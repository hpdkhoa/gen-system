{"file":"D:\\tool\\go\\src\\math\\trig_reduce.go","checksum":"fa54b4e9e792707630cd402f19e742ba23c574dc6255867a395e737494a61595","lang":"go","pkg":"math","nodes":[{"ID":"import:math/bits","Kind":"import","Name":"bits","Language":"go","Span":{"Start":{"Line":8,"Column":2,"Offset":184},"End":{"Line":8,"Column":13,"Offset":195}},"Exported":false,"Abstract":false,"Async":false,"Static":false,"DocComment":"","Receiver":null,"Params":null,"Returns":null,"Fields":null,"Implements":null,"Extends":"","TypeParams":null,"AliasTarget":{"Name":"","Package":"","IsSlice":false,"IsMap":false,"IsPtr":false,"IsFunc":false,"Params":null,"KeyType":null},"EnumMembers":null,"ImportPath":"math/bits","ImportAlias":"","ImportNames":null,"ImportAll":false,"TypeHint":{"Name":"","Package":"","IsSlice":false,"IsMap":false,"IsPtr":false,"IsFunc":false,"Params":null,"KeyType":null},"ValueLiteral":"","Callee":"","CallArgs":null,"RawSource":"","UnknownReason":"","Children":null,"Else":null},{"ID":"constant:reduceThreshold","Kind":"constant","Name":"reduceThreshold","Language":"go","Span":{"Start":{"Line":22,"Column":7,"Offset":821},"End":{"Line":22,"Column":32,"Offset":846}},"Exported":false,"Abstract":false,"Async":false,"Static":false,"DocComment":"reduceThreshold is the maximum value of x where the reduction using Pi/4\nin 3 float64 parts still gives accurate results. This threshold\nis set by y*C being representable as a float64 without error\nwhere y is given by y = floor(x * (4 / Pi)) and C is the leading partial\nterms of 4/Pi. Since the leading terms (PI4A and PI4B in sin.go) have 30\nand 32 trailing zero bits, y should have less than 30 significant bits.\n\n\ty \u003c 1\u003c\u003c30  -\u003e floor(x*4/Pi) \u003c 1\u003c\u003c30 -\u003e x \u003c (1\u003c\u003c30 - 1) * Pi/4\n\nSo, conservatively we can take x \u003c 1\u003c\u003c29.\nAbove this threshold Payne-Hanek range reduction must be used.","Receiver":null,"Params":null,"Returns":null,"Fields":null,"Implements":null,"Extends":"","Type