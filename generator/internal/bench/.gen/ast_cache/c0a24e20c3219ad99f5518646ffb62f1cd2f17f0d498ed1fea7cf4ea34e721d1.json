ld, Vite-\u003edist; copy whichever exists.\n  if [ -d web/build ]; then cp -r web/build \"$DIST/web\"; elif [ -d web/dist ]; then cp -r web/dist \"$DIST/web\"; fi\n  echo \"  built $DIST/web\"\nelse\n  echo \"→ Web: skipped (no web/ — experimental layer, not generated this run)\"\nfi\n\nif [ -d mobile ] \u0026\u0026 [ -f mobile/package.json ]; then\n  echo \"→ Mobile (React Native) deps + JS bundle…\"\n  ( cd mobile \u0026\u0026 npm ci )\n  if [ -f mobile/index.js ]; then\n    ( cd mobile \u0026\u0026 npx react-native bundle --platform android --dev false \\\n        --entry-file index.js --bundle-output \"../$DIST/mobile.android.bundle\" 2\u003e/dev/null ) || \\\n        echo \"  (RN bundle skipped — configure entry/platform on your box)\"\n  fi\n  echo \"  mobile deps installed\"\nelse\n  echo \"→ Mobile: skipped (no mobile/ — experimental layer, not generated this run)\"\nfi\n\necho \"✓ build-all complete. Artifacts in ./$DIST/\"\n`","Callee":"","CallArgs":null,"RawSource":"","UnknownReason":"","Children":null,"Else":null},{"ID":"func:bundleShFor","Kind":"function","Name":"bundleShFor","Language":"go","Span":{"Start":{"Line":72,"Column":1,"Offset":2961},"End":{"Line":117,"Column":2,"Offset":4680}},"Exported":false,"Abstract":false,"Async":false,"Static":false,"DocComment":"","Receiver":null,"Params":[{"Name":"app","Type":{"Name":"string","Package":"","IsSlice":false,"IsMap":false,"IsPtr":false,"IsFunc":false,"Params":null,"KeyType":null},"Variadic":false,"Optional":false,"Default":""}],"Returns":[{"Name":"string","Package":"","IsSlice":false,"IsMap":false,"IsPtr":false,"IsFunc":false,"Params":null,"KeyType":null}],"Fields":null,"Implements":null,"Extends":"","TypeParams":null,"AliasTarget":{"Name":"","Package":"","IsSlice":false,"IsMap":false,"IsPtr":false,"IsFunc":false,"Params":null,"KeyType":null},"EnumMembers":null,"ImportPath":"","ImportAlias":"","ImportNames":null,"ImportAll":false,"TypeHint":{"Name":"","Package":"","IsSlice":false,"IsMap":false,"IsPtr":fa