Exported":false,"Abstract":false,"Async":false,"Static":false,"DocComment":"","Receiver":null,"Params":null,"Returns":null,"Fields":null,"Implements":null,"Extends":"","TypeParams":null,"AliasTarget":{"Name":"","Package":"","IsSlice":false,"IsMap":false,"IsPtr":false,"IsFunc":false,"Params":null,"KeyType":null},"EnumMembers":null,"ImportPath":"unsafe","ImportAlias":"_","ImportNames":null,"ImportAll":false,"TypeHint":{"Name":"","Package":"","IsSlice":false,"IsMap":false,"IsPtr":false,"IsFunc":false,"Params":null,"KeyType":null},"ValueLiteral":"","Callee":"","CallArgs":null,"RawSource":"","UnknownReason":"","Children":null,"Else":null},{"ID":"constant:traceTimeDiv","Kind":"constant","Name":"traceTimeDiv","Language":"go","Span":{"Start":{"Line":42,"Column":7,"Offset":1689},"End":{"Line":42,"Column":114,"Offset":1796}},"Exported":false,"Abstract":false,"Async":false,"Static":false,"DocComment":"Timestamps in trace are produced through either nanotime or cputicks\nand divided by traceTimeDiv. nanotime is used everywhere except on\nplatforms where osHasLowResClock is true, because the system clock\nisn't granular enough to get useful information out of a trace in\nmany cases.\n\nThis makes absolute values of timestamp diffs smaller, and so they are\nencoded in fewer bytes.\n\nThe target resolution in all cases is 64 nanoseconds.\nThis is based on the fact that fundamentally the execution tracer won't emit\nevents more frequently than roughly every 200 ns or so, because that's roughly\nhow long it takes to call through the scheduler.\nWe could be more aggressive and bump this up to 128 ns while still getting\nuseful data, but the extra bit doesn't save us that much and the headroom is\nnice to have.\n\nHitting this target resolution is easy in the nanotime case: just pick a\ndivision of 64. In the cputicks case it's a bit more complex.\n\nFor x86, on a 3 GHz machine, we'd want to divide by 3*64 to hit our target.\nTo keep the division operation efficient, we round that up to 4*64, or 256.\nGiven what cputicks represents, we use this on all other platforms except\nfor PowerPC.\nThe suggested increment frequency for PowerPC's time base register is\n512 MHz according to Power ISA v2.07 section 6.2, so we use 32 on ppc64\nand ppc64le.","Receiver":null,"Params":null,"Returns":null,"Fields":null,"Implements":null,"Extends":"","TypeParams":null,"AliasTarget":{"Name":"","Package":"","IsSlice":false,"IsMap":false,"IsPtr":false,"IsFunc":false,"Params":null,"KeyType":null},"EnumMembers":null,"ImportPath":"","ImportAlias":"","ImportNames":null,"ImportAll":false,"TypeHint":{"Name":"?","Package":"","IsSlice":false,"IsMap":false,"IsPtr":false,"IsFunc":false,"Params":null,"KeyType":null},"ValueLiteral":"(1-osHasLowResClockInt)*64 + osHasLowResClockInt*(256-224*(goarch.IsPpc64|goarch.IsPpc64le))","Callee":"","CallArgs":null,"RawSource":"","UnknownReason":"","Children":null,"Else":null},{"ID":"type:traceTime","Kind":"type_alias","Name":"traceTime","Language":"go","Span":{"Start":{"Line":45,"Column":6,"Offset":1854},"End":{"Line":45,"Column":22,"Offset":1870}},"Exported":false,"Abstract":false,"Async":false,"Static":false,"DocComment":"traceTime represents a timestamp for the trace.","Receiver":null,"Params":null,"Returns":null,"Fields":null,"Implements":null,"Extends":"","TypeParams":null,"AliasTarget":{"Name":"uint64","Package":"","IsSlice":false,"IsMap":false,"IsPtr":false,"IsFunc":false,"Params":null,"KeyType":null},"EnumMembers":null,"ImportPath":"","ImportAlias":"","ImportNames":null,"ImportAll":false,"TypeHint":{"Name":"","Package":"","IsSlice":false,"IsMap":false,"IsPtr":false,"IsFunc":false,"Params":null,"KeyType":null},"ValueLiteral":"","Callee":"","CallArgs":null,"RawSource":"","UnknownReason":"","Children":null,"Else":null},{"ID":"func:traceClockNow","Kind":"function","Name":"traceClockNow","Language":"go","Span":{"Start":{"Line":58,"Column":1,"Offset":2291},"End":{"Line":63,"Column":2,"Offset":2442}},"Exported":false,"Abstract":false,"Asyn