{"flow":{"kind":"field","name":"SURVIVAL-MODE","noCFG":true,"reason":"SURVIVAL-MODE is a field: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":41,"file":"CobolCraft/src/commands/gamemode.cob","kind":"field","language":"cobol","lines":[{"line":1,"text":"*> --- RegisterCommand-GameMode ---"},{"line":2,"text":"IDENTIFICATION DIVISION."},{"line":3,"text":"PROGRAM-ID. RegisterCommand-GameMode."},{"line":4,"text":""},{"line":5,"text":"DATA DIVISION."},{"line":6,"text":"WORKING-STORAGE SECTION."},{"line":7,"text":"    COPY DD-COMMAND-CONSTANTS."},{"line":8,"text":"    01 COMMAND-NAME                 PIC X(100)                  VALUE \"gamemode\"."},{"line":9,"text":"    01 COMMAND-HELP                 PIC X(255)                  VALUE \"/gamemode <gamemode> [player] - change your game mode\"."},{"line":10,"text":"    01 PTR                          PROGRAM-POINTER."},{"line":11,"text":"    01 NODE-ROOT                    BINARY-LONG UNSIGNED."},{"line":12,"text":"    01 NODE-GAMEMODE                BINARY-LONG UNSIGNED."},{"line":13,"text":"    01 NODE-PLAYER                  BINARY-LONG UNSIGNED."},{"line":14,"text":""},{"line":15,"text":"PROCEDURE DIVISION."},{"line":16,"text":"    SET PTR TO ENTRY \"Callback-Execute\""},{"line":17,"text":"    CALL \"RegisterCommand\" USING COMMAND-NAME COMMAND-HELP PTR NODE-ROOT"},{"line":18,"text":""},{"line":19,"text":"    CALL \"AddCommandArgument\" USING NODE-ROOT \"gamemode\" CMD-PARSER-GAMEMODE OMITTED NODE-GAMEMODE"},{"line":20,"text":"    CALL \"SetCommandExecutable\" USING NODE-GAMEMODE"},{"line":21,"text":""},{"line":22,"text":"    *> Uses entity parser (instead of game profile parser) to restrict to online players"},{"line":23,"text":"    CALL \"AddCommandArgument\" USING NODE-GAMEMODE \"player\" CMD-PARSER-ENTITY CMD-ENTITY-SINGLE-PLAYER NODE-PLAYER"},{"line":24,"text":"    CALL \"SetCommandExecutable\" USING NODE-PLAYER"},{"line":25,"text":""},{"line":26,"text":"    GOBACK."},{"line":27,"text":""},{"line":28,"text":"    *> --- Callback-Execute ---"},{"line":29,"text":"    IDENTIFICATION DIVISION."},{"line":30,"text":"    PROGRAM-ID. Callback-Execute."},{"line":31,"text":""},{"line":32,"text":"    DATA DIVISION."},{"line":33,"text":"    WORKING-STORAGE SECTION."},{"line":34,"text":"        COPY DD-CLIENTS."},{"line":35,"text":"        COPY DD-PLAYERS."},{"line":36,"text":"        COPY DD-SERVER-PROPERTIES."},{"line":37,"text":"        01 BUFFER                   PIC X(255)."},{"line":38,"text":"        01 PLAYER-ID                BINARY-LONG UNSIGNED."},{"line":39,"text":"        01 GAME-EVENT-TYPE          BINARY-CHAR UNSIGNED."},{"line":40,"text":"        01 GAME-EVENT-VALUE         FLOAT-SHORT."},{"line":41,"text":"        *> game mode enum to string"}],"name":"SURVIVAL-MODE","start_line":1,"symbol_id":"CobolCraft/src/commands/gamemode.cob#field:GAMEMODE-STRING-ENUM.SURVIVAL-MODE"}}
