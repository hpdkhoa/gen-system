 CALL \"NbtDecode-RootCompound\" USING NBTDEC BUFFER"},{"line":433,"text":""},{"line":434,"text":"    MOVE SPACES TO CHUNK-STATUS"},{"line":435,"text":""},{"line":436,"text":"    *> Do a first pass to get the chunk X, Z, and Y values, as well as the chunk generation status."},{"line":437,"text":"    *> The way we write NBT, they should come before any larger pieces of data, but this is not strictly guaranteed."},{"line":438,"text":"    MOVE NBTDEC TO SEEK-NBTDEC"},{"line":439,"text":"    MOVE 0 TO SEEK-FOUND"},{"line":440,"text":"    PERFORM UNTIL EXIT"},{"line":441,"text":"        CALL \"NbtDecode-Peek\" USING SEEK-NBTDEC BUFFER AT-END TAG"},{"line":442,"text":"        IF AT-END > 0"},{"line":443,"text":"            EXIT PERFORM"},{"line":444,"text":"        END-IF"},{"line":445,"text":"        EVALUATE TAG"},{"line":446,"text":"            WHEN \"xPos\""},{"line":447,"text":"                CALL \"NbtDecode-Int\" USING SEEK-NBTDEC BUFFER X-POS"},{"line":448,"text":"                ADD 1 TO SEEK-FOUND"},{"line":449,"text":"            WHEN \"zPos\""},{"line":450,"text":"                CALL \"NbtDecode-Int\" USING SEEK-NBTDEC BUFFER Z-POS"},{"line":451,"text":"                ADD 1 TO SEEK-FOUND"},{"line":452,"text":"            WHEN \"yPos\""},{"line":453,"text":"                CALL \"NbtDecode-Int\" USING SEEK-NBTDEC BUFFER CHUNK-SECTION-MIN-Y"},{"line":454,"text":"                ADD 1 TO SEEK-FOUND"},{"line":455,"text":"            WHEN \"Status\""},{"line":456,"text":"                CALL \"NbtDecode-String\" USING SEEK-NBTDEC BUFFER STR LEN"},{"line":457,"text":"                MOVE STR(1:LEN) TO CHUNK-STATUS"},{"line":458,"text":"            WHEN OTHER"},{"line":459,"text":"                CALL \"NbtDecode-Skip\" USING SEEK-NBTDEC BUFFER"},{"line":460,"text":"        END-EVALUATE"},{"line":461,"text":"        IF SEEK-FOUND = 3"},{"line":462,"text":"            EXIT PERFORM"},{"line":463,"text":"        END-IF"},{"line":464,"text":"    END-PERFORM"},{"line":465,"text":""},{"line":466,"text":"    *> We are unable to continue generating partially-generated chunks (\"proto-chunks\"). Since we don't require light"},{"line":467,"text":"    *> or heightmap data, any chunk that has progressed to at least the \"surface\" stage is acceptable."},{"line":468,"text":"    IF CHUNK-STATUS NOT = SPACES"},{"line":469,"text":"        CALL \"Registries-Lookup\" USING \"minecraft:chunk_status\" CHUNK-STATUS CHUNK-STATUS-ID"},{"line":470,"text":"        IF CHUNK-STATUS-ID < 0"},{"line":471,"text":"            DISPLAY \"Unknown chunk status: \" FUNCTION TRIM(CHUNK-STATUS)"},{"line":472,"text":"            MOVE 1 TO LK-FAILURE"},{"line":473,"text":"            GOBACK"},{"line":474,"text":"        END-IF"},{"line":475,"text":"        CALL \"Registries-Lookup\" USING \"minecraft:chunk_status\" \"minecraft:surface\" ACCEPTED-CHUNK-STATUS-ID"},{"line":476,"text":"        IF ACCEPTED-CHUNK-STATUS-ID < 0"},{"line":477,"text":"            DISPLAY \"Unknown chunk status: minecraft:surface\""},{"line":478,"text":"            MOVE 1 TO LK-FAILURE"},{"line":479,"text":"            GOBACK"},{"line":480,"text":"        END-IF"},{"line":481,"text":"        IF CHUNK-STATUS-ID < ACCEPTED-CHUNK-STATUS-ID"},{"line":482,"text":"            MOVE 1 TO LK-FAILURE"},{"line":483,"text":"            GOBACK"},{"line":484,"text":"        END-IF"},{"line":485,"text":"    END-IF"},{"line":486,"text":""},{"line":487,"text":"    *> Allocate a chunk slot"},{"line":488,"text":"    CALL \"World-AllocateChunk\" USING X-POS Z-POS CHUNK-INDEX"},{"line":489,"text":"    IF CHUNK-INDEX = 0"},{"line":490,"text":"        MOVE 1 TO LK-FAILURE"},{"line":491,"text":"        GOBACK"},{"line":492,"text":"    END-IF"},{"line":493,"text":"    SET ADDRESS OF CHUNK TO WORLD-CHUNK-POINTER(CHUNK-INDEX)"},{"line":494,"text":""},{"line":495,"text":"    *> Decode NBT"},{"line":496,"text":"    MOVE 0 TO DID-DECODE-SECTIONS"},{"line":497,"text":"    PERFORM UNTIL EXIT"},{"line":498,"text":"        CALL \"NbtDecode-Peek\" USING NBTDEC BUFFER AT-END TAG"},{"line":499,"text":"        EVALUATE TRUE"},{"line":500,"text":"            WHEN AT-END > 0"},{"line":501,"text":"                EXIT PERFORM"},{"line":502,"text":"            WHEN TAG = \"sections\""},{"line":503,"text":"                PERFORM DecodeSections"},{"line":504,"text":"                MOVE 1 TO DID-DECODE-SECTIONS"},{"line":505,"text":"            WHEN TAG = \"block_entities\""},{"line":506,"text":"                PERFORM DecodeBlockEntities"},{"line":507,"text":"            WHEN OTHER"},{"line":508,"text":"                CALL \"NbtDecode-Skip\" USING NBTDEC BUFFER"},{"line":509,"text":"        END-EVALUATE"},{"line":510,"text":"    END-PERFORM"},{"line":511,"text":""},{"line":512,"text":"    IF DID-DECODE-SECTIONS = 0"},{"line":513,"text":"        MOVE 1 TO LK-FAILURE"},{"line":514,"text":"        GOBACK"},{"line":515,"text":"    END-IF"},{"line":516,"text":""},{"line":517,"text":"    CALL \"NbtDecode-SkipRemainingTags\" USING NBTDEC BUFFER"},{"line":518,"text":""},{"line":519,"text":"    *> end root tag"},{"line":520,"text":"    CALL \"NbtDecode-EndCompound\" USING NBTDEC BUFFER"},{"line":521,"text":"    ."}],"name":"LOADCHUNKREGION","start_line":421,"symbol_id":"CobolCraft/src/world/chunk-io.cob#func:WORLD-LOADCHUNK.LOADCHUNKREGION"}}
