{"flow":{"kind":"field","name":"BLOCK-Y","noCFG":true,"reason":"BLOCK-Y is a field: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":41,"file":"CobolCraft/src/items/bed.cob","kind":"field","language":"cobol","lines":[{"line":1,"text":"*> --- RegisterItem-Bed ---"},{"line":2,"text":"IDENTIFICATION DIVISION."},{"line":3,"text":"PROGRAM-ID. RegisterItem-Bed."},{"line":4,"text":""},{"line":5,"text":"DATA DIVISION."},{"line":6,"text":"WORKING-STORAGE SECTION."},{"line":7,"text":"    01 BLOCK-REGISTRY           BINARY-LONG."},{"line":8,"text":"    01 USE-PTR                  PROGRAM-POINTER."},{"line":9,"text":"    01 BLOCK-COUNT              BINARY-LONG UNSIGNED."},{"line":10,"text":"    01 BLOCK-ID                 BINARY-LONG UNSIGNED."},{"line":11,"text":"    01 BLOCK-NAME               PIC X(64)."},{"line":12,"text":"    01 BLOCK-TYPE               PIC X(64)."},{"line":13,"text":""},{"line":14,"text":"PROCEDURE DIVISION."},{"line":15,"text":"    CALL \"Registries-LookupRegistry\" USING \"minecraft:block\" BLOCK-REGISTRY"},{"line":16,"text":""},{"line":17,"text":"    SET USE-PTR TO ENTRY \"Callback-Use\""},{"line":18,"text":""},{"line":19,"text":"    *> Loop over all blocks and register the callback for each bed"},{"line":20,"text":"    CALL \"Registries-EntryCount\" USING BLOCK-REGISTRY BLOCK-COUNT"},{"line":21,"text":"    PERFORM VARYING BLOCK-ID FROM 0 BY 1 UNTIL BLOCK-ID >= BLOCK-COUNT"},{"line":22,"text":"        CALL \"Blocks-GetType\" USING BLOCK-ID BLOCK-TYPE"},{"line":23,"text":"        IF BLOCK-TYPE = \"minecraft:bed\""},{"line":24,"text":"            CALL \"Registries-EntryName\" USING BLOCK-REGISTRY BLOCK-ID BLOCK-NAME"},{"line":25,"text":"            CALL \"SetCallback-ItemUse\" USING BLOCK-NAME USE-PTR"},{"line":26,"text":"        END-IF"},{"line":27,"text":"    END-PERFORM"},{"line":28,"text":""},{"line":29,"text":"    GOBACK."},{"line":30,"text":""},{"line":31,"text":"    *> --- Callback-Use ---"},{"line":32,"text":"    IDENTIFICATION DIVISION."},{"line":33,"text":"    PROGRAM-ID. Callback-Use."},{"line":34,"text":""},{"line":35,"text":"    DATA DIVISION."},{"line":36,"text":"    WORKING-STORAGE SECTION."},{"line":37,"text":"        COPY DD-PLAYERS."},{"line":38,"text":"        COPY DD-BLOCK-STATE REPLACING LEADING ==PREFIX== BY ==PLACE==."},{"line":39,"text":"        01 BED-FACE                 BINARY-LONG."},{"line":40,"text":"        01 BLOCK-POSITION-FOOT."},{"line":41,"text":"            02 BLOCK-X              BINARY-LONG."}],"name":"BLOCK-Y","start_line":1,"symbol_id":"CobolCraft/src/items/bed.cob#field:BLOCK-POSITION-HEAD.BLOCK-Y"}}
