{"flow":{"kind":"field","name":"WINDOW-SLOT","noCFG":true,"reason":"WINDOW-SLOT is a field: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":41,"file":"CobolCraft/src/inventory/window-crafting.cob","kind":"field","language":"cobol","lines":[{"line":1,"text":"*> --- RegisterWindow-Crafting ---"},{"line":2,"text":"IDENTIFICATION DIVISION."},{"line":3,"text":"PROGRAM-ID. RegisterWindow-Crafting."},{"line":4,"text":""},{"line":5,"text":"DATA DIVISION."},{"line":6,"text":"WORKING-STORAGE SECTION."},{"line":7,"text":"    01 WINDOW-TYPE                  BINARY-LONG."},{"line":8,"text":"    01 SYNC-PTR                     PROGRAM-POINTER."},{"line":9,"text":"    01 CLOSE-PTR                    PROGRAM-POINTER."},{"line":10,"text":"    01 SET-SLOT-PTR                 PROGRAM-POINTER."},{"line":11,"text":"    01 DROP-PTR                     PROGRAM-POINTER."},{"line":12,"text":""},{"line":13,"text":"PROCEDURE DIVISION."},{"line":14,"text":"    CALL \"Registries-Lookup\" USING \"minecraft:menu\" \"minecraft:crafting\" WINDOW-TYPE"},{"line":15,"text":"    IF WINDOW-TYPE < 0"},{"line":16,"text":"        DISPLAY \"RegisterBlock-CraftingTable: Failed to get window type ID\""},{"line":17,"text":"        GOBACK"},{"line":18,"text":"    END-IF"},{"line":19,"text":""},{"line":20,"text":"    SET SYNC-PTR TO ENTRY \"Callback-Sync\""},{"line":21,"text":"    SET CLOSE-PTR TO ENTRY \"Callback-Close\""},{"line":22,"text":"    SET SET-SLOT-PTR TO ENTRY \"Callback-SetSlot\""},{"line":23,"text":"    SET DROP-PTR TO ENTRY \"Callback-Drop\""},{"line":24,"text":""},{"line":25,"text":"    CALL \"SetCallback-WindowSync\" USING WINDOW-TYPE SYNC-PTR"},{"line":26,"text":"    CALL \"SetCallback-WindowClose\" USING WINDOW-TYPE CLOSE-PTR"},{"line":27,"text":"    CALL \"SetCallback-WindowSetSlot\" USING WINDOW-TYPE SET-SLOT-PTR"},{"line":28,"text":"    CALL \"SetCallback-WindowDrop\" USING WINDOW-TYPE DROP-PTR"},{"line":29,"text":""},{"line":30,"text":"    GOBACK."},{"line":31,"text":""},{"line":32,"text":"    *> --- Callback-Sync ---"},{"line":33,"text":"    IDENTIFICATION DIVISION."},{"line":34,"text":"    PROGRAM-ID. Callback-Sync."},{"line":35,"text":""},{"line":36,"text":"    DATA DIVISION."},{"line":37,"text":"    WORKING-STORAGE SECTION."},{"line":38,"text":"        COPY DD-PLAYERS."},{"line":39,"text":"        *> https://minecraft.wiki/w/Minecraft_Wiki:Projects/wiki.vg_merge/Inventory#Crafting_table"},{"line":40,"text":"        *> 0 = crafting output, 1..9 = crafting grid, 10..36 = player inventory, 37..45 = hotbar"},{"line":41,"text":"        01 WINDOW-INVENTORY-LENGTH      BINARY-LONG UNSIGNED    VALUE 46."}],"name":"WINDOW-SLOT","start_line":1,"symbol_id":"CobolCraft/src/inventory/window-crafting.cob#field:WINDOW-SLOTS.WINDOW-SLOT"}}
