 3 0 0 REGION-FILE-HANDLE"},{"line":128,"text":"    IF RETURN-CODE NOT = 0 AND RETURN-CODE NOT = 35"},{"line":129,"text":"        MOVE 1 TO LK-FAILURE"},{"line":130,"text":"        EXIT PARAGRAPH"},{"line":131,"text":"    END-IF"},{"line":132,"text":""},{"line":133,"text":"    IF RETURN-CODE = 35"},{"line":134,"text":"        *> A return code of 35 means that the file does not exist, so create it if allowed"},{"line":135,"text":"        IF LK-ALLOW-CREATE = 0"},{"line":136,"text":"            MOVE 1 TO LK-FAILURE"},{"line":137,"text":"            EXIT PARAGRAPH"},{"line":138,"text":"        END-IF"},{"line":139,"text":""},{"line":140,"text":"        CALL \"CBL_CREATE_FILE\" USING REGION-FILE-NAME 2 0 0 REGION-FILE-HANDLE"},{"line":141,"text":"        IF RETURN-CODE NOT = 0"},{"line":142,"text":"            MOVE 1 TO LK-FAILURE"},{"line":143,"text":"            EXIT PARAGRAPH"},{"line":144,"text":"        END-IF"},{"line":145,"text":""},{"line":146,"text":"        *> Write an empty header (offset section, timestamp section)"},{"line":147,"text":"        MOVE ALL X\"00\" TO REGION-FILE-OFFSET-BYTES"},{"line":148,"text":"        MOVE REGION-FILE-OFFSET-BYTES TO SECTOR-BUFFER"},{"line":149,"text":"        MOVE 0 TO FILE-OFFSET"},{"line":150,"text":"        MOVE REGION-SECTOR-BYTES TO FILE-LENGTH"},{"line":151,"text":"        PERFORM 2 TIMES"},{"line":152,"text":"            CALL \"Region-WriteToHandle\" USING REGION-FILE-HANDLE FILE-OFFSET FILE-LENGTH SECTOR-BUFFER LK-FAILURE"},{"line":153,"text":"            IF LK-FAILURE NOT = 0"},{"line":154,"text":"                CALL \"CBL_CLOSE_FILE\" USING REGION-FILE-HANDLE"},{"line":155,"text":"                EXIT PARAGRAPH"},{"line":156,"text":"            END-IF"},{"line":157,"text":"            ADD REGION-SECTOR-BYTES TO FILE-OFFSET"},{"line":158,"text":"        END-PERFORM"},{"line":159,"text":""},{"line":160,"text":"        *> Close the file so we can reopen it for read/write"},{"line":161,"text":"        CALL \"CBL_CLOSE_FILE\" USING REGION-FILE-HANDLE"},{"line":162,"text":"        IF RETURN-CODE NOT = 0"},{"line":163,"text":"            MOVE 1 TO LK-FAILURE"},{"line":164,"text":"            EXIT PARAGRAPH"},{"line":165,"text":"        END-IF"},{"line":166,"text":"        CALL \"CBL_OPEN_FILE\" USING REGION-FILE-NAME 3 0 0 REGION-FILE-HANDLE"},{"line":167,"text":"        IF RETURN-CODE NOT = 0"},{"line":168,"text":"            MOVE 1 TO LK-FAILURE"},{"line":169,"text":"            EXIT PARAGRAPH"},{"line":170,"text":"        END-IF"},{"line":171,"text":"    ELSE"},{"line":172,"text":"        *> The file exists, so read the header"},{"line":173,"text":"        MOVE 0 TO FILE-OFFSET"},{"line":174,"text":"        MOVE REGION-SECTOR-BYTES TO FILE-LENGTH"},{"line":175,"text":"        CALL \"Region-ReadFromHandle\" USING REGION-FILE-HANDLE FILE-OFFSET FILE-LENGTH REGION-FILE-OFFSET-BYTES LK-FAILURE"},{"line":176,"text":"        IF LK-FAILURE NOT = 0"},{"line":177,"text":"            CALL \"CBL_CLOSE_FILE\" USING REGION-FILE-HANDLE"},{"line":178,"text":"            EXIT PARAGRAPH"},{"line":179,"text":"        END-IF"},{"line":180,"text":""},{"line":181,"text":"        *> Mark all used sectors."},{"line":182,"text":"        MOVE 1 TO OFFSET"},{"line":183,"text":"        PERFORM REGION-SECTOR-INTS TIMES"},{"line":184,"text":"            CALL \"Decode-UnsignedInt\" USING REGION-FILE-OFFSET-BYTES OFFSET CHUNK-SECTOR-LOCATION"},{"line":185,"text":"            >>IF GCVERSION >= 32"},{"line":186,"text":"                COMPUTE CHUNK-SECTOR-LENGTH = CHUNK-SECTOR-LOCATION B-AND H'FF'"},{"line":187,"text":"                COMPUTE CHUNK-SECTOR-OFFSET = CHUNK-SECTOR-LOCATION B-SHIFT-R 8"},{"line":188,"text":"            >>ELSE"},{"line":189,"text":"                DIVIDE CHUNK-SECTOR-LOCATION BY 256 GIVING CHUNK-SECTOR-OFFSET REMAINDER CHUNK-SECTOR-LENGTH"},{"line":190,"text":"            >>END-IF"},{"line":191,"text":"            IF CHUNK-SECTOR-LENGTH > 0"},{"line":192,"text":"                COMPUTE SECTOR-INDEX = CHUNK-SECTOR-OFFSET + 1"},{"line":193,"text":"                PERFORM CHUNK-SECTOR-LENGTH TIMES"},{"line":194,"text":"                    MOVE 1 TO REGION-FILE-USED(SECTOR-INDEX)"},{"line":195,"text":"                    ADD 1 TO SECTOR-INDEX"},{"line":196,"text":"                END-PERFORM"},{"line":197,"text":"            END-IF"},{"line":198,"text":"        END-PERFORM"},{"line":199,"text":"    END-IF"},{"line":200,"text":"    ."}],"name":"OPENFILE","start_line":124,"symbol_id":"CobolCraft/src/region.cob#func:REGION-OPEN.OPENFILE"}}
