{"flow":{"kind":"field","name":"PREFIX-DIR-NAME","noCFG":true,"reason":"PREFIX-DIR-NAME is a field: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":41,"file":"CobolCraft/codegen/common/data.cob","kind":"field","language":"cobol","lines":[{"line":1,"text":"*> --- Codegen-SetDataDirectory ---"},{"line":2,"text":"IDENTIFICATION DIVISION."},{"line":3,"text":"PROGRAM-ID. Codegen-SetDataDirectory."},{"line":4,"text":""},{"line":5,"text":"DATA DIVISION."},{"line":6,"text":"WORKING-STORAGE SECTION."},{"line":7,"text":"    01 CODEGEN-DATA-DIR             PIC X(255)                  EXTERNAL."},{"line":8,"text":"LINKAGE SECTION."},{"line":9,"text":"    01 LK-DATA-DIR                  PIC X ANY LENGTH."},{"line":10,"text":""},{"line":11,"text":"PROCEDURE DIVISION USING LK-DATA-DIR."},{"line":12,"text":"    MOVE LK-DATA-DIR TO CODEGEN-DATA-DIR"},{"line":13,"text":"    GOBACK."},{"line":14,"text":""},{"line":15,"text":"END PROGRAM Codegen-SetDataDirectory."},{"line":16,"text":""},{"line":17,"text":"*> --- Codegen-ReadDataDirectory ---"},{"line":18,"text":"IDENTIFICATION DIVISION."},{"line":19,"text":"PROGRAM-ID. Codegen-ReadDataDirectory."},{"line":20,"text":""},{"line":21,"text":"DATA DIVISION."},{"line":22,"text":"WORKING-STORAGE SECTION."},{"line":23,"text":"    01 CODEGEN-DATA-DIR             PIC X(255)                  EXTERNAL."},{"line":24,"text":"    01 DIR-PATH                     PIC X(1024)."},{"line":25,"text":"    01 DIR-PATH-LENGTH              BINARY-LONG UNSIGNED."},{"line":26,"text":"    01 DIR-HANDLE                   PIC X(8) USAGE COMP-X."},{"line":27,"text":"    01 FAILURE                      BINARY-CHAR UNSIGNED."},{"line":28,"text":"    01 DIR-ENTRY                    PIC X(255)."},{"line":29,"text":"LINKAGE SECTION."},{"line":30,"text":"    01 LK-DIRNAME                   PIC X ANY LENGTH."},{"line":31,"text":"    COPY DD-CODEGEN-DIR-LIST REPLACING LEADING ==PREFIX== BY ==LK==."},{"line":32,"text":""},{"line":33,"text":"PROCEDURE DIVISION USING LK-DIRNAME LK-DIR."},{"line":34,"text":"    INITIALIZE DIR-PATH"},{"line":35,"text":"    STRING FUNCTION TRIM(CODEGEN-DATA-DIR) \"/\" FUNCTION TRIM(LK-DIRNAME) INTO DIR-PATH"},{"line":36,"text":"    MOVE FUNCTION STORED-CHAR-LENGTH(DIR-PATH) TO DIR-PATH-LENGTH"},{"line":37,"text":""},{"line":38,"text":"    CALL \"OpenDirectory\" USING DIR-PATH DIR-PATH-LENGTH DIR-HANDLE GIVING FAILURE"},{"line":39,"text":"    COPY ASSERT REPLACING COND BY ==FAILURE = 0==,"},{"line":40,"text":"        MSG BY ==\"Codegen: Failed to open directory: \" FUNCTION TRIM(DIR-PATH)==."},{"line":41,"text":""}],"name":"PREFIX-DIR-NAME","start_line":1,"symbol_id":"CobolCraft/codegen/common/data.cob#field:PREFIX-DIR.PREFIX-DIR-NAME"}}
