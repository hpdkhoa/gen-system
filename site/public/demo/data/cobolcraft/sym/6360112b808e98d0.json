-CLIENT(PLAYER-INDEX) > 0"},{"line":215,"text":"                CALL \"CheckCollisionAABB\" USING ENTITY-AABB LK-PLAYER-AABB(PLAYER-INDEX) COLLISION"},{"line":216,"text":"                IF COLLISION NOT = 0"},{"line":217,"text":"                    MOVE ENTITY-ITEM-SLOT-COUNT TO PREVIOUS-ITEM-COUNT"},{"line":218,"text":"                    CALL \"Inventory-StoreItem\" USING PLAYER-INVENTORY(PLAYER-INDEX) LK-ENTITY-ITEM-SLOT"},{"line":219,"text":"                    IF ENTITY-ITEM-SLOT-COUNT < PREVIOUS-ITEM-COUNT"},{"line":220,"text":"                        COMPUTE COLLECTED-ITEM-COUNT = ENTITY-ITEM-SLOT-COUNT - PREVIOUS-ITEM-COUNT"},{"line":221,"text":"                        PERFORM SendPickupItem"},{"line":222,"text":"                        *> TODO sync just the slot that changed"},{"line":223,"text":"                        CALL \"Inventory-SyncPlayerInventory\" USING PLAYER-INDEX"},{"line":224,"text":"                    END-IF"},{"line":225,"text":"                    IF ENTITY-ITEM-SLOT-COUNT < 1"},{"line":226,"text":"                        PERFORM SendPickupItem"},{"line":227,"text":"                        MOVE 1 TO LK-REMOVE"},{"line":228,"text":"                        GOBACK"},{"line":229,"text":"                    END-IF"},{"line":230,"text":"                END-IF"},{"line":231,"text":"            END-IF"},{"line":232,"text":"        END-PERFORM"},{"line":233,"text":"        ."}],"name":"TRYPICKUPITEM","start_line":201,"symbol_id":"CobolCraft/src/entities/item.cob#func:CALLBACK-TICK.TRYPICKUPITEM"}}
