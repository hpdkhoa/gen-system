{"flow":{"kind":"field","name":"BLOCK-X","noCFG":true,"reason":"BLOCK-X is a field: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":41,"file":"CobolCraft/src/items/blocks.cob","kind":"field","language":"cobol","lines":[{"line":1,"text":"*> --- RegisterItem-Block ---"},{"line":2,"text":"*> Register a generic block item."},{"line":3,"text":"IDENTIFICATION DIVISION."},{"line":4,"text":"PROGRAM-ID. RegisterItem-Block."},{"line":5,"text":""},{"line":6,"text":"DATA DIVISION."},{"line":7,"text":"WORKING-STORAGE SECTION."},{"line":8,"text":"    01 USE-PTR                  PROGRAM-POINTER."},{"line":9,"text":"LINKAGE SECTION."},{"line":10,"text":"    01 LK-ITEM-NAME             PIC X ANY LENGTH."},{"line":11,"text":""},{"line":12,"text":"PROCEDURE DIVISION USING LK-ITEM-NAME."},{"line":13,"text":"    SET USE-PTR TO ENTRY \"Callback-Use\""},{"line":14,"text":"    CALL \"SetCallback-ItemUse\" USING LK-ITEM-NAME USE-PTR"},{"line":15,"text":"    GOBACK."},{"line":16,"text":""},{"line":17,"text":"    *> --- Callback-Use ---"},{"line":18,"text":"    IDENTIFICATION DIVISION."},{"line":19,"text":"    PROGRAM-ID. Callback-Use."},{"line":20,"text":""},{"line":21,"text":"    DATA DIVISION."},{"line":22,"text":"    WORKING-STORAGE SECTION."},{"line":23,"text":"        COPY DD-PLAYERS."},{"line":24,"text":"        01 BLOCK-POSITION."},{"line":25,"text":"            02 BLOCK-X              BINARY-LONG."},{"line":26,"text":"            02 BLOCK-Y              BINARY-LONG."},{"line":27,"text":"            02 BLOCK-Z              BINARY-LONG."},{"line":28,"text":"        01 CHECK-RESULT             BINARY-CHAR UNSIGNED."},{"line":29,"text":"        01 BLOCK-ID                 BINARY-LONG."},{"line":30,"text":"        01 BLOCK-STATE              BINARY-LONG."},{"line":31,"text":"        01 PLACE-AABB."},{"line":32,"text":"            COPY DD-AABB REPLACING LEADING ==PREFIX== BY ==PLACE==."},{"line":33,"text":"    LINKAGE SECTION."},{"line":34