32 = PALETTE-LENGTH - 1"},{"line":146,"text":"                CALL \"LeadingZeros32\" USING INT32 PALETTE-BITS"},{"line":147,"text":"                *> However, Minecraft uses a minimum of 4 bits"},{"line":148,"text":"                COMPUTE PALETTE-BITS = FUNCTION MAX(32 - PALETTE-BITS, 4)"},{"line":149,"text":"                COMPUTE PALETTE-BITS-POW = 2 ** PALETTE-BITS"},{"line":150,"text":""},{"line":151,"text":"                *> length of packed long array"},{"line":152,"text":"                DIVIDE 64 BY PALETTE-BITS GIVING ENTRIES-PER-LONG"},{"line":153,"text":"                DIVIDE 4096 BY ENTRIES-PER-LONG GIVING LONG-ARRAY-LENGTH ROUNDED MODE IS TOWARD-GREATER"},{"line":154,"text":""},{"line":155,"text":"                *> data (packed long array)"},{"line":156,"text":"                CALL \"NbtEncode-LongArray\" USING NBTENC BUFFER \"data\" LONG-ARRAY-LENGTH"},{"line":157,"text":"                MOVE 1 TO BLOCK-INDEX"},{"line":158,"text":"                PERFORM LONG-ARRAY-LENGTH TIMES"},{"line":159,"text":"                    MOVE 0 TO LONG-ARRAY-ENTRY"},{"line":160,"text":"                    MOVE 1 TO LONG-ARRAY-MULTIPLIER"},{"line":161,"text":"                    PERFORM FUNCTION MIN(ENTRIES-PER-LONG, 4096 - BLOCK-INDEX + 1) TIMES"},{"line":162,"text":"                        MOVE CHUNK-SECTION-BLOCK(SECTION-INDEX, BLOCK-INDEX) TO CURRENT-BLOCK-ID"},{"line":163,"text":"                        COMPUTE LONG-ARRAY-ENTRY = LONG-ARRAY-ENTRY + LONG-ARRAY-MULTIPLIER * (PALETTE-INDEX(CURRENT-BLOCK-ID + 1) - 1)"},{"line":164,"text":"                        MULTIPLY LONG-ARRAY-MULTIPLIER BY PALETTE-BITS-POW GIVING LONG-ARRAY-MULTIPLIER"},{"line":165,"text":"                        ADD 1 TO BLOCK-INDEX"},{"line":166,"text":"                    END-PERFORM"},{"line":167,"text":"                    CALL \"NbtEncode-Long\" USING NBTENC BUFFER OMITTED LONG-ARRAY-ENTRY-SIGNED"},{"line":168,"text":"                END-PERFORM"},{"line":169,"text":"            END-IF"},{"line":170,"text":""},{"line":171,"text":"            *> end block states"},{"line":172,"text":"            CALL \"NbtEncode-EndCompound\" USING NBTENC BUFFER"},{"line":173,"text":""},{"line":174,"text":"            *> biomes - palette and data"},{"line":175,"text":"            CALL \"NbtEncode-Compound\" USING NBTENC BUFFER \"biomes\""},{"line":176,"text":""},{"line":177,"text":"            *> palette"},{"line":178,"text":"            CALL \"NbtEncode-List\" USING NBTENC BUFFER \"palette\""},{"line":179,"text":""},{"line":180,"text":"            MOVE 0 TO PALETTE-LENGTH"},{"line":181,"text":"            INITIALIZE PALETTE-INDICES"},{"line":182,"text":""},{"line":183,"text":"            PERFORM VARYING BIOME-INDEX FROM 1 BY 1 UNTIL BIOME-INDEX > 64"},{"line":184,"text":"                *> If the biome is not in the palette, add it"},{"line":185,"text":"                MOVE CHUNK-SECTION-BIOME(SECTION-INDEX, BIOME-INDEX) TO CURRENT-BIOME-ID"},{"line":186,"text":"                IF PALETTE-INDEX(CURRENT-BIOME-ID + 1) = 0"},{"line":187,"text":"                    ADD 1 TO PALETTE-LENGTH"},{"line":188,"text":"                    MOVE PALETTE-LENGTH TO PALETTE-INDEX(CURRENT-BIOME-ID + 1)"},{"line":189,"text":"                    CALL \"Registries-EntryName\" USING BIOME-REGISTRY-ID CURRENT-BIOME-ID STR"},{"line":190,"text":"                    MOVE FUNCTION STORED-CHAR-LENGTH(STR) TO LEN"},{"line":191,"text":"                    CALL \"NbtEncode-String\" USING NBTENC BUFFER OMITTED STR LEN"},{"line":192,"text":"                END-IF"},{"line":193,"text":"            END-PERFORM"},{"line":194,"text":""},{"line":195,"text":"            *> end palette"},{"line":196,"text":"            CALL \"NbtEncode-EndList\" USING NBTENC BUFFER"},{"line":197,"text":""},{"line":198,"text":"            *> Note: We only need to encode data if the palette length is greater than 1"},{"line":199,"text":"            IF PALETTE-LENGTH > 1"},{"line":200,"text":"                *> number of bits needed = ceil(log2(palette length - 1)) = bits needed to store (palette length - 1)"},{"line":201,"text":"                COMPUTE INT32 = PALETTE-LENGTH - 1"},{"line":202,"text":"                CALL \"LeadingZeros32\" USING INT32 PALETTE-BITS"},{"line":203,"text":"                COMPUTE PALETTE-BITS = 32 - PALETTE-BITS"},{"line":204,"text":"                COMPUTE PALETTE-BITS-POW = 2 ** PALETTE-BITS"},{"line":205,"text":""},{"line":206,"text":"                *> length of packed long array"},{"line":207,"text":"                DIVIDE 64 BY PALETTE-BITS GIVING ENTRIES-PER-LONG"},{"line":208,"text":"                DIVIDE 64 BY ENTRIES-PER-LONG GIVING LONG-ARRAY-LENGTH ROUNDED MODE IS TOWARD-GREATER"},{"line":209,"text":""},{"line":210,"text":"                *> data (packed long array)"},{"line":211,"text":"                CALL \"NbtEncode-LongArray\" USING NBTENC BUFFER \"data\" LONG-ARRAY-LENGTH"},{"line":212,"text":"                MOVE 1 TO BIOME-INDEX"},{"line":213,"text":"                PERFORM LONG-ARRAY-LENGTH TIMES"},{"line":214,"text":"                    MOVE 0 TO LONG-ARRAY-ENTRY"},{"line":215,"text":"                    MOVE 1 TO LONG-ARRAY-MULTIPLIER"},{"line":216,"text":"                    PERFORM FUNCTION MIN(ENTRIES-PER-LONG, 64 - BIOME-INDEX + 1) TIMES"},{"line":217,"text":"                        MOVE CHUNK-SECTION-BIOME(SECTION-INDEX, BIOME-INDEX) TO CURRENT-BIOME-ID"},{"line":218,"text":"                        COMPUTE LONG-ARRAY-ENTRY = LONG-ARRAY-ENTRY + LONG-ARRAY-MULTIPLIER * (PALETTE-INDEX(CURRENT-BIOME-ID + 1) - 1)"},{"line":219,"text":"                        MULTIPLY LONG-ARRAY-MULTIPLIER BY PALETTE-BITS-POW GIVING LONG-ARRAY-MULTIPLIER"},{"line":220,"text":"                        ADD 1 TO BIOME-INDEX"},{"line":221,"text":"                    END-PERFORM"},{"line":222,"text":"                    CALL \"NbtEncode-Long\" USING NBTENC BUFFER OMITTED LONG-ARRAY-ENTRY-SIGNED"},{"line":223,"text":"                END-PERFORM"},{"line":224,"text":"            END-IF"},{"line":225,"text":""},{"line":226,"text":"            *> end biomes"},{"line":227,"text":"            CALL \"NbtEncode-EndCompound\" USING NBTENC BUFFER"},{"line":228,"text":""},{"line":229,"text":"            *> end section"},{"line":230,"text":"            CALL \"NbtEncode-EndCompound\" USING NBTENC BUFFER"},{"line":231,"text":"        END-IF"},{"line":232,"text":"    END-PERFORM"},{"line":233,"text":""},{"line":234,"text":"    *> end chunk sections"},{"line":235,"text":"    CALL \"NbtEncode-EndList\" USING NBTENC BUFFER"},{"line":236,"text":""},{"line":237,"text":"    *> start block entities"},{"line":238,"text":"    CALL \"NbtEncode-List\" USING NBTENC BUFFER \"block_entities\""},{"line":239,"text":""},{"line":240,"text":"    MOVE 0 TO BLOCK-ENTITY-COUNT"},{"line":241,"text":"    PERFORM VARYING BLOCK-INDEX FROM 1 BY 1 UNTIL BLOCK-ENTITY-COUNT >= CHUNK-BLOCK-ENTITY-COUNT"},{"line":242,"text":"        IF CHUNK-BLOCK-ENTITY-ID(BLOCK-INDEX) >= 0"},{"line":243,"text":"            ADD 1 TO BLOCK-ENTITY-COUNT"},{"line":244,"text":""},{"line":245,"text":"            *> start block entity"},{"line":246,"text":"            CALL \"NbtEncode-Compound\" USING NBTENC BUFFER OMITTED"},{"line":247,"text":""},{"line":248,"text":"            MOVE CHUNK-BLOCK-ENTITY-ID(BLOCK-INDEX) TO INT32"},{"line":249,"text":"            SET SERIALIZE-PTR TO CB-PTR-BLOCK-ENTITY-SERIALIZE(INT32 + 1)"},{"line":250,"text":""},{"line":251,"text":"            CALL \"Registries-EntryName\" USING BLOCK-ENTITY-REGISTRY-ID INT32 STR"},{"line":252,"text":"            MOVE FUNCTION STORED-CHAR-LENGTH(STR) TO LEN"},{"line":253,"text":"            CALL \"NbtEncode-String\" USING NBTENC BUFFER \"id\" STR LEN"},{"line":254,"text":""},{"line":255,"text":"            *> x, y, z"},{"line":256,"text":"            SUBTRACT 1 FROM BLOCK-INDEX GIVING INT32"},{"line":257,"text":"            DIVIDE INT32 BY 16 GIVING INT32 REMAINDER BLOCK-ENTITY-X"},{"line":258,"text":"            DIVIDE INT32 BY 16 GIVING INT32 REMAINDER BLOCK-ENTITY-Z"},{"line":259,"text":"            SUBTRACT 64 FROM INT32 GIVING BLOCK-ENTITY-Y"},{"line":260,"text":"            *> x and z are in the world coordinate system"},{"line":261,"text":"            COMPUTE BLOCK-ENTITY-X = BLOCK-ENTITY-X + CHUNK-X * 16"},{"line":262,"text":"            COMPUTE BLOCK-ENTITY-Z = BLOCK-ENTITY-Z + CHUNK-Z * 16"},{"line":263,"text":""},{"line":264,"text":"            CALL \"NbtEncode-Int\" USING NBTENC BUFFER \"x\" BLOCK-ENTITY-X"},{"line":265,"text":"            CALL \"NbtEncode-Int\" USING NBTENC BUFFER \"y\" BLOCK-ENTITY-Y"},{"line":266,"text":"            CALL \"NbtEncode-Int\" USING NBTENC BUFFER \"z\" BLOCK-ENTITY-Z"},{"line":267,"text":""},{"line":268,"text":"            *> block entity data"},{"line":269,"text":"            IF SERIALIZE-PTR NOT = NULL"},{"line":270,"text":"                CALL SERIALIZE-PTR USING CHUNK-BLOCK-ENTITY(BLOCK-INDEX) NBTENC BUFFER"},{"line":271,"text":"            END-IF"},{"line":272,"text":""},{"line":273,"text":"            *> end block entity"},{"line":274,"text":"            CALL \"NbtEncode-EndCompound\" USING NBTENC BUFFER"},{"line":275,"text":"        END-IF"},{"line":276,"text":"    END-PERFORM"},{"line":277,"text":""},{"line":278,"text":"    *> end block entities"},{"line":279,"text":"    CALL \"NbtEncode-EndList\" USING NBTENC BUFFER"},{"line":280,"text":""},{"line":281,"text":"    *> end root tag"},{"line":282,"text":"    CALL \"NbtEncode-EndCompound\" USING NBTENC BUFFER"},{"line":283,"text":""},{"line":284,"text":"    *> Save the chunk"},{"line":285,"text":"    COMPUTE BUFFER-LENGTH = NBTENC-OFFSET - 1"},{"line":286,"text":"    MOVE FILE-TYPE-REGION TO FILE-TYPE"},{"line":287,"text":"    CALL \"Region-WriteChunkData\" USING FILE-TYPE CHUNK-X CHUNK-Z BUFFER BUFFER-LENGTH LK-FAILURE"},{"line":288,"text":"    IF LK-FAILURE NOT = 0"},{"line":289,"text":"        GOBACK"},{"line":290,"text":"    END-IF"},{"line":291,"text":""},{"line":292,"text":"    MOVE 0 TO CHUNK-DIRTY-BLOCKS"},{"line":293,"text":"    ."}],"name":"SAVECHUNKREGION","start_line":80,"symbol_id":"CobolCraft/src/world/chunk-io.cob#func:WORLD-SAVECHUNK.SAVECHUNKREGION"}}
