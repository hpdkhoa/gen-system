ORLD-LOADCHUNK.LOADCHUNKENTITIES","issues":null},"source":{"end_line":720,"file":"CobolCraft/src/world/chunk-io.cob","kind":"func","language":"cobol","lines":[{"line":624,"text":"LoadChunkEntities."},{"line":625,"text":"    *> Load the chunk entities from the entity data file"},{"line":626,"text":"    MOVE FILE-TYPE-ENTITY TO FILE-TYPE"},{"line":627,"text":""},{"line":628,"text":"    CALL \"Region-ReadChunkData\" USING FILE-TYPE LK-CHUNK-X LK-CHUNK-Z BUFFER BUFFER-LENGTH LK-FAILURE"},{"line":629,"text":"    IF LK-FAILURE NOT = 0 OR BUFFER-LENGTH = 0"},{"line":630,"text":"        *> It is not an error if the entity data file does not exist"},{"line":631,"text":"        MOVE 0 TO LK-FAILURE"},{"line":632,"text":"        GOBACK"},{"line":633,"text":"    END-IF"},{"line":634,"text":""},{"line":635,"text":"    *> start root tag"},{"line":636,"text":"    MOVE 1 TO NBTDEC-OFFSET"},{"line":637,"text":"    CALL \"NbtDecode-RootCompound\" USING NBTDEC BUFFER"},{"line":638,"text":""},{"line":639,"text":"    *> Skip ahead until we find the entities tag."},{"line":640,"text":"    CALL \"NbtDecode-SkipUntilTag\" USING NBTDEC BUFFER \"Entities\" AT-END"},{"line":641,"text":"    IF AT-END NOT = 0"},{"line":642,"text":"        GOBACK"},{"line":643,"text":"    END-IF"},{"line":644,"text":""},{"line":645,"text":"    *> start entities"},{"line":646,"text":"    CALL \"NbtDecode-List\" USING NBTDEC BUFFER CHUNK-ENTITY-COUNT"},{"line":647,"text":""},{"line":648,"text":"    *> Load in the same order as they were saved"},{"line":649,"text":"    PERFORM CHUNK-ENTITY-COUNT TIMES"},{"line":650,"text":"        IF CHUNK-ENTITY-LIST = NULL"},{"line":651,"text":"            *> First entity: allocate and set as list head"},{"line":652,"text":"            ALLOCATE ENTITY-LIST"},{"line":653,"text":"            INITIALIZE ENTITY-LIST"},{"line":654,"text":"            SET ENTITY-PTR TO ADDRESS OF ENTITY-LIST"},{"line":655,"text":"            SET CHUNK-ENTITY-LIST TO ADDRESS OF ENTITY-LIST"},{"line":656,"text":"        ELSE"},{"line":657,"text":"            *> Subsequent entities: allocate into next pointer"},{"line":658,"text":"            ALLOCATE LENGTH OF ENTITY-LIST CHARACTERS RETURNING ENTITY-LIST-NEXT"},{"line":659,"text":"            SET ADDRESS OF ENTITY-LIST TO ENTITY-LIST-NEXT"},{"line":660,"text":"            INITIALIZE ENTITY-LIST"},{"line":661,"text":"            SET ENTITY-PTR TO ENTITY-LIST-NEXT"},{"line":662,"text":"        END-IF"},{"line":663,"text":""},{"line":664,"text":"        *> start entity"},{"line":665,"text":"        CALL \"NbtDecode-Compound\" USING NBTDEC BUFFER"},{"line":666,"text":""},{"line":667,"text":"        *> find the entity type"},{"line":668,"text":"        MOVE NBTDEC TO SEEK-NBTDEC"},{"line":669,"text":"        CALL \"NbtDecode-SkipUntilTag\" USING SEEK-NBTDEC BUFFER \"id\" AT-END"},{"line":670,"text":"        IF AT-END > 0"},{"line":671,"text":"            DISPLAY \"ERROR: Entity missing id tag\""},{"line":672,"text":"            MOVE 1 TO LK-FAILURE"},{"line":673,"text":"            GOBACK"},{"line":674,"text":"        END-IF"},{"line":675,"text":""},{"line":676,"text":"        CALL \"NbtDecode-String\" USING SEEK-NBTDEC BUFFER STR LEN"},{"line":677,"text":"        CALL \"Registries-Lookup\" USING \"minecraft:entity_type\" STR(1:LEN) ENTITY-TYPE"},{"line":678,"text":"        IF ENTITY-TYPE < 0"},{"line":679,"text":"            DISPLAY \"ERROR: Unknown entity type: \" FUNCTION TRIM(STR(1:LEN))"},{"line":680,"text":"            MOVE 1 TO LK-FAILURE"},{"line":681,"text":"            GOBACK"},{"line":682,"text":"        END-IF"},{"line":683,"text":""},{"line":684,"text":"        *> Initialize default fields"},{"line":685,"text":"        CALL \"World-NextEntityId\" USING ENTITY-ID"},{"line":686,"text":"        MOVE CHUNK-X TO ENTITY-CHUNK-X"},{"line":687,"text":"        MOVE CHUNK-Z TO ENTITY-CHUNK-Z"},{"line":688,"text":""},{"line":689,"text":"        *> TODO remove these item entity-specific default fields"},{"line":690,"text":"        MOVE 2 TO ENTITY-ITEM-SLOT-NBT-LENGTH"},{"line":691,"text":"        MOVE X\"0000\" TO ENTITY-ITEM-SLOT-NBT-DATA"},{"line":692,"text":""},{"line":693,"text":"        *> obtain its deserialize routine"},{"line":694,"text":"        CALL \"GetCallback-EntityDeserialize\" USING ENTITY-TYPE DESERIALIZE-PTR"},{"line":695,"text":"        IF DESERIALIZE-PTR = NULL"},{"line":696,"text":"            DISPLAY \"No deserialize routine for entity type \" ENTITY-TYPE"},{"line":697,"text":"            MOVE 1 TO LK-FAILURE"},{"line":698,"text":"            GOBACK"},{"line":699,"text":"        END-IF"},{"line":700,"text":""},{"line":701,"text":"        *> deserialize the entity"},{"line":702,"text":"        PERFORM UNTIL EXIT"},{"line":703,"text":"            CALL \"NbtDecode-Peek\" USING NBTDEC BUFFER AT-END TAG"},{"line":704,"text":"            IF AT-END > 0"},{"line":705,"text":"                EXIT PERFORM"},{"line":706,"text":"            END-IF"},{"line":707,"text":"            CALL DESERIALIZE-PTR USING ENTITY-LIST-ENTITY NBTDEC BUFFER TAG"},{"line":708,"text":"        END-PERFORM"},{"line":709,"text":""},{"line":710,"text":"        *> end entity"},{"line":711,"text":"        CALL \"NbtDecode-EndCompound\" USING NBTDEC BUFFER"},{"line":712,"text":"    END-PERFORM"},{"line":713,"text":""},{"line":714,"text":"    *> end entities"},{"line":715,"text":"    CALL \"NbtDecode-EndList\" USING NBTDEC BUFFER"},{"line":716,"text":""},{"line":717,"text":"    *> end root tag"},{"line":718,"text":"    CALL \"NbtDecode-SkipRemainingTags\" USING NBTDEC BUFFER"},{"line":719,"text":"    CALL \"NbtDecode-EndCompound\" USING NBTDEC BUFFER"},{"line":720,"text":"    ."}],"name":"LOADCHUNKENTITIES","start_line":624,"symbol_id":"CobolCraft/src/world/chunk-io.cob#func:WORLD-LOADCHUNK.LOADCHUNKENTITIES"}}
