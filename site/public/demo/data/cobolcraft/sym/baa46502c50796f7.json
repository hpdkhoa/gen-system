{"flow":{"kind":"field","name":"LK-PROPERTY-NAME","noCFG":true,"reason":"LK-PROPERTY-NAME is a field: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":41,"file":"CobolCraft/src/blocks.cob","kind":"field","language":"cobol","lines":[{"line":1,"text":"*> --- Blocks-Parse ---"},{"line":2,"text":"*> Parse the blocks.json file. Afterwards, the parsed contents are stored in the BLOCKS shared data structure."},{"line":3,"text":"IDENTIFICATION DIVISION."},{"line":4,"text":"PROGRAM-ID. Blocks-Parse."},{"line":5,"text":""},{"line":6,"text":"DATA DIVISION."},{"line":7,"text":"WORKING-STORAGE SECTION."},{"line":8,"text":"    COPY DD-BLOCKS."},{"line":9,"text":"    01 BLOCK-NAME               PIC X(64)."},{"line":10,"text":"    01 BLOCK-ID                 BINARY-LONG."},{"line":11,"text":"    01 BLOCK-INDEX              BINARY-LONG UNSIGNED."},{"line":12,"text":"LOCAL-STORAGE SECTION."},{"line":13,"text":"    01 OFFSET                   BINARY-LONG UNSIGNED            VALUE 1."},{"line":14,"text":"    01 EXIT-LOOP                BINARY-CHAR UNSIGNED            VALUE 0."},{"line":15,"text":"LINKAGE SECTION."},{"line":16,"text":"    01 LK-JSON                  PIC X ANY LENGTH."},{"line":17,"text":"    01 LK-JSON-LEN              BINARY-LONG UNSIGNED."},{"line":18,"text":"    01 LK-FAILURE               BINARY-CHAR UNSIGNED."},{"line":19,"text":""},{"line":20,"text":"PROCEDURE DIVISION USING LK-JSON LK-JSON-LEN LK-FAILURE."},{"line":21,"text":"    INITIALIZE BLOCKS"},{"line":22,"text":""},{"line":23,"text":"    *> Expect start of the root object."},{"line":24,"text":"    CALL \"JsonParse-ObjectStart\" USING LK-JSON OFFSET LK-FAILURE"},{"line":25,"text":""},{"line":26,"text":"    *> Each key in the root object represents a block."},{"line":27,"text":"    PERFORM UNTIL LK-FAILURE NOT = 0 OR EXIT-LOOP = 1"},{"line":28,"text":"        ADD 1 TO BLOCK-COUNT"},{"line":29,"text":""},{"line":30,"text":"        CALL \"JsonParse-ObjectKey\" USING LK-JSON OFFSET LK-FAILURE BLOCK-NAME"},{"line":31,"text":"        IF LK-FAILURE NOT = 0"},{"line":32,"text":"            GOBACK"},{"line":33,"text":"        END-IF"},{"line":34,"text":""},{"line":35,"text":"        CALL \"Registries-Lookup\" USING \"minecraft:block\" BLOCK-NAME BLOCK-ID"},{"line":36,"text":"        IF BLOCK-ID < 0"},{"line":37,"text":"            MOVE 1 TO LK-FAILURE"},{"line":38,"text":"            GOBACK"},{"line":39,"text":"        END-IF"},{"line":40,"text":""},{"line":41,"text":"        COMPUTE BLOCK-INDEX = BLOCK-ID + 1"}],"name":"LK-PROPERTY-NAME","start_line":1,"symbol_id":"CobolCraft/src/blocks.cob#field:LK-PROPERTY.LK-PROPERTY-NAME"}}
