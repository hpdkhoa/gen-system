{"flow":{"kind":"field","name":"BLOCK-Z","noCFG":true,"reason":"BLOCK-Z is a field: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":41,"file":"CobolCraft/src/items/sign.cob","kind":"field","language":"cobol","lines":[{"line":1,"text":"*> --- RegisterItem-Sign ---"},{"line":2,"text":"IDENTIFICATION DIVISION."},{"line":3,"text":"PROGRAM-ID. RegisterItem-Sign."},{"line":4,"text":""},{"line":5,"text":"DATA DIVISION."},{"line":6,"text":"WORKING-STORAGE SECTION."},{"line":7,"text":"    01 ITEM-REGISTRY            BINARY-LONG                 GLOBAL."},{"line":8,"text":"    01 BLOCK-ENTITY-TYPE        BINARY-LONG                 GLOBAL."},{"line":9,"text":"    01 USE-PTR                  PROGRAM-POINTER."},{"line":10,"text":"    COPY DD-TAGS."},{"line":11,"text":"    01 IDX-REGISTRY             BINARY-LONG UNSIGNED."},{"line":12,"text":"    01 IDX-TAG                  BINARY-LONG UNSIGNED."},{"line":13,"text":"    01 IDX-ITEM                 BINARY-LONG UNSIGNED."},{"line":14,"text":"    01 ITEM-NAME                PIC X(64)."},{"line":15,"text":""},{"line":16,"text":"PROCEDURE DIVISION."},{"line":17,"text":"    CALL \"Registries-LookupRegistry\" USING \"minecraft:item\" ITEM-REGISTRY"},{"line":18,"text":""},{"line":19,"text":"    CALL \"Registries-Lookup\" USING \"minecraft:block_entity_type\" \"minecraft:sign\" BLOCK-ENTITY-TYPE"},{"line":20,"text":"    COPY ASSERT REPLACING COND BY ==BLOCK-ENTITY-TYPE >= 0==, MSG BY ==\"RegisterItem-Sign: Failed block entity lookup\"==."},{"line":21,"text":""},{"line":22,"text":"    SET USE-PTR TO ENTRY \"Callback-Use\""},{"line":23,"text":""},{"line":24,"text":"    *> Iterate over \"minecraft:signs\" tag to find sign items"},{"line":25,"text":"    *> TODO Make this simpler and reusable"},{"line":26,"text":""},{"line":27,"text":"    PERFORM VARYING IDX-REGISTRY FROM 1 BY 1 UNTIL IDX-REGISTRY > TAGS-REGISTRY-COUNT"},{"line":28,"text":"        IF TAGS-REGISTRY-NAME(IDX-REGISTRY) = \"minecraft:item\""},{"line":29,"text":"            EXIT PERFORM"},{"line":30,"text":"        END-IF"},{"line":31,"text":"    END-PERFORM"},{"line":32,"text":""},{"line":33,"text":"    PERFORM VARYING IDX-TAG FROM 1 BY 1 UNTIL IDX-TAG > TAGS-REGISTRY-LENGTH(IDX-REGISTRY)"},{"line":34,"text":"        IF TAGS-REGISTRY-TAG-NAME(IDX-REGISTRY, IDX-TAG) = \"minecraft:signs\""},{"line":35,"text":"            EXIT PERFORM"},{"line":36,"text":"        END-IF"},{"line":37,"text":"    END-PERFORM"},{"line":38,"text":""},{"line":39,"text":"    PERFORM VARYING IDX-ITEM FROM 1 BY 1 UNTIL IDX-ITEM > TAGS-REGISTRY-TAG-LENGTH(IDX-REGISTRY, IDX-TAG)"},{"line":40,"text":"        *> TODO avoid the name lookup"},{"line":41,"text":"        CALL \"Registries-EntryName\" USING ITEM-REGISTRY TAGS-REGISTRY-TAG-ENTRY(IDX-REGISTRY, IDX-TAG, IDX-ITEM) ITEM-NAME"}],"name":"BLOCK-Z","start_line":1,"symbol_id":"CobolCraft/src/items/sign.cob#field:BLOCK-POSITION.BLOCK-Z"}}
