T = 0"},{"line":612,"text":"            *> No data read, try again later"},{"line":613,"text":"            EXIT PARAGRAPH"},{"line":614,"text":"        END-IF"},{"line":615,"text":""},{"line":616,"text":"        ADD 1 TO PACKET-BUFFERLEN(CLIENT-ID)"},{"line":617,"text":"        MOVE BUFFER(1:1) TO CLIENT-RECEIVE-BUFFER(PACKET-BUFFERLEN(CLIENT-ID):1)"},{"line":618,"text":""},{"line":619,"text":"        *> Once the most significant bit is 0, the VarInt is complete."},{"line":620,"text":"        IF FUNCTION ORD(BUFFER) <= 128"},{"line":621,"text":"            MOVE 1 TO PACKET-OFFSET"},{"line":622,"text":"            CALL \"Decode-VarInt\" USING CLIENT-RECEIVE-BUFFER PACKET-OFFSET PACKET-LENGTH(CLIENT-ID)"},{"line":623,"text":"            IF PACKET-LENGTH(CLIENT-ID) < 1 OR PACKET-LENGTH(CLIENT-ID) > 2097151"},{"line":624,"text":"                DISPLAY \"[state=\" CLIENT-STATE(CLIENT-ID) \"] Received invalid packet length: \" PACKET-LENGTH(CLIENT-ID)"},{"line":625,"text":"                CALL \"Server-DisconnectClient\" USING CLIENT-ID"},{"line":626,"text":"                EXIT PARAGRAPH"},{"line":627,"text":"            END-IF"},{"line":628,"text":"            MOVE 0 TO PACKET-BUFFERLEN(CLIENT-ID)"},{"line":629,"text":"            EXIT PERFORM"},{"line":630,"text":"        END-IF"},{"line":631,"text":""},{"line":632,"text":"        IF PACKET-BUFFERLEN(CLIENT-ID) >= 5"},{"line":633,"text":"            DISPLAY \"[state=\" CLIENT-STATE(CLIENT-ID) \"] Received invalid packet length.\""},{"line":634,"text":"            CALL \"Server-DisconnectClient\" USING CLIENT-ID"},{"line":635,"text":"            EXIT PARAGRAPH"},{"line":636,"text":"        END-IF"},{"line":637,"text":"    END-PERFORM"},{"line":638,"text":""},{"line":639,"text":"    *> Receive the packet ID and payload"},{"line":640,"text":"    PERFORM UNTIL PACKET-BUFFERLEN(CLIENT-ID) >= PACKET-LENGTH(CLIENT-ID)"},{"line":641,"text":"        *> The socket library can only read up to 64 kB at a time."},{"line":642,"text":"        MOVE FUNCTION MIN(PACKET-LENGTH(CLIENT-ID) - PACKET-BUFFERLEN(CLIENT-ID), 64000) TO BYTE-COUNT-EXPECTED BYTE-COUNT"},{"line":643,"text":"        CALL \"SocketRead\" USING CLIENT-HNDL(CLIENT-ID) BYTE-COUNT CLIENT-RECEIVE-BUFFER(PACKET-BUFFERLEN(CLIENT-ID) + 1:) GIVING ERRNO"},{"line":644,"text":"        IF ERRNO NOT = 0"},{"line":645,"text":"            PERFORM HandleClientError"},{"line":646,"text":"            EXIT PARAGRAPH"},{"line":647,"text":"        END-IF"},{"line":648,"text":"        ADD BYTE-COUNT TO PACKET-BUFFERLEN(CLIENT-ID)"},{"line":649,"text":"        IF BYTE-COUNT < BYTE-COUNT-EXPECTED"},{"line":650,"text":"            *> Not enough data read, try again later"},{"line":651,"text":"            EXIT PARAGRAPH"},{"line":652,"text":"        END-IF"},{"line":653,"text":"    END-PERFORM"},{"line":654,"text":""},{"line":655,"text":"    *> Packet received, process it"},{"line":656,"text":"    MOVE 1 TO PACKET-OFFSET"},{"line":657,"text":"    CALL \"Decode-VarInt\" USING CLIENT-RECEIVE-BUFFER PACKET-OFFSET PACKET-ID"},{"line":658,"text":"    CALL \"HandlePacket\" USING CLIENT-ID CLIENT-STATE(CLIENT-ID) PACKET-ID CLIENT-RECEIVE-BUFFER PACKET-LENGTH(CLIENT-ID) PACKET-OFFSET"},{"line":659,"text":""},{"line":660,"text":"    *> Reset length for the next packet"},{"line":661,"text":"    MOVE 0 TO PACKET-LENGTH(CLIENT-ID)"},{"line":662,"text":"    MOVE 0 TO PACKET-BUFFERLEN(CLIENT-ID)"},{"line":663,"text":"    ."}],"name":"RECEIVEPACKET","start_line":594,"symbol_id":"CobolCraft/src/server.cob#func:RECEIVEPACKET"}}
