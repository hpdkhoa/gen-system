{"flow":{"kind":"field","name":"BLOCK-Z","noCFG":true,"reason":"BLOCK-Z is a field: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":41,"file":"CobolCraft/src/blocks/door.cob","kind":"field","language":"cobol","lines":[{"line":1,"text":"*> --- RegisterBlock-Door ---"},{"line":2,"text":"IDENTIFICATION DIVISION."},{"line":3,"text":"PROGRAM-ID. RegisterBlock-Door."},{"line":4,"text":""},{"line":5,"text":"DATA DIVISION."},{"line":6,"text":"WORKING-STORAGE SECTION."},{"line":7,"text":"    01 BLOCK-REGISTRY           BINARY-LONG."},{"line":8,"text":"    01 DESTROY-PTR              PROGRAM-POINTER."},{"line":9,"text":"    01 INTERACT-PTR             PROGRAM-POINTER."},{"line":10,"text":"    01 FACE-PTR                 PROGRAM-POINTER."},{"line":11,"text":"    01 BLOCK-COUNT              BINARY-LONG UNSIGNED."},{"line":12,"text":"    01 BLOCK-ID                 BINARY-LONG UNSIGNED."},{"line":13,"text":"    01 BLOCK-TYPE               PIC X(64)."},{"line":14,"text":"    01 BLOCK-MINIMUM-STATE-ID   BINARY-LONG."},{"line":15,"text":"    01 BLOCK-MAXIMUM-STATE-ID   BINARY-LONG."},{"line":16,"text":"    01 STATE-ID                 BINARY-LONG."},{"line":17,"text":""},{"line":18,"text":"PROCEDURE DIVISION."},{"line":19,"text":"    CALL \"Registries-LookupRegistry\" USING \"minecraft:block\" BLOCK-REGISTRY"},{"line":20,"text":""},{"line":21,"text":"    SET DESTROY-PTR TO ENTRY \"Callback-Destroy\""},{"line":22,"text":"    SET INTERACT-PTR TO ENTRY \"Callback-Interact\""},{"line":23,"text":"    SET FACE-PTR TO ENTRY \"Callback-Face\""},{"line":24,"text":""},{"line":25,"text":"    *> Loop over all blocks and register the callback for each matching block type"},{"line":26,"text":"    CALL \"Registries-EntryCount\" USING BLOCK-REGISTRY BLOCK-COUNT"},{"line":27,"text":"    PERFORM VARYING BLOCK-ID FROM 0 BY 1 UNTIL BLOCK-ID >= BLOCK-COUNT"},{"line":28,"text":"        CALL \"Blocks-GetType\" USING BLOCK-ID BLOCK-TYPE"},{"line":29,"text":"        *> TODO check for door block type (e.g., iron doors cannot be opened by clicking)"},{"line":30,"text":"        IF BLOCK-TYPE = \"minecraft:door\""},{"line":31,"text":"            CALL \"Blocks-GetStateIds\" USING BLOCK-ID BLOCK-MINIMUM-STATE-ID BLOCK-MAXIMUM-STATE-ID"},{"line":32,"text":"            PERFORM VARYING STATE-ID FROM BLOCK-MINIMUM-STATE-ID BY 1 UNTIL STATE-ID > BLOCK-MAXIMUM-STATE-ID"},{"line":33,"text":"                CALL \"SetCallback-BlockDestroy\" USING STATE-ID DESTROY-PTR"},{"line":34,"text":"                CALL \"SetCallback-BlockInteract\" USING STATE-ID INTERACT-PTR"},{"line":35,"text":"                CALL \"SetCallback-BlockFace\" USING STATE-ID FACE-PTR"},{"line":36,"text":"            END-PERFORM"},{"line":37,"text":"            *> TODO set metadata"},{"line":38,"text":"        END-IF"},{"line":39,"text":"    END-PERFORM"},{"line":40,"text":""},{"line":41,"text":"    GOBACK."}],"name":"BLOCK-Z","start_line":1,"symbol_id":"CobolCraft/src/blocks/door.cob#field:BLOCK-POSITION.BLOCK-Z"}}
