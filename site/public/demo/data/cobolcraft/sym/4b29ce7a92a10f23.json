text":"    END-PERFORM"},{"line":298,"text":""},{"line":299,"text":"    *> Move slots to the top edge"},{"line":300,"text":"    PERFORM 2 TIMES"},{"line":301,"text":"        IF CRAFTING-GRID-ID(1) = 0 AND CRAFTING-GRID-ID(2) = 0 AND CRAFTING-GRID-ID(3) = 0"},{"line":302,"text":"            MOVE CRAFTING-GRID-ID(4) TO CRAFTING-GRID-ID(1)"},{"line":303,"text":"            MOVE CRAFTING-GRID-ID(5) TO CRAFTING-GRID-ID(2)"},{"line":304,"text":"            MOVE CRAFTING-GRID-ID(6) TO CRAFTING-GRID-ID(3)"},{"line":305,"text":"            MOVE CRAFTING-GRID-ID(7) TO CRAFTING-GRID-ID(4)"},{"line":306,"text":"            MOVE CRAFTING-GRID-ID(8) TO CRAFTING-GRID-ID(5)"},{"line":307,"text":"            MOVE CRAFTING-GRID-ID(9) TO CRAFTING-GRID-ID(6)"},{"line":308,"text":"            MOVE 0 TO CRAFTING-GRID-ID(7) CRAFTING-GRID-ID(8) CRAFTING-GRID-ID(9)"},{"line":309,"text":"        END-IF"},{"line":310,"text":"    END-PERFORM"},{"line":311,"text":""},{"line":312,"text":"    *> match by comparing the normalized ingredient list"},{"line":313,"text":"    PERFORM VARYING RECIPE-INDEX FROM 1 BY 1 UNTIL RECIPE-INDEX > RECIPES-SHAPED-COUNT"},{"line":314,"text":"        IF RECIPE-SHAPED-INPUTS(RECIPE-INDEX) = CRAFTING-GRID"},{"line":315,"text":"            CALL \"SetRecipeOutput\" USING LK-SLOT(LK-OUTPUT-SLOT + 1) RECIPE-SHAPED-OUTPUT(RECIPE-INDEX)"},{"line":316,"text":"            GOBACK"},{"line":317,"text":"        END-IF"},{"line":318,"text":"    END-PERFORM"},{"line":319,"text":""},{"line":320,"text":"    *> check \"complex\" recipes (shaped recipes with multiple options per slot)"},{"line":321,"text":"    PERFORM VARYING RECIPE-INDEX FROM 1 BY 1 UNTIL RECIPE-INDEX > RECIPES-COMPLEX-COUNT"},{"line":322,"text":"        PERFORM VARYING SLOT FROM 1 BY 1 UNTIL SLOT > 9"},{"line":323,"text":"            MOVE 0 TO SLOT-MATCHED"},{"line":324,"text":"            PERFORM VARYING CHOICE-INDEX FROM 1 BY 1 UNTIL CHOICE-INDEX > RECIPE-COMPLEX-INPUT-OPTIONS(RECIPE-INDEX, SLOT)"},{"line":325,"text":"                IF RECIPE-COMPLEX-INPUT-ID(RECIPE-INDEX, SLOT, CHOICE-INDEX) = CRAFTING-GRID-ID(SLOT)"},{"line":326,"text":"                    MOVE 1 TO SLOT-MATCHED"},{"line":327,"text":"                    EXIT PERFORM"},{"line":328,"text":"                END-IF"},{"line":329,"text":"            END-PERFORM"},{"line":330,"text":"            IF SLOT-MATCHED = 0"},{"line":331,"text":"                EXIT PERFORM"},{"line":332,"text":"            END-IF"},{"line":333,"text":"        END-PERFORM"},{"line":334,"text":"        *> If we made it through all slots, the recipe matches"},{"line":335,"text":"        IF SLOT > 9"},{"line":336,"text":"            CALL \"SetRecipeOutput\" USING LK-SLOT(LK-OUTPUT-SLOT + 1) RECIPE-COMPLEX-OUTPUT(RECIPE-INDEX)"},{"line":337,"text":"            GOBACK"},{"line":338,"text":"        END-IF"},{"line":339,"text":"    END-PERFORM"},{"line":340,"text":"    ."}],"name":"MATCHSHAPEDRECIPES","start_line":285,"symbol_id":"CobolCraft/src/inventory/inventory.cob#func:INVENTORY-UPDATECRAFTINGOUTPUT.MATCHSHAPEDRECIPES"}}
