{"flow":{"kind":"field","name":"LK-OUTPUT-ID","noCFG":true,"reason":"LK-OUTPUT-ID is a field: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":41,"file":"CobolCraft/src/inventory/inventory.cob","kind":"field","language":"cobol","lines":[{"line":1,"text":"*> --- Inventory-SyncPlayerInventory ---"},{"line":2,"text":"*> Utility to synchronize the player's inventory with the client."},{"line":3,"text":"*> This can be called even with other windows open, and will always update the player's inventory (window ID 0)."},{"line":4,"text":"IDENTIFICATION DIVISION."},{"line":5,"text":"PROGRAM-ID. Inventory-SyncPlayerInventory."},{"line":6,"text":""},{"line":7,"text":"DATA DIVISION."},{"line":8,"text":"WORKING-STORAGE SECTION."},{"line":9,"text":"    COPY DD-CLIENTS."},{"line":10,"text":"    01 PLAYER-INVENTORY-WINDOW-TYPE BINARY-LONG                 VALUE -1."},{"line":11,"text":"    01 SYNC-PTR                     PROGRAM-POINTER."},{"line":12,"text":"LINKAGE SECTION."},{"line":13,"text":"    01 LK-PLAYER                    BINARY-LONG UNSIGNED."},{"line":14,"text":""},{"line":15,"text":"PROCEDURE DIVISION USING LK-PLAYER."},{"line":16,"text":"    IF SYNC-PTR = NULL"},{"line":17,"text":"        CALL \"GetCallback-WindowSync\" USING PLAYER-INVENTORY-WINDOW-TYPE SYNC-PTR"},{"line":18,"text":"    END-IF"},{"line":19,"text":"    CALL SYNC-PTR USING LK-PLAYER"},{"line":20,"text":"    GOBACK."},{"line":21,"text":""},{"line":22,"text":"END PROGRAM Inventory-SyncPlayerInventory."},{"line":23,"text":""},{"line":24,"text":"*> --- Inventory-PickItem ---"},{"line":25,"text":"*> Pick an item into the player's hotbar. If the item already exists in the inventory, the hotbar will be switched to"},{"line":26,"text":"*> that item. In creative mode, the item is added to the inventory if needed."},{"line":27,"text":"IDENTIFICATION DIVISION."},{"line":28,"text":"PROGRAM-ID. Inventory-PickItem."},{"line":29,"text":""},{"line":30,"text":"DATA DIVISION."},{"line":31,"text":"WORKING-STORAGE SECTION."},{"line":32,"text":"    COPY DD-PLAYERS."},{"line":33,"text":"    *> https://minecraft.wiki/w/Minecraft_Wiki:Projects/wiki.vg_merge/Inventory"},{"line":34,"text":"    *> slot 0: crafting output"},{"line":35,"text":"    *> slots 1-4: crafting input"},{"line":36,"text":"    *> slots 5-8: armor"},{"line":37,"text":"    *> slots 9-35: main inventory"},{"line":38,"text":"    *> slots 36-44: hotbar"},{"line":39,"text":"    *> slot 45: offhand"},{"line":40,"text":"    78 HOTBAR-START                 VALUE 37."},{"line":41,"text":"    78 HOTBAR-END                   VALUE 45."}],"name":"LK-OUTPUT-ID","start_line":1,"symbol_id":"CobolCraft/src/inventory/inventory.cob#field:LK-OUTPUT.LK-OUTPUT-ID"}}
