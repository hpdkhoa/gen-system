{"flow":{"kind":"field","name":"BLOCK-Y","noCFG":true,"reason":"BLOCK-Y is a field: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":41,"file":"CobolCraft/src/items/rotated-pillar.cob","kind":"field","language":"cobol","lines":[{"line":1,"text":"*> --- RegisterItem-RotatedPillar ---"},{"line":2,"text":"*> This is responsible for all rotated pillars, such as logs, basalt, bone blocks, etc."},{"line":3,"text":"IDENTIFICATION DIVISION."},{"line":4,"text":"PROGRAM-ID. RegisterItem-RotatedPillar."},{"line":5,"text":""},{"line":6,"text":"DATA DIVISION."},{"line":7,"text":"WORKING-STORAGE SECTION."},{"line":8,"text":"    01 BLOCK-REGISTRY           BINARY-LONG."},{"line":9,"text":"    01 USE-PTR                  PROGRAM-POINTER."},{"line":10,"text":"    01 BLOCK-COUNT              BINARY-LONG UNSIGNED."},{"line":11,"text":"    01 BLOCK-ID                 BINARY-LONG UNSIGNED."},{"line":12,"text":"    01 BLOCK-NAME               PIC X(64)."},{"line":13,"text":"    01 BLOCK-TYPE               PIC X(64)."},{"line":14,"text":""},{"line":15,"text":"PROCEDURE DIVISION."},{"line":16,"text":"    CALL \"Registries-LookupRegistry\" USING \"minecraft:block\" BLOCK-REGISTRY"},{"line":17,"text":""},{"line":18,"text":"    SET USE-PTR TO ENTRY \"Callback-Use\""},{"line":19,"text":""},{"line":20,"text":"    *> Loop over all blocks and register the callback for each rotated pillar"},{"line":21,"text":"    CALL \"Registries-EntryCount\" USING BLOCK-REGISTRY BLOCK-COUNT"},{"line":22,"text":"    PERFORM VARYING BLOCK-ID FROM 0 BY 1 UNTIL BLOCK-ID >= BLOCK-COUNT"},{"line":23,"text":"        CALL \"Blocks-GetType\" USING BLOCK-ID BLOCK-TYPE"},{"line":24,"text":"        IF BLOCK-TYPE = \"minecraft:rotated_pillar\""},{"line":25,"text":"            CALL \"Registries-EntryName\" USING BLOCK-REGISTRY BLOCK-ID BLOCK-NAME"},{"line":26,"text":"            CALL \"SetCallback-ItemUse\" USING BLOCK-NAME USE-PTR"},{"line":27,"text":"        END-IF"},{"line":28,"text":"    END-PERFORM"},{"line":29,"text":""},{"line":30,"text":"    GOBACK."},{"line":31,"text":""},{"line":32,"text":"    *> --- Callback-Use ---"},{"line":33,"text":"    IDENTIFICATION DIVISION."},{"line":34,"text":"    PROGRAM-ID. Callback-Use."},{"line":35,"text":""},{"line":36,"text":"    DATA DIVISION."},{"line":37,"text":"    WORKING-STORAGE SECTION."},{"line":38,"text":"        COPY DD-PLAYERS."},{"line":39,"text":"        *> Block state description for the pillar variant."},{"line":40,"text":"        COPY DD-BLOCK-STATE REPLACING LEADING ==PREFIX== BY ==PLACE==."},{"line":41,"text":"        01 BLOCK-POSITION."}],"name":"BLOCK-Y","start_line":1,"symbol_id":"CobolCraft/src/items/rotated-pillar.cob#field:BLOCK-POSITION.BLOCK-Y"}}
