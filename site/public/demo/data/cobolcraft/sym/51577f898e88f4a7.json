 EXIT"},{"line":371,"text":"        CALL \"SystemTimeMicros\" USING CURRENT-TIME"},{"line":372,"text":"        MOVE CURRENT-TIME TO TICK-STARTTIME"},{"line":373,"text":"        COMPUTE TICK-ENDTIME = TICK-STARTTIME + GAME-TICK-INTERVAL"},{"line":374,"text":""},{"line":375,"text":"        COMPUTE TEMP-INT64 = CURRENT-TIME - LAST-AUTOSAVE"},{"line":376,"text":"        IF TEMP-INT64 >= AUTOSAVE-INTERVAL"},{"line":377,"text":"            CALL \"Server-Save\""},{"line":378,"text":"            MOVE CURRENT-TIME TO LAST-AUTOSAVE"},{"line":379,"text":"        END-IF"},{"line":380,"text":""},{"line":381,"text":"        *> Update the game state"},{"line":382,"text":"        PERFORM GameLoop"},{"line":383,"text":""},{"line":384,"text":"        *> Handle keep-alive and disconnections for connected clients"},{"line":385,"text":"        PERFORM VARYING CLIENT-ID FROM 1 BY 1 UNTIL CLIENT-ID > MAX-CLIENTS"},{"line":386,"text":"            EVALUATE TRUE"},{"line":387,"text":"                WHEN CLIENT-STATE(CLIENT-ID) = CLIENT-STATE-DISCONNECTED"},{"line":388,"text":"                    CONTINUE"},{"line":389,"text":"                WHEN CLIENT-ERRNO-SEND(CLIENT-ID) NOT = 0"},{"line":390,"text":"                    MOVE CLIENT-ERRNO-SEND(CLIENT-ID) TO ERRNO"},{"line":391,"text":"                    PERFORM HandleClientError"},{"line":392,"text":"                WHEN CLIENT-STATE(CLIENT-ID) = CLIENT-STATE-PLAY"},{"line":393,"text":"                    PERFORM KeepAlive"},{"line":394,"text":"            END-EVALUATE"},{"line":395,"text":"        END-PERFORM"},{"line":396,"text":""},{"line":397,"text":"        *> Send world time every second"},{"line":398,"text":"        CALL \"World-GetAge\" USING TEMP-INT64"},{"line":399,"text":"        IF FUNCTION MOD(TEMP-INT64, 20) = 0"},{"line":400,"text":"            CALL \"World-GetTime\" USING TEMP-INT64-2"},{"line":401,"text":"            PERFORM VARYING CLIENT-ID FROM 1 BY 1 UNTIL CLIENT-ID > MAX-CLIENTS"},{"line":402,"text":"                IF CLIENT-STATE(CLIENT-ID) = CLIENT-STATE-PLAY"},{"line":403,"text":"                    CALL \"SendPacket-UpdateTime\" USING CLIENT-ID TEMP-INT64 TEMP-INT64-2"},{"line":404,"text":"                END-IF"},{"line":405,"text":"            END-PERFORM"},{"line":406,"text":"        END-IF"},{"line":407,"text":""},{"line":408,"text":"        *> broadcast player positions to all clients in play state, as well as their equipment"},{"line":409,"text":"        *> TODO: only send this if the player has moved/rotated, or if the equipment has changed"},{"line":410,"text":"        *> TODO: use more efficient packet types when possible"},{"line":411,"text":"        PERFORM VARYING CLIENT-ID FROM 1 BY 1 UNTIL CLIENT-ID > MAX-CLIENTS"},{"line":412,"text":"            IF CLIENT-STATE(CLIENT-ID) = CLIENT-STATE-PLAY"},{"line":413,"text":"                *> Note: Since sending the packet can fail, we need to stop the loop if the client is disconnected."},{"line":414,"text":"                PERFORM VARYING TEMP-INT16 FROM 1 BY 1 UNTIL TEMP-INT16 > MAX-CLIENTS OR CLIENT-STATE(CLIENT-ID) = CLIENT-STATE-DISCONNECTED"},{"line":415,"text":"                    IF CLIENT-STATE(TEMP-INT16) = CLIENT-STATE-PLAY AND TEMP-INT16 NOT = CLIENT-ID"},{"line":416,"text":"                        MOVE CLIENT-PLAYER(TEMP-INT16) TO TEMP-INT32"},{"line":417,"text":"                        CALL \"SendPacket-EntityPositionSync\" USING CLIENT-ID TEMP-INT32"},{"line":418,"text":"                            PLAYER-POSITION(TEMP-INT32) PLAYER-ROTATION(TEMP-INT32) PLAYER-VELOCITY(TEMP-INT32) PLAYER-ON-GROUND(TEMP-INT32)"},{"line":419,"text":"                        CALL \"SendPacket-SetHeadRotation\" USING CLIENT-ID TEMP-INT32 PLAYER-YAW(TEMP-INT32)"},{"line":420,"text":"                        IF PLAYER-BLOCK-BREAKING-STAGE(TEMP-INT32) >= 0"},{"line":421,"text":"                            CALL \"SendPacket-BlockDestruction\" USING CLIENT-ID TEMP-INT32 PLAYER-BLOCK-BREAKING-POSITION(TEMP-INT32) PLAYER-BLOCK-BREAKING-STAGE(TEMP-INT32)"},{"line":422,"text":"                        END-IF"},{"line":423,"text":"                        *> index(byte), type(VarInt), value(VarInt)"},{"line":424,"text":"                        *> index of pose: 6, type of pose: 21"},{"line":425,"text":"                        *> value of standing: 0, value of sneaking: 5"},{"line":426,"text":"                        MOVE X\"06\" TO BUFFER(1:1)"},{"line":427,"text":"                        MOVE X\"15\" TO BUFFER(2:1)"},{"line":428,"text":"                        IF PLAYER-SNEAKING(TEMP-INT32) = 1"},{"line":429,"text":"                            MOVE X\"05\" TO BUFFER(3:1)"},{"line":430,"text":"                        ELSE"},{"line":431,"text":"                            MOVE X\"00\" TO BUFFER(3:1)"},{"line":432,"text":"                        END-IF"},{"line":433,"text":"                        *> index of health: 9, type of health: float(3)"},{"line":434,"text":"                        MOVE X\"09\" TO BUFFER(4:1)"},{"line":435,"text":"                        MOVE X\"03\" TO BUFFER(5:1)"},{"line":436,"text":"                        MOVE 6 TO BYTE-COUNT"},{"line":437,"text":"                        CALL \"Encode-Float\" USING PLAYER-HEALTH(TEMP-INT32) BUFFER BYTE-COUNT"},{"line":438,"text":"                        *> terminator is 0xFF"},{"line":439,"text":"                        MOVE X\"FF\" TO BUFFER(10:1)"},{"line":440,"text":"                        MOVE 10 TO BYTE-COUNT"},{"line":441,"text":"                        CALL \"SendPacket-SetEntityMetadata\" USING CLIENT-ID TEMP-INT32 BYTE-COUNT BUFFER"},{"line":442,"text":"                        *> main hand item"},{"line":443,"text":"                        MOVE 0 TO TEMP-INT8"},{"line":444,"text":"                        COMPUTE TEMP-INT64 = 36 + PLAYER-HOTBAR(TEMP-INT32) + 1"},{"line":445,"text":"                        CALL \"SendPacket-SetEquipment\" USING CLIENT-ID TEMP-INT32 TEMP-INT8 PLAYER-INVENTORY-SLOT(TEMP-INT32, TEMP-INT64)"},{"line":446,"text":"                        *> offhand item"},{"line":447,"text":"                        MOVE 1 TO TEMP-INT8"},{"line":448,"text":"                        CALL \"SendPacket-SetEquipment\" USING CLIENT-ID TEMP-INT32 TEMP-INT8 PLAYER-INVENTORY-SLOT(TEMP-INT32, 45 + 1)"},{"line":449,"text":"                        *> boots"},{"line":450,"text":"                        MOVE 2 TO TEMP-INT8"},{"line":451,"text":"                        CALL \"SendPacket-SetEquipment\" USING CLIENT-ID TEMP-INT32 TEMP-INT8 PLAYER-INVENTORY-SLOT(TEMP-INT32, 8 + 1)"},{"line":452,"text":"                        *> leggings"},{"line":453,"text":"                        MOVE 3 TO TEMP-INT8"},{"line":454,"text":"                        CALL \"SendPacket-SetEquipment\" USING CLIENT-ID TEMP-INT32 TEMP-INT8 PLAYER-INVENTORY-SLOT(TEMP-INT32, 7 + 1)"},{"line":455,"text":"                        *> chestplate"},{"line":456,"text":"                        MOVE 4 TO TEMP-INT8"},{"line":457,"text":"                        CALL \"SendPacket-SetEquipment\" USING CLIENT-ID TEMP-INT32 TEMP-INT8 PLAYER-INVENTORY-SLOT(TEMP-INT32, 6 + 1)"},{"line":458,"text":"                        *> helmet"},{"line":459,"text":"                        MOVE 5 TO TEMP-INT8"},{"line":460,"text":"                        CALL \"SendPacket-SetEquipment\" USING CLIENT-ID TEMP-INT32 TEMP-INT8 PLAYER-INVENTORY-SLOT(TEMP-INT32, 5 + 1)"},{"line":461,"text":"                    END-IF"},{"line":462,"text":"                END-PERFORM"},{"line":463,"text":"            END-IF"},{"line":464,"text":"        END-PERFORM"},{"line":465,"text":""},{"line":466,"text":"        *> update chunks around players"},{"line":467,"text":"        CALL \"ProcessClientChunks\""},{"line":468,"text":""},{"line":469,"text":"        *> Send debug sample for the past tick"},{"line":470,"text":"        PERFORM SendDebugSamples"},{"line":471,"text":""},{"line":472,"text":"        CALL \"SystemTimeMicros\" USING CURRENT-TIME"},{"line":473,"text":"        COMPUTE TICK-MAIN-DURATION = CURRENT-TIME - TICK-STARTTIME"},{"line":474,"text":""},{"line":475,"text":"        *> Read console command"},{"line":476,"text":"        PERFORM ConsoleInput"},{"line":477,"text":""},{"line":478,"text":"        *> The remaining time of this tick can be used for accepting connections and receiving packets."},{"line":479,"text":"        CALL \"SystemTimeMicros\" USING CURRENT-TIME"},{"line":480,"text":"        MOVE 0 TO TICK-SLEEP-DURATION"},{"line":481,"text":"        PERFORM UNTIL CURRENT-TIME >= TICK-ENDTIME"},{"line":482,"text":"            PERFORM NetworkRead"},{"line":483,"text":"            CALL \"SystemTimeMicros\" USING CURRENT-TIME"},{"line":484,"text":"        END-PERFORM"},{"line":485,"text":""},{"line":486,"text":"        *> debug samples are measured in nanoseconds"},{"line":487,"text":"        COMPUTE DEBUG-SAMPLE-FULL = (CURRENT-TIME - TICK-STARTTIME) * NANOSECOND-SCALE"},{"line":488,"text":"        COMPUTE DEBUG-SAMPLE-MAIN = TICK-MAIN-DURATION * NANOSECOND-SCALE"},{"line":489,"text":"        COMPUTE DEBUG-SAMPLE-IDLE = TICK-SLEEP-DURATION * NANOSECOND-SCALE"},{"line":490,"text":"        COMPUTE DEBUG-SAMPLE-TASKS = DEBUG-SAMPLE-FULL - DEBUG-SAMPLE-MAIN - DEBUG-SAMPLE-IDLE"},{"line":491,"text":""},{"line":492,"text":"        MOVE X\"00000000\" TO TEMP-HNDL"},{"line":493,"text":"        MOVE 0 TO CLIENT-ID"},{"line":494,"text":"    END-PERFORM"},{"line":495,"text":"    ."}],"name":"SERVERLOOP","start_line":368,"symbol_id":"CobolCraft/src/server.cob#func:SERVERLOOP"}}
