{"flow":{"kind":"field","name":"EMP-GRADE","noCFG":true,"reason":"EMP-GRADE is a field: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":41,"file":"examples/payroll/PAYROLL.cbl","kind":"field","language":"cobol","lines":[{"line":1,"text":"       IDENTIFICATION DIVISION."},{"line":2,"text":"       PROGRAM-ID. PAYROLL."},{"line":3,"text":"      * A small batch payroll run, written for the gen-system examples."},{"line":4,"text":"      * It reads employees, computes gross, tax and net pay, writes a"},{"line":5,"text":"      * payslip line per employee and records each run in the database."},{"line":6,"text":"       ENVIRONMENT DIVISION."},{"line":7,"text":"       INPUT-OUTPUT SECTION."},{"line":8,"text":"       FILE-CONTROL."},{"line":9,"text":"           SELECT EMPLOYEE-FILE ASSIGN TO \"EMPLOYEES.DAT\""},{"line":10,"text":"               ORGANIZATION IS LINE SEQUENTIAL."},{"line":11,"text":"           SELECT PAYSLIP-FILE ASSIGN TO \"PAYSLIPS.DAT\""},{"line":12,"text":"               ORGANIZATION IS LINE SEQUENTIAL."},{"line":13,"text":"       DATA DIVISION."},{"line":14,"text":"       FILE SECTION."},{"line":15,"text":"       FD EMPLOYEE-FILE."},{"line":16,"text":"       COPY EMPREC."},{"line":17,"text":"       FD PAYSLIP-FILE."},{"line":18,"text":"       COPY PAYSLIP."},{"line":19,"text":"       WORKING-STORAGE SECTION."},{"line":20,"text":"       01 WS-EOF              PIC X VALUE \"N\"."},{"line":21,"text":"       01 WS-GROSS            PIC 9(7)V99."},{"line":22,"text":"       01 WS-TAX              PIC 9(7)V99."},{"line":23,"text":"       01 WS-TAX-RATE         PIC V999."},{"line":24,"text":"       01 WS-OVERTIME         PIC 9(3)V9."},{"line":25,"text":"       01 WS-COUNT            PIC 9(6) VALUE 0."},{"line":26,"text":"       PROCEDURE DIVISION."},{"line":27,"text":"       MAIN-PARA."},{"line":28,"text":"           OPEN INPUT EMPLOYEE-FILE"},{"line":29,"text":"           OPEN OUTPUT PAYSLIP-FILE"},{"line":30,"text":"           PERFORM UNTIL WS-EOF = \"Y\""},{"line":31,"text":"               READ EMPLOYEE-FILE"},{"line":32,"text":"                   AT END"},{"line":33,"text":"                       MOVE \"Y\" TO WS-EOF"},{"line":34,"text":"                   NOT AT END"},{"line":35,"text":"                       PERFORM PROCESS-EMPLOYEE"},{"line":36,"text":"               END-READ"},{"line":37,"text":"           END-PERFORM"},{"line":38,"text":"           PERFORM RECORD-RUN"},{"line":39,"text":"           CLOSE EMPLOYEE-FILE"},{"line":40,"text":"           CLOSE PAYSLIP-FILE"},{"line":41,"text":"           STOP RUN."}],"name":"EMP-GRADE","start_line":1,"symbol_id":"examples/payroll/PAYROLL.cbl#field:EMPLOYEE-RECORD.EMP-GRADE"}}
