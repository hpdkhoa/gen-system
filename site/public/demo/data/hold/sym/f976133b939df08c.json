 cam = bpy.data.objects.get(\"poselab\") or bpy.data.objects.new(\"poselab\", cam_data)\r"},{"line":4154,"text":"        if cam.name not in self.sc.collection.objects:\r"},{"line":4155,"text":"            self.sc.collection.objects.link(cam)\r"},{"line":4156,"text":"        cam_data.lens_unit = 'FOV'\r"},{"line":4157,"text":"        self.sc.camera = cam\r"},{"line":4158,"text":"        self.sc.render.engine = 'BLENDER_WORKBENCH'\r"},{"line":4159,"text":"        sh = self.sc.display.shading\r"},{"line":4160,"text":"        sh.light = 'STUDIO'\r"},{"line":4161,"text":"        sh.show_cavity, sh.cavity_type = True, 'BOTH'          # edges and creases read at a glance\r"},{"line":4162,"text":"        sh.show_shadows, sh.shadow_intensity = True, 0.35\r"},{"line":4163,"text":"        sh.show_specular_highlight = True\r"},{"line":4164,"text":"        self.sc.display.render_aa = '16'\r"},{"line":4165,"text":"        if self.R.get(\"styled\"):\r"},{"line":4166,"text":"            sh.color_type = 'MATERIAL'                          # the sample's own colours\r"},{"line":4167,"text":"        else:\r"},{"line":4168,"text":"            sh.color_type = 'OBJECT'                            # a plain arms-and-rifle look for any rig\r"},{"line":4169,"text":"            for m in self.meshes:\r"},{"line":4170,"text":"                m.color = (0.55, 0.6, 0.7, 1)\r"},{"line":4171,"text":"            self.rifle_mesh.color = (0.12, 0.12, 0.13, 1)\r"},{"line":4172,"text":"        self.sc.render.resolution_x, self.sc.render.resolution_y = size\r"},{"line":4173,"text":"        G = self._gun()\r"},{"line":4174,"text":"        centre = self._point(\"bore\") if \"bore\" in self.R.get(\"points\", {}) else G.translation\r"},{"line":4175,"text":"        base = Vector(self.R.get(\"points\", {}).get(\"bore\", (0, 0, 0)))\r"},{"line":4176,"text":"        spots = {\"right\": (-70.0, 10.0, 25.0), \"left\": (70.0, 10.0, 25.0), \"top\": (-8.0, 10.0, 75.0), \"front\": (-25.0, 90.0, 20.0)}\r"},{"line":4177,"text":"        paths = []\r"},{"line":4178,"text":"        for v in views:\r"},{"line":4179,"text":"            if v == \"eye\":\r"},{"line":4180,"text":"                cam_data.type = 'PERSP'\r"},{"line":4181,"text":"                cam_data.angle = math.radians(H_FOV)\r"},{"line":4182,"text":"                cam_data.clip_start = 0.05\r"},{"line":4183,"text":"                cam.location = self.eye\r"},{"line":4184,"text":"                cam.rotation_euler = VIEW_FWD.to_track_quat('-Z', 'Y').to_euler()\r"},{"line":4185,"text":"            elif v in spots:\r"},{"line":4186,"text":"                cam_data.type = 'ORTHO' if ortho_cm else 'PERSP'\r"},{"line":4187,"text":"                if ortho_cm:\r"},{"line":4188,"text":"                    cam_data.ortho_scale = ortho_cm / 100.0\r"},{"line":4189,"text":"                cam_data.angle = math.radians(40.0)\r"},{"line":4190,"text":"                cam_data.clip_start = 0.01\r"},{"line":4191,"text":"                cam.location = G @ ue(base + Vector(spots[v]))\r"},{"line":4192,"text":"                if ortho_cm:\r"},{"line":4193,"text":"                    # straight on, the frame centred on the hold (the hands are below the bore)\r"},{"line":4194,"text":"                    drop = G.to_quaternion() @ Vector((0.0, 0.0, -0.05))\r"},{"line":4195,"text":"                    centre_v = centre + drop\r"},{"line":4196,"text":"                    cam.location = cam.location + drop\r"},{"line":4197,"text":"                else:\r"},{"line":4198,"text":"                    centre_v = centre\r"},{"line":4199,"text":"                if aim is not None:\r"},{"line":4200,"text":"                    # the outside views aimed at a given world point (the hold), from the same side\r"},{"line":4201,"text":"                    c_ = Vector(aim)\r"},{"line":4202,"text":"                    cam.location = cam.location + (c_ - centre_v)\r"},{"line":4203,"text":"                    centre_v = c_\r"},{"line":4204,"text":"                zc = (cam.location - centre_v).normalized()\r"},{"line":4205,"text":"                upv = G.to_quaternion() @ Vector((0.0, 0.0, 1.0))\r"},{"line":4206,"text":"                if abs(upv.dot(zc)) > 0.95:\r"},{"line":4207,"text":"                    upv = G.to_quaternion() @ Vector((0.0, -1.0, 0.0))\r"},{"line":4208,"text":"                xc = upv.cross(zc).normalized()\r"},{"line":4209,"text":"                cam.rotation_euler = Matrix((xc, zc.cross(xc), zc)).transposed().to_euler()\r"},{"line":4210,"text":"            else:\r"},{"line":4211,"text":"                raise ValueError(\"views: eye, right, left, top, front\")\r"},{"line":4212,"text":"            path = self._own(os.path.join(out_dir, \"%s_%s.png\" % (self.rig, v)))\r"},{"line":4213,"text":"            self.sc.render.filepath = path\r"},{"line":4214,"text":"            bpy.ops.render.render(write_still=True)\r"},{"line":4215,"text":"            paths.append({\"view\": v, \"path\": path})\r"},{"line":4216,"text":"        return {\"images\": paths}\r"}],"name":"render","start_line":4141,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:render"}}
