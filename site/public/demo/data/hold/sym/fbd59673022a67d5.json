   cv2, np = _cv()\r"},{"line":149,"text":"    f = Fg.figure(gun, fig_id)\r"},{"line":150,"text":"    m = ink(gun, f, threshold)\r"},{"line":151,"text":"    if gap_px:\r"},{"line":152,"text":"        m = cv2.dilate(m, cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2 * gap_px + 1, 2 * gap_px + 1)))\r"},{"line":153,"text":"    sx, sy = int(seed[0]), int(seed[1])\r"},{"line":154,"text":"    if m[sy, sx]:\r"},{"line":155,"text":"        raise ValueError(\"the seed (%d, %d) is on ink; put it inside the part's area\" % (sx, sy))\r"},{"line":156,"text":"    h, w = m.shape\r"},{"line":157,"text":"    pad = np.zeros((h + 2, w + 2), np.uint8)\r"},{"line":158,"text":"    flood = m.copy()\r"},{"line":159,"text":"    cv2.floodFill(flood, pad, (sx, sy), 128)\r"},{"line":160,"text":"    area = (flood == 128).astype(np.uint8) * 255\r"},{"line":161,"text":"    if area[0, :].any() or area[-1, :].any() or area[:, 0].any() or area[:, -1].any():\r"},{"line":162,"text":"        raise ValueError(\"the area round (%d, %d) runs out to the picture's edge: its lines do not close (try a larger gap_px)\" % (sx, sy))\r"},{"line":163,"text":"    if gap_px:\r"},{"line":164,"text":"        area = cv2.dilate(area, cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2 * gap_px + 1, 2 * gap_px + 1)))\r"},{"line":165,"text":"    poly, a = _outline(_fill_holes(area), eps_px)\r"},{"line":166,"text":"    return _result(gun, f, poly, a, \"region\", name)\r"}],"name":"region","start_line":145,"symbol_id":"hold-code/weaponlab/blueprint/trace.py#func:region"}}
