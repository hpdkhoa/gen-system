{"flow":{"blocks":[{"id":0,"label":"entry","lines":[{"kind":"call","line":65,"text":"pts = ccw([p for i, p in enumerate(outline) if i == 0 or p != outline[i - 1]])"},{"kind":"call","line":66,"text":"me = bpy.data.meshes.new(name)"},{"kind":"call","line":67,"text":"bm = bmesh.new()"},{"kind":"call","line":68,"text":"a = [bm.verts.new(g(x0, y, z)) for y, z in pts]"},{"kind":"call","line":69,"text":"b = [bm.verts.new(g(x1, y, z)) for y, z in pts]"},{"kind":"call","line":70,"text":"n = len(pts)"},{"kind":"call","line":71,"text":"bm.faces.new(list(reversed(a)))"},{"kind":"call","line":72,"text":"bm.faces.new(b)"},{"kind":"call","line":73,"text":"for i in range(n):"}],"preds":null,"stmts":["call ccw","call enumerate","call bpy.data.meshes.new","call bmesh.new","call bm.verts.new","call g","call bm.verts.new","call g","call len","call bm.faces.new","call list","call reversed","call bm.faces.new","call range"],"succs":[1]},{"cond":"for i in range(n)","id":1,"label":"loop_header","preds":[0,2],"stmts":null,"succs":[2,3]},{"id":2,"label":"loop_body","lines":[{"kind":"call","line":75,"text":"bm.faces.new([a[i], a[j], b[j], b[i]])"}],"preds":[1],"stmts":["call bm.faces.new"],"succs":[1]},{"id":3,"label":"loop_exit","lines":[{"kind":"call","line":76,"text":"bmesh.ops.recalc_face_normals(bm, faces=bm.faces)"},{"kind":"call","line":77,"text":"bm.to_mesh(me)"},{"kind":"call","line":78,"text":"bm.free()"},{"kind":"call","line":79,"text":"ob = bpy.data.objects.new(name, me)"},{"kind":"call","line":80,"text":"bpy.context.scene.collection.objects.link(ob)"},{"kind":"return","line":81,"text":"return ob"}],"preds":[1],"stmts":["call bmesh.ops.recalc_face_normals","call bm.to_mesh","call bm.free","call bpy.data.objects.new","call bpy.context.scene.collection.objects.link","return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[3],"func_id":"hold-code/weaponlab/blueprint/blender/blueprint_build.py#func:prism","issues":null},"source":{"end_line":81,"file":"hold-code/weaponlab/blueprint/blender/blueprint_build.py","kind":"func","language":"python","lines":[{"line":63,"text":"def prism(name, outline, x0, x1):\r"},{"line":64,"text":"    \"\"\"A side outline (y, z) run from x0 to x1: its two faces and its walls, closed.\"\"\"\r"},{"line":65,"text":"    pts = ccw([p for i, p in enumerate(outline) if i == 0 or p != outline[i - 1]])\r"},{"line":66,"text":"    me = bpy.data.meshes.new(name)\r"},{"line":67,"text":"    bm = bmesh.new()\r"},{"line":68,"text":"    a = [bm.verts.new(g(x0, y, z)) for y, z in pts]\r"},{"line":69,"text":"    b = [bm.verts.new(g(x1, y, z)) for y, z in pts]\r"},{"line":70,"text":"    n = len(pts)\r"},{"line":71,"text":"    bm.faces.new(list(reversed(a)))\r"},{"line":72,"text":"    bm.faces.new(b)\r"},{"line":73,"text":"    for i in range(n):\r"},{"line":74,"text":"        j = (i + 1) % n\r"},{"line":75,"text":"        bm.faces.new([a[i], a[j], b[j], b[i]])\r"},{"line":76,"text":"    bmesh.ops.recalc_face_normals(bm, faces=bm.faces)\r"},{"line":77,"text":"    bm.to_mesh(me)\r"},{"line":78,"text":"    bm.free()\r"},{"line":79,"text":"    ob = bpy.data.objects.new(name, me)\r"},{"line":80,"text":"    bpy.context.scene.collection.objects.link(ob)\r"},{"line":81,"text":"    return ob\r"}],"name":"prism","start_line":63,"symbol_id":"hold-code/weaponlab/blueprint/blender/blueprint_build.py#func:prism"}}
