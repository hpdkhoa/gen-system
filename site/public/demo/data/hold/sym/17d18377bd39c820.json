recalc_face_normals(bm, faces=bm.faces)\r"},{"line":77,"text":"    bm.to_mesh(me)\r"},{"line":78,"text":"    bm.free()\r"},{"line":79,"text":"    ob = bpy.data.objects.new(name, me)\r"},{"line":80,"text":"    bpy.context.scene.collection.objects.link(ob)\r"},{"line":81,"text":"    return ob\r"}],"name":"prism","start_line":63,"symbol_id":"hold-code/weaponlab/blueprint/blender/blueprint_build.py#func:prism"}}
