"label":"merge","lines":[{"kind":"call","line":208,"text":"m = max(1, int(area / (sp * sp)))"},{"kind":"call","line":209,"text":"r1, r2 = rng.random(m), rng.random(m)"},{"kind":"call","line":210,"text":"s1 = np.sqrt(r1)"},{"kind":"call","line":212,"text":"acc.setdefault(part, ([], []))"},{"kind":"call","line":213,"text":"acc[part][0].append(pts)"},{"kind":"call","line":214,"text":"acc[part][1].append(np.repeat(n[None, :], m, 0))"}],"preds":[45,43],"stmts":["call max","call int","call rng.random","call rng.random","call np.sqrt","call acc.setdefault","call ?.append","call ?.append","call np.repeat"],"succs":[42]},{"cond":"for (k, v) in acc.items()","id":47,"label":"loop_header","preds":[41,48],"stmts":null,"succs":[48,49]},{"id":48,"label":"loop_body","lines":[{"kind":"call","line":217,"text":"Fi = self._obj_frame(k).inverted()"},{"kind":"call","line":218,"text":"R_ = np.array(Fi.to_3x3())"},{"kind":"call","line":219,"text":"T_ = np.array(Fi.translation)"},{"kind":"call","line":220,"text":"Pw, Nw = np.vstack(v[0]), np.vstack(v[1])"},{"kind":"call","line":223,"text":"Nl /= np.maximum(np.linalg.norm(Nl, axis=1, keepdims=True), 1e-12)"}],"preds":[47],"stmts":["call ?.inverted","call np.array","call Fi.to_3x3","call np.array","call np.vstack","call np.vstack","call np.maximum","call np.linalg.norm"],"succs":[47]},{"id":49,"label":"loop_exit","lines":[{"kind":"return","line":225,"text":"return out"}],"preds":[47],"stmts":["return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[49],"func_id":"hold-code/poselab_mcp/blender/holdlab.py#func:_part_points","issues":null},"source":{"end_line":225,"file":"hold-code/poselab_mcp/blender/holdlab.py","kind":"func","language":"python","lines":[{"line":156,"text":"    def _part_points(self, spacing_cm=0.2, seed=11):\r"},{"line":157,"text":"        \"\"\"Every part's surface sampled about spacing_cm apart, in the object's frame (m): {part: (n x 3 points,\r"},{"line":158,"text":"        n x 3 normals)}, with the parts' bones at rest. A part is a vertex group (the heaviest of a polygon's\r"},{"line":159,"text":"        vertices), else a connected piece.\"\"\"\r"},{"line":160,"text":"        rng = np.random.default_rng(seed)\r"},{"line":161,"text":"        dg = bpy.context.evaluated_depsgraph_get()\r"},{"line":162,"text":"        me_ob = self.rifle_mesh\r"},{"line":163,"text":"        ev = me_ob.evaluated_get(dg)\r"},{"line":164,"text":"        me = ev.to_mesh()\r"},{"line":165,"text":"        Mw = me_ob.matrix_world\r"},{"line":166,"text":"        V = np.array([list(Mw @ v.co) for v in me.vertices])           # the world, as posed now\r"},{"line":167,"text":"        names = {g.index: g.name for g in me_ob.vertex_groups}\r"},{"line":168,"text":"        vg = []\r"},{"line":169,"text":"        for v in me_ob.data.vertices:\r"},{"line":170,"text":"            gm = max(v.groups, key=lambda x: x.weight) if v.groups else None\r"},{"line":171,"text":"            vg.append(names.get(gm.group) if gm else None)\r"},{"line":172,"text":"        polys = [tuple(p.vertices) for p in me.polygons]\r"},{"line":173,"text":"        ev.to_mesh_clear()\r"},{"line":174,"text":"        part_of = []\r"},{"line":175,"text":"        if any(vg):\r"},{"line":176,"text":"            for p in polys:\r"},{"line":177,"text":"                gs = [vg[i] or \"body\" for i in p]\r"},{"line":178,"text":"                part_of.append(max(set(gs), key=gs.count))\r"},{"line":179,"text":"        else:\r"},{"line":180,"text":"            # connected pieces: polygons sharing a vertex are one piece\r"},{"line":181,"text":"            parent = list(range(len(V)))\r"},{"line":182,"text":"\r"},{"line":183,"text":"            def find(i):\r"},{"line":184,"text":"                while parent[i] != i:\r"},{"line":185,"text":"                    parent[i] = parent[parent[i]]\r"},{"line":186,"text":"                    i = parent[i]\r"},{"line":187,"text":"                return i\r"},{"line":188,"text":"            for p in polys:\r"},{"line":189,"text":"                for i in p[1:]:\r"},{"line":190,"text":"                    ra, rb = find(p[0]), find(i)\r"},{"line":191,"text":"                    if ra != rb:\r"},{"line":192,"text":"                        parent[rb] = ra\r"},{"line":193,"text":"            roots = {}\r"},{"line":194,"text":"            for p in polys:\r"},{"line":195,"text":"                r = find(p[0])\r"},{"line":196,"text":"                roots.setdefault(r, \"piece_%d\" % len(roots))\r"},{"line":197,"text":"                part_of.append(roots[r])\r"},{"line":198,"text":"        sp = spacing_cm / 100.0\r"},{"line":199,"text":"        acc = {}\r"},{"line":200,"text":"        for p, part in zip(polys, part_of):\r"},{"line":201,"text":"            for k in range(1, len(p) - 1):\r"},{"line":202,"text":"                a, b, c = V[p[0]], V[p[k]], V[p[k + 1]]\r"},{"line":203,"text":"                n = np.cross(b - a, c - a)\r"},{"line":204,"text":"                area = 0.5 * float(np.linalg.norm(n))\r"},{"line":205,"text":"                if area < 1e-12:\r"},{"line":206,"text":"                    continue\r"},{"line":207,"text":"                n = n / (2.0 * area)\r"},{"line":208,"text":"                m = max(1, int(area / (sp * sp)))\r"},{"line":209,"text":"                r1, r2 = rng.random(m), rng.random(m)\r"},{"line":210,"text":"                s1 = np.sqrt(r1)\r"},{"line":211,"text":"                pts = (1 - s1)[:, None] * a + (s1 * (1 - r2))[:, None] * b + (s1 * r2)[:, None] * c\r"},{"line":212,"text":"                acc.setdefault(part, ([], []))\r"},{"line":213,"text":"                acc[part][0].append(pts)\r"},{"line":214,"text":"                acc[part][1].append(np.repeat(n[None, :], m, 0))\r"},{"line":215,"text":"        out = {}\r"},{"line":216,"text":"        for k, v in acc.items():\r"},{"line":217,"text":"            Fi = self._obj_frame(k).inverted()\r"},{"line":218,"text":"            R_ = np.array(Fi.to_3x3())\r"},{"line":219,"text":"            T_ = np.array(Fi.translation)\r"},{"line":220,"text":"            Pw, Nw = np.vstack(v[0]), np.vstack(v[1])\r"},{"line":221,"text":"            Pl = Pw @ R_.T + T_\r"},{"line":222,"text":"            Nl = Nw @ R_.T\r"},{"line":223,"text":"            Nl /= np.maximum(np.linalg.norm(Nl, axis=1, keepdims=True), 1e-12)\r"},{"line":224,"text":"            out[k] = (Pl, Nl)                          # each part in its own frame\r"},{"line":225,"text":"        return out\r"}],"name":"_part_points","start_line":156,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#func:_part_points"}}
