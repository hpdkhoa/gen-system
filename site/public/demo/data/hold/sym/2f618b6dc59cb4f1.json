{"flow":{"kind":"var","name":"OPS","noCFG":true,"reason":"OPS is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":143,"file":"hold-code/weaponlab/gate.py","kind":"var","language":"python","lines":[{"line":103,"text":"OPS = {\"<=\": lambda a, b: a <= b, \">=\": lambda a, b: a >= b, \"==\": lambda a, b: a == b, \"<\": lambda a, b: a < b, \">\": lambda a, b: a > b}\r"},{"line":104,"text":"\r"},{"line":105,"text":"\r"},{"line":106,"text":"def rule_value(rule):\r"},{"line":107,"text":"    v = rule[\"value\"]\r"},{"line":108,"text":"    if isinstance(v, str):          # a named budget (budgets.json)\r"},{"line":109,"text":"        budgets = _load(project().data / \"budgets.json\", {})\r"},{"line":110,"text":"        if v not in budgets:\r"},{"line":111,"text":"            return None\r"},{"line":112,"text":"        v = budgets[v]\r"},{"line":113,"text":"    return v\r"},{"line":114,"text":"\r"},{"line":115,"text":"\r"},{"line":116,"text":"def holds(rule, value):\r"},{"line":117,"text":"    v = rule_value(rule)\r"},{"line":118,"text":"    if v is None or value is None:\r"},{"line":119,"text":"        return None\r"},{"line":120,"text":"    return bool(OPS[rule[\"op\"]](value, v))\r"},{"line":121,"text":"\r"},{"line":122,"text":"\r"},{"line":123,"text":"# ------------------------------------------------------------------ runs and the baseline\r"},{"line":124,"text":"def key(row):\r"},{"line":125,"text":"    return \"%s|%s|%s\" % (row[\"weapon\"], row[\"action\"], row[\"metric\"])\r"},{"line":126,"text":"\r"},{"line":127,"text":"\r"},{"line":128,"text":"def _builtin(name):\r"},{"line":129,"text":"    \"\"\"The providers inside Weapon Lab: probe (the game's probe), rig (parts dumps against the specs) and gunkit (a Gun\r"},{"line":130,"text":"    Kit build's own checks: its facts, its clips read back, its hand clips' Pose Lab checks).\"\"\"\r"},{"line":131,"text":"    if name == \"probe\":\r"},{"line":132,"text":"        from . import probe\r"},{"line":133,"text":"        return lambda ws, acts, staging: probe.measure(ws, acts, staging)\r"},{"line":134,"text":"    if name == \"rig\":\r"},{"line":135,"text":"        from . import rig\r"},{"line":136,"text":"        return lambda ws, acts, staging: rig.measure(ws, acts, staging)\r"},{"line":137,"text":"    if name == \"gunkit\":\r"},{"line":138,"text":"        from .gunkit import gaterows\r"},{"line":139,"text":"        return lambda ws, acts, staging: [r for w in (ws or list(gaterows.registry())) for r in gaterows.rows(w)\r"},{"line":140,"text":"                                          if not acts or r[\"action\"] in acts]\r"},{"line":141,"text":"    return None\r"},{"line":142,"text":"\r"},{"line":143,"text":"\r"}],"name":"OPS","start_line":103,"symbol_id":"hold-code/weaponlab/gate.py#var:OPS"}}
