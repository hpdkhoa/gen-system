":1098,"text":"    L.rifle_rest = Matrix.Translation(dv) @ REST0\r"},{"line":1099,"text":"    L.pose_idle()\r"},{"line":1100,"text":"    rest_parts()\r"},{"line":1101,"text":"    sr = lay_palm(\"r\", mark_world(\"grip\"), surface_normal(mark_world(\"grip\"), \"grip\"))\r"},{"line":1102,"text":"    sl = lay_palm(\"l\", mark_world(\"support\"), surface_normal(mark_world(\"support\"), \"support\")) if \"support\" in facts[\"marks\"] else 0.0\r"},{"line":1103,"text":"    settle(\"r\")\r"},{"line":1104,"text":"    settle(\"l\")\r"},{"line":1105,"text":"    gr = L.grip(\"both\", hold=True)\r"},{"line":1106,"text":"    holding = sum(1 for sd in (\"l\", \"r\") if gr.get(sd, {}).get(\"holding\"))\r"},{"line":1107,"text":"    cl = L.clearance(parts=\"both\", ignore=[\"palm*\"], top=1)[\"worst_cm\"]\r"},{"line":1108,"text":"    an = L.anatomy(\"both\")\r"},{"line":1109,"text":"    bad = len(an.get(\"l\", {}).get(\"bad\", [])) + len(an.get(\"r\", {}).get(\"bad\", []))\r"},{"line":1110,"text":"    # the view: the muzzle and the bolt face stay about where the arms' own hold puts a gun on the screen (low and to\r"},{"line":1111,"text":"    # the right at the hip); a gun dead in the middle of the view would hide the world\r"},{"line":1112,"text":"    view = 0.0\r"},{"line":1113,"text":"    for m, ref in VIEW_REF.items():\r"},{"line":1114,"text":"        w = RA.matrix_world @ g((0.0, 0.0, 0.0)) if m == \"bolt_face\" else mark_world(m)\r"},{"line":1115,"text":"        sc = L.screen(lab_gun(w))\r"},{"line":1116,"text":"        view += ((sc.get(\"x\", 2.0) - ref[0]) ** 2 + (sc.get(\"y\", 2.0) - ref[1]) ** 2) ** 0.5\r"},{"line":1117,"text":"    return (4.0 * (sr + sl) + cl + 1.5 * bad + 3.0 * (2 - holding) + 6.0 * view,\r"},{"line":1118,"text":"            {\"short_r\": round(sr, 2), \"short_l\": round(sl, 2), \"clearance\": cl, \"rules\": bad, \"holding\": holding, \"view_off\": round(view, 3)})\r"}],"name":"try_place","start_line":1097,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:try_place"}}
