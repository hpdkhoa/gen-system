normal * fw.dot(normal)\r"},{"line":2227,"text":"            if want.length > 1e-6 and have.length > 1e-6:\r"},{"line":2228,"text":"                q2 = have.normalized().rotation_difference(want.normalized())\r"},{"line":2229,"text":"                R = Matrix.Translation(P) @ q2.to_matrix().to_4x4() @ Matrix.Translation(-P) @ R\r"},{"line":2230,"text":"        R = Matrix.Translation(at + normal * (thickness_cm / 100.0) - P) @ R\r"},{"line":2231,"text":"        return self._put_hand(side, Matrix.LocRotScale(R.translation, R.to_quaternion(), self._unit()))\r"}],"name":"_lay","start_line":2211,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:_lay"}}
