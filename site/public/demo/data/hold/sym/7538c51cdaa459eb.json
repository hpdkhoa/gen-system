}],"preds":[34],"stmts":["call np.array","call list","call self._anchor","call np.array","call list","call self._obj_frame","call Vector","call self.sdf_query","call pairs.append","call Vector","call Vector"],"succs":[36]},{"id":36,"label":"merge","lines":[{"kind":"return","line":1016,"text":"return pairs"}],"preds":[35,39],"stmts":["return"],"succs":null},{"cond":"mark['purpose'] == 'power_wrap'","id":37,"label":"else","preds":[34],"stmts":null,"succs":[38,39]},{"cond":"len(web_s)","id":38,"label":"then","lines":[{"kind":"call","line":1010,"text":"web_s = self._skin_part(side, [\"web\"])"},{"kind":"call","line":1011,"text":"if len(web_s):"}],"preds":[37],"stmts":["call self._skin_part","call len"],"succs":[40,41]},{"id":39,"label":"merge","preds":[41,37],"stmts":null,"succs":[36]},{"id":40,"label":"then","lines":[{"kind":"call","line":1012,"text":"wc = web_s.mean(0)"},{"kind":"call","line":1013,"text":"kw = int(np.argmin(np.linalg.norm(R - wc, axis=1)))"},{"kind":"call","line":1014,"text":"_Dw, _w2, Nw = self.sdf_query(R[kw][None, :])"},{"kind":"call","line":1015,"text":"pairs.append((Vector(wc), Vector(R[kw] - Nw[0] * 0.001), 2.0))"}],"preds":[38],"stmts":["call web_s.mean","call int","call np.argmin","call np.linalg.norm","call self.sdf_query","call pairs.append","call Vector","call Vector"],"succs":[41]},{"id":41,"label":"merge","preds":[40,38],"stmts":null,"succs":[39]}],"effects":["fs"],"entry":0,"exits":[12,36],"func_id":"hold-code/poselab_mcp/blender/holdlab.py#method:HoldMixin._place_targets","issues":null},"source":{"end_line":1016,"file":"hold-code/poselab_mcp/blender/holdlab.py","kind":"method","language":"python","lines":[{"line":948,"text":"    def _place_targets(self, side, mark):\r"},{"line":949,"text":"        \"\"\"Where the hand goes for its purpose, as fit pairs: the palm patch's middle onto the nearest point of its\r"},{"line":950,"text":"        regions and its facing into the surface there (weight 3, the grip itself), the web onto its point (2), the\r"},{"line":951,"text":"        knuckles' line along the run toward its inner end (1).\"\"\"\r"},{"line":952,"text":"        own, far = self._sides_named(side)\r"},{"line":953,"text":"        named = bool(mark.get(\"palm_dir\")) and own != \"side_?\"\r"},{"line":954,"text":"        RUN = [\"back\", \"front\", \"side_?\", \"left\", \"right\", \"tang\", \"end\"]\r"},{"line":955,"text":"        if mark[\"purpose\"] == \"support\":\r"},{"line":956,"text":"            regs = [own] if named else RUN\r"},{"line":957,"text":"        else:\r"},{"line":958,"text":"            regs = [\"back\", own, \"tang\"] if named else RUN\r"},{"line":959,"text":"        palm = self._skin_part(side, [\"palm\"])\r"},{"line":960,"text":"        R = self._region_points(regs)\r"},{"line":961,"text":"        if not len(palm) or not len(R):\r"},{"line":962,"text":"            return []\r"},{"line":963,"text":"        if mark[\"purpose\"] == \"power_wrap\":\r"},{"line":964,"text":"            # a power wrap seats the handle across the distal palm, by the knuckle crease (the base segments then\r"},{"line":965,"text":"            # wrap it; seated at the palm's middle only the fingertips reach): the palm's half nearest the knuckles\r"},{"line":966,"text":"            kn = np.array(list(self._bw(self._n(\"finger\", side, \"middle\", \"01\")).translation))\r"},{"line":967,"text":"            dk = np.linalg.norm(palm - kn, axis=1)\r"},{"line":968,"text":"            palm = palm[dk <= np.median(dk)]\r"},{"line":969,"text":"        pc = palm.mean(0)\r"},{"line":970,"text":"        run = self._object[\"parts\"][mark[\"part\"]][\"runs\"][mark.get(\"run\", 0)]\r"},{"line":971,"text":"        RW = self._run_world(run)\r"},{"line":972,"text":"        ax = np.array(list((RW[\"inner\"] - RW[\"outer\"]).normalized()))\r"},{"line":973,"text":"        o_ = np.array(list(RW[\"outer\"]))\r"},{"line":974,"text":"        if mark[\"purpose\"] == \"power_wrap\":\r"},{"line":975,"text":"            # the palm wraps the run: its target on the run's wall (a surface along the run, not an end or a tang's\r"},{"line":976,"text":"            # top) and its facing toward the run's axis\r"},{"line":977,"text":"            _D0, _w0, NR = self.sdf_query(R)\r"},{"line":978,"text":"            wall = np.abs(NR @ ax) < 0.5\r"},{"line":979,"text":"            if wall.any():\r"},{"line":980,"text":"                R = R[wall]\r"},{"line":981,"text":"        k = int(np.argmin(np.linalg.norm(R - pc, axis=1)))\r"},{"line":982,"text":"        tgt = R[k]\r"},{"line":983,"text":"        if mark[\"purpose\"] == \"power_wrap\":\r"},{"line":984,"text":"            c_ = o_ + ax * float(np.dot(tgt - o_, ax))          # the axis point level with the target\r"},{"line":985,"text":"            inw = c_ - tgt\r"},{"line":986,"text":"            inw = inw / max(1e-9, np.linalg.norm(inw))\r"},{"line":987,"text":"        else:\r"},{"line":988,"text":"            inw = -self.sdf_query(tgt[None, :])[2][0]          # a support palm lies flat on its panel\r"},{"line":989,"text":"        f0 = np.array(list(self._palm_facing(side)))\r"},{"line":990,"text":"        pairs = [(Vector(pc), Vector(tgt), 3.0),\r"},{"line":991,"text":"                 (Vector(pc + f0 * 0.03), Vector(tgt + inw * 0.03), 3.0)]\r"},{"line":992,"text":"        if os.environ.get(\"POSELAB_DEBUG\"):\r"},{"line":993,"text":"            print(\"DBG targets\", side, mark[\"purpose\"], \"palm->tgt cm\", round(float(np.linalg.norm(tgt - pc)) * 100, 1),\r"},{"line":994,"text":"                  \"facing.inw\", round(float(np.dot(f0, inw)), 2))\r"},{"line":995,"text":"        a0 = np.array(list(self._bw(self._n(\"finger\", side, \"index\", \"01\")).translation\r"},{"line":996,"text":"                           - self._bw(self._n(\"finger\", side, \"pinky\", \"01\")).translation))\r"},{"line":997,"text":"        a0 /= max(1e-9, np.linalg.norm(a0))\r"},{"line":998,"text":"        if os.environ.get(\"POSELAB_DEBUG\"):\r"},{"line":999,"text":"            print(\"DBG knuckles.ax\", round(float(np.dot(a0, ax)), 2), \"web mark\", bool(mark.get(\"_web\")))\r"},{"line":1000,"text":"        if np.dot(a0, ax) < 0 and not (mark.get(\"_web\") and mark[\"purpose\"] == \"power_wrap\"):\r"},{"line":1001,"text":"            ax = -ax        # the knuckles keep their start's way along the run (the body chose it); a web point pins it\r"},{"line":1002,"text":"        pairs += [(Vector(pc + a0 * 0.03), Vector(tgt + ax * 0.03), 1.0), (Vector(pc - a0 * 0.03), Vector(tgt - ax * 0.03), 1.0)]\r"},{"line":1003,"text":"        if mark.get(\"_web\") and mark[\"purpose\"] == \"power_wrap\":\r"},{"line":1004,"text":"            web = np.array(list(self._anchor(side, \"web\")))\r"},{"line":1005,"text":"            wt = np.array(list(self._obj_frame(mark[\"part\"]) @ Vector(mark[\"_web\"])))\r"},{"line":1006,"text":"            Dw, _w2, Nw = self.sdf_query(wt[None, :])\r"},{"line":1007,"text":"            pairs.append((Vector(web), Vector(wt + Nw[0] * 0.009), 2.0))   # the web's middle is a cm inside its skin\r"},{"line":1008,"text":"        elif mark[\"purpose\"] == \"power_wrap\":\r"},{"line":1009,"text":"            # no web point read: the web onto the run's surface nearest it, just pressing (a power wrap seats it)\r"},{"line":1010,"text":"            web_s = self._skin_part(side, [\"web\"])\r"},{"line":1011,"text":"            if len(web_s):\r"},{"line":1012,"text":"                wc = web_s.mean(0)\r"},{"line":1013,"text":"                kw = int(np.argmin(np.linalg.norm(R - wc, axis=1)))\r"},{"line":1014,"text":"                _Dw, _w2, Nw = self.sdf_query(R[kw][None, :])\r"},{"line":1015,"text":"                pairs.append((Vector(wc), Vector(R[kw] - Nw[0] * 0.001), 2.0))\r"},{"line":1016,"text":"        return pairs\r"}],"name":"_place_targets","start_line":948,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#method:HoldMixin._place_targets"}}
