"call round","call deepest_press"],"succs":[19]},{"cond":"for _ in range(0)","id":21,"label":"loop_header","preds":[10,25],"stmts":null,"succs":[22,23]},{"cond":"depth <= allowed","id":22,"label":"loop_body","lines":[{"kind":"call","line":578,"text":"depth = L.clearance(parts=side, ignore=[\"forearm*\", \"thumb2*\", \"thumb3*\"], top=1)[\"worst_cm\"]"}],"preds":[21],"stmts":["call L.clearance"],"succs":[24,25]},{"id":23,"label":"loop_exit","lines":[{"kind":"call","line":584,"text":"thumb_clear(side, tree, steps=30)"},{"kind":"call","line":585,"text":"L._clear_fingers(side)"},{"kind":"call","line":586,"text":"bpy.context.view_layer.update()"}],"preds":[21],"stmts":["call thumb_clear","call L._clear_fingers","call bpy.context.view_layer.update"],"succs":null},{"id":24,"label":"then","preds":[22],"stmts":null,"succs":[25]},{"id":25,"label":"merge","lines":[{"kind":"call","line":581,"text":"hw = L._bw(hn)"},{"kind":"call","line":582,"text":"L._put_hand(side, Matrix.LocRotScale(hw.translation + normal * ((depth - allowed + 0.03) / 100.0), hw.to_quaternion(), L._unit()))"},{"kind":"call","line":583,"text":"bpy.context.view_layer.update()"}],"preds":[24,22],"stmts":["call L._bw","call L._put_hand","call Matrix.LocRotScale","call hw.to_quaternion","call L._unit","call bpy.context.view_layer.update"],"succs":[21]}],"effects":["unknown"],"entry":0,"exits":[1],"func_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:apply_style","issues":null},"source":{"end_line":586,"file":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py","kind":"func","language":"python","lines":[{"line":545,"text":"def apply_style(side, trigger=False, normal=None):\r"},{"line":546,"text":"    \"\"\"The style's fingers for this hand on its contact: each digit straight or wrapped; the trigger finger on the\r"},{"line":547,"text":"    trigger when asked. Then the hand backed off along the contact's face while any of it (the ball of the thumb, the\r"},{"line":548,"text":"    palm, a knuckle) sits deeper in the gun than the glove allows, the fingers closed again each time.\"\"\"\r"},{"line":549,"text":"    h = (STYLE or {}).get(\"hands\", {}).get(side)\r"},{"line":550,"text":"    if not h:\r"},{"line":551,"text":"        return\r"},{"line":552,"text":"    tree = L._tree()\r"},{"line":553,"text":"    allowed = max(0.0, 0.2 - GLOVE)\r"},{"line":554,"text":"    hn = L._n(\"hand\", side)\r"},{"line":555,"text":"    pose_digits(side, h, trigger, tree)\r"},{"line":556,"text":"    if h.get(\"thumb_rest\") and not trigger:\r"},{"line":557,"text":"        tr = h[\"thumb_rest\"]\r"},{"line":558,"text":"        left = thumb_to(side, mark_world(tr[\"mark\"], offset=tr[\"offset\"]), tree)\r"},{"line":559,"text":"        thumb_clear(side, tree)\r"},{"line":560,"text":"        report.setdefault(\"thumb_rest_cm\", {})[side] = round(left, 2)\r"},{"line":561,"text":"    if normal is not None and not trigger:\r"},{"line":562,"text":"        # each press the style does not allow undone along its own way out, by its excess (at most 0.8 cm), the\r"},{"line":563,"text":"        # fingers closed again after each move\r"},{"line":564,"text":"        # (off: moving the support hand out of a press put the back of its index into the gun; the support fingers\r"},{"line":565,"text":"        # need the firing hand's fingers as something to wrap over, which Pose Lab's tests do not hold yet)\r"},{"line":566,"text":"        for _ in range(3 if side in tuple(job.get(\"press_sides\", ())) else 0):\r"},{"line":567,"text":"            pr = deepest_press(side, tree)\r"},{"line":568,"text":"            if pr is None:\r"},{"line":569,"text":"                break\r"},{"line":570,"text":"            hw = L._bw(hn)\r"},{"line":571,"text":"            L._put_hand(side, Matrix.LocRotScale(hw.translation + pr[1] * (min(pr[0] + 0.03, 0.8) / 100.0), hw.to_quaternion(), L._unit()))\r"},{"line":572,"text":"            bpy.context.view_layer.update()\r"},{"line":573,"text":"            pose_digits(side, h, trigger, tree)\r"},{"line":574,"text":"        report.setdefault(\"presses\", {})[side] = None if deepest_press(side, tree) is None else round(deepest_press(side, tree)[0], 2)\r"},{"line":575,"text":"    for _ in range(0):\r"},{"line":576,"text":"        # the thumb lies on the gun's far side (a pistol's firing thumb on its left): backing the palm off moves it in,\r"},{"line":577,"text":"        # so the thumbs are cleared on their own (thumb_clear)\r"},{"line":578,"text":"        depth = L.clearance(parts=side, ignore=[\"forearm*\", \"thumb2*\", \"thumb3*\"], top=1)[\"worst_cm\"]\r"},{"line":579,"text":"        if depth <= allowed:\r"},{"line":580,"text":"            break\r"},{"line":581,"text":"        hw = L._bw(hn)\r"},{"line":582,"text":"        L._put_hand(side, Matrix.LocRotScale(hw.translation + normal * ((depth - allowed + 0.03) / 100.0), hw.to_quaternion(), L._unit()))\r"},{"line":583,"text":"        bpy.context.view_layer.update()\r"},{"line":584,"text":"    thumb_clear(side, tree, steps=30)\r"},{"line":585,"text":"    L._clear_fingers(side)\r"},{"line":586,"text":"    bpy.context.view_layer.update()\r"}],"name":"apply_style","start_line":545,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:apply_style"}}
