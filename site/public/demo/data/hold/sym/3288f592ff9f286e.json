view (Gun Kit's view: +X left).\"\"\"\r"},{"line":1491,"text":"    # the gun's own axes in the world at the hold (the gun bone's axes are the arms rig's, not the gun's)\r"},{"line":1492,"text":"    q0 = RA_HOLD.to_quaternion()\r"},{"line":1493,"text":"    ax = lambda v: (q0 @ g(v)).normalized()        # noqa: E731\r"},{"line":1494,"text":"    # Blender's world is gun space mirrored: a turn's angle changes sign\r"},{"line":1495,"text":"    q = (Quaternion(ax((0, 0, 1)), math.radians(p.get(\"yaw\", 0.0))) @ Quaternion(ax((1, 0, 0)), -math.radians(p.get(\"pitch\", 0.0)))\r"},{"line":1496,"text":"         @ Quaternion(ax((0, 1, 0)), -math.radians(p.get(\"roll\", 0.0))))\r"},{"line":1497,"text":"    mv = p.get(\"move\", [0.0, 0.0, 0.0])\r"},{"line":1498,"text":"    move = (PL.VIEW_RIGHT * -mv[0] + PL.VIEW_FWD * mv[1] + PL.VIEW_UP * mv[2]) / 100.0\r"},{"line":1499,"text":"    M = Matrix.Translation(move) @ Matrix.Translation(PIVOT) @ q.to_matrix().to_4x4() @ Matrix.Translation(-PIVOT) @ G_HOLD\r"},{"line":1500,"text":"    L._set_world(GUN_BONE, Matrix.LocRotScale(M.translation, M.to_quaternion(), L._unit()))\r"},{"line":1501,"text":"    L._place_rifle()\r"}],"name":"gun_pose","start_line":1488,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:gun_pose"}}
