"pose\": \"straight\", \"curl\": [a, b, c]} | {\"pose\": \"wrap\",\r"},{"line":1200,"text":"        \"max_curl\": [a, b, c]} | {\"pose\": \"rest\"}, ..., \"thumb\": ...}: straight ones set, wrapped ones closed a step\r"},{"line":1201,"text":"        at a time until their skin (and glove) meets the gun or the other hand, a step into either taken back; then\r"},{"line":1202,"text":"        the joints mended back in range and into their fingers' planes. from_pose: each wrapped finger starts from\r"},{"line":1203,"text":"        its curl now (a hold already placed): opened a step at a time while it is in the gun or the other hand, else\r"},{"line":1204,"text":"        closed until it meets either. rules: contact rules; a wrapped finger with a rule of its own closes to the\r"},{"line":1205,"text":"        step that best meets that rule (its pad laid on its region), pressing no deeper than allowed, instead of\r"},{"line":1206,"text":"        stopping at its first touch.\"\"\"\r"},{"line":1207,"text":"        tree = tree or self._tree()\r"},{"line":1208,"text":"        _L, FL = self._limits()\r"},{"line":1209,"text":"        TL = self._thumb_limits()\r"},{"line":1210,"text":"        self._wraps = {}           # each wrapped digit: how far it closed (0 to 1 of its max) before it met something\r"},{"line":1211,"text":"        for fi in (\"index\", \"middle\", \"ring\", \"pinky\"):\r"},{"line":1212,"text":"            f = (plan or {}).get(fi)\r"},{"line":1213,"text":"            if not f or f.get(\"pose\") == \"rest\":\r"},{"line":1214,"text":"                continue\r"},{"line":1215,"text":"            if f[\"pose\"] == \"posture\":\r"},{"line":1216,"text":"                # measured joint angles (a person's grasp); with a rule of its own the finger opens or closes up to\r"},{"line":1217,"text":"                # tol degrees from them (the end joint two thirds as much) to meet it, pressing no deeper than allowed\r"},{"line":1218,"text":"                base = list(f[\"curl\"])\r"},{"line":1219,"text":"                tol = float(f.get(\"tol\", 15.0))\r"},{"line":1220,"text":"                mine = [r_ for r_ in (rules or []) if r_[\"patch\"].split(\":\")[0] == fi]\r"},{"line":1221,"text":"                offs = [0.0] if not mine else [float(x) for x in range(-int(tol), int(tol) + 1, 5)]\r"},{"line":1222,"text":"                best_ = None\r"},{"line":1223,"text":"                vv = self._gun_verts() if mine else None\r"},{"line":1224,"text":"                for dlt in offs:\r"},{"line":1225,"text":"                    c3 = [base[0] + dlt, base[1] + dlt, base[2] + dlt * 2.0 / 3.0]\r"},{"line":1226,"text":"                    for j, cc in zip((\"01\", \"02\", \"03\"), c3):\r"},{"line":1227,"text":"                        self._set_curl(side, fi, j, cc, FL)\r"},{"line":1228,"text":"                    if not mine:\r"},{"line":1229,"text":"                        best_ = (0.0, c3)\r"},{"line":1230,"text":"                        break\r"},{"line":1231,"text":"                    gap = self._digit_gap(side, fi, tree, glove_cm, other)\r"},{"line":1232,"text":"                    err = sum(self._rule_eval(side, r_, glove_cm, vv)[\"error\"] for r_ in mine)\r"},{"line":1233,"text":"                    sc_ = err + 4.0 * max(0.0, -gap - 0.15) + 0.01 * abs(dlt)\r"},{"line":1234,"text":"                    if best_ is None or sc_ < best_[0]:\r"},{"line":1235,"text":"                        best_ = (sc_, c3)\r"},{"line":1236,"text":"                for j, cc in zip((\"01\", \"02\", \"03\"), best_[1]):\r"},{"line":1237,"text":"                    self._set_curl(side, fi, j, cc, FL)\r"},{"line":1238,"text":"                continue\r"},{"line":1239,"text":"            if f[\"pose\"] == \"straight\":\r"},{"line":1240,"text":"                for j, c in zip((\"01\", \"02\", \"03\"), f[\"curl\"]):\r"},{"line":1241,"text":"                    self._set_curl(side, fi, j, c, FL)\r"},{"line":1242,"text":"                continue\r"},{"line":1243,"text":"            if from_pose:\r"},{"line":1244,"text":"                rep0 = self._finger_report(side, FL)[0]\r"},{"line":1245,"text":"                mx = f[\"max_curl\"]\r"},{"line":1246,"text":"                fr = [(rep0[\"%s_%s\" % (fi, j)][0] - 4.0) / (m - 4.0) if abs(m - 4.0) > 1e-6 else 0.0\r"},{"line":1247,"text":"                      for j, m in zip((\"01\", \"02\", \"03\"), mx)]\r"},{"line":1248,"text":"                t = min(1.0, max(0.0, sum(fr) / 3.0))\r"},{"line":1249,"text":"                at_t = lambda t_: [4.0 + (m - 4.0) * t_ for m in mx]      # noqa: E731\r"},{"line":1250,"text":"                for j, c in zip((\"01\", \"02\", \"03\"), at_t(t)):\r"},{"line":1251,"text":"                    self._set_curl(side, fi, j, c, FL)\r"},{"line":1252,"text":"                gap = self._digit_gap(side, fi, tree, glove_cm, other, skip_base=True)\r"},{"line":1253,"text":"                if gap < -0.1:\r"},{"line":1254,"text":"                    while t > 0.0 and gap < -0.1:\r"},{"line":1255,"text":"                        t = max(0.0, t - 1.0 / steps)\r"},{"line":1256,"text":"                        for j, c in zip((\"01\", \"02\", \"03\"), at_t(t)):\r"},{"line":1257,"text":"                            self._set_curl(side, fi, j, c, FL)\r"},{"line":1258,"text":"                        gap = self._digit_gap(side, fi, tree, glove_cm, other, skip_base=True)\r"},{"line":1259,"text":"                else:\r"},{"line":1260,"text":"                    while t < 1.0 and gap > 0.05:\r"},{"line":1261,"text":"                        t2 = min(1.0, t + 1.0 / steps)\r"},{"line":1262,"text":"                        for j, c in zip((\"01\", \"02\", \"03\"), at_t(t2)):\r"},{"line":1263,"text":"                            self._set_curl(side, fi, j, c, FL)\r"},{"line":1264,"text":"                        g2 = self._digit_gap(side, fi, tree, glove_cm, other, skip_base=True)\r"},{"line":1265,"text":"                        if g2 < -0.1:\r"},{"line":1266,"text":"                            for j, c in zip((\"01\", \"02\", \"03\"), at_t(t)):\r"},{"line":1267,"text":"                                self._set_curl(side, fi, j, c, FL)\r"},{"line":1268,"text":"                            break\r"},{"line":1269,"text":"                        t, gap = t2, g2\r"},{"line":1270,"text":"                self._wraps[fi] = t\r"},{"line":1271,"text":"                continue\r"},{"line":1272,"text":"            mine = [r_ for r_ in (rules or []) if r_[\"patch\"].split(\":\")[0] == fi]\r"},{"line":1273,"text":"            if mine:\r"},{"line":1274,"text":"                vv = self._gun_verts()\r"},{"line":1275,"text":"                best_ = None\r"},{"line":1276,"text":"                for k in range(0, steps + 1):\r"},{"line":1277,"text":"                    c3 = [4.0 + (m - 4.0) * k / steps for m in f[\"max_curl\"]]\r"},{"line":1278,"text":"                    for j, c in zip((\"01\", \"02\", \"03\"), c3):\r"},{"line":1279,"text":"                        self._set_curl(side, fi, j, c, FL)\r"},{"line":1280,"text":"                    gap = self._digit_gap(side, fi, tree, glove_cm, other)\r"},{"line":1281,"text":"                    err = sum(self._rule_eval(side, r_, glove_cm, vv)[\"error\"] for r_ in mine)\r"},{"line":1282,"text":"                    sc_ = err + 4.0 * max(0.0, -gap - 0.15)\r"},{"line":1283,"text":"                    if best_ is None or sc_ < best_[0] - 1e-6:\r"},{"line":1284,"text":"                        best_ = (sc_, k, c3)\r"},{"line":1285,"text":"                for j, c in zip((\"01\", \"02\", \"03\"), best_[2]):\r"},{"line":1286,"text":"                    self._set_curl(side, fi, j, c, FL)\r"},{"line":1287,"text":"                self._wraps[fi] = best_[1] / steps\r"},{"line":1288,"text":"                continue\r"},{"line":1289,"text":"            prev = [4.0, 4.0, 4.0]\r"},{"line":1290,"text":"            for j, c in zip((\"01\", \"02\", \"03\"), prev):\r"},{"line":1291,"text":"                self._set_curl(side, fi, j, c, FL)\r"},{"line":1292,"text":"            done = 1.0\r"},{"line":1293,"text":"            for k in range(1, steps + 1):\r"},{"line":1294,"text":"                c3 = [4.0 + (m - 4.0) * k / steps for m in f[\"max_curl\"]]\r"},{"line":1295,"text":"                for j, c in zip((\"01\", \"02\", \"03\"), c3):\r"},{"line":1296,"text":"                    self._set_curl(side, fi, j, c, FL)\r"},{"line":1297,"text":"                gap = self._digit_gap(side, fi, tree, glove_cm, other)\r"},{"line":1298,"text":"                if gap <= 0.05:\r"},{"line":1299,"text":"                    done = (k - (1 if gap < -0.1 else 0)) / steps\r"},{"line":1300,"text":"                    if gap < -0.1:\r"},{"line":1301,"text":"                        for j, c in zip((\"01\", \"02\", \"03\"), prev):\r"},{"line":1302,"text":"                            self._set_curl(side, fi, j, c, FL)\r"},{"line":1303,"text":"                    break\r"},{"line":1304,"text":"                prev = c3\r"},{"line":1305,"text":"            self._wraps[fi] = done\r"},{"line":1306,"text":"        t = (plan or {}).get(\"thumb\")\r"},{"line":1307,"text":"        if t and t.get(\"pose\") == \"posture\":\r"},{"line":1308,"text":"            # the measured bends (a person's thumb lies nearly straight along a pistol), then its base aimed so the\r"},{"line":1309,"text":"            # tip comes to its rest point, a turn into the gun not taken\r"},{"line":1310,"text":"            self._set_thumb_bend(side, t[\"curl\"][1], t[\"curl\"][2], TL)\r"},{"line":1311,"text":"            if t.get(\"to_world\") is not None:\r"},{"line":1312,"text":"                self._thumb_to(side, Vector(t[\"to_world\"]), tree, glove_cm, other, joints=(\"01\",), guard=True)\r"},{"line":1313,"text":"        elif t and t.get(\"pose\") == \"to\" and t.get(\"to_world\") is not None and t.get(\"via_world\") is not None:\r"},{"line":1314,"text":"            self._thumb_via(side, Vector(t[\"via_world\"]), Vector(t[\"to_world\"]), TL)\r"},{"line":1315,"text":"        elif t and t.get(\"pose\") == \"to\" and t.get(\"to_world\") is not None:\r"},{"line":1316,"text":"            # the base turned toward the point (it moves freely within its rules); the knuckle and end joint bent\r"},{"line":1317,"text":"            # only in their hinges (a grid of bends, the one that brings the tip nearest); the base once more\r"},{"line":1318,"text":"            tgt = Vector(t[\"to_world\"])\r"},{"line":1319,"text":"            self._set_thumb_bend(side, 10.0, 6.0, TL)\r"},{"line":1320,"text":"            self._thumb_to(side, tgt, tree, glove_cm, other, joints=(\"01\",), guard=False)\r"},{"line":1321,"text":"            for _round in range(2):\r"},{"line":1322,"text":"                best = None\r"},{"line":1323,"text":"                for b2 in (0.0, 15.0, 30.0, 45.0):\r"},{"line":1324,"text":"                    for b3 in (0.0, 20.0, 40.0, 60.0):\r"},{"line":1325,"text":"                        self._set_thumb_bend(side, b2, b3, TL)\r"},{"line":1326,"text":"                        dd = (self._finger_tip(\"thumb\", side) - tgt).length\r"},{"line":1327,"text":"                        if best is None or dd < best[0]:\r"},{"line":1328,"text":"                            best = (dd, b2, b3)\r"},{"line":1329,"text":"                self._set_thumb_bend(side, best[1], best[2], TL)\r"},{"line":1330,"text":"                self._thumb_to(side, tgt, tree, glove_cm, other, joints=(\"01\",), guard=False)\r"},{"line":1331,"text":"        elif t and t.get(\"pose\") == \"straight\":\r"},{"line":1332,"text":"            self._set_thumb_bend(side, t[\"curl\"][1], t[\"curl\"][2], TL)\r"},{"line":1333,"text":"        elif t and t.get(\"pose\") == \"wrap\":\r"},{"line":1334,"text":"            prev = (6.0, 4.0)\r"},{"line":1335,"text":"            self._set_thumb_bend(side, *prev, TL)\r"},{"line":1336,"text":"            for k in range(1, steps + 1):\r"},{"line":1337,"text":"                b = (6.0 + (t[\"max_curl\"][1] - 6.0) * k / steps, 4.0 + (t[\"max_curl\"][2] - 4.0) * k / steps)\r"},{"line":1338,"text":"                self._set_thumb_bend(side, *b, TL)\r"},{"line":1339,"text":"                gap = self._digit_gap(side, \"thumb\", tree, glove_cm, other)\r"},{"line":1340,"text":"                if gap <= 0.05:\r"},{"line":1341,"text":"                    if gap < -0.1:\r"},{"line":1342,"text":"                        self._set_thumb_bend(side, *prev, TL)\r"},{"line":1343,"text":"                    break\r"},{"line":1344,"text":"                prev = b\r"},{"line":1345,"text":"        if mend:\r"},{"line":1346,"text":"            self._mend_hand(side)                 # (the hold search keeps the wrist itself: it passes mend=False)\r"},{"line":1347,"text":"        self._end_joints_flat(side, FL)\r"},{"line":1348,"text":"        self._thumb_base_clear(side, tree, glove_cm, other)\r"},{"line":1349,"text":"        bpy.context.view_layer.update()\r"}],"name":"close_hand","start_line":1197,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:close_hand"}}
