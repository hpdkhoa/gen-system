 cv2.resize","call int","call int"],"succs":[24,25]},{"cond":"not region","id":23,"label":"merge","lines":[{"kind":"call","line":187,"text":"cv2.rectangle(view, (0, view.shape[0] - 24), (min(view.shape[1], 12 + 9 * len(label)), view.shape[0]), (255, 255, 255), -1)"},{"kind":"call","line":188,"text":"cv2.putText(view, label, (6, view.shape[0] - 7), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 0, 0), 1)"},{"kind":"call","line":189,"text":"out = store.folder(gun, \"figures\") / (\"%s_grid%s.png\" % (fig_id, \"\" if not region else \"_%d_%d\" % (x0, y0)))"}],"preds":[25,21],"stmts":["call cv2.rectangle","call min","call len","call cv2.putText","call store.folder"],"succs":[26,27]},{"id":24,"label":"then","preds":[22],"stmts":null,"succs":[25]},{"id":25,"label":"merge","preds":[24,22],"stmts":null,"succs":[23]},{"id":26,"label":"then","preds":[23],"stmts":null,"succs":[27]},{"id":27,"label":"merge","lines":[{"kind":"call","line":190,"text":"cv2.imwrite(str(out), view)"},{"kind":"call","line":191,"text":"return str(out)"}],"preds":[26,23],"stmts":["call cv2.imwrite","call str","call str","return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[27],"func_id":"hold-code/weaponlab/blueprint/figures.py#func:grid","issues":null},"source":{"end_line":191,"file":"hold-code/weaponlab/blueprint/figures.py","kind":"func","language":"python","lines":[{"line":154,"text":"def grid(gun, fig_id, step_px=100, region=None, zoom=1.0):\r"},{"line":155,"text":"    \"\"\"The figure with a labelled pixel grid (and, once framed, the bore line, the origin and a cm grid along it),\r"},{"line":156,"text":"    for reading points off it. region: [x0, y0, x1, y1] px to look closer; zoom scales the picture.\"\"\"\r"},{"line":157,"text":"    import cv2\r"},{"line":158,"text":"    f = figure(gun, fig_id)\r"},{"line":159,"text":"    img = image(gun, f)\r"},{"line":160,"text":"    h, w = img.shape[:2]\r"},{"line":161,"text":"    x0, y0, x1, y1 = [int(v) for v in (region or [0, 0, w, h])]\r"},{"line":162,"text":"    view = img.copy()\r"},{"line":163,"text":"    if \"frame\" in f and \"scale\" in f:\r"},{"line":164,"text":"        u, n = axes(f)\r"},{"line":165,"text":"        s = f[\"scale\"][\"cm_per_px\"]\r"},{"line":166,"text":"        o = f[\"frame\"][\"origin\"]\r"},{"line":167,"text":"        for k in range(-60, 61):\r"},{"line":168,"text":"            for d, col in ((u, (0, 160, 0)), (n, (160, 120, 0))):\r"},{"line":169,"text":"                c = (o[0] + d[0] * k / s, o[1] + d[1] * k / s)\r"},{"line":170,"text":"                perp = (d[1], -d[0])\r"},{"line":171,"text":"                p1 = (int(c[0] - perp[0] * 4000), int(c[1] - perp[1] * 4000))\r"},{"line":172,"text":"                p2 = (int(c[0] + perp[0] * 4000), int(c[1] + perp[1] * 4000))\r"},{"line":173,"text":"                cv2.line(view, p1, p2, col, 1 if k % 5 else 2)\r"},{"line":174,"text":"        b0, b1 = f[\"frame\"][\"bore\"]\r"},{"line":175,"text":"        cv2.line(view, (int(b0[0]), int(b0[1])), (int(b1[0]), int(b1[1])), (0, 0, 255), 2)\r"},{"line":176,"text":"        cv2.circle(view, (int(o[0]), int(o[1])), 8, (0, 0, 255), 2)\r"},{"line":177,"text":"    for x in range(0, w, step_px):\r"},{"line":178,"text":"        cv2.line(view, (x, 0), (x, h), (255, 0, 255), 1)\r"},{"line":179,"text":"        cv2.putText(view, str(x), (x + 2, max(y0 + 16, 16)), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 0, 255), 1)\r"},{"line":180,"text":"    for y in range(0, h, step_px):\r"},{"line":181,"text":"        cv2.line(view, (0, y), (w, y), (255, 0, 255), 1)\r"},{"line":182,"text":"        cv2.putText(view, str(y), (max(x0 + 2, 2), y - 3), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 0, 255), 1)\r"},{"line":183,"text":"    view = view[y0:y1, x0:x1]\r"},{"line":184,"text":"    if zoom != 1.0:\r"},{"line":185,"text":"        view = cv2.resize(view, (int(view.shape[1] * zoom), int(view.shape[0] * zoom)), interpolation=cv2.INTER_AREA if zoom < 1 else cv2.INTER_CUBIC)\r"},{"line":186,"text":"    label = \"SOURCE FIGURE %s WITH A MEASURING GRID (not a model view)\" % fig_id\r"},{"line":187,"text":"    cv2.rectangle(view, (0, view.shape[0] - 24), (min(view.shape[1], 12 + 9 * len(label)), view.shape[0]), (255, 255, 255), -1)\r"},{"line":188,"text":"    cv2.putText(view, label, (6, view.shape[0] - 7), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 0, 0), 1)\r"},{"line":189,"text":"    out = store.folder(gun, \"figures\") / (\"%s_grid%s.png\" % (fig_id, \"\" if not region else \"_%d_%d\" % (x0, y0)))\r"},{"line":190,"text":"    cv2.imwrite(str(out), view)\r"},{"line":191,"text":"    return str(out)\r"}],"name":"grid","start_line":154,"symbol_id":"hold-code/weaponlab/blueprint/figures.py#func:grid"}}
