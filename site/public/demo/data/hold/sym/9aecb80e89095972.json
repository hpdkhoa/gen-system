"pivot\"] = mo[\"pivot\"]\r"},{"line":49,"text":"        if p.get(\"parent\"):\r"},{"line":50,"text":"            q[\"parent\"] = bp[\"parts\"][p[\"parent\"]][\"role\"]\r"},{"line":51,"text":"    role = {pid: p[\"role\"] for pid, p in bp[\"parts\"].items()}\r"},{"line":52,"text":"    mark_parts = {}\r"},{"line":53,"text":"    for m, chain in bp.get(\"mark_parts\", {}).items():\r"},{"line":54,"text":"        roles = [role[c] for c in ([chain] if isinstance(chain, str) else chain) if role[c] != \"body\"]\r"},{"line":55,"text":"        if roles:\r"},{"line":56,"text":"            mark_parts[m] = roles[0] if len(roles) == 1 else roles\r"},{"line":57,"text":"    pm = {\"contract\": \"weaponlab-partsmap/1\", \"name\": bp[\"name\"], \"action\": bp[\"action\"], \"model\": str(blend),\r"},{"line":58,"text":"          \"units\": \"m\", \"forward\": \"-Y\", \"up\": \"+Z\", \"origin\": [0.0, 0.0, 0.0], \"parts\": parts,\r"},{"line":59,"text":"          \"marks\": {m: x[\"at\"] for m, x in bp[\"marks\"].items()}, \"mark_parts\": mark_parts,\r"},{"line":60,"text":"          \"normals\": {m: x[\"normal\"] for m, x in bp[\"marks\"].items() if \"normal\" in x},\r"},{"line":61,"text":"          \"blueprint\": str(Path(store.root() / bp[\"name\"] / \"blueprint.json\").resolve())}\r"},{"line":62,"text":"    if bp.get(\"magazine_lips\"):\r"},{"line":63,"text":"        pm[\"magazine\"] = {\"lips\": bp[\"magazine_lips\"][\"at\"]}\r"},{"line":64,"text":"        mag = next((p for p in bp[\"parts\"].values() if p[\"role\"] in (\"magazine\", \"cell\")), None)\r"},{"line":65,"text":"        if mag and mag[\"shape\"][\"kind\"] in (\"extrude\", \"views\"):\r"},{"line":66,"text":"            pm[\"magazine\"].update(magazine_line(mag[\"shape\"][\"outline\"] if mag[\"shape\"][\"kind\"] == \"extrude\" else mag[\"shape\"][\"side\"]))\r"},{"line":67,"text":"    src = json.loads(Path(bp[\"sources\"]).read_text(encoding=\"utf-8\")) if Path(bp[\"sources\"]).exists() else {\"sources\": []}\r"},{"line":68,"text":"    pm[\"sources\"] = [\"%s (%s)\" % (s[\"title\"], s.get(\"year\", \"\")) for s in src[\"sources\"]]\r"},{"line":69,"text":"    return pm\r"}],"name":"partsmap","start_line":32,"symbol_id":"hold-code/weaponlab/blueprint/build.py#func:partsmap"}}
