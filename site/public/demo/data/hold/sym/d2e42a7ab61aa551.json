},{"line":37,"text":"    hands = json.loads((build / \"hands\" / \"hands.json\").read_text(encoding=\"utf-8\"))\r"},{"line":38,"text":"    out = build / \"export\"\r"},{"line":39,"text":"    (out / \"arms\").mkdir(parents=True, exist_ok=True)\r"},{"line":40,"text":"    shutil.copy2(clips[\"fbx\"], out / Path(clips[\"fbx\"]).name)\r"},{"line":41,"text":"    arms = {}\r"},{"line":42,"text":"    for cid, h in hands[\"clips\"].items():\r"},{"line":43,"text":"        fbx = next((w for w in h[\"written\"] if w.endswith(\".fbx\")), None)\r"},{"line":44,"text":"        if fbx:\r"},{"line":45,"text":"            dst = out / \"arms\" / Path(fbx).name\r"},{"line":46,"text":"            shutil.copy2(fbx, dst)\r"},{"line":47,"text":"            arms[cid] = {\"fbx\": str(dst), \"clip\": h[\"clip\"]}\r"},{"line":48,"text":"    folder = \"%s/%s\" % (game_folder, game_id)\r"},{"line":49,"text":"    mesh = \"SK_%s\" % game_id\r"},{"line":50,"text":"    plan = {\"gun\": {\"fbx\": str(out / Path(clips[\"fbx\"]).name), \"name\": mesh, \"clips\": [c[\"clip\"] for c in clips[\"clips\"]],\r"},{"line":51,"text":"                    \"rate\": 60},\r"},{"line":52,"text":"            \"arms\": [{\"fbx\": v[\"fbx\"], \"name\": v[\"clip\"]} for v in arms.values()],\r"},{"line":53,"text":"            \"staging\": \"%s/%s\" % (staging, game_id), \"dest\": folder, \"approved_by\": None}\r"},{"line":54,"text":"    (out / \"import_plan.json\").write_text(json.dumps(plan, indent=1), encoding=\"utf-8\")\r"},{"line":55,"text":"    d = dict(base) if isinstance(base, dict) else (json.loads(Path(base).read_text(encoding=\"utf-8\")) if base else {})\r"},{"line":56,"text":"    d.pop(\"_about\", None)\r"},{"line":57,"text":"    d[\"_about\"] = (\"%s, drafted by Gun Kit from %s (action %s); the game's numbers from its dump. A draft: it goes to \"\r"},{"line":58,"text":"                   \"Content/Data/Guns only after the Gate and the user\" % (game_id, facts[\"name\"], a[\"id\"]))\r"}],"name":"HAND_ROLE","start_line":18,"symbol_id":"hold-code/weaponlab/gunkit/export.py#var:HAND_ROLE"}}
