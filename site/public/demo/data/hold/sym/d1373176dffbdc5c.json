{"flow":{"kind":"var","name":"CONTRACT","noCFG":true,"reason":"CONTRACT is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":53,"file":"hold-code/weaponlab/gunkit/reference.py","kind":"var","language":"python","lines":[{"line":13,"text":"CONTRACT = \"weaponlab-reference/1\"\r"},{"line":14,"text":"\r"},{"line":15,"text":"\r"},{"line":16,"text":"def _sub(a, b):\r"},{"line":17,"text":"    return [a[i] - b[i] for i in range(3)]\r"},{"line":18,"text":"\r"},{"line":19,"text":"\r"},{"line":20,"text":"def _dot(a, b):\r"},{"line":21,"text":"    return sum(a[i] * b[i] for i in range(3))\r"},{"line":22,"text":"\r"},{"line":23,"text":"\r"},{"line":24,"text":"def _scale(a, k):\r"},{"line":25,"text":"    return [x * k for x in a]\r"},{"line":26,"text":"\r"},{"line":27,"text":"\r"},{"line":28,"text":"def _unit(a):\r"},{"line":29,"text":"    n = math.sqrt(_dot(a, a))\r"},{"line":30,"text":"    if n < 1e-12:\r"},{"line":31,"text":"        raise ValueError(\"a zero direction\")\r"},{"line":32,"text":"    return [x / n for x in a]\r"},{"line":33,"text":"\r"},{"line":34,"text":"\r"},{"line":35,"text":"def grip_frame(lips, up, forward, left):\r"},{"line":36,"text":"    \"\"\"The grip's frame: (origin, l, f, d), each a unit vector, square to one another. up: the magazine's line toward\r"},{"line":37,"text":"    its lips; forward and left: rough directions (the bore, the gun's left), squared up against up in that order.\"\"\"\r"},{"line":38,"text":"    d = _unit(up)\r"},{"line":39,"text":"    f = _unit(_sub(forward, _scale(d, _dot(forward, d))))\r"},{"line":40,"text":"    lv = _sub(_sub(left, _scale(d, _dot(left, d))), _scale(f, _dot(left, f)))\r"},{"line":41,"text":"    return (list(lips), _unit(lv), f, d)\r"},{"line":42,"text":"\r"},{"line":43,"text":"\r"},{"line":44,"text":"def to_grip(p, frame):\r"},{"line":45,"text":"    o, l, f, d = frame\r"},{"line":46,"text":"    q = _sub(p, o)\r"},{"line":47,"text":"    return [_dot(q, l), _dot(q, f), _dot(q, d)]\r"},{"line":48,"text":"\r"},{"line":49,"text":"\r"},{"line":50,"text":"def from_grip(c, frame):\r"},{"line":51,"text":"    o, l, f, d = frame\r"},{"line":52,"text":"    return [o[i] + l[i] * c[0] + f[i] * c[1] + d[i] * c[2] for i in range(3)]\r"},{"line":53,"text":"\r"}],"name":"CONTRACT","start_line":13,"symbol_id":"hold-code/weaponlab/gunkit/reference.py#var:CONTRACT"}}
