cs":[24]},{"cond":"for _g in range(generations)","id":24,"label":"loop_header","preds":[23,38],"stmts":null,"succs":[25,26]},{"id":25,"label":"loop_body","lines":[{"kind":"call","line":1957,"text":"for _k in range(pop):"}],"preds":[24],"stmts":["call range"],"succs":[27]},{"id":26,"label":"loop_exit","lines":[{"kind":"call","line":1968,"text":"sc, why = score(best[1])"},{"kind":"call","line":1969,"text":"tc, rv = clamp(best[1])"},{"kind":"call","line":1970,"text":"return {\"score\": round(sc, 2), \"x\": [round(v, 2) for v in best[1]], \"evaluations\": generations * pop + 2,"}],"preds":[24],"stmts":["call score","call clamp","call round"],"succs":[42]},{"cond":"for _k in range(pop)","id":27,"label":"loop_header","preds":[25,32],"stmts":null,"succs":[28,29]},{"id":28,"label":"loop_body","preds":[27],"stmts":null,"succs":[30]},{"cond":"kids[0][0] < best[0]","id":29,"label":"loop_exit","lines":[{"kind":"call","line":1961,"text":"kids.sort(key=lambda k: k[0])"}],"preds":[27],"stmts":["call kids.sort"],"succs":[33,35]},{"cond":"for i in range(dim)","id":30,"label":"loop_header","preds":[28,31],"stmts":null,"succs":[31,32]},{"id":31,"label":"loop_body","lines":[{"kind":"call","line":1958,"text":"x = [mean[i] + sig * scale[i] * rnd.gauss(0, 1) for i in range(dim)]"}],"preds":[30],"stmts":["call rnd.gauss"],"succs":[30]},{"id":32,"label":"loop_exit","lines":[{"kind":"call","line":1959,"text":"sc, why = score(x)"},{"kind":"call","line":1960,"text":"kids.append((sc, x, why))"}],"preds":[30],"stmts":["call score","call kids.append"],"succs":[27]},{"id":33,"label":"then","lines":[{"kind":"call","line":1964,"text":"sig = min(2.0, sig * 1.15)"}],"preds":[29],"stmts":["call min"],"succs":[34]},{"id":34,"label":"merge","preds":[33,35],"stmts":null,"succs":[36]},{"id":35,"label":"else","lines":[{"kind":"call","line":1966,"text":"sig = max(0.1, sig * 0.85)"}],"preds":[29],"stmts":["call max"],"succs":[34]},{"cond":"for i in range(dim)","id":36,"label":"loop_header","preds":[34,41],"stmts":null,"succs":[37,38]},{"id":37,"label":"loop_body","lines":[{"kind":"call","line":1967,"text":"mean = [sum(k[1][i] for k in kids[:mu]) / mu for i in range(dim)]"}],"preds":[36],"stmts":["call sum"],"succs":[39]},{"id":38,"label":"loop_exit","preds":[36],"stmts":null,"succs":[24]},{"cond":"for k in kids[:mu]","id":39,"label":"loop_header","preds":[37,40],"stmts":null,"succs":[40,41]},{"id":40,"label":"loop_body","preds":[39],"stmts":null,"succs":[39]},{"id":41,"label":"loop_exit","preds":[39],"stmts":null,"succs":[36]},{"cond":"for v in best[1]","id":42,"label":"loop_header","preds":[26,43],"stmts":null,"succs":[43,44]},{"id":43,"label":"loop_body","lines":[{"kind":"call","line":1970,"text":"return {\"score\": round(sc, 2), \"x\": [round(v, 2) for v in best[1]], \"evaluations\": generations * pop + 2,"}],"preds":[42],"stmts":["call round"],"succs":[42]},{"id":44,"label":"loop_exit","lines":[{"kind":"call","line":1971,"text":"\"moved_cm\": round(tc.length, 2), \"turned_deg\": round(rv.length, 1), **why}"},{"kind":"return","line":1970,"text":"return {\"score\": round(sc, 2), \"x\": [round(v, 2) for v in best[1]], \"evaluations\": generations * pop + 2,"}],"preds":[42],"stmts":["call round","call round","return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[44],"func_id":"hold-code/poselab_mcp/blender/lab.py#func:es_hold","issues":null},"source":{"end_line":1971,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"func","language":"python","lines":[{"line":1856,"text":"    def es_hold(self, side, rules, plan=None, glove_cm=0.0, other=True, soft=None, generations=40, pop=16, seed=7,\r"},{"line":1857,"text":"                sigma_cm=1.0, sigma_deg=8.0, freeze_thumb=False, from_pose=False, span_cm=None, turn_deg=None,\r"},{"line":1858,"text":"                keep_w=0.0, hand_only=False):\r"},{"line":1859,"text":"        \"\"\"A hold refined as one problem, from where the hand is now: the hand's place (3) and turn (3, about its\r"},{"line":1860,"text":"        palm's middle), each finger's bend off its measured posture (4, within its tolerance), the thumb's base\r"},{"line":1861,"text":"        turn (3) and its two bends (2), and the elbow's swing about the shoulder-to-wrist line (1), searched together\r"},{"line":1862,"text":"        by an evolution strategy (a population each generation, the best quarter recombined, the step widened when\r"},{"line":1863,"text":"        it helps and narrowed when not). Each try is scored by hold_score. from_pose: the bends are the hand's own\r"},{"line":1864,"text":"        now (a reference), not the plan's posture; span_cm, turn_deg: the hand kept that near its start; keep_w:\r"},{"line":1865,"text":"        each cm away from the start costs that; hand_only: the digits stay as they are. Returns the score's parts\r"},{"line":1866,"text":"        at the best.\"\"\"\r"},{"line":1867,"text":"        import random as _random\r"},{"line":1868,"text":"        self._need()\r"},{"line":1869,"text":"        rnd = _random.Random(seed)\r"},{"line":1870,"text":"        Lm, FL = self._limits()\r"},{"line":1871,"text":"        TL = self._thumb_limits()\r"},{"line":1872,"text":"        tree = self._tree()\r"},{"line":1873,"text":"        hn = self._n(\"hand\", side)\r"},{"line":1874,"text":"        H0 = self._bw(hn).copy()\r"},{"line":1875,"text":"        P0 = H0.translation.lerp(self._bw(self._n(\"finger\", side, \"middle\", \"01\")).translation, 0.5)\r"},{"line":1876,"text":"        n1 = self._n(\"finger\", side, \"thumb\", \"01\")\r"},{"line":1877,"text":"        self.snapshot(\"save\", \"_es\")\r"},{"line":1878,"text":"        fins = (\"index\", \"middle\", \"ring\", \"pinky\")\r"},{"line":1879,"text":"        base = {fi: list((plan or {}).get(fi, {}).get(\"curl\", [0.0, 0.0, 0.0])) for fi in fins}\r"},{"line":1880,"text":"        tols = {fi: float((plan or {}).get(fi, {}).get(\"tol\", 15.0)) for fi in fins}\r"},{"line":1881,"text":"        tpl = (plan or {}).get(\"thumb\") or {}\r"},{"line":1882,"text":"        tb = list(tpl.get(\"curl\", [0.0, 10.0, 6.0]))\r"},{"line":1883,"text":"        if from_pose:\r"},{"line":1884,"text":"            # the bends the hand has now: a reference put on it, or the frame the motion made\r"},{"line":1885,"text":"            fr_ = self._finger_report(side, FL)[0]\r"},{"line":1886,"text":"            base = {fi: [fr_[\"%s_%s\" % (fi, j)][0] for j in (\"01\", \"02\", \"03\")] for fi in fins}\r"},{"line":1887,"text":"            tr_ = self._thumb_report(side, TL)[0]\r"},{"line":1888,"text":"            tb = [0.0, tr_.get(\"thumb_02\", [0.0])[0], tr_.get(\"thumb_03\", [0.0])[0]]\r"},{"line":1889,"text":"        dim = 16\r"},{"line":1890,"text":"        scale = ([sigma_cm] * 3 + [sigma_deg] * 3 + [tols[fi] / 2.0 for fi in fins] + [sigma_deg * 2] * 3 + [10.0, 10.0]\r"},{"line":1891,"text":"                 + [10.0])\r"},{"line":1892,"text":"        if freeze_thumb:\r"},{"line":1893,"text":"            scale[10:15] = [0.0] * 5           # the thumb kept as it is: the hand and fingers move round it\r"},{"line":1894,"text":"        if hand_only:\r"},{"line":1895,"text":"            scale[6:15] = [0.0] * 9            # the digits as they are: the hand and the elbow move\r"},{"line":1896,"text":"\r"},{"line":1897,"text":"        def clamp(x):\r"},{"line":1898,"text":"            t = Vector(x[0:3])\r"},{"line":1899,"text":"            if span_cm is not None and t.length > span_cm:\r"},{"line":1900,"text":"                t = t.normalized() * span_cm\r"},{"line":1901,"text":"            rv = Vector(x[3:6])\r"},{"line":1902,"text":"            if turn_deg is not None and rv.length > turn_deg:\r"},{"line":1903,"text":"                rv = rv.normalized() * turn_deg\r"},{"line":1904,"text":"            return t, rv\r"},{"line":1905,"text":"\r"},{"line":1906,"text":"        def apply(x):\r"},{"line":1907,"text":"            self.snapshot(\"load\", \"_es\")\r"},{"line":1908,"text":"            tc, rv = clamp(x)\r"},{"line":1909,"text":"            t = tc / 100.0\r"},{"line":1910,"text":"            q = Quaternion(rv.normalized(), math.radians(rv.length)) if rv.length > 1e-6 else Quaternion()\r"},{"line":1911,"text":"            R = Matrix.Translation(t) @ Matrix.Translation(P0) @ q.to_matrix().to_4x4() @ Matrix.Translation(-P0) @ H0\r"},{"line":1912,"text":"            short = self._put_hand(side, Matrix.LocRotScale(R.translation, R.to_quaternion(), self._unit()))\r"},{"line":1913,"text":"            bpy.context.view_layer.update()\r"},{"line":1914,"text":"            if abs(x[15]) > 0.5:\r"},{"line":1915,"text":"                self._swing_elbow(side, max(-40.0, min(40.0, x[15])))     # the elbow about the shoulder-wrist line\r"},{"line":1916,"text":"                bpy.context.view_layer.update()\r"},{"line":1917,"text":"            if hand_only:\r"},{"line":1918,"text":"                return short\r"},{"line":1919,"text":"            for k_, fi in enumerate(fins):\r"},{"line":1920,"text":"                d = max(-tols[fi], min(tols[fi], x[6 + k_]))\r"},{"line":1921,"text":"                c3 = [base[fi][0] + d, base[fi][1] + d, base[fi][2] + d * 2.0 / 3.0]\r"},{"line":1922,"text":"                for j, cc in zip((\"01\", \"02\", \"03\"), c3):\r"},{"line":1923,"text":"                    self._set_curl(side, fi, j, cc, FL)\r"},{"line":1924,"text":"            tv = Vector(x[10:13])\r"},{"line":1925,"text":"            if freeze_thumb:\r"},{"line":1926,"text":"                bpy.context.view_layer.update()\r"},{"line":1927,"text":"                return short\r"},{"line":1928,"text":"            if tv.length > 1e-6:\r"},{"line":1929,"text":"                head = self._bw(n1).translation.copy()\r"},{"line":1930,"text":"                self._turn_about(n1, tv.normalized(), tv.length, head)\r"},{"line":1931,"text":"            bpy.context.view_layer.update()\r"},{"line":1932,"text":"            for j, b in ((\"02\", tb[1] + x[13]), (\"03\", tb[2] + x[14])):\r"},{"line":1933,"text":"                cur = self._thumb_report(side, TL)[0].get(\"thumb_\" + j, [0, 0])[0]\r"},{"line":1934,"text":"                if self.R.get(\"thumb_hinge\") == \"ray\":\r"},{"line":1935,"text":"                    self._thumb_flex(side, j, b - cur)\r"},{"line":1936,"text":"                else:\r"},{"line":1937,"text":"                    pass\r"},{"line":1938,"text":"            if self.R.get(\"thumb_hinge\") != \"ray\":\r"},{"line":1939,"text":"                self._set_thumb_bend(side, tb[1] + x[13], tb[2] + x[14], TL)\r"},{"line":1940,"text":"            bpy.context.view_layer.update()\r"},{"line":1941,"text":"            return short\r"},{"line":1942,"text":"\r"},{"line":1943,"text":"        def score(x):\r"},{"line":1944,"text":"            short = apply(x)\r"},{"line":1945,"text":"            sc, why = self.hold_score(side, rules, glove_cm, other, soft, tree, short)\r"},{"line":1946,"text":"            if keep_w:\r"},{"line":1947,"text":"                tc, rv = clamp(x)\r"},{"line":1948,"text":"                sc += keep_w * (tc.length + 0.05 * rv.length)\r"},{"line":1949,"text":"            return sc, why\r"},{"line":1950,"text":"\r"},{"line":1951,"text":"        mean = [0.0] * dim\r"},{"line":1952,"text":"        sig = 1.0\r"},{"line":1953,"text":"        best = (score(mean)[0], list(mean), score(mean)[1])\r"},{"line":1954,"text":"        mu = max(2, pop // 4)\r"},{"line":1955,"text":"        for _g in range(generations):\r"},{"line":1956,"text":"            kids = []\r"},{"line":1957,"text":"            for _k in range(pop):\r"},{"line":1958,"text":"                x = [mean[i] + sig * scale[i] * rnd.gauss(0, 1) for i in range(dim)]\r"},{"line":1959,"text":"                sc, why = score(x)\r"},{"line":1960,"text":"                kids.append((sc, x, why))\r"},{"line":1961,"text":"            kids.sort(key=lambda k: k[0])\r"},{"line":1962,"text":"            if kids[0][0] < best[0]:\r"},{"line":1963,"text":"                best = kids[0]\r"},{"line":1964,"text":"                sig = min(2.0, sig * 1.15)\r"},{"line":1965,"text":"            else:\r"},{"line":1966,"text":"                sig = max(0.1, sig * 0.85)\r"},{"line":1967,"text":"            mean = [sum(k[1][i] for k in kids[:mu]) / mu for i in range(dim)]\r"},{"line":1968,"text":"        sc, why = score(best[1])\r"},{"line":1969,"text":"        tc, rv = clamp(best[1])\r"},{"line":1970,"text":"        return {\"score\": round(sc, 2), \"x\": [round(v, 2) for v in best[1]], \"evaluations\": generations * pop + 2,\r"},{"line":1971,"text":"                \"moved_cm\": round(tc.length, 2), \"turned_deg\": round(rv.length, 1), **why}\r"}],"name":"es_hold","start_line":1856,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:es_hold"}}
