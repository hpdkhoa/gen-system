op_header","preds":[20,22],"stmts":null,"succs":[22,23]},{"id":22,"label":"loop_body","preds":[21],"stmts":null,"succs":[21]},{"id":23,"label":"loop_exit","lines":[{"kind":"return","line":134,"text":"return {k: v[\"file\"] for k, v in rep[\"views\"].items()}"}],"preds":[21],"stmts":["return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[1,15,23],"func_id":"hold-code/weaponlab/blueprint/build.py#func:render","issues":null},"source":{"end_line":134,"file":"hold-code/weaponlab/blueprint/build.py","kind":"func","language":"python","lines":[{"line":111,"text":"def render(gun, cm_per_px=0.03, timeout=600):\r"},{"line":112,"text":"    \"\"\"The built model seen from its left and right sides square on (at cm_per_px) and from three quarters; each\r"},{"line":113,"text":"    picture labelled as a Blueprint Lab model view, not a game view.\"\"\"\r"},{"line":114,"text":"    import cv2\r"},{"line":115,"text":"    out = store.folder(gun, \"model\", \"views\")\r"},{"line":116,"text":"    blend = store.folder(gun, \"model\") / (\"%s.blend\" % gun)\r"},{"line":117,"text":"    if not blend.exists():\r"},{"line":118,"text":"        raise FileNotFoundError(\"build the model first\")\r"},{"line":119,"text":"    jf = out / \"render.job.json\"\r"},{"line":120,"text":"    jf.write_text(json.dumps({\"out\": str(out), \"cm_per_px\": cm_per_px}), encoding=\"utf-8\")\r"},{"line":121,"text":"    p = subprocess.run([str(project().blender()), \"-b\", str(blend), \"-P\", str(RENDER), \"--\", str(jf)],\r"},{"line":122,"text":"                       capture_output=True, text=True, timeout=timeout)\r"},{"line":123,"text":"    (out / \"render.log\").write_text((p.stdout or \"\") + \"\\n\" + (p.stderr or \"\"), encoding=\"utf-8\", errors=\"replace\")\r"},{"line":124,"text":"    if p.returncode != 0 or \"BLUEPRINT RENDER\" not in (p.stdout or \"\"):\r"},{"line":125,"text":"        tail = [l for l in ((p.stdout or \"\") + (p.stderr or \"\")).splitlines() if l.strip()][-15:]\r"},{"line":126,"text":"        raise RuntimeError(\"the render failed (see %s):\\n%s\" % (out / \"render.log\", \"\\n\".join(tail)))\r"},{"line":127,"text":"    rep = json.loads((out / \"render.json\").read_text(encoding=\"utf-8\"))\r"},{"line":128,"text":"    for name, v in rep[\"views\"].items():\r"},{"line":129,"text":"        img = cv2.imread(v[\"file\"])\r"},{"line":130,"text":"        label = \"BLUEPRINT LAB MODEL %s, %s (not a game view)\" % (gun, name.replace(\"view_\", \"\").replace(\"_\", \" \"))\r"},{"line":131,"text":"        cv2.rectangle(img, (0, 0), (min(img.shape[1], 12 + 9 * len(label)), 26), (255, 255, 255), -1)\r"},{"line":132,"text":"        cv2.putText(img, label, (6, 18), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 0, 0), 1)\r"},{"line":133,"text":"        cv2.imwrite(v[\"file\"], img)\r"},{"line":134,"text":"    return {k: v[\"file\"] for k, v in rep[\"views\"].items()}\r"}],"name":"render","start_line":111,"symbol_id":"hold-code/weaponlab/blueprint/build.py#func:render"}}
