erge","lines":[{"kind":"call","line":562,"text":"miss[s] = round(self._two_bone(s, W.translation, pole_world=pole), 2)"},{"kind":"call","line":563,"text":"hn = self._n(\"hand\", s)"},{"kind":"call","line":564,"text":"self._set_world(hn, Matrix.LocRotScale(self._bw(hn).translation, W.to_quaternion(), self._unit()))"},{"kind":"call","line":565,"text":"self._roll_forearm(s)"}],"preds":[15,13],"stmts":["call round","call self._two_bone","call self._n","call self._set_world","call Matrix.LocRotScale","call self._bw","call W.to_quaternion","call self._unit","call self._roll_forearm"],"succs":[12]}],"effects":["unknown"],"entry":0,"exits":[14],"func_id":"hold-code/poselab_mcp/blender/lab.py#func:move_gun","issues":null},"source":{"end_line":566,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"func","language":"python","lines":[{"line":529,"text":"    def move_gun(self, roll=0.0, swing=0.0, pitch=0.0, right=0.0, forward=0.0, up=0.0, pivot=\"stock\", keep_hands=(\"l\", \"r\")):\r"},{"line":530,"text":"        \"\"\"Moves the rifle from where it stands: roll about the bore, swing and pitch about the pivot, then a move in\r"},{"line":531,"text":"        the view (cm). The hands in keep_hands keep their hold (arm IK), each elbow pointing the way it pointed (the\r"},{"line":532,"text":"        arm IK's default pole once bent a clip's right wrist past its limit in every frame: ToangTown's AK-47 run).\"\"\"\r"},{"line":533,"text":"        self._need()\r"},{"line":534,"text":"        G = self._gun()\r"},{"line":535,"text":"        held = {s: G.inverted() @ self._bw(self._n(\"hand\", s)) for s in keep_hands}\r"},{"line":536,"text":"        bend = {}\r"},{"line":537,"text":"        for s in keep_hands:\r"},{"line":538,"text":"            S0 = self._bw(self._n(\"upperarm\", s)).translation\r"},{"line":539,"text":"            E0 = self._bw(self._n(\"lowerarm\", s)).translation\r"},{"line":540,"text":"            W0 = self._bw(self._n(\"hand\", s)).translation\r"},{"line":541,"text":"            line = W0 - S0\r"},{"line":542,"text":"            foot = S0 + line * (max(0.0, min(1.0, (E0 - S0).dot(line) / max(line.length_squared, 1e-12))))\r"},{"line":543,"text":"            bend[s] = (E0, E0 - foot, W0)\r"},{"line":544,"text":"        barrel = (G.to_quaternion() @ Vector((0.0, -1.0, 0.0))).normalized()\r"},{"line":545,"text":"        bore = self._point(\"bore\") if \"bore\" in self.R.get(\"points\", {}) else G.translation\r"},{"line":546,"text":"        pv = self._point(pivot) if isinstance(pivot, str) else self._from(pivot, \"gun\")\r"},{"line":547,"text":"        lateral = barrel.cross(VIEW_UP).normalized()\r"},{"line":548,"text":"\r"},{"line":549,"text":"        def about(point, axis, deg):\r"},{"line":550,"text":"            return Matrix.Translation(point) @ Quaternion(axis, math.radians(deg)).to_matrix().to_4x4() @ Matrix.Translation(-point)\r"},{"line":551,"text":"\r"},{"line":552,"text":"        M = Matrix.Translation((VIEW_RIGHT * right + VIEW_FWD * forward + VIEW_UP * up) / 100.0) \\\r"},{"line":553,"text":"            @ about(pv, VIEW_UP, swing) @ about(pv, lateral, pitch) @ about(bore, -barrel, roll)\r"},{"line":554,"text":"        self._set_world(self.names[\"gun\"], M @ self._bw(self.names[\"gun\"]))\r"},{"line":555,"text":"        self._place_rifle()\r"},{"line":556,"text":"        miss = {}\r"},{"line":557,"text":"        G = self._gun()\r"},{"line":558,"text":"        for s, H in held.items():\r"},{"line":559,"text":"            W = G @ H\r"},{"line":560,"text":"            E0, out, W0 = bend[s]\r"},{"line":561,"text":"            pole = E0 + out * 2.0 + (W.translation - W0) * 0.5 if out.length > 1e-5 else None\r"},{"line":562,"text":"            miss[s] = round(self._two_bone(s, W.translation, pole_world=pole), 2)\r"},{"line":563,"text":"            hn = self._n(\"hand\", s)\r"},{"line":564,"text":"            self._set_world(hn, Matrix.LocRotScale(self._bw(hn).translation, W.to_quaternion(), self._unit()))\r"},{"line":565,"text":"            self._roll_forearm(s)\r"},{"line":566,"text":"        return {\"hands_off_their_hold_cm\": miss, \"barrel_off_deg\": round(self._barrel_off(), 2)}\r"}],"name":"move_gun","start_line":529,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:move_gun"}}
