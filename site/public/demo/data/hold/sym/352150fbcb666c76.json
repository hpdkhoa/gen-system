{"line":464,"text":"        gap = finger_gap(side, \"thumb\", tree)\r"},{"line":465,"text":"        if gap <= GLOVE + 0.05:\r"},{"line":466,"text":"            if gap < GLOVE - 0.1:\r"},{"line":467,"text":"                set_thumb(side, *prev)\r"},{"line":468,"text":"            return\r"},{"line":469,"text":"        prev = b\r"}],"name":"thumb_wrap","start_line":456,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:thumb_wrap"}}
