e":"hold-code/weaponlab/blueprint/check.py","kind":"func","language":"python","lines":[{"line":167,"text":"def run(gun, reference=None, reference_holes=(), length_fact=\"overall_length\", weight_fact=\"weight\"):\r"},{"line":168,"text":"    \"\"\"Every check. reference: the name of a kept silhouette trace the side outline is held to; reference_holes:\r"},{"line":169,"text":"    kept traces of its openings (a trigger guard).\"\"\"\r"},{"line":170,"text":"    bp = store.load(gun, \"blueprint\")\r"},{"line":171,"text":"    src = store.load(gun, \"sources\")\r"},{"line":172,"text":"    out = {\"contract\": C.check_blueprint(bp, sources=src)}\r"},{"line":173,"text":"    polys = silhouette(bp)\r"},{"line":174,"text":"    facts = Sp.facts(gun)\r"},{"line":175,"text":"    if polys:\r"},{"line":176,"text":"        ys = [p[0] for poly in polys for p in poly]\r"},{"line":177,"text":"        zs = [p[1] for poly in polys for p in poly]\r"},{"line":178,"text":"        out[\"bounds_cm\"] = {\"y\": [round(min(ys), 3), round(max(ys), 3)], \"z\": [round(min(zs), 3), round(max(zs), 3)]}\r"},{"line":179,"text":"        if length_fact in facts:\r"},{"line":180,"text":"            L, want = max(ys) - min(ys), facts[length_fact][\"value\"]\r"},{"line":181,"text":"            out[\"length\"] = {\"cm\": round(L, 3), \"fact_cm\": want, \"share_off\": round(abs(L - want) / want, 4),\r"},{"line":182,"text":"                             \"ok\": abs(L - want) / want <= PASS[\"length_share\"]}\r"},{"line":183,"text":"    if reference:\r"},{"line":184,"text":"        t = Pl.trace(gun, reference)\r"},{"line":185,"text":"        holes = [Pl.trace(gun, h)[\"outline_cm\"] for h in reference_holes]\r"},{"line":186,"text":"        o = outline(bp, t[\"outline_cm\"], ref_holes=holes)\r"},{"line":187,"text":"        o[\"reference\"] = reference\r"},{"line":188,"text":"        o[\"ok\"] = o[\"iou\"] >= PASS[\"iou\"] and o[\"gap_mean_cm\"] <= PASS[\"gap_mean_cm\"]\r"},{"line":189,"text":"        out[\"outline\"] = o\r"},{"line":190,"text":"    out[\"detail\"] = detail(bp, src)\r"},{"line":191,"text":"    kg = sum(volume_cm3(p) * density(p[\"finish\"]) for p in bp[\"parts\"].values()) / 1000.0\r"},{"line":192,"text":"    out[\"weight\"] = {\"kg\": round(kg, 3)}\r"},{"line":193,"text":"    if weight_fact in facts:\r"},{"line":194,"text":"        out[\"weight\"].update({\"fact_kg\": facts[weight_fact][\"value\"], \"ratio\": round(kg / facts[weight_fact][\"value\"], 3),\r"},{"line":195,"text":"                              \"note\": \"warning only: the copy is solid where the gun is hollow\"})\r"},{"line":196,"text":"    out[\"overlays\"] = [overlay(gun, bp, f) for f in src.get(\"figures\", []) if \"scale\" in f and \"frame\" in f]\r"},{"line":197,"text":"    out[\"ok\"] = not out[\"contract\"] and all(out[k].get(\"ok\", True) for k in (\"length\", \"outline\", \"detail\") if k in out)\r"},{"line":198,"text":"    bp[\"checks\"] = {k: v for k, v in out.items() if k != \"overlays\"}\r"},{"line":199,"text":"    store.save(gun, \"blueprint\", bp, strict=False)\r"},{"line":200,"text":"    (store.folder(gun, \"check\") / \"check.json\").write_text(json.dumps(out, indent=1), encoding=\"utf-8\")\r"},{"line":201,"text":"    return out\r"}],"name":"run","start_line":167,"symbol_id":"hold-code/weaponlab/blueprint/check.py#func:run"}}
