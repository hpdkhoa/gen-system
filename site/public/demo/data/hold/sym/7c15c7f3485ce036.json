", \"mag_lips\"):\r"},{"line":250,"text":"        if m in marks:\r"},{"line":251,"text":"            free = next((r for r in parts if a[\"parts\"].get(r, {}).get(\"kind\") == \"free\" and r in (\"magazine\", \"cell\")), None)\r"},{"line":252,"text":"            if free:\r"},{"line":253,"text":"                mark_parts[m] = free\r"},{"line":254,"text":"    # every mark the action needs exists, at least as a point on the body\r"},{"line":255,"text":"    for m in a.get(\"marks\", []):\r"},{"line":256,"text":"        marks.setdefault(m, [0.0, 0.0, 0.0])\r"},{"line":257,"text":"    pm = {\"contract\": CONTRACT, \"name\": \"Proxy_\" + \"\".join(w.title() for w in action_id.split(\"_\")), \"action\": action_id,\r"},{"line":258,"text":"          \"model\": None, \"units\": \"cm\", \"forward\": \"+Y\", \"up\": \"+Z\", \"origin\": [0.0, 0.0, 0.0], \"proxy\": True,\r"},{"line":259,"text":"          \"parts\": parts, \"marks\": marks, \"mark_parts\": mark_parts, \"normals\": normals,\r"},{"line":260,"text":"          \"magazine\": {\"lips\": lips} if lips else None}\r"},{"line":261,"text":"    return {\"partsmap\": pm, \"shapes\": copy.deepcopy(shapes)}\r"}],"name":"proxy","start_line":60,"symbol_id":"hold-code/weaponlab/gunkit/proxy.py#func:proxy"}}
