.update({\"slide_rear\": \"slide\", \"slide_front\": \"slide\"})\r"},{"line":160,"text":"        else:\r"},{"line":161,"text":"            part(\"latch\", \"CellLatch\", S((0.6, 1.0, 1.0), (-1.6, -1.5, -2.0)), axis=[1, 0, 0], travel_cm=0.4)\r"},{"line":162,"text":"            part(\"vent\", \"Vent\", S((2.4, 6.0, 0.4), (0.0, 4.0, 0.5)), axis=[1, 0, 0], turn_deg=-25.0, pivot=[0.0, 1.0, 0.5])\r"},{"line":163,"text":"            marks.update({\"indicator\": [-1.6, -2.0, 0.0], \"latch\": [-1.6, -1.5, -2.0]})\r"},{"line":164,"text":"        part(\"trigger\", \"Trigger\", S((0.5, 0.6, 1.6), (0.0, -1.0, -4.0)), axis=[1, 0, 0], turn_deg=15.0, pivot=[0.0, -1.0, -3.0])\r"},{"line":165,"text":"        role = \"magazine\" if action_id == \"pistol_slide\" else \"cell\"\r"},{"line":166,"text":"        shapes.append(_box(\"Magazine\", (2.2, 3.4, 11.0), (0.0, -5.0, -8.0), role))\r"},{"line":167,"text":"        parts[role] = {\"objects\": [\"Magazine\"]}\r"},{"line":168,"text":"    elif action_id == \"open_bolt\":\r"},{"line":169,"text":"        part(\"bolt\", \"Bolt\", S((2.0, 11.0, 2.5), (0.0, -5.5, 1.0)), axis=[0, -1, 0], travel_cm=11.0)\r"},{"line":170,"text":"        shapes.append(_box(\"CockingHandle\", (2.5, 1.2, 1.2), (2.8, -2.0, 1.0), \"bolt\"))\r"},{"line":171,"text":"        parts[\"bolt\"][\"objects\"].append(\"CockingHandle\")\r"},{"line":172,"text":"        part(\"release\", \"MagCatch\", S((1.0, 1.0, 0.6), (-2.0, 3.0, -2.5)), axis=[1, 0, 0], travel_cm=0.4)\r"},{"line":173,"text":"        part(\"trigger\", \"Trigger\", S((0.6, 0.8, 2.0), (0.0, -6.5, -5.5)), axis=[1, 0, 0], turn_deg=12.0, pivot=[0.0, -6.5, -4.5])\r"},{"line":174,"text":"        marks.update({\"handle\": [3.4, -2.0, 1.0], \"release\": [-2.0, 3.0, -2.5]})\r"},{"line":175,"text":"        mark_parts.update({\"handle\": \"bolt\"})\r"},{"line":176,"text":"    elif action_id == \"revolver_swing\":\r"},{"line":177,"text":"        part(\"crane\", \"Crane\", S((1.0, 4.5, 1.0), (1.8, 1.0, -1.5)), axis=[0, 1, 0], t