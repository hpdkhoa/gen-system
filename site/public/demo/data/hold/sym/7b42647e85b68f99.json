9,"text":"            R_, T_ = Fi[:3, :3], Fi[:3, 3]\r"},{"line":170,"text":"            L_ = P @ R_.T + T_\r"},{"line":171,"text":"            idx = (L_ - g[\"origin\"]) / g[\"cell\"]\r"},{"line":172,"text":"            dd = _trilinear(g[\"d\"], idx) * 100.0\r"},{"line":173,"text":"            near = dd < best\r"},{"line":174,"text":"            best[near] = dd[near]\r"},{"line":175,"text":"            which[near] = part\r"},{"line":176,"text":"            if want_normal and near.any():\r"},{"line":177,"text":"                h = 0.5\r"},{"line":178,"text":"                gx = (_trilinear(g[\"d\"], idx[near] + [h, 0, 0]) - _trilinear(g[\"d\"], idx[near] - [h, 0, 0]))\r"},{"line":179,"text":"                gy = (_trilinear(g[\"d\"], idx[near] + [0, h, 0]) - _trilinear(g[\"d\"], idx[near] - [0, h, 0]))\r"},{"line":180,"text":"                gz = (_trilinear(g[\"d\"], idx[near] + [0, 0, h]) - _trilinear(g[\"d\"], idx[near] - [0, 0, h]))\r"},{"line":181,"text":"                gl = np.c_[gx, gy, gz]\r"},{"line":182,"text":"                gl /= np.maximum(np.linalg.norm(gl, axis=1, keepdims=True), 1e-12)\r"},{"line":183,"text":"                R3 = np.array(F.to_3x3())\r"},{"line":184,"text":"                nrm[near] = gl @ R3.T\r"},{"line":185,"text":"        return best, which, nrm\r"}],"name":"sdf_query","start_line":157,"symbol_id":"hold-code/poselab_mcp/blender/sdflab.py#func:sdf_query"}}
