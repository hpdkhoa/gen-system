language":"python","lines":[{"line":135,"text":"def lathe_profile(outline, axis_z, step_cm=0.25):\r"},{"line":136,"text":"    \"\"\"A round part's profile (y, r) from its side outline: at each y, r is the outline's greatest distance from\r"},{"line":137,"text":"    the axis line (z = axis_z).\"\"\"\r"},{"line":138,"text":"    b = box(outline)\r"},{"line":139,"text":"    n = max(2, int((b[\"y\"][1] - b[\"y\"][0]) / step_cm) + 1)\r"},{"line":140,"text":"    prof = []\r"},{"line":141,"text":"    for k in range(n):\r"},{"line":142,"text":"        y = b[\"y\"][0] + (b[\"y\"][1] - b[\"y\"][0]) * k / (n - 1)\r"},{"line":143,"text":"        zs = []\r"},{"line":144,"text":"        for a, c in zip(outline, outline[1:] + outline[:1]):\r"},{"line":145,"text":"            if (a[0] - y) * (c[0] - y) <= 0 and a[0] != c[0]:\r"},{"line":146,"text":"                t = (y - a[0]) / (c[0] - a[0])\r"},{"line":147,"text":"                zs.append(a[1] + (c[1] - a[1]) * t)\r"},{"line":148,"text":"        if zs:\r"},{"line":149,"text":"            prof.append([round(y, 4), round(max(abs(z - axis_z) for z in zs), 4)])\r"},{"line":150,"text":"    return prof\r"}],"name":"lathe_profile","start_line":135,"symbol_id":"hold-code/weaponlab/blueprint/plan.py#func:lathe_profile"}}
