ext":"        ev = self.rifle_mesh.evaluated_get(dg)\r"},{"line":541,"text":"        me = ev.to_mesh()\r"},{"line":542,"text":"        Mw = self.rifle_mesh.matrix_world\r"},{"line":543,"text":"        bvh = BVHTree.FromPolygons([Mw @ v.co for v in me.vertices], [tuple(p.vertices) for p in me.polygons])\r"},{"line":544,"text":"        ev.to_mesh_clear()\r"},{"line":545,"text":"        surf = self.Surface(bvh)\r"},{"line":546,"text":"        Pv = [Vector(p) for p in P]\r"},{"line":547,"text":"        hand_bvh = {}\r"},{"line":548,"text":"        labs_all = {}\r"},{"line":549,"text":"        for s in (\"r\", \"l\"):\r"},{"line":550,"text":"            sel = {i for i, b in enumerate(bone) if b.endswith(\"_\" + s)}\r"},{"line":551,"text":"            ts = [t for t in tris if t[0] in sel and t[1] in sel and t[2] in sel]\r"},{"line":552,"text":"            hand_bvh[s] = (BVHTree.FromPolygons(Pv, ts) if ts else None, ts)\r"},{"line":553,"text":"            labs_all[s] = self.hand_labels(s, P, N, bone)\r"},{"line":554,"text":"        vert_d, pairs, totals = {}, {}, {}\r"},{"line":555,"text":"        for s in sides:\r"},{"line":556,"text":"            other = \"r\" if s == \"l\" else \"l\"\r"},{"line":557,"text":"            ob_bvh, ots = hand_bvh[other]\r"},{"line":558,"text":"            tot = {\"contact_cm2\": 0.0, \"press_cm2\": 0.0, \"deepest_cm\": 0.0, \"hand_press_cm2\": 0.0, \"hand_deepest_cm\": 0.0,\r"},{"line":559,"text":"                   \"on_other_cm2\": 0.0, \"by_region\": {}}\r"},{"line":560,"text":"            for i, lab in labs_all[s].items():\r"},{"line":561,"text":"                p, n, a = Pv[i], Vector(N[i]), A[i]\r"},{"line":562,"text":"                loc, nrm, _pi, dist = bvh.find_nearest(p, near_cm / 100.0)\r"},{"line":563,"text":"                if loc is not None:\r"},{"line":564,"text":"                    d = -dist if dist < 0.02 and surf.inside(p) else dist\r"},{"line":565,"text":"                    d_cm = d * 100.0\r"},{"line":566,"text":"                    vert_d[i] = d_cm\r"},{"line":567,"text":"                    _c, si, _dd = skd.find(loc)\r"},{"line":568,"text":"                    reg = SL[si] if si is not None else \"other\"\r"},{"line":569,"text":"                    face = math.degrees(n.angle(-nrm)) if n.length > 0 and nrm.length > 0 else 180.0\r"},{"line":570,"text":"                    pr = pairs.setdefault((s, lab, reg), {\"contact_cm2\": 0.0, \"press_cm2\": 0.0, \"deepest_cm\": 0.0, \"facing_sum\": 0.0})\r"},{"line":571,"text":"                    if d_cm < 0.0:\r"},{"line":572,"text":"                        pr[\"press_cm2\"] += a\r"},{"line":573,"text":"                        pr[\"deepest_cm\"] = max(pr[\"deepest_cm\"], -d_cm)\r"},{"line":574,"text":"                        tot[\"press_cm2\"] += a\r"},{"line":575,"text":"                        tot[\"deepest_cm\"] = max(tot[\"deepest_cm\"], -d_cm)\r"},{"line":576,"text":"                    if d_cm <= band_cm and (d_cm < 0.0 or face <= facing_max_deg):\r"},{"line":577,"text":"                        pr[\"contact_cm2\"] += a\r"},{"line":578,"text":"                        pr[\"facing_sum\"] += face * a\r"},{"line":579,"text":"                        tot[\"contact_cm2\"] += a\r"},{"line":580,"text":"                        tot[\"by_region\"][reg] = tot[\"by_region\"].get(reg, 0.0) + a\r"},{"line":581,"text":"                if ob_bvh is not None:\r"},{"line":582,"text":"                    l2, n2, ti, d2 = ob_bvh.find_nearest(p, near_cm / 100.0)\r"},{"line":583,"text":"                    if l2 is not None:\r"},{"line":584,"text":"                        inside = (p - l2).dot(n2) < 0.0 and d2 < 0.02\r"},{"line":585,"text":"                        dd = (-d2 if inside else d2) * 100.0\r"},{"line":586,"text":"                        okey = (s, lab, \"hand_%s:%s\" % (other, labs_all[other].get(ots[ti][0], \"?\")))\r"},{"line":587,"text":"                        pr = pairs.setdefault(okey, {\"contact_cm2\": 0.0, \"press_cm2\": 0.0, \"deepest_cm\": 0.0, \"facing_sum\": 0.0})\r"},{"line":588,"text":"                        if dd < -skin_give_cm:\r"},{"line":589,"text":"                            pr[\"press_cm2\"] += a\r"},{"line":590,"text":"                            pr[\"deepest_cm\"] = max(pr[\"deepest_cm\"], -dd - skin_give_cm)\r"},{"line":591,"text":"                            tot[\"hand_press_cm2\"] += a\r"},{"line":592,"text":"                            tot[\"hand_deepest_cm\"] = max(tot[\"hand_deepest_cm\"], -dd - skin_give_cm)\r"},{"line":593,"text":"                        if dd <= band_cm:\r"},{"line":594,"text":"                            pr[\"contact_cm2\"] += a\r"},{"line":595,"text":"                            tot[\"on_other_cm2\"] += a\r"},{"line":596,"text":"                        hd = dd + skin_give_cm if dd < 0.0 else dd\r"},{"line":597,"text":"                        vert_d[i] = min(vert_d.get(i, 99.0), hd if hd < 0.0 else max(hd, 0.0))\r"},{"line":598,"text":"            totals[s] = {k: (round(v, 2) if isinstance(v, float) else {kk: round(vv, 2) for kk, vv in sorted(v.items(), key=lambda x: -x[1])})\r"},{"line":599,"text":"                         for k, v in tot.items()}\r"},{"line":600,"text":"        # each region's cover: its samples with a skin vertex within band_cm (0.35 at least: the samples are 2 mm apart)\r"},{"line":601,"text":"        kd = KDTree(len(Pv))\r"},{"line":602,"text":"        for i, p in enumerate(Pv):\r"},{"line":603,"text":"            kd.insert(p, i)\r"},{"line":604,"text":"        kd.balance()\r"},{"line":605,"text":"        owner = {}\r"},{"line":606,"text":"        for s in (\"r\", \"l\"):\r"},{"line":607,"text":"            owner.update({i: (s, l_) for i, l_ in labs_all[s].items()})\r"},{"line":608,"text":"        a_s = SAMPLE_CM * SAMPLE_CM\r"},{"line":609,"text":"        regions, touch = {}, {}\r"},{"line":610,"text":"        for k, (p, reg) in enumerate(zip(SW, SL)):\r"},{"line":611,"text":"            rc = regions.setdefault(reg, {\"area_cm2\": 0.0, \"touched_cm2\": 0.0, \"by\": {}})\r"},{"line":612,"text":"            rc[\"area_cm2\"] += a_s\r"},{"line":613,"text":"            _c, vi, dist = kd.find(Vector(p))\r"},{"line":614,"text":"            if vi is not None and dist * 100.0 <= max(band_cm, 0.35) and vi in owner:\r"},{"line":615,"text":"                rc[\"touched_cm2\"] += a_s\r"},{"line":616,"text":"                who = \"%s:%s\" % (owner[vi][0], _lab_key(owner[vi][1]))\r"},{"line":617,"text":"                rc[\"by\"][who] = rc[\"by\"].get(who, 0.0) + a_s\r"},{"line":618,"text":"                touch[k] = owner[vi]\r"},{"line":619,"text":"        for rc in regions.values():\r"},{"line":620,"text":"            rc[\"share\"] = round(rc[\"touched_cm2\"] / rc[\"area_cm2\"], 3) if rc[\"area_cm2\"] else 0.0\r"},{"line":621,"text":"            rc[\"area_cm2\"] = round(rc[\"area_cm2\"], 2)\r"},{"line":622,"text":"            rc[\"touched_cm2\"] = round(rc[\"touched_cm2\"], 2)\r"},{"line":623,"text":"            rc[\"by\"] = {k: round(v, 2) for k, v in sorted(rc[\"by\"].items(), key=lambda x: -x[1])}\r"},{"line":624,"text":"        rows = []\r"},{"line":625,"text":"        for (s, lab, reg), pr in pairs.items():\r"},{"line":626,"text":"            if pr[\"contact_cm2\"] <= 0.0 and pr[\"press_cm2\"] <= 0.0:\r"},{"line":627,"text":"                continue\r"},{"line":628,"text":"            rows.append({\"hand\": s, \"hand_part\": lab, \"touches\": reg, \"contact_cm2\": round(pr[\"contact_cm2\"], 2),\r"},{"line":629,"text":"                         \"press_cm2\": round(pr[\"press_cm2\"], 2), \"deepest_cm\": round(pr[\"deepest_cm\"], 2),\r"},{"line":630,"text":"                         \"facing_deg\": round(pr[\"facing_sum\"] / pr[\"contact_cm2\"], 1) if pr[\"contact_cm2\"] > 0 and pr[\"facing_sum\"] else None})\r"},{"line":631,"text":"        rows.sort(key=lambda r: (-r[\"press_cm2\"], -r[\"contact_cm2\"]))\r"},{"line":632,"text":"        self._cm_state = {\"vert_d\": vert_d, \"labels\": labs_all, \"touch\": touch, \"band_cm\": band_cm, \"SW\": SW, \"SL\": SL}\r"},{"line":633,"text":"        return {\"pairs\": rows, \"hands\": totals, \"regions\": regions, \"band_cm\": band_cm}\r"}],"name":"contact_map","start_line":524,"symbol_id":"hold-code/poselab_mcp/blender/contactlab.py#method:ContactMixin.contact_map"}}
