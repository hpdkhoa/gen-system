is the gun tip to tip along the bore). The scale's two points are the\r"},{"line":197,"text":"    outline's end points carried onto one line along the direction.\"\"\"\r"},{"line":198,"text":"    doc = store.load(gun, \"sources\")\r"},{"line":199,"text":"    f = _fig(doc, fig_id)\r"},{"line":200,"text":"    if direction is None:\r"},{"line":201,"text":"        direction = axes(f)[0] if \"frame\" in f else (1.0, 0.0)\r"},{"line":202,"text":"    d = math.hypot(*direction)\r"},{"line":203,"text":"    u = (direction[0] / d, direction[1] / d)\r"},{"line":204,"text":"    proj = [p[0] * u[0] + p[1] * u[1] for p in outline_px]\r"},{"line":205,"text":"    lo, hi = min(proj), max(proj)\r"},{"line":206,"text":"    a = outline_px[proj.index(lo)]\r"},{"line":207,"text":"    b = [a[0] + u[0] * (hi - lo), a[1] + u[1] * (hi - lo)]\r"},{"line":208,"text":"    r = calibrate(gun, fig_id, a, b, fact=fact)\r"},{"line":209,"text":"    r.update({\"a\": a, \"b\": b, \"length_px\": round(hi - lo, 2)})\r"},{"line":210,"text":"    return r\r"}],"name":"calibrate_extent","start_line":194,"symbol_id":"hold-code/weaponlab/blueprint/figures.py#func:calibrate_extent"}}
