{"flow":{"kind":"var","name":"_BVH","noCFG":true,"reason":"_BVH is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":240,"file":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py","kind":"var","language":"python","lines":[{"line":200,"text":"_BVH = {}\r"},{"line":201,"text":"\r"},{"line":202,"text":"\r"},{"line":203,"text":"def surface_normal(world_point, mark=None):\r"},{"line":204,"text":"    \"\"\"The gun's surface normal at a mark: the facts' own (gun space) when given, else the nearest face's, outward.\"\"\"\r"},{"line":205,"text":"    q = RA.matrix_world.to_quaternion()\r"},{"line":206,"text":"    n = FACE.get(mark) if mark else None                         # the grip style's face for its contact marks\r"},{"line":207,"text":"    n = n or ((facts.get(\"normals\") or {}).get(mark) if mark else None)\r"},{"line":208,"text":"    if n:\r"},{"line":209,"text":"        return (q @ g(n)).normalized()\r"},{"line":210,"text":"    if \"tree\" not in _BVH:\r"},{"line":211,"text":"        from mathutils.bvhtree import BVHTree\r"},{"line":212,"text":"        dg = bpy.context.evaluated_depsgraph_get()\r"},{"line":213,"text":"        ev = L.rifle_mesh.evaluated_get(dg)\r"},{"line":214,"text":"        me = ev.to_mesh()\r"},{"line":215,"text":"        M = L.rifle_mesh.matrix_world\r"},{"line":216,"text":"        _BVH[\"tree\"] = BVHTree.FromPolygons([M @ v.co for v in me.vertices], [tuple(p.vertices) for p in me.polygons])\r"},{"line":217,"text":"        ev.to_mesh_clear()\r"},{"line":218,"text":"    loc, nrm, idx, dist = _BVH[\"tree\"].find_nearest(world_point)\r"},{"line":219,"text":"    return nrm.normalized() if nrm is not None else Vector((0.0, 0.0, 1.0))\r"},{"line":220,"text":"\r"},{"line":221,"text":"\r"},{"line":222,"text":"def palm_frame(side):\r"},{"line":223,"text":"    \"\"\"The palm's middle and the way it faces (toward what the fingers close on).\"\"\"\r"},{"line":224,"text":"    hn = L._n(\"hand\", side)\r"},{"line":225,"text":"    w = L._bw(hn).translation\r"},{"line":226,"text":"    mid = L._bw(L._n(\"finger\", side, \"middle\", \"01\")).translation\r"},{"line":227,"text":"    across, k = L._hand_frame(side)\r"},{"line":228,"text":"    return w.lerp(mid, 0.5), (across.cross((mid - w).normalized()) * k).normalized()\r"},{"line":229,"text":"\r"},{"line":230,"text":"\r"},{"line":231,"text":"def fingers_way(side):\r"},{"line":232,"text":"    hn = L._n(\"hand\", side)\r"},{"line":233,"text":"    return (L._bw(L._n(\"finger\", side, \"middle\", \"01\")).translation - L._bw(hn).translation).normalized()\r"},{"line":234,"text":"\r"},{"line":235,"text":"\r"},{"line":236,"text":"def lay_palm(side, at, normal, thickness_cm=None, toward=None):\r"},{"line":237,"text":"    \"\"\"The palm turned to face into the surface (the least turn) and its middle set a palm's thickness off it.\"\"\"\r"},{"line":238,"text":"    thickness_cm = PALM_CM if thickness_cm is None else thickness_cm\r"},{"line":239,"text":"    hn = L._n(\"hand\", side)\r"},{"line":240,"text":"    H = L._bw(hn).copy()\r"}],"name":"_BVH","start_line":200,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#var:_BVH"}}
