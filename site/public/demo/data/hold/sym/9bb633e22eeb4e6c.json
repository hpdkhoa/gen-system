y(outline, dtype=float)\r"},{"line":23,"text":"    segs = [(np.linalg.norm(b - a), b - a) for a, b in zip(P, np.roll(P, -1, axis=0))]\r"},{"line":24,"text":"    d = max(segs, key=lambda s: s[0])[1]\r"},{"line":25,"text":"    d = d / np.linalg.norm(d)\r"},{"line":26,"text":"    if d[1] > 0:\r"},{"line":27,"text":"        d = -d\r"},{"line":28,"text":"    proj = (P - P.mean(axis=0)) @ d\r"},{"line":29,"text":"    return {\"axis\": [0.0, round(float(d[0]), 5), round(float(d[1]), 5)], \"length_cm\": round(float(proj.max() - proj.min()), 3)}\r"}],"name":"magazine_line","start_line":17,"symbol_id":"hold-code/weaponlab/blueprint/build.py#func:magazine_line"}}
