{"flow":{"hint":"Select one of its methods to see control flow.","kind":"type","methods":[{"id":"hold-code/poselab_mcp/worker_client.py#method:Worker.__init__","name":"__init__"},{"id":"hold-code/poselab_mcp/worker_client.py#method:Worker.call","name":"call"},{"id":"hold-code/poselab_mcp/worker_client.py#method:Worker.ensure","name":"ensure"},{"id":"hold-code/poselab_mcp/worker_client.py#method:Worker.stop","name":"stop"}],"name":"Worker","noCFG":true,"reason":"Worker is a type (struct/class/interface/enum). Control-flow graphs are built for functions and methods, not for a type itself."},"source":{"end_line":113,"file":"hold-code/poselab_mcp/worker_client.py","kind":"type","language":"python","lines":[{"line":54,"text":"class Worker:\r"},{"line":55,"text":"    def __init__(self):\r"},{"line":56,"text":"        self.proc = None\r"},{"line":57,"text":"        self.file = None\r"},{"line":58,"text":"        self.token = secrets.token_hex(16)\r"},{"line":59,"text":"\r"},{"line":60,"text":"    def ensure(self):\r"},{"line":61,"text":"        if self.file and self.proc and self.proc.poll() is None:\r"},{"line":62,"text":"            return\r"},{"line":63,"text":"        port = _free_port()\r"},{"line":64,"text":"        out = out_dir()\r"},{"line":65,"text":"        log = open(out / \"worker.log\", \"w\")\r"},{"line":66,"text":"        env = dict(os.environ, POSELAB_TOKEN=self.token)\r"},{"line":67,"text":"        rigs = os.environ.get(\"POSELAB_RIGS\", \"\")\r"},{"line":68,"text":"        flags = getattr(subprocess, \"CREATE_NO_WINDOW\", 0)\r"},{"line":69,"text":"        self.proc = subprocess.Popen([find_blender(), \"-b\", \"--factory-startup\", \"-P\", str(WORKER), \"--\", str(port), rigs, str(out)],\r"},{"line":70,"text":"                                     stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, env=env, creationflags=flags)\r"},{"line":71,"text":"        start = time.time()\r"},{"line":72,"text":"        while time.time() - start < 120:\r"},{"line":73,"text":"            if self.proc.poll() is not None:\r"},{"line":74,"text":"                raise ToolError(\"Blender stopped while starting; see %s\" % (out / \"worker.log\"))\r"},{"line":75,"text":"            try:\r"},{"line":76,"text":"                s = socket.create_connection((\"127.0.0.1\", port), timeout=5)\r"},{"line":77,"text":"                s.settimeout(900)\r"},{"line":78,"text":"                self.file = s.makefile(\"rwb\")\r"},{"line":79,"text":"                return\r"},{"line":80,"text":"            except OSError:\r"},{"line":81,"text":"                time.sleep(0.5)\r"},{"line":82,"text":"        raise ToolError(\"Blender did not answer within 120 s; see %s\" % (out / \"worker.log\"))\r"},{"line":83,"text":"\r"},{"line":84,"text":"    def call(self, cmd, **args):\r"},{"line":85,"text":"        \"\"\"Runs a Lab command; returns its result or raises with the worker's error.\"\"\"\r"},{"line":86,"text":"        self.ensure()\r"},{"line":87,"text":"        try:\r"},{"line":88,"text":"            self.file.write((json.dumps({\"token\": self.token, \"cmd\": cmd, \"args\": args}) + \"\\n\").encode())\r"},{"line":89,"text":"            self.file.flush()\r"},{"line":90,"text":"            line = self.file.readline()\r"},{"line":91,"text":"        except OSError:\r"},{"line":92,"text":"            self.file = None\r"},{"line":93,"text":"            raise\r"},{"line":94,"text":"        if not line:\r"},{"line":95,"text":"            self.file = None\r"},{"line":96,"text":"            raise ToolError(\"the Blender worker closed; see %s\" % (out_dir() / \"worker.log\"))\r"},{"line":97,"text":"        reply = json.loads(line)\r"},{"line":98,"text":"        if not reply.get(\"ok\"):\r"},{"line":99,"text":"            raise ToolError(reply.get(\"error\", \"worker error\"))\r"},{"line":100,"text":"        return reply[\"result\"]\r"},{"line":101,"text":"\r"},{"line":102,"text":"    def stop(self):\r"},{"line":103,"text":"        if self.file:\r"},{"line":104,"text":"            try:\r"},{"line":105,"text":"                self.file.write((json.dumps({\"token\": self.token, \"cmd\": \"quit\"}) + \"\\n\").encode())\r"},{"line":106,"text":"                self.file.flush()\r"},{"line":107,"text":"            except OSError:\r"},{"line":108,"text":"                pass\r"},{"line":109,"text":"        if self.proc:\r"},{"line":110,"text":"            try:\r"},{"line":111,"text":"                self.proc.wait(timeout=10)\r"},{"line":112,"text":"            except subprocess.TimeoutExpired:\r"},{"line":113,"text":"                self.proc.kill()\r"}],"name":"Worker","start_line":54,"symbol_id":"hold-code/poselab_mcp/worker_client.py#type:Worker"}}
