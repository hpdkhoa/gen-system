rface within near_cm of that point counts. None when nothing counts.\"\"\"\r"},{"line":1063,"text":"        n = max(2, int((b - a).length / 0.003))\r"},{"line":1064,"text":"        best = None\r"},{"line":1065,"text":"        for i in range(n + 1):\r"},{"line":1066,"text":"            q, d = tree.nearest(a.lerp(b, i / n))\r"},{"line":1067,"text":"            if q is None or (near is not None and (q - near).length * 100.0 > near_cm):\r"},{"line":1068,"text":"                continue\r"},{"line":1069,"text":"            g = (d - r) * 100.0\r"},{"line":1070,"text":"            best = g if best is None else min(best, g)\r"},{"line":1071,"text":"        return best\r"}],"name":"_seg_gap","start_line":1060,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:_seg_gap"}}
