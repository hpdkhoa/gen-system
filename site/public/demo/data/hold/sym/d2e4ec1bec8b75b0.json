{"flow":{"kind":"var","name":"args","noCFG":true,"reason":"args is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":55,"file":"hold-code/poselab_mcp/blender/worker.py","kind":"var","language":"python","lines":[{"line":16,"text":"args = sys.argv[sys.argv.index(\"--\") + 1:]\r"},{"line":17,"text":"port, rigs_file, out_dir = int(args[0]), args[1] or None, args[2]\r"},{"line":18,"text":"token = os.environ.get(\"POSELAB_TOKEN\", \"\")\r"},{"line":19,"text":"if not token:\r"},{"line":20,"text":"    sys.exit(\"POSELAB_TOKEN is not set\")\r"},{"line":21,"text":"L = lab.Lab(rigs_file, out_dir)\r"},{"line":22,"text":"srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\r"},{"line":23,"text":"srv.bind((\"127.0.0.1\", port))\r"},{"line":24,"text":"srv.listen(1)\r"},{"line":25,"text":"print(\"POSELAB WORKER: listening on 127.0.0.1:%d\" % port, flush=True)\r"},{"line":26,"text":"running = True\r"},{"line":27,"text":"while running:\r"},{"line":28,"text":"    conn, _ = srv.accept()\r"},{"line":29,"text":"    f = conn.makefile(\"rwb\")\r"},{"line":30,"text":"    for line in f:\r"},{"line":31,"text":"        try:\r"},{"line":32,"text":"            req = json.loads(line)\r"},{"line":33,"text":"        except ValueError:\r"},{"line":34,"text":"            continue\r"},{"line":35,"text":"        if not hmac.compare_digest(str(req.get(\"token\", \"\")), token):\r"},{"line":36,"text":"            f.write(b'{\"ok\": false, \"error\": \"bad token\"}\\n')\r"},{"line":37,"text":"            f.flush()\r"},{"line":38,"text":"            continue\r"},{"line":39,"text":"        cmd = req.get(\"cmd\", \"\")\r"},{"line":40,"text":"        if cmd == \"quit\":\r"},{"line":41,"text":"            f.write(b'{\"ok\": true, \"result\": \"bye\"}\\n')\r"},{"line":42,"text":"            f.flush()\r"},{"line":43,"text":"            running = False\r"},{"line":44,"text":"            break\r"},{"line":45,"text":"        try:\r"},{"line":46,"text":"            if cmd not in lab.PUBLIC:\r"},{"line":47,"text":"                raise ValueError(\"no command %r\" % cmd)\r"},{"line":48,"text":"            out = {\"ok\": True, \"result\": getattr(L, cmd)(**req.get(\"args\", {}))}\r"},{"line":49,"text":"        except Exception as e:\r"},{"line":50,"text":"            out = {\"ok\": False, \"error\": \"%s: %s\" % (type(e).__name__, e), \"trace\": traceback.format_exc()[-1500:]}\r"},{"line":51,"text":"        f.write((json.dumps(out) + \"\\n\").encode())\r"},{"line":52,"text":"        f.flush()\r"},{"line":53,"text":"    conn.close()\r"},{"line":54,"text":"srv.close()\r"},{"line":55,"text":""}],"name":"args","start_line":16,"symbol_id":"hold-code/poselab_mcp/blender/worker.py#var:args"}}
