, other=True, rounds=14, step_deg=8.0, joints=(\"03\", \"02\", \"01\"),\r"},{"line":1457,"text":"                  guard=True):\r"},{"line":1458,"text":"        \"\"\"The thumb's tip brought to a rest point (the firing thumb on the safety): its joints, tip to base, each\r"},{"line":1459,"text":"        turned about its head toward the point by at most step_deg a round (cyclic coordinate descent); a turn that\r"},{"line":1460,"text":"        breaks a thumb rule, or puts the thumb deeper into the gun or the other hand, is undone. Returns the tip's\r"},{"line":1461,"text":"        distance left, cm.\"\"\"\r"},{"line":1462,"text":"        TL = self._thumb_limits()\r"},{"line":1463,"text":"        rules0 = len(self._thumb_report(side, TL)[1])\r"},{"line":1464,"text":"        for _ in range(rounds):\r"},{"line":1465,"text":"            moved = False\r"},{"line":1466,"text":"            for j in joints:\r"},{"line":1467,"text":"                n = self._n(\"finger\", side, \"thumb\", j)\r"},{"line":1468,"text":"                head = self._bw(n).translation.copy()\r"},{"line":1469,"text":"                a, b = self._finger_tip(\"thumb\", side) - head, target - head\r"},{"line":1470,"text":"                if a.length < 1e-6 or b.length < 1e-6:\r"},{"line":1471,"text":"                    continue\r"},{"line":1472,"text":"                axis = a.cross(b)\r"},{"line":1473,"text":"                ang = min(step_deg, math.degrees(a.angle(b)))\r"},{"line":1474,"text":"                if axis.length < 1e-9 or ang < 0.5:\r"},{"line":1475,"text":"                    continue\r"},{"line":1476,"text":"                M = self._bw(n)\r"},{"line":1477,"text":"                g0 = self._digit_gap(side, \"thumb\", tree, glove_cm, other)\r"},{"line":1478,"text":"                self._turn_about(n, axis.normalized(), ang, head)\r"},{"line":1479,"text":"                if (len(self._thumb_report(side, TL)[1]) > rules0\r"},{"line":1480,"text":"                        or guard and self._digit_gap(side, \"thumb\", tree, glove_cm, other) < min(g0, 0.0) - 0.05):\r"},{"line":1481,"text":"                    self._set_world(n, M)\r"},{"line":1482,"text":"                    continue\r"},{"line":1483,"text":"                moved = True\r"},{"line":1484,"text":"            if not moved:\r"},{"line":1485,"text":"                break\r"},{"line":1486,"text":"        return (self._finger_tip(\"thumb\", side) - target).length * 100.0\r"}],"name":"_thumb_to","start_line":1456,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._thumb_to"}}
