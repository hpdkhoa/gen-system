{"flow":{"kind":"var","name":"NEEDS","noCFG":true,"reason":"NEEDS is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":116,"file":"hold-code/weaponlab/contracts/__init__.py","kind":"var","language":"python","lines":[{"line":76,"text":"NEEDS = {\"extrude\": (\"outline\", \"x\"), \"lathe\": (\"profile\", \"axis\"), \"views\": (\"side\", \"x\"),\r"},{"line":77,"text":"         \"slide\": (\"axis\", \"travel_cm\"), \"turn\": (\"axis\", \"turn_deg\", \"pivot\"), \"free\": ()}\r"},{"line":78,"text":"\r"},{"line":79,"text":"\r"},{"line":80,"text":"def check_blueprint(doc, sources=None, action=None):\r"},{"line":81,"text":"    \"\"\"sources: the gun's sources document (checks every figure and fact a ref names); action: its action file\r"},{"line":82,"text":"    (checks the roles). Both load from the blueprint when not given and they can be found.\"\"\"\r"},{"line":83,"text":"    bad = _schema_problems(doc, \"blueprint\")\r"},{"line":84,"text":"    if bad:\r"},{"line":85,"text":"        return bad\r"},{"line":86,"text":"    if sources is None:\r"},{"line":87,"text":"        p = Path(doc[\"sources\"])\r"},{"line":88,"text":"        if p.exists():\r"},{"line":89,"text":"            sources = json.loads(p.read_text(encoding=\"utf-8\"))\r"},{"line":90,"text":"    if action is None:\r"},{"line":91,"text":"        try:\r"},{"line":92,"text":"            from ..gunkit import actions as A\r"},{"line":93,"text":"            action = A.load(doc[\"action\"])\r"},{"line":94,"text":"        except Exception as e:                     # an unknown action is itself a problem\r"},{"line":95,"text":"            bad.append(\"action %s: %s\" % (doc[\"action\"], e))\r"},{"line":96,"text":"    figs = {f[\"id\"] for f in (sources or {}).get(\"figures\", [])}\r"},{"line":97,"text":"    facts = {f[\"id\"] for f in (sources or {}).get(\"facts\", [])}\r"},{"line":98,"text":"\r"},{"line":99,"text":"    def ref_ok(where, r):\r"},{"line":100,"text":"        if sources is None:\r"},{"line":101,"text":"            return\r"},{"line":102,"text":"        if \"figure\" in r and r[\"figure\"] not in figs:\r"},{"line":103,"text":"            bad.append(\"%s: figure %s is not in the sources\" % (where, r[\"figure\"]))\r"},{"line":104,"text":"        if \"fact\" in r and r[\"fact\"] not in facts:\r"},{"line":105,"text":"            bad.append(\"%s: fact %s is not in the sources\" % (where, r[\"fact\"]))\r"},{"line":106,"text":"\r"},{"line":107,"text":"    roles = set((action or {}).get(\"parts\", {}))\r"},{"line":108,"text":"    for pid, p in doc[\"parts\"].items():\r"},{"line":109,"text":"        sh, mo = p[\"shape\"], p.get(\"motion\")\r"},{"line":110,"text":"        extra = tuple(k for k in (\"front\", \"top\") if sh[\"kind\"] == \"views\" and k in sh)\r"},{"line":111,"text":"        for key in NEEDS[sh[\"kind\"]] + extra + (NEEDS[mo[\"kind\"]] if mo else ()) + ((\"bevel_cm\",) if p.get(\"bevel_cm\") else ()):\r"},{"line":112,"text":"            if key not in p[\"sources\"]:\r"},{"line":113,"text":"                bad.append(\"part %s: no source for its %s\" % (pid, key))\r"},{"line":114,"text":"        for key, r in p[\"sources\"].items():\r"},{"line":115,"text":"            ref_ok(\"part %s %s\" % (pid, key), r)\r"},{"line":116,"text":"        for n, h in enumerate(p.get(\"holes\", [])):\r"}],"name":"NEEDS","start_line":76,"symbol_id":"hold-code/weaponlab/contracts/__init__.py#var:NEEDS"}}
