exits":[1,21],"func_id":"hold-code/poselab_mcp/blender/holdlab.py#method:HoldMixin._body_eases","issues":null},"source":{"end_line":1054,"file":"hold-code/poselab_mcp/blender/holdlab.py","kind":"method","language":"python","lines":[{"line":1018,"text":"    def _body_eases(self, side, keep):\r"},{"line":1019,"text":"        \"\"\"The body helps when the arm is past a limit, in a set order: the elbow swung (40 to -40 in 10 degree\r"},{"line":1020,"text":"        steps), then the shoulder girdle (forward and up, a small grid), each taken only if it leaves the arm less\r"},{"line":1021,"text":"        past its limits; the hand kept where it is (keep: its matrix).\"\"\"\r"},{"line":1022,"text":"        best = self.arm_excess(side)\r"},{"line":1023,"text":"        if best <= 0.0:\r"},{"line":1024,"text":"            return 0.0\r"},{"line":1025,"text":"        self.snapshot(\"save\", \"_ease\")\r"},{"line":1026,"text":"        choice = None\r"},{"line":1027,"text":"        for sw in (-40.0, -30.0, -20.0, -10.0, 10.0, 20.0, 30.0, 40.0):\r"},{"line":1028,"text":"            self.snapshot(\"load\", \"_ease\")\r"},{"line":1029,"text":"            self._swing_elbow(side, sw)\r"},{"line":1030,"text":"            bpy.context.view_layer.update()\r"},{"line":1031,"text":"            ex = self.arm_excess(side)\r"},{"line":1032,"text":"            if ex < best - 0.5:\r"},{"line":1033,"text":"                best, choice = ex, (\"swing\", sw)\r"},{"line":1034,"text":"        if best > 0.0:\r"},{"line":1035,"text":"            for pr in (-10.0, -5.0, 5.0, 10.0):\r"},{"line":1036,"text":"                for el in (-6.0, 0.0, 6.0):\r"},{"line":1037,"text":"                    self.snapshot(\"load\", \"_ease\")\r"},{"line":1038,"text":"                    self.shoulder(side, pr, el)\r"},{"line":1039,"text":"                    self._put_hand(side, keep)\r"},{"line":1040,"text":"                    bpy.context.view_layer.update()\r"},{"line":1041,"text":"                    ex = self.arm_excess(side)\r"},{"line":1042,"text":"                    if ex < best - 0.5:\r"},{"line":1043,"text":"                        best, choice = ex, (\"shoulder\", pr, el)\r"},{"line":1044,"text":"        self.snapshot(\"load\", \"_ease\")\r"},{"line":1045,"text":"        if choice and choice[0] == \"swing\":\r"},{"line":1046,"text":"            self._swing_elbow(side, choice[1])\r"},{"line":1047,"text":"        elif choice:\r"},{"line":1048,"text":"            self.shoulder(side, choice[1], choice[2])\r"},{"line":1049,"text":"            if not hasattr(self, \"_clav_now\"):\r"},{"line":1050,"text":"                self._clav_now = {}\r"},{"line":1051,"text":"            self._clav_now[side] = (choice[1], choice[2])\r"},{"line":1052,"text":"            self._put_hand(side, keep)\r"},{"line":1053,"text":"        bpy.context.view_layer.update()\r"},{"line":1054,"text":"        return best\r"}],"name":"_body_eases","start_line":1018,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#method:HoldMixin._body_eases"}}
