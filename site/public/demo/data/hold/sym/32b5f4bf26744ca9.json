{"flow":{"kind":"var","name":"REF","noCFG":true,"reason":"REF is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":1426,"file":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py","kind":"var","language":"python","lines":[{"line":1386,"text":"REF = None\r"},{"line":1387,"text":"if job.get(\"reference_pose\"):\r"},{"line":1388,"text":"    # a reference hold (a pack clip retargeted to these arms): each hand against the gun's body bone, every finger\r"},{"line":1389,"text":"    # joint's turn; taken as the home holds instead of solving them\r"},{"line":1390,"text":"    REF = json.load(open(job[\"reference_pose\"], encoding=\"utf-8\"))\r"},{"line":1391,"text":"    for sd, mk in ((\"r\", \"grip\"), (\"l\", facts.get(\"home_l\", \"support\"))):\r"},{"line":1392,"text":"        h_ = REF[\"hands\"].get(sd)\r"},{"line":1393,"text":"        if not h_:\r"},{"line":1394,"text":"            continue\r"},{"line":1395,"text":"        rel_ = Matrix([h_[\"rel_to_root\"][i * 4:(i + 1) * 4] for i in range(4)])\r"},{"line":1396,"text":"        GRASPS[(sd, mk, None, ())] = (bone_world(mark_bone(mk)).inverted() @ (bone_world(\"Root\") @ rel_),\r"},{"line":1397,"text":"                                      {n: Quaternion(q) for n, q in h_[\"fingers\"].items()}, True)\r"},{"line":1398,"text":"    report[\"reference_pose\"] = job[\"reference_pose\"]\r"},{"line":1399,"text":"home_r = grasp(\"r\", \"grip\", start=start)\r"},{"line":1400,"text":"if home_r and STYLE and \"support\" in facts[\"marks\"]:\r"},{"line":1401,"text":"    # the firing hand closes on the gun first; the support hand then wraps over it, against the gun and the\r"},{"line":1402,"text":"    # firing hand where it now is (a real two-hand grip is built in that order)\r"},{"line":1403,"text":"    if \"r\" in CLAV_SET:\r"},{"line":1404,"text":"        L.arm.pose.bones[\"clavicle_r\"].rotation_quaternion = CLAV_SET[\"r\"]\r"},{"line":1405,"text":"        bpy.context.view_layer.update()\r"},{"line":1406,"text":"    L._put_hand(\"r\", bone_world(\"Root\") @ home_r[0])\r"},{"line":1407,"text":"    for _n, _q in home_r[1].items():\r"},{"line":1408,"text":"        L.arm.pose.bones[_n].rotation_quaternion = _q\r"},{"line":1409,"text":"    bpy.context.view_layer.update()\r"},{"line":1410,"text":"home_l = grasp(\"l\", facts.get(\"home_l\", \"support\"), start=start) if \"support\" in facts[\"marks\"] else None\r"},{"line":1411,"text":"if home_l and job.get(\"solver_two_pass\", False) and STYLE and style_plan(\"r\", \"grip\") is not None:\r"},{"line":1412,"text":"    # the firing hand solved again with the support hand on: the two hands meet (thumbs stacked, fingers wrapped)\r"},{"line":1413,"text":"    L._put_hand(\"l\", bone_world(\"Root\") @ home_l[0])\r"},{"line":1414,"text":"    for _n, _q in home_l[1].items():\r"},{"line":1415,"text":"        L.arm.pose.bones[_n].rotation_quaternion = _q\r"},{"line":1416,"text":"    bpy.context.view_layer.update()\r"},{"line":1417,"text":"    L.snapshot(\"save\", \"with_support\")\r"},{"line":1418,"text":"    GRASPS.pop((\"r\", \"grip\", None, ()), None)\r"},{"line":1419,"text":"    home_r = grasp(\"r\", \"grip\", start=\"with_support\")\r"},{"line":1420,"text":"    # and the support hand once more on the firing hand where it now is\r"},{"line":1421,"text":"    L._put_hand(\"r\", bone_world(\"Root\") @ home_r[0])\r"},{"line":1422,"text":"    for _n, _q in home_r[1].items():\r"},{"line":1423,"text":"        L.arm.pose.bones[_n].rotation_quaternion = _q\r"},{"line":1424,"text":"    bpy.context.view_layer.update()\r"},{"line":1425,"text":"    L.snapshot(\"save\", \"with_firing\")\r"},{"line":1426,"text":"    GRASPS.pop((\"l\", facts.get(\"home_l\", \"support\"), None, ()), None)\r"}],"name":"REF","start_line":1386,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#var:REF"}}
