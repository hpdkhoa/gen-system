\"excluded\":\r"},{"line":252,"text":"            continue\r"},{"line":253,"text":"        v = now[k][\"value\"]\r"},{"line":254,"text":"        ok = holds(c[\"rule\"], v)\r"},{"line":255,"text":"        prov = _metric(c[\"metric\"]).get(\"provider\")\r"},{"line":256,"text":"        if not trusted(prov):\r"},{"line":257,"text":"            untrusted.add(prov)\r"},{"line":258,"text":"        case_results.append({\"case\": c[\"id\"], \"target\": c[\"id\"] in target_ids, \"value\": v, \"rule\": c[\"rule\"], \"pass\": ok,\r"},{"line":259,"text":"                             \"was\": base.get(k, {}).get(\"value\"), \"trusted\": trusted(prov)})\r"},{"line":260,"text":"    for k, r in now.items():\r"},{"line":261,"text":"        b = base.get(k)\r"},{"line":262,"text":"        md = _metric(r[\"metric\"])\r"},{"line":263,"text":"        if b is None or not isinstance(r[\"value\"], (int, float)) or not isinstance(b[\"value\"], (int, float)):\r"},{"line":264,"text":"            continue\r"},{"line":265,"text":"        tol, better = md.get(\"tolerance\", 0.0), md.get(\"better\", \"lower\")\r"},{"line":266,"text":"        if better == \"none\":            # a count only its cases judge\r"},{"line":267,"text":"            continue\r"},{"line":268,"text":"        delta = r[\"value\"] - b[\"value\"]\r"},{"line":269,"text":"        worse = delta > tol if better == \"lower\" else -delta > tol\r"},{"line":270,"text":"        better_now = -delta > tol if better == \"lower\" else delta > tol\r"},{"line":271,"text":"        item = {\"row\": k, \"was\": b[\"value\"], \"now\": r[\"value\"], \"unit\": md.get(\"unit\")}\r"},{"line":272,"text":"        if worse:\r"},{"line":273,"text":"            regressions.append(item)\r"},{"line":274,"text":"        elif better_now:\r"},{"line":275,"text":"            improved.append(item)\r"},{"line":276,"text":"    targets_ok = all(cr[\"pass\"] and cr[\"trusted\"] for cr in case_results if cr[\"target\"]) if target_ids else None\r"},{"line":277,"text":"    missing = sorted(target_ids - {cr[\"case\"] for cr in case_results})\r"},{"line":278,"text":"    passed = bool(target_ids) and bool(targets_ok) and not regressions and not missing and not run[\"errors\"]\r"},{"line":279,"text":"    v = {\"run\": run_id, \"pass\": passed, \"targets_pass\": targets_ok, \"targets_not_measured\": missing,\r"},{"line":280,"text":"         \"regressions\": regressions, \"improved\": improved, \"cases\": case_results,\r"},{"line":281,"text":"         \"untrusted_providers\": sorted(p for p in untrusted if p), \"provider_errors\": run[\"errors\"]}\r"},{"line":282,"text":"    if proposal:\r"},{"line":283,"text":"        d = _proposals() / proposal\r"},{"line":284,"text":"        _save(d / \"verdict.json\", v)\r"},{"line":285,"text":"        (d / \"report.md\").write_text(report_md(v), encoding=\"utf-8\")\r"},{"line":286,"text":"        v[\"report\"] = str(d / \"report.md\")\r"},{"line":287,"text":"    return v\r"}],"name":"verdict","start_line":239,"symbol_id":"hold-code/weaponlab/gate.py#func:verdict"}}
