,"line":352,"text":"pts = np.array([c + a1 * (e1.min() + (x - 1) * step) + a2 * (e2.min() + (y - 1) * step) for x, y in cells])"}],"preds":[56],"stmts":["call e1.min","call e2.min"],"succs":[56]},{"id":58,"label":"loop_exit","lines":[{"kind":"call","line":353,"text":"out.append({\"cells\": pts, \"centre\": pts.mean(0), \"area_cm2\": round(len(cells) * cell_cm ** 2, 1), \"through\": thin})"}],"preds":[56],"stmts":["call out.append","call pts.mean","call round","call len"],"succs":[33]}],"effects":["unknown"],"entry":0,"exits":[3,32],"func_id":"hold-code/poselab_mcp/blender/holdlab.py#func:_part_openings","issues":null},"source":{"end_line":354,"file":"hold-code/poselab_mcp/blender/holdlab.py","kind":"func","language":"python","lines":[{"line":303,"text":"    def _part_openings(self, name, P, cell_cm=0.3, skip=()):\r"},{"line":304,"text":"        \"\"\"Holes through the object beside a part (a trigger guard, a handle's eye), found once over the whole part:\r"},{"line":305,"text":"        a grid of rays across its thinnest direction, against all the object's parts; a cell no ray hits but walled by hits on both sides in both grid directions\r"},{"line":306,"text":"        is open; touching open cells are one opening. Returns each opening's cells (object frame, m), middle, area\r"},{"line":307,"text":"        and its through direction.\"\"\"\r"},{"line":308,"text":"        # rays against the whole object (another part may close the hole: a slide over a frame's open top), in\r"},{"line":309,"text":"        # this part's frame\r"},{"line":310,"text":"        bvh = self._part_bvh_local(None, name, skip)\r"},{"line":311,"text":"        if bvh is None or len(P) < 60:\r"},{"line":312,"text":"            return []\r"},{"line":313,"text":"        c = P.mean(0)\r"},{"line":314,"text":"        _u, _s, vt = np.linalg.svd(P - c, full_matrices=False)\r"},{"line":315,"text":"        a1, a2, thin = vt[0], vt[1], vt[2]\r"},{"line":316,"text":"        e1, e2 = (P - c) @ a1, (P - c) @ a2\r"},{"line":317,"text":"        step = cell_cm / 100.0\r"},{"line":318,"text":"        n1, n2 = int(np.ptp(e1) / step) + 3, int(np.ptp(e2) / step) + 3\r"},{"line":319,"text":"        far = float(np.ptp((P - c) @ thin)) + 0.1\r"},{"line":320,"text":"        grid = np.zeros((n1, n2), dtype=bool)\r"},{"line":321,"text":"        for i in range(n1):\r"},{"line":322,"text":"            for j in range(n2):\r"},{"line":323,"text":"                q = c + a1 * (e1.min() + (i - 1) * step) + a2 * (e2.min() + (j - 1) * step)\r"},{"line":324,"text":"                # the cell's middle and its four corners: a bar thinner than a cell (a guard's bottom) still walls it\r"},{"line":325,"text":"                for du, dv in ((0, 0), (-0.45, -0.45), (0.45, -0.45), (-0.45, 0.45), (0.45, 0.45)):\r"},{"line":326,"text":"                    qq = q + a1 * (du * step) + a2 * (dv * step)\r"},{"line":327,"text":"                    if bvh.ray_cast(Vector(qq - thin * far), Vector(thin), 2 * far)[0] is not None:\r"},{"line":328,"text":"                        grid[i, j] = True\r"},{"line":329,"text":"                        break\r"},{"line":330,"text":"        walled = np.zeros_like(grid)\r"},{"line":331,"text":"        for i in range(n1):\r"},{"line":332,"text":"            for j in range(n2):\r"},{"line":333,"text":"                if not grid[i, j]:\r"},{"line":334,"text":"                    walled[i, j] = grid[:i, j].any() and grid[i + 1:, j].any() and grid[i, :j].any() and grid[i, j + 1:].any()\r"},{"line":335,"text":"        seen, out = set(), []\r"},{"line":336,"text":"        for i in range(n1):\r"},{"line":337,"text":"            for j in range(n2):\r"},{"line":338,"text":"                if not walled[i, j] or (i, j) in seen:\r"},{"line":339,"text":"                    continue\r"},{"line":340,"text":"                stack, cells = [(i, j)], []\r"},{"line":341,"text":"                seen.add((i, j))\r"},{"line":342,"text":"                while stack:\r"},{"line":343,"text":"                    x0, y0 = stack.pop()\r"},{"line":344,"text":"                    cells.append((x0, y0))\r"},{"line":345,"text":"                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\r"},{"line":346,"text":"                        x, y = x0 + dx, y0 + dy\r"},{"line":347,"text":"                        if 0 <= x < n1 and 0 <= y < n2 and walled[x, y] and (x, y) not in seen:\r"},{"line":348,"text":"                            seen.add((x, y))\r"},{"line":349,"text":"                            stack.append((x, y))\r"},{"line":350,"text":"                if len(cells) * cell_cm ** 2 < 1.0:     # under a square cm: a seam in the mesh, not a hole\r"},{"line":351,"text":"                    continue\r"},{"line":352,"text":"                pts = np.array([c + a1 * (e1.min() + (x - 1) * step) + a2 * (e2.min() + (y - 1) * step) for x, y in cells])\r"},{"line":353,"text":"                out.append({\"cells\": pts, \"centre\": pts.mean(0), \"area_cm2\": round(len(cells) * cell_cm ** 2, 1), \"through\": thin})\r"},{"line":354,"text":"        return out\r"}],"name":"_part_openings","start_line":303,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#func:_part_openings"}}
