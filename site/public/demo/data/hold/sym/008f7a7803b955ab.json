ch of a hand the player sees: the share of the hand's own vertices (it and its fingers) that are inside\r"},{"line":3849,"text":"        the view (90 degrees, 16:9) and nearest the eye along their line of sight, the arms and the rifle in the way.\r"},{"line":3850,"text":"        A hand on top of a handguard shows about half of itself, one under it or below the view's edge little or none.\r"},{"line":3851,"text":"        ToangTown's Game Probe measures the same (view.hand_l_shown).\"\"\"\r"},{"line":3852,"text":"        self._need()\r"},{"line":3853,"text":"        hand = self._n(\"hand\", side)\r"},{"line":3854,"text":"        bones = self.arm.data.bones\r"},{"line":3855,"text":"        if hand not in bones:\r"},{"line":3856,"text":"            return None\r"},{"line":3857,"text":"        inside = {b.name for b in bones if b.name == hand or any(p.name == hand for p in b.parent_recursive)}\r"},{"line":3858,"text":"        dg = bpy.context.evaluated_depsgraph_get()\r"},{"line":3859,"text":"        verts, polys, mine = [], [], []\r"},{"line":3860,"text":"        for ob in self.meshes:\r"},{"line":3861,"text":"            ev = ob.evaluated_get(dg)\r"},{"line":3862,"text":"            me = ev.to_mesh()\r"},{"line":3863,"text":"            base = len(verts)\r"},{"line":3864,"text":"            M = ob.matrix_world\r"},{"line":3865,"text":"            names = {g.index: g.name for g in ob.vertex_groups}\r"},{"line":3866,"text":"            for v, v0 in zip(me.vertices, ob.data.vertices):\r"},{"line":3867,"text":"                verts.append(M @ v.co)\r"},{"line":3868,"text":"                top = max(v0.groups, key=lambda g: g.weight, default=None)\r"},{"line":3869,"text":"                if top is not None and top.weight > 0.0 and names.get(top.group) in inside:\r"},{"line":3870,"text":"                    mine.append(base + v.index)\r"},{"line":3871,"text":"            polys += [tuple(base + i for i in p.vertices) for p in me.polygons]\r"},{"line":3872,"text":"            ev.to_mesh_clear()\r"},{"line":3873,"text":"        if not mine:\r"},{"line":3874,"text":"            return None\r"},{"line":3875,"text":"        ev = self.rifle_mesh.evaluated_get(dg)\r"},{"line":3876,"text":"        me = ev.to_mesh()\r"},{"line":3877,"text":"        base = len(verts)\r"},{"line":3878,"text":"        M = self.rifle_mesh.matrix_world\r"},{"line":3879,"text":"        verts += [M @ v.co for v in me.vertices]\r"},{"line":3880,"text":"        polys += [tuple(base + i for i in p.vertices) for p in me.polygons]\r"},{"line":3881,"text":"        ev.to_mesh_clear()\r"},{"line":3882,"text":"        bvh = BVHTree.FromPolygons(verts, polys)\r"},{"line":3883,"text":"        tan_x = math.tan(math.radians(H_FOV) / 2.0)\r"},{"line":3884,"text":"        tan_y = tan_x / ASPECT\r"},{"line":3885,"text":"        seen = 0\r"},{"line":3886,"text":"        for i in mine:\r"},{"line":3887,"text":"            p = verts[i]\r"},{"line":3888,"text":"            d = p - self.eye\r"},{"line":3889,"text":"            ahead, right, up = d.dot(VIEW_FWD), d.dot(VIEW_RIGHT), d.dot(VIEW_UP)\r"},{"line":3890,"text":"            if ahead < 0.01 or abs(right) >= ahead * tan_x or abs(up) >= ahead * tan_y:\r"},{"line":3891,"text":"                continue\r"},{"line":3892,"text":"            hit = bvh.ray_cast(self.eye, d.normalized(), d.length + 0.05)\r"},{"line":3893,"text":"            if hit[0] is not None and abs((hit[0] - self.eye).length - d.length) <= 0.02:      # the first surface is its own (2 cm)\r"},{"line":3894,"text":"                seen += 1\r"},{"line":3895,"text":"        return round(seen / float(len(mine)), 3)\r"}],"name":"hand_shown","start_line":3847,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.hand_shown"}}
