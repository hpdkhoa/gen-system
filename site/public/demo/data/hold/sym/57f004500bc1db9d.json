):\r"},{"line":147,"text":"        col = colors[k % len(colors)]\r"},{"line":148,"text":"        for poly in silhouette(bp, include=[pid]):\r"},{"line":149,"text":"            px = np.array(Fg.to_px(fig, poly), dtype=np.int32)\r"},{"line":150,"text":"            cv2.polylines(img, [px], True, col, 2)\r"},{"line":151,"text":"            c = px.mean(axis=0).astype(int)\r"},{"line":152,"text":"            cv2.putText(img, pid, (int(c[0]) - 20, int(c[1])), cv2.FONT_HERSHEY_SIMPLEX, 0.5, col, 1)\r"},{"line":153,"text":"        for h in p.get(\"holes\", []):\r"},{"line":154,"text":"            if h[\"kind\"] == \"polygon\":\r"},{"line":155,"text":"                cv2.polylines(img, [np.array(Fg.to_px(fig, h[\"outline\"]), dtype=np.int32)], True, col, 1)\r"},{"line":156,"text":"    for m, x in bp[\"marks\"].items():\r"},{"line":157,"text":"        px = Fg.to_px(fig, [[x[\"at\"][1], x[\"at\"][2]]])[0]\r"},{"line":158,"text":"        cv2.drawMarker(img, (int(px[0]), int(px[1])), (0, 0, 0), cv2.MARKER_CROSS, 10, 1)\r"},{"line":159,"text":"    label = \"SOURCE FIGURE %s WITH THE BLUEPRINT DRAWN ON IT (not a model view)\" % fig[\"id\"]\r"},{"line":160,"text":"    cv2.rectangle(img, (0, 0), (12 + 9 * len(label), 26), (255, 255, 255), -1)\r"},{"line":161,"text":"    cv2.putText(img, label, (6, 18), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 0, 0), 1)\r"},{"line":162,"text":"    out = store.folder(gun, \"check\") / (\"overlay_%s.png\" % fig[\"id\"])\r"},{"line":163,"text":"    cv2.imwrite(str(out), img)\r"},{"line":164,"text":"    return str(out)\r"}],"name":"overlay","start_line":141,"symbol_id":"hold-code/weaponlab/blueprint/check.py#func:overlay"}}
