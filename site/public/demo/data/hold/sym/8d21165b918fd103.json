 with how far past it is: the arm's rules, the fingers' and\r"},{"line":842,"text":"        the thumb's ranges, a holding digit's limits (degrees past), and clipping (skin in the object past its give,\r"},{"line":843,"text":"        the object in the flesh past it, a hand in the other: cm2 and cm). Empty when the hand is inside every wall.\"\"\"\r"},{"line":844,"text":"        import re\r"},{"line":845,"text":"        out = {}\r"},{"line":846,"text":"\r"},{"line":847,"text":"        def add(kind, msg):\r"},{"line":848,"text":"            m = re.search(r\"(-?\\d+(?:\\.\\d+)?)\\D*\\(at most (-?\\d+(?:\\.\\d+)?)\\)\", msg)\r"},{"line":849,"text":"            if m:\r"},{"line":850,"text":"                key, over = kind + \":\" + msg[:m.start(1)].strip(), abs(float(m.group(1)) - float(m.group(2)))\r"},{"line":851,"text":"            else:\r"},{"line":852,"text":"                key, over = kind + \":\" + re.sub(r\"\\(.*?\\)\", \"\", msg).strip(), 1.0\r"},{"line":853,"text":"            out[key] = max(out.get(key, 0.0), over)\r"},{"line":854,"text":"        FL = self._limits()[1]\r"},{"line":855,"text":"        TL = self._thumb_limits()\r"},{"line":856,"text":"        for msg in self._arm_report(side, self._limits()[0])[1]:\r"},{"line":857,"text":"            add(\"arm\", msg)\r"},{"line":858,"text":"        for msg in self._finger_report(side, FL)[1]:\r"},{"line":859,"text":"            add(\"finger\", msg)\r"},{"line":860,"text":"        for msg in self._thumb_report(side, TL)[1]:\r"},{"line":861,"text":"            add(\"thumb\", msg)\r"},{"line":862,"text":"        for msg in self.hold_digit_rule(side)[\"faults\"]:\r"},{"line":863,"text":"            add(\"holding\", msg)\r"},{"line":864,"text":"        if getattr(self, \"_object\", None):\r"},{"line":865,"text":"            cp = self.contact_pairs(side, other=other)\r"},{"line":866,"text":"            area = cp[\"press_cm2\"] + cp[\"pierced_cm2\"] + cp[\"hand_press_cm2\"]\r"},{"line":867,"text":"            deep = max(cp[\"deepest_cm\"], cp[\"pierced_deep_cm\"], cp[\"hand_deepest_cm\"])\r"},{"line":868,"text":"            if area > CLIP_NOISE_CM2 or deep > 0.0:\r"},{"line":869,"text":"                out[\"clip:area_cm2\"], out[\"clip:deepest_cm\"] = area, deep\r"},{"line":870,"text":"        else:\r"},{"line":871,"text":"            sp = self.skin_presses(side, other=other)\r"},{"line":872,"text":"            if not sp[\"ok\"]:\r"},{"line":873,"text":"                s_ = sp.get(side, {})\r"},{"line":874,"text":"                out[\"clip:deepest_cm\"] = max(s_.get(\"gun_cm\", 0.0), s_.get(\"hand_cm\", 0.0), 0.01)\r"},{"line":875,"text":"        return out\r"}],"name":"wall_faults","start_line":840,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#method:HoldMixin.wall_faults"}}
