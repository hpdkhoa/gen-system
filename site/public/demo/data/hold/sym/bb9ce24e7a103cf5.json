": x_source}\r"},{"line":197,"text":"    sources.update(motion_sources or {})\r"},{"line":198,"text":"    if bevel_cm:\r"},{"line":199,"text":"        sources.setdefault(\"bevel_cm\", {\"guess\": \"a small round on the edges, as machined parts have\"})\r"},{"line":200,"text":"    return part(gun, part_id, role, finish, {\"kind\": \"extrude\", \"outline\": out, \"x\": [float(x[0]), float(x[1])]}, sources,\r"},{"line":201,"text":"                name=name, motion=motion, bevel_cm=bevel_cm, parent=parent)\r"}],"name":"extrude","start_line":169,"symbol_id":"hold-code/weaponlab/blueprint/plan.py#func:extrude"}}
