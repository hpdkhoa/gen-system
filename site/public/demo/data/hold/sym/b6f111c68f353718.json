{"flow":{"kind":"var","name":"COLORS","noCFG":true,"reason":"COLORS is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":58,"file":"hold-code/weaponlab/blender/render_parts.py","kind":"var","language":"python","lines":[{"line":18,"text":"COLORS = {\"arms\": (0.75, 0.72, 0.68, 1), \"gun\": (0.12, 0.12, 0.14, 1), \"part\": (0.15, 0.3, 0.75, 1), \"item\": (0.95, 0.5, 0.1, 1)}\r"},{"line":19,"text":"\r"},{"line":20,"text":"\r"},{"line":21,"text":"def read_obj(path):\r"},{"line":22,"text":"    \"\"\"The groups of a parts dump: {group: [triangles of three (x, y, z) in cm]}, and the eye.\"\"\"\r"},{"line":23,"text":"    groups, verts, cur, eye = {}, [], None, None\r"},{"line":24,"text":"    with open(path, encoding=\"utf-8\", errors=\"replace\") as f:\r"},{"line":25,"text":"        for line in f:\r"},{"line":26,"text":"            if line.startswith(\"v \"):\r"},{"line":27,"text":"                verts.append(tuple(float(x) for x in line.split()[1:4]))\r"},{"line":28,"text":"            elif line.startswith(\"g \"):\r"},{"line":29,"text":"                cur = line[2:].strip()\r"},{"line":30,"text":"                groups.setdefault(cur, [])\r"},{"line":31,"text":"            elif line.startswith(\"f \"):\r"},{"line":32,"text":"                i = [int(x) - 1 for x in line.split()[1:4]]\r"},{"line":33,"text":"                groups[cur].append((verts[i[0]], verts[i[1]], verts[i[2]]))\r"},{"line":34,"text":"            elif line.startswith(\"# eye\"):\r"},{"line":35,"text":"                eye = tuple(float(x) for x in line.split()[2:5])\r"},{"line":36,"text":"    return groups, eye\r"},{"line":37,"text":"\r"},{"line":38,"text":"\r"},{"line":39,"text":"def pieces(tris, weld=0.02):\r"},{"line":40,"text":"    \"\"\"Connected pieces of a triangle soup (vertices within weld cm count as one).\"\"\"\r"},{"line":41,"text":"    key = lambda p: (round(p[0] / weld), round(p[1] / weld), round(p[2] / weld))\r"},{"line":42,"text":"    parent = {}\r"},{"line":43,"text":"\r"},{"line":44,"text":"    def find(a):\r"},{"line":45,"text":"        while parent[a] != a:\r"},{"line":46,"text":"            parent[a] = parent[parent[a]]\r"},{"line":47,"text":"            a = parent[a]\r"},{"line":48,"text":"        return a\r"},{"line":49,"text":"\r"},{"line":50,"text":"    for t in tris:\r"},{"line":51,"text":"        ks = [key(p) for p in t]\r"},{"line":52,"text":"        for k in ks:\r"},{"line":53,"text":"            parent.setdefault(k, k)\r"},{"line":54,"text":"        for k in ks[1:]:\r"},{"line":55,"text":"            ra, rb = find(ks[0]), find(k)\r"},{"line":56,"text":"            if ra != rb:\r"},{"line":57,"text":"                parent[rb] = ra\r"},{"line":58,"text":"    out = {}\r"}],"name":"COLORS","start_line":18,"symbol_id":"hold-code/weaponlab/blender/render_parts.py#var:COLORS"}}
