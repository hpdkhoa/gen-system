{"flow":{"kind":"var","name":"report","noCFG":true,"reason":"report is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":272,"file":"hold-code/weaponlab/blueprint/blender/blueprint_build.py","kind":"var","language":"python","lines":[{"line":232,"text":"report = {\"parts\": {}, \"textures\": []}\r"},{"line":233,"text":"for pid, p in bp[\"parts\"].items():\r"},{"line":234,"text":"    sh = p[\"shape\"]\r"},{"line":235,"text":"    if sh[\"kind\"] in (\"extrude\", \"views\"):\r"},{"line":236,"text":"        x0, x1 = sh[\"x\"]\r"},{"line":237,"text":"        ob = prism(pid, sh[\"outline\"] if sh[\"kind\"] == \"extrude\" else sh[\"side\"], x0, x1)\r"},{"line":238,"text":"        if sh[\"kind\"] == \"views\":\r"},{"line":239,"text":"            zs = [q[1] for q in sh[\"side\"]]\r"},{"line":240,"text":"            if sh.get(\"front\"):\r"},{"line":241,"text":"                intersect(ob, join([prism_along(\"%s_front%d\" % (pid, k), f[\"outline\"], \"y\", f[\"y\"][0], f[\"y\"][1]) for k, f in enumerate(sh[\"front\"])], pid + \"_front\"))\r"},{"line":242,"text":"            if sh.get(\"top\"):\r"},{"line":243,"text":"                intersect(ob, prism_along(pid + \"_top\", sh[\"top\"], \"z\", min(zs) - 1.0, max(zs) + 1.0))\r"},{"line":244,"text":"        print(\"BLUEPRINT STEP %s: %d vertices, %d faces\" % (pid, len(ob.data.vertices), len(ob.data.polygons)))\r"},{"line":245,"text":"        for k, h in enumerate(p.get(\"holes\", [])):\r"},{"line":246,"text":"            hx = h.get(\"x\") or [x0 - 1.0, x1 + 1.0]\r"},{"line":247,"text":"            if h[\"kind\"] == \"bore\":\r"},{"line":248,"text":"                cut = lathe(\"%s_hole%d\" % (pid, k), [[h[\"y\"][0], h[\"r\"]], [h[\"y\"][1], h[\"r\"]]], h[\"at\"][0], h[\"at\"][1])\r"},{"line":249,"text":"            elif h[\"kind\"] == \"polygon\":\r"},{"line":250,"text":"                cut = prism(\"%s_hole%d\" % (pid, k), h[\"outline\"], hx[0], hx[1])\r"},{"line":251,"text":"            else:\r"},{"line":252,"text":"                (y, z), r = h[\"at\"], h[\"r\"]\r"},{"line":253,"text":"                cut = prism(\"%s_hole%d\" % (pid, k), [[y + r * math.cos(2 * math.pi * t / SEG), z + r * math.sin(2 * math.pi * t / SEG)] for t in range(SEG)], hx[0], hx[1])\r"},{"line":254,"text":"            boolean(ob, cut)\r"},{"line":255,"text":"    else:\r"},{"line":256,"text":"        ob = lathe(pid, sh[\"profile\"], sh[\"axis\"][0], sh[\"axis\"][1], sh.get(\"bore_r\"))\r"},{"line":257,"text":"    for k, ft in enumerate(p.get(\"features\", [])):\r"},{"line":258,"text":"        feature(ob, pid, k, ft, report[\"textures\"])\r"},{"line":259,"text":"    if p.get(\"bevel_cm\"):\r"},{"line":260,"text":"        mod = ob.modifiers.new(\"bevel\", 'BEVEL')\r"},{"line":261,"text":"        mod.width = p[\"bevel_cm\"] / 100.0\r"},{"line":262,"text":"        mod.segments = 2\r"},{"line":263,"text":"        mod.limit_method = 'ANGLE'\r"},{"line":264,"text":"        bpy.context.view_layer.objects.active = ob\r"},{"line":265,"text":"        bpy.ops.object.modifier_apply(modifier=mod.name)\r"},{"line":266,"text":"    ob.data.materials.clear()                     # the cuts bring their cutters' empty slots: one finish a part\r"},{"line":267,"text":"    ob.data.materials.append(material(p[\"finish\"]))\r"},{"line":268,"text":"    for poly in ob.data.polygons:\r"},{"line":269,"text":"        poly.material_index = 0\r"},{"line":270,"text":"    ob[\"role\"] = p[\"role\"]\r"},{"line":271,"text":"    ob[\"finish\"] = p[\"finish\"]\r"},{"line":272,"text":"    ob.data.validate()\r"}],"name":"report","start_line":232,"symbol_id":"hold-code/weaponlab/blueprint/blender/blueprint_build.py#var:report"}}
