,{"line":4093,"text":"        sides: both, l or r (the side the clip is about: a magazine hold is the left hand's). rules: every distinct rule\r"},{"line":4094,"text":"        broken, with how many frames break it. Also each frame's numbers, for a table.\"\"\"\r"},{"line":4095,"text":"        if sides not in (\"both\", \"l\", \"r\"):\r"},{"line":4096,"text":"            raise ValueError(\"sides must be both, l or r\")\r"},{"line":4097,"text":"        part = {\"both\": \"both\", \"l\": \"left\", \"r\": \"right\"}[sides]\r"},{"line":4098,"text":"        which = (\"l\", \"r\") if sides == \"both\" else (sides,)\r"},{"line":4099,"text":"        import re as _re\r"},{"line":4100,"text":"        seen = {}\r"},{"line":4101,"text":"        self._need()\r"},{"line":4102,"text":"        frames, fps = self._frames(clip)\r"},{"line":4103,"text":"        worst, worst_t, breaks, not_holding, grip_bad = 0.0, 0.0, 0, {s_: 0 for s_ in hold_sides}, 0\r"},{"line":4104,"text":"        per = []\r"},{"line":4105,"text":"        for i, fr in enumerate(frames):\r"},{"line":4106,"text":"            self._apply(fr)\r"},{"line":4107,"text":"            c = self.clearance(parts=part, ignore=ignore)[\"worst_cm\"]\r"},{"line":4108,"text":"            a = self.anatomy(side=sides)\r"},{"line":4109,"text":"            b = sum(len(a.get(s_, {}).get(\"bad\", [])) for s_ in which)\r"},{"line":4110,"text":"            for s_ in which:\r"},{"line":4111,"text":"                for txt in a.get(s_, {}).get(\"bad\", []):\r"},{"line":4112,"text":"                    k = \"%s: %s\" % (s_, _re.sub(r\"[-0-9.]+\", \"#\", txt))\r"},{"line":4113,"text":"                    seen[k] = seen.get(k, 0) + 1\r"},{"line":4114,"text":"            if c > worst:\r"},{"line":4115,"text":"                worst, worst_t = c, i / fps\r"},{"line":4116,"text":"            breaks += 1 if b else 0\r"},{"line":4117,"text":"            row = {\"t\": round(i / fps, 3), \"clearance_cm\": c, \"rules_broken\": b}\r"},{"line":4118,"text":"            g = self.grip(\"both\", hold=False)\r"},{"line":4119,"text":"            gb = sum(len(g[s_][\"bad\"]) for s_ in which)\r"},{"line":4120,"text":"            for s_ in which:\r"},{"line":4121,"text":"                for txt in g[s_][\"bad\"]:\r"},{"line":4122,"text":"                    k = \"%s grip: %s\" % (s_, _re.sub(r\"[-0-9.]+\", \"#\", txt))\r"},{"line":4123,"text":"                    seen[k] = seen.get(k, 0) + 1\r"},{"line":4124,"text":"            grip_bad += 1 if gb else 0\r"},{"line":4125,"text":"            row[\"grip_rules_broken\"] = gb\r"},{"line":4126,"text":"            for s_ in hold_sides:\r"},{"line":4127,"text":"                # holding: the palm on the gun facing it, and either the thumb opposing the fingers on it (a pinch)\r"},{"line":4128,"text":"                # or two or more fingers wrapped onto it against the palm (a power grip, as a pistol is held); a\r"},{"line":4129,"text":"                # palm laid flat on the gun with the fingers straight touches it but holds nothing\r"},{"line":4130,"text":"                wrapped = [d for d in g[s_].get(\"digits_touching\", []) if d != \"thumb\"]\r"},{"line":4131,"text":"                held = g[s_][\"holding\"] and (g[s_][\"grasping\"] or len(wrapped) >= 2)\r"},{"line":4132,"text":"                if not held:\r"},{"line":4133,"text":"                    not_holding[s_] += 1\r"},{"line":4134,"text":"                row[\"holding_\" + s_] = held\r"},{"line":4135,"text":"            per.append(row)\r"},{"line":4136,"text":"        return {\"clip\": clip, \"frames\": len(frames), \"clearance_worst_cm\": round(worst, 2), \"clearance_worst_s\": round(worst_t, 3),\r"},{"line":4137,"text":"                \"clearance_over_frames\": sum(1 for r in per if r[\"clearance_cm\"] > clearance_max_cm),\r"},{"line":4138,"text":"                \"anatomy_break_frames\": breaks, \"grip_break_frames\": grip_bad, \"not_holding_frames\": not_holding,\r"},{"line":4139,"text":"                \"rules\": dict(sorted(seen.items(), key=lambda kv: -kv[1])), \"per_frame\": per}\r"}],"name":"check_set","start_line":4088,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.check_set"}}
