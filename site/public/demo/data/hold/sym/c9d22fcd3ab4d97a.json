on.objects.link(ob)\r"},{"line":1146,"text":"        return ob\r"}],"name":"_fine_copy","start_line":1126,"symbol_id":"hold-code/poselab_mcp/blender/contactlab.py#method:ContactMixin._fine_copy"}}
