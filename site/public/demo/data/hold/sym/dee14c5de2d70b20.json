lation)\r"},{"line":3554,"text":"        self._set_world(hn, Matrix.LocRotScale(self._bw(hn).translation, M.to_quaternion(), self._unit()))\r"},{"line":3555,"text":"        self._roll_forearm(side)\r"},{"line":3556,"text":"        return short\r"}],"name":"_put_hand","start_line":3547,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:_put_hand"}}
