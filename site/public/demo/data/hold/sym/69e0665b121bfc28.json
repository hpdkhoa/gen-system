{"flow":{"kind":"var","name":"VIEWS","noCFG":true,"reason":"VIEWS is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":112,"file":"hold-code/weaponlab/blueprint/blender/blueprint_showcase.py","kind":"var","language":"python","lines":[{"line":72,"text":"VIEWS = {\"right\": (205, 14), \"left\": (-25, 14), \"top_right\": (215, 38), \"right_close\": (195, 8)}\r"},{"line":73,"text":"n = 0\r"},{"line":74,"text":"report = {\"shots\": []}\r"},{"line":75,"text":"\r"},{"line":76,"text":"\r"},{"line":77,"text":"def shot(name):\r"},{"line":78,"text":"    global n\r"},{"line":79,"text":"    sc.render.filepath = os.path.join(OUT, \"f%05d.png\" % n)\r"},{"line":80,"text":"    bpy.ops.render.render(write_still=True)\r"},{"line":81,"text":"    report[\"shots\"].append({\"frame\": n, \"shot\": name})\r"},{"line":82,"text":"    n += 1\r"},{"line":83,"text":"\r"},{"line":84,"text":"\r"},{"line":85,"text":"# 1. once round\r"},{"line":86,"text":"arm.animation_data.action = None\r"},{"line":87,"text":"for k in range(job.get(\"turn_frames\", 60)):\r"},{"line":88,"text":"    aim(-25 + 360.0 * k / job.get(\"turn_frames\", 60), 14)\r"},{"line":89,"text":"    shot(\"turn\")\r"},{"line":90,"text":"# 2. the clips\r"},{"line":91,"text":"for c in job.get(\"clips\", []):\r"},{"line":92,"text":"    act = bpy.data.actions.get(c[\"action\"])\r"},{"line":93,"text":"    if act is None:\r"},{"line":94,"text":"        print(\"SHOWCASE: no action %s\" % c[\"action\"])\r"},{"line":95,"text":"        continue\r"},{"line":96,"text":"    arm.animation_data.action = act\r"},{"line":97,"text":"    if hasattr(arm.animation_data, \"action_slot\") and act.slots:\r"},{"line":98,"text":"        arm.animation_data.action_slot = act.slots[0]\r"},{"line":99,"text":"    f0, f1 = act.frame_range\r"},{"line":100,"text":"    src_fps = c.get(\"fps\", 60)\r"},{"line":101,"text":"    secs = (f1 - f0) / src_fps\r"},{"line":102,"text":"    frames = max(2, int(round(secs * c.get(\"slow\", 1) * FPS)))\r"},{"line":103,"text":"    az, el = VIEWS.get(c.get(\"view\", \"right\"), VIEWS[\"right\"])\r"},{"line":104,"text":"    aim(az, el, DIST * c.get(\"zoom\", 1.0))\r"},{"line":105,"text":"    for rep in range(c.get(\"repeat\", 1)):\r"},{"line":106,"text":"        for k in range(frames + 1):\r"},{"line":107,"text":"            t = f0 + (f1 - f0) * k / frames\r"},{"line":108,"text":"            sc.frame_set(int(t), subframe=t - int(t))\r"},{"line":109,"text":"            shot(c.get(\"label\", c[\"action\"]))\r"},{"line":110,"text":"        for _ in range(int(FPS * c.get(\"hold\", 0.4))):          # a short hold at the end of each play\r"},{"line":111,"text":"            shot(c.get(\"label\", c[\"action\"]))\r"},{"line":112,"text":"with open(os.path.join(OUT, \"shots.json\"), \"w\", encoding=\"utf-8\") as f:\r"}],"name":"VIEWS","start_line":72,"symbol_id":"hold-code/weaponlab/blueprint/blender/blueprint_showcase.py#var:VIEWS"}}
