{"flow":{"kind":"var","name":"PALM_CM","noCFG":true,"reason":"PALM_CM is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":103,"file":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py","kind":"var","language":"python","lines":[{"line":63,"text":"PALM_CM = ((_FIT or {}).get(\"palm\", 0.015) * 100.0) + GLOVE\r"},{"line":64,"text":"FACE = {h[\"contact\"][\"mark\"]: h[\"contact\"][\"face\"] for h in (STYLE or {}).get(\"hands\", {}).values()}\r"},{"line":65,"text":"TOWARD = {h[\"contact\"][\"mark\"]: h[\"contact\"].get(\"fingers_toward\") for h in (STYLE or {}).get(\"hands\", {}).values()}\r"},{"line":66,"text":"for _h in (STYLE or {}).get(\"hands\", {}).values():\r"},{"line":67,"text":"    for _m, _x in (_h.get(\"holds\") or {}).items():\r"},{"line":68,"text":"        FACE.setdefault(_m, _x[\"face\"])               # a working hold's face (the slide's top for a rack)\r"},{"line":69,"text":"        TOWARD.setdefault(_m, _x.get(\"fingers_toward\"))\r"},{"line":70,"text":"report[\"style\"] = STYLE[\"id\"] if STYLE else None\r"},{"line":71,"text":"report[\"character\"] = CHAR[\"id\"] if CHAR else None\r"},{"line":72,"text":"report[\"glove_cm\"] = GLOVE\r"},{"line":73,"text":"bone_of = {r: p[\"bone\"] for r, p in facts[\"parts\"].items()}\r"},{"line":74,"text":"role_of = {p[\"bone\"]: r for r, p in facts[\"parts\"].items()}\r"},{"line":75,"text":"\r"},{"line":76,"text":"\r"},{"line":77,"text":"def g(v):\r"},{"line":78,"text":"    return Vector((v[0], -v[1], v[2])) / 100.0\r"},{"line":79,"text":"\r"},{"line":80,"text":"\r"},{"line":81,"text":"def gun_cm(v):\r"},{"line":82,"text":"    return [v.x * 100.0, -v.y * 100.0, v.z * 100.0]\r"},{"line":83,"text":"\r"},{"line":84,"text":"\r"},{"line":85,"text":"# --- the gun's parts: a track frame's transforms onto the rifle's bones (gunkit_clips' sums) ----------------------\r"},{"line":86,"text":"def pose_parts(bones):\r"},{"line":87,"text":"    for name, x in bones.items():\r"},{"line":88,"text":"        pb = RA.pose.bones.get(name)\r"},{"line":89,"text":"        if pb is None:\r"},{"line":90,"text":"            continue\r"},{"line":91,"text":"        pb.rotation_mode = 'QUATERNION'\r"},{"line":92,"text":"        lx, ly, lz = x[\"loc\"]\r"},{"line":93,"text":"        pb.location = Vector((lx, -ly, lz)) / 100.0\r"},{"line":94,"text":"        deg, ax, ay, az = x[\"rot\"]\r"},{"line":95,"text":"        axis = Vector((ax, -ay, az))\r"},{"line":96,"text":"        pb.rotation_quaternion = Quaternion(axis.normalized() if axis.length > 0 else Vector((0, 1, 0)), -math.radians(deg))\r"},{"line":97,"text":"    bpy.context.view_layer.update()\r"},{"line":98,"text":"\r"},{"line":99,"text":"\r"},{"line":100,"text":"def rest_parts():\r"},{"line":101,"text":"    for pb in RA.pose.bones:\r"},{"line":102,"text":"        pb.matrix_basis = Matrix.Identity(4)\r"},{"line":103,"text":"    bpy.context.view_layer.update()\r"}],"name":"PALM_CM","start_line":63,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#var:PALM_CM"}}
