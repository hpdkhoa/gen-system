{"flow":{"kind":"var","name":"out","noCFG":true,"reason":"out is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":122,"file":"hold-code/weaponlab/gunkit/blender/gunkit_pack_hold.py","kind":"var","language":"python","lines":[{"line":82,"text":"out = {\"contract\": REF.CONTRACT, \"style\": job.get(\"style\"), \"source\": dict(job.get(\"source\") or {}, clip=act.name, frame=frame),\r"},{"line":83,"text":"       \"frame\": \"grip: origin the magazine's lips, d up the magazine, f forward, l the gun's left; cm\", \"hands\": {}}\r"},{"line":84,"text":"for sd, B in job[\"bones\"].items():\r"},{"line":85,"text":"    f = {fi: [Vector(head(n)) for n in B[fi]] for fi in (\"thumb\", \"index\", \"middle\", \"ring\", \"pinky\")}\r"},{"line":86,"text":"    wrist = Vector(head(B[\"hand\"]))\r"},{"line":87,"text":"    across = (f[\"index\"][0] - f[\"pinky\"][0]).normalized()\r"},{"line":88,"text":"    sign = -1.0 if sd == \"l\" else 1.0\r"},{"line":89,"text":"    w2k = f[\"middle\"][0] - wrist\r"},{"line":90,"text":"    curls = {}\r"},{"line":91,"text":"    for fi in (\"index\", \"middle\", \"ring\", \"pinky\"):\r"},{"line":92,"text":"        pts = [f[fi][0] - w2k, f[fi][0], f[fi][1], f[fi][2], f[fi][3]]\r"},{"line":93,"text":"        c3 = []\r"},{"line":94,"text":"        for i in range(3):\r"},{"line":95,"text":"            a, c = (pts[i + 1] - pts[i]).normalized(), (pts[i + 2] - pts[i + 1]).normalized()\r"},{"line":96,"text":"            c3.append(round(math.degrees(math.atan2(a.cross(c).dot(across) * sign, a.dot(c))), 1))\r"},{"line":97,"text":"        curls[fi] = c3\r"},{"line":98,"text":"    t = f[\"thumb\"]\r"},{"line":99,"text":"    elbow = Vector(head(B[\"forearm\"])) if B.get(\"forearm\") else None\r"},{"line":100,"text":"    extra = {}\r"},{"line":101,"text":"    if elbow is not None:\r"},{"line":102,"text":"        # the forearm's line and the wrist's bend off it (the forearm to the wrist against the wrist to the middle\r"},{"line":103,"text":"        # knuckle), as the animator posed them\r"},{"line":104,"text":"        extra = {\"elbow\": grip(elbow), \"wrist_bend_deg\": round(math.degrees((wrist - elbow).angle(f[\"middle\"][0] - wrist)), 1)}\r"},{"line":105,"text":"    out[\"hands\"][sd] = {\r"},{"line":106,"text":"        \"points\": {\"wrist\": grip(wrist), \"index_knuckle\": grip(f[\"index\"][0]), \"knuckle\": grip(f[\"middle\"][0]),\r"},{"line":107,"text":"                   \"pinky_knuckle\": grip(f[\"pinky\"][0]), \"thumb_cmc\": grip(t[0]), \"thumb_tip\": grip(t[3]),\r"},{"line":108,"text":"                   \"index_tip\": grip(f[\"index\"][3]), \"middle_tip\": grip(f[\"middle\"][3])},\r"},{"line":109,"text":"        \"curls\": curls,\r"},{"line":110,"text":"        \"thumb\": [round(seg_deg(t[1] - t[0], t[2] - t[1]), 1), round(seg_deg(t[2] - t[1], t[3] - t[2]), 1)],\r"},{"line":111,"text":"        \"keep\": list((job.get(\"keep\") or {}).get(sd, [])),\r"},{"line":112,"text":"        \"hand_cm\": round((f[\"middle\"][3] - wrist).length * 100.0, 2)}\r"},{"line":113,"text":"    out[\"hands\"][sd][\"points\"].update({k: v for k, v in extra.items() if k == \"elbow\"})\r"},{"line":114,"text":"    if \"wrist_bend_deg\" in extra:\r"},{"line":115,"text":"        out[\"hands\"][sd][\"wrist_bend_deg\"] = extra[\"wrist_bend_deg\"]\r"},{"line":116,"text":"cam = next((o for o in bpy.data.objects if o.type == \"CAMERA\"), None)\r"},{"line":117,"text":"if cam is not None:\r"},{"line":118,"text":"    out[\"eye\"] = grip(cam.matrix_world.translation)\r"},{"line":119,"text":"out[\"gun\"] = {\"magazine\": mags[0], \"lips_world_cm\": [round(x * 100, 2) for x in lips]}\r"},{"line":120,"text":"bad = REF.check(out)\r"},{"line":121,"text":"os.makedirs(os.path.dirname(job[\"out\"]), exist_ok=True)\r"},{"line":122,"text":"json.dump(out, open(job[\"out\"], \"w\", encoding=\"utf-8\"), indent=1)\r"}],"name":"out","start_line":82,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_pack_hold.py#var:out"}}
