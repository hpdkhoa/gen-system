", 0.0)"},{"kind":"call","line":1702,"text":"err += 2.0 * max(0.0, need_share - share)"},{"kind":"call","line":1703,"text":"return {\"id\": rule.get(\"id\"), \"patch\": rule[\"patch\"], \"met\": err <= 1e-6, \"error\": round(err, 3),"},{"kind":"call","line":1704,"text":"\"gap_cm\": round(gap, 2), \"facing_deg\": round(ang), \"share\": round(share, 2), \"min_share\": need_share,"},{"kind":"return","line":1703,"text":"return {\"id\": rule.get(\"id\"), \"patch\": rule[\"patch\"], \"met\": err <= 1e-6, \"error\": round(err, 3),"}],"preds":[29],"stmts":["call len","call rule.get","call max","call rule.get","call round","call round","call round","call round","return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[1,25,44,45],"func_id":"hold-code/poselab_mcp/blender/lab.py#func:_rule_eval","issues":null},"source":{"end_line":1705,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"func","language":"python","lines":[{"line":1659,"text":"    def _rule_eval(self, side, rule, glove_cm=0.0, verts=None):\r"},{"line":1660,"text":"        if rule.get(\"on_hand\"):\r"},{"line":1661,"text":"            return self._rule_eval_hand(side, rule, glove_cm)\r"},{"line":1662,"text":"        \"\"\"One contact rule measured: the patch's surface point that best meets the region (gap and facing), its\r"},{"line":1663,"text":"        gap (cm, below 0 inside), the facing angle (the patch's normal against the surface's, degrees), the touch\r"},{"line":1664,"text":"        point and the surface normal (world), whether the rule is met, and an error (0 when met).\"\"\"\r"},{"line":1665,"text":"        pts = self._patch_points(side, rule[\"patch\"], glove_cm)\r"},{"line":1666,"text":"        vs, ps = verts or self._gun_verts()\r"},{"line":1667,"text":"        rk = (id(vs), rule.get(\"id\"), len(rule.get(\"polys\") or ()))\r"},{"line":1668,"text":"        rbc = getattr(self, \"_rb_cache\", None)\r"},{"line":1669,"text":"        if rbc is not None and rk in rbc:\r"},{"line":1670,"text":"            bvh = rbc[rk]\r"},{"line":1671,"text":"        else:\r"},{"line":1672,"text":"            sub = [ps[i] for i in rule[\"polys\"] if i < len(ps)] if rule.get(\"polys\") is not None else ps\r"},{"line":1673,"text":"            bvh = BVHTree.FromPolygons(vs, sub) if sub else None\r"},{"line":1674,"text":"            if rbc is not None:\r"},{"line":1675,"text":"                rbc[rk] = bvh\r"},{"line":1676,"text":"        if not pts or bvh is None:\r"},{"line":1677,"text":"            return {\"id\": rule.get(\"id\"), \"met\": False, \"error\": 10.0, \"why\": \"no patch or no region\"}\r"},{"line":1678,"text":"        lo, hi = rule.get(\"gap_cm\", [-0.05, 0.2])\r"},{"line":1679,"text":"        fmax = rule.get(\"facing_max_deg\", 45.0)\r"},{"line":1680,"text":"        best = None\r"},{"line":1681,"text":"        good = 0\r"},{"line":1682,"text":"        for p, nv in pts:\r"},{"line":1683,"text":"            q, nn, _i, _d = bvh.find_nearest(p)\r"},{"line":1684,"text":"            if q is None:\r"},{"line":1685,"text":"                continue\r"},{"line":1686,"text":"            gap = (p - q).dot(nn) * 100.0\r"},{"line":1687,"text":"            dist = (p - q).length * 100.0\r"},{"line":1688,"text":"            gap = gap if abs(gap) > 1e-6 else dist\r"},{"line":1689,"text":"            if gap > 0:\r"},{"line":1690,"text":"                gap = dist                          # off the surface: the straight distance to it\r"},{"line":1691,"text":"            ang = math.degrees(nv.angle(-nn)) if nv.length > 1e-9 else 180.0\r"},{"line":1692,"text":"            err = max(0.0, gap - hi) + max(0.0, lo - gap) + max(0.0, ang - fmax) / 30.0\r"},{"line":1693,"text":"            good += 1 if err <= 1e-6 else 0\r"},{"line":1694,"text":"            if best is None or err < best[0]:\r"},{"line":1695,"text":"                best = (err, gap, ang, q, nn)\r"},{"line":1696,"text":"        if best is None:\r"},{"line":1697,"text":"            return {\"id\": rule.get(\"id\"), \"met\": False, \"error\": 10.0, \"why\": \"region out of reach\"}\r"},{"line":1698,"text":"        err, gap, ang, q, nn = best\r"},{"line":1699,"text":"        # how much of the patch lies on the region: a pad laid along a surface, not one point of it touching\r"},{"line":1700,"text":"        share = good / len(pts)\r"},{"line":1701,"text":"        need_share = rule.get(\"min_share\", 0.0)\r"},{"line":1702,"text":"        err += 2.0 * max(0.0, need_share - share)\r"},{"line":1703,"text":"        return {\"id\": rule.get(\"id\"), \"patch\": rule[\"patch\"], \"met\": err <= 1e-6, \"error\": round(err, 3),\r"},{"line":1704,"text":"                \"gap_cm\": round(gap, 2), \"facing_deg\": round(ang), \"share\": round(share, 2), \"min_share\": need_share,\r"},{"line":1705,"text":"                \"touch\": q, \"normal\": nn}\r"}],"name":"_rule_eval","start_line":1659,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:_rule_eval"}}
