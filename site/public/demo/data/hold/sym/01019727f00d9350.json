elf, \"pole_world\"):"}],"preds":[23],"stmts":["call hasattr"],"succs":[28,29]},{"cond":"ref.get('thumb_tip') is not None","id":27,"label":"merge","lines":[{"kind":"call","line":2008,"text":"placed = self.place_hand(side, pts, frame=\"world\")"},{"kind":"call","line":2010,"text":"if ref.get(\"thumb_tip\") is not None and \"thumb\" not in keep:"}],"preds":[29,23],"stmts":["call self.place_hand","call ref.get"],"succs":[30,31]},{"id":28,"label":"then","preds":[26],"stmts":null,"succs":[29]},{"id":29,"label":"merge","lines":[{"kind":"call","line":2007,"text":"self.pole_world[side] = Vector(ref[\"points\"][\"elbow\"])"}],"preds":[28,26],"stmts":["call Vector"],"succs":[27]},{"id":30,"label":"then","preds":[27],"stmts":null,"succs":[31]},{"cond":"ref.get('thumb_tip') is not None and 'thumb' not in keep","id":31,"label":"merge","preds":[30,27],"stmts":null,"succs":[32,33]},{"id":32,"label":"then","lines":[{"kind":"call","line":2011,"text":"tgt = Vector(ref[\"thumb_tip\"])"},{"kind":"call","line":2012,"text":"self._thumb_to(side, tgt, self._tree(), glove_cm, other, joints=(\"01\",), guard=True)"},{"kind":"call","line":2013,"text":"out[\"thumb_tip_left_cm\"] = round((self._finger_tip(\"thumb\", side) - tgt).length * 100.0, 2)"}],"preds":[31],"stmts":["call Vector","call self._thumb_to","call self._tree","call round","call self._finger_tip"],"succs":[33]},{"id":33,"label":"merge","lines":[{"kind":"call","line":2014,"text":"bpy.context.view_layer.update()"},{"kind":"return","line":2015,"text":"return out"}],"preds":[32,31],"stmts":["call bpy.context.view_layer.update","return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[33],"func_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.put_reference","issues":null},"source":{"end_line":2015,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"method","language":"python","lines":[{"line":1974,"text":"    def put_reference(self, side, ref, glove_cm=0.0, other=True):\r"},{"line":1975,"text":"        \"\"\"A reference hold (a pack's or a dataset's, already in this gun's world) put on the hand: each finger's\r"},{"line":1976,"text":"        three bends and the thumb's two (the measured angles), then the hand fitted as one rigid body to the\r"},{"line":1977,"text":"        reference's wrist, knuckles and thumb base (Kabsch; a smaller or larger hand lands as near as it can), then\r"},{"line":1978,"text":"        the thumb's base aimed so its tip comes to the reference's. ref: {\"points\": {wrist|index_knuckle|knuckle|\r"},{"line":1979,"text":"        pinky_knuckle|thumb_cmc: world point}, \"curls\": {finger: [3 degrees]}, \"thumb\": [knuckle, end degrees],\r"},{"line":1980,"text":"        \"thumb_tip\": world point, \"elbow\": world point (the arm's pole from then on), \"keep\": [digits left as they are]}.\r"},{"line":1981,"text":"        Returns each point's distance left (cm).\"\"\"\r"},{"line":1982,"text":"        self._need()\r"},{"line":1983,"text":"        FL = self._limits()[1]\r"},{"line":1984,"text":"        TL = self._thumb_limits()\r"},{"line":1985,"text":"        keep = set(ref.get(\"keep\") or ())\r"},{"line":1986,"text":"        for fi, c3 in (ref.get(\"curls\") or {}).items():\r"},{"line":1987,"text":"            if fi in keep:\r"},{"line":1988,"text":"                continue\r"},{"line":1989,"text":"            for j, cc in zip((\"01\", \"02\", \"03\"), c3):\r"},{"line":1990,"text":"                self._set_curl(side, fi, j, float(cc), FL)\r"},{"line":1991,"text":"        bpy.context.view_layer.update()\r"},{"line":1992,"text":"        th = ref.get(\"thumb\")\r"},{"line":1993,"text":"        if th and \"thumb\" not in keep:\r"},{"line":1994,"text":"            if self.R.get(\"thumb_hinge\") == \"ray\":\r"},{"line":1995,"text":"                for j, b in ((\"02\", th[0]), (\"03\", th[1])):\r"},{"line":1996,"text":"                    cur = self._thumb_report(side, TL)[0].get(\"thumb_\" + j, [0, 0])[0]\r"},{"line":1997,"text":"                    self._thumb_flex(side, j, float(b) - cur)\r"},{"line":1998,"text":"                    bpy.context.view_layer.update()\r"},{"line":1999,"text":"            else:\r"},{"line":2000,"text":"                self._set_thumb_bend(side, float(th[0]), float(th[1]), TL)\r"},{"line":2001,"text":"        pts = {k: v for k, v in (ref.get(\"points\") or {}).items()\r"},{"line":2002,"text":"               if k in (\"wrist\", \"index_knuckle\", \"knuckle\", \"pinky_knuckle\", \"thumb_cmc\")}\r"},{"line":2003,"text":"        if (ref.get(\"points\") or {}).get(\"elbow\") is not None:\r"},{"line":2004,"text":"            # the reference's elbow as this arm's pole from now on (a body-fixed point: the arm frame does not move)\r"},{"line":2005,"text":"            if not hasattr(self, \"pole_world\"):\r"},{"line":2006,"text":"                self.pole_world = {}\r"},{"line":2007,"text":"            self.pole_world[side] = Vector(ref[\"points\"][\"elbow\"])\r"},{"line":2008,"text":"        placed = self.place_hand(side, pts, frame=\"world\")\r"},{"line":2009,"text":"        out = {\"left_cm\": placed[\"left_cm\"], \"short_cm\": placed[\"short_cm\"]}\r"},{"line":2010,"text":"        if ref.get(\"thumb_tip\") is not None and \"thumb\" not in keep:\r"},{"line":2011,"text":"            tgt = Vector(ref[\"thumb_tip\"])\r"},{"line":2012,"text":"            self._thumb_to(side, tgt, self._tree(), glove_cm, other, joints=(\"01\",), guard=True)\r"},{"line":2013,"text":"            out[\"thumb_tip_left_cm\"] = round((self._finger_tip(\"thumb\", side) - tgt).length * 100.0, 2)\r"},{"line":2014,"text":"        bpy.context.view_layer.update()\r"},{"line":2015,"text":"        return out\r"}],"name":"put_reference","start_line":1974,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.put_reference"}}
