{"flow":{"kind":"var","name":"IMAGE_EXT","noCFG":true,"reason":"IMAGE_EXT is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":52,"file":"hold-code/weaponlab/blueprint/sources.py","kind":"var","language":"python","lines":[{"line":12,"text":"IMAGE_EXT = (\".png\", \".jpg\", \".jpeg\", \".tif\", \".tiff\", \".bmp\", \".gif\", \".webp\")\r"},{"line":13,"text":"\r"},{"line":14,"text":"\r"},{"line":15,"text":"def _pdf():\r"},{"line":16,"text":"    try:\r"},{"line":17,"text":"        import pymupdf\r"},{"line":18,"text":"    except ImportError:\r"},{"line":19,"text":"        import fitz as pymupdf\r"},{"line":20,"text":"    return pymupdf\r"},{"line":21,"text":"\r"},{"line":22,"text":"\r"},{"line":23,"text":"def _sha(path):\r"},{"line":24,"text":"    h = hashlib.sha256()\r"},{"line":25,"text":"    with open(path, \"rb\") as f:\r"},{"line":26,"text":"        for chunk in iter(lambda: f.read(1 << 20), b\"\"):\r"},{"line":27,"text":"            h.update(chunk)\r"},{"line":28,"text":"    return h.hexdigest()\r"},{"line":29,"text":"\r"},{"line":30,"text":"\r"},{"line":31,"text":"def new(gun, title=None):\r"},{"line":32,"text":"    \"\"\"An empty sources document for a gun (kept when one exists).\"\"\"\r"},{"line":33,"text":"    if store.exists(gun, \"sources\"):\r"},{"line":34,"text":"        return store.load(gun, \"sources\")\r"},{"line":35,"text":"    return {\"contract\": \"weaponlab-sources/1\", \"gun\": gun, \"title\": title or gun, \"sources\": [], \"pages\": [], \"figures\": [], \"facts\": []}\r"},{"line":36,"text":"\r"},{"line":37,"text":"\r"},{"line":38,"text":"def add(gun, file, source_id, kind, title, license_basis, publisher=None, year=None, url=None, credit=None,\r"},{"line":39,"text":"        distribution=None, note=None, gun_title=None):\r"},{"line":40,"text":"    \"\"\"Registers a file as a source of the gun. license_basis: us-government-work, public-domain-age,\r"},{"line":41,"text":"    public-domain-mark, us-patent, cc0, cc-by, cc-by-sa or permission.\"\"\"\r"},{"line":42,"text":"    path = Path(file)\r"},{"line":43,"text":"    if not path.exists():\r"},{"line":44,"text":"        raise FileNotFoundError(file)\r"},{"line":45,"text":"    doc = new(gun, gun_title)\r"},{"line":46,"text":"    if gun_title:\r"},{"line":47,"text":"        doc[\"title\"] = gun_title\r"},{"line":48,"text":"    src = {\"id\": source_id, \"kind\": kind, \"title\": title, \"file\": str(path.resolve()), \"sha256\": _sha(path),\r"},{"line":49,"text":"           \"license\": {\"basis\": license_basis}}\r"},{"line":50,"text":"    for k, v in ((\"publisher\", publisher), (\"year\", year), (\"url\", url), (\"distribution\", distribution)):\r"},{"line":51,"text":"        if v is not None:\r"},{"line":52,"text":"            src[k] = v\r"}],"name":"IMAGE_EXT","start_line":12,"symbol_id":"hold-code/weaponlab/blueprint/sources.py#var:IMAGE_EXT"}}
