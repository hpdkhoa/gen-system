57,"text":"    if path.suffix.lower() == \".pdf\":\r"},{"line":58,"text":"        d = _pdf().open(str(path))\r"},{"line":59,"text":"        src[\"pages\"] = d.page_count\r"},{"line":60,"text":"        src[\"text_layer\"] = sum(len(p.get_text()) for p in d) > 200 * min(d.page_count, 5)\r"},{"line":61,"text":"    else:\r"},{"line":62,"text":"        src[\"pages\"] = 1\r"},{"line":63,"text":"        src[\"text_layer\"] = False\r"},{"line":64,"text":"    doc[\"sources\"] = [s for s in doc[\"sources\"] if s[\"id\"] != source_id] + [src]\r"},{"line":65,"text":"    store.save(gun, \"sources\", doc)\r"},{"line":66,"text":"    return src\r"}],"name":"add","start_line":38,"symbol_id":"hold-code/weaponlab/blueprint/sources.py#func:add"}}
