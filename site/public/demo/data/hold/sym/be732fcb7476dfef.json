ine":96,"file":"hold-code/weaponlab/blueprint/figures.py","kind":"func","language":"python","lines":[{"line":86,"text":"def frame(gun, fig_id, bore_rear, bore_front, origin):\r"},{"line":87,"text":"    \"\"\"How the figure lies in gun space: the bore line from bore_rear toward the muzzle at bore_front, and the bolt\r"},{"line":88,"text":"    face (the origin). The origin is moved onto the bore line.\"\"\"\r"},{"line":89,"text":"    doc = store.load(gun, \"sources\")\r"},{"line":90,"text":"    f = _fig(doc, fig_id)\r"},{"line":91,"text":"    u = _unit(bore_rear, bore_front)\r"},{"line":92,"text":"    t = (origin[0] - bore_rear[0]) * u[0] + (origin[1] - bore_rear[1]) * u[1]\r"},{"line":93,"text":"    on = [bore_rear[0] + u[0] * t, bore_rear[1] + u[1] * t]\r"},{"line":94,"text":"    f[\"frame\"] = {\"bore\": [[round(v, 2) for v in bore_rear], [round(v, 2) for v in bore_front]], \"origin\": [round(v, 2) for v in on]}\r"},{"line":95,"text":"    store.save(gun, \"sources\", doc)\r"},{"line":96,"text":"    return {\"origin_on_bore\": f[\"frame\"][\"origin\"], \"moved_px\": round(math.dist(origin, on), 2)}\r"}],"name":"frame","start_line":86,"symbol_id":"hold-code/weaponlab/blueprint/figures.py#func:frame"}}
