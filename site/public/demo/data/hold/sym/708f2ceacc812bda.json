    ancestor.\"\"\"\r"},{"line":92,"text":"    have = set(arm.data.bones.keys())\r"},{"line":93,"text":"    moved = {}\r"},{"line":94,"text":"    for vg in list(mesh.vertex_groups):\r"},{"line":95,"text":"        if vg.name in have or vg.name not in full.data.bones:\r"},{"line":96,"text":"            continue\r"},{"line":97,"text":"        up = full.data.bones[vg.name].parent\r"},{"line":98,"text":"        while up is not None and up.name not in have:\r"},{"line":99,"text":"            up = up.parent\r"},{"line":100,"text":"        if up is None:\r"},{"line":101,"text":"            continue\r"},{"line":102,"text":"        to = mesh.vertex_groups.get(up.name) or mesh.vertex_groups.new(name=up.name)\r"},{"line":103,"text":"        for v in mesh.data.vertices:\r"},{"line":104,"text":"            for g in v.groups:\r"},{"line":105,"text":"                if g.group == vg.index and g.weight > 0.0:\r"},{"line":106,"text":"                    to.add([v.index], g.weight, 'ADD')\r"},{"line":107,"text":"        moved.setdefault(up.name, []).append(vg.name)\r"},{"line":108,"text":"        mesh.vertex_groups.remove(vg)\r"},{"line":109,"text":"    return moved\r"}],"name":"_adopt_orphans","start_line":86,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:_adopt_orphans"}}
