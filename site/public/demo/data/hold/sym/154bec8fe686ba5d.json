":["call polys.append"],"succs":[12]}],"effects":["unknown"],"entry":0,"exits":[3],"func_id":"hold-code/weaponlab/blueprint/check.py#func:silhouette","issues":null},"source":{"end_line":44,"file":"hold-code/weaponlab/blueprint/check.py","kind":"func","language":"python","lines":[{"line":27,"text":"def silhouette(bp, include=None):\r"},{"line":28,"text":"    \"\"\"Every part's side outline as polygons in (y, z) cm: an extrude's outline, a lathe's profile mirrored about\r"},{"line":29,"text":"    its axis.\"\"\"\r"},{"line":30,"text":"    polys = []\r"},{"line":31,"text":"    for pid, p in bp[\"parts\"].items():\r"},{"line":32,"text":"        if include and pid not in include:\r"},{"line":33,"text":"            continue\r"},{"line":34,"text":"        sh = p[\"shape\"]\r"},{"line":35,"text":"        if sh[\"kind\"] == \"extrude\":\r"},{"line":36,"text":"            polys.append(sh[\"outline\"])\r"},{"line":37,"text":"        elif sh[\"kind\"] == \"views\":\r"},{"line":38,"text":"            polys.append(sh[\"side\"])\r"},{"line":39,"text":"        else:\r"},{"line":40,"text":"            z0 = sh[\"axis\"][1]\r"},{"line":41,"text":"            top = [[y, z0 + r] for y, r in sh[\"profile\"]]\r"},{"line":42,"text":"            bot = [[y, z0 - r] for y, r in reversed(sh[\"profile\"])]\r"},{"line":43,"text":"            polys.append(top + bot)\r"},{"line":44,"text":"    return polys\r"}],"name":"silhouette","start_line":27,"symbol_id":"hold-code/weaponlab/blueprint/check.py#func:silhouette"}}
