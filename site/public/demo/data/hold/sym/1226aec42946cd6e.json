 s_ in run[\"sections\"]:\r"},{"line":555,"text":"            ring = [F @ (o + d * s_[\"t\"] + u * a + v * b) for a, b in s_[\"ring\"]]\r"},{"line":556,"text":"            secs.append((F @ Vector(s_[\"centre\"]), ring))\r"},{"line":557,"text":"        return {\"axis\": (Fq @ d).normalized(), \"inner\": F @ Vector(run[\"inner\"]), \"outer\": F @ Vector(run[\"outer\"]), \"sections\": secs}\r"}],"name":"_run_world","start_line":546,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#method:HoldMixin._run_world"}}
