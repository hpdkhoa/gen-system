{"flow":{"hint":"Select one of its methods to see control flow.","kind":"type","methods":[{"id":"hold-code/poselab_mcp/blender/sdflab.py#method:SdfMixin._part_mesh_local","name":"_part_mesh_local"},{"id":"hold-code/poselab_mcp/blender/sdflab.py#method:SdfMixin._sdf_dir","name":"_sdf_dir"},{"id":"hold-code/poselab_mcp/blender/sdflab.py#method:SdfMixin.build_sdf","name":"build_sdf"},{"id":"hold-code/poselab_mcp/blender/sdflab.py#method:SdfMixin.object_sdf","name":"object_sdf"},{"id":"hold-code/poselab_mcp/blender/sdflab.py#method:SdfMixin.sdf_query","name":"sdf_query"}],"name":"SdfMixin","noCFG":true,"reason":"SdfMixin is a type (struct/class/interface/enum). Control-flow graphs are built for functions and methods, not for a type itself."},"source":{"end_line":185,"file":"hold-code/poselab_mcp/blender/sdflab.py","kind":"type","language":"python","lines":[{"line":49,"text":"class SdfMixin:\r"},{"line":50,"text":"    def _sdf_dir(self):\r"},{"line":51,"text":"        d = os.path.join(self.out_dir, \"sdf\")\r"},{"line":52,"text":"        os.makedirs(d, exist_ok=True)\r"},{"line":53,"text":"        return d\r"},{"line":54,"text":"\r"},{"line":55,"text":"    def _part_mesh_local(self, part):\r"},{"line":56,"text":"        \"\"\"A part's polygons in its own frame (vertices, polygons), parts at rest.\"\"\"\r"},{"line":57,"text":"        dg = bpy.context.evaluated_depsgraph_get()\r"},{"line":58,"text":"        me_ob = self.rifle_mesh\r"},{"line":59,"text":"        ev = me_ob.evaluated_get(dg)\r"},{"line":60,"text":"        me = ev.to_mesh()\r"},{"line":61,"text":"        Fi = self._obj_frame(part).inverted() @ me_ob.matrix_world\r"},{"line":62,"text":"        V = [Fi @ v.co for v in me.vertices]\r"},{"line":63,"text":"        names = {g.index: g.name for g in me_ob.vertex_groups}\r"},{"line":64,"text":"        vg = []\r"},{"line":65,"text":"        for v in me_ob.data.vertices:\r"},{"line":66,"text":"            gm = max(v.groups, key=lambda x: x.weight) if v.groups else None\r"},{"line":67,"text":"            vg.append(names.get(gm.group) if gm else None)\r"},{"line":68,"text":"        ps = []\r"},{"line":69,"text":"        for p in me.polygons:\r"},{"line":70,"text":"            gs = [vg[i] or \"body\" for i in p.vertices]\r"},{"line":71,"text":"            own = max(set(gs), key=gs.count)\r"},{"line":72,"text":"            if not any(vg) or own == part:\r"},{"line":73,"text":"                ps.append(tuple(p.vertices))\r"},{"line":74,"text":"        ev.to_mesh_clear()\r"},{"line":75,"text":"        return V, ps\r"},{"line":76,"text":"\r"},{"line":77,"text":"    def build_sdf(self, part, cell_cm=SDF_CELL_CM, margin_cm=SDF_MARGIN_CM):\r"},{"line":78,"text":"        \"\"\"A part's signed distance grid in its own frame (m; inside below 0), and its region labels near the\r"},{"line":79,"text":"        surface. Kept on disk under the part's mesh's hash; built once.\"\"\"\r"},{"line":80,"text":"        V, ps = self._part_mesh_local(part)\r"},{"line":81,"text":"        if not ps:\r"},{"line":82,"text":"            return None\r"},{"line":83,"text":"        key = hashlib.sha1((part + json.dumps([[round(c, 5) for c in v] for v in V[:: max(1, len(V) // 500)]]) +\r"},{"line":84,"text":"                            str(len(V)) + str(len(ps)) + str(cell_cm)).encode()).hexdigest()[:16]\r"},{"line":85,"text":"        path = os.path.join(self._sdf_dir(), \"%s_%s.npz\" % (part, key))\r"},{"line":86,"text":"        if os.path.exists(path):\r"},{"line":87,"text":"            z = np.load(path, allow_pickle=True)\r"},{"line":88,"text":"            return {\"origin\": z[\"origin\"], \"cell\": float(z[\"cell\"]), \"d\": z[\"d\"], \"path\": path}\r"},{"line":89,"text":"        bvh = BVHTree.FromPolygons(V, ps)\r"},{"line":90,"text":"        A = np.array([list(v) for v in V])\r"},{"line":91,"text":"        cell = cell_cm / 100.0\r"},{"line":92,"text":"        lo = A.min(0) - margin_cm / 100.0\r"},{"line":93,"text":"        hi = A.max(0) + margin_cm / 100.0\r"},{"line":94,"text":"        n = np.maximum(2, np.ceil((hi - lo) / cell).astype(int) + 1)\r"},{"line":95,"text":"        nx, ny, nz = int(n[0]), int(n[1]), int(n[2])\r"},{"line":96,"text":"        # inside or out: rays along every row of cells, both ways along x and along z; crossings alternate\r"},{"line":97,"text":"        def row_inside(axis):\r"},{"line":98,"text":"            ins = np.zeros((nx, ny, nz), dtype=np.int8)\r"},{"line":99,"text":"            a, b = [k for k in range(3) if k != axis]\r"},{"line":100,"text":"            dirv = Vector([1.0 if k == axis else 0.0 for k in range(3)])\r"},{"line":101,"text":"            length = (n[axis] - 1) * cell\r"},{"line":102,"text":"            for i in range(n[a]):\r"},{"line":103,"text":"                for j in range(n[b]):\r"},{"line":104,"text":"                    o = [0.0, 0.0, 0.0]\r"},{"line":105,"text":"                    o[a] = lo[a] + i * cell\r"},{"line":106,"text":"                    o[b] = lo[b] + j * cell\r"},{"line":107,"text":"                    o[axis] = lo[axis] - 0.001\r"},{"line":108,"text":"                    o = Vector(o)\r"},{"line":109,"text":"                    hits, t0 = [], 0.0\r"},{"line":110,"text":"                    for _ in range(64):\r"},{"line":111,"text":"                        h = bvh.ray_cast(o + dirv * t0, dirv, length + 0.002 - t0)\r"},{"line":112,"text":"                        if h[0] is None:\r"},{"line":113,"text":"                            break\r"},{"line":114,"text":"                        t_hit = (h[0] - o).dot(dirv)\r"},{"line":115,"text":"                        hits.append(t_hit)\r"},{"line":116,"text":"                        t0 = t_hit + 1e-5\r"},{"line":117,"text":"                    if len(hits) < 2:\r"},{"line":118,"text":"                        continue\r"},{"line":119,"text":"                    ts = (np.arange(n[axis]) * cell + 0.001)\r"},{"line":120,"text":"                    cnt = np.searchsorted(np.array(hits), ts)\r"},{"line":121,"text":"                    line = (cnt % 2 == 1).astype(np.int8)\r"},{"line":122,"text":"                    sl = [slice(None)] * 3\r"},{"line":123,"text":"                    sl[a], sl[b] = i, j\r"},{"line":124,"text":"                    ins[tuple(sl)] = line\r"},{"line":125,"text":"            return ins\r"},{"line":126,"text":"        inside = (row_inside(0) + row_inside(2)) >= 1\r"},{"line":127,"text":"        # the distance: the nearest surface, for every cell (far cells clamped)\r"},{"line":128,"text":"        d = np.empty((nx, ny, nz), dtype=np.float32)\r"},{"line":129,"text":"        band = SDF_BAND_CM / 100.0\r"},{"line":130,"text":"        for i in range(nx):\r"},{"line":131,"text":"            for j in range(ny):\r"},{"line":132,"text":"                for k in range(nz):\r"},{"line":133,"text":"                    q = Vector((lo[0] + i * cell, lo[1] + j * cell, lo[2] + k * cell))\r"},{"line":134,"text":"                    loc, _nr, _ix, dist = bvh.find_nearest(q, band)\r"},{"line":135,"text":"                    dist = band if loc is None else dist\r"},{"line":136,"text":"                    d[i, j, k] = -dist if inside[i, j, k] else dist\r"},{"line":137,"text":"        np.savez_compressed(path, origin=lo, cell=cell, d=d)\r"},{"line":138,"text":"        return {\"origin\": lo, \"cell\": cell, \"d\": d, \"path\": path}\r"},{"line":139,"text":"\r"},{"line":140,"text":"    def object_sdf(self, parts=None):\r"},{"line":141,"text":"        \"\"\"Every part's grid, built once (or read from disk).\"\"\"\r"},{"line":142,"text":"        c = getattr(self, \"_sdfs\", None)\r"},{"line":143,"text":"        if c is not None:\r"},{"line":144,"text":"            return c\r"},{"line":145,"text":"        names = set()\r"},{"line":146,"text":"        for g in self.rifle_mesh.vertex_groups:\r"},{"line":147,"text":"            names.add(g.name)\r"},{"line":148,"text":"        names = sorted(names) or [\"body\"]\r"},{"line":149,"text":"        out = {}\r"},{"line":150,"text":"        for p in (parts or names):\r"},{"line":151,"text":"            g = self.build_sdf(p)\r"},{"line":152,"text":"            if g is not None:\r"},{"line":153,"text":"                out[p] = g\r"},{"line":154,"text":"        self._sdfs = out\r"},{"line":155,"text":"        return out\r"},{"line":156,"text":"\r"},{"line":157,"text":"    def sdf_query(self, P, want_normal=True, parts=None):\r"},{"line":158,"text":"        \"\"\"Signed distance (cm, inside below 0) from world points P (n x 3) to the object as posed now (the nearest\r"},{"line":159,"text":"        part wins), each point's nearest part, and with want_normal the outward normal (world, the grid's gradient).\"\"\"\r"},{"line":160,"text":"        S = self.object_sdf()\r"},{"line":161,"text":"        best = np.full(len(P), 99.0)\r"},{"line":162,"text":"        which = np.full(len(P), \"\", dtype=object)\r"},{"line":163,"text":"        nrm = np.zeros((len(P), 3)) if want_normal else None\r"},{"line":164,"text":"        for part, g in S.items():\r"},{"line":165,"text":"            if parts and part not in parts:\r"},{"line":166,"text":"                continue\r"},{"line":167,"text":"            F = self._obj_frame(part)\r"},{"line":168,"text":"            Fi = np.array(F.inverted())\r"},{"line":169,"text":"            R_, T_ = Fi[:3, :3], Fi[:3, 3]\r"},{"line":170,"text":"            L_ = P @ R_.T + T_\r"},{"line":171,"text":"            idx = (L_ - g[\"origin\"]) / g[\"cell\"]\r"},{"line":172,"text":"            dd = _trilinear(g[\"d\"], idx) * 100.0\r"},{"line":173,"text":"            near = dd < best\r"},{"line":174,"text":"            best[near] = dd[near]\r"},{"line":175,"text":"            which[near] = part\r"},{"line":176,"text":"            if want_normal and near.any():\r"},{"line":177,"text":"                h = 0.5\r"},{"line":178,"text":"                gx = (_trilinear(g[\"d\"], idx[near] + [h, 0, 0]) - _trilinear(g[\"d\"], idx[near] - [h, 0, 0]))\r"},{"line":179,"text":"                gy = (_trilinear(g[\"d\"], idx[near] + [0, h, 0]) - _trilinear(g[\"d\"], idx[near] - [0, h, 0]))\r"},{"line":180,"text":"                gz = (_trilinear(g[\"d\"], idx[near] + [0, 0, h]) - _trilinear(g[\"d\"], idx[near] - [0, 0, h]))\r"},{"line":181,"text":"                gl = np.c_[gx, gy, gz]\r"},{"line":182,"text":"                gl /= np.maximum(np.linalg.norm(gl, axis=1, keepdims=True), 1e-12)\r"},{"line":183,"text":"                R3 = np.array(F.to_3x3())\r"},{"line":184,"text":"                nrm[near] = gl @ R3.T\r"},{"line":185,"text":"        return best, which, nrm\r"}],"name":"SdfMixin","start_line":49,"symbol_id":"hold-code/poselab_mcp/blender/sdflab.py#type:SdfMixin"}}
