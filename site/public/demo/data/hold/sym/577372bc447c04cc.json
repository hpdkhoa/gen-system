t\r"},{"line":174,"text":"    for s in (\"l\", \"r\"):\r"},{"line":175,"text":"        S = ue(SHOULDER[s])\r"},{"line":176,"text":"        w, d, palm, index_side = HANDS[s]\r"},{"line":177,"text":"        W = G + ue(w)\r"},{"line":178,"text":"        E = _elbow(S, W, ue(POLE[s]))\r"},{"line":179,"text":"        up = eb.new(\"upperarm_\" + s)\r"},{"line":180,"text":"        up.head, up.tail, up.parent = S, E, root\r"},{"line":181,"text":"        lo = eb.new(\"lowerarm_\" + s)\r"},{"line":182,"text":"        lo.head, lo.tail, lo.parent, lo.use_connect = E, W, up, True\r"},{"line":183,"text":"        fwd = ue(d).normalized()\r"},{"line":184,"text":"        palm_n = ue(palm)\r"},{"line":185,"text":"        palm_n = (palm_n - fwd * palm_n.dot(fwd)).normalized()          # the way the palm faces\r"},{"line":186,"text":"        palm_up = -palm_n                                               # the back of the hand\r"},{"line":187,"text":"        across = palm_n.cross(fwd).normalized()                         # across the knuckles, to the index side\r"},{"line":188,"text":"        if across.dot(ue(index_side)) < 0:\r"},{"line":189,"text":"            across = -across\r"},{"line":190,"text":"        hand = eb.new(\"hand_\" + s)\r"},{"line":191,"text":"        hand.head, hand.tail, hand.parent, hand.use_connect = W, W + fwd * 0.085, lo, True\r"},{"line":192,"text":"        hand.align_roll(palm_up)       # the hand bone's Z: out of the back of the hand, its X: across the knuckles\r"},{"line":193,"text":"        for f, (off, *lengths) in FINGER.items():\r"},{"line":194,"text":"            start = W + fwd * (0.035 if f == \"thumb\" else 0.085) + across * off / 100.0 + palm_n * (0.012 if f == \"thumb\" else 0.0)\r"},{"line":195,"text":"            direction = (fwd * 0.7 + across * 0.5 + palm_n * 0.5).normalized() if f == \"thumb\" else (fwd + palm_n * 0.15).normalized()\r"},{"line":196,"text":"            parent = hand\r"},{"line":197,"text":"            for j, L in zip((\"01\", \"02\", \"03\"), lengths):\r"},{"line":198,"text":"                b = eb.new(\"%s_%s_%s\" % (f, j, s))\r"},{"line":199,"text":"                b.head, b.tail, b.parent = start, start + direction * L / 100.0, parent\r"},{"line":200,"text":"                b.use_connect = parent is not hand\r"},{"line":201,"text":"                b.align_roll(palm_up)\r"},{"line":202,"text":"                start, parent = b.tail.copy(), b\r"},{"line":203,"text":"                if f != \"thumb\":\r"},{"line":204,"text":"                    direction = (direction - palm_up * CURL).normalized()   # each joint curls toward the palm\r"},{"line":205,"text":"    bpy.ops.object.mode_set(mode='OBJECT')\r"},{"line":206,"text":"    return arm\r"}],"name":"build_arms","start_line":162,"symbol_id":"hold-code/poselab_mcp/blender/sample.py#func:build_arms"}}
