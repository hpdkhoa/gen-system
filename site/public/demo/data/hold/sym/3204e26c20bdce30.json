{"flow":{"kind":"var","name":"PUR","noCFG":true,"reason":"PUR is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":1215,"file":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py","kind":"var","language":"python","lines":[{"line":1175,"text":"PUR = (STYLE or {}).get(\"purposes\") if job.get(\"purposes\", True) else None\r"},{"line":1176,"text":"OBJ, MARKS = None, None\r"},{"line":1177,"text":"CLAV_SET = {}                # each home hold's shoulder girdle, as its search left it\r"},{"line":1178,"text":"GUN_DIRS = {\"back\": (0, -1, 0), \"front\": (0, 1, 0), \"left\": (1, 0, 0), \"right\": (-1, 0, 0), \"up\": (0, 0, 1), \"down\": (0, 0, -1)}\r"},{"line":1179,"text":"if PUR:\r"},{"line":1180,"text":"    hl_ = ((report.get(\"body_size\") or {}).get(\"r\") or {}).get(\"measures\", {}).get(\"hand_length_cm\")\r"},{"line":1181,"text":"    OBJ = L.read_object(parts=[\"Root\"], hand_length_cm=hl_, inner_toward=list(g((0.0, 0.0, 0.0))))\r"},{"line":1182,"text":"    runs_ = (OBJ[\"parts\"].get(\"Root\") or {}).get(\"runs\") or []\r"},{"line":1183,"text":"    report[\"object\"] = L.object_summary()\r"},{"line":1184,"text":"    if not runs_:\r"},{"line":1185,"text":"        report[\"notes\"].append(\"the frame has no run a hand can wrap: no purpose holds\")\r"},{"line":1186,"text":"        PUR = None\r"},{"line":1187,"text":"if PUR:\r"},{"line":1188,"text":"    gl_ = g(facts[\"marks\"][\"grip\"])\r"},{"line":1189,"text":"    ri_ = min(range(len(runs_)), key=lambda i: min((Vector(s_[\"centre\"]) - gl_).length for s_ in runs_[i][\"sections\"]))\r"},{"line":1190,"text":"    MARKS = []\r"},{"line":1191,"text":"    for sd_ in (\"r\", \"l\"):\r"},{"line":1192,"text":"        p_ = PUR.get(sd_)\r"},{"line":1193,"text":"        if not p_:\r"},{"line":1194,"text":"            continue\r"},{"line":1195,"text":"        m_ = {\"part\": \"Root\", \"role\": \"hold\", \"purpose\": p_[\"purpose\"], \"run\": ri_, \"hand\": sd_, \"thumb\": p_.get(\"thumb\"),\r"},{"line":1196,"text":"              \"index\": p_.get(\"index\", \"wrap\"), \"palm_dir\": list(g(GUN_DIRS[p_.get(\"palm\", \"back\")]).normalized())}\r"},{"line":1197,"text":"        ops_ = runs_[ri_][\"openings\"]\r"},{"line":1198,"text":"        if m_[\"index\"] == \"extended\":\r"},{"line":1199,"text":"            if ops_:\r"},{"line":1200,"text":"                tl_ = g(facts[\"marks\"][\"trigger\"]) if \"trigger\" in facts[\"marks\"] else gl_\r"},{"line":1201,"text":"                m_[\"index_line\"] = min(range(len(ops_)), key=lambda i: (Vector(ops_[i][\"centre\"]) - tl_).length)\r"},{"line":1202,"text":"            else:\r"},{"line":1203,"text":"                m_[\"index\"] = \"wrap\"\r"},{"line":1204,"text":"                report[\"notes\"].append(\"no opening beside the grip: the index wraps\")\r"},{"line":1205,"text":"        MARKS.append(m_)\r"},{"line":1206,"text":"    for part_ in PUR.get(\"notouch\", []):\r"},{"line":1207,"text":"        if part_ in facts[\"parts\"]:\r"},{"line":1208,"text":"            MARKS.append({\"part\": facts[\"parts\"][part_][\"bone\"], \"role\": \"notouch\"})\r"},{"line":1209,"text":"    # the gun's surface labelled once by region (the contact model's object), named in the gun's own frame\r"},{"line":1210,"text":"    LEFT_ = list(g((1.0, 0.0, 0.0)).normalized())\r"},{"line":1211,"text":"    for m_ in MARKS:\r"},{"line":1212,"text":"        if m_.get(\"role\") == \"hold\" and m_.get(\"purpose\") == \"power_wrap\" and m_.get(\"palm_dir\"):\r"},{"line":1213,"text":"            m_[\"_web\"] = L.web_point(m_, m_[\"palm_dir\"])[0]\r"},{"line":1214,"text":"    report[\"regions_cm2\"] = L.object_regions(MARKS, LEFT_)\r"},{"line":1215,"text":"    report[\"marks\"] = MARKS\r"}],"name":"PUR","start_line":1175,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#var:PUR"}}
