{"flow":{"kind":"var","name":"CONTRACT","noCFG":true,"reason":"CONTRACT is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":62,"file":"hold-code/weaponlab/gunkit/proxy.py","kind":"var","language":"python","lines":[{"line":22,"text":"CONTRACT = \"weaponlab-partsmap/1\"\r"},{"line":23,"text":"\r"},{"line":24,"text":"\r"},{"line":25,"text":"def _box(name, size, at, part=None):\r"},{"line":26,"text":"    return {\"name\": name, \"shape\": \"box\", \"size\": list(size), \"at\": list(at), \"part\": part}\r"},{"line":27,"text":"\r"},{"line":28,"text":"\r"},{"line":29,"text":"def _cyl(name, d, length, at, part=None, along=\"y\"):\r"},{"line":30,"text":"    return {\"name\": name, \"shape\": \"cyl\", \"size\": [d, length], \"at\": list(at), \"part\": part, \"along\": along}\r"},{"line":31,"text":"\r"},{"line":32,"text":"\r"},{"line":33,"text":"def _long_gun(barrel=40.0, mag=True):\r"},{"line":34,"text":"    \"\"\"A rifle's body: receiver, barrel, handguard, stock, grip; the marks every long gun has.\"\"\"\r"},{"line":35,"text":"    shapes = [_box(\"Receiver\", (4.0, 24.0, 7.0), (0.0, -4.0, 0.5)),\r"},{"line":36,"text":"              _cyl(\"Barrel\", 2.0, barrel, (0.0, barrel / 2.0, 0.0)),\r"},{"line":37,"text":"              _box(\"Handguard\", (5.0, 22.0, 6.0), (0.0, 16.0, -0.5)),\r"},{"line":38,"text":"              _cyl(\"BufferTube\", 3.0, 18.0, (0.0, -25.0, 1.0)),\r"},{"line":39,"text":"              _box(\"Butt\", (4.0, 8.0, 13.0), (0.0, -37.0, -2.0)),\r"},{"line":40,"text":"              _box(\"Grip\", (3.0, 4.0, 10.0), (0.0, -10.0, -8.0))]\r"},{"line":41,"text":"    # a hand's mark is where its palm (or a pinch's fingertips) meets the surface: the right palm on the grip's right\r"},{"line":42,"text":"    # side, the left palm under the handguard\r"},{"line":43,"text":"    marks = {\"grip\": [-1.5, -10.0, -7.0], \"support\": [0.0, 16.0, -3.5], \"muzzle\": [0.0, barrel, 0.0],\r"},{"line":44,"text":"             \"trigger\": [0.0, -6.5, -5.5], \"port\": [-2.2, 1.0, 1.5]}\r"},{"line":45,"text":"    if mag:\r"},{"line":46,"text":"        shapes.append(_box(\"Magazine\", (2.5, 6.0, 18.0), (0.0, 3.0, -11.0), \"magazine\"))\r"},{"line":47,"text":"        marks.update({\"mag_well\": [0.0, 3.0, -2.0], \"mag_grab\": [1.25, 3.0, -15.0], \"mag_lips\": [0.0, 3.0, -2.2]})\r"},{"line":48,"text":"    return shapes, marks\r"},{"line":49,"text":"\r"},{"line":50,"text":"\r"},{"line":51,"text":"def _pistol():\r"},{"line":52,"text":"    shapes = [_box(\"Frame\", (3.0, 18.0, 3.5), (0.0, 2.0, -1.5)),\r"},{"line":53,"text":"              _box(\"Grip\", (3.0, 5.0, 11.0), (0.0, -5.0, -8.0))]\r"},{"line":54,"text":"    marks = {\"grip\": [-1.5, -5.0, -7.0], \"support\": [1.5, -4.5, -8.0], \"muzzle\": [0.0, 12.0, 0.0],\r"},{"line":55,"text":"             \"trigger\": [0.0, -1.0, -4.0], \"port\": [-1.6, 1.0, 1.2],\r"},{"line":56,"text":"             \"mag_well\": [0.0, -5.0, -2.5], \"mag_grab\": [0.0, -5.0, -13.6], \"mag_lips\": [0.0, -5.0, -2.6]}\r"},{"line":57,"text":"    return shapes, marks\r"},{"line":58,"text":"\r"},{"line":59,"text":"\r"},{"line":60,"text":"def proxy(action_id):\r"},{"line":61,"text":"    \"\"\"The proxy gun of an action: its parts map (model left empty: the build writes it) and its shapes.\"\"\"\r"},{"line":62,"text":"    a = A.load(action_id)\r"}],"name":"CONTRACT","start_line":22,"symbol_id":"hold-code/weaponlab/gunkit/proxy.py#var:CONTRACT"}}
