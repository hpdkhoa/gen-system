c_id":"hold-code/poselab_mcp/blender/contactlab.py#method:ContactMixin._samples_world","issues":null},"source":{"end_line":187,"file":"hold-code/poselab_mcp/blender/contactlab.py","kind":"method","language":"python","lines":[{"line":175,"text":"    def _samples_world(self):\r"},{"line":176,"text":"        \"\"\"The labelled samples in the world as the object is posed now: (points n x 3, labels).\"\"\"\r"},{"line":177,"text":"        by_part = {}\r"},{"line":178,"text":"        for i, (part, p_, _n, _l) in enumerate(self._samples):\r"},{"line":179,"text":"            by_part.setdefault(part, []).append(i)\r"},{"line":180,"text":"        W = np.zeros((len(self._samples), 3))\r"},{"line":181,"text":"        for part, idx in by_part.items():\r"},{"line":182,"text":"            F = self._obj_frame(part)\r"},{"line":183,"text":"            R_ = np.array(F.to_3x3())\r"},{"line":184,"text":"            T_ = np.array(F.translation)\r"},{"line":185,"text":"            Pl = np.array([self._samples[i][1] for i in idx])\r"},{"line":186,"text":"            W[idx] = Pl @ R_.T + T_\r"},{"line":187,"text":"        return W, [s_[3] for s_ in self._samples]\r"}],"name":"_samples_world","start_line":175,"symbol_id":"hold-code/poselab_mcp/blender/contactlab.py#method:ContactMixin._samples_world"}}
