"id":28,"label":"loop_body","preds":[27],"stmts":null,"succs":[27]},{"id":29,"label":"loop_exit","preds":[27],"stmts":null,"succs":[24]},{"cond":"i > 0","id":30,"label":"else","lines":[{"kind":"call","line":745,"text":"i = len(prof) - 1"}],"preds":[19],"stmts":["call len"],"succs":[31,32]},{"id":31,"label":"then","preds":[30],"stmts":null,"succs":[32]},{"id":32,"label":"merge","preds":[31,30],"stmts":null,"succs":[33]},{"cond":"i > 0 and prof[i][0] > prof[-1][0] - crook_cm / 100.0","id":33,"label":"loop_header","preds":[32,34],"stmts":null,"succs":[34,35]},{"id":34,"label":"loop_body","preds":[33],"stmts":null,"succs":[33]},{"id":35,"label":"loop_exit","preds":[33],"stmts":null,"succs":[24]},{"cond":"for x in q","id":36,"label":"loop_header","preds":[24,37],"stmts":null,"succs":[37,38]},{"id":37,"label":"loop_body","lines":[{"kind":"call","line":749,"text":"return [float(x) for x in q], round(kk * 100.0, 2)"}],"preds":[36],"stmts":["call float"],"succs":[36]},{"id":38,"label":"loop_exit","lines":[{"kind":"call","line":749,"text":"return [float(x) for x in q], round(kk * 100.0, 2)"}],"preds":[36],"stmts":["call round","return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[16,38],"func_id":"hold-code/poselab_mcp/blender/holdlab.py#func:web_point","issues":null},"source":{"end_line":749,"file":"hold-code/poselab_mcp/blender/holdlab.py","kind":"func","language":"python","lines":[{"line":706,"text":"    def web_point(self, mark, palm_dir, step_cm=0.25, most_cm=6.0, overhang_cm=0.8, crook_cm=0.5):\r"},{"line":707,"text":"        \"\"\"Where the web of the hand sits on a power wrap. The part's surface on the palm's side (palm_dir, object\r"},{"line":708,"text":"        frame) is followed up from the run, past its inner end: how far it reaches out that way at each height.\r"},{"line":709,"text":"        Where it reaches out overhang_cm or more past the run's end (a beavertail, a hammer's head, a lip) the web\r"},{"line":710,"text":"        sits crook_cm into the crook under the farthest reach; with no overhang, crook_cm under the surface's end.\r"},{"line":711,"text":"        Returns the point (object frame, m) and its height past the run's end (cm).\"\"\"\r"},{"line":712,"text":"        run = self._object[\"parts\"][mark[\"part\"]][\"runs\"][mark.get(\"run\", 0)]\r"},{"line":713,"text":"        P = self._part_P[mark[\"part\"]]\r"},{"line":714,"text":"        d = np.array(run[\"axis\"])\r"},{"line":715,"text":"        inner, outer = np.array(run[\"inner\"]), np.array(run[\"outer\"])\r"},{"line":716,"text":"        inward = d if float((inner - outer) @ d) >= 0 else -d\r"},{"line":717,"text":"        pd = np.array(palm_dir, dtype=float)\r"},{"line":718,"text":"        pd = pd - inward * float(pd @ inward)\r"},{"line":719,"text":"        pd /= np.linalg.norm(pd)\r"},{"line":720,"text":"        side_ = np.cross(inward, pd)\r"},{"line":721,"text":"        h = (P - inner) @ inward\r"},{"line":722,"text":"        prof = []                                      # (height, reach, the surface point)\r"},{"line":723,"text":"        k = 0.0\r"},{"line":724,"text":"        while k <= most_cm / 100.0 + 1e-9:\r"},{"line":725,"text":"            m = (np.abs(h - k) <= step_cm / 200.0) & (np.abs((P - inner) @ side_) <= 0.012)\r"},{"line":726,"text":"            if m.sum() < 3:\r"},{"line":727,"text":"                break\r"},{"line":728,"text":"            off = (P[m] - inner) @ pd\r"},{"line":729,"text":"            e = float(np.max(off))\r"},{"line":730,"text":"            if prof and e < prof[0][1] - 0.01:\r"},{"line":731,"text":"                break                                  # the surface turns away: past the part's end on this side\r"},{"line":732,"text":"            prof.append((k, e, P[m][int(np.argmax(off))]))\r"},{"line":733,"text":"            k += step_cm / 100.0\r"},{"line":734,"text":"        if not prof:\r"},{"line":735,"text":"            return [float(x) for x in (inner + pd * 0.01)], 0.0\r"},{"line":736,"text":"        # the reach smoothed over its neighbours (the surface is sampled, its farthest point jitters)\r"},{"line":737,"text":"        es = [max(x[1] for x in prof[max(0, i - 1):i + 2]) for i in range(len(prof))]\r"},{"line":738,"text":"        kmax = int(np.argmax(es))\r"},{"line":739,"text":"        if es[kmax] - es[0] >= overhang_cm / 100.0:\r"},{"line":740,"text":"            target = es[kmax] - crook_cm / 100.0\r"},{"line":741,"text":"            i = kmax\r"},{"line":742,"text":"            while i > 0 and es[i] > target:\r"},{"line":743,"text":"                i -= 1\r"},{"line":744,"text":"        else:\r"},{"line":745,"text":"            i = len(prof) - 1\r"},{"line":746,"text":"            while i > 0 and prof[i][0] > prof[-1][0] - crook_cm / 100.0:\r"},{"line":747,"text":"                i -= 1\r"},{"line":748,"text":"        q, kk = prof[i][2], prof[i][0]\r"},{"line":749,"text":"        return [float(x) for x in q], round(kk * 100.0, 2)\r"}],"name":"web_point","start_line":706,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#func:web_point"}}
