,"label":"merge","lines":[{"kind":"call","line":175,"text":"poly.material_index = k if sum(1 for i in poly.vertices if i in gloved) * 2 >= len(poly.vertices) else ks"}],"preds":[33,31],"stmts":["call sum","call len"],"succs":[30]}],"effects":["unknown"],"entry":0,"exits":[5,11],"func_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:put_gloves","issues":null},"source":{"end_line":178,"file":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py","kind":"func","language":"python","lines":[{"line":136,"text":"def put_gloves():\r"},{"line":137,"text":"    cov = (CHAR or {}).get(\"covering\") or {}\r"},{"line":138,"text":"    if cov.get(\"kind\") not in (\"full_gloves\", \"fingerless_gloves\") or not GLOVE:\r"},{"line":139,"text":"        return None\r"},{"line":140,"text":"    col = ((CHAR.get(\"finish\") or {}).get(\"colors\") or {}).get(\"glove\", [0.23, 0.26, 0.2])\r"},{"line":141,"text":"    mat = bpy.data.materials.new(\"M_glove_\" + CHAR[\"id\"])\r"},{"line":142,"text":"    mat.use_nodes = True\r"},{"line":143,"text":"    bsdf = mat.node_tree.nodes.get(\"Principled BSDF\")\r"},{"line":144,"text":"    bsdf.inputs[\"Base Color\"].default_value = (*col, 1.0)\r"},{"line":145,"text":"    bsdf.inputs[\"Roughness\"].default_value = 0.85\r"},{"line":146,"text":"    mat.diffuse_color = (*col, 1.0)\r"},{"line":147,"text":"    hand_bones = {L._n(\"hand\", sd) for sd in (\"l\", \"r\")} | set(FINGER_BONES[\"l\"]) | set(FINGER_BONES[\"r\"])\r"},{"line":148,"text":"    if cov[\"kind\"] == \"fingerless_gloves\":\r"},{"line":149,"text":"        hand_bones = {b for b in hand_bones if not b.endswith((\"02_l\", \"03_l\", \"02_r\", \"03_r\"))}\r"},{"line":150,"text":"    done = 0\r"},{"line":151,"text":"    for ob in L.meshes:\r"},{"line":152,"text":"        groups = {vg.index: vg.name for vg in ob.vertex_groups}\r"},{"line":153,"text":"        me = ob.data\r"},{"line":154,"text":"        gloved = set()\r"},{"line":155,"text":"        for v in me.vertices:\r"},{"line":156,"text":"            w_hand = sum(gr.weight for gr in v.groups if groups.get(gr.group) in hand_bones)\r"},{"line":157,"text":"            w_all = sum(gr.weight for gr in v.groups) or 1.0\r"},{"line":158,"text":"            if w_hand / w_all >= 0.5:\r"},{"line":159,"text":"                gloved.add(v.index)\r"},{"line":160,"text":"        if not gloved:\r"},{"line":161,"text":"            continue\r"},{"line":162,"text":"        me.calc_normals() if hasattr(me, \"calc_normals\") else None\r"},{"line":163,"text":"        unit = 1.0 / (ob.matrix_world.to_scale().x or 1.0)          # the glove's thickness in the mesh's own units\r"},{"line":164,"text":"        for i in gloved:\r"},{"line":165,"text":"            v = me.vertices[i]\r"},{"line":166,"text":"            v.co = v.co + v.normal * (GLOVE / 100.0) * unit\r"},{"line":167,"text":"        sleeve_col = ((CHAR.get(\"finish\") or {}).get(\"colors\") or {}).get(\"sleeve\", [0.24, 0.26, 0.2])\r"},{"line":168,"text":"        sleeve = bpy.data.materials.get(\"M_sleeve_\" + CHAR[\"id\"]) or bpy.data.materials.new(\"M_sleeve_\" + CHAR[\"id\"])\r"},{"line":169,"text":"        sleeve.diffuse_color = (*sleeve_col, 1.0)\r"},{"line":170,"text":"        me.materials.append(mat)\r"},{"line":171,"text":"        k = len(me.materials) - 1\r"},{"line":172,"text":"        me.materials.append(sleeve)\r"},{"line":173,"text":"        ks = len(me.materials) - 1\r"},{"line":174,"text":"        for poly in me.polygons:                      # the hands gloved, the rest of the arms in the character's sleeves\r"},{"line":175,"text":"            poly.material_index = k if sum(1 for i in poly.vertices if i in gloved) * 2 >= len(poly.vertices) else ks\r"},{"line":176,"text":"        me.update()\r"},{"line":177,"text":"        done += len(gloved)\r"},{"line":178,"text":"    return {\"vertices\": done, \"thickness_cm\": GLOVE, \"color\": col, \"material\": mat.name}\r"}],"name":"put_gloves","start_line":136,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:put_gloves"}}
