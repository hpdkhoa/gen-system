t(obj, side=\"r\"):\r"},{"line":234,"text":"    \"\"\"A one-hand weapon's hilt against the closed fist. The grip channel runs between the palm and the curled middle\r"},{"line":235,"text":"    finger, along the knuckles (little finger to index); a hilt held right lies in it, the blade out on the index\r"},{"line":236,"text":"    side. Returns offset_cm and angle_deg (0 and 0 when it lies in), and the turn and offset in gun space that would\r"},{"line":237,"text":"    lay it in: rot (3x3, and as an Unreal rotator) and move_cm (add it to the model's offset on the hand).\"\"\"\r"},{"line":238,"text":"    d = C.read_parts(obj)\r"},{"line":239,"text":"    bone = lambda b: next((np.array(g[\"verts\"]) for k, g in d[\"groups\"].items() if k[0] == \"arms\" and k[3] == b), None)\r"},{"line":240,"text":"    parts = [b + \"_\" + side for b in (\"hand\", \"middle_01\", \"middle_02\", \"middle_03\")]\r"},{"line":241,"text":"    if any(bone(b) is None for b in parts + [\"index_01_\" + side, \"pinky_01_\" + side]):\r"},{"line":242,"text":"        return None\r"},{"line":243,"text":"    channel = np.mean([bone(b).mean(0) for b in parts], axis=0)\r"},{"line":244,"text":"    across = bone(\"index_01_\" + side).mean(0) - bone(\"pinky_01_\" + side).mean(0)\r"},{"line":245,"text":"    across /= np.linalg.norm(across)\r"},{"line":246,"text":"    model = np.vstack([np.array(g[\"verts\"]) for k, g in d[\"groups\"].items() if k[0] in (\"gun\", \"part\")])\r"},{"line":247,"text":"    c = model.mean(0)\r"},{"line":248,"text":"    w, vec = np.linalg.eigh(np.cov((model - c).T))\r"},{"line":249,"text":"    axis = vec[:, int(np.argmax(w))]\r"},{"line":250,"text":"    h = (model - c) @ axis\r"},{"line":251,"text":"    ends = [c + axis * h.min(), c + axis * h.max()]\r"},{"line":252,"text":"    pommel = min(ends, key=lambda e: np.linalg.norm(e - channel))\r"},{"line":253,"text":"    out_dir = axis if (ends[1] - pommel) @ axis > 0 else -axis\r"},{"line":254,"text":"    grip = pommel + out_dir * GRIP_CM\r"},{"line":255,"text":"    dv = grip - channel\r"},{"line":256,"text":"    off = float(np.linalg.norm(dv - across * (dv @ across)))\r"},{"line":257,"text":"    ang = math.degrees(math.acos(min(1.0, abs(float(out_dir @ across)))))\r"},{"line":258,"text":"    # a short knife's two ends both lie by the palm and its blade end can read reversed: under 20 degrees only moves\r"},{"line":259,"text":"    R = _rot_between(out_dir, across) if ang > 20.0 else np.eye(3)\r"},{"line":260,"text":"    move = channel - R @ grip          # the hand stays; the model turns by R and moves by this\r"},{"line":261,"text":"    return {\"offset_cm\": round(off, 2), \"angle_deg\": round(ang, 1), \"rot\": R.round(5).tolist(), \"rotator\": rotator(R),\r"},{"line":262,"text":"            \"move_cm\": move.round(2).tolist(), \"channel\": channel.round(2).tolist(), \"grip\": grip.round(2).tolist()}\r"}],"name":"fist","start_line":233,"symbol_id":"hold-code/weaponlab/rig.py#func:fist"}}
