, q1) = act[i][pb.name], act[j][pb.name]\r"},{"line":499,"text":"                    pb.location = Vector(l0).lerp(Vector(l1), k)\r"},{"line":500,"text":"                    pb.rotation_quaternion = Quaternion(q0).slerp(Quaternion(q1), k)\r"},{"line":501,"text":"            p0, p1 = act[i].get(\"_parts\", {}), act[j].get(\"_parts\", {})\r"},{"line":502,"text":"            if p0 or p1:\r"},{"line":503,"text":"                self.travel = {n: p0.get(n, 0.0) + (p1.get(n, 0.0) - p0.get(n, 0.0)) * k for n in set(p0) | set(p1)}\r"},{"line":504,"text":"            bpy.context.view_layer.update()\r"},{"line":505,"text":"        else:\r"},{"line":506,"text":"            f = act.frame_range[0] + seconds * fps\r"},{"line":507,"text":"            self.sc.frame_set(int(math.floor(f)), subframe=f % 1.0)\r"},{"line":508,"text":"            want = {b: T @ (o.matrix_world @ o.pose.bones[b].matrix) @ C[b] for b in C}\r"},{"line":509,"text":"            inv = self.arm.matrix_world.inverted()\r"},{"line":510,"text":"            for pb in self.arm.pose.bones:          # parents before children\r"},{"line":511,"text":"                if pb.name in want:\r"},{"line":512,"text":"                    pb.matrix = inv @ want[pb.name]\r"},{"line":513,"text":"                    bpy.context.view_layer.update()\r"},{"line":514,"text":"        self._place_rifle()\r"},{"line":515,"text":"        out = {\"clip\": clip, \"seconds\": round(seconds, 3), \"length\": round(length, 3)}\r"},{"line":516,"text":"        if abs(asked - seconds) > 1e-9:\r"},{"line":517,"text":"            out[\"note\"] = \"%s s is outside the clip; showing %s s\" % (asked, round(seconds, 3))\r"},{"line":518,"text":"        return out\r"}],"name":"pose_clip","start_line":484,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:pose_clip"}}
