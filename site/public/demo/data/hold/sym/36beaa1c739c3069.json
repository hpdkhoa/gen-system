x(side, j, b - cur)\r"},{"line":1936,"text":"                else:\r"},{"line":1937,"text":"                    pass\r"},{"line":1938,"text":"            if self.R.get(\"thumb_hinge\") != \"ray\":\r"},{"line":1939,"text":"                self._set_thumb_bend(side, tb[1] + x[13], tb[2] + x[14], TL)\r"},{"line":1940,"text":"            bpy.context.view_layer.update()\r"},{"line":1941,"text":"            return short\r"}],"name":"apply","start_line":1906,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:apply"}}
