.create_cube(bm, size=1.0, matrix=Matrix.Diagonal(size.to_4d()))\r"},{"line":72,"text":"    b = min(bevel, min(size) * 0.3)\r"},{"line":73,"text":"    if b > 0:\r"},{"line":74,"text":"        bmesh.ops.bevel(bm, geom=list(bm.edges), offset=b, segments=2, profile=0.5, affect='EDGES', clamp_overlap=True)\r"},{"line":75,"text":"    bmesh.ops.transform(bm, matrix=Matrix.Translation((lo + hi) / 2) @ Matrix.Rotation(math.radians(turn_deg), 4, 'X'), verts=bm.verts)\r"},{"line":76,"text":"    return bm\r"}],"name":"rifle_box","start_line":66,"symbol_id":"hold-code/poselab_mcp/blender/sample.py#func:rifle_box"}}
