ers.items()","id":37,"label":"loop_header","preds":[36,38],"stmts":null,"succs":[38,39]},{"id":38,"label":"loop_body","preds":[37],"stmts":null,"succs":[37]},{"id":39,"label":"loop_exit","lines":[{"kind":"call","line":4027,"text":"bpy.context.view_layer.update()"},{"kind":"call","line":4028,"text":"self._roll_forearm(side)"},{"kind":"call","line":4029,"text":"self._mend_hand(side)"},{"kind":"call","line":4030,"text":"self._clear_fingers(side)"},{"kind":"call","line":4031,"text":"made.append(self._capture())"}],"preds":[37],"stmts":["call bpy.context.view_layer.update","call self._roll_forearm","call self._mend_hand","call self._clear_fingers","call made.append","call self._capture"],"succs":[21]},{"id":40,"label":"then","preds":[23],"stmts":null,"succs":[41]},{"id":41,"label":"merge","lines":[{"kind":"call","line":4033,"text":"self._store(name, made, fps, \"retarget_clip(%s, %s)\" % (clip, side))"},{"kind":"call","line":4034,"text":"return {\"clip\": name, \"frames\": len(made), \"fps\": fps}"}],"preds":[40,23],"stmts":["call self._store","call len","return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[1,41],"func_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.retarget_clip","issues":null},"source":{"end_line":4034,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"method","language":"python","lines":[{"line":3985,"text":"    def retarget_clip(self, clip, side, mark=None, out=None, frame=\"gun\", keep_from_s=None, keep_to_s=None, hold=\"idle\",\r"},{"line":3986,"text":"                      gun_move=None, pole=None):\r"},{"line":3987,"text":"        \"\"\"A donor rig's clip played on this rig with a hand held on this gun's own hold: each frame keeps the clip's\r"},{"line":3988,"text":"        body, then the hand is put back where it holds the gun at rest (or on mark, gun frame) by arm IK, its turn\r"},{"line":3989,"text":"        against the gun kept, its fingers mended. keep_from_s..keep_to_s: the span in which the hand lets go (a reload),\r"},{"line":3990,"text":"        left as the clip has it. hold: 'idle' (the rig's idle hold) or 'current' (the hold the rig stands in now, as\r"},{"line":3991,"text":"        solve_grip leaves it). gun_move: move_gun's arguments (roll, swing, pitch, right, forward, up, pivot), applied to\r"},{"line":3992,"text":"        each frame before the hand is placed, the other hand keeping its hold: a rifle carried lower or closer than the\r"},{"line":3993,"text":"        clip has it. pole: where the elbow points (arms frame, cm), as solve_grip's best gives it; the arm IK's own\r"},{"line":3994,"text":"        choice if left out. Stores the result as out (default clip + '_retarget').\"\"\"\r"},{"line":3995,"text":"        self._need()\r"},{"line":3996,"text":"        frames, fps = self._frames(clip)\r"},{"line":3997,"text":"        hn = self._n(\"hand\", side)\r"},{"line":3998,"text":"        if hold not in (\"idle\", \"current\"):\r"},{"line":3999,"text":"            raise ValueError(\"hold must be idle or current\")\r"},{"line":4000,"text":"        if hold == \"idle\":\r"},{"line":4001,"text":"            self.pose_idle()\r"},{"line":4002,"text":"        other = \"r\" if side == \"l\" else \"l\"\r"},{"line":4003,"text":"        move = dict(gun_move or {})\r"},{"line":4004,"text":"        move.pop(\"keep_hands\", None)\r"},{"line":4005,"text":"        G = self._gun()\r"},{"line":4006,"text":"        rel = G.inverted() @ self._bw(hn)\r"},{"line":4007,"text":"        fingers = {pb.name: (pb.location.copy(), pb.rotation_quaternion.copy()) for pb in self.arm.pose.bones\r"},{"line":4008,"text":"                   if pb.name.endswith(\"_\" + side) and any(f in pb.name for f in (\"thumb\", \"index\", \"middle\", \"ring\", \"pinky\"))}\r"},{"line":4009,"text":"        if mark is not None:\r"},{"line":4010,"text":"            p = self._point(mark, frame)\r"},{"line":4011,"text":"            rel = Matrix.LocRotScale(G.inverted() @ p, rel.to_quaternion(), rel.to_scale())\r"},{"line":4012,"text":"        made = []\r"},{"line":4013,"text":"        for i, fr in enumerate(frames):\r"},{"line":4014,"text":"            t = i / fps\r"},{"line":4015,"text":"            self._apply(fr)\r"},{"line":4016,"text":"            if keep_from_s is not None and keep_to_s is not None and keep_from_s <= t <= keep_to_s:\r"},{"line":4017,"text":"                made.append(self._capture())\r"},{"line":4018,"text":"                continue\r"},{"line":4019,"text":"            if any(v for k, v in move.items() if k != \"pivot\"):\r"},{"line":4020,"text":"                self.move_gun(keep_hands=(other,), **move)\r"},{"line":4021,"text":"            Hw = self._gun() @ rel\r"},{"line":4022,"text":"            self._two_bone(side, Hw.translation, pole)\r"},{"line":4023,"text":"            self._set_world(hn, Matrix.LocRotScale(self._bw(hn).translation, Hw.to_quaternion(), self._unit()))\r"},{"line":4024,"text":"            for name, (l, q) in fingers.items():           # the hold's own fingers\r"},{"line":4025,"text":"                pb = self.arm.pose.bones[name]\r"},{"line":4026,"text":"                pb.location, pb.rotation_quaternion = l, q\r"},{"line":4027,"text":"            bpy.context.view_layer.update()\r"},{"line":4028,"text":"            self._roll_forearm(side)\r"},{"line":4029,"text":"            self._mend_hand(side)\r"},{"line":4030,"text":"            self._clear_fingers(side)\r"},{"line":4031,"text":"            made.append(self._capture())\r"},{"line":4032,"text":"        name = out or clip + \"_retarget\"\r"},{"line":4033,"text":"        self._store(name, made, fps, \"retarget_clip(%s, %s)\" % (clip, side))\r"},{"line":4034,"text":"        return {\"clip\": name, \"frames\": len(made), \"fps\": fps}\r"}],"name":"retarget_clip","start_line":3985,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.retarget_clip"}}
