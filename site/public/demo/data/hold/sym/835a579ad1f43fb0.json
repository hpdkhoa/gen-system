        spread over the frames round it so nothing pops;\r"},{"line":3570,"text":"        anatomy: the elbow swings (as for clearance) by the least angle that brings it under the shoulder and inside\r"},{"line":3571,"text":"        its bend, then the wrist turns back inside its limits and each finger joint back inside its range.\r"},{"line":3572,"text":"        Reports the scan before and after; save_clip writes the result.\"\"\"\r"},{"line":3573,"text":"        self._need()\r"},{"line":3574,"text":"        out = out or clip + \"_fixed\"\r"},{"line":3575,"text":"        frames, fps = self._frames(clip)\r"},{"line":3576,"text":"        before = self._scan(frames, fps, checks, clip)\r"},{"line":3577,"text":"        changed = set()\r"},{"line":3578,"text":"        limits = {}   # check -> the frames whose target lies out of the arm's reach, and how far\r"},{"line":3579,"text":"\r"},{"line":3580,"text":"        def out_of_reach(c, i, short):\r"},{"line":3581,"text":"            if short > 0.05:\r"},{"line":3582,"text":"                key = \"%s %s\" % (c[\"type\"], c.get(\"side\") or c.get(\"a\"))\r"},{"line":3583,"text":"                n, worst, first, last = limits.get(key, (0, 0.0, i, i))\r"},{"line":3584,"text":"                limits[key] = (n + 1, max(worst, short), min(first, i), max(last, i))\r"},{"line":3585,"text":"        # pops: the frames that jump are blended again between the nearest good frames\r"},{"line":3586,"text":"        for c in [c for c in checks if c[\"type\"] == \"pop\"]:\r"},{"line":3587,"text":"            rep = self._scan(frames, fps, [c], clip)[\"checks\"][0]\r"},{"line":3588,"text":"            bad = set()\r"},{"line":3589,"text":"            for a, b in rep[\"failing_s\"]:\r"},{"line":3590,"text":"                for i in range(int(round(a * fps)), int(round(b * fps)) + 1):\r"},{"line":3591,"text":"                    bad.update((i - 1, i))\r"},{"line":3592,"text":"            bad = sorted(i for i in bad if 0 <= i < len(frames))\r"},{"line":3593,"text":"            good = [i for i in range(len(frames)) if i not in bad]\r"},{"line":3594,"text":"            for i in bad:\r"},{"line":3595,"text":"                lo_ = max([g for g in good if g < i], default=None)\r"},{"line":3596,"text":"                hi_ = min([g for g in good if g > i], default=None)\r"},{"line":3597,"text":"                if lo_ is not None and hi_ is not None:\r"},{"line":3598,"text":"                    frames[i] = self._blend(frames[lo_], frames[hi_], (i - lo_) / (hi_ - lo_))\r"},{"line":3599,"text":"                    changed.add(i)\r"},{"line":3600,"text":"        # holds: each frame's hand back onto its grip as at ref_s\r"},{"line":3601,"text":"        for c in [c for c in checks if c[\"type\"] == \"hold\"]:\r"},{"line":3602,"text":"            self._apply(frames[min(len(frames) - 1, int(round(c.get(\"ref_s\", 0.0) * fps)))])\r"},{"line":3603,"text":"            ref = self._hand_in_gun(c[\"side\"])\r"},{"line":3604,"text":"            for i, fr in enumerate(frames):\r"},{"line":3605,"text":"                if not self._in(c, i / fps):\r"},{"line":3606,"text":"                    continue\r"},{"line":3607,"text":"                self._apply(fr)\r"},{"line":3608,"text":"                if (self._hand_in_gun(c[\"side\"]).translation - ref.translation).length * 100.0 > c.get(\"max_cm\", 0.5):\r"},{"line":3609,"text":"                    out_of_reach(c, i, self._put_hand(c[\"side\"], self._gun() @ ref))\r"},{"line":3610,"text":"                    frames[i] = self._capture()\r"},{"line":3611,"text":"                    changed.add(i)\r"},{"line":3612,"text":"        # contacts: the wrist moves until the point of the hand touches its mark\r"},{"line":3613,"text":"        for c in [c for c in checks if c[\"type\"] == \"contact\"]:\r"},{"line":3614,"text":"            side = c[\"a\"][-1] if c[\"a\"][-2:] in (\"_l\", \"_r\") else c.get(\"side\", \"l\")\r"},{"line":3615,"text":"            for i, fr in enumerate(frames):\r"},{"line":3616,"text":"                if not self._in(c, i / fps):\r"},{"line":3617,"text":"                    continue\r"},{"line":3618,"text":"                self._apply(fr)\r"},{"line":3619,"text":"                if self.distance(c[\"a\"], c[\"b\"])[\"cm\"] <= c.get(\"max_cm\", 0.5):\r"},{"line":3620,"text":"                    continue\r"},{"line":3621,"text":"                short = 0.0\r"},{"line":3622,"text":"                for _ in range(8):\r"},{"line":3623,"text":"                    err = self._point(c[\"b\"]) - self._point(c[\"a\"])\r"},{"line":3624,"text":"                    if err.length * 100.0 <= c.get(\"max_cm\", 0.5) * 0.5:\r"},{"line":3625,"text":"                        break\r"},{"line":3626,"text":"                    short = self._put_hand(side, Matrix.Translation(err) @ self._bw(self._n(\"hand\", side)))\r"},{"line":3627,"text":"                out_of_reach(c, i, short)\r"},{"line":3628,"text":"                frames[i] = self._capture()\r"},{"line":3629,"text":"                changed.add(i)\r"},{"line":3630,"text":"        # clearance: the least elbow swing that clears, per frame and side, spread over the frames round it\r"},{"line":3631,"text":"        steps = [0.0] + [sg * a for a in range(10, int(max_swing_deg) + 1, 10) for sg in (1, -1)]\r"},{"line":3632,"text":"        for c in [c for c in checks if c[\"type\"] == \"clearance\"]:\r"},{"line":3633,"text":"            for side in [s_ for s_ in (\"l\", \"r\") if c.get(\"parts\", \"both\") in (\"both\", s_, {\"l\": \"left\", \"r\": \"right\"}[s_])]:\r"},{"line":3634,"text":"                part = {\"l\": \"left\", \"r\": \"right\"}[side]\r"},{"line":3635,"text":"                angle = [0.0] * len(frames)\r"},{"line":3636,"text":"                for i, fr in enumerate(frames):\r"},{"line":3637,"text":"                    if not self._in(c, i / fps):\r"},{"line":3638,"text":"                        continue\r"},{"line":3639,"text":"                    self._apply(fr)\r"},{"line":3640,"text":"                    if self.clearance(part, c.get(\"ignore\", ()))[\"worst_cm\"] <= c.get(\"max_cm\", 0.0):\r"},{"line":3641,"text":"                        continue\r"},{"line":3642,"text":"                    best = None\r"},{"line":3643,"text":"                    for a in steps:\r"},{"line":3644,"text":"                        self._apply(fr)\r"},{"line":3645,"text":"                        self._swing_elbow(side, a)\r"},{"line":3646,"text":"                        v = self.clearance(part, c.get(\"ignore\", ()))[\"worst_cm\"]\r"},{"line":3647,"text":"                        if best is None or v < best[0] - 1e-6:\r"},{"line":3648,"text":"                            best = (v, a)\r"},{"line":3649,"text":"                        if v <= c.get(\"max_cm\", 0.0):\r"},{"line":3650,"text":"                            break\r"},{"line":3651,"text":"                    angle[i] = best[1]\r"},{"line":3652,"text":"                spread = list(angle)\r"},{"line":3653,"text":"                for i, a in enumerate(angle):\r"},{"line":3654,"text":"                    if not a:\r"},{"line":3655,"text":"                        continue\r"},{"line":3656,"text":"                    for k in range(-spread_frames, spread_frames + 1):\r"},{"line":3657,"text":"                        j = i + k\r"},{"line":3658,"text":"                        if 0 <= j < len(frames):\r"},{"line":3659,"text":"                            w = a * (1.0 - smooth(0.0, spread_frames + 1.0, abs(k)))\r"},{"line":3660,"text":"                            if abs(w) > abs(spread[j]):\r"},{"line":3661,"text":"                                spread[j] = w\r"},{"line":3662,"text":"                for i, a in enumerate(spread):\r"},{"line":3663,"text":"                    if a:\r"},{"line":3664,"text":"                        self._apply(frames[i])\r"},{"line":3665,"text":"                        self._swing_elbow(side, a)\r"},{"line":3666,"text":"                        frames[i] = self._capture()\r"},{"line":3667,"text":"                        changed.add(i)\r"},{"line":3668,"text":"        # anatomy: the least elbow swing that puts each elbow under its shoulder and inside its bend, spread over the\r"},{"line":3669,"text":"        # frames round it; then the wrist and the fingers inside their limits, frame by frame\r"},{"line":3670,"text":"        for c in [c for c in checks if c[\"type\"] == \"anatomy\"]:\r"},{"line":3671,"text":"            L, _FL = self._limits()\r"},{"line":3672,"text":"            for side in [s_ for s_ in (\"l\", \"r\") if c.get(\"side\", \"both\") in (\"both\", s_)]:\r"},{"line":3673,"text":"                elbow_bad = lambda: [b_ for b_ in self._arm_report(side, L)[1] if b_.startswith(\"elbow\")]\r"},{"line":3674,"text":"                angle = [0.0] * len(frames)\r"},{"line":3675,"text":"                for i, fr in enumerate(frames):\r"},{"line":3676,"text":"                    if not self._in(c, i / fps):\r"},{"line":3677,"text":"                        continue\r"},{"line":3678,"text":"                    self._apply(fr)\r"},{"line":3679,"text":"                    if not elbow_bad():\r"},{"line":3680,"text":"                        continue\r"},{"line":3681,"text":"                    best = None\r"},{"line":3682,"text":"                    for a in steps:\r"},{"line":3683,"text":"                        self._apply(fr)\r"},{"line":3684,"text":"                        self._swing_elbow(side, a)\r"},{"line":3685,"text":"                        n_ = len(elbow_bad())\r"},{"line":3686,"text":"                        under = self._arm_report(side, L)[0][\"elbow_under_shoulder_cm\"]\r"},{"line":3687,"text":"                        if best is None or (n_, -under) < best[0]:\r"},{"line":3688,"text":"                            best = ((n_, -under), a)\r"},{"line":3689,"text":"                        if n_ == 0:\r"},{"line":3690,"text":"                            break\r"},{"line":3691,"text":"                    angle[i] = best[1]\r"},{"line":3692,"text":"                spread = list(angle)\r"},{"line":3693,"text":"                for i, a in enumerate(angle):\r"},{"line":3694,"text":"                    if not a:\r"},{"line":3695,"text":"                        continue\r"},{"line":3696,"text":"                    for k in range(-spread_frames, spread_frames + 1):\r"},{"line":3697,"text":"                        j = i + k\r"},{"line":3698,"text":"                        if 0 <= j < len(frames):\r"},{"line":3699,"text":"                            w = a * (1.0 - smooth(0.0, spread_frames + 1.0, abs(k)))\r"},{"line":3700,"text":"                            if abs(w) > abs(spread[j]):\r"},{"line":3701,"text":"                                spread[j] = w\r"},{"line":3702,"text":"                for i, fr in enumerate(frames):\r"},{"line":3703,"text":"                    if not self._in(c, i / fps) and not spread[i]:\r"},{"line":3704,"text":"                        continue\r"},{"line":3705,"text":"                    self._apply(fr)\r"},{"line":3706,"text":"                    if spread[i]:\r"},{"line":3707,"text":"                        self._swing_elbow(side, spread[i])\r"},{"line":3708,"text":"                    made = self._mend_hand(side, c.get(\"fingers\", True)) if self._in(c, i / fps) else 0\r"},{"line":3709,"text":"                    # a finger whose back is inside the rifle opens off it (a hand moved onto another gun's grip)\r"},{"line":3710,"text":"                    if self._in(c, i / fps) and c.get(\"fingers\", True):\r"},{"line":3711,"text":"                        made += self._clear_fingers(side)\r"},{"line":3712,"text":"                    # the forearm's roll spread along its twist bones (0.4.0's rule), where a link rolls past its limit\r"},{"line":3713,"text":"                    if self._in(c, i / fps) and self._twist_bones(side):\r"},{"line":3714,"text":"                        rep_, bad_ = self._arm_report(side, self._limits()[0])\r"},{"line":3715,"text":"                        if any(\"link rolled\" in b for b in bad_):\r"},{"line":3716,"text":"                            self._spread_roll(side)\r"},{"line":3717,"text":"                            made += 1\r"},{"line":3718,"text":"                    if spread[i] or made:\r"},{"line":3719,"text":"                        frames[i] = self._capture()\r"},{"line":3720,"text":"                        changed.add(i)\r"},{"line":3721,"text":"        self._store(out, frames, fps, \"fixed from %s\" % clip)\r"},{"line":3722,"text":"        after = self._scan(frames, fps, checks, out)\r"},{"line":3723,"text":"        brief = lambda r: [{\"check\": x[\"check\"][\"type\"], \"passed\": x[\"passed\"], \"worst\": x[\"worst\"], \"failing_frames\": x[\"failing_frames\"]} for x in r[\"checks\"]]\r"},{"line":3724,"text":"        # what no fix can mend: a hand asked to be where the arm cannot reach (the pose itself must change)\r"},{"line":3725,"text":"        reach = [{\"check\": k, \"frames\": n, \"from_s\": round(a / fps, 3), \"to_s\": round(b / fps, 3), \"worst_short_cm\": round(w, 2)}\r"},{"line":3726,"text":"                 for k, (n, w, a, b) in limits.items()]\r"},{"line":3727,"text":"        return {\"clip\": out, \"changed_frames\": len(changed), \"before\": brief(before), \"after\": brief(after),\r"},{"line":3728,"text":"                \"all_passed_after\": after[\"all_passed\"], \"out_of_reach\": reach, \"after_detail\": after[\"checks\"]}\r"}],"name":"fix_clip","start_line":3563,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.fix_clip"}}
