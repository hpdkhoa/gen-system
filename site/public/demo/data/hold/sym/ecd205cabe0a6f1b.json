d":"func","language":"python","lines":[{"line":660,"text":"def _gun_polys():\r"},{"line":661,"text":"    \"\"\"Each polygon of the gun's mesh at rest in the facts' gun frame (cm): its centre, its normal and the bone that\r"},{"line":662,"text":"    carries it (its vertices' heaviest group).\"\"\"\r"},{"line":663,"text":"    me = L.rifle_mesh\r"},{"line":664,"text":"    Ri = RA.matrix_world.inverted() @ me.matrix_world\r"},{"line":665,"text":"    Rq = Ri.to_quaternion()\r"},{"line":666,"text":"    names = {g.index: g.name for g in me.vertex_groups}\r"},{"line":667,"text":"    vb = []\r"},{"line":668,"text":"    for v in me.data.vertices:\r"},{"line":669,"text":"        gm = max(v.groups, key=lambda x: x.weight) if v.groups else None\r"},{"line":670,"text":"        vb.append(names.get(gm.group, \"Root\") if gm else \"Root\")\r"},{"line":671,"text":"    out = []\r"},{"line":672,"text":"    for p in me.data.polygons:\r"},{"line":673,"text":"        c_ = Ri @ p.center\r"},{"line":674,"text":"        n_ = Rq @ p.normal\r"},{"line":675,"text":"        bones = [vb[i] for i in p.vertices]\r"},{"line":676,"text":"        out.append((Vector((c_.x * 100, -c_.y * 100, c_.z * 100)), Vector((n_.x, -n_.y, n_.z)).normalized(),\r"},{"line":677,"text":"                    max(set(bones), key=bones.count)))\r"},{"line":678,"text":"    return out\r"}],"name":"_gun_polys","start_line":660,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:_gun_polys"}}
