mts":null,"succs":[6,7]},{"cond":"SL[k] in want","id":6,"label":"loop_body","preds":[5],"stmts":null,"succs":[8,9]},{"id":7,"label":"loop_exit","lines":[{"kind":"call","line":906,"text":"return round(hit / float(max(1, tot)), 3)"}],"preds":[5],"stmts":["call round","call float","call max","return"],"succs":null},{"cond":"int(k) in tch","id":8,"label":"then","preds":[6],"stmts":null,"succs":[10,11]},{"id":9,"label":"merge","preds":[11,6],"stmts":null,"succs":[5]},{"id":10,"label":"then","preds":[8],"stmts":null,"succs":[11]},{"id":11,"label":"merge","lines":[{"kind":"call","line":905,"text":"hit += 1 if int(k) in tch else 0"}],"preds":[10,8],"stmts":["call int"],"succs":[9]}],"effects":["unknown"],"entry":0,"exits":[1,3,7],"func_id":"hold-code/poselab_mcp/blender/contactlab.py#method:ContactMixin.span_cover","issues":null},"source":{"end_line":906,"file":"hold-code/poselab_mcp/blender/contactlab.py","kind":"method","language":"python","lines":[{"line":878,"text":"    def span_cover(self, cp, mark, regions):\r"},{"line":879,"text":"        \"\"\"The share of the run's surface the hand covers, over the stretch of the run the hand spans (along its\r"},{"line":880,"text":"        axis, between the hand's palm and digit skin), not the whole run: a long handle is not held less for being\r"},{"line":881,"text":"        long. regions: the run's region names. Returns the share.\"\"\"\r"},{"line":882,"text":"        run = self._object[\"parts\"][mark[\"part\"]][\"runs\"][mark.get(\"run\", 0)]\r"},{"line":883,"text":"        RW = self._run_world(run)\r"},{"line":884,"text":"        ax = np.array(list(RW[\"axis\"]))\r"},{"line":885,"text":"        o = np.array(list(RW[\"inner\"]))\r"},{"line":886,"text":"        P, idx, lab = cp[\"_P\"], cp[\"_idx\"], cp[\"_lab\"]\r"},{"line":887,"text":"        hand = [int(i) for i, l_ in zip(idx, lab) if l_ != \"forearm\"]\r"},{"line":888,"text":"        if not hand:\r"},{"line":889,"text":"            return 0.0\r"},{"line":890,"text":"        h = (P[hand] - o) @ ax\r"},{"line":891,"text":"        # the hand's span along the run: where its skin lies within 3 cm of the run's line\r"},{"line":892,"text":"        radv = (P[hand] - o) - np.outer(h, ax)\r"},{"line":893,"text":"        near = np.linalg.norm(radv, axis=1) <= 0.03 + max(s_[\"diameter_cm\"] for s_ in run[\"sections\"]) / 200.0\r"},{"line":894,"text":"        if not near.any():\r"},{"line":895,"text":"            return 0.0\r"},{"line":896,"text":"        t0, t1 = float(h[near].min()), float(h[near].max())\r"},{"line":897,"text":"        SW, SL = self._object_now()[2:4]\r"},{"line":898,"text":"        want = set(regions)\r"},{"line":899,"text":"        hs = (SW - o) @ ax\r"},{"line":900,"text":"        tot = hit = 0\r"},{"line":901,"text":"        tch = cp.get(\"_touched\", set())\r"},{"line":902,"text":"        for k in np.nonzero((hs >= t0) & (hs <= t1))[0]:\r"},{"line":903,"text":"            if SL[k] in want:\r"},{"line":904,"text":"                tot += 1\r"},{"line":905,"text":"                hit += 1 if int(k) in tch else 0\r"},{"line":906,"text":"        return round(hit / float(max(1, tot)), 3)\r"}],"name":"span_cover","start_line":878,"symbol_id":"hold-code/poselab_mcp/blender/contactlab.py#method:ContactMixin.span_cover"}}
