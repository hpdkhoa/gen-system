{"flow":{"kind":"var","name":"DENSITY","noCFG":true,"reason":"DENSITY is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":61,"file":"hold-code/weaponlab/blueprint/check.py","kind":"var","language":"python","lines":[{"line":21,"text":"DENSITY = {\"steel\": 7.85, \"blued\": 7.85, \"parkerized\": 7.85, \"phosphate\": 7.85, \"stainless\": 8.0, \"nickel\": 8.4,\r"},{"line":22,"text":"           \"aluminium\": 2.7, \"aluminum\": 2.7, \"anodized\": 2.7, \"brass\": 8.5, \"walnut\": 0.65, \"wood\": 0.65,\r"},{"line":23,"text":"           \"plastic\": 1.3, \"bakelite\": 1.3, \"polymer\": 1.2, \"rubber\": 1.1}\r"},{"line":24,"text":"PASS = {\"iou\": 0.95, \"gap_mean_cm\": 0.15, \"length_share\": 0.01}\r"},{"line":25,"text":"\r"},{"line":26,"text":"\r"},{"line":27,"text":"def silhouette(bp, include=None):\r"},{"line":28,"text":"    \"\"\"Every part's side outline as polygons in (y, z) cm: an extrude's outline, a lathe's profile mirrored about\r"},{"line":29,"text":"    its axis.\"\"\"\r"},{"line":30,"text":"    polys = []\r"},{"line":31,"text":"    for pid, p in bp[\"parts\"].items():\r"},{"line":32,"text":"        if include and pid not in include:\r"},{"line":33,"text":"            continue\r"},{"line":34,"text":"        sh = p[\"shape\"]\r"},{"line":35,"text":"        if sh[\"kind\"] == \"extrude\":\r"},{"line":36,"text":"            polys.append(sh[\"outline\"])\r"},{"line":37,"text":"        elif sh[\"kind\"] == \"views\":\r"},{"line":38,"text":"            polys.append(sh[\"side\"])\r"},{"line":39,"text":"        else:\r"},{"line":40,"text":"            z0 = sh[\"axis\"][1]\r"},{"line":41,"text":"            top = [[y, z0 + r] for y, r in sh[\"profile\"]]\r"},{"line":42,"text":"            bot = [[y, z0 - r] for y, r in reversed(sh[\"profile\"])]\r"},{"line":43,"text":"            polys.append(top + bot)\r"},{"line":44,"text":"    return polys\r"},{"line":45,"text":"\r"},{"line":46,"text":"\r"},{"line":47,"text":"def _raster(polys, holes, bounds, res):\r"},{"line":48,"text":"    import cv2\r"},{"line":49,"text":"    import numpy as np\r"},{"line":50,"text":"    (y0, y1), (z0, z1) = bounds\r"},{"line":51,"text":"    w, h = int((y1 - y0) / res) + 3, int((z1 - z0) / res) + 3\r"},{"line":52,"text":"    m = np.zeros((h, w), np.uint8)\r"},{"line":53,"text":"    to = lambda poly: np.array([[(y - y0) / res + 1, (z1 - z) / res + 1] for y, z in poly], dtype=np.int32)   # noqa: E731\r"},{"line":54,"text":"    for p in polys:\r"},{"line":55,"text":"        cv2.fillPoly(m, [to(p)], 255)\r"},{"line":56,"text":"    for p in holes:\r"},{"line":57,"text":"        cv2.fillPoly(m, [to(p)], 0)\r"},{"line":58,"text":"    return m\r"},{"line":59,"text":"\r"},{"line":60,"text":"\r"},{"line":61,"text":"def _holes(bp):\r"}],"name":"DENSITY","start_line":21,"symbol_id":"hold-code/weaponlab/blueprint/check.py#var:DENSITY"}}
