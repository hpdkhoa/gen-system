a a, b, t: g(a, t, b)        # noqa: E731\r"},{"line":116,"text":"    else:\r"},{"line":117,"text":"        put = lambda a, b, t: g(b, a, t)        # noqa: E731\r"},{"line":118,"text":"    me = bpy.data.meshes.new(name)\r"},{"line":119,"text":"    bm = bmesh.new()\r"},{"line":120,"text":"    a = [bm.verts.new(put(u, v, lo)) for u, v in pts]\r"},{"line":121,"text":"    b = [bm.verts.new(put(u, v, hi)) for u, v in pts]\r"},{"line":122,"text":"    n = len(pts)\r"},{"line":123,"text":"    bm.faces.new(list(reversed(a)))\r"},{"line":124,"text":"    bm.faces.new(b)\r"},{"line":125,"text":"    for i in range(n):\r"},{"line":126,"text":"        j = (i + 1) % n\r"},{"line":127,"text":"        bm.faces.new([a[i], a[j], b[j], b[i]])\r"},{"line":128,"text":"    bmesh.ops.recalc_face_normals(bm, faces=bm.faces)\r"},{"line":129,"text":"    bm.to_mesh(me)\r"},{"line":130,"text":"    bm.free()\r"},{"line":131,"text":"    ob = bpy.data.objects.new(name, me)\r"},{"line":132,"text":"    bpy.context.scene.collection.objects.link(ob)\r"},{"line":133,"text":"    return ob\r"}],"name":"prism_along","start_line":111,"symbol_id":"hold-code/weaponlab/blueprint/blender/blueprint_build.py#func:prism_along"}}
