eds":[93,98],"stmts":null,"succs":[95,96]},{"cond":"m == 0","id":95,"label":"loop_body","preds":[94],"stmts":null,"succs":[97,98]},{"id":96,"label":"loop_exit","lines":[{"kind":"return","line":3308,"text":"return {\"all_met\": all(r[0] for r in best[2]), \"best\": {n: round(v, 2) for n, v in zip(names, best[1])},"}],"preds":[94],"stmts":["return"],"succs":null},{"id":97,"label":"then","preds":[95],"stmts":null,"succs":[98]},{"id":98,"label":"merge","preds":[97,95],"stmts":null,"succs":[94]}],"effects":["unknown"],"entry":0,"exits":[6,20,22,26,96],"func_id":"hold-code/poselab_mcp/blender/lab.py#func:solve","issues":null},"source":{"end_line":3311,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"func","language":"python","lines":[{"line":3243,"text":"    def solve(self, dofs, goals, keep_hands=(\"l\", \"r\"), pivot=\"stock\", samples=120, maximize=None, seed=1):\r"},{"line":3244,"text":"        \"\"\"Searches rifle moves (dofs: roll, swing, pitch, right, forward, up -> [min, max]) from the current pose for\r"},{"line":3245,"text":"        one that meets every goal; reports each goal at the best and how often any sample met it (never met: a fact\r"},{"line":3246,"text":"        of the geometry, not a tuning miss). Leaves the scene at the best.\"\"\"\r"},{"line":3247,"text":"        self._need()\r"},{"line":3248,"text":"        known = (\"roll\", \"swing\", \"pitch\", \"right\", \"forward\", \"up\")\r"},{"line":3249,"text":"        names = list(dofs)\r"},{"line":3250,"text":"        if not names or any(k not in known for k in names):\r"},{"line":3251,"text":"            raise ValueError(\"dofs: name -> [min, max] for roll, swing, pitch, right, forward, up; got %s\" % \", \".join(map(str, names)))\r"},{"line":3252,"text":"        for k in names:\r"},{"line":3253,"text":"            r = dofs[k]\r"},{"line":3254,"text":"            if not isinstance(r, (list, tuple)) or len(r) != 2 or not all(isinstance(c, (int, float)) for c in r) or r[0] > r[1]:\r"},{"line":3255,"text":"                raise ValueError(\"dofs[%r] must be [min, max] with min <= max, got %r\" % (k, r))\r"},{"line":3256,"text":"        if samples < 1:\r"},{"line":3257,"text":"            raise ValueError(\"samples must be 1 or more\")\r"},{"line":3258,"text":"        if maximize is not None and not 0 <= maximize < len(goals):\r"},{"line":3259,"text":"            raise ValueError(\"maximize must be a goal's index, 0 to %d\" % (len(goals) - 1))\r"},{"line":3260,"text":"        for g in goals:\r"},{"line":3261,"text":"            self._need_keys(g)\r"},{"line":3262,"text":"        self.snapshot(\"save\", \"_solve_base\")\r"},{"line":3263,"text":"        rng = random.Random(seed)\r"},{"line":3264,"text":"        met_count = [0] * len(goals)\r"},{"line":3265,"text":"        all_count = 0\r"},{"line":3266,"text":"\r"},{"line":3267,"text":"        def evaluate(x):\r"},{"line":3268,"text":"            self.snapshot(\"load\", \"_solve_base\")\r"},{"line":3269,"text":"            self.move_gun(pivot=pivot, keep_hands=tuple(keep_hands), **dict(zip(names, x)))\r"},{"line":3270,"text":"            res = [self._goal(g) for g in goals]\r"},{"line":3271,"text":"            short = sum(r[2] for r in res)\r"},{"line":3272,"text":"            bonus = res[maximize][1] if maximize is not None and short == 0 else 0.0\r"},{"line":3273,"text":"            return short * 10.0 - bonus, res\r"},{"line":3274,"text":"\r"},{"line":3275,"text":"        lo = [float(dofs[n][0]) for n in names]\r"},{"line":3276,"text":"        hi = [float(dofs[n][1]) for n in names]\r"},{"line":3277,"text":"        tried, pool = 0, []\r"},{"line":3278,"text":"        for i in range(samples):\r"},{"line":3279,"text":"            x = [0.0 if (i == 0 and l <= 0.0 <= h) else rng.uniform(l, h) for l, h in zip(lo, hi)]\r"},{"line":3280,"text":"            score, res = evaluate(x)\r"},{"line":3281,"text":"            tried += 1\r"},{"line":3282,"text":"            for k, r in enumerate(res):\r"},{"line":3283,"text":"                met_count[k] += 1 if r[0] else 0\r"},{"line":3284,"text":"            all_count += 1 if all(r[0] for r in res) else 0\r"},{"line":3285,"text":"            pool.append((score, x, res))\r"},{"line":3286,"text":"        # a pattern search from each of the six best samples (goals met in different corners rarely meet in one)\r"},{"line":3287,"text":"        best = None\r"},{"line":3288,"text":"        for start in sorted(pool, key=lambda p: p[0])[:6]:\r"},{"line":3289,"text":"            cur = start\r"},{"line":3290,"text":"            step = [(h - l) / 8.0 for l, h in zip(lo, hi)]\r"},{"line":3291,"text":"            for _ in range(4):\r"},{"line":3292,"text":"                improved = True\r"},{"line":3293,"text":"                while improved:\r"},{"line":3294,"text":"                    improved = False\r"},{"line":3295,"text":"                    for k in range(len(names)):\r"},{"line":3296,"text":"                        for sgn in (1, -1):\r"},{"line":3297,"text":"                            x = list(cur[1])\r"},{"line":3298,"text":"                            x[k] = min(hi[k], max(lo[k], x[k] + sgn * step[k]))\r"},{"line":3299,"text":"                            score, res = evaluate(x)\r"},{"line":3300,"text":"                            tried += 1\r"},{"line":3301,"text":"                            if score < cur[0] - 1e-6:\r"},{"line":3302,"text":"                                cur, improved = (score, x, res), True\r"},{"line":3303,"text":"                step = [s_ / 2.0 for s_ in step]\r"},{"line":3304,"text":"            if best is None or cur[0] < best[0]:\r"},{"line":3305,"text":"                best = cur\r"},{"line":3306,"text":"        self.snapshot(\"load\", \"_solve_base\")\r"},{"line":3307,"text":"        self.move_gun(pivot=pivot, keep_hands=tuple(keep_hands), **dict(zip(names, best[1])))\r"},{"line":3308,"text":"        return {\"all_met\": all(r[0] for r in best[2]), \"best\": {n: round(v, 2) for n, v in zip(names, best[1])},\r"},{"line":3309,"text":"                \"goals\": [{\"goal\": g, \"met\": bool(r[0]), \"value\": r[1], \"met_in_samples\": \"%d of %d\" % (m, samples)}\r"},{"line":3310,"text":"                          for g, r, m in zip(goals, best[2], met_count)],\r"},{"line":3311,"text":"                \"evaluations\": tried, \"all_met_in_samples\": \"%d of %d\" % (all_count, samples), \"never_met\": [g for g, m in zip(goals, met_count) if m == 0]}\r"}],"name":"solve","start_line":3243,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:solve"}}
