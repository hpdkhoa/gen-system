oad\", \"_solve_base\")"},{"kind":"call","line":3307,"text":"self.move_gun(pivot=pivot, keep_hands=tuple(keep_hands), **dict(zip(names, best[1])))"},{"kind":"call","line":3308,"text":"return {\"all_met\": all(r[0] for r in best[2]), \"best\": {n: round(v, 2) for n, v in zip(names, best[1])},"}],"preds":[58],"stmts":["call self.snapshot","call self.move_gun","call tuple","call dict","call zip","call all"],"succs":[85]},{"cond":"for (l, h) in zip(lo, hi)","id":61,"label":"loop_header","preds":[59,62],"stmts":null,"succs":[62,63]},{"id":62,"label":"loop_body","preds":[61],"stmts":null,"succs":[61]},{"id":63,"label":"loop_exit","lines":[{"kind":"call","line":3291,"text":"for _ in range(4):"}],"preds":[61],"stmts":["call range"],"succs":[64]},{"cond":"for _ in range(4)","id":64,"label":"loop_header","preds":[63,80],"stmts":null,"succs":[65,66]},{"id":65,"label":"loop_body","preds":[64],"stmts":null,"succs":[67]},{"cond":"best is None","id":66,"label":"loop_exit","preds":[64],"stmts":null,"succs":[81,82]},{"cond":"improved","id":67,"label":"loop_header","preds":[65,72],"stmts":null,"succs":[68,69]},{"id":68,"label":"loop_body","lines":[{"kind":"call","line":3295,"text":"for k in range(len(names)):"}],"preds":[67],"stmts":["call range","call len"],"succs":[70]},{"id":69,"label":"loop_exit","preds":[67],"stmts":null,"succs":[78]},{"cond":"for k in range(len(names))","id":70,"label":"loop_header","preds":[68,75],"stmts":null,"succs":[71,72]},{"id":71,"label":"loop_body","preds":[70],"stmts":null,"succs":[73]},{"id":72,"label":"loop_exit","preds":[70],"stmts":null,"succs":[67]},{"cond":"for sgn in (1, -1)","id":73,"label":"loop_header","preds":[71,77],"stmts":null,"succs":[74,75]},{"cond":"score < cur[0] - 1e-06","id":74,"label":"loop_body","lines":[{"kind":"call","line":3297,"text":"x = list(cur[1])"},{"kind":"call","line":3298,"text":"x[k] = min(hi[k], max(lo[k], x[k] + sgn * step[k]))"},{"kind":"call","line":3299,"text":"score, res = evaluate(x)"}],"preds":[73],"stmts":["c