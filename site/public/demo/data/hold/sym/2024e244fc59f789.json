{"flow":{"kind":"var","name":"DEFAULTS","noCFG":true,"reason":"DEFAULTS is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":65,"file":"hold-code/weaponlab/config.py","kind":"var","language":"python","lines":[{"line":25,"text":"DEFAULTS = {\"data\": \"weaponlab/data\", \"specs\": \"weaponlab/specs\", \"work\": \"weaponlab/work\",\r"},{"line":26,"text":"            \"probe\": {\"command\": [], \"timeout_s\": 1800, \"busy\": [], \"refuse\": [], \"wait_s\": 0, \"warmup\": True,\r"},{"line":27,"text":"                      \"low_priority\": False, \"job_extra\": {}},\r"},{"line":28,"text":"            \"providers\": {}, \"blender\": None}\r"},{"line":29,"text":"\r"},{"line":30,"text":"\r"},{"line":31,"text":"class Project:\r"},{"line":32,"text":"    def __init__(self, root=None):\r"},{"line":33,"text":"        self.root = Path(root or os.environ.get(\"WEAPONLAB_PROJECT\") or os.getcwd()).resolve()\r"},{"line":34,"text":"        cfg = self.root / \"weaponlab.json\"\r"},{"line":35,"text":"        raw = json.loads(cfg.read_text(encoding=\"utf-8-sig\")) if cfg.exists() else {}\r"},{"line":36,"text":"        self.config = {**DEFAULTS, **raw, \"probe\": {**DEFAULTS[\"probe\"], **raw.get(\"probe\", {})}}\r"},{"line":37,"text":"        self.has_config = cfg.exists()\r"},{"line":38,"text":"\r"},{"line":39,"text":"    def _dir(self, key):\r"},{"line":40,"text":"        p = Path(self.config[key])\r"},{"line":41,"text":"        return p if p.is_absolute() else self.root / p\r"},{"line":42,"text":"\r"},{"line":43,"text":"    @property\r"},{"line":44,"text":"    def data(self):\r"},{"line":45,"text":"        return self._dir(\"data\")\r"},{"line":46,"text":"\r"},{"line":47,"text":"    @property\r"},{"line":48,"text":"    def specs(self):\r"},{"line":49,"text":"        return self._dir(\"specs\")\r"},{"line":50,"text":"\r"},{"line":51,"text":"    @property\r"},{"line":52,"text":"    def work(self):\r"},{"line":53,"text":"        return self._dir(\"work\")\r"},{"line":54,"text":"\r"},{"line":55,"text":"    def ensure(self, *parts):\r"},{"line":56,"text":"        p = self.work.joinpath(*parts)\r"},{"line":57,"text":"        p.mkdir(parents=True, exist_ok=True)\r"},{"line":58,"text":"        return p\r"},{"line":59,"text":"\r"},{"line":60,"text":"    @property\r"},{"line":61,"text":"    def probe(self):\r"},{"line":62,"text":"        return self.config[\"probe\"]\r"},{"line":63,"text":"\r"},{"line":64,"text":"    @property\r"},{"line":65,"text":"    def providers(self):\r"}],"name":"DEFAULTS","start_line":25,"symbol_id":"hold-code/weaponlab/config.py#var:DEFAULTS"}}
