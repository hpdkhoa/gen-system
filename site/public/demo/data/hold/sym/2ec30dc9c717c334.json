nown"],"entry":0,"exits":[21],"func_id":"hold-code/weaponlab/gunkit/timeline.py#func:point","issues":null},"source":{"end_line":160,"file":"hold-code/weaponlab/gunkit/timeline.py","kind":"func","language":"python","lines":[{"line":138,"text":"def point(facts, values, mark, part=None):\r"},{"line":139,"text":"    \"\"\"A mark's place in gun space with the parts as they are: it rides its part (slide or turn), or its parts in order\r"},{"line":140,"text":"    (a bolt knob: the bolt's lift turns it, then the bolt's draw slides it), when it has them.\"\"\"\r"},{"line":141,"text":"    roles = facts.get(\"mark_parts\", {}).get(mark) if part is None else part\r"},{"line":142,"text":"    roles = [roles] if isinstance(roles, str) else list(roles or [])\r"},{"line":143,"text":"    if part is not None and isinstance(part, str):\r"},{"line":144,"text":"        # a target that names one part rides the mark's own chain when that part is in it\r"},{"line":145,"text":"        own = facts.get(\"mark_parts\", {}).get(mark)\r"},{"line":146,"text":"        own = [own] if isinstance(own, str) else list(own or [])\r"},{"line":147,"text":"        if part in own:\r"},{"line":148,"text":"            roles = own\r"},{"line":149,"text":"    at = list(facts[\"marks\"][mark])\r"},{"line":150,"text":"    for role in roles:\r"},{"line":151,"text":"        if role not in facts[\"parts\"]:\r"},{"line":152,"text":"            continue\r"},{"line":153,"text":"        p, v = facts[\"parts\"][role], values.get(role, 0.0)\r"},{"line":154,"text":"        if p[\"kind\"] == \"slide\":\r"},{"line":155,"text":"            at = _add(at, _scale(p[\"axis\"], p[\"travel_cm\"] * v))\r"},{"line":156,"text":"        elif p[\"kind\"] == \"turn\":\r"},{"line":157,"text":"            at = _rot(at, p[\"pivot\"], p[\"axis\"], p[\"turn_deg\"] * v)\r"},{"line":158,"text":"        elif isinstance(v, list):\r"},{"line":159,"text":"            at = _add(at, v)\r"},{"line":160,"text":"    return at\r"}],"name":"point","start_line":138,"symbol_id":"hold-code/weaponlab/gunkit/timeline.py#func:point"}}
