{"flow":{"kind":"var","name":"off","noCFG":true,"reason":"off is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":39,"file":"hold-code/weaponlab/gunkit/blender/gunkit_skin.py","kind":"var","language":"python","lines":[{"line":18,"text":"off = float(job[\"offset_cm\"]) / 100.0\r"},{"line":19,"text":"below = float(job[\"below_z_cm\"]) / 100.0\r"},{"line":20,"text":"bone = job.get(\"part_bone\", \"Root\")\r"},{"line":21,"text":"moved = 0\r"},{"line":22,"text":"mesh = me.data\r"},{"line":23,"text":"for v in mesh.vertices:\r"},{"line":24,"text":"    gm = max(v.groups, key=lambda x: x.weight) if v.groups else None\r"},{"line":25,"text":"    if (names.get(gm.group) if gm else \"Root\") != bone:\r"},{"line":26,"text":"        continue\r"},{"line":27,"text":"    p = (Ai @ (me.matrix_world @ v.co)) * k_          # the armature's own frame, metres\r"},{"line":28,"text":"    if p.z > below:\r"},{"line":29,"text":"        continue\r"},{"line":30,"text":"    v.co = v.co + v.normal * (off / max(1e-9, me.matrix_world.to_scale()[0]))\r"},{"line":31,"text":"    moved += 1\r"},{"line":32,"text":"bpy.ops.object.select_all(action=\"DESELECT\")\r"},{"line":33,"text":"arm.select_set(True)\r"},{"line":34,"text":"me.select_set(True)\r"},{"line":35,"text":"bpy.context.view_layer.objects.active = arm\r"},{"line":36,"text":"bpy.ops.export_scene.fbx(filepath=job[\"out_fbx\"], use_selection=True, object_types={\"ARMATURE\", \"MESH\"},\r"},{"line":37,"text":"                         add_leaf_bones=False, bake_anim=False)\r"},{"line":38,"text":"print(\"GUNKIT \" + json.dumps({\"moved\": moved, \"out\": job[\"out_fbx\"]}))\r"},{"line":39,"text":""}],"name":"off","start_line":18,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_skin.py#var:off"}}
