{"flow":{"kind":"var","name":"mid","noCFG":true,"reason":"mid is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":94,"file":"hold-code/weaponlab/blueprint/blender/blueprint_showcase.py","kind":"var","language":"python","lines":[{"line":54,"text":"mid = (lo + hi) / 2.0\r"},{"line":55,"text":"R = (hi - lo).length\r"},{"line":56,"text":"cam_data = bpy.data.cameras.new(\"ShowCam\")\r"},{"line":57,"text":"cam_data.lens = 70\r"},{"line":58,"text":"cam = bpy.data.objects.new(\"ShowCam\", cam_data)\r"},{"line":59,"text":"sc.collection.objects.link(cam)\r"},{"line":60,"text":"sc.camera = cam\r"},{"line":61,"text":"DIST = R * 2.15\r"},{"line":62,"text":"\r"},{"line":63,"text":"\r"},{"line":64,"text":"def aim(az_deg, el_deg, dist=DIST, look=None):\r"},{"line":65,"text":"    \"\"\"The camera round the gun: azimuth 0 looks at its left side (Blender +X), 180 its right; the muzzle is -Y.\"\"\"\r"},{"line":66,"text":"    a, e = math.radians(az_deg), math.radians(el_deg)\r"},{"line":67,"text":"    look = look or mid\r"},{"line":68,"text":"    cam.location = look + Vector((math.cos(a) * math.cos(e), math.sin(a) * math.cos(e), math.sin(e))) * dist\r"},{"line":69,"text":"    cam.rotation_euler = (look - cam.location).normalized().to_track_quat('-Z', 'Y').to_euler()\r"},{"line":70,"text":"\r"},{"line":71,"text":"\r"},{"line":72,"text":"VIEWS = {\"right\": (205, 14), \"left\": (-25, 14), \"top_right\": (215, 38), \"right_close\": (195, 8)}\r"},{"line":73,"text":"n = 0\r"},{"line":74,"text":"report = {\"shots\": []}\r"},{"line":75,"text":"\r"},{"line":76,"text":"\r"},{"line":77,"text":"def shot(name):\r"},{"line":78,"text":"    global n\r"},{"line":79,"text":"    sc.render.filepath = os.path.join(OUT, \"f%05d.png\" % n)\r"},{"line":80,"text":"    bpy.ops.render.render(write_still=True)\r"},{"line":81,"text":"    report[\"shots\"].append({\"frame\": n, \"shot\": name})\r"},{"line":82,"text":"    n += 1\r"},{"line":83,"text":"\r"},{"line":84,"text":"\r"},{"line":85,"text":"# 1. once round\r"},{"line":86,"text":"arm.animation_data.action = None\r"},{"line":87,"text":"for k in range(job.get(\"turn_frames\", 60)):\r"},{"line":88,"text":"    aim(-25 + 360.0 * k / job.get(\"turn_frames\", 60), 14)\r"},{"line":89,"text":"    shot(\"turn\")\r"},{"line":90,"text":"# 2. the clips\r"},{"line":91,"text":"for c in job.get(\"clips\", []):\r"},{"line":92,"text":"    act = bpy.data.actions.get(c[\"action\"])\r"},{"line":93,"text":"    if act is None:\r"},{"line":94,"text":"        print(\"SHOWCASE: no action %s\" % c[\"action\"])\r"}],"name":"mid","start_line":54,"symbol_id":"hold-code/weaponlab/blueprint/blender/blueprint_showcase.py#var:mid"}}
