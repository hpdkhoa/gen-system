ils. Returns per hand its results and pass, and pass.\"\"\"\r"},{"line":1400,"text":"        out, ok = {}, True\r"},{"line":1401,"text":"        for side in sides:\r"},{"line":1402,"text":"            if not any(m.get(\"role\") == \"hold\" and m.get(\"hand\", side) == side for m in marks):\r"},{"line":1403,"text":"                continue\r"},{"line":1404,"text":"            res = self.hold_purposes(side, marks, glove_cm, other=other)\r"},{"line":1405,"text":"            FL = self._limits()[1]\r"},{"line":1406,"text":"            TL = self._thumb_limits()\r"},{"line":1407,"text":"            body = self._finger_report(side, FL)[1] + self._thumb_report(side, TL)[1]\r"},{"line":1408,"text":"            pr = next((r for r in res if r[\"purpose\"] == \"press\"), {})\r"},{"line":1409,"text":"            rec = {\"purposes\": res, \"body_rules\": body, \"press\": round(pr.get(\"object_cm2\", 0.0) + pr.get(\"hand_cm2\", 0.0), 3)}\r"},{"line":1410,"text":"            rec[\"pass\"] = all(r[\"met\"] for r in res) and not body\r"},{"line":1411,"text":"            out[side] = rec\r"},{"line":1412,"text":"            ok = ok and rec[\"pass\"]\r"},{"line":1413,"text":"        out[\"pass\"] = ok                               # the presses are the drawn skin's already (the contact model)\r"},{"line":1414,"text":"        return out\r"}],"name":"hold_gate","start_line":1396,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#func:hold_gate"}}
