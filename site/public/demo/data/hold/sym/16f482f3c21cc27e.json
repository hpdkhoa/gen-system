\": [1.2]}, staging=staging, parts=folder)\r"},{"line":277,"text":"    rows = []\r"},{"line":278,"text":"    for w in want:\r"},{"line":279,"text":"        obj = folder / C.parts_name(w, \"idle\", 1.2)\r"},{"line":280,"text":"        if not obj.exists():\r"},{"line":281,"text":"            continue\r"},{"line":282,"text":"        if S.path_of(w).exists() and S.read_spec(w).get(\"anchors\"):\r"},{"line":283,"text":"            f = facts(w, obj)\r"},{"line":284,"text":"            rows += [{\"weapon\": w, \"action\": \"idle\", \"metric\": \"facts.false\", \"value\": f[\"facts.false\"], \"note\": \"; \".join(f[\"notes\"])},\r"},{"line":285,"text":"                     {\"weapon\": w, \"action\": \"idle\", \"metric\": \"parts.duplicates\", \"value\": f[\"parts.duplicates\"]}]\r"},{"line":286,"text":"        if kinds.get(w) == \"Melee\":\r"},{"line":287,"text":"            m = fist(obj)\r"},{"line":288,"text":"            if m:\r"},{"line":289,"text":"                rows += [{\"weapon\": w, \"action\": \"idle\", \"metric\": \"fist.offset_cm\", \"value\": m[\"offset_cm\"]},\r"},{"line":290,"text":"                         {\"weapon\": w, \"action\": \"idle\", \"metric\": \"fist.angle_deg\", \"value\": m[\"angle_deg\"]}]\r"},{"line":291,"text":"    return rows\r"}],"name":"measure","start_line":266,"symbol_id":"hold-code/weaponlab/rig.py#func:measure"}}
