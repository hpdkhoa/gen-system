"language":"python","lines":[{"line":266,"text":"def measure(weapon_ids, actions=None, staging=None):\r"},{"line":267,"text":"    \"\"\"Rows from fresh idle dumps: facts.false and parts.duplicates for each weapon with anchors in its spec,\r"},{"line":268,"text":"    fist.offset_cm and fist.angle_deg for each melee weapon held by hands, align.* for each spec with align.\"\"\"\r"},{"line":269,"text":"    from . import gate as G\r"},{"line":270,"text":"    from . import probe as P\r"},{"line":271,"text":"    kinds = {w[\"id\"]: w.get(\"kind\") for w in G.weapons()}\r"},{"line":272,"text":"    want = [w for w in weapon_ids if kinds.get(w) == \"Melee\" or S.path_of(w).exists()]\r"},{"line":273,"text":"    if not want:\r"},{"line":274,"text":"        return []\r"},{"line":275,"text":"    folder = project().ensure(\"rig\", \"dumps\", __import__(\"time\").strftime(\"%Y%m%d-%H%M%S\"))\r"},{"line":276,"text":"    P.run(want, [\"idle\"], at={\"idle\": [1.2]}, staging=staging, parts=folder)\r"},{"line":277,"text":"    rows = []\r"},{"line":278,"text":"    for w in want:\r"},{"line":279,"text":"        obj = folder / C.parts_name(w, \"idle\", 1.2)\r"},{"line":280,"text":"        if not obj.exists():\r"},{"line":281,"text":"            continue\r"},{"line":282,"text":"        if S.path_of(w).exists() and S.read_spec(w).get(\"anchors\"):\r"},{"line":283,"text":"            f = facts(w, obj)\r"},{"line":284,"text":"            rows += [{\"weapon\": w, \"action\": \"idle\", \"metric\": \"facts.false\", \"value\": f[\"facts.false\"], \"note\": \"; \".join(f[\"notes\"])},\r"},{"line":285,"text":"                     {\"weapon\": w, \"action\": \"idle\", \"metric\": \"parts.duplicates\", \"value\": f[\"parts.duplicates\"]}]\r"},{"line":286,"text":"        if kinds.get(w) == \"Melee\":\r"},{"line":287,"text":"            m = fist(obj)\r"},{"line":288,"text":"            if m:\r"},{"line":289,"text":"                rows += [{\"weapon\": w, \"action\": \"idle\", \"metric\": \"fist.offset_cm\", \"value\": m[\"offset_cm\"]},\r"},{"line":290,"text":"                         {\"weapon\": w, \"action\": \"idle\", \"metric\": \"fist.angle_deg\", \"value\": m[\"angle_deg\"]}]\r"},{"line":291,"text":"    return rows\r"}],"name":"measure","start_line":266,"symbol_id":"hold-code/weaponlab/rig.py#func:measure"}}
