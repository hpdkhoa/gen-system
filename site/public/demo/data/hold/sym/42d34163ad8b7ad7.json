s":["unknown"],"entry":0,"exits":[5],"func_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._body_size","issues":null},"source":{"end_line":2595,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"method","language":"python","lines":[{"line":2518,"text":"    def _body_size(self, side, ranges):\r"},{"line":2519,"text":"        pts = self._skin_points()\r"},{"line":2520,"text":"        sides = (\"l\", \"r\") if side == \"both\" else (side,)\r"},{"line":2521,"text":"        out = {\"ok\": True}\r"},{"line":2522,"text":"        for s_ in sides:\r"},{"line":2523,"text":"            B = lambda n: self._bw(n).translation     # noqa: E731\r"},{"line":2524,"text":"            S, E, W = B(self._n(\"upperarm\", s_)), B(self._n(\"lowerarm\", s_)), B(self._n(\"hand\", s_))\r"},{"line":2525,"text":"            K = B(self._n(\"finger\", s_, \"middle\", \"01\"))\r"},{"line":2526,"text":"            I, Pk = B(self._n(\"finger\", s_, \"index\", \"01\")), B(self._n(\"finger\", s_, \"pinky\", \"01\"))\r"},{"line":2527,"text":"            along = (K - W).normalized()\r"},{"line":2528,"text":"            across = (I - Pk) - along * (I - Pk).dot(along)\r"},{"line":2529,"text":"            across.normalize()\r"},{"line":2530,"text":"            nrm = across.cross(along).normalized()\r"},{"line":2531,"text":"            suf = \"_\" + s_\r"},{"line":2532,"text":"            mine = [(p, g) for p, g in pts if g.endswith(suf)]\r"},{"line":2533,"text":"            arm = [p for p, g in mine if g.startswith(\"lowerarm\") or g.startswith(\"hand\")]\r"},{"line":2534,"text":"            handv = [(p, g) for p, g in mine if g.startswith(\"hand\") or \"metacarpal\" in g or\r"},{"line":2535,"text":"                     any(g.startswith(f) for f in (\"index\", \"middle\", \"ring\", \"pinky\"))]\r"},{"line":2536,"text":"            m = {\"upper_arm_cm\": round((E - S).length * 100, 2), \"forearm_cm\": round((W - E).length * 100, 2)}\r"},{"line":2537,"text":"            mid = [p for p, g in mine if g.startswith(\"middle\")]\r"},{"line":2538,"text":"            m[\"hand_length_cm\"] = round(max(((p - W).dot(along) for p in mid), default=0.0) * 100, 2)\r"},{"line":2539,"text":"            m[\"palm_cm\"] = round((K - W).length * 100, 2)\r"},{"line":2540,"text":"            m[\"finger_cm\"] = round(max(((p - K).length for p, g in mine if g.startswith(\"middle_02\") or g.startswith(\"middle_03\")), default=0.0) * 100, 2)\r"},{"line":2541,"text":"            # at the knuckles: the hand's own skin within 0.6 cm of the knuckle line, thumb left out\r"},{"line":2542,"text":"            kn = [p for p, g in handv if abs((p - K).dot(along)) < 0.006 and (p - K).length < 0.08]\r"},{"line":2543,"text":"            if kn:\r"},{"line":2544,"text":"                xs = [(p - K).dot(across) for p in kn]\r"},{"line":2545,"text":"                m[\"hand_breadth_cm\"] = round((max(xs) - min(xs)) * 100, 2)\r"},{"line":2546,"text":"                m[\"hand_circumference_cm\"] = round(self._hull_perimeter([((p - K).dot(across), (p - K).dot(nrm)) for p in kn]) * 100, 2)\r"},{"line":2547,"text":"            # the forearm in slices from the elbow to the wrist\r"},{"line":2548,"text":"            d = (W - E).normalized()\r"},{"line":2549,"text":"            u = d.orthogonal().normalized()\r"},{"line":2550,"text":"            v2 = d.cross(u)\r"},{"line":2551,"text":"            girth = []\r"},{"line":2552,"text":"            for k in range(1, 20):\r"},{"line":2553,"text":"                t = k / 20.0\r"},{"line":2554,"text":"                c = E.lerp(W, t)\r"},{"line":2555,"text":"                sl = [p for p in arm if abs((p - c).dot(d)) < 0.005 and ((p - c) - d * (p - c).dot(d)).length < 0.08]\r"},{"line":2556,"text":"                if len(sl) >= 8:\r"},{"line":2557,"text":"                    girth.append((t, self._hull_perimeter([((p - c).dot(u), (p - c).dot(v2)) for p in sl]) * 100))\r"},{"line":2558,"text":"            if girth:\r"},{"line":2559,"text":"                m[\"forearm_circumference_cm\"] = round(max((g for t, g in girth if t <= 0.5), default=0.0), 2)\r"},{"line":2560,"text":"                m[\"wrist_circumference_cm\"] = round(min((g for t, g in girth if t >= 0.8), default=0.0), 2)\r"},{"line":2561,"text":"            # the drawn skin against the capsules clearance tests: the palm's thickness, the forearm's middle, a finger\r"},{"line":2562,"text":"            cap = {}\r"},{"line":2563,"text":"            pm = W.lerp(K, 0.5)\r"},{"line":2564,"text":"            pt = [(p - pm).dot(nrm) for p, g in handv if abs((p - pm).dot(along)) < 0.006 and abs((p - pm).dot(across)) < 0.015]\r"},{"line":2565,"text":"            fit = self._fitted_radii() or {}\r"},{"line":2566,"text":"            if pt:\r"},{"line":2567,"text":"                cap[\"palm\"] = round(((max(pt) - min(pt)) / 2 - fit.get(\"palm\", RADIUS[\"palm\"])) * 100, 2)\r"},{"line":2568,"text":"            c = E.lerp(W, 0.5)\r"},{"line":2569,"text":"            fr = [((p - c) - d * (p - c).dot(d)).length for p in arm if abs((p - c).dot(d)) < 0.005]\r"},{"line":2570,"text":"            if fr:\r"},{"line":2571,"text":"                # the mean radius at the middle (the capsule halves meet there)\r"},{"line":2572,"text":"                rf_ = (fit.get(\"forearm_elbow\", RADIUS[\"forearm\"]) + fit.get(\"forearm_wrist\", RADIUS[\"forearm\"])) / 2\r"},{"line":2573,"text":"                cap[\"forearm\"] = round((self._hull_perimeter([((p - c).dot(u), (p - c).dot(v2)) for p in arm\r"},{"line":2574,"text":"                                                               if abs((p - c).dot(d)) < 0.005]) / (2 * math.pi) - rf_) * 100, 2)\r"},{"line":2575,"text":"            a2, a3 = B(self._n(\"finger\", s_, \"index\", \"02\")), B(self._n(\"finger\", s_, \"index\", \"03\"))\r"},{"line":2576,"text":"            fd = (a3 - a2).normalized()\r"},{"line":2577,"text":"            fc = a2.lerp(a3, 0.5)\r"},{"line":2578,"text":"            fv = [p - fc - fd * (p - fc).dot(fd) for p, g in mine if g.startswith(\"index\") and abs((p - fc).dot(fd)) < 0.003]\r"},{"line":2579,"text":"            if len(fv) >= 6:\r"},{"line":2580,"text":"                uu = fd.orthogonal().normalized()\r"},{"line":2581,"text":"                vv = fd.cross(uu)\r"},{"line":2582,"text":"                cap[\"finger\"] = round((self._hull_perimeter([(r.dot(uu), r.dot(vv)) for r in fv]) / (2 * math.pi)\r"},{"line":2583,"text":"                                       - fit.get(\"finger_index\", RADIUS[\"finger\"])) * 100, 2)\r"},{"line":2584,"text":"            bad = []\r"},{"line":2585,"text":"            for k, val in m.items():\r"},{"line":2586,"text":"                rg = (ranges or {}).get(k)\r"},{"line":2587,"text":"                if rg and not (rg[\"low\"] <= val <= rg[\"high\"]):\r"},{"line":2588,"text":"                    bad.append(\"%s %.1f cm outside the human range %.1f to %.1f (1st to 99th percentile%s)\"\r"},{"line":2589,"text":"                               % (k, val, rg[\"low\"], rg[\"high\"], \", landmark allowance counted\" if rg[\"low\"] != rg.get(\"p1\") or rg[\"high\"] != rg.get(\"p99\") else \"\"))\r"},{"line":2590,"text":"            for k, val in cap.items():\r"},{"line":2591,"text":"                if val > 0.3:\r"},{"line":2592,"text":"                    bad.append(\"the %s's skin lies %.1f cm outside the capsule clearance tests it with: the checks miss clips the picture shows\" % (k, val))\r"},{"line":2593,"text":"            out[s_] = {\"measures\": m, \"skin_vs_capsules_cm\": cap, \"bad\": bad}\r"},{"line":2594,"text":"            out[\"ok\"] = out[\"ok\"] and not bad\r"},{"line":2595,"text":"        return out\r"}],"name":"_body_size","start_line":2518,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._body_size"}}
