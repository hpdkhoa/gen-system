]}],"effects":["unknown"],"entry":0,"exits":[3],"func_id":"hold-code/poselab_mcp/blender/sdflab.py#func:_trilinear","issues":null},"source":{"end_line":46,"file":"hold-code/poselab_mcp/blender/sdflab.py","kind":"func","language":"python","lines":[{"line":28,"text":"def _trilinear(G, idx):\r"},{"line":29,"text":"    \"\"\"G (nx, ny, nz) at fractional cell coordinates idx (m x 3), clamped to the grid.\"\"\"\r"},{"line":30,"text":"    nx, ny, nz = G.shape\r"},{"line":31,"text":"    f = np.clip(idx, 0.0, [nx - 1.001, ny - 1.001, nz - 1.001])\r"},{"line":32,"text":"    i0 = np.floor(f).astype(np.int64)\r"},{"line":33,"text":"    t = f - i0\r"},{"line":34,"text":"    i1 = i0 + 1\r"},{"line":35,"text":"    out = np.zeros(len(f))\r"},{"line":36,"text":"    for dx in (0, 1):\r"},{"line":37,"text":"        wx = t[:, 0] if dx else 1.0 - t[:, 0]\r"},{"line":38,"text":"        ix = i1[:, 0] if dx else i0[:, 0]\r"},{"line":39,"text":"        for dy in (0, 1):\r"},{"line":40,"text":"            wy = t[:, 1] if dy else 1.0 - t[:, 1]\r"},{"line":41,"text":"            iy = i1[:, 1] if dy else i0[:, 1]\r"},{"line":42,"text":"            for dz in (0, 1):\r"},{"line":43,"text":"                wz = t[:, 2] if dz else 1.0 - t[:, 2]\r"},{"line":44,"text":"                iz = i1[:, 2] if dz else i0[:, 2]\r"},{"line":45,"text":"                out += wx * wy * wz * G[ix, iy, iz]\r"},{"line":46,"text":"    return out\r"}],"name":"_trilinear","start_line":28,"symbol_id":"hold-code/poselab_mcp/blender/sdflab.py#func:_trilinear"}}
