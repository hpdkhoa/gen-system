":"deep > allow","id":61,"label":"merge","preds":[60,58],"stmts":null,"succs":[62,63]},{"id":62,"label":"then","preds":[61],"stmts":null,"succs":[63]},{"id":63,"label":"merge","preds":[62,61],"stmts":null,"succs":[59]},{"id":64,"label":"then","preds":[55],"stmts":null,"succs":[65]},{"cond":"bone.startswith(('lowerarm', 'forearm')) or 'twist' in bone","id":65,"label":"merge","preds":[64,55],"stmts":null,"succs":[66,67]},{"id":66,"label":"then","preds":[65],"stmts":null,"succs":[67]},{"id":67,"label":"merge","preds":[66,65],"stmts":null,"succs":[68]},{"cond":"for (oname, oa, ob, orr) in theirs","id":68,"label":"loop_header","preds":[67,74],"stmts":null,"succs":[69,70]},{"cond":"into > worst_o[0]","id":69,"label":"loop_body","lines":[{"kind":"call","line":2058,"text":"into = 2.0 * glove_cm - self._seg_point_cm(oa, ob, orr, p)"}],"preds":[68],"stmts":["call self._seg_point_cm"],"succs":[71,72]},{"id":70,"label":"loop_exit","preds":[68],"stmts":null,"succs":[39]},{"id":71,"label":"then","preds":[69],"stmts":null,"succs":[72]},{"cond":"into > skin_allow_cm","id":72,"label":"merge","preds":[71,69],"stmts":null,"succs":[73,74]},{"id":73,"label":"then","preds":[72],"stmts":null,"succs":[74]},{"id":74,"label":"merge","preds":[73,72],"stmts":null,"succs":[68]},{"id":75,"label":"then","preds":[41],"stmts":null,"succs":[76]},{"id":76,"label":"merge","preds":[75,41],"stmts":null,"succs":[32]}],"effects":["unknown"],"entry":0,"exits":[34],"func_id":"hold-code/poselab_mcp/blender/lab.py#func:skin_presses","issues":null},"source":{"end_line":2070,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"func","language":"python","lines":[{"line":2017,"text":"    def skin_presses(self, side=\"both\", glove_cm=0.0, allow_cm=0.1, palm_allow_cm=0.3, skin_allow_cm=0.5, other=True,\r"},{"line":2018,"text":"                     top=4):\r"},{"line":2019,"text":"        \"\"\"How far the drawn skin goes into the gun and into the other hand: every skin vertex of the forearm, the\r"},{"line":2020,"text":"        hand and its digits (the glove's thickness out along it), measured to the gun's surface (signed: inside is\r"},{"line":2021,"text":"        found by ray parity, not by a nearest corner) and to the other hand's capsules. The capsule checks test a\r"},{"line":2022,"text":"        body slightly thinner than the drawn one; this is the picture's own answer. The palm may press\r"},{"line":2023,"text":"        palm_allow_cm, skin on skin skin_allow_cm (it gives). Returns per side the worst press into the gun and into\r"},{"line":2024,"text":"        the other hand (cm), the part, how many vertices press past their allowance, and ok.\"\"\"\r"},{"line":2025,"text":"        self._need()\r"},{"line":2026,"text":"        tree = self._tree()\r"},{"line":2027,"text":"        g = glove_cm / 100.0\r"},{"line":2028,"text":"        dg = bpy.context.evaluated_depsgraph_get()\r"},{"line":2029,"text":"        M = self.rifle_mesh.matrix_world\r"},{"line":2030,"text":"        corners = [M @ Vector(c) for c in self.rifle_mesh.bound_box]\r"},{"line":2031,"text":"        lo = Vector((min(c.x for c in corners), min(c.y for c in corners), min(c.z for c in corners))) - Vector((0.03,) * 3)\r"},{"line":2032,"text":"        hi = Vector((max(c.x for c in corners), max(c.y for c in corners), max(c.z for c in corners))) + Vector((0.03,) * 3)\r"},{"line":2033,"text":"        sides = (\"l\", \"r\") if side == \"both\" else (side,)\r"},{"line":2034,"text":"        segs = {s_: [x for x in self._segments(s_) if not x[0].startswith(\"forearm\")] for s_ in (\"l\", \"r\")}\r"},{"line":2035,"text":"        out, ok = {}, True\r"},{"line":2036,"text":"        pts = self._skin_points()\r"},{"line":2037,"text":"        for s_ in sides:\r"},{"line":2038,"text":"            suf = \"_\" + s_\r"},{"line":2039,"text":"            hand = self._n(\"hand\", s_)\r"},{"line":2040,"text":"            theirs = segs[\"r\" if s_ == \"l\" else \"l\"] if other else []\r"},{"line":2041,"text":"            worst_g, worst_o, over = (0.0, None), (0.0, None), 0\r"},{"line":2042,"text":"            for p, bone in pts:\r"},{"line":2043,"text":"                if not bone.endswith(suf) or bone.startswith((\"upperarm\", \"clavicle\")):\r"},{"line":2044,"text":"                    continue\r"},{"line":2045,"text":"                part = \"palm\" if bone == hand else bone\r"},{"line":2046,"text":"                allow = palm_allow_cm if part == \"palm\" else allow_cm\r"},{"line":2047,"text":"                if lo.x <= p.x <= hi.x and lo.y <= p.y <= hi.y and lo.z <= p.z <= hi.z:\r"},{"line":2048,"text":"                    _q, d = tree.nearest(p)\r"},{"line":2049,"text":"                    if d is not None and d < g:\r"},{"line":2050,"text":"                        deep = (g - d) * 100.0\r"},{"line":2051,"text":"                        if deep > worst_g[0]:\r"},{"line":2052,"text":"                            worst_g = (deep, part)\r"},{"line":2053,"text":"                        if deep > allow:\r"},{"line":2054,"text":"                            over += 1\r"},{"line":2055,"text":"                if bone.startswith((\"lowerarm\", \"forearm\")) or \"twist\" in bone:\r"},{"line":2056,"text":"                    continue\r"},{"line":2057,"text":"                for oname, oa, ob, orr in theirs:\r"},{"line":2058,"text":"                    into = 2.0 * glove_cm - self._seg_point_cm(oa, ob, orr, p)\r"},{"line":2059,"text":"                    if into > worst_o[0]:\r"},{"line":2060,"text":"                        worst_o = (into, \"%s on %s\" % (part, oname))\r"},{"line":2061,"text":"                    if into > skin_allow_cm:\r"},{"line":2062,"text":"                        over += 1\r"},{"line":2063,"text":"                        break\r"},{"line":2064,"text":"            rec = {\"gun_cm\": round(worst_g[0], 2), \"gun_part\": worst_g[1], \"hand_cm\": round(worst_o[0], 2),\r"},{"line":2065,"text":"                   \"hand_part\": worst_o[1], \"vertices_over\": over}\r"},{"line":2066,"text":"            rec[\"ok\"] = over == 0\r"},{"line":2067,"text":"            ok = ok and rec[\"ok\"]\r"},{"line":2068,"text":"            out[s_] = rec\r"},{"line":2069,"text":"        out[\"ok\"] = ok\r"},{"line":2070,"text":"        return out\r"}],"name":"skin_presses","start_line":2017,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:skin_presses"}}
