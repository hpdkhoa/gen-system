 it\" % \", \".join(playing))\r"},{"line":49,"text":"        busy = [n for n in now if n not in refuse]\r"},{"line":50,"text":"        if not busy:\r"},{"line":51,"text":"            return\r"},{"line":52,"text":"        if time.time() >= end:\r"},{"line":53,"text":"            raise Busy(\"%s running: one heavy job at a time\" % \", \".join(busy))\r"},{"line":54,"text":"        time.sleep(15)\r"}],"name":"guard","start_line":37,"symbol_id":"hold-code/weaponlab/probe.py#func:guard"}}
