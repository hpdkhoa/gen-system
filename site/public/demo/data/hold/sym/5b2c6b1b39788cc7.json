5)"}],"preds":[11],"stmts":["call time.sleep"],"succs":[3]}],"effects":["unknown"],"entry":0,"exits":[8,10,12],"func_id":"hold-code/weaponlab/probe.py#func:guard","issues":null},"source":{"end_line":54,"file":"hold-code/weaponlab/probe.py","kind":"func","language":"python","lines":[{"line":37,"text":"def guard(wait_s=None, allow=False):\r"},{"line":38,"text":"    \"\"\"Fails at once while a \"refuse\" process runs (the player's own game) unless allow; waits up to wait_s (the\r"},{"line":39,"text":"    project's probe.wait_s by default) while a \"busy\" one runs (another heavy job), then raises Busy.\"\"\"\r"},{"line":40,"text":"    cfg = project().probe\r"},{"line":41,"text":"    refuse = set(cfg.get(\"refuse\", []))\r"},{"line":42,"text":"    wait_s = cfg.get(\"wait_s\", 0) if wait_s is None else wait_s\r"},{"line":43,"text":"    end = time.time() + wait_s\r"},{"line":44,"text":"    while True:\r"},{"line":45,"text":"        now = running(set(cfg.get(\"busy\", [])) | refuse)\r"},{"line":46,"text":"        playing = [n for n in now if n in refuse]\r"},{"line":47,"text":"        if playing and not allow:\r"},{"line":48,"text":"            raise Busy(\"%s running: the probe does not run beside it\" % \", \".join(playing))\r"},{"line":49,"text":"        busy = [n for n in now if n not in refuse]\r"},{"line":50,"text":"        if not busy:\r"},{"line":51,"text":"            return\r"},{"line":52,"text":"        if time.time() >= end:\r"},{"line":53,"text":"            raise Busy(\"%s running: one heavy job at a time\" % \", \".join(busy))\r"},{"line":54,"text":"        time.sleep(15)\r"}],"name":"guard","start_line":37,"symbol_id":"hold-code/weaponlab/probe.py#func:guard"}}
