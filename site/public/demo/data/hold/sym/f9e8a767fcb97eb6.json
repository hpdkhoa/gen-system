xt":"    def _segments(self, parts):\r"},{"line":636,"text":"        out = []\r"},{"line":637,"text":"        for side in (\"l\", \"r\"):\r"},{"line":638,"text":"            if parts not in (\"both\", side, {\"l\": \"left\", \"r\": \"right\"}[side]):\r"},{"line":639,"text":"                continue\r"},{"line":640,"text":"            b = lambda part: self._bw(self._n(part, side)).translation\r"},{"line":641,"text":"            f = lambda fi, j: self._bw(self._n(\"finger\", side, fi, j)).translation\r"},{"line":642,"text":"            fit = self._fitted_radii()\r"},{"line":643,"text":"            if fit:\r"},{"line":644,"text":"                # capsules fitted to the rig's own skin (fit_capsules): the forearm in two halves (it tapers to the\r"},{"line":645,"text":"                # wrist), the palm as three spokes from the wrist to the index, middle and little finger knuckles\r"},{"line":646,"text":"                # (one line down its middle left its sides untested), each finger its own girth\r"},{"line":647,"text":"                E, H = b(\"lowerarm\"), b(\"hand\")\r"},{"line":648,"text":"                out.append((\"forearm_\" + side, E, E.lerp(H, 0.5), fit[\"forearm_elbow\"]))\r"},{"line":649,"text":"                out.append((\"forearmw_\" + side, E.lerp(H, 0.5), H, fit[\"forearm_wrist\"]))\r"},{"line":650,"text":"                out.append((\"palm_\" + side, H, f(\"middle\", \"01\"), fit[\"palm\"]))\r"},{"line":651,"text":"                out.append((\"palmi_\" + side, H, f(\"index\", \"01\"), fit.get(\"palm_index\", fit[\"palm\"])))\r"},{"line":652,"text":"                out.append((\"palmp_\" + side, H, f(\"pinky\", \"01\"), fit.get(\"palm_pinky\", fit[\"palm\"])))\r"},{"line":653,"text":"            else:\r"},{"line":654,"text":"                out.append((\"forearm_\" + side, b(\"lowerarm\"), b(\"hand\"), RADIUS[\"forearm\"]))\r"},{"line":655,"text":"                out.append((\"palm_\" + side, b(\"hand\"), f(\"middle\", \"01\"), RADIUS[\"palm\"]))\r"},{"line":656,"text":"            for fi in FINGERS:\r"},{"line":657,"text":"                pts = [f(fi, \"01\"), f(fi, \"02\"), f(fi, \"03\"), self._tip(fi, side)]\r"},{"line":658,"text":"                rf = fit.get(\"finger_\" + fi, RADIUS[\"finger\"]) if fit else RADIUS[\"finger\"]\r"},{"line":659,"text":"                for i in range(3):\r"},{"line":660,"text":"                    ri = fit.get(\"seg_%s%d\" % (fi, i + 1), rf) if fit else rf\r"},{"line":661,"text":"                    out.append((\"%s%d_%s\" % (fi, i + 1, side), pts[i], pts[i + 1], ri))\r"},{"line":662,"text":"        return out\r"}],"name":"_segments","start_line":635,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._segments"}}
