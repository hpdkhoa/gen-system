ll},"source":{"end_line":405,"file":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py","kind":"func","language":"python","lines":[{"line":375,"text":"def thumb_clear(side, tree, steps=16):\r"},{"line":376,"text":"    \"\"\"A thumb pressed into the gun lifted off it: one of its three joints turned 3 degrees at a time, the joint and\r"},{"line":377,"text":"    the way that open the gap most, until its skin is a glove's thickness off the surface; a turn that breaks a thumb\r"},{"line":378,"text":"    rule is not taken.\"\"\"\r"},{"line":379,"text":"    for _ in range(steps):\r"},{"line":380,"text":"        gap = finger_gap(side, \"thumb\", tree)\r"},{"line":381,"text":"        if gap >= GLOVE - 0.02:\r"},{"line":382,"text":"            return gap\r"},{"line":383,"text":"        across, k = L._hand_frame(side)\r"},{"line":384,"text":"        best = None\r"},{"line":385,"text":"        for j in (\"01\", \"02\", \"03\"):\r"},{"line":386,"text":"            n = L._n(\"finger\", side, \"thumb\", j)\r"},{"line":387,"text":"            head = L._bw(n).translation.copy()\r"},{"line":388,"text":"            tip = L._finger_tip(\"thumb\", side)\r"},{"line":389,"text":"            d = (tip - head)\r"},{"line":390,"text":"            if d.length < 1e-9:\r"},{"line":391,"text":"                continue\r"},{"line":392,"text":"            d.normalize()\r"},{"line":393,"text":"            M = L._bw(n)\r"},{"line":394,"text":"            for axis in (across, d.cross(across).normalized(), d.cross(d.cross(across)).normalized()):\r"},{"line":395,"text":"                for sg in (1.0, -1.0):\r"},{"line":396,"text":"                    L._turn_about(n, axis, 3.0 * sg, head)\r"},{"line":397,"text":"                    g2 = finger_gap(side, \"thumb\", tree)\r"},{"line":398,"text":"                    ok = not L._thumb_report(side, _TL)[1]\r"},{"line":399,"text":"                    if ok and (best is None or g2 > best[0]):\r"},{"line":400,"text":"                        best = (g2, n, axis, sg, head)\r"},{"line":401,"text":"                    L._set_world(n, M)\r"},{"line":402,"text":"        if best is None or best[0] <= gap + 1e-4:\r"},{"line":403,"text":"            return gap\r"},{"line":404,"text":"        L._turn_about(best[1], best[2], 3.0 * best[3], best[4])\r"},{"line":405,"text":"    return finger_gap(side, \"thumb\", tree)\r"}],"name":"thumb_clear","start_line":375,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:thumb_clear"}}
