{"flow":{"blocks":[{"id":0,"label":"entry","lines":[{"kind":"call","line":154,"text":"d = min((W - S).length, (UPPER + LOWER) / 100.0 - 1e-4)"},{"kind":"call","line":155,"text":"axis = (W - S).normalized()"},{"kind":"call","line":156,"text":"side = ((pole - S) - axis * (pole - S).dot(axis)).normalized()"},{"kind":"call","line":159,"text":"return S + axis * x + side * max(l1 * l1 - x * x, 0.0) ** 0.5"}],"preds":null,"stmts":["call min","call ?.normalized","call ?.normalized","call max","return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[0],"func_id":"hold-code/poselab_mcp/blender/sample.py#func:_elbow","issues":null},"source":{"end_line":159,"file":"hold-code/poselab_mcp/blender/sample.py","kind":"func","language":"python","lines":[{"line":153,"text":"def _elbow(S, W, pole):\r"},{"line":154,"text":"    d = min((W - S).length, (UPPER + LOWER) / 100.0 - 1e-4)\r"},{"line":155,"text":"    axis = (W - S).normalized()\r"},{"line":156,"text":"    side = ((pole - S) - axis * (pole - S).dot(axis)).normalized()\r"},{"line":157,"text":"    l1, l2 = UPPER / 100.0, LOWER / 100.0\r"},{"line":158,"text":"    x = (l1 * l1 - l2 * l2 + d * d) / (2 * d)\r"},{"line":159,"text":"    return S + axis * x + side * max(l1 * l1 - x * x, 0.0) ** 0.5\r"}],"name":"_elbow","start_line":153,"symbol_id":"hold-code/poselab_mcp/blender/sample.py#func:_elbow"}}
