l,"succs":[21]},{"id":32,"label":"then","lines":[{"kind":"call","line":1443,"text":"self._turn_about(n1, axis, float(best[1]), head)"}],"preds":[15],"stmts":["call self._turn_about","call float"],"succs":[33]},{"id":33,"label":"merge","lines":[{"kind":"call","line":1444,"text":"bpy.context.view_layer.update()"},{"kind":"call","line":1445,"text":"n2_, n3_ = self._n(\"finger\", side, \"thumb\", \"02\"), self._n(\"finger\", side, \"thumb\", \"03\")"},{"kind":"call","line":1448,"text":"self._thumb_flex(side, \"02\", best[2])"},{"kind":"call","line":1449,"text":"self._thumb_flex(side, \"03\", best[3])"},{"kind":"call","line":1450,"text":"bpy.context.view_layer.update()"},{"kind":"call","line":1452,"text":"self._last_via = {\"via_left_cm\": round((self._bw(n2).translation - via).length * 100, 2), \"tip_left_cm\": round(best[0] * 100, 2),"},{"kind":"return","line":1454,"text":"return self._last_via"}],"preds":[32,15],"stmts":["call bpy.context.view_layer.update","call self._n","call self._n","call self._thumb_flex","call self._thumb_flex","call bpy.context.view_layer.update","call round","call self._bw","call round","return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[33],"func_id":"hold-code/poselab_mcp/blender/lab.py#func:_thumb_via","issues":null},"source":{"end_line":1454,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"func","language":"python","lines":[{"line":1393,"text":"    def _thumb_via(self, side, via, target, TL, rounds=24, step_deg=6.0):\r"},{"line":1394,"text":"        \"\"\"The thumb laid along a path, as it wraps a pistol's backstrap: its base joint turned (a few degrees at a\r"},{"line":1395,"text":"        time) until its knuckle (the thumb's MCP) sits on the waypoint via; then its knuckle and end joint bent in\r"},{"line":1396,"text":"        their hinges (a grid) and the base nudged so the tip comes nearest the target. Returns the distances left.\"\"\"\r"},{"line":1397,"text":"        n1 = self._n(\"finger\", side, \"thumb\", \"01\")\r"},{"line":1398,"text":"        n2 = self._n(\"finger\", side, \"thumb\", \"02\")\r"},{"line":1399,"text":"        for _ in range(rounds):\r"},{"line":1400,"text":"            head = self._bw(n1).translation.copy()\r"},{"line":1401,"text":"            a, b = self._bw(n2).translation - head, via - head\r"},{"line":1402,"text":"            if a.length < 1e-6 or b.length < 1e-6:\r"},{"line":1403,"text":"                break\r"},{"line":1404,"text":"            ang = math.degrees(a.angle(b))\r"},{"line":1405,"text":"            if ang < 0.5:\r"},{"line":1406,"text":"                break\r"},{"line":1407,"text":"            self._turn_about(n1, a.cross(b).normalized(), min(step_deg, ang), head)\r"},{"line":1408,"text":"            bpy.context.view_layer.update()\r"},{"line":1409,"text":"        # the metacarpal's roll about its own line sets the plane the thumb's hinges bend in: each roll (the knuckle\r"},{"line":1410,"text":"        # stays on the waypoint) with a grid of bends; the try whose tip comes nearest, clear of the gun and within\r"},{"line":1411,"text":"        # the thumb's rules, stays\r"},{"line":1412,"text":"        head = self._bw(n1).translation.copy()\r"},{"line":1413,"text":"        M1 = self._bw(n1)\r"},{"line":1414,"text":"        axis = (self._bw(n2).translation - head)\r"},{"line":1415,"text":"        axis = axis.normalized() if axis.length > 1e-9 else Vector((0, 0, 1))\r"},{"line":1416,"text":"        tree = self._tree()\r"},{"line":1417,"text":"        best = None\r"},{"line":1418,"text":"        closest = None\r"},{"line":1419,"text":"        for roll in range(-180, 180, 15):\r"},{"line":1420,"text":"            self._set_world(n1, M1)\r"},{"line":1421,"text":"            if roll:\r"},{"line":1422,"text":"                self._turn_about(n1, axis, float(roll), head)\r"},{"line":1423,"text":"            bpy.context.view_layer.update()\r"},{"line":1424,"text":"            n2_, n3_ = self._n(\"finger\", side, \"thumb\", \"02\"), self._n(\"finger\", side, \"thumb\", \"03\")\r"},{"line":1425,"text":"            q2_, q3_ = self.arm.pose.bones[n2_].rotation_quaternion.copy(), self.arm.pose.bones[n3_].rotation_quaternion.copy()\r"},{"line":1426,"text":"            for b2 in (-5.0, 5.0, 15.0, 25.0, 35.0, 45.0, 55.0):\r"},{"line":1427,"text":"                for b3 in (-10.0, 0.0, 15.0, 30.0, 45.0, 60.0):\r"},{"line":1428,"text":"                    self.arm.pose.bones[n2_].rotation_quaternion = q2_\r"},{"line":1429,"text":"                    self.arm.pose.bones[n3_].rotation_quaternion = q3_\r"},{"line":1430,"text":"                    self._thumb_flex(side, \"02\", b2)\r"},{"line":1431,"text":"                    self._thumb_flex(side, \"03\", b3)\r"},{"line":1432,"text":"                    bpy.context.view_layer.update()\r"},{"line":1433,"text":"                    dd = (self._finger_tip(\"thumb\", side) - target).length * 100.0\r"},{"line":1434,"text":"                    gap = self._digit_gap(side, \"thumb\", tree, 0.0, False)\r"},{"line":1435,"text":"                    rules = len(self._thumb_report(side, TL)[1])\r"},{"line":1436,"text":"                    sc = dd + 6.0 * max(0.0, -gap - 0.05) + 10.0 * rules\r"},{"line":1437,"text":"                    if best is None or sc < best[0]:\r"},{"line":1438,"text":"                        best = (sc, roll, b2, b3, dd)\r"},{"line":1439,"text":"                    if closest is None or dd < closest[0]:\r"},{"line":1440,"text":"                        closest = (round(dd, 2), roll, b2, b3, round(gap, 2), self._thumb_report(side, TL)[1][:3])\r"},{"line":1441,"text":"        self._set_world(n1, M1)\r"},{"line":1442,"text":"        if best[1]:\r"},{"line":1443,"text":"            self._turn_about(n1, axis, float(best[1]), head)\r"},{"line":1444,"text":"        bpy.context.view_layer.update()\r"},{"line":1445,"text":"        n2_, n3_ = self._n(\"finger\", side, \"thumb\", \"02\"), self._n(\"finger\", side, \"thumb\", \"03\")\r"},{"line":1446,"text":"        self.arm.pose.bones[n2_].rotation_quaternion = q2_\r"},{"line":1447,"text":"        self.arm.pose.bones[n3_].rotation_quaternion = q3_\r"},{"line":1448,"text":"        self._thumb_flex(side, \"02\", best[2])\r"},{"line":1449,"text":"        self._thumb_flex(side, \"03\", best[3])\r"},{"line":1450,"text":"        bpy.context.view_layer.update()\r"},{"line":1451,"text":"        best = (best[4] / 100.0, best[2], best[3], best[1])\r"},{"line":1452,"text":"        self._last_via = {\"via_left_cm\": round((self._bw(n2).translation - via).length * 100, 2), \"tip_left_cm\": round(best[0] * 100, 2),\r"},{"line":1453,"text":"                          \"bend\": [best[1], best[2]], \"roll\": best[3], \"closest_try\": closest}\r"},{"line":1454,"text":"        return self._last_via\r"}],"name":"_thumb_via","start_line":1393,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:_thumb_via"}}
