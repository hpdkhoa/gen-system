de spoke its own half thickness at its middle\r"},{"line":714,"text":"            for name, Kx in ((\"palm_index\", I), (\"palm_pinky\", Pk)):\r"},{"line":715,"text":"                ax = (Kx - W).normalized()\r"},{"line":716,"text":"                cm_ = W.lerp(Kx, 0.5)\r"},{"line":717,"text":"                side_ = nrm.cross(ax).normalized()\r"},{"line":718,"text":"                pe = [(p - cm_).dot(nrm) for p, g in mine if (g.startswith(\"hand\") or \"metacarpal\" in g)\r"},{"line":719,"text":"                      and abs((p - cm_).dot(ax)) < 0.006 and abs((p - cm_).dot(side_)) < 0.01]\r"},{"line":720,"text":"                if pe:\r"},{"line":721,"text":"                    got.setdefault(name, []).append((max(pe) - min(pe)) / 2)\r"},{"line":722,"text":"            for fi in FINGERS:\r"},{"line":723,"text":"                a2, a3 = B(self._n(\"finger\", s_, fi, \"02\")), B(self._n(\"finger\", s_, fi, \"03\"))\r"},{"line":724,"text":"                fd = (a3 - a2).normalized()\r"},{"line":725,"text":"                fc = a2.lerp(a3, 0.5)\r"},{"line":726,"text":"                ring = [p - fc - fd * (p - fc).dot(fd) for p, g in mine if g.startswith(fi) and abs((p - fc).dot(fd)) < 0.003]\r"},{"line":727,"text":"                if len(ring) >= 6:\r"},{"line":728,"text":"                    uu = fd.orthogonal().normalized()\r"},{"line":729,"text":"                    vv = fd.cross(uu)\r"},{"line":730,"text":"                    got.setdefault(\"finger_\" + fi, []).append(\r"},{"line":731,"text":"                        self._hull_perimeter([(r.dot(uu), r.dot(vv)) for r in ring]) / (2 * math.pi))\r"},{"line":732,"text":"                # each segment its own girth: the first (a finger's base, the thumb's thick thenar) is wider\r"},{"line":733,"text":"                a1 = B(self._n(\"finger\", s_, fi, \"01\"))\r"},{"line":734,"text":"                for sg, (pa, pb) in ((\"1\", (a1, a2)), (\"2\", (a2, a3))):\r"},{"line":735,"text":"                    d_ = (pb - pa)\r"},{"line":736,"text":"                    if d_.length < 1e-6:\r"},{"line":737,"text":"                        continue\r"},{"line":738,"text":"                    d_ = d_.normalized()\r"},{"line":739,"text":"                    c_ = pa.lerp(pb, 0.5)\r"},{"line":740,"text":"                    rg = [p - c_ - d_ * (p - c_).dot(d_) for p, g in mine\r"},{"line":741,"text":"                          if g.startswith(\"%s_0%s\" % (fi, sg)) and abs((p - c_).dot(d_)) < 0.004\r"},{"line":742,"text":"                          and (p - c_ - d_ * (p - c_).dot(d_)).length < 0.035]\r"},{"line":743,"text":"                    if len(rg) >= 6:\r"},{"line":744,"text":"                        uu = d_.orthogonal().normalized()\r"},{"line":745,"text":"                        vv = d_.cross(uu)\r"},{"line":746,"text":"                        got.setdefault(\"seg_%s%s\" % (fi, sg), []).append(\r"},{"line":747,"text":"                            self._hull_perimeter([(r.dot(uu), r.dot(vv)) for r in rg]) / (2 * math.pi))\r"},{"line":748,"text":"        base = {\"forearm_elbow\": RADIUS[\"forearm\"], \"forearm_wrist\": RADIUS[\"forearm\"], \"palm\": RADIUS[\"palm\"],\r"},{"line":749,"text":"                \"palm_index\": RADIUS[\"palm\"], \"palm_pinky\": RADIUS[\"palm\"]}\r"},{"line":750,"text":"        base.update({\"finger_\" + fi: RADIUS[\"finger\"] for fi in FINGERS})\r"},{"line":751,"text":"        out = {k: (max(got[k]) if got.get(k) else v) for k, v in base.items()}\r"},{"line":752,"text":"        for k, v in got.items():\r"},{"line":753,"text":"            if k.startswith(\"seg_\") and v:\r"},{"line":754,"text":"                out[k] = max(v)\r"},{"line":755,"text":"        return out\r"}],"name":"_measure_radii","start_line":686,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._measure_radii"}}
