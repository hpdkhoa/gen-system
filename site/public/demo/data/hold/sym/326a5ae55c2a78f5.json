       if side in CLAV_SET:\r"},{"line":1431,"text":"            L.arm.pose.bones[\"clavicle_\" + side].rotation_quaternion = CLAV_SET[side]\r"},{"line":1432,"text":"            bpy.context.view_layer.update()\r"},{"line":1433,"text":"        L._put_hand(side, bone_world(\"Root\") @ gr[0])\r"},{"line":1434,"text":"        for n, q in gr[1].items():\r"},{"line":1435,"text":"            L.arm.pose.bones[n].rotation_quaternion = q\r"},{"line":1436,"text":"bpy.context.view_layer.update()\r"},{"line":1437,"text":"MEND_SIDES = tuple(job.get(\"mend_sides\", (\"l\",)))\r"},{"line":1438,"text":"TRIGGER = {}\r"},{"line":1439,"text":"if STYLE and STYLE.get(\"trigger_clips\") and (STYLE[\"hands\"].get(\"r\") or {}).get(\"trigger\"):\r"},{"line":1440,"text":"    L.snapshot(\"save\", \"before_trigger\")\r"},{"line":1441,"text":"    apply_style(\"r\", trigger=True)\r"},{"line":1442,"text":"    TRIGGER = {n: L.arm.pose.bones[n].rotation_quaternion.copy() for n in FINGER_BONES[\"r\"] if n.startswith(\"index\")}\r"},{"line":1443,"text":"    L.snapshot(\"load\", \"before_trigger\")\r"},{"line":1444,"text":"L.snapshot(\"save\", \"hold\")\r"},{"line":1445,"text":"GUN_BONE = L.names[\"gun\"]\r"},{"line":1446,"text":"G_HOLD = L._bw(GUN_BONE).copy()\r"},{"line":1447,"text":"RA_HOLD = RA.matrix_world.copy()\r"},{"line":1448,"text":"PIVOT = mark_world(\"grip\")\r"},{"line":1449,"text":"report[\"hold\"] = {\"right\": \"found\" if home_r[2] else \"laid\", \"left\": (\"found\" if home_l[2] else \"laid\") if home_l else \"none\"}\r"},{"line":1450,"text":"# where the gun hangs on the arms' gun bone: the bolt face (the gun's origin) in that bone's frame at the hold, cm\r"}],"name":"home_l","start_line":1410,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#var:home_l"}}
