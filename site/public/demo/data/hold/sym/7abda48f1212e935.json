:30,"label":"merge","preds":[29,27],"stmts":null,"succs":[31,32]},{"id":31,"label":"then","lines":[{"kind":"call","line":541,"text":"best = (excess, out.normalized(), name)"}],"preds":[30],"stmts":["call out.normalized"],"succs":[32]},{"id":32,"label":"merge","preds":[31,30],"stmts":null,"succs":[28]}],"effects":["unknown"],"entry":0,"exits":[3],"func_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:deepest_press","issues":null},"source":{"end_line":542,"file":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py","kind":"func","language":"python","lines":[{"line":520,"text":"def deepest_press(side, tree):\r"},{"line":521,"text":"    \"\"\"The hand's deepest press into the gun that the style does not allow, and the way out of it: (excess cm, world\r"},{"line":522,"text":"    direction from the gun's surface out through the body part). A soft contact counts past 80 percent of its own\r"},{"line":523,"text":"    most; the thumb's middle and end are the thumb's own (thumb_clear); the forearm and the palm are left out.\"\"\"\r"},{"line":524,"text":"    allowed = max(0.0, 0.2 - GLOVE)\r"},{"line":525,"text":"    best = None\r"},{"line":526,"text":"    for name, a, b, r in L._segments(side):\r"},{"line":527,"text":"        if name.startswith((\"forearm\", \"palm\", \"thumb2\", \"thumb3\")) and not any(name.startswith(k) for k in SOFT):\r"},{"line":528,"text":"            continue\r"},{"line":529,"text":"        lim = next((0.8 * v for k, v in SOFT.items() if name.startswith(k)), allowed)\r"},{"line":530,"text":"        n = max(2, int((b - a).length / 0.003))\r"},{"line":531,"text":"        for i in range(n + 1):\r"},{"line":532,"text":"            pt = a.lerp(b, i / n)\r"},{"line":533,"text":"            q, dq = tree.nearest(pt)\r"},{"line":534,"text":"            if q is None or dq >= r:\r"},{"line":535,"text":"                continue\r"},{"line":536,"text":"            depth = (r - dq) * 100.0\r"},{"line":537,"text":"            excess = depth - lim\r"},{"line":538,"text":"            if excess > 0 and (best is None or excess > best[0]):\r"},{"line":539,"text":"                out = (pt - q) if dq >= 0.0 else (q - pt)\r"},{"line":540,"text":"                if out.length > 1e-9:\r"},{"line":541,"text":"                    best = (excess, out.normalized(), name)\r"},{"line":542,"text":"    return best\r"}],"name":"deepest_press","start_line":520,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:deepest_press"}}
