{"flow":{"kind":"var","name":"job","noCFG":true,"reason":"job is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":56,"file":"hold-code/weaponlab/blueprint/blender/blueprint_showcase.py","kind":"var","language":"python","lines":[{"line":16,"text":"job = json.load(open(sys.argv[sys.argv.index(\"--\") + 1], encoding=\"utf-8\"))\r"},{"line":17,"text":"OUT = job[\"out\"]\r"},{"line":18,"text":"os.makedirs(OUT, exist_ok=True)\r"},{"line":19,"text":"W, H = job.get(\"size\", [960, 600])\r"},{"line":20,"text":"FPS = job.get(\"fps\", 15)\r"},{"line":21,"text":"sc = bpy.context.scene\r"},{"line":22,"text":"sc.render.engine = 'BLENDER_WORKBENCH'\r"},{"line":23,"text":"sh = sc.display.shading\r"},{"line":24,"text":"sh.light = 'STUDIO'\r"},{"line":25,"text":"sh.color_type = 'MATERIAL'\r"},{"line":26,"text":"sh.show_cavity = True\r"},{"line":27,"text":"sh.cavity_type = 'BOTH'\r"},{"line":28,"text":"sh.show_specular_highlight = True\r"},{"line":29,"text":"sh.show_object_outline = False\r"},{"line":30,"text":"sh.background_type = 'WORLD'\r"},{"line":31,"text":"sc.world = sc.world or bpy.data.worlds.new(\"W\")\r"},{"line":32,"text":"sc.world.color = (0.93, 0.93, 0.95)\r"},{"line":33,"text":"sc.render.resolution_x, sc.render.resolution_y = W, H\r"},{"line":34,"text":"sc.render.film_transparent = False\r"},{"line":35,"text":"sc.view_settings.view_transform = 'Standard'\r"},{"line":36,"text":"arm = next(o for o in sc.objects if o.type == 'ARMATURE')\r"},{"line":37,"text":"mesh = [o for o in sc.objects if o.type == 'MESH']\r"},{"line":38,"text":"for m in mesh:\r"},{"line":39,"text":"    m.hide_render = False\r"},{"line":40,"text":"# the gun's bounds at rest\r"},{"line":41,"text":"arm.animation_data_create()\r"},{"line":42,"text":"arm.animation_data.action = None\r"},{"line":43,"text":"for pb in arm.pose.bones:\r"},{"line":44,"text":"    pb.location = (0, 0, 0)\r"},{"line":45,"text":"    pb.rotation_quaternion = (1, 0, 0, 0)\r"},{"line":46,"text":"bpy.context.view_layer.update()\r"},{"line":47,"text":"dg = bpy.context.evaluated_depsgraph_get()\r"},{"line":48,"text":"pts = []\r"},{"line":49,"text":"for m in mesh:\r"},{"line":50,"text":"    e = m.evaluated_get(dg)\r"},{"line":51,"text":"    pts += [e.matrix_world @ v.co for v in e.to_mesh().vertices]\r"},{"line":52,"text":"lo = Vector((min(p.x for p in pts), min(p.y for p in pts), min(p.z for p in pts)))\r"},{"line":53,"text":"hi = Vector((max(p.x for p in pts), max(p.y for p in pts), max(p.z for p in pts)))\r"},{"line":54,"text":"mid = (lo + hi) / 2.0\r"},{"line":55,"text":"R = (hi - lo).length\r"},{"line":56,"text":"cam_data = bpy.data.cameras.new(\"ShowCam\")\r"}],"name":"job","start_line":16,"symbol_id":"hold-code/weaponlab/blueprint/blender/blueprint_showcase.py#var:job"}}
