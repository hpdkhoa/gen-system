       yc = y0 + pitch * (i + 0.5)\r"},{"line":173,"text":"                if face in (\"left\", \"right\"):\r"},{"line":174,"text":"                    out = [[yc - w / 2 + slant * (z0 - zm), z0], [yc + w / 2 + slant * (z0 - zm), z0], [yc + w / 2 + slant * (z1 - zm), z1], [yc - w / 2 + slant * (z1 - zm), z1]]\r"},{"line":175,"text":"                    xa, xb = (b[\"x\"][1] - d, b[\"x\"][1] + 1.0) if face == \"left\" else (b[\"x\"][0] - 1.0, b[\"x\"][0] + d)\r"},{"line":176,"text":"                    cut = prism(\"%s_f%d_%d\" % (pid, k, i), out, xa, xb)\r"},{"line":177,"text":"                else:                                   # top: across x, cut down from the top\r"},{"line":178,"text":"                    xs = ft.get(\"x\") or b[\"x\"]\r"},{"line":179,"text":"                    out = [[yc - w / 2, b[\"z\"][1] - d], [yc + w / 2, b[\"z\"][1] - d], [yc + w / 2, b[\"z\"][1] + 1.0], [yc - w / 2, b[\"z\"][1] + 1.0]]\r"},{"line":180,"text":"                    cut = prism(\"%s_f%d_%d\" % (pid, k, i), out, xs[0], xs[1])\r"},{"line":181,"text":"                boolean(ob, cut)\r"},{"line":182,"text":"        elif ft[\"kind\"] == \"screw\":\r"},{"line":183,"text":"            (y, z), r, h = ft[\"at\"], ft[\"r\"], ft[\"head_cm\"]\r"},{"line":184,"text":"            circ = [[y + r * math.cos(2 * math.pi * t / SEG), z + r * math.sin(2 * math.pi * t / SEG)] for t in range(SEG)]\r"},{"line":185,"text":"            xa, xb = (b[\"x\"][1] - 0.05, b[\"x\"][1] + h) if face == \"left\" else (b[\"x\"][0] - h, b[\"x\"][0] + 0.05)\r"},{"line":186,"text":"            head = prism(\"%s_screw%d\" % (pid, k), circ, xa, xb)\r"},{"line":187,"text":"            if ft.get(\"slot\", True):\r"},{"line":188,"text":"                sx = (xb - 0.6 * h, xb + 1.0) if face == \"left\" else (xa - 1.0, xa + 0.6 * h)\r"},{"line":189,"text":"                boolean(head, prism(\"%s_slot%d\" % (pid, k), [[y - r, z - r * 0.12], [y + r, z - r * 0.12], [y + r, z + r * 0.12], [y - r, z + r * 0.12]], sx[0], sx[1]))\r"},{"line":190,"text":"            union(ob, head)\r"}],"name":"feature","start_line":156,"symbol_id":"hold-code/weaponlab/blueprint/blender/blueprint_build.py#func:feature"}}
