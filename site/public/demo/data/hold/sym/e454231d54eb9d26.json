s BVH, its signed-distance surface and the labelled samples in the world (a KD\r"},{"line":706,"text":"        tree), cached while the object does not move.\"\"\"\r"},{"line":707,"text":"        key = self._gun_key()\r"},{"line":708,"text":"        c = getattr(self, \"_obj_now\", None)\r"},{"line":709,"text":"        if c and c[0] == key:\r"},{"line":710,"text":"            return c[1]\r"},{"line":711,"text":"        vs, ps = self._gun_verts()\r"},{"line":712,"text":"        bvh = BVHTree.FromPolygons(vs, ps)\r"},{"line":713,"text":"        SW, SL = self._samples_world()\r"},{"line":714,"text":"        kd = KDTree(len(SW))\r"},{"line":715,"text":"        for i, p_ in enumerate(SW):\r"},{"line":716,"text":"            kd.insert(Vector(p_), i)\r"},{"line":717,"text":"        kd.balance()\r"},{"line":718,"text":"        val = (bvh, self.Surface(bvh), SW, SL, kd)\r"},{"line":719,"text":"        self._obj_now = (key, val)\r"},{"line":720,"text":"        return val\r"}],"name":"_object_now","start_line":704,"symbol_id":"hold-code/poselab_mcp/blender/contactlab.py#func:_object_now"}}
