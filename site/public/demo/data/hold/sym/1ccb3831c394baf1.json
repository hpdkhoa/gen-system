["return"],"succs":null},{"cond":"for t in range(1, m - 1)","id":22,"label":"loop_header","preds":[20,23],"stmts":null,"succs":[23,24]},{"id":23,"label":"loop_body","lines":[{"kind":"call","line":71,"text":"w = min(h, t, m - 1 - t)                  # the window shrinks toward the corners, which stay put"},{"kind":"call","line":72,"text":"out[idx[t]] = seg[t - w:t + w + 1].mean(axis=0)"}],"preds":[22],"stmts":["call min","call ?.mean"],"succs":[22]},{"id":24,"label":"loop_exit","preds":[22],"stmts":null,"succs":[19]}],"effects":["unknown"],"entry":0,"exits":[1,18,21],"func_id":"hold-code/weaponlab/blueprint/trace.py#func:smooth","issues":null},"source":{"end_line":73,"file":"hold-code/weaponlab/blueprint/trace.py","kind":"func","language":"python","lines":[{"line":35,"text":"def smooth(points, window_px, corner_deg=35.0):\r"},{"line":36,"text":"    \"\"\"A traced contour's edge noise (a halftone's dots, a scan's grain) taken out: the corners found first (where the\r"},{"line":37,"text":"    outline turns more than corner_deg over a window), then each run between two corners averaged over the window\r"},{"line":38,"text":"    with its two corner ends held. Straight edges come out straight, curves even, corners sharp.\"\"\"\r"},{"line":39,"text":"    cv2, np = _cv()\r"},{"line":40,"text":"    P = np.asarray(points, dtype=float)\r"},{"line":41,"text":"    n = len(P)\r"},{"line":42,"text":"    h = max(2, int(window_px // 2))\r"},{"line":43,"text":"    if n < 4 * h:\r"},{"line":44,"text":"        return P\r"},{"line":45,"text":"    hc = 2 * h                                       # corners judged over twice the smoothing span: noise is no corner\r"},{"line":46,"text":"    a = P[(np.arange(n) - hc) % n]\r"},{"line":47,"text":"    b = P[(np.arange(n) + hc) % n]\r"},{"line":48,"text":"    u, v = P - a, b - P\r"},{"line":49,"text":"    cos = (u * v).sum(1) / (np.linalg.norm(u, axis=1) * np.linalg.norm(v, axis=1) + 1e-9)\r"},{"line":50,"text":"    turn = np.degrees(np.arccos(np.clip(cos, -1, 1)))\r"},{"line":51,"text":"    corners = [i for i in range(n) if turn[i] >= corner_deg and turn[i] >= turn[(i - 1) % n] and turn[i] >= turn[(i + 1) % n]]\r"},{"line":52,"text":"    keep = []                                        # corners closer than the window are one corner\r"},{"line":53,"text":"    for i in corners:\r"},{"line":54,"text":"        if not keep or i - keep[-1] > hc:\r"},{"line":55,"text":"            keep.append(i)\r"},{"line":56,"text":"    if len(keep) > 1 and keep[0] + n - keep[-1] <= hc:\r"},{"line":57,"text":"        keep.pop()\r"},{"line":58,"text":"    out = P.copy()\r"},{"line":59,"text":"    if not keep:\r"},{"line":60,"text":"        k = np.ones(2 * h + 1) / (2 * h + 1)\r"},{"line":61,"text":"        for d in range(2):\r"},{"line":62,"text":"            ext = np.concatenate([P[-h:, d], P[:, d], P[:h, d]])\r"},{"line":63,"text":"            out[:, d] = np.convolve(ext, k, mode=\"valid\")\r"},{"line":64,"text":"        return out\r"},{"line":65,"text":"    for j, c0 in enumerate(keep):\r"},{"line":66,"text":"        c1 = keep[(j + 1) % len(keep)]\r"},{"line":67,"text":"        idx = [(c0 + t) % n for t in range(((c1 - c0) % n) + 1)]\r"},{"line":68,"text":"        seg = P[idx]\r"},{"line":69,"text":"        m = len(seg)\r"},{"line":70,"text":"        for t in range(1, m - 1):\r"},{"line":71,"text":"            w = min(h, t, m - 1 - t)                  # the window shrinks toward the corners, which stay put\r"},{"line":72,"text":"            out[idx[t]] = seg[t - w:t + w + 1].mean(axis=0)\r"},{"line":73,"text":"    return out\r"}],"name":"smooth","start_line":35,"symbol_id":"hold-code/weaponlab/blueprint/trace.py#func:smooth"}}
