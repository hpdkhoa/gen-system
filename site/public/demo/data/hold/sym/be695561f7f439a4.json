{"flow":{"kind":"var","name":"FINGER","noCFG":true,"reason":"FINGER is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":63,"file":"hold-code/poselab_mcp/blender/sample.py","kind":"var","language":"python","lines":[{"line":23,"text":"FINGER = {\"index\": (2.4, 4.0, 2.4, 2.0), \"middle\": (0.8, 4.4, 2.7, 2.1), \"ring\": (-0.8, 4.1, 2.5, 2.0),\r"},{"line":24,"text":"          \"pinky\": (-2.4, 3.2, 2.0, 1.8), \"thumb\": (3.0, 3.4, 2.8, 2.3)}\r"},{"line":25,"text":"CURL = 0.95                                     # how much each finger joint bends toward the palm (about 45 degrees)\r"},{"line":26,"text":"FINGER_R = {\"index\": 0.85, \"middle\": 0.9, \"ring\": 0.85, \"pinky\": 0.75, \"thumb\": 1.0}   # cm\r"},{"line":27,"text":"COLOURS = {\"receiver\": (0.045, 0.047, 0.05), \"furniture\": (0.07, 0.07, 0.075), \"rail\": (0.11, 0.11, 0.12),\r"},{"line":28,"text":"           \"steel\": (0.2, 0.21, 0.22), \"magazine\": (0.28, 0.24, 0.17), \"handle\": (0.5, 0.52, 0.55),\r"},{"line":29,"text":"           \"sleeve\": (0.2, 0.23, 0.17), \"cuff\": (0.12, 0.13, 0.1), \"skin\": (0.72, 0.53, 0.42)}\r"},{"line":30,"text":"CONFIG = {\r"},{"line":31,"text":"    \"eye\": list(EYE), \"gun_offset\": [0.0, 0.0, 0.0], \"parts\": {\"carrier\": [\"carrier\"]},\r"},{"line":32,"text":"    \"points\": {\"port\": [-1.5, 9.0, 4.0], \"bore\": [0.0, 0.0, 3.5], \"stock\": [0.0, -25.0, 0.0],\r"},{"line":33,"text":"               \"muzzle\": [0.0, 64.0, 3.5], \"handle\": [-2.6, 4.0, 4.5]},\r"},{"line":34,"text":"    \"normals\": {\"port\": [-1.0, 0.0, 0.0]},\r"},{"line":35,"text":"    \"poles\": {k: list(v) for k, v in POLE.items()},\r"},{"line":36,"text":"}\r"},{"line":37,"text":"\r"},{"line":38,"text":"\r"},{"line":39,"text":"def ue(v):\r"},{"line":40,"text":"    return Vector((v[0], -v[1], v[2])) / 100.0\r"},{"line":41,"text":"\r"},{"line":42,"text":"\r"},{"line":43,"text":"def material(name):\r"},{"line":44,"text":"    m = bpy.data.materials.get(\"poselab_\" + name)\r"},{"line":45,"text":"    if not m:\r"},{"line":46,"text":"        m = bpy.data.materials.new(\"poselab_\" + name)\r"},{"line":47,"text":"        m.diffuse_color = COLOURS[name] + (1.0,)\r"},{"line":48,"text":"        m.roughness = 0.35 if name in (\"steel\", \"handle\") else 0.6\r"},{"line":49,"text":"        m.metallic = 0.6 if name in (\"steel\", \"handle\") else 0.0\r"},{"line":50,"text":"    return m\r"},{"line":51,"text":"\r"},{"line":52,"text":"\r"},{"line":53,"text":"def new_object(name, bm, mat, smooth=True):\r"},{"line":54,"text":"    me = bpy.data.meshes.new(name)\r"},{"line":55,"text":"    bm.to_mesh(me)\r"},{"line":56,"text":"    bm.free()\r"},{"line":57,"text":"    me.materials.append(material(mat))\r"},{"line":58,"text":"    for p in me.polygons:\r"},{"line":59,"text":"        p.use_smooth = smooth\r"},{"line":60,"text":"    ob = bpy.data.objects.new(name, me)\r"},{"line":61,"text":"    bpy.context.scene.collection.objects.link(ob)\r"},{"line":62,"text":"    return ob\r"},{"line":63,"text":"\r"}],"name":"FINGER","start_line":23,"symbol_id":"hold-code/poselab_mcp/blender/sample.py#var:FINGER"}}
