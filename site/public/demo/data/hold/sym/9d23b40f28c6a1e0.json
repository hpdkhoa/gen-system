{"flow":{"blocks":[{"id":0,"label":"entry","lines":[{"kind":"call","line":3472,"text":"self._need()"},{"kind":"call","line":3473,"text":"frames, fps = self._frames(clip)"},{"kind":"call","line":3474,"text":"return self._scan(frames, fps, checks, clip)"}],"preds":null,"stmts":["call self._need","call self._frames","call self._scan","return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[0],"func_id":"hold-code/poselab_mcp/blender/lab.py#func:scan_clip","issues":null},"source":{"end_line":3474,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"func","language":"python","lines":[{"line":3466,"text":"    def scan_clip(self, clip, checks):\r"},{"line":3467,"text":"        \"\"\"Plays a clip frame by frame and runs each check: clearance, anatomy (side, fingers: the rules a frame\r"},{"line":3468,"text":"        breaks, counted), faces_eye, visible, on_screen, barrel, contact\r"},{"line":3469,"text":"        (a, b, max_cm), hold (side, max_cm: the hand's drift on the rifle from its grip at ref_s), pop (bones, \"gun\" for the gun bone,\r"},{"line":3470,"text":"        max_cm_per_s). Any check takes during: [from_s, to_s]. Reports, for each check, the worst value and when, and\r"},{"line":3471,"text":"        the times it fails.\"\"\"\r"},{"line":3472,"text":"        self._need()\r"},{"line":3473,"text":"        frames, fps = self._frames(clip)\r"},{"line":3474,"text":"        return self._scan(frames, fps, checks, clip)\r"}],"name":"scan_clip","start_line":3466,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:scan_clip"}}
