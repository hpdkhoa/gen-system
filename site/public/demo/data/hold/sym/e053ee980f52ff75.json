\"))\r"},{"line":264,"text":"    a = A.load(facts[\"action\"])\r"},{"line":265,"text":"    st = SU.style(style) if style else SU.style_for(facts[\"action\"])\r"},{"line":266,"text":"    ch = SU.character(character)\r"},{"line":267,"text":"    hands_dir = Path(facts_path).parent / \"hands\"\r"},{"line":268,"text":"    name = name or Path(gun_fbx).stem\r"},{"line":269,"text":"    out = hands_dir / (\"skin_\" + name)\r"},{"line":270,"text":"    out.mkdir(parents=True, exist_ok=True)\r"},{"line":271,"text":"    want = list(a[\"hand_clips\"])\r"},{"line":272,"text":"    tl = {cid: T.hand_clip(a, facts, cid) for cid in want}\r"},{"line":273,"text":"    tracks = {cid: R.tracks(facts, cc) for cid, cc in tl.items()}\r"},{"line":274,"text":"    job = {\"poselab\": str(Path(poselab_mcp.__file__).resolve().parent / \"blender\"), \"arms\": arms(),\r"},{"line":275,"text":"           \"gun_fbx\": str(gun_fbx), \"facts\": facts, \"clips\": tl, \"tracks\": tracks,\r"},{"line":276,"text":"           \"prefix\": \"A_%s_Hands_\" % facts[\"name\"], \"out\": str(out), \"grip_steps\": 3, \"render\": False,\r"},{"line":277,"text":"           \"style\": st, \"character\": ch, \"glove_cm\": SU.glove_cm(ch), \"body_ranges\": None,\r"},{"line":278,"text":"           \"skin_check\": {\"name\": name, \"clips_dir\": str(hands_dir / \"clips\")}}\r"},{"line":279,"text":"    _blender(\"gunkit_hands.py\", job, out, timeout=7200)\r"},{"line":280,"text":"    return json.loads((out / \"skin_check.json\").read_text(encoding=\"utf-8\"))\r"}],"name":"skin_check","start_line":257,"symbol_id":"hold-code/weaponlab/gunkit/run.py#func:skin_check"}}
