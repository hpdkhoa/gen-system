ccs":[20,21]},{"cond":"cand is None","id":19,"label":"merge","preds":[21,17],"stmts":null,"succs":[22,23]},{"id":20,"label":"then","preds":[18],"stmts":null,"succs":[21]},{"id":21,"label":"merge","lines":[{"kind":"call","line":1644,"text":"err += max(0.0, 0.3 - side_ok)"}],"preds":[20,18],"stmts":["call max"],"succs":[19]},{"id":22,"label":"then","preds":[19],"stmts":null,"succs":[23]},{"cond":"cand is None or err < cand[0]","id":23,"label":"merge","preds":[22,19],"stmts":null,"succs":[24,25]},{"id":24,"label":"then","lines":[{"kind":"call","line":1646,"text":"cand = (err, gap, ang, a.lerp(b, t), n_out)"}],"preds":[23],"stmts":["call a.lerp"],"succs":[25]},{"id":25,"label":"merge","preds":[24,23],"stmts":null,"succs":[8]},{"id":26,"label":"then","preds":[10],"stmts":null,"succs":[27]},{"cond":"cand[0] <= 1e-06","id":27,"label":"merge","preds":[26,10],"stmts":null,"succs":[28,29]},{"id":28,"label":"then","preds":[27],"stmts":null,"succs":[29]},{"cond":"best is None","id":29,"label":"merge","preds":[28,27],"stmts":null,"succs":[30,31]},{"id":30,"label":"then","preds":[29],"stmts":null,"succs":[31]},{"cond":"best is None or cand[0] < best[0]","id":31,"label":"merge","preds":[30,29],"stmts":null,"succs":[32,33]},{"id":32,"label":"then","preds":[31],"stmts":null,"succs":[33]},{"id":33,"label":"merge","preds":[32,31],"stmts":null,"succs":[5]}],"effects":["unknown"],"entry":0,"exits":[3,7],"func_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._rule_eval_hand","issues":null},"source":{"end_line":1657,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"method","language":"python","lines":[{"line":1613,"text":"    def _rule_eval_hand(self, side, rule, glove_cm=0.0):\r"},{"line":1614,"text":"        \"\"\"A contact rule whose region is a hand (on_hand: {side, segments, face back|pad|any}): the patch's points\r"},{"line":1615,"text":"        against those segments' skin, the glove counted on both; the facing is the patch's normal against the\r"},{"line":1616,"text":"        other skin's (pressed onto it reads 0); face back asks the touch to be on the backs of those fingers.\"\"\"\r"},{"line":1617,"text":"        oh = rule[\"on_hand\"]\r"},{"line":1618,"text":"        segs = {x[0]: x for x in self._segments(oh[\"side\"])}\r"},{"line":1619,"text":"        want = [segs[n + \"_\" + oh[\"side\"]] for n in oh[\"segments\"] if n + \"_\" + oh[\"side\"] in segs]\r"},{"line":1620,"text":"        pts = self._patch_points(side, rule[\"patch\"], glove_cm)\r"},{"line":1621,"text":"        if not pts or not want:\r"},{"line":1622,"text":"            return {\"id\": rule.get(\"id\"), \"met\": False, \"error\": 10.0, \"why\": \"no patch or no segments\"}\r"},{"line":1623,"text":"        lo, hi = rule.get(\"gap_cm\", [-0.1, 0.4])\r"},{"line":1624,"text":"        fmax = rule.get(\"facing_max_deg\", 60.0)\r"},{"line":1625,"text":"        g = glove_cm / 100.0\r"},{"line":1626,"text":"        acr, k_ = self._hand_frame(oh[\"side\"])\r"},{"line":1627,"text":"        best, good = None, 0\r"},{"line":1628,"text":"        for p, nv in pts:\r"},{"line":1629,"text":"            cand = None\r"},{"line":1630,"text":"            for name, a, b, r in want:\r"},{"line":1631,"text":"                ab = b - a\r"},{"line":1632,"text":"                t = 0.0 if ab.length_squared < 1e-12 else max(0.0, min(1.0, (p - a).dot(ab) / ab.length_squared))\r"},{"line":1633,"text":"                qa = a + ab * t\r"},{"line":1634,"text":"                rad = p - qa\r"},{"line":1635,"text":"                if rad.length < 1e-9:\r"},{"line":1636,"text":"                    continue\r"},{"line":1637,"text":"                n_out = rad.normalized()\r"},{"line":1638,"text":"                gap = (rad.length - r - g) * 100.0          # the patch point already carries its own skin and glove\r"},{"line":1639,"text":"                ang = math.degrees(nv.angle(-n_out)) if nv.length > 1e-9 else 180.0\r"},{"line":1640,"text":"                err = max(0.0, gap - hi) + max(0.0, lo - gap) + max(0.0, ang - fmax) / 30.0\r"},{"line":1641,"text":"                if oh.get(\"face\") in (\"back\", \"pad\"):\r"},{"line":1642,"text":"                    pad = (acr.cross(ab.normalized()) * k_).normalized()\r"},{"line":1643,"text":"                    side_ok = n_out.dot(-pad if oh[\"face\"] == \"back\" else pad)\r"},{"line":1644,"text":"                    err += max(0.0, 0.3 - side_ok)\r"},{"line":1645,"text":"                if cand is None or err < cand[0]:\r"},{"line":1646,"text":"                    cand = (err, gap, ang, a.lerp(b, t), n_out)\r"},{"line":1647,"text":"            if cand is None:\r"},{"line":1648,"text":"                continue\r"},{"line":1649,"text":"            good += 1 if cand[0] <= 1e-6 else 0\r"},{"line":1650,"text":"            if best is None or cand[0] < best[0]:\r"},{"line":1651,"text":"                best = cand\r"},{"line":1652,"text":"        err, gap, ang, q, nn = best\r"},{"line":1653,"text":"        share = good / len(pts)\r"},{"line":1654,"text":"        err += 2.0 * max(0.0, rule.get(\"min_share\", 0.0) - share)\r"},{"line":1655,"text":"        return {\"id\": rule.get(\"id\"), \"patch\": rule[\"patch\"], \"met\": err <= 1e-6, \"error\": round(err, 3), \"gap_cm\": round(gap, 2),\r"},{"line":1656,"text":"                \"facing_deg\": round(ang), \"share\": round(share, 2), \"min_share\": rule.get(\"min_share\", 0.0), \"touch\": q, \"normal\": nn,\r"},{"line":1657,"text":"                \"on_hand\": oh[\"side\"]}\r"}],"name":"_rule_eval_hand","start_line":1613,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._rule_eval_hand"}}
