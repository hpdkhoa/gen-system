all","line":2171,"text":"p = (min(max(dists_cm), max(min(dists_cm), d + rnd.uniform(-0.6, 0.6))), ta + rnd.uniform(-8, 8), tb + rnd.uniform(-8, 8), roll + rnd.uniform(-12, 12),"},{"kind":"call","line":2172,"text":"sa + rnd.uniform(-0.6, 0.6), sb + rnd.uniform(-0.6, 0.6))"},{"kind":"call","line":2173,"text":"sc, why = full(p)"}],"preds":[40],"stmts":["call min","call max","call max","call min","call rnd.uniform","call rnd.uniform","call rnd.uniform","call rnd.uniform","call rnd.uniform","call rnd.uniform","call full"],"succs":[43,44]},{"id":42,"label":"loop_exit","lines":[{"kind":"call","line":2176,"text":"sc, why = full(best[1])"},{"kind":"call","line":2177,"text":"return {\"score\": round(sc, 2), \"place\": [round(x, 2) for x in best[1]], \"tried_cheap\": len(cheap), \"tried_full\": keep + refine,"}],"preds":[40],"stmts":["call full","call round"],"succs":[45]},{"id":43,"label":"then","preds":[41],"stmts":null,"succs":[44]},{"id":44,"label":"merge","preds":[43,41],"stmts":null,"succs":[40]},{"cond":"for x in best[1]","id":45,"label":"loop_header","preds":[42,46],"stmts":null,"succs":[46,47]},{"id":46,"label":"loop_body","lines":[{"kind":"call","line":2177,"text":"return {\"score\": round(sc, 2), \"place\": [round(x, 2) for x in best[1]], \"tried_cheap\": len(cheap), \"tried_full\": keep + refine,"}],"preds":[45],"stmts":["call round"],"succs":[45]},{"id":47,"label":"loop_exit","lines":[{"kind":"call","line":2177,"text":"return {\"score\": round(sc, 2), \"place\": [round(x, 2) for x in best[1]], \"tried_cheap\": len(cheap), \"tried_full\": keep + refine,"}],"preds":[45],"stmts":["call len"],"succs":[48]},{"cond":"for (k, v) in why.items()","id":48,"label":"loop_header","preds":[47,52],"stmts":null,"succs":[49,50]},{"cond":"k != 'arm'","id":49,"label":"loop_body","preds":[48],"stmts":null,"succs":[51,52]},{"id":50,"label":"loop_exit","lines":[{"kind":"call","line":2178,"text":"**{k: v for k, v in why.items() if k != \"arm\"}, \"wrist_bend_deg\": why[\"arm\"].get(\"wrist_bend_deg\"),"},{"kind":"call","line":2179,"text":"\"forearm_rotation_deg\": why[\"arm\"].get(\"forearm_rotation_deg\"), \"elbow_bend_deg\": why[\"arm\"].get(\"elbow_bend_deg\")}"},{"kind":"return","line":2177,"text":"return {\"score\": round(sc, 2), \"place\": [round(x, 2) for x in best[1]], \"tried_cheap\": len(cheap), \"tried_full\": keep + refine,"}],"preds":[48],"stmts":["call ?.get","call ?.get","call ?.get","return"],"succs":null},{"id":51,"label":"then","preds":[49],"stmts":null,"succs":[52]},{"id":52,"label":"merge","preds":[51,49],"stmts":null,"succs":[48]}],"effects":["unknown"],"entry":0,"exits":[50],"func_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.natural_hold","issues":null},"source":{"end_line":2179,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"method","language":"python","lines":[{"line":2093,"text":"    def natural_hold(self, side, centre, normal, rules, plan=None, glove_cm=0.0, other=True, soft=None,\r"},{"line":2094,"text":"                     axis=None, dists_cm=(0.0, 1.0, 2.0), cone_deg=60.0, keep=40, refine=40, seed=5, slide_cm=(-2.0, 0.0, 2.0)):\r"},{"line":2095,"text":"        \"\"\"A hand's hold found over the whole arm's range, as a body would take it: palm places off a surface\r"},{"line":2096,"text":"        (centre, its outward normal; dists_cm farther out, for a palm over another hand), the palm facing anywhere\r"},{"line":2097,"text":"        within cone_deg of into the surface and the fingers pointing any way round it. Each place is reached by the\r"},{"line":2098,"text":"        arm (shoulder, clavicle, elbow, forearm, wrist) and scored first for the arm alone: its rules (hard), how far\r"},{"line":2099,"text":"        the wrist bends, the forearm rolls and the elbow straightens. The keep most natural are then closed (the\r"},{"line":2100,"text":"        plan's digits) and scored by the contact rules and the presses too, and the best refined round itself.\r"},{"line":2101,"text":"        Returns the scores and the arm at the end.\"\"\"\r"},{"line":2102,"text":"        import random as _random\r"},{"line":2103,"text":"        self._need()\r"},{"line":2104,"text":"        rnd = _random.Random(seed)\r"},{"line":2105,"text":"        Lm = self._limits()[0]\r"},{"line":2106,"text":"        tree = self._tree()\r"},{"line":2107,"text":"        hn = self._n(\"hand\", side)\r"},{"line":2108,"text":"        nrm = Vector(normal).normalized()\r"},{"line":2109,"text":"        ax = Vector(axis).normalized() if axis is not None else nrm.orthogonal().normalized()\r"},{"line":2110,"text":"        ax = (ax - nrm * ax.dot(nrm)).normalized()\r"},{"line":2111,"text":"        bx = nrm.cross(ax).normalized()\r"},{"line":2112,"text":"        H0 = self._bw(hn).copy()\r"},{"line":2113,"text":"        self.snapshot(\"save\", \"_natural\")\r"},{"line":2114,"text":"\r"},{"line":2115,"text":"        def hand_at(dist, tilt_a, tilt_b, roll, sa=0.0, sb=0.0):\r"},{"line":2116,"text":"            # the palm facing into the surface, tilted, then turned about its own facing; its middle at the place\r"},{"line":2117,"text":"            # (slid sa along the axis and sb across it on the surface)\r"},{"line":2118,"text":"            face = -nrm\r"},{"line":2119,"text":"            face = (Quaternion(ax, math.radians(tilt_a)) @ Quaternion(bx, math.radians(tilt_b)) @ face).normalized()\r"},{"line":2120,"text":"            P = Vector(centre) + nrm * (dist / 100.0) + ax * (sa / 100.0) + bx * (sb / 100.0)\r"},{"line":2121,"text":"            self.snapshot(\"load\", \"_natural\")\r"},{"line":2122,"text":"            H = self._bw(hn)\r"},{"line":2123,"text":"            w = H.translation\r"},{"line":2124,"text":"            mid = self._bw(self._n(\"finger\", side, \"middle\", \"01\")).translation\r"},{"line":2125,"text":"            pc = w.lerp(mid, 0.5)\r"},{"line":2126,"text":"            q = self._palm_facing(side).rotation_difference(face)\r"},{"line":2127,"text":"            R = Matrix.Translation(pc) @ q.to_matrix().to_4x4() @ Matrix.Translation(-pc) @ H\r"},{"line":2128,"text":"            R = Matrix.Translation(pc) @ Quaternion(face, math.radians(roll)).to_matrix().to_4x4() @ Matrix.Translation(-pc) @ R\r"},{"line":2129,"text":"            R = Matrix.Translation(P - pc) @ R\r"},{"line":2130,"text":"            return Matrix.LocRotScale(R.translation, R.to_quaternion(), self._unit())\r"},{"line":2131,"text":"\r"},{"line":2132,"text":"        cheap = []\r"},{"line":2133,"text":"        # the palm's own rules (palm, heel) measured on each place too: a relaxed arm away from the gun holds nothing\r"},{"line":2134,"text":"        palm_rules = [r_ for r_ in (rules or []) if r_[\"patch\"].split(\":\")[0] in (\"palm\", \"heel\")]\r"},{"line":2135,"text":"        vv0 = self._gun_verts()\r"},{"line":2136,"text":"        tilts = [t for t in range(-int(cone_deg), int(cone_deg) + 1, 20)]\r"},{"line":2137,"text":"        for d in dists_cm:\r"},{"line":2138,"text":"            for sa in slide_cm:\r"},{"line":2139,"text":"                for sb in slide_cm:\r"},{"line":2140,"text":"                    for ta in tilts:\r"},{"line":2141,"text":"                        for tb in tilts:\r"},{"line":2142,"text":"                            for roll in range(0, 360, 30):\r"},{"line":2143,"text":"                                M = hand_at(d, ta, tb, roll, sa, sb)\r"},{"line":2144,"text":"                                short = self._put_hand(side, M)\r"},{"line":2145,"text":"                                bpy.context.view_layer.update()\r"},{"line":2146,"text":"                                sc, _r, _b = self._comfort(side, Lm)\r"},{"line":2147,"text":"                                pe = sum(self._rule_eval(side, r_, glove_cm, vv0)[\"error\"] for r_ in palm_rules)\r"},{"line":2148,"text":"                                cheap.append((sc + 4.0 * short + 8.0 * pe, (d, ta, tb, roll, sa, sb)))\r"},{"line":2149,"text":"        cheap.sort(key=lambda x: x[0])\r"},{"line":2150,"text":"\r"},{"line":2151,"text":"        def full(p):\r"},{"line":2152,"text":"            M = hand_at(*p)\r"},{"line":2153,"text":"            short = self._put_hand(side, M)\r"},{"line":2154,"text":"            bpy.context.view_layer.update()\r"},{"line":2155,"text":"            self.close_hand(side, plan, tree, glove_cm, other, rules=rules)\r"},{"line":2156,"text":"            vv = self._gun_verts()\r"},{"line":2157,"text":"            err = sum(self._rule_eval(side, r_, glove_cm, vv)[\"error\"] * (1.0 if r_.get(\"need\", \"required\") == \"required\" else 0.3)\r"},{"line":2158,"text":"                      for r_ in (rules or []))\r"},{"line":2159,"text":"            pen, worst = self.hand_presses(side, tree, glove_cm, other=other, soft=soft)\r"},{"line":2160,"text":"            cm, rep_, bad = self._comfort(side, Lm)\r"},{"line":2161,"text":"            return 8.0 * err + 25.0 * pen + cm + 4.0 * short, {\"rules_error\": round(err, 3), \"press\": round(pen, 3),\r"},{"line":2162,"text":"                                                              \"presses\": worst, \"comfort\": round(cm, 2), \"arm\": rep_, \"arm_bad\": bad}\r"},{"line":2163,"text":"\r"},{"line":2164,"text":"        best = None\r"},{"line":2165,"text":"        for _sc, p in cheap[:keep]:\r"},{"line":2166,"text":"            sc, why = full(p)\r"},{"line":2167,"text":"            if best is None or sc < best[0]:\r"},{"line":2168,"text":"                best = (sc, p, why)\r"},{"line":2169,"text":"        for _ in range(refine):\r"},{"line":2170,"text":"            d, ta, tb, roll, sa, sb = best[1]\r"},{"line":2171,"text":"            p = (min(max(dists_cm), max(min(dists_cm), d + rnd.uniform(-0.6, 0.6))), ta + rnd.uniform(-8, 8), tb + rnd.uniform(-8, 8), roll + rnd.uniform(-12, 12),\r"},{"line":2172,"text":"                 sa + rnd.uniform(-0.6, 0.6), sb + rnd.uniform(-0.6, 0.6))\r"},{"line":2173,"text":"            sc, why = full(p)\r"},{"line":2174,"text":"            if sc < best[0]:\r"},{"line":2175,"text":"                best = (sc, p, why)\r"},{"line":2176,"text":"        sc, why = full(best[1])\r"},{"line":2177,"text":"        return {\"score\": round(sc, 2), \"place\": [round(x, 2) for x in best[1]], \"tried_cheap\": len(cheap), \"tried_full\": keep + refine,\r"},{"line":2178,"text":"                **{k: v for k, v in why.items() if k != \"arm\"}, \"wrist_bend_deg\": why[\"arm\"].get(\"wrist_bend_deg\"),\r"},{"line":2179,"text":"                \"forearm_rotation_deg\": why[\"arm\"].get(\"forearm_rotation_deg\"), \"elbow_bend_deg\": why[\"arm\"].get(\"elbow_bend_deg\")}\r"}],"name":"natural_hold","start_line":2093,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.natural_hold"}}
