elf._n(\"finger\", s, \"index\", \"01\")).translation - wrist\r"},{"line":2924,"text":"        palm = across.cross((mid - wrist).normalized()) * k\r"},{"line":2925,"text":"        palm = palm.normalized() if palm.length > 1e-9 else palm\r"},{"line":2926,"text":"        pts = [b(\"01\"), b(\"02\"), b(\"03\"), self._finger_tip(\"thumb\", s)]\r"},{"line":2927,"text":"        meta = pts[1] - pts[0]\r"},{"line":2928,"text":"        asin = lambda x: math.degrees(math.asin(max(-1.0, min(1.0, x))))\r"},{"line":2929,"text":"        spread = self._deg(meta, index_meta)\r"},{"line":2930,"text":"        palmar = asin(meta.normalized().dot(palm)) if meta.length > 1e-9 else 0.0\r"},{"line":2931,"text":"        out = {\"cmc_spread_deg\": round(spread), \"cmc_palmar_deg\": round(palmar)}\r"},{"line":2932,"text":"        bad, axes = [], {}\r"},{"line":2933,"text":"        if round(spread) > TL[\"cmc_spread_max_deg\"]:\r"},{"line":2934,"text":"            bad.append(\"thumb base spread %.0f from the index (at most %.0f)\" % (spread, TL[\"cmc_spread_max_deg\"]))\r"},{"line":2935,"text":"        if round(palmar) < TL[\"cmc_palmar_min_deg\"]:\r"},{"line":2936,"text":"            bad.append(\"thumb base %.0f behind the palm (at most %.0f)\" % (-palmar, -TL[\"cmc_palmar_min_deg\"]))\r"},{"line":2937,"text":"        flex = (palm - across).normalized()          # a thumb bends across the palm toward the little finger\r"},{"line":2938,"text":"        ray = self.R.get(\"thumb_hinge\") == \"ray\"\r"},{"line":2939,"text":"        for i, j in ((0, \"02\"), (1, \"03\")):\r"},{"line":2940,"text":"            a, c = (pts[i + 1] - pts[i]), (pts[i + 2] - pts[i + 1])\r"},{"line":2941,"text":"            if a.length < 1e-9 or c.length < 1e-9:\r"},{"line":2942,"text":"                continue\r"},{"line":2943,"text":"            a, c = a.normalized(), c.normalized()\r"},{"line":2944,"text":"            if ray:\r"},{"line":2945,"text":"                # the hinge fixed in the thumb's own ray: the bend's way is the pad side of the bone before the\r"},{"line":2946,"text":"                # joint, which turns with it (an opposed thumb rolls its hinges with its metacarpal)\r"},{"line":2947,"text":"                pn = self._n(\"finger\", s, \"thumb\", \"0%d\" % (i + 1))\r"},{"line":2948,"text":"                flex = (self._bw(pn).to_quaternion() @ self._thumb_pad_axis(s, \"0%d\" % (i + 1))).normalized()\r"},{"line":2949,"text":"            f_perp = flex - a * flex.dot(a)\r"},{"line":2950,"text":"            if f_perp.length < 1e-6:\r"},{"line":2951,"text":"                continue\r"},{"line":2952,"text":"            f_perp.normalize()\r"},{"line":2953,"text":"            axis = a.cross(f_perp).normalized()      # the hinge: turning about it moves c toward flex\r"},{"line":2954,"text":"            in_plane = c - axis * c.dot(axis)\r"},{"line":2955,"text":"            bend = math.degrees(math.atan2(in_plane.dot(f_perp), in_plane.dot(a))) if in_plane.length > 1e-9 else 0.0\r"},{"line":2956,"text":"            side_deg = asin(c.dot(axis))\r"},{"line":2957,"text":"            axes[j] = axis\r"},{"line":2958,"text":"            lo, hi, sd = TL[j]\r"},{"line":2959,"text":"            out[\"thumb_\" + j] = [round(bend), round(side_deg)]\r"},{"line":2960,"text":"            if round(bend) < lo:\r"},{"line":2961,"text":"                bad.append(\"thumb %s bent %.0f backward (hyperextended; at most %.0f)\" % (THUMB_JOINTS[j], -bend, -lo))\r"},{"line":2962,"text":"            elif round(bend) > hi:\r"},{"line":2963,"text":"                bad.append(\"thumb %s bent %.0f (at most %.0f)\" % (THUMB_JOINTS[j], bend, hi))\r"},{"line":2964,"text":"            if abs(round(side_deg)) > sd:\r"},{"line":2965,"text":"                bad.append(\"thumb %s bent %.0f out of its hinge's plane (at most %.0f)\" % (THUMB_JOINTS[j], abs(side_deg), sd))\r"},{"line":2966,"text":"        return out, bad, axes\r"}],"name":"_thumb_report","start_line":2915,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._thumb_report"}}
