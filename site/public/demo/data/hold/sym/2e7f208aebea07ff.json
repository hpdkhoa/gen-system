 p[i] >= value) if keep == \"above\" else (lambda p: p[i] <= value)\r"},{"line":43,"text":"    out = []\r"},{"line":44,"text":"    for k, a in enumerate(outline):\r"},{"line":45,"text":"        b = outline[(k + 1) % len(outline)]\r"},{"line":46,"text":"        if inside(a):\r"},{"line":47,"text":"            out.append(list(a))\r"},{"line":48,"text":"        if inside(a) != inside(b):\r"},{"line":49,"text":"            t = (value - a[i]) / (b[i] - a[i])\r"},{"line":50,"text":"            out.append([round(a[0] + (b[0] - a[0]) * t, 4), round(a[1] + (b[1] - a[1]) * t, 4)])\r"},{"line":51,"text":"    return out\r"}],"name":"clip","start_line":39,"symbol_id":"hold-code/weaponlab/blueprint/plan.py#func:clip"}}
