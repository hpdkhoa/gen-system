83,"text":"def build_all(facts_path, grip_steps=3, style=None, character=None):\r"},{"line":284,"text":"    \"\"\"Every clip of one gun: the hand clips first (they settle where a carried part goes), then the gun's own clips\r"},{"line":285,"text":"    with those parts' tracks. Returns both reports.\"\"\"\r"},{"line":286,"text":"    facts = json.loads(Path(facts_path).read_text(encoding=\"utf-8\"))\r"},{"line":287,"text":"    a = A.load(facts[\"action\"])\r"},{"line":288,"text":"    h = hands(facts_path, grip_steps=grip_steps, style=style, character=character)\r"},{"line":289,"text":"    resolved = {}\r"},{"line":290,"text":"    for cid, v in h[\"clips\"].items():\r"},{"line":291,"text":"        if cid in a[\"gun_clips\"] and any(isinstance(x, dict) and \"at\" in x for fr in v[\"resolved\"][\"frames\"] for x in fr[\"parts\"].values()):\r"},{"line":292,"text":"            resolved[cid] = v[\"resolved\"]\r"},{"line":293,"text":"    c = gun_clips(facts_path, resolved=resolved)\r"},{"line":294,"text":"    return {\"hands\": {k: v[\"checks\"] for k, v in h[\"clips\"].items()}, \"holds\": h.get(\"holds\"), \"clips\": c, \"resolved\": list(resolved)}\r"}],"name":"build_all","start_line":283,"symbol_id":"hold-code/weaponlab/gunkit/run.py#func:build_all"}}
