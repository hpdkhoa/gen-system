],"preds":[8,7],"stmts":["call bool"],"succs":[10,11]},{"id":10,"label":"then","preds":[9],"stmts":null,"succs":[11]},{"id":11,"label":"merge","lines":[{"kind":"return","line":830,"text":"return GRASPS[key]"}],"preds":[10,9],"stmts":["return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[3,11],"func_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:grasp","issues":null},"source":{"end_line":830,"file":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py","kind":"func","language":"python","lines":[{"line":812,"text":"def grasp(side, mark, part=None, offset=None, start=None):\r"},{"line":813,"text":"    \"\"\"The hand's hold on a mark (_grasp_solve), checked against the walls whichever way it was found: the hold is\r"},{"line":814,"text":"    posed, its walls read, and a hold past any wall is recorded as failed with the walls it breaks (report\r"},{"line":815,"text":"    \"walls\"); it never counts as found.\"\"\"\r"},{"line":816,"text":"    key = (side, mark, part, tuple(offset or ()))\r"},{"line":817,"text":"    if key in GRASPS:\r"},{"line":818,"text":"        return GRASPS[key]\r"},{"line":819,"text":"    rel, fingers, found = _grasp_solve(side, mark, part, offset, start)\r"},{"line":820,"text":"    L.snapshot(\"save\", \"_wall_check\")\r"},{"line":821,"text":"    L._put_hand(side, bone_world(mark_bone(mark, part)) @ rel)      # as every solver stored it: against the mark's bone\r"},{"line":822,"text":"    for n_, q_ in fingers.items():\r"},{"line":823,"text":"        L.arm.pose.bones[n_].rotation_quaternion = q_\r"},{"line":824,"text":"    bpy.context.view_layer.update()\r"},{"line":825,"text":"    w_ = L.wall_faults(side, other=True)\r"},{"line":826,"text":"    L.snapshot(\"load\", \"_wall_check\")\r"},{"line":827,"text":"    if w_:\r"},{"line":828,"text":"        report.setdefault(\"walls\", {})[\"%s:%s\" % (side, mark)] = {k: round(v, 2) for k, v in w_.items()}\r"},{"line":829,"text":"    GRASPS[key] = (rel, fingers, bool(found) and not w_)\r"},{"line":830,"text":"    return GRASPS[key]\r"}],"name":"grasp","start_line":812,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:grasp"}}
