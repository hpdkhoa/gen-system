{"flow":{"kind":"var","name":"twists","noCFG":true,"reason":"twists is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":70,"file":"hold-code/weaponlab/blender/roll.py","kind":"var","language":"python","lines":[{"line":30,"text":"twists = [(P[n], k) for n, k in ((\"lowerarm_twist_01_\" + side, 1 / 3), (\"lowerarm_twist_02_\" + side, 2 / 3)) if n in P]\r"},{"line":31,"text":"for b, _ in twists:\r"},{"line":32,"text":"    assert b.parent == lower, \"%s is not the forearm's child\" % b.name\r"},{"line":33,"text":"assert hand.parent == lower, \"the hand is not the forearm's child\"\r"},{"line":34,"text":"W = arm.matrix_world\r"},{"line":35,"text":"\r"},{"line":36,"text":"\r"},{"line":37,"text":"def axis_now():\r"},{"line":38,"text":"    a = (W @ hand.head) - (W @ lower.head)\r"},{"line":39,"text":"    return a.normalized()\r"},{"line":40,"text":"\r"},{"line":41,"text":"\r"},{"line":42,"text":"def turned(pb, ang, axis):\r"},{"line":43,"text":"    \"\"\"pb's armature-space matrix turned by ang about the forearm's line (through pb's head).\"\"\"\r"},{"line":44,"text":"    ax = W.to_3x3().inverted() @ axis\r"},{"line":45,"text":"    head = pb.matrix.translation.copy()\r"},{"line":46,"text":"    return Matrix.Translation(head) @ Matrix.Rotation(ang, 4, ax.normalized()) @ Matrix.Translation(-head) @ pb.matrix\r"},{"line":47,"text":"\r"},{"line":48,"text":"\r"},{"line":49,"text":"def profile():\r"},{"line":50,"text":"    out = []\r"},{"line":51,"text":"    for f in range(f0, f1 + 1, max(1, (f1 - f0) // 12)):\r"},{"line":52,"text":"        sc.frame_set(f)\r"},{"line":53,"text":"        ax = axis_now()\r"},{"line":54,"text":"        k = (W @ P[\"index_01_\" + side].head) - (W @ P[\"pinky_01_\" + side].head)\r"},{"line":55,"text":"        k = (k - ax * k.dot(ax)).normalized()\r"},{"line":56,"text":"        up = Vector((0, 0, 1))\r"},{"line":57,"text":"        up = (up - ax * up.dot(ax)).normalized()\r"},{"line":58,"text":"        out.append((f, round(math.degrees(math.atan2(k.dot(ax.cross(up)), k.dot(up))))))\r"},{"line":59,"text":"    return out\r"},{"line":60,"text":"\r"},{"line":61,"text":"\r"},{"line":62,"text":"if want == \"measure\":\r"},{"line":63,"text":"    pr = profile()\r"},{"line":64,"text":"    print(\"MOTIONLAB PROFILE %s\" % \" \".join(\"%d:%d\" % fa for fa in pr))\r"},{"line":65,"text":"    print(\"MOTIONLAB PROFILE WORST %d\" % max(abs(a) for _, a in pr))\r"},{"line":66,"text":"    sys.exit(0)\r"},{"line":67,"text":"sc.frame_set(f0)\r"},{"line":68,"text":"if want == \"auto\":\r"},{"line":69,"text":"    axis = axis_now()\r"},{"line":70,"text":"    across = (W @ P[\"index_01_\" + side].head) - (W @ P[\"pinky_01_\" + side].head)\r"}],"name":"twists","start_line":30,"symbol_id":"hold-code/weaponlab/blender/roll.py#var:twists"}}
