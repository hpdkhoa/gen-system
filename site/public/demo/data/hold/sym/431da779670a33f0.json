{"flow":{"blocks":[{"id":0,"label":"entry","lines":[{"kind":"call","line":689,"text":"res = self.hold_purposes(side, marks, glove_cm, other=other)"},{"kind":"call","line":693,"text":"perr = sum(r[\"error\"] * PRIMARY.get(r[\"purpose\"], 1.0) for r in res)"},{"kind":"call","line":696,"text":"hard = sum(1 for r in res if r.get(\"hard\") and not r[\"met\"])"},{"kind":"call","line":697,"text":"FL = self._limits()[1]"},{"kind":"call","line":698,"text":"TL = self._thumb_limits()"},{"kind":"call","line":699,"text":"fbad = len(self._finger_report(side, FL)[1]) + len(self._thumb_report(side, TL)[1])"},{"kind":"call","line":700,"text":"abad = len(self._arm_report(side, self._limits()[0])[1])"},{"kind":"call","line":702,"text":"pr = next((r for r in res if r[\"purpose\"] == \"press\"), {})"},{"kind":"call","line":703,"text":"return sc, {\"purposes_error\": round(perr, 3), \"press\": round(pr.get(\"object_cm2\", 0.0) + pr.get(\"hand_cm2\", 0.0), 3),"}],"preds":null,"stmts":["call self.hold_purposes","call sum","call PRIMARY.get","call sum","call r.get","call self._limits","call self._thumb_limits","call len","call self._finger_report","call len","call self._thumb_report","call len","call self._arm_report","call self._limits","call next","call round","call round","call pr.get","call pr.get","return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[0],"func_id":"hold-code/poselab_mcp/blender/holdlab.py#method:HoldMixin._hold_score","issues":null},"source":{"end_line":704,"file":"hold-code/poselab_mcp/blender/holdlab.py","kind":"method","language":"python","lines":[{"line":686,"text":"    def _hold_score(self, side, marks, glove_cm, other, soft, tree):\r"},{"line":687,"text":"        \"\"\"The search's score is the gate's ruler: each purpose's error (the contact pairs, the presses on the drawn\r"},{"line":688,"text":"        skin, the comfort) 10, each body rule broken 200.\"\"\"\r"},{"line":689,"text":"        res = self.hold_purposes(side, marks, glove_cm, other=other)\r"},{"line":690,"text":"        # the hand's job first: the grip itself (a power wrap, a support) counts three times its refinements (the\r"},{"line":691,"text":"        # thumb's and the index's lines), so no search trades the palm on the grip for a finer line\r"},{"line":692,"text":"        PRIMARY = {\"power_wrap\": 3.0, \"support\": 3.0}\r"},{"line":693,"text":"        perr = sum(r[\"error\"] * PRIMARY.get(r[\"purpose\"], 1.0) for r in res)\r"},{"line":694,"text":"        # the hard rules (no clipping either way, digits as a holding hand's) are never traded: each broken one costs\r"},{"line":695,"text":"        # as much as a broken body rule\r"},{"line":696,"text":"        hard = sum(1 for r in res if r.get(\"hard\") and not r[\"met\"])\r"},{"line":697,"text":"        FL = self._limits()[1]\r"},{"line":698,"text":"        TL = self._thumb_limits()\r"},{"line":699,"text":"        fbad = len(self._finger_report(side, FL)[1]) + len(self._thumb_report(side, TL)[1])\r"},{"line":700,"text":"        abad = len(self._arm_report(side, self._limits()[0])[1])\r"},{"line":701,"text":"        sc = 10.0 * perr + 200.0 * (fbad + abad + hard)\r"},{"line":702,"text":"        pr = next((r for r in res if r[\"purpose\"] == \"press\"), {})\r"},{"line":703,"text":"        return sc, {\"purposes_error\": round(perr, 3), \"press\": round(pr.get(\"object_cm2\", 0.0) + pr.get(\"hand_cm2\", 0.0), 3),\r"},{"line":704,"text":"                    \"presses\": [], \"digit_rules\": fbad, \"arm_rules\": abad, \"purposes\": res}\r"}],"name":"_hold_score","start_line":686,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#method:HoldMixin._hold_score"}}
