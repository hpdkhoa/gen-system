ctures, the share of it that is drawn (ink outside the words) and its\r"},{"line":78,"text":"    captions. The kind follows: table (a page of numbers), figure (mostly drawn), text, mixed or blank.\"\"\"\r"},{"line":79,"text":"    import numpy as np\r"},{"line":80,"text":"    doc = store.load(gun, \"sources\")\r"},{"line":81,"text":"    src = _source(doc, source_id)\r"},{"line":82,"text":"    out = []\r"},{"line":83,"text":"    if not src[\"file\"].lower().endswith(\".pdf\"):\r"},{"line":84,"text":"        out.append({\"source\": source_id, \"page\": 1, \"kind\": \"figure\", \"text_chars\": 0, \"images\": 1, \"drawn\": 1.0, \"captions\": []})\r"},{"line":85,"text":"    else:\r"},{"line":86,"text":"        pdf = _pdf().open(src[\"file\"])\r"},{"line":87,"text":"        for i, page in enumerate(pdf):\r"},{"line":88,"text":"            text = page.get_text()\r"},{"line":89,"text":"            words = page.get_text(\"words\")\r"},{"line":90,"text":"            pix = page.get_pixmap(dpi=40, colorspace=_pdf().csGRAY)\r"},{"line":91,"text":"            img = np.frombuffer(pix.samples, dtype=np.uint8).reshape(pix.height, pix.width)\r"},{"line":92,"text":"            ink = img < 128\r"},{"line":93,"text":"            sx, sy = pix.width / page.rect.width, pix.height / page.rect.height\r"},{"line":94,"text":"            for w in words:                         # the words' own boxes are text, not drawing\r"},{"line":95,"text":"                ink[int(w[1] * sy):int(w[3] * sy) + 1, int(w[0] * sx):int(w[2] * sx) + 1] = False\r"},{"line":96,"text":"            drawn = float(ink.mean())\r"},{"line":97,"text":"            digits = sum(c.isdigit() for c in text)\r"},{"line":98,"text":"            caps = [m.group(0).strip()[:100] for m in CAPTION.finditer(text)][:6]\r"},{"line":99,"text":"            if len(text.strip()) < 20 and drawn < 0.005:\r"},{"line":100,"text":"                kind = \"blank\"\r"},{"line":101,"text":"            elif (drawn > 0.04 and (len(text) < 900 or caps)) or (drawn > 0.015 and len(text) < 600):\r"},{"line":102,"text":"                kind = \"figure\"\r"},{"line":103,"text":"            elif digits > 0.08 * max(len(text), 1) and len(text) > 200:\r"},{"line":104,"text":"                kind = \"table\"\r"},{"line":105,"text":"            elif drawn > 0.02:\r"},{"line":106,"text":"                kind = \"mixed\"\r"},{"line":107,"text":"            else:\r"},{"line":108,"text":"                kind = \"text\"\r"},{"line":109,"text":"            out.append({\"source\": source_id, \"page\": i + 1, \"kind\": kind, \"text_chars\": len(text),\r"},{"line":110,"text":"                        \"images\": len(page.get_images()), \"drawn\": round(drawn, 4), \"captions\": caps})\r"},{"line":111,"text":"    doc[\"pages\"] = [p for p in doc.get(\"pages\", []) if p[\"source\"] != source_id] + out\r"},{"line":112,"text":"    store.save(gun, \"sources\", doc)\r"},{"line":113,"text":"    counts = {}\r"},{"line":114,"text":"    for p in out:\r"},{"line":115,"text":"        counts[p[\"kind\"]] = counts.get(p[\"kind\"], 0) + 1\r"},{"line":116,"text":"    return {\"source\": source_id, \"pages\": len(out), \"kinds\": counts,\r"},{"line":117,"text":"            \"figures\": [{\"page\": p[\"page\"], \"drawn\": p[\"drawn\"], \"captions\": p[\"captions\"]} for p in out if p[\"kind\"] == \"figure\"],\r"},{"line":118,"text":"            \"tables\": [p[\"page\"] for p in out if p[\"kind\"] == \"table\"]}\r"}],"name":"scan","start_line":76,"symbol_id":"hold-code/weaponlab/blueprint/sources.py#func:scan"}}
