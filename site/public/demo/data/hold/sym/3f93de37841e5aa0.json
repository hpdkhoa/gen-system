,"succs":[25]},{"id":24,"label":"loop_exit","lines":[{"kind":"call","line":3844,"text":"return {\"total\": round(total / float(W * H), 3), \"lower_left\": round(ll / float(third), 3),"},{"kind":"call","line":3845,"text":"\"bottom_middle\": round(bm / float(third), 3), \"hand_l_shown\": self.hand_shown(\"l\")}"},{"kind":"return","line":3844,"text":"return {\"total\": round(total / float(W * H), 3), \"lower_left\": round(ll / float(third), 3),"}],"preds":[22],"stmts":["call round","call float","call round","call float","call round","call float","call self.hand_shown","return"],"succs":null},{"cond":"for x in range(W)","id":25,"label":"loop_header","preds":[23,31],"stmts":null,"succs":[26,27]},{"cond":"px[(y * W + x) * 4 + 3] <= 0.5","id":26,"label":"loop_body","preds":[25],"stmts":null,"succs":[28,29]},{"id":27,"label":"loop_exit","preds":[25],"stmts":null,"succs":[22]},{"id":28,"label":"then","preds":[26],"stmts":null,"succs":[29]},{"cond":"y < H // 3","id":29,"label":"merge","preds":[28,26],"stmts":null,"succs":[30,31]},{"cond":"x < W // 3","id":30,"label":"then","preds":[29],"stmts":null,"succs":[32,34]},{"id":31,"label":"merge","preds":[33,29],"stmts":null,"succs":[25]},{"id":32,"label":"then","preds":[30],"stmts":null,"succs":[33]},{"id":33,"label":"merge","preds":[32,36],"stmts":null,"succs":[31]},{"cond":"x < 2 * W // 3","id":34,"label":"else","preds":[30],"stmts":null,"succs":[35,36]},{"id":35,"label":"then","preds":[34],"stmts":null,"succs":[36]},{"id":36,"label":"merge","preds":[35,34],"stmts":null,"succs":[33]}],"effects":["fs"],"entry":0,"exits":[24],"func_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.view_cover","issues":null},"source":{"end_line":3845,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"method","language":"python","lines":[{"line":3787,"text":"    def view_cover(self, size=(192, 108)):\r"},{"line":3788,"text":"        \"\"\"The share of the player's view the arms cover: all of it, its lower left third and its bottom middle third.\r"},{"line":3789,"text":"        The arms render alone from the eye (90 degrees, 16:9) as a mask, the rifle hidden, their back faces culled as a\r"},{"line":3790,"text":"        game culls them (a shoulder the near plane cuts open shows nothing inside). A forearm or sleeve that fills the\r"},{"line":3791,"text":"        lower left hides the gun's left side and the world; ToangTown's Game Probe measures the same in the game (within\r"},{"line":3792,"text":"        about 0.06 of it on the AKS-74U arms, 2026-10-13).\"\"\"\r"},{"line":3793,"text":"        self._need()\r"},{"line":3794,"text":"        hidden = []\r"},{"line":3795,"text":"        for o in self.sc.objects:\r"},{"line":3796,"text":"            if o.type == 'MESH' and o not in self.meshes and not o.hide_render:\r"},{"line":3797,"text":"                o.hide_render = True\r"},{"line":3798,"text":"                hidden.append(o)\r"},{"line":3799,"text":"        cam_data = bpy.data.cameras.get(\"poselab\") or bpy.data.cameras.new(\"poselab\")\r"},{"line":3800,"text":"        cam = bpy.data.objects.get(\"poselab\") or bpy.data.objects.new(\"poselab\", cam_data)\r"},{"line":3801,"text":"        if cam.name not in self.sc.collection.objects:\r"},{"line":3802,"text":"            self.sc.collection.objects.link(cam)\r"},{"line":3803,"text":"        cam_data.lens_unit = 'FOV'\r"},{"line":3804,"text":"        cam_data.angle = math.radians(H_FOV)\r"},{"line":3805,"text":"        cam_data.clip_start = 0.05\r"},{"line":3806,"text":"        cam.location = self.eye\r"},{"line":3807,"text":"        cam.rotation_euler = VIEW_FWD.to_track_quat('-Z', 'Y').to_euler()\r"},{"line":3808,"text":"        self.sc.camera = cam\r"},{"line":3809,"text":"        r = self.sc.render\r"},{"line":3810,"text":"        keep = (r.engine, r.resolution_x, r.resolution_y, r.film_transparent, r.filepath, self.sc.display.render_aa)\r"},{"line":3811,"text":"        shading = self.sc.display.shading\r"},{"line":3812,"text":"        keep_cull = shading.show_backface_culling\r"},{"line":3813,"text":"        shading.show_backface_culling = True\r"},{"line":3814,"text":"        r.engine = 'BLENDER_WORKBENCH'\r"},{"line":3815,"text":"        r.resolution_x, r.resolution_y = size\r"},{"line":3816,"text":"        r.film_transparent = True\r"},{"line":3817,"text":"        self.sc.display.render_aa = 'OFF'\r"},{"line":3818,"text":"        path = self._own(os.path.join(self.out_dir, \"renders\", \"_view_cover.png\"))\r"},{"line":3819,"text":"        os.makedirs(os.path.dirname(path), exist_ok=True)\r"},{"line":3820,"text":"        r.filepath = path\r"},{"line":3821,"text":"        try:\r"},{"line":3822,"text":"            bpy.ops.render.render(write_still=True)\r"},{"line":3823,"text":"        finally:\r"},{"line":3824,"text":"            for o in hidden:\r"},{"line":3825,"text":"                o.hide_render = False\r"},{"line":3826,"text":"            r.engine, r.resolution_x, r.resolution_y, r.film_transparent, r.filepath, self.sc.display.render_aa = keep\r"},{"line":3827,"text":"            shading.show_backface_culling = keep_cull\r"},{"line":3828,"text":"        img = bpy.data.images.load(path, check_existing=False)\r"},{"line":3829,"text":"        W, H = img.size\r"},{"line":3830,"text":"        px = list(img.pixels)\r"},{"line":3831,"text":"        bpy.data.images.remove(img)\r"},{"line":3832,"text":"        total = ll = bm = 0\r"},{"line":3833,"text":"        third = (W // 3) * (H // 3)\r"},{"line":3834,"text":"        for y in range(H):                     # Blender's rows start at the bottom\r"},{"line":3835,"text":"            for x in range(W):\r"},{"line":3836,"text":"                if px[(y * W + x) * 4 + 3] <= 0.5:\r"},{"line":3837,"text":"                    continue\r"},{"line":3838,"text":"                total += 1\r"},{"line":3839,"text":"                if y < H // 3:\r"},{"line":3840,"text":"                    if x < W // 3:\r"},{"line":3841,"text":"                        ll += 1\r"},{"line":3842,"text":"                    elif x < 2 * W // 3:\r"},{"line":3843,"text":"                        bm += 1\r"},{"line":3844,"text":"        return {\"total\": round(total / float(W * H), 3), \"lower_left\": round(ll / float(third), 3),\r"},{"line":3845,"text":"                \"bottom_middle\": round(bm / float(third), 3), \"hand_l_shown\": self.hand_shown(\"l\")}\r"}],"name":"view_cover","start_line":3787,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.view_cover"}}
