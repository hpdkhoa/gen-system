all across.cross","call d.normalized"],"succs":[37]}],"effects":["unknown"],"entry":0,"exits":[7,15,20,33],"func_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._patch_points","issues":null},"source":{"end_line":1542,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"method","language":"python","lines":[{"line":1491,"text":"    def _patch_points(self, side, patch, glove_cm=0.0, n=5):\r"},{"line":1492,"text":"        \"\"\"A named patch of the hand's skin as surface points with their outward normals (world): a digit's pad\r"},{"line":1493,"text":"        (the palm side of its middle and end segments), tip (the end segment's pad), base, back, whole; the palm\r"},{"line":1494,"text":"        (its palm side), heel (the palm side near the wrist), web (the thumb's first segment). Each point lies on\r"},{"line":1495,"text":"        the capsule's skin, the glove on it.\"\"\"\r"},{"line":1496,"text":"        digit, _, kind = patch.partition(\":\")\r"},{"line":1497,"text":"        kind = kind or \"pad\"\r"},{"line":1498,"text":"        segs = {x[0]: x for x in self._segments(side)}\r"},{"line":1499,"text":"        g = glove_cm / 100.0\r"},{"line":1500,"text":"        across, k = self._hand_frame(side)\r"},{"line":1501,"text":"        facing = self._palm_facing(side)\r"},{"line":1502,"text":"        out = []\r"},{"line":1503,"text":"\r"},{"line":1504,"text":"        def add(a, b, r, nrm_fn, t0=0.0, t1=1.0):\r"},{"line":1505,"text":"            for i in range(n):\r"},{"line":1506,"text":"                t = t0 + (t1 - t0) * (i + 0.5) / n\r"},{"line":1507,"text":"                c = a.lerp(b, t)\r"},{"line":1508,"text":"                nv = nrm_fn(b - a)\r"},{"line":1509,"text":"                if nv.length > 1e-9:\r"},{"line":1510,"text":"                    out.append((c + nv.normalized() * (r + g), nv.normalized()))\r"},{"line":1511,"text":"\r"},{"line":1512,"text":"        if digit in (\"palm\", \"heel\"):\r"},{"line":1513,"text":"            for nm in (\"palm_\", \"palmi_\", \"palmp_\"):\r"},{"line":1514,"text":"                x = segs.get(nm + side)\r"},{"line":1515,"text":"                if x:\r"},{"line":1516,"text":"                    add(x[1], x[2], x[3], lambda d: facing, 0.0, 0.5 if digit == \"heel\" else 1.0)\r"},{"line":1517,"text":"            return out\r"},{"line":1518,"text":"        if digit == \"web\":\r"},{"line":1519,"text":"            x = segs.get(\"thumb1_\" + side)\r"},{"line":1520,"text":"            if x:\r"},{"line":1521,"text":"                add(x[1], x[2], x[3], lambda d: (facing + across * (-k)).normalized())\r"},{"line":1522,"text":"            return out\r"},{"line":1523,"text":"        if digit == \"thumb\":\r"},{"line":1524,"text":"            for j in self.PATCH_SEGS.get(kind, (\"2\", \"3\")):\r"},{"line":1525,"text":"                x = segs.get(\"thumb%s_%s\" % (j, side))\r"},{"line":1526,"text":"                if not x:\r"},{"line":1527,"text":"                    continue\r"},{"line":1528,"text":"                d = (x[2] - x[1]).normalized()\r"},{"line":1529,"text":"                jj = \"0\" + j if len(j) == 1 else j\r"},{"line":1530,"text":"                bn = self._n(\"finger\", side, \"thumb\", jj)\r"},{"line":1531,"text":"                pad = self._bw(bn).to_quaternion() @ self._thumb_pad_axis(side, jj)\r"},{"line":1532,"text":"                pad = (pad - d * pad.dot(d))\r"},{"line":1533,"text":"                pad = pad.normalized() if pad.length > 1e-9 else facing\r"},{"line":1534,"text":"                add(x[1], x[2], x[3], (lambda d_, p_=pad: -p_) if kind == \"back\" else (lambda d_, p_=pad: p_))\r"},{"line":1535,"text":"            return out\r"},{"line":1536,"text":"        for j in self.PATCH_SEGS.get(kind if kind != \"back\" else \"whole\", (\"2\", \"3\")):\r"},{"line":1537,"text":"            x = segs.get(\"%s%s_%s\" % (digit, j, side))\r"},{"line":1538,"text":"            if not x:\r"},{"line":1539,"text":"                continue\r"},{"line":1540,"text":"            pad_fn = (lambda d: (across.cross(d.normalized()) * k)) if kind != \"back\" else (lambda d: -(across.cross(d.normalized()) * k))\r"},{"line":1541,"text":"            add(x[1], x[2], x[3], pad_fn)\r"},{"line":1542,"text":"        return out\r"}],"name":"_patch_points","start_line":1491,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._patch_points"}}
