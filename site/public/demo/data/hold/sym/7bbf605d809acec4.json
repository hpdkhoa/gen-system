{"flow":{"kind":"var","name":"dg","noCFG":true,"reason":"dg is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":87,"file":"hold-code/weaponlab/blueprint/blender/blueprint_showcase.py","kind":"var","language":"python","lines":[{"line":47,"text":"dg = bpy.context.evaluated_depsgraph_get()\r"},{"line":48,"text":"pts = []\r"},{"line":49,"text":"for m in mesh:\r"},{"line":50,"text":"    e = m.evaluated_get(dg)\r"},{"line":51,"text":"    pts += [e.matrix_world @ v.co for v in e.to_mesh().vertices]\r"},{"line":52,"text":"lo = Vector((min(p.x for p in pts), min(p.y for p in pts), min(p.z for p in pts)))\r"},{"line":53,"text":"hi = Vector((max(p.x for p in pts), max(p.y for p in pts), max(p.z for p in pts)))\r"},{"line":54,"text":"mid = (lo + hi) / 2.0\r"},{"line":55,"text":"R = (hi - lo).length\r"},{"line":56,"text":"cam_data = bpy.data.cameras.new(\"ShowCam\")\r"},{"line":57,"text":"cam_data.lens = 70\r"},{"line":58,"text":"cam = bpy.data.objects.new(\"ShowCam\", cam_data)\r"},{"line":59,"text":"sc.collection.objects.link(cam)\r"},{"line":60,"text":"sc.camera = cam\r"},{"line":61,"text":"DIST = R * 2.15\r"},{"line":62,"text":"\r"},{"line":63,"text":"\r"},{"line":64,"text":"def aim(az_deg, el_deg, dist=DIST, look=None):\r"},{"line":65,"text":"    \"\"\"The camera round the gun: azimuth 0 looks at its left side (Blender +X), 180 its right; the muzzle is -Y.\"\"\"\r"},{"line":66,"text":"    a, e = math.radians(az_deg), math.radians(el_deg)\r"},{"line":67,"text":"    look = look or mid\r"},{"line":68,"text":"    cam.location = look + Vector((math.cos(a) * math.cos(e), math.sin(a) * math.cos(e), math.sin(e))) * dist\r"},{"line":69,"text":"    cam.rotation_euler = (look - cam.location).normalized().to_track_quat('-Z', 'Y').to_euler()\r"},{"line":70,"text":"\r"},{"line":71,"text":"\r"},{"line":72,"text":"VIEWS = {\"right\": (205, 14), \"left\": (-25, 14), \"top_right\": (215, 38), \"right_close\": (195, 8)}\r"},{"line":73,"text":"n = 0\r"},{"line":74,"text":"report = {\"shots\": []}\r"},{"line":75,"text":"\r"},{"line":76,"text":"\r"},{"line":77,"text":"def shot(name):\r"},{"line":78,"text":"    global n\r"},{"line":79,"text":"    sc.render.filepath = os.path.join(OUT, \"f%05d.png\" % n)\r"},{"line":80,"text":"    bpy.ops.render.render(write_still=True)\r"},{"line":81,"text":"    report[\"shots\"].append({\"frame\": n, \"shot\": name})\r"},{"line":82,"text":"    n += 1\r"},{"line":83,"text":"\r"},{"line":84,"text":"\r"},{"line":85,"text":"# 1. once round\r"},{"line":86,"text":"arm.animation_data.action = None\r"},{"line":87,"text":"for k in range(job.get(\"turn_frames\", 60)):\r"}],"name":"dg","start_line":47,"symbol_id":"hold-code/weaponlab/blueprint/blender/blueprint_showcase.py#var:dg"}}
