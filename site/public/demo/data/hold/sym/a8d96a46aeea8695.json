{"flow":{"blocks":[{"id":0,"label":"entry","lines":[{"kind":"call","line":226,"text":"frame = (arm.matrix_world @ b.matrix_local).to_3x3()"},{"kind":"call","line":228,"text":"M = Matrix.Translation(head) @ frame.to_4x4() @ Matrix.Rotation(math.radians(-90), 4, 'X') @ local"},{"kind":"call","line":230,"text":"mw = ob.matrix_world.copy()"},{"kind":"call","line":232,"text":"bpy.context.view_layer.update()"},{"kind":"return","line":234,"text":"return ob"}],"preds":null,"stmts":["call ?.to_3x3","call Matrix.Translation","call frame.to_4x4","call Matrix.Rotation","call math.radians","call ob.matrix_world.copy","call bpy.context.view_layer.update","return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[0],"func_id":"hold-code/poselab_mcp/blender/sample.py#func:_attach","issues":null},"source":{"end_line":234,"file":"hold-code/poselab_mcp/blender/sample.py","kind":"func","language":"python","lines":[{"line":222,"text":"def _attach(arm, bone, ob, local):\r"},{"line":223,"text":"    \"\"\"ob placed by `local` in the bone's frame (its Z along the bone from the head), parented to the bone.\"\"\"\r"},{"line":224,"text":"    b = arm.data.bones[bone]\r"},{"line":225,"text":"    head = arm.matrix_world @ b.head_local\r"},{"line":226,"text":"    frame = (arm.matrix_world @ b.matrix_local).to_3x3()\r"},{"line":227,"text":"    # the bone frame has Y along the bone; the shapes are made along Z: turn Z onto Y\r"},{"line":228,"text":"    M = Matrix.Translation(head) @ frame.to_4x4() @ Matrix.Rotation(math.radians(-90), 4, 'X') @ local\r"},{"line":229,"text":"    ob.matrix_world = M\r"},{"line":230,"text":"    mw = ob.matrix_world.copy()\r"},{"line":231,"text":"    ob.parent, ob.parent_type, ob.parent_bone = arm, 'BONE', bone\r"},{"line":232,"text":"    bpy.context.view_layer.update()\r"},{"line":233,"text":"    ob.matrix_world = mw\r"},{"line":234,"text":"    return ob\r"}],"name":"_attach","start_line":222,"symbol_id":"hold-code/poselab_mcp/blender/sample.py#func:_attach"}}
