rn([(\"03\", 1.0)]),"},{"kind":"call","line":1126,"text":"turn([(\"01\", 1.0), (\"03\", -1.0)]), turn([(\"01\", 1.0), (\"02\", -1.0)]),"},{"kind":"call","line":1127,"text":"turn([(\"02\", 1.0), (\"03\", -1.0)])], side, other, steps=(6.0, 3.0))"}],"preds":[11],"stmts":["call self._descend","call turn","call turn","call turn","call turn","call turn","call turn"],"succs":[1]},{"id":14,"label":"then","lines":[{"kind":"call","line":1109,"text":"is_pad = np.array([lb[k].endswith(\"_pad\") for k in range(len(lb)) if lb[k].startswith(fi)])"}],"preds":[12],"stmts":["call ?.endswith"],"succs":[15]},{"id":15,"label":"merge","lines":[{"kind":"call","line":1109,"text":"is_pad = np.array([lb[k].endswith(\"_pad\") for k in range(len(lb)) if lb[k].startswith(fi)])"}],"preds":[14,12],"stmts":["call ?.startswith"],"succs":[11]}],"effects":["unknown"],"entry":0,"exits":[3],"func_id":"hold-code/poselab_mcp/blender/holdlab.py#func:_fit_pads","issues":null},"source":{"end_line":1127,"file":"hold-code/poselab_mcp/blender/holdlab.py","kind":"func","language":"python","lines":[{"line":1098,"text":"    def _fit_pads(self, side, fingers, other=True):\r"},{"line":1099,"text":"        \"\"\"Each wrapping finger's joints turned by a fixed step pattern so more of its pads rest on the surface (within\r"},{"line":1100,"text":"        0.1 cm): a closing stops the joints behind a touching fingertip, and this lays the base and middle segments\r"},{"line":1101,"text":"        down too. Inside the walls (no pad past its give, no joint past a holding finger's limits).\"\"\"\r"},{"line":1102,"text":"        FL = self._limits()[1]\r"},{"line":1103,"text":"        P_, N_ = self._skin_arrays()[:2]\r"},{"line":1104,"text":"        ix, lb = self._hand_label_arrays(side, P_, N_)\r"},{"line":1105,"text":"        for fi in fingers:\r"},{"line":1106,"text":"            sel = np.array([i for i, l_ in zip(ix, lb) if l_.startswith(fi)])\r"},{"line":1107,"text":"            if not len(sel):\r"},{"line":1108,"text":"                continue\r"},{"line":1109,"text":"            is_pad = np.array([lb[k].endswith(\"_pad\") for k in range(len(lb)) if lb[k].startswith(fi)])\r"},{"line":1110,"text":"\r"},{"line":1111,"text":"            def err(sel=sel, is_pad=is_pad):\r"},{"line":1112,"text":"                P, _N, A = self._skin_arrays()[:3]\r"},{"line":1113,"text":"                D = self.sdf_query(P[sel], want_normal=False)[0]\r"},{"line":1114,"text":"                on = is_pad & (D <= 0.1) & (D >= -0.15)\r"},{"line":1115,"text":"                return -float(A[sel][on].sum())\r"},{"line":1116,"text":"\r"},{"line":1117,"text":"            def turn(js, fi=fi):\r"},{"line":1118,"text":"                # js: (joint, share) turned together; a base closing while its end opens rolls a finger down onto\r"},{"line":1119,"text":"                # the surface without pushing the touching tip in\r"},{"line":1120,"text":"                def mv(deg):\r"},{"line":1121,"text":"                    fr = self._finger_report(side, FL)[0]\r"},{"line":1122,"text":"                    for j, k in js:\r"},{"line":1123,"text":"                        self._set_curl(side, fi, j, fr[\"%s_%s\" % (fi, j)][0] + deg * k, FL)\r"},{"line":1124,"text":"                return mv\r"},{"line":1125,"text":"            self._descend(err, [turn([(\"01\", 1.0)]), turn([(\"02\", 1.0)]), turn([(\"03\", 1.0)]),\r"},{"line":1126,"text":"                                turn([(\"01\", 1.0), (\"03\", -1.0)]), turn([(\"01\", 1.0), (\"02\", -1.0)]),\r"},{"line":1127,"text":"                                turn([(\"02\", 1.0), (\"03\", -1.0)])], side, other, steps=(6.0, 3.0))\r"}],"name":"_fit_pads","start_line":1098,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#func:_fit_pads"}}
