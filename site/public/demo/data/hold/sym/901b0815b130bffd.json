 as the upper arm carries it, unbent\r"},{"line":2762,"text":"        out = [(\"elbow\", self._twist_about(self._rest_turn(lo) @ self._rest_turn(up).inverted(), v0))]\r"},{"line":2763,"text":"        prev = lo\r"},{"line":2764,"text":"        tb = self._twist_bones(s)\r"},{"line":2765,"text":"        for _p, n in tb:\r"},{"line":2766,"text":"            out.append((n, self._twist_about(self._rest_turn(n) @ self._rest_turn(prev).inverted(), a)))\r"},{"line":2767,"text":"            prev = n\r"},{"line":2768,"text":"        out.append((\"wrist\", self._twist_about(self._rest_turn(hn) @ self._rest_turn(prev).inverted(), a)))\r"},{"line":2769,"text":"        total = sum(v for _n, v in out)\r"},{"line":2770,"text":"        places = [0.0] + [p for p, _n in tb] + [1.0]\r"},{"line":2771,"text":"        shares = [share0] + [(1.0 - share0) * (places[i + 1] - places[i]) for i in range(len(places) - 1)]\r"},{"line":2772,"text":"        return [(n, v, total * sh) for (n, v), sh in zip(out, shares)], total\r"}],"name":"_forearm_links","start_line":2753,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:_forearm_links"}}
