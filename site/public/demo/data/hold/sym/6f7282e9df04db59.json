 the parts in skip.\"\"\"\r"},{"line":388,"text":"        c = getattr(self, \"_pbvh\", {})\r"},{"line":389,"text":"        ck = (part, frame_part, tuple(sorted(skip)))\r"},{"line":390,"text":"        if ck in c:\r"},{"line":391,"text":"            return c[ck]\r"},{"line":392,"text":"        dg = bpy.context.evaluated_depsgraph_get()\r"},{"line":393,"text":"        me_ob = self.rifle_mesh\r"},{"line":394,"text":"        ev = me_ob.evaluated_get(dg)\r"},{"line":395,"text":"        me = ev.to_mesh()\r"},{"line":396,"text":"        Fi = self._obj_frame(frame_part or part).inverted() @ me_ob.matrix_world\r"},{"line":397,"text":"        V = [Fi @ v.co for v in me.vertices]\r"},{"line":398,"text":"        names = {g.index: g.name for g in me_ob.vertex_groups}\r"},{"line":399,"text":"        vg = []\r"},{"line":400,"text":"        for v in me_ob.data.vertices:\r"},{"line":401,"text":"            gm = max(v.groups, key=lambda x: x.weight) if v.groups else None\r"},{"line":402,"text":"            vg.append(names.get(gm.group) if gm else None)\r"},{"line":403,"text":"        ps = []\r"},{"line":404,"text":"        for p in me.polygons:\r"},{"line":405,"text":"            gs = [vg[i] or \"body\" for i in p.vertices]\r"},{"line":406,"text":"            own = max(set(gs), key=gs.count)\r"},{"line":407,"text":"            if (part is None and own not in skip) or not any(vg) or own == part:\r"},{"line":408,"text":"                ps.append(tuple(p.vertices))\r"},{"line":409,"text":"        ev.to_mesh_clear()\r"},{"line":410,"text":"        bvh = BVHTree.FromPolygons(V, ps) if ps else None\r"},{"line":411,"text":"        c[ck] = bvh\r"},{"line":412,"text":"        self._pbvh = c\r"},{"line":413,"text":"        return bvh\r"}],"name":"_part_bvh_local","start_line":385,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#method:HoldMixin._part_bvh_local"}}
