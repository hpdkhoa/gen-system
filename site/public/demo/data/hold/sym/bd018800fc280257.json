r"},{"line":924,"text":"            t_ = RI[\"kd\"][rg]\r"},{"line":925,"text":"            for i in vi:\r"},{"line":926,"text":"                _c, _k, d = t_.find(Vector(P[i]))\r"},{"line":927,"text":"                if d is not None and (best is None or d < best):\r"},{"line":928,"text":"                    best = d\r"},{"line":929,"text":"        return round((best or 0.0) * 100.0, 2)\r"}],"name":"pull_cm","start_line":908,"symbol_id":"hold-code/poselab_mcp/blender/contactlab.py#method:ContactMixin.pull_cm"}}
