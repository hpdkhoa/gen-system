ull,"succs":[3]},{"id":12,"label":"then","preds":[10],"stmts":null,"succs":[13]},{"cond":"at and i - at[-1] < min_gap_px","id":13,"label":"merge","preds":[12,10],"stmts":null,"succs":[14,15]},{"cond":"prof[i] > prof[at[-1]]","id":14,"label":"then","preds":[13],"stmts":null,"succs":[16,17]},{"id":15,"label":"merge","lines":[{"kind":"call","line":293,"text":"at.append(i)"}],"preds":[17,13],"stmts":["call at.append"],"succs":[11]},{"id":16,"label":"then","preds":[14],"stmts":null,"succs":[17]},{"id":17,"label":"merge","preds":[16,14],"stmts":null,"succs":[15]},{"id":18,"label":"then","lines":[{"kind":"call","line":297,"text":"\"pitch_px\": round(float(np.median(gaps)), 2) if gaps else None}"}],"preds":[5],"stmts":["call round","call float","call np.median"],"succs":[19]},{"cond":"gaps","id":19,"label":"merge","preds":[18,5],"stmts":null,"succs":[20,21]},{"id":20,"label":"then","preds":[19],"stmts":null,"succs":[21]},{"cond":"gaps and 'scale' in f","id":21,"label":"merge","preds":[20,19],"stmts":null,"succs":[22,23]},{"id":22,"label":"then","lines":[{"kind":"call","line":299,"text":"out[\"pitch_cm\"] = round(out[\"pitch_px\"] * f[\"scale\"][\"cm_per_px\"], 4)"},{"kind":"call","line":300,"text":"out[\"span_cm\"] = round((cols[-1] - cols[0]) * f[\"scale\"][\"cm_per_px\"], 3)"}],"preds":[21],"stmts":["call round","call round"],"succs":[23]},{"id":23,"label":"merge","lines":[{"kind":"return","line":301,"text":"return out"}],"preds":[22,21],"stmts":["return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[23],"func_id":"hold-code/weaponlab/blueprint/trace.py#func:peaks","issues":null},"source":{"end_line":301,"file":"hold-code/weaponlab/blueprint/trace.py","kind":"func","language":"python","lines":[{"line":273,"text":"def peaks(gun, fig_id, region, light=True, min_gap_px=3, k=0.5):\r"},{"line":274,"text":"    \"\"\"Evenly spaced marks too faint or dotted for ink runs (serrations in a halftone photo): the columns of region\r"},{"line":275,"text":"    [x0, y0, x1, y1] px whose mean brightness (light marks) or darkness peaks above the profile's mean plus k times\r"},{"line":276,"text":"    its spread, at least min_gap_px apart. Gives their columns, their mean pitch in px and in cm.\"\"\"\r"},{"line":277,"text":"    cv2, np = _cv()\r"},{"line":278,"text":"    f = Fg.figure(gun, fig_id)\r"},{"line":279,"text":"    g = Fg.image(gun, f, gray=True).astype(float)\r"},{"line":280,"text":"    x0, y0, x1, y1 = [int(v) for v in region]\r"},{"line":281,"text":"    prof = g[y0:y1, x0:x1].mean(axis=0)\r"},{"line":282,"text":"    if not light:\r"},{"line":283,"text":"        prof = 255.0 - prof\r"},{"line":284,"text":"    prof = np.convolve(prof, np.ones(3) / 3.0, mode=\"same\")\r"},{"line":285,"text":"    cut = prof.mean() + k * prof.std()\r"},{"line":286,"text":"    at = []\r"},{"line":287,"text":"    for i in range(1, len(prof) - 1):\r"},{"line":288,"text":"        if prof[i] >= cut and prof[i] >= prof[i - 1] and prof[i] >= prof[i + 1]:\r"},{"line":289,"text":"            if at and i - at[-1] < min_gap_px:\r"},{"line":290,"text":"                if prof[i] > prof[at[-1]]:\r"},{"line":291,"text":"                    at[-1] = i\r"},{"line":292,"text":"                continue\r"},{"line":293,"text":"            at.append(i)\r"},{"line":294,"text":"    cols = [x0 + i for i in at]\r"},{"line":295,"text":"    gaps = [b - a for a, b in zip(cols, cols[1:])]\r"},{"line":296,"text":"    out = {\"figure\": fig_id, \"columns_px\": cols, \"count\": len(cols), \"gaps_px\": gaps,\r"},{"line":297,"text":"           \"pitch_px\": round(float(np.median(gaps)), 2) if gaps else None}\r"},{"line":298,"text":"    if gaps and \"scale\" in f:\r"},{"line":299,"text":"        out[\"pitch_cm\"] = round(out[\"pitch_px\"] * f[\"scale\"][\"cm_per_px\"], 4)\r"},{"line":300,"text":"        out[\"span_cm\"] = round((cols[-1] - cols[0]) * f[\"scale\"][\"cm_per_px\"], 3)\r"},{"line":301,"text":"    return out\r"}],"name":"peaks","start_line":273,"symbol_id":"hold-code/weaponlab/blueprint/trace.py#func:peaks"}}
