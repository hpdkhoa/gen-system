ine":155,"text":"return rows"}],"preds":[58],"stmts":["return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[1,24,46,47,49,60],"func_id":"hold-code/weaponlab/probe.py#func:run_job","issues":null},"source":{"end_line":155,"file":"hold-code/weaponlab/probe.py","kind":"func","language":"python","lines":[{"line":101,"text":"def run_job(weapons, overrides=None, shots=None, parts=None, slomo=None, view=True, timeout_s=None, extra=None):\r"},{"line":102,"text":"    \"\"\"One probe run: writes the job, starts the probe, checks the rows. A warm-up entry (the first weapon at idle)\r"},{"line":103,"text":"    goes first and its rows are dropped: a first action can read wrong (docs/PROBE_CONTRACT.md, lessons).\"\"\"\r"},{"line":104,"text":"    cfg = project().probe\r"},{"line":105,"text":"    if not cfg.get(\"command\"):\r"},{"line":106,"text":"        raise RuntimeError(\"no probe: set probe.command in weaponlab.json (docs/PROBE_CONTRACT.md)\")\r"},{"line":107,"text":"    if weapons and cfg.get(\"warmup\", True):\r"},{"line":108,"text":"        idle = next((a for a in weapons[0][\"actions\"] if a[\"name\"] == \"idle\"), {\"name\": \"idle\", \"seconds\": 1.0})\r"},{"line":109,"text":"        weapons = [{\"id\": weapons[0][\"id\"], \"tag\": \"warmup\", \"actions\": [dict(idle, seconds=1.0)]}] + list(weapons)\r"},{"line":110,"text":"    d = project().ensure(\"probe\")\r"},{"line":111,"text":"    stamp = time.strftime(\"%Y%m%d-%H%M%S\")\r"},{"line":112,"text":"    out, jobf = d / (\"rows-%s.json\" % stamp), d / (\"job-%s.json\" % stamp)\r"},{"line":113,"text":"    job = {\"contract\": C.CONTRACT, \"out\": str(out).replace(\"\\\\\", \"/\"), \"weapons\": weapons, \"view\": bool(view)}\r"},{"line":114,"text":"    job.update(cfg.get(\"job_extra\") or {})\r"},{"line":115,"text":"    job.update(extra or {})\r"},{"line":116,"text":"    if overrides:\r"},{"line":117,"text":"        job[\"overrides\"] = overrides\r"},{"line":118,"text":"    if shots:\r"},{"line":119,"text":"        Path(shots).mkdir(parents=True, exist_ok=True)\r"},{"line":120,"text":"        job[\"shots\"] = str(shots).replace(\"\\\\\", \"/\")\r"},{"line":121,"text":"    if parts:\r"},{"line":122,"text":"        Path(parts).mkdir(parents=True, exist_ok=True)\r"},{"line":123,"text":"        job[\"parts\"] = str(parts).replace(\"\\\\\", \"/\")\r"},{"line":124,"text":"    if slomo:\r"},{"line":125,"text":"        job[\"slomo\"] = slomo\r"},{"line":126,"text":"    bad = C.check_job(job)\r"},{"line":127,"text":"    if bad:\r"},{"line":128,"text":"        raise ValueError(\"the job breaks the contract: \" + \"; \".join(bad))\r"},{"line":129,"text":"    jobf.write_text(json.dumps(job, indent=1), encoding=\"utf-8\")\r"},{"line":130,"text":"    sub = {\"{job}\": str(jobf).replace(\"\\\\\", \"/\"), \"{work}\": str(project().work).replace(\"\\\\\", \"/\"), \"{stamp}\": stamp}\r"},{"line":131,"text":"    cmd = []\r"},{"line":132,"text":"    for c in cfg[\"command\"]:\r"},{"line":133,"text":"        for k, v in sub.items():\r"},{"line":134,"text":"            c = c.replace(k, v)\r"},{"line":135,"text":"        cmd.append(c)\r"},{"line":136,"text":"    seconds = sum(sum(a.get(\"seconds\", 2.0) + 3.0 for a in w[\"actions\"]) for w in weapons) / (slomo or 1.0) + 90\r"},{"line":137,"text":"    log = d / (\"probe-%s.log\" % stamp)\r"},{"line":138,"text":"    with open(log, \"w\", encoding=\"utf-8\") as lf:\r"},{"line":139,"text":"        low = getattr(subprocess, \"BELOW_NORMAL_PRIORITY_CLASS\", 0) if cfg.get(\"low_priority\") else 0\r"},{"line":140,"text":"        p = subprocess.Popen(cmd, cwd=str(project().root), stdout=lf, stderr=subprocess.STDOUT, creationflags=low)\r"},{"line":141,"text":"        try:\r"},{"line":142,"text":"            p.wait(timeout=timeout_s or max(seconds, cfg.get(\"timeout_s\", 0)))\r"},{"line":143,"text":"        except subprocess.TimeoutExpired:\r"},{"line":144,"text":"            p.kill()\r"},{"line":145,"text":"            p.wait(60)\r"},{"line":146,"text":"            raise RuntimeError(\"the probe ran past its time (%s); its log: %s\" % (cmd[0], log))\r"},{"line":147,"text":"    if not out.exists():\r"},{"line":148,"text":"        raise RuntimeError(\"the probe wrote no rows (exit %s); its log: %s\" % (p.returncode, log))\r"},{"line":149,"text":"    data = json.loads(out.read_text(encoding=\"utf-8-sig\"))\r"},{"line":150,"text":"    bad = C.check_rows(data, job)\r"},{"line":151,"text":"    if bad:\r"},{"line":152,"text":"        raise ValueError(\"the probe's rows break the contract: \" + \"; \".join(bad[:8]))\r"},{"line":153,"text":"    rows = [r for r in data[\"rows\"] if r.get(\"value\") is not None and not r[\"weapon\"].endswith(\"@warmup\")]\r"},{"line":154,"text":"    rows += [{\"weapon\": \"_probe\", \"action\": \"-\", \"metric\": \"note\", \"value\": None, \"note\": n} for n in data.get(\"notes\", [])]\r"},{"line":155,"text":"    return rows\r"}],"name":"run_job","start_line":101,"symbol_id":"hold-code/weaponlab/probe.py#func:run_job"}}
