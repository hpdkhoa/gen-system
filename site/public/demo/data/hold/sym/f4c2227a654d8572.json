py#method:Lab._thumb_base_clear","issues":null},"source":{"end_line":2209,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"method","language":"python","lines":[{"line":2181,"text":"    def _thumb_base_clear(self, side, tree, glove_cm=0.0, other=True, steps=20):\r"},{"line":2182,"text":"        \"\"\"The thumb's base joint turned, 3 degrees at a time about three axes, the way that opens the whole thumb's\r"},{"line":2183,"text":"        gap to the gun and the other hand most, until it is clear; a turn that breaks a thumb rule is not taken (the\r"},{"line":2184,"text":"        base bone of the thumb sits where its base joint puts it, which no other step turns).\"\"\"\r"},{"line":2185,"text":"        TL = self._thumb_limits()\r"},{"line":2186,"text":"        n = self._n(\"finger\", side, \"thumb\", \"01\")\r"},{"line":2187,"text":"        for _ in range(steps):\r"},{"line":2188,"text":"            gap = self._digit_gap(side, \"thumb\", tree, glove_cm, other)\r"},{"line":2189,"text":"            if gap >= 0.0:\r"},{"line":2190,"text":"                return gap\r"},{"line":2191,"text":"            head = self._bw(n).translation.copy()\r"},{"line":2192,"text":"            across, _k = self._hand_frame(side)\r"},{"line":2193,"text":"            d = self._finger_tip(\"thumb\", side) - head\r"},{"line":2194,"text":"            if d.length < 1e-9:\r"},{"line":2195,"text":"                return gap\r"},{"line":2196,"text":"            d.normalize()\r"},{"line":2197,"text":"            best = None\r"},{"line":2198,"text":"            M = self._bw(n)\r"},{"line":2199,"text":"            for axis in (across, d.cross(across).normalized(), d):\r"},{"line":2200,"text":"                for sg in (1.0, -1.0):\r"},{"line":2201,"text":"                    self._turn_about(n, axis, 3.0 * sg, head)\r"},{"line":2202,"text":"                    g2 = self._digit_gap(side, \"thumb\", tree, glove_cm, other)\r"},{"line":2203,"text":"                    if not self._thumb_report(side, TL)[1] and (best is None or g2 > best[0]):\r"},{"line":2204,"text":"                        best = (g2, axis, sg)\r"},{"line":2205,"text":"                    self._set_world(n, M)\r"},{"line":2206,"text":"            if best is None or best[0] <= gap + 1e-4:\r"},{"line":2207,"text":"                return gap\r"},{"line":2208,"text":"            self._turn_about(n, best[1], 3.0 * best[2], head)\r"},{"line":2209,"text":"        return self._digit_gap(side, \"thumb\", tree, glove_cm, other)\r"}],"name":"_thumb_base_clear","start_line":2181,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._thumb_base_clear"}}
