t":"        if len(pairs) < 3:\r"},{"line":925,"text":"            return None\r"},{"line":926,"text":"        Sx = np.array([list(a) for a, _b, _w in pairs])\r"},{"line":927,"text":"        Dx = np.array([list(b) for _a, b, _w in pairs])\r"},{"line":928,"text":"        w = np.array([w_ for _a, _b, w_ in pairs])\r"},{"line":929,"text":"        w = w / w.sum()\r"},{"line":930,"text":"        cs, cd = (Sx * w[:, None]).sum(0), (Dx * w[:, None]).sum(0)\r"},{"line":931,"text":"        Hm = ((Sx - cs) * w[:, None]).T @ (Dx - cd)\r"},{"line":932,"text":"        U, _S, Vt = np.linalg.svd(Hm)\r"},{"line":933,"text":"        dd = np.sign(np.linalg.det(Vt.T @ U.T))\r"},{"line":934,"text":"        Rm = Vt.T @ np.diag([1.0, 1.0, dd]) @ U.T\r"},{"line":935,"text":"        R = Matrix([list(Rm[0]), list(Rm[1]), list(Rm[2])]).to_4x4()\r"},{"line":936,"text":"        if share < 1.0:\r"},{"line":937,"text":"            # a share of the move: the turn by slerp, the shift in proportion\r"},{"line":938,"text":"            q = Matrix([list(Rm[0]), list(Rm[1]), list(Rm[2])]).to_quaternion()\r"},{"line":939,"text":"            R = Quaternion().slerp(q, share).to_matrix().to_4x4()\r"},{"line":940,"text":"            cd = cs + (cd - cs) * share\r"},{"line":941,"text":"        T = Matrix.Translation(Vector(list(cd))) @ R @ Matrix.Translation(-Vector(list(cs)))\r"},{"line":942,"text":"        hn = self._n(\"hand\", side)\r"},{"line":943,"text":"        M = T @ self._bw(hn)\r"},{"line":944,"text":"        short = self._put_hand(side, Matrix.LocRotScale(M.translation, M.to_quaternion(), self._unit()))\r"},{"line":945,"text":"        bpy.context.view_layer.update()\r"},{"line":946,"text":"        return short\r"}],"name":"_fit_hand","start_line":921,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#method:HoldMixin._fit_hand"}}
