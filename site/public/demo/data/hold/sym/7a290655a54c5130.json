{"flow":{"kind":"var","name":"arm","noCFG":true,"reason":"arm is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":63,"file":"hold-code/weaponlab/gunkit/blender/gunkit_clips.py","kind":"var","language":"python","lines":[{"line":23,"text":"arm = next(o for o in bpy.context.scene.objects if o.type == 'ARMATURE')\r"},{"line":24,"text":"mesh = next(o for o in bpy.context.scene.objects if o.type == 'MESH')\r"},{"line":25,"text":"NAME = arm.name\r"},{"line":26,"text":"sc = bpy.context.scene\r"},{"line":27,"text":"report = []\r"},{"line":28,"text":"arm.animation_data_create()\r"},{"line":29,"text":"for pb in arm.pose.bones:\r"},{"line":30,"text":"    pb.rotation_mode = 'QUATERNION'\r"},{"line":31,"text":"for tr in job[\"tracks\"]:\r"},{"line":32,"text":"    fps = int(tr[\"fps\"])\r"},{"line":33,"text":"    sc.render.fps = fps\r"},{"line":34,"text":"    act = bpy.data.actions.new(job.get(\"prefix\", \"A_%s_\" % NAME) + tr[\"clip\"])\r"},{"line":35,"text":"    act.use_fake_user = True\r"},{"line":36,"text":"    arm.animation_data.action = act\r"},{"line":37,"text":"    for fr in tr[\"frames\"]:\r"},{"line":38,"text":"        f = int(round(fr[\"t\"] * fps))\r"},{"line":39,"text":"        for bone, x in fr[\"bones\"].items():\r"},{"line":40,"text":"            pb = arm.pose.bones.get(bone)\r"},{"line":41,"text":"            if pb is None:\r"},{"line":42,"text":"                continue\r"},{"line":43,"text":"            lx, ly, lz = x[\"loc\"]\r"},{"line":44,"text":"            pb.location = Vector((lx, -ly, lz)) / 100.0\r"},{"line":45,"text":"            deg, ax, ay, az = x[\"rot\"]\r"},{"line":46,"text":"            axis = Vector((ax, -ay, az))\r"},{"line":47,"text":"            pb.rotation_quaternion = Quaternion(axis.normalized() if axis.length > 0 else Vector((0, 1, 0)), -math.radians(deg))\r"},{"line":48,"text":"            pb.keyframe_insert(\"location\", frame=f)\r"},{"line":49,"text":"            pb.keyframe_insert(\"rotation_quaternion\", frame=f)\r"},{"line":50,"text":"    report.append({\"clip\": act.name, \"frames\": len(tr[\"frames\"]), \"seconds\": tr[\"seconds\"], \"fps\": fps})\r"},{"line":51,"text":"arm.animation_data.action = None\r"},{"line":52,"text":"for pb in arm.pose.bones:\r"},{"line":53,"text":"    pb.location = (0, 0, 0)\r"},{"line":54,"text":"    pb.rotation_quaternion = (1, 0, 0, 0)\r"},{"line":55,"text":"for o in sc.objects:\r"},{"line":56,"text":"    o.select_set(False)\r"},{"line":57,"text":"arm.select_set(True)\r"},{"line":58,"text":"mesh.select_set(True)\r"},{"line":59,"text":"fbx = os.path.join(OUT, \"SK_%s_Clips.fbx\" % NAME)\r"},{"line":60,"text":"bpy.ops.export_scene.fbx(filepath=fbx, use_selection=True, object_types={'ARMATURE', 'MESH'}, add_leaf_bones=False,\r"},{"line":61,"text":"                         bake_anim=True, bake_anim_use_all_actions=True, bake_anim_use_nla_strips=False,\r"},{"line":62,"text":"                         bake_anim_force_startend_keying=True, bake_anim_simplify_factor=0.0,\r"},{"line":63,"text":"                         mesh_smooth_type='FACE', colors_type='LINEAR')\r"}],"name":"arm","start_line":23,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_clips.py#var:arm"}}
