l":"then","lines":[{"kind":"call","line":1615,"text":"while deg < 16.0 and elbow_bend(side) < need:"}],"preds":[10],"stmts":["call elbow_bend"],"succs":[12]},{"id":12,"label":"merge","preds":[11,10],"stmts":null,"succs":[13]},{"cond":"deg < 16.0 and elbow_bend(side) < need","id":13,"label":"loop_header","preds":[12,14],"stmts":null,"succs":[14,15]},{"id":14,"label":"loop_body","lines":[{"kind":"call","line":1618,"text":"bpy.context.view_layer.update()"},{"kind":"call","line":1619,"text":"L._turn_about(cn, axis, deg, C)"},{"kind":"call","line":1620,"text":"bpy.context.view_layer.update()"},{"kind":"call","line":1621,"text":"L._put_hand(side, H)"},{"kind":"call","line":1622,"text":"bpy.context.view_layer.update()"}],"preds":[13],"stmts":["call bpy.context.view_layer.update","call L._turn_about","call bpy.context.view_layer.update","call L._put_hand","call bpy.context.view_layer.update"],"succs":[13]},{"id":15,"label":"loop_exit","lines":[{"kind":"return","line":1623,"text":"return deg"}],"preds":[13],"stmts":["return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[1,7,9,15],"func_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:shoulder_reach","issues":null},"source":{"end_line":1623,"file":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py","kind":"func","language":"python","lines":[{"line":1591,"text":"def shoulder_reach(side, H):\r"},{"line":1592,"text":"    \"\"\"An arm at full stretch reaches with the shoulder too, as a shooter's does: the clavicle turned toward the hand,\r"},{"line":1593,"text":"    2 degrees at a time up to 16 (about 4 cm at the shoulder), until the elbow keeps 5 degrees past its locked limit.\r"},{"line":1594,"text":"    Each frame starts from the hold's clavicle, so a reach lasts only while the arm needs it. Returns the degrees.\"\"\"\r"},{"line":1595,"text":"    cn = \"clavicle_\" + side\r"},{"line":1596,"text":"    if cn not in L.arm.pose.bones:\r"},{"line":1597,"text":"        return 0.0\r"},{"line":1598,"text":"    pb = L.arm.pose.bones[cn]\r"},{"line":1599,"text":"    if side not in CLAV:\r"},{"line":1600,"text":"        CLAV[side] = pb.rotation_quaternion.copy()\r"},{"line":1601,"text":"    if pb.rotation_quaternion != CLAV[side]:\r"},{"line":1602,"text":"        pb.rotation_quaternion = CLAV[side]\r"},{"line":1603,"text":"        bpy.context.view_layer.update()\r"},{"line":1604,"text":"        L._put_hand(side, H)\r"},{"line":1605,"text":"    need = L._limits()[0][\"elbow_bend_min_deg\"] + 5.0\r"},{"line":1606,"text":"    if elbow_bend(side) >= need:\r"},{"line":1607,"text":"        return 0.0\r"},{"line":1608,"text":"    C = L._bw(cn).translation\r"},{"line":1609,"text":"    S = L._bw(L._n(\"upperarm\", side)).translation\r"},{"line":1610,"text":"    axis = (S - C).cross(H.translation - C)\r"},{"line":1611,"text":"    if axis.length < 1e-9:\r"},{"line":1612,"text":"        return 0.0\r"},{"line":1613,"text":"    axis.normalize()\r"},{"line":1614,"text":"    deg = 0.0\r"},{"line":1615,"text":"    while deg < 16.0 and elbow_bend(side) < need:\r"},{"line":1616,"text":"        deg += 2.0\r"},{"line":1617,"text":"        pb.rotation_quaternion = CLAV[side]\r"},{"line":1618,"text":"        bpy.context.view_layer.update()\r"},{"line":1619,"text":"        L._turn_about(cn, axis, deg, C)\r"},{"line":1620,"text":"        bpy.context.view_layer.update()\r"},{"line":1621,"text":"        L._put_hand(side, H)\r"},{"line":1622,"text":"        bpy.context.view_layer.update()\r"},{"line":1623,"text":"    return deg\r"}],"name":"shoulder_reach","start_line":1591,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:shoulder_reach"}}
