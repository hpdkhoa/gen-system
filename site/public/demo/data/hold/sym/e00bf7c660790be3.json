()), None)\r"},{"line":1419,"text":"    home_r = grasp(\"r\", \"grip\", start=\"with_support\")\r"},{"line":1420,"text":"    # and the support hand once more on the firing hand where it now is\r"},{"line":1421,"text":"    L._put_hand(\"r\", bone_world(\"Root\") @ home_r[0])\r"},{"line":1422,"text":"    for _n, _q in home_r[1].items():\r"},{"line":1423,"text":"        L.arm.pose.bones[_n].rotation_quaternion = _q\r"},{"line":1424,"text":"    bpy.context.view_layer.update()\r"},{"line":1425,"text":"    L.snapshot(\"save\", \"with_firing\")\r"},{"line":1426,"text":"    GRASPS.pop((\"l\", facts.get(\"home_l\", \"support\"), None, ()), None)\r"},{"line":1427,"text":"    home_l = grasp(\"l\", facts.get(\"home_l\", \"support\"), start=\"with_firing\")\r"},{"line":1428,"text":"for side, gr in ((\"r\", home_r), (\"l\", home_l)):\r"},{"line":1429,"text":"    if gr:\r"},{"line":1430,"text":"        if side in CLAV_SET:\r"},{"line":1431,"text":"            L.arm.pose.bones[\"clavicle_\" + side].rotation_quaternion = CLAV_SET[side]\r"},{"line":1432,"text":"            bpy.context.view_layer.update()\r"},{"line":1433,"text":"        L._put_hand(side, bone_world(\"Root\") @ gr[0])\r"},{"line":1434,"text":"        for n, q in gr[1].items():\r"},{"line":1435,"text":"            L.arm.pose.bones[n].rotation_quaternion = q\r"},{"line":1436,"text":"bpy.context.view_layer.update()\r"},{"line":1437,"text":"MEND_SIDES = tuple(job.get(\"mend_sides\", (\"l\",)))\r"},{"line":1438,"text":"TRIGGER = {}\r"},{"line":1439,"text":"if STYLE and STYLE.get(\"trigger_clips\") and (STYLE[\"hands\"].get(\"r\") or {}).get(\"trigger\"):\r"}],"name":"home_r","start_line":1399,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#var:home_r"}}
