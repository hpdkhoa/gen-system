"end_line":3400,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"method","language":"python","lines":[{"line":3363,"text":"    def record_clip(self, action, clip=None, seconds=0.0, fps=30.0, ease=True):\r"},{"line":3364,"text":"        \"\"\"Builds a clip from poses: start (a name), key (the current pose at a time, s), stop (bakes the frames:\r"},{"line":3365,"text":"        each bone eased from key to key). Between keys the bones blend by rotation, so hands may drift off the rifle\r"},{"line":3366,"text":"        between keys.\"\"\"\r"},{"line":3367,"text":"        self._need()\r"},{"line":3368,"text":"        if action == \"start\":\r"},{"line":3369,"text":"            if not clip:\r"},{"line":3370,"text":"                raise ValueError(\"start needs a clip name\")\r"},{"line":3371,"text":"            if fps <= 0:\r"},{"line":3372,"text":"                raise ValueError(\"fps must be above 0\")\r"},{"line":3373,"text":"            self._rec = {\"clip\": clip, \"fps\": float(fps), \"keys\": []}\r"},{"line":3374,"text":"            return {\"recording\": clip, \"fps\": fps}\r"},{"line":3375,"text":"        rec = getattr(self, \"_rec\", None)\r"},{"line":3376,"text":"        if not rec:\r"},{"line":3377,"text":"            raise RuntimeError(\"no recording: record_clip start first\")\r"},{"line":3378,"text":"        if action == \"key\":\r"},{"line":3379,"text":"            if seconds < 0:\r"},{"line":3380,"text":"                raise ValueError(\"seconds must be 0 or more\")\r"},{"line":3381,"text":"            rec[\"keys\"] = [k for k in rec[\"keys\"] if abs(k[0] - seconds) > 1e-6] + [(float(seconds), self._capture())]\r"},{"line":3382,"text":"            rec[\"keys\"].sort(key=lambda k: k[0])\r"},{"line":3383,"text":"            return {\"keys\": [round(k[0], 3) for k in rec[\"keys\"]]}\r"},{"line":3384,"text":"        if action != \"stop\":\r"},{"line":3385,"text":"            raise ValueError(\"action: start, key or stop\")\r"},{"line":3386,"text":"        keys = rec[\"keys\"]\r"},{"line":3387,"text":"        if not keys:\r"},{"line":3388,"text":"            raise ValueError(\"no keys recorded\")\r"},{"line":3389,"text":"        fps = rec[\"fps\"]\r"},{"line":3390,"text":"        n = int(round(keys[-1][0] * fps)) + 1\r"},{"line":3391,"text":"        frames = []\r"},{"line":3392,"text":"        for i in range(n):\r"},{"line":3393,"text":"            t = i / fps\r"},{"line":3394,"text":"            a = max([k for k in keys if k[0] <= t + 1e-9], key=lambda k: k[0], default=keys[0])\r"},{"line":3395,"text":"            b = min([k for k in keys if k[0] >= t - 1e-9], key=lambda k: k[0], default=keys[-1])\r"},{"line":3396,"text":"            x = 0.0 if b[0] <= a[0] else (t - a[0]) / (b[0] - a[0])\r"},{"line":3397,"text":"            frames.append(self._blend(a[1], b[1], x * x * (3 - 2 * x) if ease else x))\r"},{"line":3398,"text":"        self._store(rec[\"clip\"], frames, fps, \"recorded\")\r"},{"line":3399,"text":"        self._rec = None\r"},{"line":3400,"text":"        return {\"clip\": rec[\"clip\"], \"frames\": n, \"seconds\": round((n - 1) / fps, 3)}\r"}],"name":"record_clip","start_line":3363,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.record_clip"}}
