{"flow":{"kind":"var","name":"job","noCFG":true,"reason":"job is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":63,"file":"hold-code/weaponlab/gunkit/blender/gunkit_rig.py","kind":"var","language":"python","lines":[{"line":23,"text":"job = json.load(open(sys.argv[sys.argv.index(\"--\") + 1], encoding=\"utf-8\"))\r"},{"line":24,"text":"sys.path.insert(0, job[\"pkg\"])\r"},{"line":25,"text":"from weaponlab.gunkit import rigplan as R  # noqa: E402\r"},{"line":26,"text":"\r"},{"line":27,"text":"pm = job[\"partsmap\"] if isinstance(job[\"partsmap\"], dict) else json.load(open(job[\"partsmap\"], encoding=\"utf-8\"))\r"},{"line":28,"text":"OUT = job[\"out\"]\r"},{"line":29,"text":"os.makedirs(OUT, exist_ok=True)\r"},{"line":30,"text":"NAME = pm[\"name\"]\r"},{"line":31,"text":"\r"},{"line":32,"text":"\r"},{"line":33,"text":"def g(x, y, z):\r"},{"line":34,"text":"    return Vector((x, -y, z)) / 100.0\r"},{"line":35,"text":"\r"},{"line":36,"text":"\r"},{"line":37,"text":"def gun(v):\r"},{"line":38,"text":"    return [round(v.x * 100.0, 4), round(-v.y * 100.0, 4), round(v.z * 100.0, 4)]\r"},{"line":39,"text":"\r"},{"line":40,"text":"\r"},{"line":41,"text":"bpy.ops.wm.read_factory_settings(use_empty=True)\r"},{"line":42,"text":"bpy.context.scene.unit_settings.scale_length = 1.0\r"},{"line":43,"text":"\r"},{"line":44,"text":"# --- the meshes: a proxy's shapes, or the user's model turned into gun space -----------------------------------------\r"},{"line":45,"text":"COLOURS = {None: (0.18, 0.18, 0.2, 1.0)}\r"},{"line":46,"text":"\r"},{"line":47,"text":"\r"},{"line":48,"text":"def material(role):\r"},{"line":49,"text":"    if role not in COLOURS:\r"},{"line":50,"text":"        h = (abs(hash(role)) % 360) / 360.0\r"},{"line":51,"text":"        import colorsys\r"},{"line":52,"text":"        r, gg, b = colorsys.hsv_to_rgb(h, 0.55, 0.8)\r"},{"line":53,"text":"        COLOURS[role] = (r, gg, b, 1.0)\r"},{"line":54,"text":"    name = \"M_\" + (R.bone_name(role) if role else \"Body\")\r"},{"line":55,"text":"    m = bpy.data.materials.get(name) or bpy.data.materials.new(name)\r"},{"line":56,"text":"    m.diffuse_color = COLOURS[role]\r"},{"line":57,"text":"    return m\r"},{"line":58,"text":"\r"},{"line":59,"text":"\r"},{"line":60,"text":"objects = {}\r"},{"line":61,"text":"if job.get(\"shapes\"):\r"},{"line":62,"text":"    for s in job[\"shapes\"]:\r"},{"line":63,"text":"        if s[\"shape\"] == \"box\":\r"}],"name":"job","start_line":23,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_rig.py#var:job"}}
