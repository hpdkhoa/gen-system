}\r"},{"line":42,"text":"    if \"DustCover\" in mv:\r"},{"line":43,"text":"        parts[\"cover\"] = {\"vertex_groups\": [\"DustCover\"], \"axis\": mv[\"DustCover\"][\"axis\"], \"turn_deg\": mv[\"DustCover\"][\"open_deg\"],\r"},{"line":44,"text":"                          \"pivot\": [round(v, 3) for v in mv[\"DustCover\"][\"hinge\"]]}\r"},{"line":45,"text":"    if \"BoltCatch\" in mv:\r"},{"line":46,"text":"        parts[\"catch\"] = {\"vertex_groups\": [\"BoltCatch\"], \"axis\": [0, 0, 1], \"travel_cm\": mv[\"BoltCatch\"][\"lift_cm\"]}\r"},{"line":47,"text":"    if \"MagRelease\" in mv:\r"},{"line":48,"text":"        parts[\"release\"] = {\"vertex_groups\": [\"MagRelease\"], \"axis\": mv[\"MagRelease\"][\"axis\"], \"travel_cm\": mv[\"MagRelease\"][\"press_cm\"]}\r"},{"line":49,"text":"    if \"ForwardAssist\" in mv:\r"},{"line":50,"text":"        parts[\"assist\"] = {\"vertex_groups\": [\"ForwardAssist\"], \"axis\": mv[\"ForwardAssist\"][\"axis\"], \"travel_cm\": mv[\"ForwardAssist\"][\"press_cm\"]}\r"},{"line":51,"text":"    tb = _box(sb, \"Trigger\")\r"},{"line":52,"text":"    if \"Trigger\" in mv and tb:\r"},{"line":53,"text":"        parts[\"trigger\"] = {\"vertex_groups\": [\"Trigger\"], \"axis\": [1, 0, 0], \"turn_deg\": mv[\"Trigger\"][\"pull_deg\"],\r"},{"line":54,"text":"                            \"pivot\": [0.0, _mid(tb, 1), round(tb[1][2], 3)]}\r"},{"line":55,"text":"    grip = _box(sb, \"Grip\")\r"},{"line":56,"text":"    mag = _box(sb, \"Magazine_Body\")\r"},{"line":57,"text":"    wing = _box(sb, \"Charging_Wing\", \"Charging_Latch\")\r"},{"line":58,"text":"    marks = {\"muzzle\": at(\"muzzle\"), \"trigger\": at(\"trigger\"), \"support\": at(\"support_l\"),\r"},{"line":59,"text":"             \"port\": at(\"eject_port\"), \"mag_well\": at(\"magwell\"), \"mag_lips\": at(\"mag_lips\"),\r"},{"line":60,"text":"             \"grip\": [round(grip[0][0], 3), _mid(grip, 1), _mid(grip, 2)] if grip else at(\"grip_r\"),\r"},{"line":61,"text":"             \"mag_grab\": [round(mag[1][0], 3), _mid(mag, 1), round(mag[0][2] + (mag[1][2] - mag[0][2]) * 0.3, 3)] if mag else at(\"mag_lips\"),\r"},{"line":62,"text":"             \"handle\": [round(wing[1][0], 3), _mid(wing, 1), _mid(wing, 2)] if wing else at(\"charging_handle\")}\r"},{"line":63,"text":"    for name, shape, side in ((\"catch\", \"BoltCatch\", 1), (\"release\", \"MagRelease\", 0), (\"assist\", \"ForwardAssist\", 0)):\r"},{"line":64,"text":"        b = _box(sb, shape)\r"},{"line":65,"text":"        if b:\r"},{"line":66,"text":"            marks[name] = [round(b[side][0], 3), _mid(b, 1), _mid(b, 2)]\r"},{"line":67,"text":"    return {\"contract\": X.CONTRACT, \"name\": \"ML_\" + f[\"name\"], \"action\": action, \"model\": str(folder / (\"%s.blend\" % f[\"name\"])),\r"},{"line":68,"text":"            \"units\": \"m\", \"forward\": \"-Y\", \"up\": \"+Z\", \"origin\": [0.0, 0.0, 0.0], \"parts\": parts, \"marks\": marks,\r"},{"line":69,"text":"            \"mark_parts\": {\"handle\": \"handle\", \"mag_grab\": \"magazine\", \"mag_lips\": \"magazine\"},\r"},{"line":70,"text":"            # which way each hand mark's surface faces (a palm is laid facing into it): the grip's right face, under\r"},{"line":71,"text":"            # the handguard, the magazine's left face, the handle's left wing, the catch on the left, buttons on the right\r"},{"line":72,"text":"            \"normals\": {\"port\": mk[\"eject_port\"].get(\"normal\", [-1.0, 0.0, 0.0]), \"grip\": [-1.0, 0.0, 0.0],\r"},{"line":73,"text":"                        \"support\": [0.0, 0.0, -1.0], \"mag_grab\": [1.0, 0.0, 0.0], \"handle\": [1.0, 0.0, 0.0],\r"},{"line":74,"text":"                        \"catch\": [1.0, 0.0, 0.0], \"release\": [-1.0, 0.0, 0.0], \"assist\": [-1.0, 0.0, 0.0]},\r"},{"line":75,"text":"            \"magazine\": {\"lips\": at(\"mag_lips\")},\r"},{"line":76,"text":"            \"sources\": [\"Model Lab build %s (%s, %s)\" % (folder.name, f.get(\"platform\"), f.get(\"params\", {}).get(\"barrel_in\", \"?\"))]}\r"}],"name":"partsmap","start_line":28,"symbol_id":"hold-code/weaponlab/gunkit/modellab.py#func:partsmap"}}
