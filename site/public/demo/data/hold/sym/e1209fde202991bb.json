old-code/poselab_mcp/blender/holdlab.py","kind":"func","language":"python","lines":[{"line":111,"text":"def _ring(hull, n=24):\r"},{"line":112,"text":"    \"\"\"n points evenly round a closed 2D polygon.\"\"\"\r"},{"line":113,"text":"    if len(hull) < 3:\r"},{"line":114,"text":"        return list(hull)\r"},{"line":115,"text":"    segs = [(hull[i], hull[(i + 1) % len(hull)]) for i in range(len(hull))]\r"},{"line":116,"text":"    L = [math.dist(a, b) for a, b in segs]\r"},{"line":117,"text":"    tot = sum(L)\r"},{"line":118,"text":"    out, k, acc = [], 0, 0.0\r"},{"line":119,"text":"    for i in range(n):\r"},{"line":120,"text":"        s = tot * i / n\r"},{"line":121,"text":"        while k < len(segs) - 1 and acc + L[k] < s:\r"},{"line":122,"text":"            acc += L[k]\r"},{"line":123,"text":"            k += 1\r"},{"line":124,"text":"        a, b = segs[k]\r"},{"line":125,"text":"        t = 0.0 if L[k] < 1e-12 else (s - acc) / L[k]\r"},{"line":126,"text":"        out.append((a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t))\r"},{"line":127,"text":"    return out\r"}],"name":"_ring","start_line":111,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#func:_ring"}}
