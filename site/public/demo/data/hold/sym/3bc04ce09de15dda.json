{"flow":{"kind":"var","name":"NAMES","noCFG":true,"reason":"NAMES is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":59,"file":"hold-code/weaponlab/contracts/__init__.py","kind":"var","language":"python","lines":[{"line":19,"text":"NAMES = {\"weaponlab-sources/1\": \"sources\", \"weaponlab-blueprint/1\": \"blueprint\", \"weaponlab-partsmap/1\": \"partsmap\",\r"},{"line":20,"text":"         \"weaponlab-gripstyle/1\": \"gripstyle\", \"weaponlab-character/1\": \"character\"}\r"},{"line":21,"text":"\r"},{"line":22,"text":"\r"},{"line":23,"text":"@lru_cache(maxsize=None)\r"},{"line":24,"text":"def schema(name):\r"},{"line":25,"text":"    \"\"\"A contract's JSON Schema, by its short name (sources, blueprint, partsmap) or its full id.\"\"\"\r"},{"line":26,"text":"    short = NAMES.get(name, name)\r"},{"line":27,"text":"    return json.loads((HERE / (\"%s.schema.json\" % short)).read_text(encoding=\"utf-8\"))\r"},{"line":28,"text":"\r"},{"line":29,"text":"\r"},{"line":30,"text":"def _schema_problems(doc, name):\r"},{"line":31,"text":"    v = jsonschema.Draft202012Validator(schema(name))\r"},{"line":32,"text":"    out = []\r"},{"line":33,"text":"    for e in sorted(v.iter_errors(doc), key=lambda e: list(e.absolute_path)):\r"},{"line":34,"text":"        where = \"/\".join(str(p) for p in e.absolute_path) or \"(top)\"\r"},{"line":35,"text":"        msg = e.message if len(e.message) < 300 else e.message[:300] + \"...\"\r"},{"line":36,"text":"        out.append(\"%s: %s\" % (where, msg))\r"},{"line":37,"text":"    return out\r"},{"line":38,"text":"\r"},{"line":39,"text":"\r"},{"line":40,"text":"def check_sources(doc):\r"},{"line":41,"text":"    bad = _schema_problems(doc, \"sources\")\r"},{"line":42,"text":"    if bad:\r"},{"line":43,"text":"        return bad\r"},{"line":44,"text":"    ids = [s[\"id\"] for s in doc[\"sources\"]]\r"},{"line":45,"text":"    for i in {i for i in ids if ids.count(i) > 1}:\r"},{"line":46,"text":"        bad.append(\"sources: id %s is used twice\" % i)\r"},{"line":47,"text":"    pages = {s[\"id\"]: s.get(\"pages\") for s in doc[\"sources\"]}\r"},{"line":48,"text":"    for kind in (\"pages\", \"figures\", \"facts\"):\r"},{"line":49,"text":"        for n, x in enumerate(doc.get(kind, [])):\r"},{"line":50,"text":"            if x[\"source\"] not in pages:\r"},{"line":51,"text":"                bad.append(\"%s/%d: source %s is not in sources\" % (kind, n, x[\"source\"]))\r"},{"line":52,"text":"            elif pages[x[\"source\"]] and x[\"page\"] > pages[x[\"source\"]]:\r"},{"line":53,"text":"                bad.append(\"%s/%d: page %d is past the source's %d pages\" % (kind, n, x[\"page\"], pages[x[\"source\"]]))\r"},{"line":54,"text":"    for kind in (\"figures\", \"facts\"):\r"},{"line":55,"text":"        xs = [x[\"id\"] for x in doc.get(kind, [])]\r"},{"line":56,"text":"        for i in {i for i in xs if xs.count(i) > 1}:\r"},{"line":57,"text":"            bad.append(\"%s: id %s is used twice\" % (kind, i))\r"},{"line":58,"text":"    facts = {f[\"id\"] for f in doc.get(\"facts\", [])}\r"},{"line":59,"text":"    for f in doc.get(\"figures\", []):\r"}],"name":"NAMES","start_line":19,"symbol_id":"hold-code/weaponlab/contracts/__init__.py#var:NAMES"}}
