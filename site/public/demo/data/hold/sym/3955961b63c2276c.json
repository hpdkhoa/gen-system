{"flow":{"kind":"var","name":"cam","noCFG":true,"reason":"cam is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":69,"file":"hold-code/weaponlab/blueprint/blender/blueprint_render.py","kind":"var","language":"python","lines":[{"line":34,"text":"cam = bpy.data.objects.new(\"Cam\", cam_data)\r"},{"line":35,"text":"sc.collection.objects.link(cam)\r"},{"line":36,"text":"sc.camera = cam\r"},{"line":37,"text":"out = {\"views\": {}}\r"},{"line":38,"text":"\r"},{"line":39,"text":"\r"},{"line":40,"text":"def shoot(name, loc, look, ortho=True, pad=1.15):\r"},{"line":41,"text":"    cam.location = loc\r"},{"line":42,"text":"    d = (look - loc).normalized()\r"},{"line":43,"text":"    cam.rotation_euler = d.to_track_quat('-Z', 'Y').to_euler()\r"},{"line":44,"text":"    if ortho:\r"},{"line":45,"text":"        cam_data.type = 'ORTHO'\r"},{"line":46,"text":"        w_m = max(size.y, size.x) * pad if abs(d.x) > 0.5 else max(size.y, size.z) * pad\r"},{"line":47,"text":"        h_m = size.z * pad\r"},{"line":48,"text":"        sc.render.resolution_x = int(w_m * 100 / S)\r"},{"line":49,"text":"        sc.render.resolution_y = int(h_m * 100 / S)\r"},{"line":50,"text":"        cam_data.ortho_scale = max(w_m, h_m)\r"},{"line":51,"text":"    else:\r"},{"line":52,"text":"        cam_data.type = 'PERSP'\r"},{"line":53,"text":"        cam_data.lens = 50\r"},{"line":54,"text":"        sc.render.resolution_x, sc.render.resolution_y = 1400, 900\r"},{"line":55,"text":"    sc.render.filepath = os.path.join(OUT, \"%s.png\" % name)\r"},{"line":56,"text":"    bpy.ops.render.render(write_still=True)\r"},{"line":57,"text":"    out[\"views\"][name] = {\"file\": sc.render.filepath, \"px\": [sc.render.resolution_x, sc.render.resolution_y], \"ortho\": ortho,\r"},{"line":58,"text":"                          \"cm_per_px\": S if ortho else None}\r"},{"line":59,"text":"\r"},{"line":60,"text":"\r"},{"line":61,"text":"far = max(size) * 4 + 1.0\r"},{"line":62,"text":"# Blender's world: gun +X (left) is +X, the muzzle toward -Y, up +Z\r"},{"line":63,"text":"shoot(\"view_left\", mid + Vector((far, 0, 0)), mid)\r"},{"line":64,"text":"shoot(\"view_right\", mid + Vector((-far, 0, 0)), mid)\r"},{"line":65,"text":"shoot(\"view_three_quarter\", mid + Vector((far * 0.45, -far * 0.35, far * 0.25)) * 0.35 + mid * 0.65, mid, ortho=False)\r"},{"line":66,"text":"with open(os.path.join(OUT, \"render.json\"), \"w\", encoding=\"utf-8\") as f:\r"},{"line":67,"text":"    json.dump(out, f, indent=1)\r"},{"line":68,"text":"print(\"BLUEPRINT RENDER \" + json.dumps(list(out[\"views\"])))\r"},{"line":69,"text":""}],"name":"cam","start_line":34,"symbol_id":"hold-code/weaponlab/blueprint/blender/blueprint_render.py#var:cam"}}
