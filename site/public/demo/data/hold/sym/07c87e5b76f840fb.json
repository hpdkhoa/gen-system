6,"text":"    A.load(action_id)\r"},{"line":47,"text":"    for i in ids(\"gripstyles\"):\r"},{"line":48,"text":"        s = style(i)\r"},{"line":49,"text":"        if action_id in s[\"families\"]:\r"},{"line":50,"text":"            return s\r"},{"line":51,"text":"    return None\r"},{"line":52,"text":"\r"}],"name":"HERE","start_line":12,"symbol_id":"hold-code/weaponlab/gunkit/setup.py#var:HERE"}}
