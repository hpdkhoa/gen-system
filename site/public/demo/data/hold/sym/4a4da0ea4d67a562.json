{"flow":{"blocks":[{"id":0,"label":"entry","lines":[{"kind":"call","line":1169,"text":"FL = self._limits()[1]"},{"kind":"call","line":1170,"text":"TL = self._thumb_limits()"},{"kind":"call","line":1171,"text":"hn = self._n(\"hand\", side)"},{"kind":"call","line":1220,"text":"m = next(x for x in marks if x.get(\"role\") == \"hold\" and x.get(\"hand\", side) == side)"},{"kind":"call","line":1221,"text":"run = self._object[\"parts\"][m[\"part\"]][\"runs\"][m.get(\"run\", 0)]"},{"kind":"call","line":1238,"text":"moves = [around, along] + [move(a) for a in AX] + [turn(a) for a in AX] + [swing, girdle(0), girdle(1)]"},{"kind":"call","line":1239,"text":"moves += [curl(fi, j) for fi in fingers for j in (\"01\", \"02\", \"03\")] + [tbend(\"02\"), tbend(\"03\")]"},{"kind":"call","line":1240,"text":"return self._descend(err, moves, side, other, steps=(4.0, 2.0, 1.0))"}],"preds":null,"stmts":["call self._limits","call self._thumb_limits","call self._n","call next","call x.get","call x.get","call m.get","call move","call turn","call girdle","call girdle","call curl","call tbend","call tbend","call self._descend","return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[0],"func_id":"hold-code/poselab_mcp/blender/holdlab.py#method:HoldMixin._polish","issues":null},"source":{"end_line":1240,"file":"hold-code/poselab_mcp/blender/holdlab.py","kind":"method","language":"python","lines":[{"line":1165,"text":"    def _polish(self, side, marks, glove_cm, other, fingers):\r"},{"line":1166,"text":"        \"\"\"The whole hold tuned on the gate's own ruler (the hold score) by a fixed step pattern: the hand moved\r"},{"line":1167,"text":"        along and turned about three axes (a step of 4 is 0.2 cm or 2 degrees), then each finger's joints and the\r"},{"line":1168,"text":"        thumb's bends. Returns the score.\"\"\"\r"},{"line":1169,"text":"        FL = self._limits()[1]\r"},{"line":1170,"text":"        TL = self._thumb_limits()\r"},{"line":1171,"text":"        hn = self._n(\"hand\", side)\r"},{"line":1172,"text":"\r"},{"line":1173,"text":"        def err():\r"},{"line":1174,"text":"            return sum(r[\"error\"] for r in self.hold_purposes(side, marks, glove_cm, other=other) if not r.get(\"hard\"))\r"},{"line":1175,"text":"\r"},{"line":1176,"text":"        def move(ax):\r"},{"line":1177,"text":"            def mv(st):\r"},{"line":1178,"text":"                M = Matrix.Translation(Vector(ax) * (st * 0.0005)) @ self._bw(hn)\r"},{"line":1179,"text":"                self._put_hand(side, Matrix.LocRotScale(M.translation, M.to_quaternion(), self._unit()))\r"},{"line":1180,"text":"            return mv\r"},{"line":1181,"text":"\r"},{"line":1182,"text":"        def turn(ax):\r"},{"line":1183,"text":"            def mv(st):\r"},{"line":1184,"text":"                M = self._bw(hn)\r"},{"line":1185,"text":"                pc = Vector(list(self._skin_part(side, [\"palm\"]).mean(0)))\r"},{"line":1186,"text":"                R = Matrix.Translation(pc) @ Matrix.Rotation(math.radians(st * 0.5), 4, Vector(ax)) @ Matrix.Translation(-pc)\r"},{"line":1187,"text":"                M = R @ M\r"},{"line":1188,"text":"                self._put_hand(side, Matrix.LocRotScale(M.translation, M.to_quaternion(), self._unit()))\r"},{"line":1189,"text":"            return mv\r"},{"line":1190,"text":"\r"},{"line":1191,"text":"        def curl(fi, j):\r"},{"line":1192,"text":"            def mv(st):\r"},{"line":1193,"text":"                self._set_curl(side, fi, j, self._finger_report(side, FL)[0][\"%s_%s\" % (fi, j)][0] + st, FL)\r"},{"line":1194,"text":"            return mv\r"},{"line":1195,"text":"\r"},{"line":1196,"text":"        def tbend(j):\r"},{"line":1197,"text":"            def mv(st):\r"},{"line":1198,"text":"                if self.R.get(\"thumb_hinge\") == \"ray\":\r"},{"line":1199,"text":"                    self._thumb_flex(side, j, st)\r"},{"line":1200,"text":"                else:\r"},{"line":1201,"text":"                    tr = self._thumb_report(side, TL)[0]\r"},{"line":1202,"text":"                    b2, b3 = tr.get(\"thumb_02\", [0, 0])[0], tr.get(\"thumb_03\", [0, 0])[0]\r"},{"line":1203,"text":"                    self._set_thumb_bend(side, b2 + (st if j == \"02\" else 0.0), b3 + (st if j == \"03\" else 0.0), TL)\r"},{"line":1204,"text":"            return mv\r"},{"line":1205,"text":"        def swing(st):\r"},{"line":1206,"text":"            self._swing_elbow(side, st * 2.0)                 # the elbow about the shoulder-wrist line, the hand kept\r"},{"line":1207,"text":"            self._roll_forearm(side)\r"},{"line":1208,"text":"\r"},{"line":1209,"text":"        def girdle(k):\r"},{"line":1210,"text":"            def mv(st):\r"},{"line":1211,"text":"                keep = self._bw(hn).copy()\r"},{"line":1212,"text":"                if not hasattr(self, \"_clav_now\"):\r"},{"line":1213,"text":"                    self._clav_now = {}\r"},{"line":1214,"text":"                pr, el = self._clav_now.get(side, (0.0, 0.0))\r"},{"line":1215,"text":"                pr, el = (pr + st, el) if k == 0 else (pr, el + st)\r"},{"line":1216,"text":"                got = self.shoulder(side, pr, el)\r"},{"line":1217,"text":"                self._clav_now[side] = (got[\"protraction_deg\"], got[\"elevation_deg\"])\r"},{"line":1218,"text":"                self._put_hand(side, keep)\r"},{"line":1219,"text":"            return mv\r"},{"line":1220,"text":"        m = next(x for x in marks if x.get(\"role\") == \"hold\" and x.get(\"hand\", side) == side)\r"},{"line":1221,"text":"        run = self._object[\"parts\"][m[\"part\"]][\"runs\"][m.get(\"run\", 0)]\r"},{"line":1222,"text":"\r"},{"line":1223,"text":"        def around(st):\r"},{"line":1224,"text":"            # the hand turned round the run's axis (st x 1.5 degrees): a hand finds its comfortable place on a handle\r"},{"line":1225,"text":"            RW = self._run_world(run)\r"},{"line":1226,"text":"            ax = (RW[\"inner\"] - RW[\"outer\"]).normalized()\r"},{"line":1227,"text":"            c = RW[\"outer\"].lerp(RW[\"inner\"], 0.5)\r"},{"line":1228,"text":"            R = Matrix.Translation(c) @ Matrix.Rotation(math.radians(st * 1.5), 4, ax) @ Matrix.Translation(-c)\r"},{"line":1229,"text":"            M = R @ self._bw(hn)\r"},{"line":1230,"text":"            self._put_hand(side, Matrix.LocRotScale(M.translation, M.to_quaternion(), self._unit()))\r"},{"line":1231,"text":"\r"},{"line":1232,"text":"        def along(st):\r"},{"line":1233,"text":"            RW = self._run_world(run)\r"},{"line":1234,"text":"            ax = (RW[\"inner\"] - RW[\"outer\"]).normalized()\r"},{"line":1235,"text":"            M = Matrix.Translation(ax * (st * 0.001)) @ self._bw(hn)\r"},{"line":1236,"text":"            self._put_hand(side, Matrix.LocRotScale(M.translation, M.to_quaternion(), self._unit()))\r"},{"line":1237,"text":"        AX = ((1, 0, 0), (0, 1, 0), (0, 0, 1))\r"},{"line":1238,"text":"        moves = [around, along] + [move(a) for a in AX] + [turn(a) for a in AX] + [swing, girdle(0), girdle(1)]\r"},{"line":1239,"text":"        moves += [curl(fi, j) for fi in fingers for j in (\"01\", \"02\", \"03\")] + [tbend(\"02\"), tbend(\"03\")]\r"},{"line":1240,"text":"        return self._descend(err, moves, side, other, steps=(4.0, 2.0, 1.0))\r"}],"name":"_polish","start_line":1165,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#method:HoldMixin._polish"}}
