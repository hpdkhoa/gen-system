      for j in (\"01\", \"02\", \"03\"):\r"},{"line":1059,"text":"                curl, twist = fr[\"%s_%s\" % (fi, j)]\r"},{"line":1060,"text":"                lo, tw = HOLD_DIGIT_LIMITS[j]\r"},{"line":1061,"text":"                if curl < lo:\r"},{"line":1062,"text":"                    bad.append(\"%s %s bent %d backward (a holding finger: at most %d)\" % (fi, j, -curl, -lo))\r"},{"line":1063,"text":"                if abs(twist) > tw:\r"},{"line":1064,"text":"                    bad.append(\"%s %s twisted %d out of its plane (a holding finger: at most %d)\" % (fi, j, abs(twist), tw))\r"},{"line":1065,"text":"        for j in (\"02\", \"03\"):\r"},{"line":1066,"text":"            if \"thumb_\" + j not in tr:\r"},{"line":1067,"text":"                continue\r"},{"line":1068,"text":"            bend, twist = tr[\"thumb_\" + j]\r"},{"line":1069,"text":"            lo, tw = HOLD_DIGIT_LIMITS[\"thumb_\" + j]\r"},{"line":1070,"text":"            if bend < lo:\r"},{"line":1071,"text":"                bad.append(\"thumb %s bent %d backward (at most %d)\" % (j, -bend, -lo))\r"},{"line":1072,"text":"            if abs(twist) > tw:\r"},{"line":1073,"text":"                bad.append(\"thumb %s twisted %d out of its plane (at most %d)\" % (j, abs(twist), tw))\r"},{"line":1074,"text":"        return {\"purpose\": \"digits\", \"met\": not bad, \"error\": float(len(bad)), \"hard\": True, \"faults\": bad}\r"}],"name":"hold_digit_rule","start_line":1049,"symbol_id":"hold-code/poselab_mcp/blender/contactlab.py#method:ContactMixin.hold_digit_rule"}}
