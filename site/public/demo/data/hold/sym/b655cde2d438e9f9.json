,{"id":88,"label":"then","preds":[67],"stmts":null,"succs":[89]},{"id":89,"label":"merge","preds":[88,67],"stmts":null,"succs":[62]}],"effects":["unknown"],"entry":0,"exits":[17,61],"func_id":"hold-code/poselab_mcp/blender/lab.py#func:_mend_hand","issues":null},"source":{"end_line":3155,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"func","language":"python","lines":[{"line":3059,"text":"    def _mend_hand(self, s, fingers=True):\r"},{"line":3060,"text":"        \"\"\"The wrist back inside its limits (turned toward the forearm's line), then each finger joint back inside its\r"},{"line":3061,"text":"        curl range (turned about the finger's own hinge, the better way) and the knuckle and middle joint back into the\r"},{"line":3062,"text":"        finger's plane. Returns how many corrections it made.\"\"\"\r"},{"line":3063,"text":"        L, FL = self._limits()\r"},{"line":3064,"text":"        made = 0\r"},{"line":3065,"text":"        hn = self._n(\"hand\", s)\r"},{"line":3066,"text":"        tree = self._tree()\r"},{"line":3067,"text":"        back0 = self._hand_contacts(s, tree)[3]\r"},{"line":3068,"text":"        for _ in range(3):\r"},{"line":3069,"text":"            rep_, bad = self._arm_report(s, L)\r"},{"line":3070,"text":"            over = max(rep_[\"wrist_bend_deg\"] - L[\"wrist_max_deg\"], rep_[\"wrist_radial_deg\"] - L[\"wrist_radial_deg\"],\r"},{"line":3071,"text":"                       -rep_[\"wrist_radial_deg\"] - L[\"wrist_ulnar_deg\"], 0.0)\r"},{"line":3072,"text":"            if over <= 0.0 or rep_[\"wrist_bend_deg\"] <= 0.0:\r"},{"line":3073,"text":"                break\r"},{"line":3074,"text":"            line = (self._bw(hn).translation - self._bw(self._n(\"lowerarm\", s)).translation).normalized()\r"},{"line":3075,"text":"            hand = (self._bw(self._n(\"finger\", s, \"middle\", \"01\")).translation - self._bw(hn).translation).normalized()\r"},{"line":3076,"text":"            want = min(1.0, (over + 1.0) / rep_[\"wrist_bend_deg\"])\r"},{"line":3077,"text":"            H = self._bw(hn)\r"},{"line":3078,"text":"            turned = False\r"},{"line":3079,"text":"            for part in (1.0, 0.5, 0.25):          # the largest turn that keeps the back of the hand out of the rifle\r"},{"line":3080,"text":"                q = Quaternion().slerp(hand.rotation_difference(line), want * part)\r"},{"line":3081,"text":"                self._set_world(hn, Matrix.LocRotScale(H.translation, q @ H.to_quaternion(), self._unit()))\r"},{"line":3082,"text":"                if self._hand_contacts(s, tree)[3] <= max(back0, 0.1) + 1e-6:\r"},{"line":3083,"text":"                    turned = True\r"},{"line":3084,"text":"                    break\r"},{"line":3085,"text":"                self._set_world(hn, H)\r"},{"line":3086,"text":"            if not turned:\r"},{"line":3087,"text":"                break\r"},{"line":3088,"text":"            made += 1\r"},{"line":3089,"text":"        if not fingers or not self._has_fingers(s):\r"},{"line":3090,"text":"            return made\r"},{"line":3091,"text":"        for _ in range(4):\r"},{"line":3092,"text":"            changed = False\r"},{"line":3093,"text":"            for fi in (\"index\", \"middle\", \"ring\", \"pinky\"):\r"},{"line":3094,"text":"                for j in (\"01\", \"02\", \"03\"):\r"},{"line":3095,"text":"                    fr, _b, planes = self._finger_report(s, FL)\r"},{"line":3096,"text":"                    curl, side_deg = fr[\"%s_%s\" % (fi, j)]\r"},{"line":3097,"text":"                    lo, hi, sd = FL[j]\r"},{"line":3098,"text":"                    n = self._n(\"finger\", s, fi, j)\r"},{"line":3099,"text":"                    head = self._bw(n).translation\r"},{"line":3100,"text":"                    if curl <= lo + 0.5 or curl >= hi - 0.5:\r"},{"line":3101,"text":"                        fix = (lo + 3.0 - curl) if curl <= lo + 0.5 else (hi - 3.0 - curl)\r"},{"line":3102,"text":"                        axis = planes[fi]\r"},{"line":3103,"text":"                        over0 = (lo - curl) if curl < lo else (curl - hi)\r"},{"line":3104,"text":"                        M = self._bw(n)\r"},{"line":3105,"text":"                        for sg in (1.0, -1.0):\r"},{"line":3106,"text":"                            self._turn_about(n, axis, fix * sg, head)\r"},{"line":3107,"text":"                            c2 = self._finger_report(s, FL)[0][\"%s_%s\" % (fi, j)][0]\r"},{"line":3108,"text":"                            if ((lo - c2) if c2 < lo else (c2 - hi) if c2 > hi else -1.0) < over0:\r"},{"line":3109,"text":"                                break\r"},{"line":3110,"text":"                            self._set_world(n, M)\r"},{"line":3111,"text":"                        made += 1\r"},{"line":3112,"text":"                        changed = True\r"},{"line":3113,"text":"                    elif j != \"03\" and abs(side_deg) >= sd - 0.5:\r"},{"line":3114,"text":"                        child = self._bw(self._n(\"finger\", s, fi, \"%02d\" % (int(j) + 1))).translation\r"},{"line":3115,"text":"                        axis = (child - head).cross(planes[fi])\r"},{"line":3116,"text":"                        if axis.length < 1e-9:\r"},{"line":3117,"text":"                            continue\r"},{"line":3118,"text":"                        fix = math.copysign(sd - 3.0, side_deg) - side_deg\r"},{"line":3119,"text":"                        M = self._bw(n)\r"},{"line":3120,"text":"                        for sg in (1.0, -1.0):\r"},{"line":3121,"text":"                            self._turn_about(n, axis.normalized(), fix * sg, head)\r"},{"line":3122,"text":"                            if abs(self._finger_report(s, FL)[0][\"%s_%s\" % (fi, j)][1]) < abs(side_deg):\r"},{"line":3123,"text":"                                break\r"},{"line":3124,"text":"                            self._set_world(n, M)\r"},{"line":3125,"text":"                        made += 1\r"},{"line":3126,"text":"                        changed = True\r"},{"line":3127,"text":"            if not changed:\r"},{"line":3128,"text":"                break\r"},{"line":3129,"text":"        if self._has_thumb(s):\r"},{"line":3130,"text":"            TL = self._thumb_limits()\r"},{"line":3131,"text":"            for _ in range(3):\r"},{"line":3132,"text":"                changed = False\r"},{"line":3133,"text":"                for j in (\"02\", \"03\"):\r"},{"line":3134,"text":"                    tr, _b, axes = self._thumb_report(s, TL)\r"},{"line":3135,"text":"                    if \"thumb_\" + j not in tr or j not in axes:\r"},{"line":3136,"text":"                        continue\r"},{"line":3137,"text":"                    bend = tr[\"thumb_\" + j][0]\r"},{"line":3138,"text":"                    lo, hi, _sd = TL[j]\r"},{"line":3139,"text":"                    if lo + 0.5 < bend < hi - 0.5:\r"},{"line":3140,"text":"                        continue\r"},{"line":3141,"text":"                    fix = (lo + 3.0 - bend) if bend <= lo + 0.5 else (hi - 3.0 - bend)\r"},{"line":3142,"text":"                    over0 = (lo - bend) if bend < lo else (bend - hi)\r"},{"line":3143,"text":"                    n = self._n(\"finger\", s, \"thumb\", j)\r"},{"line":3144,"text":"                    head, M = self._bw(n).translation.copy(), self._bw(n)\r"},{"line":3145,"text":"                    for sg in (1.0, -1.0):\r"},{"line":3146,"text":"                        self._turn_about(n, axes[j], fix * sg, head)\r"},{"line":3147,"text":"                        b2 = self._thumb_report(s, TL)[0][\"thumb_\" + j][0]\r"},{"line":3148,"text":"                        if ((lo - b2) if b2 < lo else (b2 - hi) if b2 > hi else -1.0) < over0:\r"},{"line":3149,"text":"                            break\r"},{"line":3150,"text":"                        self._set_world(n, M)\r"},{"line":3151,"text":"                    made += 1\r"},{"line":3152,"text":"                    changed = True\r"},{"line":3153,"text":"                if not changed:\r"},{"line":3154,"text":"                    break\r"},{"line":3155,"text":"        return made\r"}],"name":"_mend_hand","start_line":3059,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:_mend_hand"}}
