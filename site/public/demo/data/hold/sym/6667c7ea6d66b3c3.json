and).translation\r"},{"line":439,"text":"        l1, l2 = (E - S).length, (W - E).length\r"},{"line":440,"text":"        d = min((goal - S).length, l1 + l2 - 1e-4)\r"},{"line":441,"text":"        axis = (goal - S).normalized()\r"},{"line":442,"text":"        sidev = (pole - S) - axis * (pole - S).dot(axis)\r"},{"line":443,"text":"        sidev = sidev.normalized() if sidev.length > 1e-6 else Vector((0, 0, -1))\r"},{"line":444,"text":"        x = (l1 * l1 - l2 * l2 + d * d) / (2 * d)\r"},{"line":445,"text":"        h = max(l1 * l1 - x * x, 0.0) ** 0.5\r"},{"line":446,"text":"        E2, W2 = S + axis * x + sidev * h, S + axis * d\r"},{"line":447,"text":"        self._turn(upper, (E - S).rotation_difference(E2 - S))\r"},{"line":448,"text":"        E, W = self._bw(lower).translation, self._bw(hand).translation\r"},{"line":449,"text":"        self._turn(lower, (W - E).rotation_difference(W2 - E))\r"},{"line":450,"text":"        return (self._bw(hand).translation - goal).length * 100.0\r"}],"name":"_two_bone","start_line":433,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:_two_bone"}}
