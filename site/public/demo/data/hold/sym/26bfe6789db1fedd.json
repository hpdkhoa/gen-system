= L._n(\"finger\", side, \"thumb\", j)\r"},{"line":346,"text":"        head, M = L._bw(n).translation.copy(), L._bw(n)\r"},{"line":347,"text":"        for sg in (1.0, -1.0):\r"},{"line":348,"text":"            L._turn_about(n, axes[j], (target - cur) * sg, head)\r"},{"line":349,"text":"            if abs(L._thumb_report(side, _TL)[0][\"thumb_\" + j][0] - target) < abs(cur - target):\r"},{"line":350,"text":"                break\r"},{"line":351,"text":"            L._set_world(n, M)\r"},{"line":352,"text":"    for _ in range(3):\r"},{"line":353,"text":"        for j in (\"02\", \"03\"):\r"},{"line":354,"text":"            tr, _b, axes = L._thumb_report(side, _TL)\r"},{"line":355,"text":"            if \"thumb_\" + j not in tr or j not in axes:\r"},{"line":356,"text":"                continue\r"},{"line":357,"text":"            side_deg = tr[\"thumb_\" + j][1]\r"},{"line":358,"text":"            if abs(side_deg) < 3.0:\r"},{"line":359,"text":"                continue\r"},{"line":360,"text":"            n = L._n(\"finger\", side, \"thumb\", j)\r"},{"line":361,"text":"            head = L._bw(n).translation.copy()\r"},{"line":362,"text":"            tip = L._bw(L._n(\"finger\", side, \"thumb\", \"03\")).translation if j == \"02\" else L._finger_tip(\"thumb\", side)\r"},{"line":363,"text":"            w = (tip - head).cross(axes[j])\r"},{"line":364,"text":"            if w.length < 1e-9:\r"},{"line":365,"text":"                continue\r"},{"line":366,"text":"            w.normalize()\r"},{"line":367,"text":"            M = L._bw(n)\r"},{"line":368,"text":"            for sg in (1.0, -1.0):\r"},{"line":369,"text":"                L._turn_about(n, w, -side_deg * sg, head)\r"},{"line":370,"text":"                if abs(L._thumb_report(side, _TL)[0][\"thumb_\" + j][1]) < abs(side_deg):\r"},{"line":371,"text":"                    break\r"},{"line":372,"text":"                L._set_world(n, M)\r"}],"name":"set_thumb","start_line":337,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:set_thumb"}}
