{"flow":{"kind":"var","name":"HERE","noCFG":true,"reason":"HERE is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":55,"file":"hold-code/poselab_mcp/worker_client.py","kind":"var","language":"python","lines":[{"line":15,"text":"HERE = Path(__file__).resolve().parent\r"},{"line":16,"text":"WORKER = HERE / \"blender\" / \"worker.py\"\r"},{"line":17,"text":"\r"},{"line":18,"text":"\r"},{"line":19,"text":"def find_blender():\r"},{"line":20,"text":"    \"\"\"POSELAB_BLENDER, else blender on the PATH, else the usual install folders.\"\"\"\r"},{"line":21,"text":"    env = os.environ.get(\"POSELAB_BLENDER\")\r"},{"line":22,"text":"    if env:\r"},{"line":23,"text":"        return env\r"},{"line":24,"text":"    on_path = shutil.which(\"blender\")\r"},{"line":25,"text":"    if on_path:\r"},{"line":26,"text":"        return on_path\r"},{"line":27,"text":"    guesses = []\r"},{"line":28,"text":"    if sys.platform == \"win32\":\r"},{"line":29,"text":"        guesses += sorted(glob.glob(r\"C:\\Program Files\\Blender Foundation\\Blender *\\blender.exe\"), reverse=True)\r"},{"line":30,"text":"    elif sys.platform == \"darwin\":\r"},{"line":31,"text":"        guesses.append(\"/Applications/Blender.app/Contents/MacOS/Blender\")\r"},{"line":32,"text":"    else:\r"},{"line":33,"text":"        guesses += [\"/usr/bin/blender\", \"/snap/bin/blender\"]\r"},{"line":34,"text":"    for g in guesses:\r"},{"line":35,"text":"        if os.path.exists(g):\r"},{"line":36,"text":"            return g\r"},{"line":37,"text":"    raise ToolError(\"Blender not found: set POSELAB_BLENDER to blender's executable (for example \"\r"},{"line":38,"text":"                    \"D:/Blender/blender.exe) in the MCP client's configuration or the shell that starts the server\")\r"},{"line":39,"text":"\r"},{"line":40,"text":"\r"},{"line":41,"text":"def out_dir():\r"},{"line":42,"text":"    \"\"\"Where Pose Lab writes (renders, the worker's log): POSELAB_OUT, else ~/.poselab.\"\"\"\r"},{"line":43,"text":"    d = Path(os.environ.get(\"POSELAB_OUT\") or Path.home() / \".poselab\")\r"},{"line":44,"text":"    d.mkdir(parents=True, exist_ok=True)\r"},{"line":45,"text":"    return d\r"},{"line":46,"text":"\r"},{"line":47,"text":"\r"},{"line":48,"text":"def _free_port():\r"},{"line":49,"text":"    with socket.socket() as s:\r"},{"line":50,"text":"        s.bind((\"127.0.0.1\", 0))\r"},{"line":51,"text":"        return s.getsockname()[1]\r"},{"line":52,"text":"\r"},{"line":53,"text":"\r"},{"line":54,"text":"class Worker:\r"},{"line":55,"text":"    def __init__(self):\r"}],"name":"HERE","start_line":15,"symbol_id":"hold-code/poselab_mcp/worker_client.py#var:HERE"}}
