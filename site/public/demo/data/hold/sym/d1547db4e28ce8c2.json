* 100.0, 2),"},{"kind":"call","line":295,"text":"\"ring\": [[float(a), float(b)] for a, b in _ring(s_[\"hull\"], 24)]} for s_ in run]})"},{"kind":"call","line":296,"text":"if len(out) >= 3:"}],"preds":[40,38],"stmts":["call out.append","call float","call float","call float","call float","call round","call round","call round","call float","call np.mean","call float","call round","call round","call round","call float","call float","call _ring","call len"],"succs":[42,43]},{"id":42,"label":"then","preds":[41],"stmts":null,"succs":[43]},{"id":43,"label":"merge","preds":[42,41],"stmts":null,"succs":[37]},{"cond":"for o in out","id":44,"label":"loop_header","preds":[39,45],"stmts":null,"succs":[45,46]},{"id":45,"label":"loop_body","lines":[{"kind":"call","line":299,"text":"o.pop(\"_mid\")"},{"kind":"call","line":300,"text":"o.pop(\"_d\")"}],"preds":[44],"stmts":["call o.pop","call o.pop"],"succs":[44]},{"id":46,"label":"loop_exit","lines":[{"kind":"return","line":301,"text":"return out"}],"preds":[44],"stmts":["return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[46],"func_id":"hold-code/poselab_mcp/blender/holdlab.py#method:HoldMixin._runs","issues":null},"source":{"end_line":301,"file":"hold-code/poselab_mcp/blender/holdlab.py","kind":"method","language":"python","lines":[{"line":227,"text":"    def _runs(self, P, hand_len_cm, step_cm=0.5, dir_step_deg=8.0):\r"},{"line":228,"text":"        \"\"\"The runs of a part a hand can wrap: along a direction, consecutive sections whose girth (as a cylinder's\r"},{"line":229,"text":"        diameter) is in the handle range and whose middles follow on from one another. Returns the longest ones,\r"},{"line":230,"text":"        best first: {axis, origin, sections [{t, centre, diameter_cm, width_cm, depth_cm, ring (2D)}], length_cm,\r"},{"line":231,"text":"        frame (u, v)}.\"\"\"\r"},{"line":232,"text":"        lo_d, hi_d = HANDLE[\"min_diameter_cm\"] / 100.0, HANDLE[\"max_diameter_cm\"] / 100.0\r"},{"line":233,"text":"        best_d = HANDLE[\"best_share_of_hand_length\"] * hand_len_cm / 100.0\r"},{"line":234,"text":"        st = step_cm / 100.0\r"},{"line":235,"text":"        c0 = P.mean(0)\r"},{"line":236,"text":"        found = []\r"},{"line":237,"text":"        for d in _dirs(dir_step_deg):\r"},{"line":238,"text":"            u = np.cross(d, [0.0, 0.0, 1.0] if abs(d[2]) < 0.9 else [1.0, 0.0, 0.0])\r"},{"line":239,"text":"            u /= np.linalg.norm(u)\r"},{"line":240,"text":"            v = np.cross(d, u)\r"},{"line":241,"text":"            t = (P - c0) @ d\r"},{"line":242,"text":"            pu, pv = (P - c0) @ u, (P - c0) @ v\r"},{"line":243,"text":"            k = np.floor((t - t.min()) / st).astype(int)\r"},{"line":244,"text":"            chains, done = [], []\r"},{"line":245,"text":"            for b in range(int(k.max()) + 2):\r"},{"line":246,"text":"                m = k == b\r"},{"line":247,"text":"                blobs = _blobs(pu[m], pv[m]) if m.sum() >= 12 else []\r"},{"line":248,"text":"                secs = []\r"},{"line":249,"text":"                for bu, bv in blobs:\r"},{"line":250,"text":"                    if len(bu) < 12:\r"},{"line":251,"text":"                        continue\r"},{"line":252,"text":"                    hull, per = _hull2(np.c_[bu, bv])\r"},{"line":253,"text":"                    secs.append({\"t\": float(t.min() + (b + 0.5) * st), \"dia\": per / math.pi, \"cu\": float(bu.mean()),\r"},{"line":254,"text":"                                 \"cv\": float(bv.mean()), \"hull\": hull, \"w\": float(np.ptp(bu)), \"h\": float(np.ptp(bv))})\r"},{"line":255,"text":"                # each chain goes on with the piece of this section that follows its last one\r"},{"line":256,"text":"                nxt, used = [], set()\r"},{"line":257,"text":"                for ch in chains:\r"},{"line":258,"text":"                    last = ch[-1]\r"},{"line":259,"text":"                    cand = [(math.hypot(s_[\"cu\"] - last[\"cu\"], s_[\"cv\"] - last[\"cv\"]), i) for i, s_ in enumerate(secs)\r"},{"line":260,"text":"                            if lo_d <= s_[\"dia\"] <= hi_d and abs(s_[\"dia\"] - last[\"dia\"]) <= 0.5 / 100.0]\r"},{"line":261,"text":"                    cand = [c for c in cand if c[0] <= 1.2 * st]\r"},{"line":262,"text":"                    if cand:\r"},{"line":263,"text":"                        _dd, i = min(cand)\r"},{"line":264,"text":"                        used.add(i)\r"},{"line":265,"text":"                        nxt.append(ch + [secs[i]])\r"},{"line":266,"text":"                    else:\r"},{"line":267,"text":"                        done.append(ch)\r"},{"line":268,"text":"                for i, s_ in enumerate(secs):\r"},{"line":269,"text":"                    if i not in used and lo_d <= s_[\"dia\"] <= hi_d:\r"},{"line":270,"text":"                        nxt.append([s_])\r"},{"line":271,"text":"                chains = nxt\r"},{"line":272,"text":"            for run in done + chains:\r"},{"line":273,"text":"                if len(run) * step_cm >= HANDLE[\"min_run_cm\"]:\r"},{"line":274,"text":"                    found.append((d.copy(), u.copy(), v.copy(), run))\r"},{"line":275,"text":"        scored = []\r"},{"line":276,"text":"        for d, u, v, run in found:\r"},{"line":277,"text":"            L = len(run) * step_cm\r"},{"line":278,"text":"            dev = abs(np.mean([s_[\"dia\"] for s_ in run]) - best_d) * 100.0\r"},{"line":279,"text":"            # straight runs score higher: the middles' drift sideways over the run\r"},{"line":280,"text":"            drift = math.hypot(run[-1][\"cu\"] - run[0][\"cu\"], run[-1][\"cv\"] - run[0][\"cv\"]) * 100.0\r"},{"line":281,"text":"            scored.append((L - 0.8 * dev - 1.5 * drift, d, u, v, run, L))\r"},{"line":282,"text":"        scored.sort(key=lambda x: -x[0])\r"},{"line":283,"text":"        out = []\r"},{"line":284,"text":"        for sc, d, u, v, run, L in scored:\r"},{"line":285,"text":"            mid = c0 + d * np.mean([s_[\"t\"] for s_ in run]) + u * np.mean([s_[\"cu\"] for s_ in run]) + v * np.mean([s_[\"cv\"] for s_ in run])\r"},{"line":286,"text":"            if any(np.linalg.norm(mid - o[\"_mid\"]) < 0.02 and abs(float(np.dot(d, o[\"_d\"]))) > 0.85 for o in out):\r"},{"line":287,"text":"                continue                               # the same run read along a nearly equal direction\r"},{"line":288,"text":"            out.append({\"_mid\": mid, \"_d\": d, \"axis\": [float(x) for x in d], \"u\": [float(x) for x in u],\r"},{"line":289,"text":"                        \"v\": [float(x) for x in v], \"origin\": [float(x) for x in c0], \"length_cm\": round(L, 1),\r"},{"line":290,"text":"                        \"score\": round(sc, 2),\r"},{"line":291,"text":"                        \"diameter_cm\": round(float(np.mean([s_[\"dia\"] for s_ in run])) * 100.0, 2),\r"},{"line":292,"text":"                        \"sections\": [{\"t\": s_[\"t\"], \"centre\": [float(x) for x in (c0 + d * s_[\"t\"] + u * s_[\"cu\"] + v * s_[\"cv\"])],\r"},{"line":293,"text":"                                      \"diameter_cm\": round(s_[\"dia\"] * 100.0, 2), \"width_cm\": round(s_[\"w\"] * 100.0, 2),\r"},{"line":294,"text":"                                      \"depth_cm\": round(s_[\"h\"] * 100.0, 2),\r"},{"line":295,"text":"                                      \"ring\": [[float(a), float(b)] for a, b in _ring(s_[\"hull\"], 24)]} for s_ in run]})\r"},{"line":296,"text":"            if len(out) >= 3:\r"},{"line":297,"text":"                break\r"},{"line":298,"text":"        for o in out:\r"},{"line":299,"text":"            o.pop(\"_mid\")\r"},{"line":300,"text":"            o.pop(\"_d\")\r"},{"line":301,"text":"        return out\r"}],"name":"_runs","start_line":227,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#method:HoldMixin._runs"}}
