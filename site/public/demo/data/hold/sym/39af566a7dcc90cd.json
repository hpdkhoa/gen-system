471,"text":"    def _skin_points(self):\r"},{"line":2472,"text":"        \"\"\"Every skin vertex in the world as posed now, with the bone that weighs it most.\"\"\"\r"},{"line":2473,"text":"        dg = bpy.context.evaluated_depsgraph_get()\r"},{"line":2474,"text":"        out = []\r"},{"line":2475,"text":"        for ob in self.meshes:\r"},{"line":2476,"text":"            names = {g.index: g.name for g in ob.vertex_groups}\r"},{"line":2477,"text":"            ev = ob.evaluated_get(dg)\r"},{"line":2478,"text":"            me = ev.to_mesh()\r"},{"line":2479,"text":"            M = ev.matrix_world\r"},{"line":2480,"text":"            for v, v0 in zip(me.vertices, ob.data.vertices):\r"},{"line":2481,"text":"                if not v0.groups:\r"},{"line":2482,"text":"                    continue\r"},{"line":2483,"text":"                gmax = max(v0.groups, key=lambda x: x.weight)\r"},{"line":2484,"text":"                out.append((M @ v.co, names.get(gmax.group, \"\")))\r"},{"line":2485,"text":"            ev.to_mesh_clear()\r"},{"line":2486,"text":"        return out\r"}],"name":"_skin_points","start_line":2471,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:_skin_points"}}
