clip\": clip, \"seconds\": round(self._clip_len(clip), 3), \"source\": \"bone data\"}\r"},{"line":3415,"text":"        before = set(bpy.data.objects.keys())\r"},{"line":3416,"text":"        if full.lower().endswith(\".bvh\"):\r"},{"line":3417,"text":"            bpy.ops.import_anim.bvh(filepath=full, update_scene_fps=False, update_scene_duration=False)\r"},{"line":3418,"text":"        elif full.lower().endswith(\".fbx\"):\r"},{"line":3419,"text":"            bpy.ops.import_scene.fbx(filepath=full)\r"},{"line":3420,"text":"        else:\r"},{"line":3421,"text":"            raise ValueError(\"clips: .pose.json, .fbx or .bvh\")\r"},{"line":3422,"text":"        fps = self.sc.render.fps / self.sc.render.fps_base\r"},{"line":3423,"text":"        rest = {b.name: self.arm.matrix_world @ b.matrix_local for b in self.arm.data.bones}\r"},{"line":3424,"text":"        made = None\r"},{"line":3425,"text":"        for o in [o for o in bpy.data.objects if o.name not in before]:\r"},{"line":3426,"text":"            if o.type == 'ARMATURE' and o.animation_data and o.animation_data.action and made is None:\r"},{"line":3427,"text":"                if bone_map:\r"},{"line":3428,"text":"                    for b in o.data.bones:\r"},{"line":3429,"text":"                        if b.name in bone_map:\r"},{"line":3430,"text":"                            b.name = bone_map[b.name]\r"},{"line":3431,"text":"                o.hide_render = True\r"},{"line":3432,"text":"                crest = {b.name: o.matrix_world @ b.matrix_local for b in o.data.bones}\r"},{"line":3433,"text":"                shared = [b.name for b in self.arm.data.bones if b.name in crest]\r"},{"line":3434,"text":"                if len(shared) < 3:\r"},{"line":3435,"text":"                    raise ValueError(\"the file's bones do not match this rig's: give a bone_map\")\r"},{"line":3436,"text":"                T = fit([crest[b].translation for b in shared], [rest[b].translation for b in shared])\r"},{"line":3437,"text":"                C = {b: crest[b].inverted() @ T.inverted() @ rest[b] for b in shared}\r"},{"line":3438,"text":"                worst = max(((T @ crest[b]).translation - rest[b].translation).length for b in shared) * 100.0\r"},{"line":3439,"text":"                self.clips[clip] = (o, o.animation_data.action, fps, T, C)\r"},{"line":3440,"text":"                self.clip_fit[clip] = {\"source\": os.path.splitext(full)[1][1:], \"bones\": len(shared), \"rest_mismatch_cm\": round(worst, 3)}\r"},{"line":3441,"text":"                made = o\r"},{"line":3442,"text":"            else:\r"},{"line":3443,"text":"                bpy.data.objects.remove(o)\r"},{"line":3444,"text":"        self.sc.render.fps, self.sc.render.fps_base = 30, 1.0\r"},{"line":3445,"text":"        if made is None:\r"},{"line":3446,"text":"            raise ValueError(\"no animation in %s\" % full)\r"},{"line":3447,"text":"        return {\"clip\": clip, \"seconds\": round(self._clip_len(clip), 3), **self.clip_fit[clip]}\r"}],"name":"load_clip","start_line":3402,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.load_clip"}}
