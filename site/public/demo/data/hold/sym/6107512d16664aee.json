{"flow":{"blocks":[{"id":0,"label":"entry","lines":[{"kind":"call","line":108,"text":"fr = min(track[\"frames\"], key=lambda f: abs(f[\"t\"] - t))"}],"preds":null,"stmts":["call min","call abs"],"succs":[1]},{"cond":"for b in facts['bones']","id":1,"label":"loop_header","preds":[0,2],"stmts":null,"succs":[2,3]},{"id":2,"label":"loop_body","preds":[1],"stmts":null,"succs":[1]},{"id":3,"label":"loop_exit","preds":[1],"stmts":null,"succs":[4]},{"cond":"for b in facts['bones']","id":4,"label":"loop_header","preds":[3,9],"stmts":null,"succs":[5,6]},{"id":5,"label":"loop_body","preds":[4],"stmts":null,"succs":[7]},{"id":6,"label":"loop_exit","lines":[{"kind":"return","line":128,"text":"return out"}],"preds":[4],"stmts":["return"],"succs":null},{"cond":"for (k, v) in pts.items()","id":7,"label":"loop_header","preds":[5,8],"stmts":null,"succs":[8,9]},{"id":8,"label":"loop_body","lines":[{"kind":"call","line":127,"text":"out[b[\"name\"]] = {k: move(b[\"name\"], v) for k, v in pts.items()}"}],"preds":[7],"stmts":["call move"],"succs":[7]},{"id":9,"label":"loop_exit","preds":[7],"stmts":null,"succs":[4]}],"effects":["unknown"],"entry":0,"exits":[6],"func_id":"hold-code/weaponlab/gunkit/run.py#func:expected_keyed","issues":null},"source":{"end_line":128,"file":"hold-code/weaponlab/gunkit/run.py","kind":"func","language":"python","lines":[{"line":105,"text":"def expected_keyed(facts, track, t):\r"},{"line":106,"text":"    \"\"\"Where each bone's head and its three side points should be at t, from the tracks keyed (a resolved clip): a\r"},{"line":107,"text":"    bone turns round its head, then moves by its loc, then rides its parent (Blender's pose, in gun space).\"\"\"\r"},{"line":108,"text":"    fr = min(track[\"frames\"], key=lambda f: abs(f[\"t\"] - t))\r"},{"line":109,"text":"    byname = {b[\"name\"]: b for b in facts[\"bones\"]}\r"},{"line":110,"text":"\r"},{"line":111,"text":"    def move(bone, pt):\r"},{"line":112,"text":"        x = fr[\"bones\"].get(bone)\r"},{"line":113,"text":"        if x:\r"},{"line":114,"text":"            head = byname[bone][\"head\"]\r"},{"line":115,"text":"            deg, ax, ay, az = x[\"rot\"]\r"},{"line":116,"text":"            n = (ax * ax + ay * ay + az * az) ** 0.5\r"},{"line":117,"text":"            if deg and n:\r"},{"line":118,"text":"                pt = T._rot(pt, head, [ax / n, ay / n, az / n], deg)\r"},{"line":119,"text":"            pt = [pt[i] + x[\"loc\"][i] for i in range(3)]\r"},{"line":120,"text":"        parent = byname[bone].get(\"parent\")\r"},{"line":121,"text":"        return move(parent, pt) if parent and parent != \"Root\" else pt\r"},{"line":122,"text":"\r"},{"line":123,"text":"    out = {}\r"},{"line":124,"text":"    for b in facts[\"bones\"]:\r"},{"line":125,"text":"        h = b[\"head\"]\r"},{"line":126,"text":"        pts = {\"head\": h, \"x\": [h[0] + 3, h[1], h[2]], \"y\": [h[0], h[1] + 3, h[2]], \"z\": [h[0], h[1], h[2] + 3]}\r"},{"line":127,"text":"        out[b[\"name\"]] = {k: move(b[\"name\"], v) for k, v in pts.items()}\r"},{"line":128,"text":"    return out\r"}],"name":"expected_keyed","start_line":105,"symbol_id":"hold-code/weaponlab/gunkit/run.py#func:expected_keyed"}}
