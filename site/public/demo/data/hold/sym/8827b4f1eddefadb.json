":84,"text":"    frames_dir.mkdir()\r"},{"line":85,"text":"    clips = [{\"action\": \"A_%s_%s\" % (gun, a), \"label\": lab, \"slow\": s, \"view\": v, \"repeat\": r, \"zoom\": z} for a, lab, s, v, r, z in CLIPS]\r"},{"line":86,"text":"    jf = out / \"showcase.job.json\"\r"},{"line":87,"text":"    jf.write_text(json.dumps({\"out\": str(frames_dir), \"size\": list(size), \"fps\": fps, \"turn_frames\": turn_frames, \"clips\": clips}), encoding=\"utf-8\")\r"},{"line":88,"text":"    p = subprocess.run([str(project().blender()), \"-b\", str(clips_blend), \"-P\", str(HERE / \"blueprint_showcase.py\"), \"--\", str(jf)],\r"},{"line":89,"text":"                       capture_output=True, text=True, timeout=timeout)\r"},{"line":90,"text":"    (out / \"showcase.log\").write_text((p.stdout or \"\") + \"\\n\" + (p.stderr or \"\"), encoding=\"utf-8\", errors=\"replace\")\r"},{"line":91,"text":"    if p.returncode != 0 or \"SHOWCASE FRAMES\" not in (p.stdout or \"\"):\r"},{"line":92,"text":"        tail = [l for l in ((p.stdout or \"\") + (p.stderr or \"\")).splitlines() if l.strip()][-12:]\r"},{"line":93,"text":"        raise RuntimeError(\"the showcase render failed (see %s):\\n%s\" % (out / \"showcase.log\", \"\\n\".join(tail)))\r"},{"line":94,"text":"    shots = json.loads((frames_dir / \"shots.json\").read_text(encoding=\"utf-8\"))[\"shots\"]\r"},{"line":95,"text":"    head = \"BLUEPRINT LAB MODEL %s (not a game view)\" % gun\r"},{"line":96,"text":"    bp = store.load(gun, \"blueprint\")\r"},{"line":97,"text":"    seq = []\r"},{"line":98,"text":"    card = _card(size, [(title or bp.get(\"title\", gun), True), (\"A visual copy made from its public sources\", False),\r"},{"line":99,"text":"                        (source_note or \"\", False), (\"Blueprint Lab and Gun Kit, weaponlab-mcp\", False)])\r"},{"line":100,"text":"    seq += [card] * int(fps * 2.5)\r"},{"line":101,"text":"    view = store.folder(gun, \"model\", \"views\") / \"view_left.png\"\r"},{"line":102,"text":"    if compare_figure and view.exists():\r"},{"line":103,"text":"        sbs = _label(_side_by_side(gun, size, compare_figure, view), head, \"The source figure and the copy, side by side\")\r"},{"line":104,"text":"        seq += [sbs] * int(fps * 3)\r"},{"line":105,"text":"    for s in shots:\r"},{"line":106,"text":"        im = Image.open(frames_dir / (\"f%05d.png\" % s[\"frame\"])).convert(\"RGB\")\r"},{"line":107,"text":"        seq.append(_label(im, head, \"Turned once round\" if s[\"shot\"] == \"turn\" else s[\"shot\"]))\r"},{"line":108,"text":"    seq += [card] * int(fps * 1.5)\r"},{"line":109,"text":"    gif = out / (\"%s.gif\" % gun)\r"},{"line":110,"text":"    small = [im.resize((size[0] * 3 // 4, size[1] * 3 // 4), Image.LANCZOS) for im in seq]\r"},{"line":111,"text":"    pal = [im.convert(\"P\", palette=Image.ADAPTIVE, colors=128) for im in small]\r"},{"line":112,"text":"    pal[0].save(gif, save_all=True, append_images=pal[1:], duration=int(1000 / fps), loop=0, optimize=True)\r"},{"line":113,"text":"    comp = out / \"composed\"\r"},{"line":114,"text":"    if comp.exists():\r"},{"line":115,"text":"        shutil.rmtree(comp)\r"},{"line":116,"text":"    comp.mkdir()\r"},{"line":117,"text":"    for k, im in enumerate(seq):\r"},{"line":118,"text":"        im.save(comp / (\"c%05d.png\" % k))\r"},{"line":119,"text":"    mp4 = out / (\"%s.mp4\" % gun)\r"},{"line":120,"text":"    enc = out / \"encode.job.json\"\r"},{"line":121,"text":"    enc.write_text(json.dumps({\"frames\": str(comp), \"count\": len(seq), \"fps\": fps, \"size\": list(size), \"out\": str(mp4)}), encoding=\"utf-8\")\r"},{"line":122,"text":"    p = subprocess.run([str(project().blender()), \"-b\", \"--factory-startup\", \"-P\", str(HERE / \"blueprint_encode.py\"), \"--\", str(enc)],\r"},{"line":123,"text":"                       capture_output=True, text=True, timeout=timeout)\r"},{"line":124,"text":"    (out / \"encode.log\").write_text((p.stdout or \"\") + \"\\n\" + (p.stderr or \"\"), encoding=\"utf-8\", errors=\"replace\")\r"},{"line":125,"text":"    return {\"gif\": str(gif), \"mp4\": str(mp4) if mp4.exists() else None, \"frames\": len(seq), \"seconds\": round(len(seq) / fps, 1),\r"},{"line":126,"text":"            \"gif_mb\": round(gif.stat().st_size / 1e6, 2)}\r"}],"name":"make","start_line":73,"symbol_id":"hold-code/weaponlab/blueprint/showcase.py#func:make"}}
