{"flow":{"kind":"var","name":"KINDS","noCFG":true,"reason":"KINDS is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":65,"file":"hold-code/weaponlab/gunkit/facts.py","kind":"var","language":"python","lines":[{"line":25,"text":"KINDS = (\"slide\", \"turn\", \"free\")\r"},{"line":26,"text":"\r"},{"line":27,"text":"\r"},{"line":28,"text":"def load(path):\r"},{"line":29,"text":"    return json.loads(Path(path).read_text(encoding=\"utf-8\"))\r"},{"line":30,"text":"\r"},{"line":31,"text":"\r"},{"line":32,"text":"def _vec(v, n=3):\r"},{"line":33,"text":"    return isinstance(v, (list, tuple)) and len(v) == n and all(isinstance(x, (int, float)) and math.isfinite(x) for x in v)\r"},{"line":34,"text":"\r"},{"line":35,"text":"\r"},{"line":36,"text":"def check(facts, action=None):\r"},{"line":37,"text":"    \"\"\"Problems with a gun's facts, against its action when given ([] when it is ready).\"\"\"\r"},{"line":38,"text":"    bad = []\r"},{"line":39,"text":"    if facts.get(\"contract\") != CONTRACT:\r"},{"line":40,"text":"        bad.append(\"contract: want %s, got %r\" % (CONTRACT, facts.get(\"contract\")))\r"},{"line":41,"text":"    for key in (\"name\", \"action\", \"bones\", \"parts\", \"marks\"):\r"},{"line":42,"text":"        if key not in facts:\r"},{"line":43,"text":"            bad.append(\"no %s\" % key)\r"},{"line":44,"text":"    if bad:\r"},{"line":45,"text":"        return bad\r"},{"line":46,"text":"    names = {b.get(\"name\") for b in facts[\"bones\"]}\r"},{"line":47,"text":"    for b in facts[\"bones\"]:\r"},{"line":48,"text":"        if b.get(\"parent\") and b[\"parent\"] not in names:\r"},{"line":49,"text":"            bad.append(\"bone %s: no parent %s\" % (b.get(\"name\"), b[\"parent\"]))\r"},{"line":50,"text":"    for role, p in facts[\"parts\"].items():\r"},{"line":51,"text":"        if p.get(\"bone\") not in names:\r"},{"line":52,"text":"            bad.append(\"part %s: no bone %r\" % (role, p.get(\"bone\")))\r"},{"line":53,"text":"        if p.get(\"kind\") not in KINDS:\r"},{"line":54,"text":"            bad.append(\"part %s: kind %r, want one of %s\" % (role, p.get(\"kind\"), \", \".join(KINDS)))\r"},{"line":55,"text":"        if p.get(\"kind\") in (\"slide\", \"turn\"):\r"},{"line":56,"text":"            ax = p.get(\"axis\")\r"},{"line":57,"text":"            if not _vec(ax) or abs(math.sqrt(sum(a * a for a in ax)) - 1.0) > 1e-3:\r"},{"line":58,"text":"                bad.append(\"part %s: axis must be a unit vector\" % role)\r"},{"line":59,"text":"        if p.get(\"kind\") == \"slide\" and not (isinstance(p.get(\"travel_cm\"), (int, float)) and p[\"travel_cm\"] > 0):\r"},{"line":60,"text":"            bad.append(\"part %s: travel_cm > 0\" % role)\r"},{"line":61,"text":"        if p.get(\"kind\") == \"turn\":\r"},{"line":62,"text":"            if not (isinstance(p.get(\"turn_deg\"), (int, float)) and p[\"turn_deg\"] != 0):\r"},{"line":63,"text":"                bad.append(\"part %s: turn_deg not 0\" % role)\r"},{"line":64,"text":"            if not _vec(p.get(\"pivot\")):\r"},{"line":65,"text":"                bad.append(\"part %s: a turn needs its pivot\" % role)\r"}],"name":"KINDS","start_line":25,"symbol_id":"hold-code/weaponlab/gunkit/facts.py#var:KINDS"}}
