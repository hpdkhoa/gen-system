ed patch holding the seed.\"\"\"\r"},{"line":307,"text":"    cv2, np = _cv()\r"},{"line":308,"text":"    f = Fg.figure(gun, fig_id)\r"},{"line":309,"text":"    g = Fg.image(gun, f, gray=True)\r"},{"line":310,"text":"    x0, y0, x1, y1 = [int(v) for v in box]\r"},{"line":311,"text":"    sub = cv2.GaussianBlur(g[y0:y1, x0:x1], (2 * blur_px + 1, 2 * blur_px + 1), 0)\r"},{"line":312,"text":"    _, m = cv2.threshold(sub, 0, 255, (cv2.THRESH_BINARY if light else cv2.THRESH_BINARY_INV) + cv2.THRESH_OTSU)\r"},{"line":313,"text":"    n, lab = cv2.connectedComponents(m)\r"},{"line":314,"text":"    sx, sy = int(seed[0]) - x0, int(seed[1]) - y0\r"},{"line":315,"text":"    if not lab[sy, sx]:\r"},{"line":316,"text":"        raise ValueError(\"the seed (%d, %d) is not on a %s patch\" % (seed[0], seed[1], \"light\" if light else \"dark\"))\r"},{"line":317,"text":"    patch = (lab == lab[sy, sx]).astype(np.uint8) * 255\r"},{"line":318,"text":"    if patch[0, :].any() or patch[-1, :].any() or patch[:, 0].any() or patch[:, -1].any():\r"},{"line":319,"text":"        raise ValueError(\"the patch runs to the box's edge: give a larger box\")\r"},{"line":320,"text":"    full = np.zeros_like(g)\r"},{"line":321,"text":"    full[y0:y1, x0:x1] = patch\r"},{"line":322,"text":"    poly, a = _outline(full, eps_px)\r"},{"line":323,"text":"    return _result(gun, f, poly, a, \"blob\", name)\r"}],"name":"blob","start_line":304,"symbol_id":"hold-code/weaponlab/blueprint/trace.py#func:blob"}}
