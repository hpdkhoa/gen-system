4,9],"stmts":null,"succs":[16,17]},{"id":16,"label":"then","lines":[{"kind":"call","line":206,"text":"\"moved_px_max\": round(float(np.max(moved)), 2) if moved else None,"}],"preds":[15],"stmts":["call round","call float","call np.max"],"succs":[17]},{"id":17,"label":"merge","lines":[{"kind":"call","line":207,"text":"\"no_edge_share\": round(missed / max(1, len(dense)), 3)})"},{"kind":"return","line":208,"text":"return res"}],"preds":[16,15],"stmts":["call round","call max","call len","return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[17],"func_id":"hold-code/weaponlab/blueprint/trace.py#func:snap","issues":null},"source":{"end_line":208,"file":"hold-code/weaponlab/blueprint/trace.py","kind":"func","language":"python","lines":[{"line":169,"text":"def snap(gun, fig_id, rough_px, radius_px=12, step_px=4, eps_px=1.5, threshold=None, name=None):\r"},{"line":170,"text":"    \"\"\"A rough outline (px) moved onto the ink: each point, after the outline is cut into steps, goes to the nearest\r"},{"line":171,"text":"    ink edge within the radius; a point with none stays. Gives how far points moved and how many found no edge.\"\"\"\r"},{"line":172,"text":"    cv2, np = _cv()\r"},{"line":173,"text":"    f = Fg.figure(gun, fig_id)\r"},{"line":174,"text":"    m = ink(gun, f, threshold)\r"},{"line":175,"text":"    edge = cv2.morphologyEx(m, cv2.MORPH_GRADIENT, np.ones((3, 3), np.uint8)) > 0\r"},{"line":176,"text":"    h, w = edge.shape\r"},{"line":177,"text":"    dense = []\r"},{"line":178,"text":"    pts = [tuple(p) for p in rough_px]\r"},{"line":179,"text":"    for i, a in enumerate(pts):\r"},{"line":180,"text":"        b = pts[(i + 1) % len(pts)]\r"},{"line":181,"text":"        n = max(1, int(np.hypot(b[0] - a[0], b[1] - a[1]) / step_px))\r"},{"line":182,"text":"        for k in range(n):\r"},{"line":183,"text":"            dense.append((a[0] + (b[0] - a[0]) * k / n, a[1] + (b[1] - a[1]) * k / n))\r"},{"line":184,"text":"    out, moved, missed = [], [], 0\r"},{"line":185,"text":"    r = int(radius_px)\r"},{"line":186,"text":"    for x, y in dense:\r"},{"line":187,"text":"        xi, yi = int(round(x)), int(round(y))\r"},{"line":188,"text":"        x0, x1, y0, y1 = max(0, xi - r), min(w, xi + r + 1), max(0, yi - r), min(h, yi + r + 1)\r"},{"line":189,"text":"        ys, xs = np.nonzero(edge[y0:y1, x0:x1])\r"},{"line":190,"text":"        if len(xs) == 0:\r"},{"line":191,"text":"            out.append((x, y))\r"},{"line":192,"text":"            missed += 1\r"},{"line":193,"text":"            continue\r"},{"line":194,"text":"        d = (xs + x0 - x) ** 2 + (ys + y0 - y) ** 2\r"},{"line":195,"text":"        j = int(np.argmin(d))\r"},{"line":196,"text":"        if d[j] > r * r:\r"},{"line":197,"text":"            out.append((x, y))\r"},{"line":198,"text":"            missed += 1\r"},{"line":199,"text":"            continue\r"},{"line":200,"text":"        out.append((float(xs[j] + x0), float(ys[j] + y0)))\r"},{"line":201,"text":"        moved.append(float(np.sqrt(d[j])))\r"},{"line":202,"text":"    c = np.array(out, dtype=np.float32).reshape(-1, 1, 2)\r"},{"line":203,"text":"    poly = cv2.approxPolyDP(c, eps_px, True)[:, 0, :]\r"},{"line":204,"text":"    res = _result(gun, f, [[float(x), float(y)] for x, y in poly], float(abs(cv2.contourArea(c))), \"snap\", name)\r"},{"line":205,"text":"    res.update({\"moved_px_mean\": round(float(np.mean(moved)), 2) if moved else None,\r"},{"line":206,"text":"                \"moved_px_max\": round(float(np.max(moved)), 2) if moved else None,\r"},{"line":207,"text":"                \"no_edge_share\": round(missed / max(1, len(dense)), 3)})\r"},{"line":208,"text":"    return res\r"}],"name":"snap","start_line":169,"symbol_id":"hold-code/weaponlab/blueprint/trace.py#func:snap"}}
