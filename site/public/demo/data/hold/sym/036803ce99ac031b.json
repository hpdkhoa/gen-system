         return c[1]\r"},{"line":753,"text":"        m = sel[T[:, 0]] & sel[T[:, 1]] & sel[T[:, 2]]\r"},{"line":754,"text":"        ts = T[m]\r"},{"line":755,"text":"        if not len(ts):\r"},{"line":756,"text":"            return None\r"},{"line":757,"text":"        bvh = BVHTree.FromPolygons([Vector(x) for x in P[vi]], [tuple(t) for t in np.searchsorted(vi, ts)])\r"},{"line":758,"text":"        oi, ol = self._hand_label_arrays(other, P, N)\r"},{"line":759,"text":"        olab = dict(zip(oi.tolist(), ol))\r"},{"line":760,"text":"        val = (bvh, ts, olab, P[vi].min(0) - 0.01, P[vi].max(0) + 0.01)\r"},{"line":761,"text":"        if not hasattr(self, \"_ohb\"):\r"},{"line":762,"text":"            self._ohb = {}\r"},{"line":763,"text":"        self._ohb[other] = (key, val)\r"},{"line":764,"text":"        return val\r"}],"name":"_other_hand_bvh","start_line":743,"symbol_id":"hold-code/poselab_mcp/blender/contactlab.py#func:_other_hand_bvh"}}
