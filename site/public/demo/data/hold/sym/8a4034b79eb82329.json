de/poselab_mcp/blender/lab.py#func:clearance","issues":null},"source":{"end_line":818,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"func","language":"python","lines":[{"line":800,"text":"    def clearance(self, parts=\"both\", ignore=(), frame=\"gun\", top=5):\r"},{"line":801,"text":"        \"\"\"How deep the rifle sits inside the arms (capsules: forearm 3 cm, palm 1.8 cm, each finger segment 0.75 cm),\r"},{"line":802,"text":"        measured to the rifle's surface, not its corner points. worst_cm 0: nothing touches. ignore: segment names,\r"},{"line":803,"text":"        prefixes or wildcards (thumb, index3_r, *_l).\"\"\"\r"},{"line":804,"text":"        self._need()\r"},{"line":805,"text":"        tree = self._tree()\r"},{"line":806,"text":"        hits = {}\r"},{"line":807,"text":"        for name, a, b, r in self._segments(parts):\r"},{"line":808,"text":"            if any(name.startswith(i) or fnmatch.fnmatch(name, i) for i in ignore):\r"},{"line":809,"text":"                continue\r"},{"line":810,"text":"            n = max(2, int((b - a).length / 0.004))\r"},{"line":811,"text":"            for i in range(n + 1):\r"},{"line":812,"text":"                p = a.lerp(b, i / n)\r"},{"line":813,"text":"                co, d = tree.nearest(p)\r"},{"line":814,"text":"                if co is not None and d < r and (r - d) * 100.0 > hits.get(name, (0.0,))[0]:\r"},{"line":815,"text":"                    hits[name] = ((r - d) * 100.0, co.copy())\r"},{"line":816,"text":"        ranked = sorted(hits.items(), key=lambda kv: -kv[1][0])\r"},{"line":817,"text":"        return {\"worst_cm\": round(ranked[0][1][0], 2) if ranked else 0.0,\r"},{"line":818,"text":"                \"contacts\": [{\"segment\": k, \"depth_cm\": round(v[0], 2), \"rifle_point\": r2(self._to(v[1], frame), 1)} for k, v in ranked[:top]]}\r"}],"name":"clearance","start_line":800,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:clearance"}}
