search(side, at, n, toward):\r"},{"line":599,"text":"    \"\"\"The palm laid on the face at seven turns about its normal, 30 degrees apart round the style's finger direction\r"},{"line":600,"text":"    (or the least turn): the one that leaves the arm least past its limits, then the closest to the hand's reach.\"\"\"\r"},{"line":601,"text":"    base = toward\r"},{"line":602,"text":"    if base is None:\r"},{"line":603,"text":"        base = fingers_way(side)\r"},{"line":604,"text":"    base = (base - n * base.dot(n)).normalized()\r"},{"line":605,"text":"    L.snapshot(\"save\", \"turn_search\")\r"},{"line":606,"text":"    best = None\r"},{"line":607,"text":"    for k in (0, -1, 1, -2, 2, -3, 3):\r"},{"line":608,"text":"        L.snapshot(\"load\", \"turn_search\")\r"},{"line":609,"text":"        way = Quaternion(n, math.radians(30.0 * k)) @ base\r"},{"line":610,"text":"        short = lay_palm(side, at, n, toward=way)\r"},{"line":611,"text":"        score = arm_over(side) + 4.0 * short\r"},{"line":612,"text":"        if best is None or score < best[0] - 1e-6:\r"},{"line":613,"text":"            best = (score, way, short)\r"},{"line":614,"text":"    L.snapshot(\"load\", \"turn_search\")\r"},{"line":615,"text":"    return lay_palm(side, at, n, toward=best[1])\r"}],"name":"turn_search","start_line":598,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:turn_search"}}
