 self._n(\"hand\", side)\r"},{"line":2418,"text":"                H = self._bw(hn)\r"},{"line":2419,"text":"                P = H.translation\r"},{"line":2420,"text":"                R = Matrix.Translation(P) @ Quaternion(nrm, math.radians(yaw)).to_matrix().to_4x4() @ Matrix.Translation(-P) @ H\r"},{"line":2421,"text":"                short = self._put_hand(side, Matrix.LocRotScale(R.translation, R.to_quaternion(), self._unit()))\r"},{"line":2422,"text":"            self.close_hand(side, plan, tree, glove_cm, other)\r"},{"line":2423,"text":"            return self._hand_score(side, tree, glove_cm, other, soft, short)\r"}],"name":"place","start_line":2388,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:Lab.solve_hand.place"}}
