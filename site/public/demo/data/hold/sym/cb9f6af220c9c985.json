y","kind":"func","language":"python","lines":[{"line":75,"text":"def outline(bp, ref_outline, res=0.01, ref_holes=()):\r"},{"line":76,"text":"    \"\"\"IoU and edge gaps between the blueprint's silhouette and a reference outline (y, z cm).\"\"\"\r"},{"line":77,"text":"    import cv2\r"},{"line":78,"text":"    import numpy as np\r"},{"line":79,"text":"    polys = silhouette(bp)\r"},{"line":80,"text":"    pts = [p for poly in polys + [ref_outline] for p in poly]\r"},{"line":81,"text":"    bounds = ((min(p[0] for p in pts) - 0.5, max(p[0] for p in pts) + 0.5), (min(p[1] for p in pts) - 0.5, max(p[1] for p in pts) + 0.5))\r"},{"line":82,"text":"    a = _raster(polys, _holes(bp), bounds, res) > 0\r"},{"line":83,"text":"    b = _raster([ref_outline], list(ref_holes), bounds, res) > 0\r"},{"line":84,"text":"    iou = float((a & b).sum()) / max(1, float((a | b).sum()))\r"},{"line":85,"text":"    ea = cv2.morphologyEx(a.astype(np.uint8), cv2.MORPH_GRADIENT, np.ones((3, 3), np.uint8)) > 0\r"},{"line":86,"text":"    eb = cv2.morphologyEx(b.astype(np.uint8), cv2.MORPH_GRADIENT, np.ones((3, 3), np.uint8)) > 0\r"},{"line":87,"text":"    da = cv2.distanceTransform((~ea).astype(np.uint8), cv2.DIST_L2, 5)\r"},{"line":88,"text":"    gaps = da[eb] * res\r"},{"line":89,"text":"    return {\"iou\": round(iou, 4), \"gap_mean_cm\": round(float(gaps.mean()), 3), \"gap_worst_cm\": round(float(gaps.max()), 3),\r"},{"line":90,"text":"            \"gap_p95_cm\": round(float(np.percentile(gaps, 95)), 3)}\r"}],"name":"outline","start_line":75,"symbol_id":"hold-code/weaponlab/blueprint/check.py#func:outline"}}
