{"flow":{"blocks":[{"id":0,"label":"entry","lines":[{"kind":"call","line":79,"text":"polys = silhouette(bp)"},{"kind":"call","line":81,"text":"bounds = ((min(p[0] for p in pts) - 0.5, max(p[0] for p in pts) + 0.5), (min(p[1] for p in pts) - 0.5, max(p[1] for p in pts) + 0.5))"},{"kind":"call","line":82,"text":"a = _raster(polys, _holes(bp), bounds, res) > 0"},{"kind":"call","line":83,"text":"b = _raster([ref_outline], list(ref_holes), bounds, res) > 0"},{"kind":"call","line":84,"text":"iou = float((a & b).sum()) / max(1, float((a | b).sum()))"},{"kind":"call","line":85,"text":"ea = cv2.morphologyEx(a.astype(np.uint8), cv2.MORPH_GRADIENT, np.ones((3, 3), np.uint8)) > 0"},{"kind":"call","line":86,"text":"eb = cv2.morphologyEx(b.astype(np.uint8), cv2.MORPH_GRADIENT, np.ones((3, 3), np.uint8)) > 0"},{"kind":"call","line":87,"text":"da = cv2.distanceTransform((~ea).astype(np.uint8), cv2.DIST_L2, 5)"},{"kind":"call","line":89,"text":"return {\"iou\": round(iou, 4), \"gap_mean_cm\": round(float(gaps.mean()), 3), \"gap_worst_cm\": round(float(gaps.max()), 3),"},{"kind":"call","line":90,"text":"\"gap_p95_cm\": round(float(np.percentile(gaps, 95)), 3)}"},{"kind":"return","line":89,"text":"return {\"iou\": round(iou, 4), \"gap_mean_cm\": round(float(gaps.mean()), 3), \"gap_worst_cm\": round(float(gaps.max()), 3),"}],"preds":null,"stmts":["call silhouette","call min","call max","call min","call max","call _raster","call _holes","call _raster","call list","call float","call ?.sum","call max","call float","call ?.sum","call cv2.morphologyEx","call a.astype","call np.ones","call cv2.morphologyEx","call b.astype","call np.ones","call cv2.distanceTransform","call ?.astype","call round","call round","call float","call gaps.mean","call round","call float","call gaps.max","call round","call float","call np.percentile","return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[0],"func_id":"hold-code/weaponlab/blueprint/check.py#func:outline","issues":null},"source":{"end_line":90,"file":"hold-code/weaponlab/blueprint/check.py","kind":"func","language":"python","lines":[{"line":75,"text":"def outline(bp, ref_outline, res=0.01, ref_holes=()):\r"},{"line":76,"text":"    \"\"\"IoU and edge gaps between the blueprint's silhouette and a reference outline (y, z cm).\"\"\"\r"},{"line":77,"text":"    import cv2\r"},{"line":78,"text":"    import numpy as np\r"},{"line":79,"text":"    polys = silhouette(bp)\r"},{"line":80,"text":"    pts = [p for poly in polys + [ref_outline] for p in poly]\r"},{"line":81,"text":"    bounds = ((min(p[0] for p in pts) - 0.5, max(p[0] for p in pts) + 0.5), (min(p[1] for p in pts) - 0.5, max(p[1] for p in pts) + 0.5))\r"},{"line":82,"text":"    a = _raster(polys, _holes(bp), bounds, res) > 0\r"},{"line":83,"text":"    b = _raster([ref_outline], list(ref_holes), bounds, res) > 0\r"},{"line":84,"text":"    iou = float((a & b).sum()) / max(1, float((a | b).sum()))\r"},{"line":85,"text":"    ea = cv2.morphologyEx(a.astype(np.uint8), cv2.MORPH_GRADIENT, np.ones((3, 3), np.uint8)) > 0\r"},{"line":86,"text":"    eb = cv2.morphologyEx(b.astype(np.uint8), cv2.MORPH_GRADIENT, np.ones((3, 3), np.uint8)) > 0\r"},{"line":87,"text":"    da = cv2.distanceTransform((~ea).astype(np.uint8), cv2.DIST_L2, 5)\r"},{"line":88,"text":"    gaps = da[eb] * res\r"},{"line":89,"text":"    return {\"iou\": round(iou, 4), \"gap_mean_cm\": round(float(gaps.mean()), 3), \"gap_worst_cm\": round(float(gaps.max()), 3),\r"},{"line":90,"text":"            \"gap_p95_cm\": round(float(np.percentile(gaps, 95)), 3)}\r"}],"name":"outline","start_line":75,"symbol_id":"hold-code/weaponlab/blueprint/check.py#func:outline"}}
