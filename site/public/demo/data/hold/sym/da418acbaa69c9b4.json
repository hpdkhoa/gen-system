.snapshot(\"save\", \"_seed_\" + side)\r"},{"line":1232,"text":"    ext = m.get(\"index\") == \"extended\"\r"},{"line":1233,"text":"    digits_ = tuple(fi for fi in (\"index\", \"middle\", \"ring\", \"pinky\") if not (fi == \"index\" and ext))\r"},{"line":1234,"text":"    along_ = float(pu.get(\"along_cm\", 0.0)) if m[\"purpose\"] != \"support\" else 0.0\r"},{"line":1235,"text":"\r"},{"line":1236,"text":"    def seat(roll):\r"},{"line":1237,"text":"        L.snapshot(\"load\", \"_seed_\" + side)\r"},{"line":1238,"text":"        sd_ = L.seed_hold(side, m, palm_dir=pdir, roll_deg=roll, along_cm=along_)\r"},{"line":1239,"text":"        L.settle_palm(side)\r"},{"line":1240,"text":"        for fi in (\"index\", \"middle\", \"ring\", \"pinky\"):\r"},{"line":1241,"text":"            for j, cc in zip((\"01\", \"02\", \"03\"), (0.0, 0.0, 3.0) if (fi == \"index\" and ext) else (0.0, 0.0, 0.0)):\r"},{"line":1242,"text":"                L._set_curl(side, fi, j, float(cc), _FL)\r"},{"line":1243,"text":"        bpy.context.view_layer.update()\r"},{"line":1244,"text":"        L.conform_digits(side, digits_, other=oth)\r"},{"line":1245,"text":"        return sd_\r"},{"line":1246,"text":"\r"},{"line":1247,"text":"    tries = []\r"},{"line":1248,"text":"    for roll in rolls:\r"},{"line":1249,"text":"        seat(roll)\r"},{"line":1250,"text":"        sc_, _why = L._hold_score(side, MARKS, GLOVE, oth, SOFT, L._tree())\r"},{"line":1251,"text":"        tries.append((sc_, roll, L.arm_excess(side)))\r"},{"line":1252,"text":"    return tries, seat, ext\r"}],"name":"purpose_starts","start_line":1219,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:purpose_starts"}}
