,"label":"loop_header","preds":[12,14],"stmts":null,"succs":[14,15]},{"id":14,"label":"loop_body","lines":[{"kind":"call","line":1230,"text":"report[\"support_open\"] = {\"dir\": [round(x, 3) for x in od_], \"open_share\": share_}"}],"preds":[13],"stmts":["call round"],"succs":[13]},{"id":15,"label":"loop_exit","preds":[13],"stmts":null,"succs":[9]},{"cond":"for fi in ('index', 'middle', 'ring', 'pinky')","id":16,"label":"loop_header","preds":[5,22],"stmts":null,"succs":[17,18]},{"cond":"not (fi == 'index' and ext)","id":17,"label":"loop_body","preds":[16],"stmts":null,"succs":[19,20]},{"cond":"m['purpose'] != 'support'","id":18,"label":"loop_exit","preds":[16],"stmts":null,"succs":[23,24]},{"id":19,"label":"then","preds":[17],"stmts":null,"succs":[20]},{"cond":"fi == 'index'","id":20,"label":"merge","preds":[19,17],"stmts":null,"succs":[21,22]},{"id":21,"label":"then","preds":[20],"stmts":null,"succs":[22]},{"id":22,"label":"merge","preds":[21,20],"stmts":null,"succs":[16]},{"id":23,"label":"then","lines":[{"kind":"call","line":1234,"text":"along_ = float(pu.get(\"along_cm\", 0.0)) if m[\"purpose\"] != \"support\" else 0.0"}],"preds":[18],"stmts":["call float","call pu.get"],"succs":[24]},{"id":24,"label":"merge","preds":[23,18],"stmts":null,"succs":[25]},{"cond":"for roll in rolls","id":25,"label":"loop_header","preds":[24,26],"stmts":null,"succs":[26,27]},{"id":26,"label":"loop_body","lines":[{"kind":"call","line":1249,"text":"seat(roll)"},{"kind":"call","line":1250,"text":"sc_, _why = L._hold_score(side, MARKS, GLOVE, oth, SOFT, L._tree())"},{"kind":"call","line":1251,"text":"tries.append((sc_, roll, L.arm_excess(side)))"}],"preds":[25],"stmts":["call seat","call L._hold_score","call L._tree","call tries.append","call L.arm_excess"],"succs":[25]},{"id":27,"label":"loop_exit","lines":[{"kind":"return","line":1252,"text":"return tries, seat, ext"}],"preds":[25],"stmts":["return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[27],"func_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:purpose_starts","issues":null},"source":{"end_line":1252,"file":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py","kind":"func","language":"python","lines":[{"line":1219,"text":"def purpose_starts(side, m, pu, oth):\r"},{"line":1220,"text":"    \"\"\"A hand's starts on its mark: the hand by the run's frame turned about the grip (a support hand's palm toward\r"},{"line":1221,"text":"    where the firing hand leaves the grip open), its palm settled, the index laid straight when it lies along the\r"},{"line":1222,"text":"    guard, the other fingers closed by the skin; each scored by the purposes and by how far past its limits the arm\r"},{"line":1223,"text":"    is. Returns the starts [(score, turn, arm excess)], a function that seats the hand at a turn, and whether the\r"},{"line":1224,"text":"    index is extended.\"\"\"\r"},{"line":1225,"text":"    pdir, rolls = m.get(\"palm_dir\"), [float(x) for x in job.get(\"seed_rolls\", range(-90, 91, 15))]\r"},{"line":1226,"text":"    if m[\"purpose\"] == \"support\":\r"},{"line":1227,"text":"        od_, share_ = L.open_dir(\"r\" if side == \"l\" else \"l\", m, GLOVE)\r"},{"line":1228,"text":"        if od_ is not None:\r"},{"line":1229,"text":"            pdir, rolls = od_, [float(x) for x in range(-45, 46, 15)]\r"},{"line":1230,"text":"            report[\"support_open\"] = {\"dir\": [round(x, 3) for x in od_], \"open_share\": share_}\r"},{"line":1231,"text":"    L.snapshot(\"save\", \"_seed_\" + side)\r"},{"line":1232,"text":"    ext = m.get(\"index\") == \"extended\"\r"},{"line":1233,"text":"    digits_ = tuple(fi for fi in (\"index\", \"middle\", \"ring\", \"pinky\") if not (fi == \"index\" and ext))\r"},{"line":1234,"text":"    along_ = float(pu.get(\"along_cm\", 0.0)) if m[\"purpose\"] != \"support\" else 0.0\r"},{"line":1235,"text":"\r"},{"line":1236,"text":"    def seat(roll):\r"},{"line":1237,"text":"        L.snapshot(\"load\", \"_seed_\" + side)\r"},{"line":1238,"text":"        sd_ = L.seed_hold(side, m, palm_dir=pdir, roll_deg=roll, along_cm=along_)\r"},{"line":1239,"text":"        L.settle_palm(side)\r"},{"line":1240,"text":"        for fi in (\"index\", \"middle\", \"ring\", \"pinky\"):\r"},{"line":1241,"text":"            for j, cc in zip((\"01\", \"02\", \"03\"), (0.0, 0.0, 3.0) if (fi == \"index\" and ext) else (0.0, 0.0, 0.0)):\r"},{"line":1242,"text":"                L._set_curl(side, fi, j, float(cc), _FL)\r"},{"line":1243,"text":"        bpy.context.view_layer.update()\r"},{"line":1244,"text":"        L.conform_digits(side, digits_, other=oth)\r"},{"line":1245,"text":"        return sd_\r"},{"line":1246,"text":"\r"},{"line":1247,"text":"    tries = []\r"},{"line":1248,"text":"    for roll in rolls:\r"},{"line":1249,"text":"        seat(roll)\r"},{"line":1250,"text":"        sc_, _why = L._hold_score(side, MARKS, GLOVE, oth, SOFT, L._tree())\r"},{"line":1251,"text":"        tries.append((sc_, roll, L.arm_excess(side)))\r"},{"line":1252,"text":"    return tries, seat, ext\r"}],"name":"purpose_starts","start_line":1219,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:purpose_starts"}}
