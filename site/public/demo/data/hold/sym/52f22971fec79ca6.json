=(\"object\", \"hand\", \"heat\", \"contact\"),\r"},{"line":1149,"text":"                         views=(\"right\", \"left\", \"top\", \"front\"), size=(900, 600), ortho_cm=26.0):\r"},{"line":1150,"text":"        \"\"\"The model's vision drawn, straight-on views about centre (a world point) along the held part's axes:\r"},{"line":1151,"text":"        object (the surface by region), hand (the skin by hand part), heat (the skin by its signed gap to the\r"},{"line":1152,"text":"        object and the other hand), contact (the object's surface by the hand part touching it). Returns paths.\"\"\"\r"},{"line":1153,"text":"        st = getattr(self, \"_cm_state\", None)\r"},{"line":1154,"text":"        if st is None:\r"},{"line":1155,"text":"            raise ValueError(\"run contact_map first\")\r"},{"line":1156,"text":"        sc = self.sc\r"},{"line":1157,"text":"        Fq = self._obj_frame(frame_part).to_quaternion()\r"},{"line":1158,"text":"        skin = self.meshes[0]\r"},{"line":1159,"text":"        fine = self._fine_copy()\r"},{"line":1160,"text":"        FW = np.array([list(v.co) for v in fine.data.vertices])\r"},{"line":1161,"text":"        skd = KDTree(len(st[\"SW\"]))\r"},{"line":1162,"text":"        for i, p in enumerate(st[\"SW\"]):\r"},{"line":1163,"text":"            skd.insert(Vector(p), i)\r"},{"line":1164,"text":"        skd.balance()\r"},{"line":1165,"text":"        near = [skd.find(Vector(p))[1] for p in FW]\r"},{"line":1166,"text":"        nverts = len(skin.data.vertices)\r"},{"line":1167,"text":"        keep = (sc.render.engine, sc.render.resolution_x, sc.render.resolution_y, sc.display.shading.light,\r"},{"line":1168,"text":"                sc.display.shading.color_type, sc.camera, sc.display.shading.show_xray, sc.display.shading.xray_alpha)\r"},{"line":1169,"text":"        sc.render.engine = \"BLENDER_WORKBENCH\"\r"},{"line":1170,"text":"        sc.render.resolution_x, sc.render.resolution_y = size\r"},{"line":1171,"text":"        sc.display.shading.light = \"STUDIO\"\r"},{"line":1172,"text":"        sc.display.shading.color_type = \"VERTEX\"\r"},{"line":1173,"text":"        hidden = [o for o in sc.objects if o.type == \"MESH\" and o not in (skin, fine) and not o.hide_render]\r"},{"line":1174,"text":"        for o in hidden:\r"},{"line":1175,"text":"            o.hide_render = True\r"},{"line":1176,"text":"        cam_d = bpy.data.cameras.get(\"contact_cam\") or bpy.data.cameras.new(\"contact_cam\")\r"},{"line":1177,"text":"        cam = bpy.data.objects.get(\"contact_cam\") or bpy.data.objects.new(\"contact_cam\", cam_d)\r"},{"line":1178,"text":"        if cam.name not in sc.collection.objects:\r"},{"line":1179,"text":"            sc.collection.objects.link(cam)\r"},{"line":1180,"text":"        cam_d.type = \"ORTHO\"\r"},{"line":1181,"text":"        cam_d.ortho_scale = ortho_cm / 100.0\r"},{"line":1182,"text":"        cam_d.clip_start = 0.001\r"},{"line":1183,"text":"        cam_d.clip_end = 5.0\r"},{"line":1184,"text":"        sc.camera = cam\r"},{"line":1185,"text":"        dirs = {\"right\": Vector((-1, 0, 0)), \"left\": Vector((1, 0, 0)), \"top\": Vector((0, 0, 1)), \"front\": Vector((0, -1, 0)),\r"},{"line":1186,"text":"                \"back\": Vector((0, 1, 0)), \"under\": Vector((0, 0, -1))}\r"},{"line":1187,"text":"        grey = (0.62, 0.62, 0.64)\r"},{"line":1188,"text":"        paths = []\r"},{"line":1189,"text":"        try:\r"},{"line":1190,"text":"            for kind in kinds:\r"},{"line":1191,"text":"                if kind == \"object\":\r"},{"line":1192,"text":"                    gcol = [_region_colour(st[\"SL\"][k]) for k in near]\r"},{"line":1193,"text":"                    scol = [grey] * nverts\r"},{"line":1194,"text":"                    skin.hide_render = True\r"},{"line":1195,"text":"                elif kind == \"hand\":\r"},{"line":1196,"text":"                    gcol = [(0.25, 0.25, 0.27)] * len(near)\r"},{"line":1197,"text":"                    scol = [grey] * nverts\r"},{"line":1198,"text":"                    for s, labs in st[\"labels\"].items():\r"},{"line":1199,"text":"                        for i, l_ in labs.items():\r"},{"line":1200,"text":"                            scol[i] = HAND_COLOURS.get(_lab_key(l_), grey)\r"},{"line":1201,"text":"                    skin.hide_render = False\r"},{"line":1202,"text":"                elif kind == \"heat\":\r"},{"line":1203,"text":"                    scol = [grey] * nverts\r"},{"line":1204,"text":"                    for i, d in st[\"vert_d\"].items():\r"},{"line":1205,"text":"                        scol[i] = _heat(d, st[\"band_cm\"])\r"},{"line":1206,"text":"                    gcol = [(0.1, 0.6, 0.2) if k in st[\"touch\"] else (0.3, 0.3, 0.32) for k in near]\r"},{"line":1207,"text":"                    skin.hide_render = False\r"},{"line":1208,"text":"                elif kind == \"contact\":\r"},{"line":1209,"text":"                    gcol = []\r"},{"line":1210,"text":"                    for k in near:\r"},{"line":1211,"text":"                        if k in st[\"touch\"]:\r"},{"line":1212,"text":"                            s, l_ = st[\"touch\"][k]\r"},{"line":1213,"text":"                            c = HAND_COLOURS.get(_lab_key(l_), (0.9, 0.9, 0.9))\r"},{"line":1214,"text":"                            gcol.append(c if s == \"r\" else tuple(0.55 * x + 0.45 for x in c))\r"},{"line":1215,"text":"                        else:\r"},{"line":1216,"text":"                            gcol.append(_region_colour(st[\"SL\"][k]) if False else (0.35, 0.35, 0.37))\r"},{"line":1217,"text":"                    scol = [grey] * nverts\r"},{"line":1218,"text":"                    skin.hide_render = True\r"},{"line":1219,"text":"                else:\r"},{"line":1220,"text":"                    raise ValueError(\"kinds: object, hand, heat, contact\")\r"},{"line":1221,"text":"                # a press is skin inside something: the heat is drawn see-through so buried skin shows\r"},{"line":1222,"text":"                sc.display.shading.show_xray = kind == \"heat\"\r"},{"line":1223,"text":"                sc.display.shading.xray_alpha = 0.45\r"},{"line":1224,"text":"                self._paint(fine, \"contact_view\", gcol)\r"},{"line":1225,"text":"                self._paint(skin, \"contact_view\", scol)\r"},{"line":1226,"text":"                for v in views:\r"},{"line":1227,"text":"                    dv = (Fq @ dirs[v]).normalized()\r"},{"line":1228,"text":"                    upv = (Fq @ (Vector((0, 0, 1)) if v not in (\"top\", \"under\") else Vector((0, 1, 0)))).normalized()\r"},{"line":1229,"text":"                    cam.location = Vector(centre) + dv * 0.8\r"},{"line":1230,"text":"                    xc = upv.cross(dv).normalized()\r"},{"line":1231,"text":"                    cam.rotation_euler = Matrix((xc, dv.cross(xc), dv)).transposed().to_euler()\r"},{"line":1232,"text":"                    path = self._own(os.path.join(out_dir, \"contact_%s_%s.png\" % (kind, v)))\r"},{"line":1233,"text":"                    sc.render.filepath = path\r"},{"line":1234,"text":"                    bpy.ops.render.render(write_still=True)\r"},{"line":1235,"text":"                    paths.append(path)\r"},{"line":1236,"text":"        finally:\r"},{"line":1237,"text":"            skin.hide_render = False\r"},{"line":1238,"text":"            for o in hidden:\r"},{"line":1239,"text":"                o.hide_render = False\r"},{"line":1240,"text":"            bpy.data.objects.remove(fine)\r"},{"line":1241,"text":"            (sc.render.engine, sc.render.resolution_x, sc.render.resolution_y, sc.display.shading.light,\r"},{"line":1242,"text":"             sc.display.shading.color_type, sc.camera, sc.display.shading.show_xray, sc.display.shading.xray_alpha) = keep\r"},{"line":1243,"text":"        return paths\r"}],"name":"contact_pictures","start_line":1148,"symbol_id":"hold-code/poselab_mcp/blender/contactlab.py#method:ContactMixin.contact_pictures"}}
