l},"source":{"end_line":68,"file":"hold-code/weaponlab/blueprint/plan.py","kind":"func","language":"python","lines":[{"line":54,"text":"def clip_line(outline, p, q, keep=\"left\"):\r"},{"line":55,"text":"    \"\"\"The part of a polygon on one side of the line from p to q (y, z): keep \"left\" or \"right\" of it, looking\r"},{"line":56,"text":"    from p to q.\"\"\"\r"},{"line":57,"text":"    side = lambda a: (q[0] - p[0]) * (a[1] - p[1]) - (q[1] - p[1]) * (a[0] - p[0])   # noqa: E731\r"},{"line":58,"text":"    inside = (lambda a: side(a) >= 0) if keep == \"left\" else (lambda a: side(a) <= 0)\r"},{"line":59,"text":"    out = []\r"},{"line":60,"text":"    for k, a in enumerate(outline):\r"},{"line":61,"text":"        b = outline[(k + 1) % len(outline)]\r"},{"line":62,"text":"        if inside(a):\r"},{"line":63,"text":"            out.append(list(a))\r"},{"line":64,"text":"        if inside(a) != inside(b):\r"},{"line":65,"text":"            sa, sb = side(a), side(b)\r"},{"line":66,"text":"            t = sa / (sa - sb)\r"},{"line":67,"text":"            out.append([round(a[0] + (b[0] - a[0]) * t, 4), round(a[1] + (b[1] - a[1]) * t, 4)])\r"},{"line":68,"text":"    return out\r"}],"name":"clip_line","start_line":54,"symbol_id":"hold-code/weaponlab/blueprint/plan.py#func:clip_line"}}
