uccs":[54]},{"cond":"k != name","id":54,"label":"merge","preds":[53,51],"stmts":null,"succs":[55,56]},{"id":55,"label":"then","lines":[{"kind":"call","line":454,"text":"small = tuple(k for k, (pk, _nk) in pts.items() if k != name and len(pk) < 0.1 * len(P))"}],"preds":[54],"stmts":["call len","call len"],"succs":[56]},{"id":56,"label":"merge","preds":[55,54],"stmts":null,"succs":[50]},{"cond":"for r in rec['runs']","id":57,"label":"loop_header","preds":[52,58],"stmts":null,"succs":[58,59]},{"id":58,"label":"loop_body","lines":[{"kind":"call","line":457,"text":"r[\"openings\"] = self._attach_openings(r, opens)"}],"preds":[57],"stmts":["call self._attach_openings"],"succs":[57]},{"id":59,"label":"loop_exit","lines":[{"kind":"call","line":458,"text":"self._part_P = getattr(self, \"_part_P\", {})"}],"preds":[57],"stmts":["call getattr"],"succs":[19]}],"effects":["unknown"],"entry":0,"exits":[10],"func_id":"hold-code/poselab_mcp/blender/holdlab.py#func:read_object","issues":null},"source":{"end_line":462,"file":"hold-code/poselab_mcp/blender/holdlab.py","kind":"func","language":"python","lines":[{"line":415,"text":"    def read_object(self, parts=None, hand_length_cm=None, inner_toward=None):\r"},{"line":416,"text":"        \"\"\"The object read from its geometry: each part's size, its runs a hand can wrap (axis, sections with their\r"},{"line":417,"text":"        girth and middles, the inner end: the end nearer the rest of the object, or nearer inner_toward, a point in\r"},{"line":418,"text":"        the object's frame) and the openings beside each run. Kept for the purposes and the hold search. hand_length_cm:\r"},{"line":419,"text":"        the hand's length (Pose Lab's body_size), for the best handle size.\"\"\"\r"},{"line":420,"text":"        self._need()\r"},{"line":421,"text":"        if hand_length_cm is None:\r"},{"line":422,"text":"            try:\r"},{"line":423,"text":"                hand_length_cm = self.body_size(\"r\")[\"r\"][\"measures\"][\"hand_length_cm\"]\r"},{"line":424,"text":"            except Exception:\r"},{"line":425,"text":"                hand_length_cm = 19.0\r"},{"line":426,"text":"        self._pbvh = {}\r"},{"line":427,"text":"        pts = self._part_points()\r"},{"line":428,"text":"        allp = np.vstack([p for p, _n in pts.values()])\r"},{"line":429,"text":"        out = {}\r"},{"line":430,"text":"        for name, (P, N) in pts.items():\r"},{"line":431,"text":"            if parts and name not in parts:\r"},{"line":432,"text":"                continue\r"},{"line":433,"text":"            ext = np.ptp(P, 0) * 100.0\r"},{"line":434,"text":"            rec = {\"points\": len(P), \"size_cm\": [round(float(x), 1) for x in ext], \"runs\": []}\r"},{"line":435,"text":"            if len(P) >= 60:\r"},{"line":436,"text":"                runs = self._runs(P, hand_length_cm)\r"},{"line":437,"text":"                rest = np.vstack([p for k, (p, _n) in pts.items() if k != name]) if len(pts) > 1 else P\r"},{"line":438,"text":"                for r in runs:\r"},{"line":439,"text":"                    d = np.array(r[\"axis\"])\r"},{"line":440,"text":"                    a = np.array(r[\"sections\"][0][\"centre\"])\r"},{"line":441,"text":"                    b = np.array(r[\"sections\"][-1][\"centre\"])\r"},{"line":442,"text":"                    tgt = np.array(inner_toward) if inner_toward is not None else rest.mean(0) if len(pts) > 1 else allp.mean(0)\r"},{"line":443,"text":"                    # the end nearer the rest of the object (a grip's top meets the frame): with only one part, the\r"},{"line":444,"text":"                    # end nearer the part's own bulk off the run\r"},{"line":445,"text":"                    if inner_toward is None and len(pts) == 1:\r"},{"line":446,"text":"                        off = P[np.abs((P - (a + b) / 2) @ d) > np.linalg.norm(b - a) / 2]\r"},{"line":447,"text":"                        tgt = off.mean(0) if len(off) else (a + b) / 2\r"},{"line":448,"text":"                    inner, outer = (a, b) if np.linalg.norm(a - tgt) < np.linalg.norm(b - tgt) else (b, a)\r"},{"line":449,"text":"                    r[\"inner\"], r[\"outer\"] = [float(x) for x in inner], [float(x) for x in outer]\r"},{"line":450,"text":"                    r[\"part\"] = name\r"},{"line":451,"text":"                    rec[\"runs\"].append(r)\r"},{"line":452,"text":"                # a part much smaller than this one does not close an opening (a trigger inside its guard); a\r"},{"line":453,"text":"                # large one does (a slide over a frame's open top)\r"},{"line":454,"text":"                small = tuple(k for k, (pk, _nk) in pts.items() if k != name and len(pk) < 0.1 * len(P))\r"},{"line":455,"text":"                opens = self._part_openings(name, P, skip=small)\r"},{"line":456,"text":"                for r in rec[\"runs\"]:\r"},{"line":457,"text":"                    r[\"openings\"] = self._attach_openings(r, opens)\r"},{"line":458,"text":"                self._part_P = getattr(self, \"_part_P\", {})\r"},{"line":459,"text":"                self._part_P[name] = P\r"},{"line":460,"text":"            out[name] = rec\r"},{"line":461,"text":"        self._object = {\"parts\": out, \"hand_length_cm\": hand_length_cm}\r"},{"line":462,"text":"        return self._object\r"}],"name":"read_object","start_line":415,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#func:read_object"}}
