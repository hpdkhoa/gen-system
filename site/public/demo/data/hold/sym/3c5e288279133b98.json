oses onto the trigger),\r"},{"line":3014,"text":"        each joint within its range. Returns how many turns it made.\"\"\"\r"},{"line":3015,"text":"        if not self._has_fingers(s):\r"},{"line":3016,"text":"            return 0\r"},{"line":3017,"text":"        import re as _re\r"},{"line":3018,"text":"        _L, FL = self._limits()\r"},{"line":3019,"text":"        tree = self._tree()\r"},{"line":3020,"text":"        made = 0\r"},{"line":3021,"text":"        for _ in range(16):\r"},{"line":3022,"text":"            back_cm, seg = self._hand_contacts(s, tree)[3:5]\r"},{"line":3023,"text":"            if back_cm <= back_max_cm or not seg:\r"},{"line":3024,"text":"                break\r"},{"line":3025,"text":"            m = _re.match(r\"(index|middle|ring|pinky)(\\d)\", seg)\r"},{"line":3026,"text":"            if not m:\r"},{"line":3027,"text":"                break\r"},{"line":3028,"text":"            fi, k = m.group(1), int(m.group(2))\r"},{"line":3029,"text":"            moved = False\r"},{"line":3030,"text":"            for j in [\"%02d\" % x for x in range(min(k, 3), 0, -1)]:\r"},{"line":3031,"text":"                fr, _b, planes = self._finger_report(s, FL)\r"},{"line":3032,"text":"                curl = fr[\"%s_%s\" % (fi, j)][0]\r"},{"line":3033,"text":"                lo, hi = FL[j][0], FL[j][1]\r"},{"line":3034,"text":"                n = self._n(\"finger\", s, fi, j)\r"},{"line":3035,"text":"                M = self._bw(n)\r"},{"line":3036,"text":"                head = M.translation.copy()\r"},{"line":3037,"text":"                for want_open in (True, False):\r"},{"line":3038,"text":"                    room = (curl - lo - 1.0) if want_open else (hi - curl - 1.0)\r"},{"line":3039,"text":"                    if room <= 0.0:\r"},{"line":3040,"text":"                        continue\r"},{"line":3041,"text":"                    step = min(6.0, room)\r"},{"line":3042,"text":"                    for sg in (1.0, -1.0):\r"},{"line":3043,"text":"                        self._turn_about(n, planes[fi], step * sg, head)\r"},{"line":3044,"text":"                        c2 = self._finger_report(s, FL)[0][\"%s_%s\" % (fi, j)][0]\r"},{"line":3045,"text":"                        if ((c2 < curl - 0.5) if want_open else (c2 > curl + 0.5)) and lo <= c2 <= hi and \\\r"},{"line":3046,"text":"                                self._hand_contacts(s, tree)[3] < back_cm - 1e-4:\r"},{"line":3047,"text":"                            moved = True\r"},{"line":3048,"text":"                            break\r"},{"line":3049,"text":"                        self._set_world(n, M)\r"},{"line":3050,"text":"                    if moved:\r"},{"line":3051,"text":"                        break\r"},{"line":3052,"text":"                if moved:\r"},{"line":3053,"text":"                    break\r"},{"line":3054,"text":"            if not moved:\r"},{"line":3055,"text":"                break\r"},{"line":3056,"text":"            made += 1\r"},{"line":3057,"text":"        return made\r"}],"name":"_clear_fingers","start_line":3010,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._clear_fingers"}}
