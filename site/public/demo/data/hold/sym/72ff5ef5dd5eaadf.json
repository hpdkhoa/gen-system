{"flow":{"kind":"var","name":"need","noCFG":true,"reason":"need is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":1719,"file":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py","kind":"var","language":"python","lines":[{"line":1679,"text":"need = {}\r"},{"line":1680,"text":"for cid_, clip in job[\"clips\"].items():\r"},{"line":1681,"text":"    stays = {}\r"},{"line":1682,"text":"    for fr in clip[\"frames\"]:\r"},{"line":1683,"text":"        for side, h in fr[\"hands\"].items():\r"},{"line":1684,"text":"            for k in (\"a\", \"b\"):\r"},{"line":1685,"text":"                mk = mark_of(h[k])\r"},{"line":1686,"text":"                if not mk:\r"},{"line":1687,"text":"                    continue\r"},{"line":1688,"text":"                if (side, mk) not in need:\r"},{"line":1689,"text":"                    need[(side, mk)] = (fr, None, False)\r"},{"line":1690,"text":"                on = k == \"b\" and h[\"w\"] >= 0.999 or k == \"a\" and h[\"w\"] <= 0.001\r"},{"line":1691,"text":"                if on:\r"},{"line":1692,"text":"                    stays.setdefault((side, mk), []).append(fr)\r"},{"line":1693,"text":"    for sk, frs in stays.items():\r"},{"line":1694,"text":"        if not need[sk][2]:\r"},{"line":1695,"text":"            need[sk] = (frs[len(frs) // 2], cid_, True)       # the middle of the first clip's stay on the hold\r"},{"line":1696,"text":"for (side, mk), (fr, cid_, _) in sorted(need.items()):\r"},{"line":1697,"text":"    key = (side, mk, None, ())\r"},{"line":1698,"text":"    if key in GRASPS:\r"},{"line":1699,"text":"        continue\r"},{"line":1700,"text":"    L.snapshot(\"load\", \"hold\")\r"},{"line":1701,"text":"    rest_parts()\r"},{"line":1702,"text":"    if job.get(\"solve_at_use\", True):\r"},{"line":1703,"text":"        gun_pose(fr[\"gun\"])\r"},{"line":1704,"text":"        tr_ = job[\"tracks\"].get(cid_) if cid_ else None\r"},{"line":1705,"text":"        if tr_ and not free_mark(mk):\r"},{"line":1706,"text":"            at_t = {round(f[\"t\"], 5): f[\"bones\"] for f in tr_[\"frames\"]}.get(round(fr[\"t\"], 5))\r"},{"line":1707,"text":"            if at_t:\r"},{"line":1708,"text":"                pose_parts(at_t)                          # the slide back on a press check, as the hand holds it\r"},{"line":1709,"text":"        o = \"l\" if side == \"r\" else \"r\"\r"},{"line":1710,"text":"        ho = fr[\"hands\"][o]\r"},{"line":1711,"text":"        omk = mark_of(ho[\"b\"] if ho[\"w\"] >= 0.5 else ho[\"a\"])\r"},{"line":1712,"text":"        if omk and (o, omk, None, ()) in GRASPS:\r"},{"line":1713,"text":"            rel, fingers, _ = GRASPS[(o, omk, None, ())]\r"},{"line":1714,"text":"            B = RA.matrix_world if free_mark(omk) else bone_world(mark_bone(omk))\r"},{"line":1715,"text":"            L._put_hand(o, B @ rel)\r"},{"line":1716,"text":"            for n, q in fingers.items():\r"},{"line":1717,"text":"                L.arm.pose.bones[n].rotation_quaternion = q\r"},{"line":1718,"text":"        bpy.context.view_layer.update()\r"},{"line":1719,"text":"    L.snapshot(\"save\", \"at_use\")\r"}],"name":"need","start_line":1679,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#var:need"}}
