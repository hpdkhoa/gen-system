reported at 21 fails\r"},{"line":2617,"text":"        if round(under, 1) < L[\"elbow_under_shoulder_cm\"]:\r"},{"line":2618,"text":"            bad.append(\"elbow %.1f cm under the shoulder (at least %.1f)\" % (under, L[\"elbow_under_shoulder_cm\"]))\r"},{"line":2619,"text":"        bend = self._deg(upper, fore)\r"},{"line":2620,"text":"        if round(bend) > L[\"elbow_bend_max_deg\"]:\r"},{"line":2621,"text":"            bad.append(\"elbow bent %.0f (at most %.0f)\" % (bend, L[\"elbow_bend_max_deg\"]))\r"},{"line":2622,"text":"        if round(bend) < L[\"elbow_bend_min_deg\"]:\r"},{"line":2623,"text":"            bad.append(\"elbow locked straight (%.0f)\" % bend)\r"},{"line":2624,"text":"        total = self._deg(fore, hand)\r"},{"line":2625,"text":"        thumb_side = f(\"index\") - f(\"pinky\")\r"},{"line":2626,"text":"        palm = thumb_side.cross(hand) * (-1.0 if s == \"l\" else 1.0)   # toward the palm (see _hand_frame)\r"},{"line":2627,"text":"        fn = fore.normalized()\r"},{"line":2628,"text":"        off = hand.normalized() - fn * hand.normalized().dot(fn)\r"},{"line":2629,"text":"        flat = lambda v: v - fn * v.dot(fn)\r"},{"line":2630,"text":"        asin = lambda x: math.degrees(math.asin(max(-1.0, min(1.0, x))))\r"},{"line":2631,"text":"        # the bend split on two perpendicular axes across the forearm: toward the palm, and toward the thumb\r"},{"line":2632,"text":"        c = hand.normalized().dot(fn)\r"},{"line":2633,"text":"        e1 = flat(palm).normalized() if flat(palm).length > 1e-9 else Vector((0.0, 0.0, 0.0))\r"},{"line":2634,"text":"        t = flat(thumb_side)\r"},{"line":2635,"text":"        e2 = t - e1 * t.dot(e1)\r"},{"line":2636,"text":"        e2 = e2.normalized() if e2.length > 1e-9 else Vector((0.0, 0.0, 0.0))\r"},{"line":2637,"text":"        flex = math.degrees(math.atan2(off.dot(e1), c))\r"},{"line":2638,"text":"        dev = math.degrees(math.atan2(off.dot(e2), c))\r"},{"line":2639,"text":"        if round(total) > L[\"wrist_max_deg\"]:\r"},{"line":2640,"text":"            bad.append(\"wrist bent %.0f off the forearm (at most %.0f)\" % (total, L[\"wrist_max_deg\"]))\r"},{"line":2641,"text":"        rf, rd = round(flex), round(dev)\r"},{"line":2642,"text":"        if rf > L[\"wrist_flexion_deg\"] or -rf > L[\"wrist_extension_deg\"] or rd > L[\"wrist_radial_deg\"] or -rd > L[\"wrist_ulnar_deg\"]:\r"},{"line":2643,"text":"            bad.append(\"wrist past its joint range (%s %.0f, %s %.0f)\" % (\"flexion\" if flex >= 0 else \"extension\", abs(flex),\r"},{"line":2644,"text":"                                                                          \"radial\" if dev >= 0 else \"ulnar\", abs(dev)))\r"},{"line":2645,"text":"        rep_ = {\"elbow_under_shoulder_cm\": round(under, 1), \"upper_arm_raised_deg\": round(self._deg(upper, -up)),\r"},{"line":2646,"text":"                \"elbow_bend_deg\": round(bend), \"wrist_bend_deg\": round(total), \"wrist_flexion_deg\": round(flex),\r"},{"line":2647,"text":"                \"wrist_radial_deg\": round(dev)}\r"},{"line":2648,"text":"        # the forearm's rotation: pronation and supination, measured from thumb up against the elbow's hinge plane (the\r"},{"line":2649,"text":"        # bones' bind does not enter it). The radius turns over the ulna, so a hand's roll is the forearm's\r"},{"line":2650,"text":"        rot = self._forearm_rotation(s)\r"},{"line":2651,"text":"        if rot is not None:\r"},{"line":2652,"text":"            rep_[\"forearm_rotation_deg\"] = round(rot)\r"},{"line":2653,"text":"            if round(rot) > L[\"supination_deg\"]:\r"},{"line":2654,"text":"                bad.append(\"forearm supinated %.0f (at most %.0f)\" % (rot, L[\"supination_deg\"]))\r"},{"line":2655,"text":"            if -round(rot) > L[\"pronation_deg\"]:\r"},{"line":2656,"text":"                bad.append(\"forearm pronated %.0f (at most %.0f)\" % (-rot, L[\"pronation_deg\"]))\r"},{"line":2657,"text":"        if self._twist_bones(s):\r"},{"line":2658,"text":"            # a rig with twist bones carries the roll along the forearm's skin: each link (the elbow's end, each twist\r"},{"line":2659,"text":"            # bone, the wrist) turns only part of it. The whole roll in one link wrings the skin there\r"},{"line":2660,"text":"            links, total = self._forearm_links(s)\r"},{"line":2661,"text":"            rep_[\"forearm_roll_deg\"] = round(total)\r"},{"line":2662,"text":"            rep_[\"forearm_links_deg\"] = {n: round(v) for n, v, _share in links}\r"},{"line":2663,"text":"            for n, v, share in links:\r"},{"line":2664,"text":"                if round(abs(v)) > L[\"forearm_link_max_deg\"]:\r"},{"line":2665,"text":"                    bad.append(\"forearm's %s link rolled %.0f (at most %.0f: the skin wrings there; its even share is %.0f)\"\r"},{"line":2666,"text":"                               % (n, abs(v), L[\"forearm_link_max_deg\"], abs(share)))\r"},{"line":2667,"text":"        else:\r"},{"line":2668,"text":"            # without twist bones: the hand turned about the forearm's line against the forearm's bone, beyond the idle\r"},{"line":2669,"text":"            # grip's (a forearm turned 154 degrees under a still hand passed before 0.3.1)\r"},{"line":2670,"text":"            twist = self._wrist_twist(s)\r"},{"line":2671,"text":"            if twist is not None:\r"},{"line":2672,"text":"                rep_[\"wrist_twist_deg\"] = round(twist)\r"},{"line":2673,"text":"                if round(twist) > L[\"wrist_twist_max_deg\"]:\r"},{"line":2674,"text":"                    bad.append(\"wrist twisted %.0f against the idle grip (at most %.0f): the hand's roll belongs to the forearm\"\r"},{"line":2675,"text":"                               % (twist, L[\"wrist_twist_max_deg\"]))\r"},{"line":2676,"text":"        # the shoulder in its range, against the view's axes (right, forward, up); lat: the arm's own side\r"},{"line":2677,"text":"        lat = VIEW_RIGHT if s == \"r\" else -VIEW_RIGHT\r"},{"line":2678,"text":"        u = upper.normalized()\r"},{"line":2679,"text":"        sf = math.degrees(math.atan2(u.dot(VIEW_FWD), -u.dot(VIEW_UP)))     # 0 hanging, 90 straight ahead, 180 up\r"},{"line":2680,"text":"        rep_[\"shoulder_flexion_deg\"] = round(sf)\r"},{"line":2681,"text":"        if round(sf) > L[\"shoulder_flexion_deg\"]:\r"},{"line":2682,"text":"            bad.append(\"shoulder raised %.0f forward (at most %.0f)\" % (sf, L[\"shoulder_flexion_deg\"]))\r"},{"line":2683,"text":"        if -round(sf) > L[\"shoulder_extension_deg\"]:\r"},{"line":2684,"text":"            bad.append(\"shoulder swung %.0f back (at most %.0f)\" % (-sf, L[\"shoulder_extension_deg\"]))\r"},{"line":2685,"text":"        hz = Vector((u.dot(lat), u.dot(VIEW_FWD)))\r"},{"line":2686,"text":"        if hz.length > 0.5:                       # the arm well off hanging: its swing in the horizontal plane means something\r"},{"line":2687,"text":"            cross = math.degrees(math.atan2(-hz.x, hz.y))       # + across the body past straight ahead\r"},{"line":2688,"text":"            rep_[\"shoulder_across_deg\"] = round(cross)\r"},{"line":2689,"text":"            if round(cross) > L[\"shoulder_cross_body_deg\"]:\r"},{"line":2690,"text":"                bad.append(\"upper arm %.0f across the body past straight ahead (at most %.0f)\" % (cross, L[\"shoulder_cross_body_deg\"]))\r"},{"line":2691,"text":"            behind = math.degrees(math.atan2(-hz.y, hz.x))       # + behind the side\r"},{"line":2692,"text":"            if round(behind) > L[\"shoulder_behind_deg\"]:\r"},{"line":2693,"text":"                bad.append(\"upper arm %.0f behind the side (at most %.0f)\" % (behind, L[\"shoulder_behind_deg\"]))\r"},{"line":2694,"text":"        if bend >= 25.0:                          # the upper arm's own turn reads only with the elbow bent\r"},{"line":2695,"text":"            ref = VIEW_FWD - u * VIEW_FWD.dot(u) if abs(u.dot(VIEW_FWD)) < 0.9 else VIEW_UP - u * VIEW_UP.dot(u)\r"},{"line":2696,"text":"            fp = fore - u * fore.dot(u)\r"},{"line":2697,"text":"            if ref.length > 1e-6 and fp.length > 1e-6:\r"},{"line":2698,"text":"                ref, fp = ref.normalized(), fp.normalized()\r"},{"line":2699,"text":"                rr = math.degrees(math.atan2(ref.cross(fp).dot(u), ref.dot(fp)))\r"},{"line":2700,"text":"                internal = -rr if s == \"r\" else rr\r"},{"line":2701,"text":"                rep_[\"shoulder_internal_rot_deg\"] = round(internal)\r"},{"line":2702,"text":"                if round(internal) > L[\"shoulder_internal_deg\"]:\r"},{"line":2703,"text":"                    bad.append(\"upper arm turned %.0f inward (at most %.0f)\" % (internal, L[\"shoulder_internal_deg\"]))\r"},{"line":2704,"text":"                if -round(internal) > L[\"shoulder_external_deg\"]:\r"},{"line":2705,"text":"                    bad.append(\"upper arm turned %.0f outward (at most %.0f)\" % (-internal, L[\"shoulder_external_deg\"]))\r"},{"line":2706,"text":"        return rep_, bad\r"}],"name":"_arm_report","start_line":2607,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._arm_report"}}
