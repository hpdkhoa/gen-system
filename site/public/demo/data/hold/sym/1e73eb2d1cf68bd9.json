":["call lay_palm"],"succs":[8]},{"id":10,"label":"then","preds":[8],"stmts":null,"succs":[11]},{"cond":"pr","id":11,"label":"merge","preds":[10,8],"stmts":null,"succs":[12,13]},{"id":12,"label":"then","preds":[11],"stmts":null,"succs":[13]},{"cond":"best is None","id":13,"label":"merge","lines":[{"kind":"call","line":636,"text":"score = (pr[0] if pr else 0.0) * 4.0 + max(0.0, gap - 0.3) * 2.0 + arm_over(side) * 0.1 + 4.0 * short"}],"preds":[12,11],"stmts":["call max","call arm_over"],"succs":[14,15]},{"id":14,"label":"then","preds":[13],"stmts":null,"succs":[15]},{"cond":"best is None or score < best[0] - 1e-06","id":15,"label":"merge","preds":[14,13],"stmts":null,"succs":[16,17]},{"id":16,"label":"then","preds":[15],"stmts":null,"succs":[17]},{"id":17,"label":"merge","preds":[16,15],"stmts":null,"succs":[4]},{"id":18,"label":"then","lines":[{"kind":"call","line":640,"text":"short = turn_search(side, best[1], n, tw) if STYLE else lay_palm(side, best[1], n, toward=tw)"}],"preds":[3],"stmts":["call turn_search"],"succs":[19]},{"id":19,"label":"merge","lines":[{"kind":"call","line":641,"text":"report.setdefault(\"contact_place\", {})[\"%s:%s\" % (side, mark)] = {\"down_cm\": -best[2], \"forward_cm\": best[3], \"score\": round(best[0], 3)}"},{"kind":"return","line":642,"text":"return short"}],"preds":[18,20],"stmts":["call round","return"],"succs":null},{"id":20,"label":"else","lines":[{"kind":"call","line":640,"text":"short = turn_search(side, best[1], n, tw) if STYLE else lay_palm(side, best[1], n, toward=tw)"}],"preds":[3],"stmts":["call lay_palm"],"succs":[19]}],"effects":["unknown"],"entry":0,"exits":[19],"func_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:contact_search","issues":null},"source":{"end_line":642,"file":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py","kind":"func","language":"python","lines":[{"line":618,"text":"def contact_search(side, mark, at, n, tw):\r"},{"line":619,"text":"    \"\"\"Where on its contact the hand lies: the palm laid at a few places down and up the grip and forward and back,\r"},{"line":620,"text":"    each scored by the presses the style does not allow (the web through a pistol's tang), the palm's gap and the\r"},{"line":621,"text":"    arm's limits; the best place is kept.\"\"\"\r"},{"line":622,"text":"    q = RA.matrix_world.to_quaternion()\r"},{"line":623,"text":"    up, fwd = (q @ g((0.0, 0.0, 1.0))).normalized(), (q @ g((0.0, 1.0, 0.0))).normalized()\r"},{"line":624,"text":"    tree = L._tree()\r"},{"line":625,"text":"    L.snapshot(\"save\", \"contact_search\")\r"},{"line":626,"text":"    best = None\r"},{"line":627,"text":"    for dz in (0.0, -0.5, -1.0, -1.5, -2.0, 0.5):\r"},{"line":628,"text":"        for dy in (0.0, 0.5, -0.5, 1.0):\r"},{"line":629,"text":"            L.snapshot(\"load\", \"contact_search\")\r"},{"line":630,"text":"            p_ = at + (up * dz + fwd * dy) / 100.0\r"},{"line":631,"text":"            short = turn_search(side, p_, n, tw) if STYLE else lay_palm(side, p_, n, toward=tw)\r"},{"line":632,"text":"            settle(side)\r"},{"line":633,"text":"            pr = deepest_press(side, tree)\r"},{"line":634,"text":"            gap = L.grip(side, hold=False)[side].get(\"palm_gap_cm\")\r"},{"line":635,"text":"            gap = 3.0 if gap is None else gap\r"},{"line":636,"text":"            score = (pr[0] if pr else 0.0) * 4.0 + max(0.0, gap - 0.3) * 2.0 + arm_over(side) * 0.1 + 4.0 * short\r"},{"line":637,"text":"            if best is None or score < best[0] - 1e-6:\r"},{"line":638,"text":"                best = (score, p_, dz, dy)\r"},{"line":639,"text":"    L.snapshot(\"load\", \"contact_search\")\r"},{"line":640,"text":"    short = turn_search(side, best[1], n, tw) if STYLE else lay_palm(side, best[1], n, toward=tw)\r"},{"line":641,"text":"    report.setdefault(\"contact_place\", {})[\"%s:%s\" % (side, mark)] = {\"down_cm\": -best[2], \"forward_cm\": best[3], \"score\": round(best[0], 3)}\r"},{"line":642,"text":"    return short\r"}],"name":"contact_search","start_line":618,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:contact_search"}}
