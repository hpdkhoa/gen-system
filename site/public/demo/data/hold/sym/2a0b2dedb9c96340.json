{"flow":{"blocks":[{"id":0,"label":"entry","lines":[{"kind":"call","line":223,"text":"w = math.sqrt(max(0.0, 1.0 + m[0, 0] + m[1, 1] + m[2, 2])) / 2.0"},{"kind":"call","line":227,"text":"pitch = math.degrees(math.asin(max(-1.0, min(1.0, 2 * (z * x - w * y)))))"},{"kind":"call","line":228,"text":"yaw = math.degrees(math.atan2(2 * (w * z + x * y), 1 - 2 * (y * y + z * z)))"},{"kind":"call","line":229,"text":"roll = math.degrees(math.atan2(-2 * (w * x + y * z), 1 - 2 * (x * x + y * y)))"},{"kind":"call","line":230,"text":"return [round(pitch, 3), round(yaw, 3), round(roll, 3)]"}],"preds":null,"stmts":["call math.sqrt","call max","call math.degrees","call math.asin","call max","call min","call math.degrees","call math.atan2","call math.degrees","call math.atan2","call round","call round","call round","return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[0],"func_id":"hold-code/weaponlab/rig.py#func:rotator","issues":null},"source":{"end_line":230,"file":"hold-code/weaponlab/rig.py","kind":"func","language":"python","lines":[{"line":221,"text":"def rotator(m):\r"},{"line":222,"text":"    \"\"\"A rotation matrix as Unreal's FRotator [pitch, yaw, roll] (FQuat's own conversion).\"\"\"\r"},{"line":223,"text":"    w = math.sqrt(max(0.0, 1.0 + m[0, 0] + m[1, 1] + m[2, 2])) / 2.0\r"},{"line":224,"text":"    x = (m[2, 1] - m[1, 2]) / (4 * w)\r"},{"line":225,"text":"    y = (m[0, 2] - m[2, 0]) / (4 * w)\r"},{"line":226,"text":"    z = (m[1, 0] - m[0, 1]) / (4 * w)\r"},{"line":227,"text":"    pitch = math.degrees(math.asin(max(-1.0, min(1.0, 2 * (z * x - w * y)))))\r"},{"line":228,"text":"    yaw = math.degrees(math.atan2(2 * (w * z + x * y), 1 - 2 * (y * y + z * z)))\r"},{"line":229,"text":"    roll = math.degrees(math.atan2(-2 * (w * x + y * z), 1 - 2 * (x * x + y * y)))\r"},{"line":230,"text":"    return [round(pitch, 3), round(yaw, 3), round(roll, 3)]\r"}],"name":"rotator","start_line":221,"symbol_id":"hold-code/weaponlab/rig.py#func:rotator"}}
