 2][0])"}],"preds":[11],"stmts":["call hgt","call len"],"succs":[13]}],"effects":["unknown"],"entry":0,"exits":[13],"func_id":"hold-code/poselab_mcp/blender/holdlab.py#func:seed_hold","issues":null},"source":{"end_line":832,"file":"hold-code/poselab_mcp/blender/holdlab.py","kind":"func","language":"python","lines":[{"line":776,"text":"    def seed_hold(self, side, mark, palm_dir=None, roll_deg=0.0, along_cm=0.0, flip=False):\r"},{"line":777,"text":"        \"\"\"A first place for a hand on its mark, from the run's geometry alone: the hand turned so its palm faces\r"},{"line":778,"text":"        into the run from palm_dir (object frame; without one the run's own u), turned roll_deg about the run's\r"},{"line":779,"text":"        axis, and its knuckles' line (little finger to index) runs along the axis toward the inner end; then\r"},{"line":780,"text":"        moved so the palm's middle sits a palm's thickness off the surface, at the height where the web meets its\r"},{"line":781,"text":"        point (a grip's web under its overhang) or, with no web point, at the run's middle; along_cm further from\r"},{"line":782,"text":"        the inner end; flip: the knuckles' line the other way (the index toward the outer end). Returns where the\r"},{"line":783,"text":"        hand went.\"\"\"\r"},{"line":784,"text":"        run = self._object[\"parts\"][mark[\"part\"]][\"runs\"][mark.get(\"run\", 0)]\r"},{"line":785,"text":"        RW = self._run_world(run)\r"},{"line":786,"text":"        F = self._obj_frame(mark[\"part\"])\r"},{"line":787,"text":"        ax = RW[\"axis\"]\r"},{"line":788,"text":"        if (RW[\"inner\"] - RW[\"outer\"]).dot(ax) < 0:\r"},{"line":789,"text":"            ax = -ax\r"},{"line":790,"text":"        if flip:\r"},{"line":791,"text":"            ax = -ax                                  # the index toward the other end (a round handle has no top)\r"},{"line":792,"text":"        pd = (F.to_quaternion() @ Vector(palm_dir)).normalized() if palm_dir is not None else (F.to_quaternion() @ Vector(run[\"u\"])).normalized()\r"},{"line":793,"text":"        pd = (pd - ax * pd.dot(ax)).normalized()\r"},{"line":794,"text":"        pd = Quaternion(ax, math.radians(roll_deg)) @ pd\r"},{"line":795,"text":"        hn = self._n(\"hand\", side)\r"},{"line":796,"text":"        # the turn: the hand's palm facing and knuckle line onto -pd and ax\r"},{"line":797,"text":"        f0 = self._palm_facing(side)\r"},{"line":798,"text":"        a0 = (self._bw(self._n(\"finger\", side, \"index\", \"01\")).translation\r"},{"line":799,"text":"              - self._bw(self._n(\"finger\", side, \"pinky\", \"01\")).translation)      # the knuckles, little finger to index\r"},{"line":800,"text":"        a0 = (a0 - f0 * a0.dot(f0)).normalized()\r"},{"line":801,"text":"        cur = Matrix((f0, a0, f0.cross(a0))).transposed()\r"},{"line":802,"text":"        f1, a1 = -pd, ax\r"},{"line":803,"text":"        tgt = Matrix((f1, a1, f1.cross(a1))).transposed()\r"},{"line":804,"text":"        Rm = (tgt @ cur.transposed()).to_4x4()\r"},{"line":805,"text":"        H = self._bw(hn).copy()\r"},{"line":806,"text":"        pc = H.translation.lerp(self._bw(self._n(\"finger\", side, \"middle\", \"01\")).translation, 0.5)\r"},{"line":807,"text":"        M = Matrix.Translation(pc) @ Rm @ Matrix.Translation(-pc) @ H\r"},{"line":808,"text":"        self._put_hand(side, Matrix.LocRotScale(M.translation, M.to_quaternion(), self._unit()))\r"},{"line":809,"text":"        bpy.context.view_layer.update()\r"},{"line":810,"text":"        # the move: the palm's middle a palm's thickness off the surface on the palm's side, at its height\r"},{"line":811,"text":"        palm_r = (self._fitted_radii() or {}).get(\"palm\", 0.018)\r"},{"line":812,"text":"        secs = RW[\"sections\"]\r"},{"line":813,"text":"        web_t = None\r"},{"line":814,"text":"        if getattr(self, \"_part_P\", {}).get(mark[\"part\"]) is not None and palm_dir is not None:\r"},{"line":815,"text":"            wp, _past = self.web_point(mark, list(F.to_quaternion().inverted() @ pd))\r"},{"line":816,"text":"            web_t = F @ Vector(wp)\r"},{"line":817,"text":"        pc = self._bw(hn).translation.lerp(self._bw(self._n(\"finger\", side, \"middle\", \"01\")).translation, 0.5)\r"},{"line":818,"text":"        web = self._anchor(side, \"web\")\r"},{"line":819,"text":"        hgt = lambda q: (q - RW[\"inner\"]).dot(ax)         # noqa: E731  (height along the run, from its inner end)\r"},{"line":820,"text":"        if web_t is not None:\r"},{"line":821,"text":"            # the palm's middle as far below the web as it is now, the web just under its point\r"},{"line":822,"text":"            h_pc = hgt(web_t) - 0.004 - (hgt(web) - hgt(pc))\r"},{"line":823,"text":"        else:\r"},{"line":824,"text":"            h_pc = hgt(secs[len(secs) // 2][0])\r"},{"line":825,"text":"        h_pc -= along_cm / 100.0\r"},{"line":826,"text":"        at = min(secs, key=lambda s_: abs(hgt(s_[0]) - h_pc))\r"},{"line":827,"text":"        edge = max(at[1], key=lambda q: (q - at[0]).dot(pd))\r"},{"line":828,"text":"        goal = at[0] + pd * ((edge - at[0]).dot(pd) + palm_r) + ax * (h_pc - hgt(at[0]))\r"},{"line":829,"text":"        M = Matrix.Translation(goal - pc) @ self._bw(hn)\r"},{"line":830,"text":"        short = self._put_hand(side, Matrix.LocRotScale(M.translation, M.to_quaternion(), self._unit()))\r"},{"line":831,"text":"        bpy.context.view_layer.update()\r"},{"line":832,"text":"        return {\"short_cm\": round(short, 2), \"roll_deg\": roll_deg}\r"}],"name":"seed_hold","start_line":776,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#func:seed_hold"}}
