s over a half sphere (a line's two ways are one).\"\"\"\r"},{"line":132,"text":"    out = []\r"},{"line":133,"text":"    for el in np.arange(0.0, 90.0 + 1e-9, step_deg):\r"},{"line":134,"text":"        n = max(1, int(round(360.0 * math.cos(math.radians(el)) / step_deg)))\r"},{"line":135,"text":"        for k in range(n):\r"},{"line":136,"text":"            az = 360.0 * k / n\r"},{"line":137,"text":"            if el > 89.9 and k:\r"},{"line":138,"text":"                break\r"},{"line":139,"text":"            e, a = math.radians(el), math.radians(az)\r"},{"line":140,"text":"            out.append(np.array([math.cos(e) * math.cos(a), math.cos(e) * math.sin(a), math.sin(e)]))\r"},{"line":141,"text":"    return out\r"}],"name":"_dirs","start_line":130,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#func:_dirs"}}
