{"flow":{"kind":"var","name":"bp","noCFG":true,"reason":"bp is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":60,"file":"hold-code/weaponlab/blueprint/blender/blueprint_build.py","kind":"var","language":"python","lines":[{"line":20,"text":"bp = job[\"blueprint\"]\r"},{"line":21,"text":"OUT = job[\"out\"]\r"},{"line":22,"text":"SEG = int(job.get(\"segments\", 32))\r"},{"line":23,"text":"os.makedirs(OUT, exist_ok=True)\r"},{"line":24,"text":"for _o in list(bpy.data.objects):          # the factory scene's cube, camera and light are not the gun's\r"},{"line":25,"text":"    bpy.data.objects.remove(_o)\r"},{"line":26,"text":"\r"},{"line":27,"text":"FINISH = {\"blued\": ((0.05, 0.055, 0.065), 1.0, 0.35), \"parkerized\": ((0.11, 0.115, 0.11), 0.9, 0.7),\r"},{"line":28,"text":"          \"phosphate\": ((0.11, 0.115, 0.11), 0.9, 0.7), \"steel\": ((0.45, 0.45, 0.47), 1.0, 0.3),\r"},{"line":29,"text":"          \"stainless\": ((0.6, 0.6, 0.62), 1.0, 0.25), \"nickel\": ((0.65, 0.63, 0.6), 1.0, 0.2),\r"},{"line":30,"text":"          \"aluminium\": ((0.12, 0.12, 0.13), 0.8, 0.5), \"brass\": ((0.7, 0.55, 0.25), 1.0, 0.3),\r"},{"line":31,"text":"          \"walnut\": ((0.25, 0.12, 0.05), 0.0, 0.55), \"wood\": ((0.3, 0.17, 0.08), 0.0, 0.6),\r"},{"line":32,"text":"          \"plastic\": ((0.18, 0.09, 0.05), 0.0, 0.45), \"bakelite\": ((0.16, 0.08, 0.04), 0.0, 0.4),\r"},{"line":33,"text":"          \"polymer\": ((0.04, 0.04, 0.04), 0.0, 0.6), \"rubber\": ((0.03, 0.03, 0.03), 0.0, 0.85)}\r"},{"line":34,"text":"\r"},{"line":35,"text":"\r"},{"line":36,"text":"def g(x, y, z):\r"},{"line":37,"text":"    return Vector((x, -y, z)) / 100.0\r"},{"line":38,"text":"\r"},{"line":39,"text":"\r"},{"line":40,"text":"def material(finish):\r"},{"line":41,"text":"    name = \"M_\" + finish\r"},{"line":42,"text":"    if name in bpy.data.materials:\r"},{"line":43,"text":"        return bpy.data.materials[name]\r"},{"line":44,"text":"    key = next((k for k in FINISH if k in finish.lower()), \"steel\")\r"},{"line":45,"text":"    col, metal, rough = FINISH[key]\r"},{"line":46,"text":"    m = bpy.data.materials.new(name)\r"},{"line":47,"text":"    m.use_nodes = True\r"},{"line":48,"text":"    b = m.node_tree.nodes.get(\"Principled BSDF\")\r"},{"line":49,"text":"    b.inputs[\"Base Color\"].default_value = (*col, 1.0)\r"},{"line":50,"text":"    b.inputs[\"Metallic\"].default_value = metal\r"},{"line":51,"text":"    b.inputs[\"Roughness\"].default_value = rough\r"},{"line":52,"text":"    m.diffuse_color = (*col, 1.0)                 # the colour quick renders and the viewport show\r"},{"line":53,"text":"    m.metallic, m.roughness = metal, rough\r"},{"line":54,"text":"    m[\"finish\"] = finish\r"},{"line":55,"text":"    return m\r"},{"line":56,"text":"\r"},{"line":57,"text":"\r"},{"line":58,"text":"def ccw(outline):\r"},{"line":59,"text":"    s = sum(a[0] * b[1] - b[0] * a[1] for a, b in zip(outline, outline[1:] + outline[:1]))\r"},{"line":60,"text":"    return outline if s > 0 else list(reversed(outline))\r"}],"name":"bp","start_line":20,"symbol_id":"hold-code/weaponlab/blueprint/blender/blueprint_build.py#var:bp"}}
