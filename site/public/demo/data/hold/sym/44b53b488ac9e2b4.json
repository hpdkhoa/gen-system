{"flow":{"kind":"var","name":"CLAV","noCFG":true,"reason":"CLAV is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":1614,"file":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py","kind":"var","language":"python","lines":[{"line":1574,"text":"CLAV = {}                    # the clavicles' turns in the hold: each frame starts from them\r"},{"line":1575,"text":"ARM_HOLD = {}                # the arm bones' turns in the hold\r"},{"line":1576,"text":"\r"},{"line":1577,"text":"\r"},{"line":1578,"text":"def arm_from_hold(side):\r"},{"line":1579,"text":"    names = [L._n(\"upperarm\", side), L._n(\"lowerarm\", side), L._n(\"hand\", side)] + [n for _, n in L._twist_bones(side)]\r"},{"line":1580,"text":"    if side not in ARM_HOLD:\r"},{"line":1581,"text":"        ARM_HOLD[side] = {n: L.arm.pose.bones[n].rotation_quaternion.copy() for n in names}\r"},{"line":1582,"text":"    for n, q in ARM_HOLD[side].items():\r"},{"line":1583,"text":"        L.arm.pose.bones[n].rotation_quaternion = q\r"},{"line":1584,"text":"    bpy.context.view_layer.update()\r"},{"line":1585,"text":"\r"},{"line":1586,"text":"\r"},{"line":1587,"text":"def elbow_bend(side):\r"},{"line":1588,"text":"    return L._arm_report(side, L._limits()[0])[0].get(\"elbow_bend_deg\", 90.0)\r"},{"line":1589,"text":"\r"},{"line":1590,"text":"\r"},{"line":1591,"text":"def shoulder_reach(side, H):\r"},{"line":1592,"text":"    \"\"\"An arm at full stretch reaches with the shoulder too, as a shooter's does: the clavicle turned toward the hand,\r"},{"line":1593,"text":"    2 degrees at a time up to 16 (about 4 cm at the shoulder), until the elbow keeps 5 degrees past its locked limit.\r"},{"line":1594,"text":"    Each frame starts from the hold's clavicle, so a reach lasts only while the arm needs it. Returns the degrees.\"\"\"\r"},{"line":1595,"text":"    cn = \"clavicle_\" + side\r"},{"line":1596,"text":"    if cn not in L.arm.pose.bones:\r"},{"line":1597,"text":"        return 0.0\r"},{"line":1598,"text":"    pb = L.arm.pose.bones[cn]\r"},{"line":1599,"text":"    if side not in CLAV:\r"},{"line":1600,"text":"        CLAV[side] = pb.rotation_quaternion.copy()\r"},{"line":1601,"text":"    if pb.rotation_quaternion != CLAV[side]:\r"},{"line":1602,"text":"        pb.rotation_quaternion = CLAV[side]\r"},{"line":1603,"text":"        bpy.context.view_layer.update()\r"},{"line":1604,"text":"        L._put_hand(side, H)\r"},{"line":1605,"text":"    need = L._limits()[0][\"elbow_bend_min_deg\"] + 5.0\r"},{"line":1606,"text":"    if elbow_bend(side) >= need:\r"},{"line":1607,"text":"        return 0.0\r"},{"line":1608,"text":"    C = L._bw(cn).translation\r"},{"line":1609,"text":"    S = L._bw(L._n(\"upperarm\", side)).translation\r"},{"line":1610,"text":"    axis = (S - C).cross(H.translation - C)\r"},{"line":1611,"text":"    if axis.length < 1e-9:\r"},{"line":1612,"text":"        return 0.0\r"},{"line":1613,"text":"    axis.normalize()\r"},{"line":1614,"text":"    deg = 0.0\r"}],"name":"CLAV","start_line":1574,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#var:CLAV"}}
