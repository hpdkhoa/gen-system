, 02, 03).\"\"\"\r"},{"line":640,"text":"        c = getattr(self, \"_skin_st\", None)\r"},{"line":641,"text":"        if c is not None:\r"},{"line":642,"text":"            return c\r"},{"line":643,"text":"        ob = self.meshes[0]\r"},{"line":644,"text":"        names = {g.index: g.name for g in ob.vertex_groups}\r"},{"line":645,"text":"        bone = []\r"},{"line":646,"text":"        for v0 in ob.data.vertices:\r"},{"line":647,"text":"            gm = max(v0.groups, key=lambda x: x.weight) if v0.groups else None\r"},{"line":648,"text":"            bone.append(names.get(gm.group, \"\") if gm else \"\")\r"},{"line":649,"text":"        tris = []\r"},{"line":650,"text":"        for p_ in ob.data.polygons:\r"},{"line":651,"text":"            vs = list(p_.vertices)\r"},{"line":652,"text":"            for k in range(1, len(vs) - 1):\r"},{"line":653,"text":"                tris.append((vs[0], vs[k], vs[k + 1]))\r"},{"line":654,"text":"        n = len(bone)\r"},{"line":655,"text":"        side = np.zeros(n, dtype=np.int8)\r"},{"line":656,"text":"        kind = np.zeros(n, dtype=np.int8)\r"},{"line":657,"text":"        segi = np.full(n, -1, dtype=np.int16)\r"},{"line":658,"text":"        for i, b in enumerate(bone):\r"},{"line":659,"text":"            if b.endswith(\"_r\"):\r"},{"line":660,"text":"                side[i] = 1\r"},{"line":661,"text":"            elif b.endswith(\"_l\"):\r"},{"line":662,"text":"                side[i] = 2\r"},{"line":663,"text":"            else:\r"},{"line":664,"text":"                continue\r"},{"line":665,"text":"            base = b[:-2]\r"},{"line":666,"text":"            if base.startswith((\"lowerarm\", \"forearm\")) or \"twist\" in base:\r"},{"line":667,"text":"                kind[i] = 1\r"},{"line":668,"text":"            elif base.startswith((\"upperarm\", \"clavicle\")):\r"},{"line":669,"text":"                kind[i] = 0\r"},{"line":670,"text":"            else:\r"},{"line":671,"text":"                fi = next((x for x in DIGITS if base.startswith(x)), None)\r"},{"line":672,"text":"                if fi and \"metacarpal\" not in base:\r"},{"line":673,"text":"                    j = base.split(\"_\")[1] if \"_\" in base else \"01\"\r"},{"line":674,"text":"                    kind[i] = 3\r"},{"line":675,"text":"                    segi[i] = DIGITS.index(fi) * 3 + max(0, min(2, int(j[-1]) - 1))\r"},{"line":676,"text":"                else:\r"},{"line":677,"text":"                    kind[i] = 2\r"},{"line":678,"text":"        self._skin_st = (bone, np.array(tris, dtype=np.int64), side, kind, segi)\r"},{"line":679,"text":"        return self._skin_st\r"}],"name":"_skin_static","start_line":636,"symbol_id":"hold-code/poselab_mcp/blender/contactlab.py#method:ContactMixin._skin_static"}}
