          \"bones\": bones, \"parts\": parts, \"marks\": {k: list(v) for k, v in partsmap[\"marks\"].items()},\r"},{"line":51,"text":"             \"mark_parts\": dict(partsmap.get(\"mark_parts\", {})), \"normals\": dict(partsmap.get(\"normals\", {})),\r"},{"line":52,"text":"             \"magazine\": (dict({\"bone\": parts[free][\"bone\"], \"lips\": list(partsmap[\"magazine\"][\"lips\"])},\r"},{"line":53,"text":"                               **{k: partsmap[\"magazine\"][k] for k in (\"axis\", \"length_cm\") if k in partsmap[\"magazine\"]})\r"},{"line":54,"text":"                          if free and (partsmap.get(\"magazine\") or {}).get(\"lips\") else None),\r"},{"line":55,"text":"             \"proxy\": bool(partsmap.get(\"proxy\")),\r"},{"line":56,"text":"             \"sources\": list(partsmap.get(\"sources\", []))}\r"},{"line":57,"text":"    if facts[\"magazine\"] is None:\r"},{"line":58,"text":"        facts.pop(\"magazine\")\r"},{"line":59,"text":"    return facts\r"}],"name":"plan","start_line":18,"symbol_id":"hold-code/weaponlab/gunkit/rigplan.py#func:plan"}}
