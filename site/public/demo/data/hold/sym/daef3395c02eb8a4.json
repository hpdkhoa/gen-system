{"flow":{"kind":"var","name":"running","noCFG":true,"reason":"running is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":55,"file":"hold-code/poselab_mcp/blender/worker.py","kind":"var","language":"python","lines":[{"line":26,"text":"running = True\r"},{"line":27,"text":"while running:\r"},{"line":28,"text":"    conn, _ = srv.accept()\r"},{"line":29,"text":"    f = conn.makefile(\"rwb\")\r"},{"line":30,"text":"    for line in f:\r"},{"line":31,"text":"        try:\r"},{"line":32,"text":"            req = json.loads(line)\r"},{"line":33,"text":"        except ValueError:\r"},{"line":34,"text":"            continue\r"},{"line":35,"text":"        if not hmac.compare_digest(str(req.get(\"token\", \"\")), token):\r"},{"line":36,"text":"            f.write(b'{\"ok\": false, \"error\": \"bad token\"}\\n')\r"},{"line":37,"text":"            f.flush()\r"},{"line":38,"text":"            continue\r"},{"line":39,"text":"        cmd = req.get(\"cmd\", \"\")\r"},{"line":40,"text":"        if cmd == \"quit\":\r"},{"line":41,"text":"            f.write(b'{\"ok\": true, \"result\": \"bye\"}\\n')\r"},{"line":42,"text":"            f.flush()\r"},{"line":43,"text":"            running = False\r"},{"line":44,"text":"            break\r"},{"line":45,"text":"        try:\r"},{"line":46,"text":"            if cmd not in lab.PUBLIC:\r"},{"line":47,"text":"                raise ValueError(\"no command %r\" % cmd)\r"},{"line":48,"text":"            out = {\"ok\": True, \"result\": getattr(L, cmd)(**req.get(\"args\", {}))}\r"},{"line":49,"text":"        except Exception as e:\r"},{"line":50,"text":"            out = {\"ok\": False, \"error\": \"%s: %s\" % (type(e).__name__, e), \"trace\": traceback.format_exc()[-1500:]}\r"},{"line":51,"text":"        f.write((json.dumps(out) + \"\\n\").encode())\r"},{"line":52,"text":"        f.flush()\r"},{"line":53,"text":"    conn.close()\r"},{"line":54,"text":"srv.close()\r"},{"line":55,"text":""}],"name":"running","start_line":26,"symbol_id":"hold-code/poselab_mcp/blender/worker.py#var:running"}}
