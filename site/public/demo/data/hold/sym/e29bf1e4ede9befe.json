{"flow":{"kind":"var","name":"objects","noCFG":true,"reason":"objects is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":100,"file":"hold-code/weaponlab/gunkit/blender/gunkit_rig.py","kind":"var","language":"python","lines":[{"line":60,"text":"objects = {}\r"},{"line":61,"text":"if job.get(\"shapes\"):\r"},{"line":62,"text":"    for s in job[\"shapes\"]:\r"},{"line":63,"text":"        if s[\"shape\"] == \"box\":\r"},{"line":64,"text":"            bpy.ops.mesh.primitive_cube_add(size=1.0)\r"},{"line":65,"text":"            ob = bpy.context.object\r"},{"line":66,"text":"            ob.scale = (s[\"size\"][0] / 100.0, s[\"size\"][1] / 100.0, s[\"size\"][2] / 100.0)\r"},{"line":67,"text":"        else:\r"},{"line":68,"text":"            bpy.ops.mesh.primitive_cylinder_add(vertices=16, radius=0.5, depth=1.0)\r"},{"line":69,"text":"            ob = bpy.context.object\r"},{"line":70,"text":"            d, length = s[\"size\"]\r"},{"line":71,"text":"            along = s.get(\"along\", \"y\")\r"},{"line":72,"text":"            if along == \"y\":\r"},{"line":73,"text":"                ob.rotation_euler = (math.radians(90), 0, 0)\r"},{"line":74,"text":"                ob.scale = (d / 100.0, d / 100.0, length / 100.0)\r"},{"line":75,"text":"            elif along == \"x\":\r"},{"line":76,"text":"                ob.rotation_euler = (0, math.radians(90), 0)\r"},{"line":77,"text":"                ob.scale = (d / 100.0, d / 100.0, length / 100.0)\r"},{"line":78,"text":"            else:\r"},{"line":79,"text":"                ob.scale = (d / 100.0, d / 100.0, length / 100.0)\r"},{"line":80,"text":"        ob.location = g(*s[\"at\"])\r"},{"line":81,"text":"        ob.name = s[\"name\"]\r"},{"line":82,"text":"        ob.data.materials.append(material(s.get(\"part\")))\r"},{"line":83,"text":"        bpy.context.view_layer.update()\r"},{"line":84,"text":"        ob.data.transform(ob.matrix_world)\r"},{"line":85,"text":"        ob.matrix_world = Matrix.Identity(4)\r"},{"line":86,"text":"        objects[s[\"name\"]] = ob\r"},{"line":87,"text":"else:\r"},{"line":88,"text":"    path = pm[\"model\"]\r"},{"line":89,"text":"    ext = os.path.splitext(path)[1].lower()\r"},{"line":90,"text":"    before = set(bpy.data.objects)\r"},{"line":91,"text":"    if ext == \".blend\":\r"},{"line":92,"text":"        with bpy.data.libraries.load(path, link=False) as (src, dst):\r"},{"line":93,"text":"            dst.objects = [n for n in src.objects]\r"},{"line":94,"text":"        for ob in dst.objects:\r"},{"line":95,"text":"            if ob is not None:\r"},{"line":96,"text":"                bpy.context.scene.collection.objects.link(ob)\r"},{"line":97,"text":"    elif ext == \".fbx\":\r"},{"line":98,"text":"        bpy.ops.import_scene.fbx(filepath=path)\r"},{"line":99,"text":"    elif ext == \".obj\":\r"},{"line":100,"text":"        bpy.ops.wm.obj_import(filepath=path)\r"}],"name":"objects","start_line":60,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_rig.py#var:objects"}}
