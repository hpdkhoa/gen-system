{"flow":{"kind":"var","name":"_DIRS","noCFG":true,"reason":"_DIRS is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":686,"file":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py","kind":"var","language":"python","lines":[{"line":646,"text":"_DIRS = {\"left\": (1, 0, 0), \"right\": (-1, 0, 0), \"front\": (0, 1, 0), \"back\": (0, -1, 0), \"up\": (0, 0, 1), \"down\": (0, 0, -1)}\r"},{"line":647,"text":"\r"},{"line":648,"text":"\r"},{"line":649,"text":"def _facing_vec(f):\r"},{"line":650,"text":"    if isinstance(f, list):\r"},{"line":651,"text":"        return Vector(f).normalized()\r"},{"line":652,"text":"    handed = (CHAR or {}).get(\"handed\", \"right\")\r"},{"line":653,"text":"    if f == \"support_side\":\r"},{"line":654,"text":"        f = \"left\" if handed == \"right\" else \"right\"\r"},{"line":655,"text":"    elif f == \"firing_side\":\r"},{"line":656,"text":"        f = \"right\" if handed == \"right\" else \"left\"\r"},{"line":657,"text":"    return None if f == \"any\" else Vector(_DIRS[f])\r"},{"line":658,"text":"\r"},{"line":659,"text":"\r"},{"line":660,"text":"def _gun_polys():\r"},{"line":661,"text":"    \"\"\"Each polygon of the gun's mesh at rest in the facts' gun frame (cm): its centre, its normal and the bone that\r"},{"line":662,"text":"    carries it (its vertices' heaviest group).\"\"\"\r"},{"line":663,"text":"    me = L.rifle_mesh\r"},{"line":664,"text":"    Ri = RA.matrix_world.inverted() @ me.matrix_world\r"},{"line":665,"text":"    Rq = Ri.to_quaternion()\r"},{"line":666,"text":"    names = {g.index: g.name for g in me.vertex_groups}\r"},{"line":667,"text":"    vb = []\r"},{"line":668,"text":"    for v in me.data.vertices:\r"},{"line":669,"text":"        gm = max(v.groups, key=lambda x: x.weight) if v.groups else None\r"},{"line":670,"text":"        vb.append(names.get(gm.group, \"Root\") if gm else \"Root\")\r"},{"line":671,"text":"    out = []\r"},{"line":672,"text":"    for p in me.data.polygons:\r"},{"line":673,"text":"        c_ = Ri @ p.center\r"},{"line":674,"text":"        n_ = Rq @ p.normal\r"},{"line":675,"text":"        bones = [vb[i] for i in p.vertices]\r"},{"line":676,"text":"        out.append((Vector((c_.x * 100, -c_.y * 100, c_.z * 100)), Vector((n_.x, -n_.y, n_.z)).normalized(),\r"},{"line":677,"text":"                    max(set(bones), key=bones.count)))\r"},{"line":678,"text":"    return out\r"},{"line":679,"text":"\r"},{"line":680,"text":"\r"},{"line":681,"text":"_GP = []\r"},{"line":682,"text":"\r"},{"line":683,"text":"\r"},{"line":684,"text":"def _bound(b, axis, part_ext):\r"},{"line":685,"text":"    if isinstance(b, (int, float)):\r"},{"line":686,"text":"        return float(b)\r"}],"name":"_DIRS","start_line":646,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#var:_DIRS"}}
