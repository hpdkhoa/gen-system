  extended index and the thumb turned onto their lines by a fixed step pattern; the best round is kept, the\r"},{"line":1247,"text":"        rounds stop when the hold passes its gate or stops getting better. Returns the score's parts, the rounds\r"},{"line":1248,"text":"        and what is still unmet, each with its reason.\"\"\"\r"},{"line":1249,"text":"        import time as _time\r"},{"line":1250,"text":"        t0 = _time.time()\r"},{"line":1251,"text":"        m = next(x for x in marks if x.get(\"role\") == \"hold\" and x.get(\"hand\", side) == side)\r"},{"line":1252,"text":"        FL = self._limits()[1]\r"},{"line":1253,"text":"        wrap = wrap or {fi: \"wrap\" for fi in (\"index\", \"middle\", \"ring\", \"pinky\")}\r"},{"line":1254,"text":"        closing = tuple(fi for fi, how in wrap.items() if how == \"wrap\" and fi != \"thumb\")\r"},{"line":1255,"text":"        best, log = None, []\r"},{"line":1256,"text":"        self.snapshot(\"save\", \"_th_best\")\r"},{"line":1257,"text":"        for rd in range(rounds):\r"},{"line":1258,"text":"            self.snapshot(\"save\", \"_th_round\")\r"},{"line":1259,"text":"            w_round = self.wall_faults(side, other)\r"},{"line":1260,"text":"            pairs = self._place_targets(side, m)\r"},{"line":1261,"text":"            if pairs:\r"},{"line":1262,"text":"                # the hand goes onto its targets as far as the arm takes it: the whole move, else three quarters,\r"},{"line":1263,"text":"                # a half, a quarter (an arm no further past its limits than it was); else it stays\r"},{"line":1264,"text":"                # the fingers open first (a hand moving onto a hold comes open), inside the walls\r"},{"line":1265,"text":"                self._walled(side, other, lambda: [self._set_curl(side, fi, j, 0.0, FL) for fi in closing for j in (\"01\", \"02\", \"03\")])\r"},{"line":1266,"text":"                w_fit = self.wall_faults(side, other)\r"},{"line":1267,"text":"                self.snapshot(\"save\", \"_th_fit\")\r"},{"line":1268,"text":"                took = 0.0\r"},{"line":1269,"text":"                for share in (1.0, 0.75, 0.5, 0.25):\r"},{"line":1270,"text":"                    self.snapshot(\"load\", \"_th_fit\")\r"},{"line":1271,"text":"                    self._fit_hand(side, pairs, share)\r"},{"line":1272,"text":"                    self.settle_palm(side)\r"},{"line":1273,"text":"                    if not self._walls_hold(self.wall_faults(side, other), w_fit):\r"},{"line":1274,"text":"                        # the body helps first (the elbow, then the girdle), the hand kept on its targets\r"},{"line":1275,"text":"                        self._body_eases(side, self._bw(self._n(\"hand\", side)).copy())\r"},{"line":1276,"text":"                    if self._walls_hold(self.wall_faults(side, other), w_fit):\r"},{"line":1277,"text":"                        took = share\r"},{"line":1278,"text":"                        break\r"},{"line":1279,"text":"                if os.environ.get(\"POSELAB_DEBUG\"):\r"},{"line":1280,"text":"                    print(\"DBG fit\", side, rd, \"share\", took)\r"},{"line":1281,"text":"                if took == 0.0:\r"},{"line":1282,"text":"                    self.snapshot(\"load\", \"_th_fit\")\r"},{"line":1283,"text":"                    log.append({\"round\": rd, \"fit\": \"refused: every share broke a wall\"})\r"},{"line":1284,"text":"                elif took < 1.0:\r"},{"line":1285,"text":"                    log.append({\"round\": rd, \"fit\": \"share %.2f, as far as the arm takes it\" % took})\r"},{"line":1286,"text":"            W = lambda f: self._walled(side, other, f)           # noqa: E731  every step inside the walls\r"},{"line":1287,"text":"            W(lambda: self.settle_palm(side))\r"},{"line":1288,"text":"            keep = self._bw(self._n(\"hand\", side)).copy()\r"},{"line":1289,"text":"            W(lambda: self._body_eases(side, keep))\r"},{"line":1290,"text":"            for fi, how in wrap.items():\r"},{"line":1291,"text":"                if how == \"straight\" and fi != \"thumb\" and rd == 0:\r"},{"line":1292,"text":"                    W(lambda fi=fi: [self._set_curl(side, fi, j, cc, FL) for j, cc in zip((\"01\", \"02\", \"03\"), (0.0, 0.0, 3.0))])\r"},{"line":1293,"text":"            W(lambda: self.conform_digits(side, closing, other=other))\r"},{"line":1294,"text":"            self._fit_pads(side, closing, other)\r"},{"line":1295,"text":"            if m.get(\"index\") == \"extended\" and wrap.get(\"index\") == \"straight\":\r"},{"line":1296,"text":"                self._fit_index(side, m, glove_cm, other)\r"},{"line":1297,"text":"            if m.get(\"thumb\") == \"inline\":\r"},{"line":1298,"text":"                o_ = \"r\" if side == \"l\" else \"l\"\r"},{"line":1299,"text":"                self._fit_thumb(side, m, glove_cm, along=self._thumb_dir(o_) if m[\"purpose\"] == \"support\" else None, other=other)\r"},{"line":1300,"text":"            elif m.get(\"thumb\") in (\"wrap\", \"opposed\"):\r"},{"line":1301,"text":"                W(lambda: self._set_thumb_bend(side, 6.0, 4.0, self._thumb_limits()))\r"},{"line":1302,"text":"                W(lambda: self.conform_digits(side, (\"thumb\",), other=other))\r"},{"line":1303,"text":"                self._fit_thumb(side, m, glove_cm, inline=False, other=other)\r"},{"line":1304,"text":"            W(lambda: self.relax_fingers(side, tuple(fi for fi in (\"index\", \"middle\", \"ring\", \"pinky\", \"thumb\"))))\r"},{"line":1305,"text":"            w_end = self.wall_faults(side, other)\r"},{"line":1306,"text":"            if not self._walls_hold(w_end, w_round):\r"},{"line":1307,"text":"                # the round as a whole may not leave the hand past a wall it started inside (nor further past one)\r"},{"line":1308,"text":"                self.snapshot(\"load\", \"_th_round\")\r"},{"line":1309,"text":"                log.append({\"round\": rd, \"refused\": \"the round broke walls: %s\" % sorted(set(w_end) - set(w_round))})\r"},{"line":1310,"text":"                w_end = w_round\r"},{"line":1311,"text":"            sc, why = self._hold_score(side, marks, glove_cm, other, None, self._tree())\r"},{"line":1312,"text":"            g = self.hold_gate(marks, sides=(side,), glove_cm=glove_cm, skin=False, other=other)\r"},{"line":1313,"text":"            ok = bool(g.get(side, {}).get(\"pass\")) and not w_end\r"},{"line":1314,"text":"            prev = [x[\"score\"] for x in log if \"score\" in x]\r"},{"line":1315,"text":"            log.append({\"round\": rd, \"score\": round(sc, 2), \"gate\": ok, \"walls\": len(w_end)})\r"},{"line":1316,"text":"            # holds compared in a fixed order: the walls first (fewer broken, less past), then the gate, then the score\r"},{"line":1317,"text":"            rank = (self._walls_rank(w_end), not ok, sc)\r"},{"line":1318,"text":"            if best is None or rank < best[3]:\r"},{"line":1319,"text":"                best = (sc, why, ok, rank, w_end)\r"},{"line":1320,"text":"                self.snapshot(\"save\", \"_th_best\")\r"},{"line":1321,"text":"            if ok or (prev and sc >= prev[-1] - 0.5):\r"},{"line":1322,"text":"                break\r"},{"line":1323,"text":"        self.snapshot(\"load\", \"_th_best\")\r"},{"line":1324,"text":"        if polish and not best[2]:\r"},{"line":1325,"text":"            self._polish(side, marks, glove_cm, other, tuple(fi for fi in (\"index\", \"middle\", \"ring\", \"pinky\")\r"},{"line":1326,"text":"                                                              if wrap.get(fi) == \"wrap\"))\r"},{"line":1327,"text":"            w_p = self.wall_faults(side, other)\r"},{"line":1328,"text":"            sc, why = self._hold_score(side, marks, glove_cm, other, None, self._tree())\r"},{"line":1329,"text":"            g = self.hold_gate(marks, sides=(side,), glove_cm=glove_cm, skin=False, other=other)\r"},{"line":1330,"text":"            ok = bool(g.get(side, {}).get(\"pass\")) and not w_p\r"},{"line":1331,"text":"            log.append({\"round\": \"polish\", \"score\": round(sc, 2), \"gate\": ok, \"walls\": len(w_p)})\r"},{"line":1332,"text":"            rank = (self._walls_rank(w_p), not ok, sc)\r"},{"line":1333,"text":"            if rank < best[3]:\r"},{"line":1334,"text":"                best = (sc, why, ok, rank, w_p)\r"},{"line":1335,"text":"                self.snapshot(\"save\", \"_th_best\")\r"},{"line":1336,"text":"            self.snapshot(\"load\", \"_th_best\")\r"},{"line":1337,"text":"        sc, why, ok, _rank, walls = best\r"},{"line":1338,"text":"        unmet = [{\"purpose\": r[\"purpose\"], \"why\": {k: v for k, v in r.items() if k not in (\"purpose\", \"met\", \"error\", \"hard\", \"why\")}}\r"},{"line":1339,"text":"                 for r in why[\"purposes\"] if not r[\"met\"]]\r"},{"line":1340,"text":"        out = {\"score\": round(sc, 2), \"gate\": ok, \"rounds\": log, \"unmet\": unmet, \"solve_s\": round(_time.time() - t0, 1),\r"},{"line":1341,"text":"               \"walls\": {k: round(v, 2) for k, v in walls.items()}, **why}\r"},{"line":1342,"text":"        if walls:\r"},{"line":1343,"text":"            # no hold inside the walls from this start: said plainly, never handed out as a hold\r"},{"line":1344,"text":"            out[\"result\"] = \"no hold inside the walls from this start\"\r"},{"line":1345,"text":"            out[\"gate\"] = False\r"},{"line":1346,"text":"        return out\r"}],"name":"target_hold","start_line":1242,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#method:HoldMixin.target_hold"}}
