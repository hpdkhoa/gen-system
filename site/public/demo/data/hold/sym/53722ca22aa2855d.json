30],"stmts":null,"succs":[33,34]},{"id":33,"label":"then","preds":[32],"stmts":null,"succs":[34]},{"id":34,"label":"merge","preds":[33,32],"stmts":null,"succs":[29]}],"effects":["unknown"],"entry":0,"exits":[3],"func_id":"hold-code/poselab_mcp/blender/lab.py#func:_hand_contacts","issues":null},"source":{"end_line":862,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"func","language":"python","lines":[{"line":827,"text":"    def _hand_contacts(self, s, tree):\r"},{"line":828,"text":"        \"\"\"The hand's contacts with the rifle: (closest gap cm, deepest palm-side cm and segment, deepest back-side cm,\r"},{"line":829,"text":"        segment and rifle point). The thumb's pad faces sideways, not the way the fingers curl, so its contacts count\r"},{"line":830,"text":"        only toward the palm side's depth.\"\"\"\r"},{"line":831,"text":"        across, k = self._hand_frame(s)\r"},{"line":832,"text":"        palm_cm = back_cm = 0.0\r"},{"line":833,"text":"        near, palm_seg, back_seg, back_pt = None, None, None, None\r"},{"line":834,"text":"        for name, a, b, r in self._segments(s):\r"},{"line":835,"text":"            if name.startswith(\"forearm\"):\r"},{"line":836,"text":"                continue\r"},{"line":837,"text":"            d = b - a\r"},{"line":838,"text":"            if d.length < 1e-9:\r"},{"line":839,"text":"                continue\r"},{"line":840,"text":"            dn = d.normalized()\r"},{"line":841,"text":"            palmar = across.cross(dn) * k\r"},{"line":842,"text":"            thumb = name.startswith(\"thumb\")\r"},{"line":843,"text":"            n = max(2, int(d.length / 0.003))\r"},{"line":844,"text":"            for i in range(n + 1):\r"},{"line":845,"text":"                p = a.lerp(b, i / n)\r"},{"line":846,"text":"                q, dq = tree.nearest(p)\r"},{"line":847,"text":"                if q is None:\r"},{"line":848,"text":"                    continue\r"},{"line":849,"text":"                gap = (dq - r) * 100.0\r"},{"line":850,"text":"                near = gap if near is None else min(near, gap)\r"},{"line":851,"text":"                if dq < r:\r"},{"line":852,"text":"                    depth = (r - dq) * 100.0\r"},{"line":853,"text":"                    # the side the rifle is on: toward its surface point from outside, away from it from inside\r"},{"line":854,"text":"                    off = (q - p) if dq >= 0.0 else (p - q)\r"},{"line":855,"text":"                    off = off - dn * off.dot(dn)\r"},{"line":856,"text":"                    back = (not thumb and palmar.length > 1e-6 and off.length > 1e-9\r"},{"line":857,"text":"                            and off.normalized().dot(palmar.normalized()) < -0.25)\r"},{"line":858,"text":"                    if back and depth > back_cm:\r"},{"line":859,"text":"                        back_cm, back_seg, back_pt = depth, name, q.copy()\r"},{"line":860,"text":"                    elif not back and depth > palm_cm:      # the palm side, a finger's edge, or the thumb\r"},{"line":861,"text":"                        palm_cm, palm_seg = depth, name\r"},{"line":862,"text":"        return near, palm_cm, palm_seg, back_cm, back_seg, back_pt\r"}],"name":"_hand_contacts","start_line":827,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:_hand_contacts"}}
