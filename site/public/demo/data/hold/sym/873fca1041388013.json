 None:\r"},{"line":1523,"text":"        return Matrix.LocRotScale(RA.matrix_world @ g(tgt[\"point\"]), current.to_quaternion(), current.to_scale()), None\r"},{"line":1524,"text":"    rel, fingers, _ = grasp(side, mark)\r"},{"line":1525,"text":"    # the mark's frame: its bone as posed, or the gun at rest for a free part's mark (its place is the timeline's)\r"},{"line":1526,"text":"    B = RA.matrix_world if free_mark(mark) else bone_world(mark_bone(mark))\r"},{"line":1527,"text":"    H = B @ rel\r"},{"line":1528,"text":"    # the target moved off the mark (an offset, a free part out of its seat): the same hold moved with it\r"},{"line":1529,"text":"    d = (RA.matrix_world @ g(tgt[\"point\"])) - (B @ g(facts[\"marks\"][mark]))\r"},{"line":1530,"text":"    return Matrix.Translation(d) @ H, fingers\r"}],"name":"target_matrix","start_line":1512,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:target_matrix"}}
