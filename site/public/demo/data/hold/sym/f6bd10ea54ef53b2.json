s":[10]},{"id":12,"label":"then","preds":[10],"stmts":null,"succs":[13]},{"id":13,"label":"merge","preds":[12,10],"stmts":null,"succs":[6]}],"effects":["unknown"],"entry":0,"exits":[1,5],"func_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._wrap","issues":null},"source":{"end_line":1784,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"method","language":"python","lines":[{"line":1763,"text":"    def _wrap(self, side_set, polys, glove_cm=0.0, within_cm=0.3):\r"},{"line":1764,"text":"        \"\"\"The share of a band of the gun's surface (polygons) the hands cover: each polygon's centre within\r"},{"line":1765,"text":"        within_cm of a hand's skin.\"\"\"\r"},{"line":1766,"text":"        dg = bpy.context.evaluated_depsgraph_get()\r"},{"line":1767,"text":"        ev = self.rifle_mesh.evaluated_get(dg)\r"},{"line":1768,"text":"        me = ev.to_mesh()\r"},{"line":1769,"text":"        M = self.rifle_mesh.matrix_world\r"},{"line":1770,"text":"        cs = [M @ me.polygons[i].center for i in polys if i < len(me.polygons)]\r"},{"line":1771,"text":"        ev.to_mesh_clear()\r"},{"line":1772,"text":"        if not cs:\r"},{"line":1773,"text":"            return 0.0\r"},{"line":1774,"text":"        segs = [x for s_ in side_set for x in self._segments(s_) if not x[0].startswith(\"forearm\")]\r"},{"line":1775,"text":"        g = glove_cm / 100.0\r"},{"line":1776,"text":"        hit = 0\r"},{"line":1777,"text":"        for c in cs:\r"},{"line":1778,"text":"            for _n, a, b, r in segs:\r"},{"line":1779,"text":"                ab = b - a\r"},{"line":1780,"text":"                t = 0.0 if ab.length_squared < 1e-12 else max(0.0, min(1.0, (c - a).dot(ab) / ab.length_squared))\r"},{"line":1781,"text":"                if ((a + ab * t) - c).length - r - g <= within_cm / 100.0:\r"},{"line":1782,"text":"                    hit += 1\r"},{"line":1783,"text":"                    break\r"},{"line":1784,"text":"        return hit / len(cs)\r"}],"name":"_wrap","start_line":1763,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._wrap"}}
