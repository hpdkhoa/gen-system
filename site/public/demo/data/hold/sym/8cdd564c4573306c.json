{"flow":{"kind":"var","name":"arm","noCFG":true,"reason":"arm is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":49,"file":"hold-code/weaponlab/gunkit/blender/gunkit_readback.py","kind":"var","language":"python","lines":[{"line":16,"text":"arm = next(o for o in bpy.context.scene.objects if o.type == 'ARMATURE')\r"},{"line":17,"text":"sc = bpy.context.scene\r"},{"line":18,"text":"\r"},{"line":19,"text":"\r"},{"line":20,"text":"def gun(v):\r"},{"line":21,"text":"    return [round(v.x * 100.0, 3), round(-v.y * 100.0, 3), round(v.z * 100.0, 3)]\r"},{"line":22,"text":"\r"},{"line":23,"text":"\r"},{"line":24,"text":"out = {}\r"},{"line":25,"text":"for clip, times in job[\"clips\"].items():\r"},{"line":26,"text":"    act = bpy.data.actions.get(clip)\r"},{"line":27,"text":"    if act is None:\r"},{"line":28,"text":"        continue\r"},{"line":29,"text":"    arm.animation_data.action = act\r"},{"line":30,"text":"    out[clip] = {}\r"},{"line":31,"text":"    for t in times:\r"},{"line":32,"text":"        f = int(round(t * sc.render.fps))\r"},{"line":33,"text":"        sc.frame_set(f)\r"},{"line":34,"text":"        bpy.context.view_layer.update()\r"},{"line":35,"text":"        frame = {}\r"},{"line":36,"text":"        for pb in arm.pose.bones:\r"},{"line":37,"text":"            m = arm.matrix_world @ pb.matrix\r"},{"line":38,"text":"            rest = arm.matrix_world @ pb.bone.matrix_local\r"},{"line":39,"text":"            pts = {}\r"},{"line":40,"text":"            for k, d in ((\"head\", Vector((0, 0, 0))), (\"x\", Vector((0.03, 0, 0))), (\"y\", Vector((0, -0.03, 0))), (\"z\", Vector((0, 0, 0.03)))):\r"},{"line":41,"text":"                # a point fixed to the bone: its rest place in the world, carried by the bone's pose\r"},{"line":42,"text":"                p_rest = rest.translation + d\r"},{"line":43,"text":"                p = m @ (rest.inverted() @ p_rest)\r"},{"line":44,"text":"                pts[k] = gun(p)\r"},{"line":45,"text":"            frame[pb.name] = pts\r"},{"line":46,"text":"        out[clip][str(t)] = frame\r"},{"line":47,"text":"json.dump(out, open(os.path.join(job[\"out\"], \"readback.json\"), \"w\", encoding=\"utf-8\"), indent=1)\r"},{"line":48,"text":"print(\"GUNKIT READBACK: %d clips\" % len(out))\r"},{"line":49,"text":""}],"name":"arm","start_line":16,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_readback.py#var:arm"}}
