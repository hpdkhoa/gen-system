{"flow":{"kind":"var","name":"HOLD_DIGIT_LIMITS","noCFG":true,"reason":"HOLD_DIGIT_LIMITS is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":97,"file":"hold-code/poselab_mcp/blender/contactlab.py","kind":"var","language":"python","lines":[{"line":57,"text":"HOLD_DIGIT_LIMITS = {\"01\": (-5.0, 20.0), \"02\": (0.0, 8.0), \"03\": (-5.0, 10.0),\r"},{"line":58,"text":"                     \"thumb_02\": (-5.0, 15.0), \"thumb_03\": (-15.0, 15.0)}\r"},{"line":59,"text":"# clipping: no skin past its tissue's give inside the object, no object inside the flesh past it, no hand inside the\r"},{"line":60,"text":"# other past the skin's give; a hair of sampling noise allowed (cm2), nothing deeper\r"},{"line":61,"text":"CLIP_NOISE_CM2 = 0.05\r"},{"line":62,"text":"PULL_W = 0.3                   # the pull's weight: a cm off its region costs 0.3 of a purpose's error\r"},{"line":63,"text":"FINGERS3 = [\"middle?_pad\", \"ring?_pad\", \"pinky?_pad\", \"middle?_side\", \"ring?_side\", \"pinky?_side\"]\r"},{"line":64,"text":"\r"},{"line":65,"text":"\r"},{"line":66,"text":"def _lab_key(l_):\r"},{"line":67,"text":"    \"\"\"A hand label's colour key: a digit segment's pad, side or back (the thumb's apart), else the label.\"\"\"\r"},{"line":68,"text":"    head = l_.split(\"_\")[0]\r"},{"line":69,"text":"    if head[:-1] in DIGITS and head[-1:].isdigit():\r"},{"line":70,"text":"        kind = l_.split(\"_\")[-1]\r"},{"line":71,"text":"        return (\"thumb_\" + kind) if head.startswith(\"thumb\") else kind\r"},{"line":72,"text":"    return l_\r"},{"line":73,"text":"\r"},{"line":74,"text":"\r"},{"line":75,"text":"def _region_colour(r):\r"},{"line":76,"text":"    if r.startswith(\"notouch\"):\r"},{"line":77,"text":"        return REGION_COLOURS[\"notouch\"]\r"},{"line":78,"text":"    if r.startswith(\"other\"):\r"},{"line":79,"text":"        return REGION_COLOURS[\"other\"]\r"},{"line":80,"text":"    return REGION_COLOURS.get(r, REGION_COLOURS[\"other\"])\r"},{"line":81,"text":"\r"},{"line":82,"text":"\r"},{"line":83,"text":"def _heat(d_cm, band_cm):\r"},{"line":84,"text":"    \"\"\"A colour for a signed gap: red deep inside, orange to yellow just inside, green touching, blue near, grey far.\"\"\"\r"},{"line":85,"text":"    if d_cm < 0.0:\r"},{"line":86,"text":"        k = min(1.0, -d_cm / 0.6)\r"},{"line":87,"text":"        return (1.0, 0.75 * (1.0 - k), 0.0)\r"},{"line":88,"text":"    if d_cm <= band_cm:\r"},{"line":89,"text":"        return (0.1, 0.85, 0.2)\r"},{"line":90,"text":"    if d_cm <= 1.0:\r"},{"line":91,"text":"        k = (d_cm - band_cm) / max(1e-6, 1.0 - band_cm)\r"},{"line":92,"text":"        return (0.15, 0.4 + 0.3 * (1 - k), 0.95)\r"},{"line":93,"text":"    return (0.6, 0.6, 0.62)\r"},{"line":94,"text":"\r"},{"line":95,"text":"\r"},{"line":96,"text":"class ContactMixin:\r"},{"line":97,"text":"    # --- the object's surface, labelled ------------------------------------------------------------------------\r"}],"name":"HOLD_DIGIT_LIMITS","start_line":57,"symbol_id":"hold-code/poselab_mcp/blender/contactlab.py#var:HOLD_DIGIT_LIMITS"}}
