{"flow":{"hint":"Select one of its methods to see control flow.","kind":"type","methods":null,"name":"Project","noCFG":true,"reason":"Project is a type (struct/class/interface/enum). Control-flow graphs are built for functions and methods, not for a type itself."},"source":{"end_line":85,"file":"hold-code/weaponlab/config.py","kind":"type","language":"python","lines":[{"line":31,"text":"class Project:\r"},{"line":32,"text":"    def __init__(self, root=None):\r"},{"line":33,"text":"        self.root = Path(root or os.environ.get(\"WEAPONLAB_PROJECT\") or os.getcwd()).resolve()\r"},{"line":34,"text":"        cfg = self.root / \"weaponlab.json\"\r"},{"line":35,"text":"        raw = json.loads(cfg.read_text(encoding=\"utf-8-sig\")) if cfg.exists() else {}\r"},{"line":36,"text":"        self.config = {**DEFAULTS, **raw, \"probe\": {**DEFAULTS[\"probe\"], **raw.get(\"probe\", {})}}\r"},{"line":37,"text":"        self.has_config = cfg.exists()\r"},{"line":38,"text":"\r"},{"line":39,"text":"    def _dir(self, key):\r"},{"line":40,"text":"        p = Path(self.config[key])\r"},{"line":41,"text":"        return p if p.is_absolute() else self.root / p\r"},{"line":42,"text":"\r"},{"line":43,"text":"    @property\r"},{"line":44,"text":"    def data(self):\r"},{"line":45,"text":"        return self._dir(\"data\")\r"},{"line":46,"text":"\r"},{"line":47,"text":"    @property\r"},{"line":48,"text":"    def specs(self):\r"},{"line":49,"text":"        return self._dir(\"specs\")\r"},{"line":50,"text":"\r"},{"line":51,"text":"    @property\r"},{"line":52,"text":"    def work(self):\r"},{"line":53,"text":"        return self._dir(\"work\")\r"},{"line":54,"text":"\r"},{"line":55,"text":"    def ensure(self, *parts):\r"},{"line":56,"text":"        p = self.work.joinpath(*parts)\r"},{"line":57,"text":"        p.mkdir(parents=True, exist_ok=True)\r"},{"line":58,"text":"        return p\r"},{"line":59,"text":"\r"},{"line":60,"text":"    @property\r"},{"line":61,"text":"    def probe(self):\r"},{"line":62,"text":"        return self.config[\"probe\"]\r"},{"line":63,"text":"\r"},{"line":64,"text":"    @property\r"},{"line":65,"text":"    def providers(self):\r"},{"line":66,"text":"        return self.config.get(\"providers\") or {}\r"},{"line":67,"text":"\r"},{"line":68,"text":"    def blender(self):\r"},{"line":69,"text":"        \"\"\"Blender: WEAPONLAB_BLENDER, the project's setting, the PATH, then the usual install folders.\"\"\"\r"},{"line":70,"text":"        for cand in (os.environ.get(\"WEAPONLAB_BLENDER\"), self.config.get(\"blender\"), shutil.which(\"blender\")):\r"},{"line":71,"text":"            if cand and Path(cand).exists():\r"},{"line":72,"text":"                return Path(cand)\r"},{"line":73,"text":"        pats = []\r"},{"line":74,"text":"        if sys.platform == \"win32\":\r"},{"line":75,"text":"            for base in (os.environ.get(\"ProgramFiles\", r\"C:\\Program Files\"), r\"D:\\Blender\", r\"C:\\Blender\"):\r"},{"line":76,"text":"                pats += [os.path.join(base, \"Blender Foundation\", \"Blender*\", \"blender.exe\"), os.path.join(base, \"blender.exe\")]\r"},{"line":77,"text":"        elif sys.platform == \"darwin\":\r"},{"line":78,"text":"            pats += [\"/Applications/Blender.app/Contents/MacOS/Blender\"]\r"},{"line":79,"text":"        else:\r"},{"line":80,"text":"            pats += [\"/usr/bin/blender\", \"/snap/bin/blender\", os.path.expanduser(\"~/blender*/blender\")]\r"},{"line":81,"text":"        for pat in pats:\r"},{"line":82,"text":"            hits = sorted(glob.glob(pat), reverse=True)\r"},{"line":83,"text":"            if hits:\r"},{"line":84,"text":"                return Path(hits[0])\r"},{"line":85,"text":"        raise FileNotFoundError(\"Blender not found: set WEAPONLAB_BLENDER or \\\"blender\\\" in weaponlab.json\")\r"}],"name":"Project","start_line":31,"symbol_id":"hold-code/weaponlab/config.py#type:Project"}}
