oselab_mcp/blender/lab.py","kind":"func","language":"python","lines":[{"line":4036,"text":"    def shift_hand(self, clip, side, deltas, out=None):\r"},{"line":4037,"text":"        \"\"\"A clip with one hand moved, frame by frame, by deltas: [[seconds, [x, y, z]], ...] in the gun frame (cm),\r"},{"line":4038,"text":"        straight lines between them (a hand that holds a part whose track changed follows the part's new path). The\r"},{"line":4039,"text":"        hand keeps its turn against the gun, its elbow its direction, its fingers their curl; the wrist and fingers\r"},{"line":4040,"text":"        are mended. Stores the result as out (default clip + '_shifted').\"\"\"\r"},{"line":4041,"text":"        self._need()\r"},{"line":4042,"text":"        frames, fps = self._frames(clip)\r"},{"line":4043,"text":"        pts = sorted((float(t), Vector(_xyz(d, \"delta\"))) for t, d in deltas)\r"},{"line":4044,"text":"        if not pts:\r"},{"line":4045,"text":"            raise ValueError(\"deltas: at least one [seconds, [x, y, z]]\")\r"},{"line":4046,"text":"\r"},{"line":4047,"text":"        def at(t):\r"},{"line":4048,"text":"            if t <= pts[0][0]:\r"},{"line":4049,"text":"                return pts[0][1]\r"},{"line":4050,"text":"            for (t0, a), (t1, b) in zip(pts, pts[1:]):\r"},{"line":4051,"text":"                if t <= t1:\r"},{"line":4052,"text":"                    return a.lerp(b, (t - t0) / max(t1 - t0, 1e-9))\r"},{"line":4053,"text":"            return pts[-1][1]\r"},{"line":4054,"text":"        hn = self._n(\"hand\", side)\r"},{"line":4055,"text":"        made = []\r"},{"line":4056,"text":"        for i, fr in enumerate(frames):\r"},{"line":4057,"text":"            self._apply(fr)\r"},{"line":4058,"text":"            d = at(i / fps)\r"},{"line":4059,"text":"            if d.length > 1e-4:\r"},{"line":4060,"text":"                G = self._gun()\r"},{"line":4061,"text":"                H = self._bw(hn)\r"},{"line":4062,"text":"                rel = G.inverted() @ H\r"},{"line":4063,"text":"                move = G.to_quaternion() @ ue(d)          # gun frame cm to world\r"},{"line":4064,"text":"                S0 = self._bw(self._n(\"upperarm\", side)).translation\r"},{"line":4065,"text":"                E0 = self._bw(self._n(\"lowerarm\", side)).translation\r"},{"line":4066,"text":"                line = H.translation - S0\r"},{"line":4067,"text":"                foot = S0 + line * max(0.0, min(1.0, (E0 - S0).dot(line) / max(line.length_squared, 1e-12)))\r"},{"line":4068,"text":"                out_dir = E0 - foot\r"},{"line":4069,"text":"                pole = E0 + out_dir * 2.0 + move * 0.5 if out_dir.length > 1e-5 else None\r"},{"line":4070,"text":"                fingers = {pb.name: (pb.location.copy(), pb.rotation_quaternion.copy()) for pb in self.arm.pose.bones\r"},{"line":4071,"text":"                           if pb.name.endswith(\"_\" + side) and any(f in pb.name for f in (\"thumb\", \"index\", \"middle\", \"ring\", \"pinky\"))}\r"},{"line":4072,"text":"                self._two_bone(side, H.translation + move, pole_world=pole)\r"},{"line":4073,"text":"                W = G @ rel\r"},{"line":4074,"text":"                self._set_world(hn, Matrix.LocRotScale(self._bw(hn).translation, W.to_quaternion(), self._unit()))\r"},{"line":4075,"text":"                for name, (l, q) in fingers.items():\r"},{"line":4076,"text":"                    pb = self.arm.pose.bones[name]\r"},{"line":4077,"text":"                    pb.location, pb.rotation_quaternion = l, q\r"},{"line":4078,"text":"                bpy.context.view_layer.update()\r"},{"line":4079,"text":"                self._roll_forearm(side)\r"},{"line":4080,"text":"                self._mend_hand(side)\r"},{"line":4081,"text":"                self._clear_fingers(side)\r"},{"line":4082,"text":"            made.append(self._capture())\r"},{"line":4083,"text":"        name = out or clip + \"_shifted\"\r"},{"line":4084,"text":"        self._store(name, made, fps, \"shift_hand(%s, %s)\" % (clip, side))\r"},{"line":4085,"text":"        return {\"clip\": name, \"frames\": len(made), \"fps\": fps}\r"}],"name":"shift_hand","start_line":4036,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:shift_hand"}}
