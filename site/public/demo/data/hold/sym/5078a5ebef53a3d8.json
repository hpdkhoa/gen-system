{"flow":{"kind":"var","name":"mesh","noCFG":true,"reason":"mesh is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":77,"file":"hold-code/weaponlab/blueprint/blender/blueprint_showcase.py","kind":"var","language":"python","lines":[{"line":37,"text":"mesh = [o for o in sc.objects if o.type == 'MESH']\r"},{"line":38,"text":"for m in mesh:\r"},{"line":39,"text":"    m.hide_render = False\r"},{"line":40,"text":"# the gun's bounds at rest\r"},{"line":41,"text":"arm.animation_data_create()\r"},{"line":42,"text":"arm.animation_data.action = None\r"},{"line":43,"text":"for pb in arm.pose.bones:\r"},{"line":44,"text":"    pb.location = (0, 0, 0)\r"},{"line":45,"text":"    pb.rotation_quaternion = (1, 0, 0, 0)\r"},{"line":46,"text":"bpy.context.view_layer.update()\r"},{"line":47,"text":"dg = bpy.context.evaluated_depsgraph_get()\r"},{"line":48,"text":"pts = []\r"},{"line":49,"text":"for m in mesh:\r"},{"line":50,"text":"    e = m.evaluated_get(dg)\r"},{"line":51,"text":"    pts += [e.matrix_world @ v.co for v in e.to_mesh().vertices]\r"},{"line":52,"text":"lo = Vector((min(p.x for p in pts), min(p.y for p in pts), min(p.z for p in pts)))\r"},{"line":53,"text":"hi = Vector((max(p.x for p in pts), max(p.y for p in pts), max(p.z for p in pts)))\r"},{"line":54,"text":"mid = (lo + hi) / 2.0\r"},{"line":55,"text":"R = (hi - lo).length\r"},{"line":56,"text":"cam_data = bpy.data.cameras.new(\"ShowCam\")\r"},{"line":57,"text":"cam_data.lens = 70\r"},{"line":58,"text":"cam = bpy.data.objects.new(\"ShowCam\", cam_data)\r"},{"line":59,"text":"sc.collection.objects.link(cam)\r"},{"line":60,"text":"sc.camera = cam\r"},{"line":61,"text":"DIST = R * 2.15\r"},{"line":62,"text":"\r"},{"line":63,"text":"\r"},{"line":64,"text":"def aim(az_deg, el_deg, dist=DIST, look=None):\r"},{"line":65,"text":"    \"\"\"The camera round the gun: azimuth 0 looks at its left side (Blender +X), 180 its right; the muzzle is -Y.\"\"\"\r"},{"line":66,"text":"    a, e = math.radians(az_deg), math.radians(el_deg)\r"},{"line":67,"text":"    look = look or mid\r"},{"line":68,"text":"    cam.location = look + Vector((math.cos(a) * math.cos(e), math.sin(a) * math.cos(e), math.sin(e))) * dist\r"},{"line":69,"text":"    cam.rotation_euler = (look - cam.location).normalized().to_track_quat('-Z', 'Y').to_euler()\r"},{"line":70,"text":"\r"},{"line":71,"text":"\r"},{"line":72,"text":"VIEWS = {\"right\": (205, 14), \"left\": (-25, 14), \"top_right\": (215, 38), \"right_close\": (195, 8)}\r"},{"line":73,"text":"n = 0\r"},{"line":74,"text":"report = {\"shots\": []}\r"},{"line":75,"text":"\r"},{"line":76,"text":"\r"},{"line":77,"text":"def shot(name):\r"}],"name":"mesh","start_line":37,"symbol_id":"hold-code/weaponlab/blueprint/blender/blueprint_showcase.py#var:mesh"}}
