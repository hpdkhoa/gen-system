eader","preds":[5,20],"stmts":null,"succs":[10,11]},{"cond":"i < len(axes)","id":10,"label":"loop_body","lines":[{"kind":"call","line":1753,"text":"if i < len(axes):"}],"preds":[9],"stmts":["call len"],"succs":[12,14]},{"id":11,"label":"loop_exit","lines":[{"kind":"call","line":1761,"text":"return worst > 0.0, round(max(0.0, worst), 3)"}],"preds":[9],"stmts":["call round","call max","return"],"succs":null},{"id":12,"label":"then","preds":[10],"stmts":null,"succs":[13]},{"cond":"worst is None or sup < worst","id":13,"label":"merge","lines":[{"kind":"call","line":1759,"text":"sup = max(sum(w[j] * d[j] for j in range(6)) for w in W)"}],"preds":[12,16],"stmts":["call max","call sum","call range"],"succs":[17,18]},{"cond":"math.sqrt(sum((x * x for x in v)))","id":14,"label":"else","lines":[{"kind":"call","line":1756,"text":"v = [rnd.gauss(0, 1) for _ in range(6)]"},{"kind":"call","line":1757,"text":"ln = math.sqrt(sum(x * x for x in v)) or 1.0"}],"preds":[10],"stmts":["call rnd.gauss","call range","call math.sqrt","call sum"],"succs":[15,16]},{"id":15,"label":"then","preds":[14],"stmts":null,"succs":[16]},{"id":16,"label":"merge","lines":[{"kind":"call","line":1758,"text":"d = tuple(x / ln for x in v)"}],"preds":[15,14],"stmts":["call tuple"],"succs":[13]},{"id":17,"label":"then","preds":[13],"stmts":null,"succs":[18]},{"cond":"worst is None","id":18,"label":"merge","preds":[17,13],"stmts":null,"succs":[19,20]},{"id":19,"label":"then","preds":[18],"stmts":null,"succs":[20]},{"id":20,"label":"merge","preds":[19,18],"stmts":null,"succs":[9]}],"effects":["unknown"],"entry":0,"exits":[1,11],"func_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._closure","issues":null},"source":{"end_line":1761,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"method","language":"python","lines":[{"line":1730,"text":"    def _closure(self, touches, friction=0.5, length_cm=5.0, dirs=150, seed=11):\r"},{"line":1731,"text":"        \"\"\"Force closure from touches (point, outward normal): each contact pushes into the gun inside its friction\r"},{"line":1732,"text":"        cone (6 edges); the wrenches (force, torque over length_cm) must surround the origin: for every direction\r"},{"line":1733,"text":"        some wrench points along it. Sampled over dirs directions, so a near miss reads as a small margin. Returns\r"},{"line":1734,"text":"        (closed, margin: the least best support over the directions, 0 when open).\"\"\"\r"},{"line":1735,"text":"        import random as _random\r"},{"line":1736,"text":"        if len(touches) < 2:\r"},{"line":1737,"text":"            return False, 0.0\r"},{"line":1738,"text":"        c0 = sum((t[1] for t in touches), Vector()) / len(touches)\r"},{"line":1739,"text":"        L_ = length_cm / 100.0\r"},{"line":1740,"text":"        W = []\r"},{"line":1741,"text":"        for _n, q, nn in touches:\r"},{"line":1742,"text":"            t1 = nn.orthogonal().normalized()\r"},{"line":1743,"text":"            t2 = nn.cross(t1).normalized()\r"},{"line":1744,"text":"            for k_ in range(6):\r"},{"line":1745,"text":"                a_ = 2 * math.pi * k_ / 6\r"},{"line":1746,"text":"                f = (-nn + (t1 * math.cos(a_) + t2 * math.sin(a_)) * friction).normalized()\r"},{"line":1747,"text":"                tq = (q - c0).cross(f) / L_\r"},{"line":1748,"text":"                W.append((f.x, f.y, f.z, tq.x, tq.y, tq.z))\r"},{"line":1749,"text":"        rnd = _random.Random(seed)\r"},{"line":1750,"text":"        worst = None\r"},{"line":1751,"text":"        axes = [tuple((1.0 if i == j else 0.0) * sg for i in range(6)) for j in range(6) for sg in (1.0, -1.0)]\r"},{"line":1752,"text":"        for i in range(dirs + len(axes)):\r"},{"line":1753,"text":"            if i < len(axes):\r"},{"line":1754,"text":"                d = axes[i]\r"},{"line":1755,"text":"            else:\r"},{"line":1756,"text":"                v = [rnd.gauss(0, 1) for _ in range(6)]\r"},{"line":1757,"text":"                ln = math.sqrt(sum(x * x for x in v)) or 1.0\r"},{"line":1758,"text":"                d = tuple(x / ln for x in v)\r"},{"line":1759,"text":"            sup = max(sum(w[j] * d[j] for j in range(6)) for w in W)\r"},{"line":1760,"text":"            worst = sup if worst is None or sup < worst else worst\r"},{"line":1761,"text":"        return worst > 0.0, round(max(0.0, worst), 3)\r"}],"name":"_closure","start_line":1730,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._closure"}}
