{"flow":{"kind":"var","name":"UNITS","noCFG":true,"reason":"UNITS is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":68,"file":"hold-code/weaponlab/blueprint/specs.py","kind":"var","language":"python","lines":[{"line":28,"text":"UNITS = {\"in\": (\"cm\", 2.54), \"inch\": (\"cm\", 2.54), \"inches\": (\"cm\", 2.54), \"mm\": (\"cm\", 0.1), \"cm\": (\"cm\", 1.0),\r"},{"line":29,"text":"         \"m\": (\"cm\", 100.0), \"ft\": (\"cm\", 30.48), \"feet\": (\"cm\", 30.48),\r"},{"line":30,"text":"         \"lb\": (\"kg\", 0.45359237), \"lbs\": (\"kg\", 0.45359237), \"pounds\": (\"kg\", 0.45359237), \"pound\": (\"kg\", 0.45359237),\r"},{"line":31,"text":"         \"oz\": (\"kg\", 0.028349523), \"ounces\": (\"kg\", 0.028349523), \"kg\": (\"kg\", 1.0), \"g\": (\"kg\", 0.001),\r"},{"line":32,"text":"         \"count\": (\"count\", 1.0), \"rpm\": (\"rpm\", 1.0), \"fps\": (\"m_s\", 0.3048), \"m_s\": (\"m_s\", 1.0), \"deg\": (\"deg\", 1.0)}\r"},{"line":33,"text":"NUM = re.compile(r\"(?<![\\w.])(\\d{1,4}(?:\\.\\d+)?|\\.\\d+)\\s*(inches|inch|in\\b|mm\\b|cm\\b|ft\\b|feet|lbs?\\b|pounds?|oz\\b|ounces|kg\\b|g\\b|m\\b)?\", re.I)\r"},{"line":34,"text":"\r"},{"line":35,"text":"\r"},{"line":36,"text":"def find(gun, source_id=None, quantities=None):\r"},{"line":37,"text":"    \"\"\"Candidates for each quantity: the page, the label line, and the numbers on it and the two lines after it.\"\"\"\r"},{"line":38,"text":"    doc = store.load(gun, \"sources\")\r"},{"line":39,"text":"    out = {}\r"},{"line":40,"text":"    for s in doc[\"sources\"]:\r"},{"line":41,"text":"        if source_id and s[\"id\"] != source_id or not s[\"file\"].lower().endswith(\".pdf\"):\r"},{"line":42,"text":"            continue\r"},{"line":43,"text":"        pdf = S._pdf().open(s[\"file\"])\r"},{"line":44,"text":"        for i, page in enumerate(pdf):\r"},{"line":45,"text":"            lines = [l.strip() for l in page.get_text().splitlines()]\r"},{"line":46,"text":"            for q, (pat, unit) in LABELS.items():\r"},{"line":47,"text":"                if quantities and q not in quantities:\r"},{"line":48,"text":"                    continue\r"},{"line":49,"text":"                rx = re.compile(pat, re.I)\r"},{"line":50,"text":"                for n, line in enumerate(lines):\r"},{"line":51,"text":"                    if not rx.search(line):\r"},{"line":52,"text":"                        continue\r"},{"line":53,"text":"                    near = \" \".join(lines[n:n + 3])\r"},{"line":54,"text":"                    nums = [{\"value\": float(m.group(1)), \"unit\": (m.group(2) or \"\").lower() or None} for m in NUM.finditer(near)]\r"},{"line":55,"text":"                    out.setdefault(q, []).append({\"source\": s[\"id\"], \"page\": i + 1, \"line\": line[:140], \"near\": near[:220],\r"},{"line":56,"text":"                                                  \"numbers\": nums[:8], \"default_unit\": unit})\r"},{"line":57,"text":"    return out\r"},{"line":58,"text":"\r"},{"line":59,"text":"\r"},{"line":60,"text":"def add(gun, fact_id, value, unit, source_id, page, quote, about=None):\r"},{"line":61,"text":"    \"\"\"Records a fact. unit as printed (in, mm, lb, oz, count...): the fact is kept in cm, kg, deg, count, rpm or\r"},{"line":62,"text":"    m_s, with the printed value in raw.\"\"\"\r"},{"line":63,"text":"    u = UNITS.get(unit.lower())\r"},{"line":64,"text":"    if not u:\r"},{"line":65,"text":"        raise ValueError(\"unit %s: one of %s\" % (unit, \", \".join(UNITS)))\r"},{"line":66,"text":"    doc = store.load(gun, \"sources\")\r"},{"line":67,"text":"    S._source(doc, source_id)\r"},{"line":68,"text":"    fact = {\"id\": fact_id, \"value\": round(float(value) * u[1], 6), \"unit\": u[0], \"raw\": \"%s %s\" % (value, unit),\r"}],"name":"UNITS","start_line":28,"symbol_id":"hold-code/weaponlab/blueprint/specs.py#var:UNITS"}}
