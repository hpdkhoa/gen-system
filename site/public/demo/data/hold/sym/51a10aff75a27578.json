nkit/timeline.py","kind":"func","language":"python","lines":[{"line":118,"text":"def part_values(action, clip, t, kind=\"gun\"):\r"},{"line":119,"text":"    \"\"\"Every part's value at t: a share for a slide or a turn, an offset or a follow for a free part.\"\"\"\r"},{"line":120,"text":"    beats = clip.get(\"beats\", [])\r"},{"line":121,"text":"    out = {}\r"},{"line":122,"text":"    for role, p in action[\"parts\"].items():\r"},{"line":123,"text":"        mine = [b for b in beats if b[\"part\"] == role]\r"},{"line":124,"text":"        if p[\"kind\"] == \"free\":\r"},{"line":125,"text":"            follow = next((b[\"follow\"] for b in mine if \"follow\" in b and b[\"from\"] <= t <= b[\"to\"]), None)\r"},{"line":126,"text":"            out[role] = {\"follow\": follow} if follow else _offset_track(mine, t)\r"},{"line":127,"text":"        else:\r"},{"line":128,"text":"            out[role] = _value_track(mine, t)\r"},{"line":129,"text":"    if kind == \"hand\":\r"},{"line":130,"text":"        for part, hand, start, end in carry_spans(clip):\r"},{"line":131,"text":"            if t >= start and (end is None or t < end):\r"},{"line":132,"text":"                out[part] = {\"follow\": hand}\r"},{"line":133,"text":"            elif end is not None and t >= end:\r"},{"line":134,"text":"                out[part] = [0.0, 0.0, 0.0]\r"},{"line":135,"text":"    return out\r"}],"name":"part_values","start_line":118,"symbol_id":"hold-code/weaponlab/gunkit/timeline.py#func:part_values"}}
