    w0 = self.wall_faults(side, other)\r"},{"line":1364,"text":"        if not w0:\r"},{"line":1365,"text":"            return None\r"},{"line":1366,"text":"        f0 = self.frame_fault(side, glove_cm, other)\r"},{"line":1367,"text":"        hn = self._n(\"hand\", side)\r"},{"line":1368,"text":"        H0 = self._bw(hn).copy()\r"},{"line":1369,"text":"        P0 = H0.translation.lerp(self._bw(self._n(\"finger\", side, \"middle\", \"01\")).translation, 0.5)\r"},{"line":1370,"text":"\r"},{"line":1371,"text":"        def err():\r"},{"line":1372,"text":"            return (self._bw(hn).translation - H0.translation).length * 100.0\r"},{"line":1373,"text":"\r"},{"line":1374,"text":"        def move(ax):\r"},{"line":1375,"text":"            def mv(st):\r"},{"line":1376,"text":"                M = Matrix.Translation(Vector(ax) * (st * 0.001)) @ self._bw(hn)\r"},{"line":1377,"text":"                self._put_hand(side, Matrix.LocRotScale(M.translation, M.to_quaternion(), self._unit()))\r"},{"line":1378,"text":"            return mv\r"},{"line":1379,"text":"\r"},{"line":1380,"text":"        def turn(ax):\r"},{"line":1381,"text":"            def mv(st):\r"},{"line":1382,"text":"                R = Matrix.Translation(P0) @ Matrix.Rotation(math.radians(st * 0.5), 4, Vector(ax)) @ Matrix.Translation(-P0)\r"},{"line":1383,"text":"                M = R @ self._bw(hn)\r"},{"line":1384,"text":"                self._put_hand(side, Matrix.LocRotScale(M.translation, M.to_quaternion(), self._unit()))\r"},{"line":1385,"text":"            return mv\r"},{"line":1386,"text":"\r"},{"line":1387,"text":"        def swing(st):\r"},{"line":1388,"text":"            self._swing_elbow(side, st * 2.0)\r"},{"line":1389,"text":"        AX = ((1, 0, 0), (0, 1, 0), (0, 0, 1))\r"},{"line":1390,"text":"        self._descend(err, [move(a) for a in AX] + [turn(a) for a in AX] + [swing], side, other, steps=(4.0, 2.0, 1.0))\r"},{"line":1391,"text":"        f1 = self.frame_fault(side, glove_cm, other)\r"},{"line":1392,"text":"        w1 = self.wall_faults(side, other)\r"},{"line":1393,"text":"        return {\"before\": f0, \"after\": f1, \"moved_cm\": round(err(), 2), \"walls\": {k: round(v, 2) for k, v in w1.items()}}\r"}],"name":"repair_frame","start_line":1356,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#func:repair_frame"}}
