,"exits":[45],"func_id":"hold-code/weaponlab/rig.py#func:facts","issues":null},"source":{"end_line":135,"file":"hold-code/weaponlab/rig.py","kind":"func","language":"python","lines":[{"line":107,"text":"def facts(weapon, obj):\r"},{"line":108,"text":"    \"\"\"The spec's facts on one dump: rows facts.false and parts.duplicates, and each fact's result.\"\"\"\r"},{"line":109,"text":"    sp = S.read_spec(weapon)\r"},{"line":110,"text":"    anchors = sp.get(\"anchors\", {})\r"},{"line":111,"text":"    pcs = pieces(obj)[\"pieces\"]\r"},{"line":112,"text":"    found = {k: find_piece(pcs, a) for k, a in anchors.items()}\r"},{"line":113,"text":"    false, notes = 0, []\r"},{"line":114,"text":"    for f in sp.get(\"facts\", []):\r"},{"line":115,"text":"        c = f.get(\"check\", {})\r"},{"line":116,"text":"        kind = c.get(\"kind\")\r"},{"line":117,"text":"        if kind == \"order\":\r"},{"line":118,"text":"            a, b = found.get(c[\"ahead\"]), found.get(c[\"behind\"])\r"},{"line":119,"text":"            ok = a is not None and b is not None and a[\"center\"][1] > b[\"center\"][1]\r"},{"line":120,"text":"        elif kind == \"side\":\r"},{"line":121,"text":"            a = found.get(c[\"anchor\"])\r"},{"line":122,"text":"            ok = a is not None and (a[\"center\"][0] > 0.2 if c[\"side\"] == \"left\" else a[\"center\"][0] < -0.2)\r"},{"line":123,"text":"        elif kind == \"below\":\r"},{"line":124,"text":"            a, b = found.get(c[\"anchor\"]), found.get(c[\"under\"])\r"},{"line":125,"text":"            ok = a is not None and b is not None and a[\"max\"][2] <= b[\"min\"][2] + c.get(\"overlap_cm\", 1.0)\r"},{"line":126,"text":"        elif kind == \"in\":\r"},{"line":127,"text":"            a, b = found.get(c[\"anchor\"]), found.get(c[\"into\"])\r"},{"line":128,"text":"            ok = a is not None and b is not None and all(b[\"min\"][i] - 1.0 <= a[\"max\"][i] and a[\"min\"][i] <= b[\"max\"][i] + 1.0 for i in range(3))\r"},{"line":129,"text":"        else:\r"},{"line":130,"text":"            continue\r"},{"line":131,"text":"        if not ok:\r"},{"line":132,"text":"            false += 1\r"},{"line":133,"text":"        notes.append(\"%s: %s\" % (f[\"id\"], \"holds\" if ok else \"FALSE\"))\r"},{"line":134,"text":"    dup = sum(max(0, len(find_all(pcs, a)) - 1) for a in anchors.values() if a.get(\"unique\"))\r"},{"line":135,"text":"    return {\"facts.false\": false, \"parts.duplicates\": dup, \"notes\": notes}\r"}],"name":"facts","start_line":107,"symbol_id":"hold-code/weaponlab/rig.py#func:facts"}}
