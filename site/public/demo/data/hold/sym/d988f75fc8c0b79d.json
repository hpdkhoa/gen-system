 == \"left\" else a[\"center\"][0] < -0.2)\r"},{"line":123,"text":"        elif kind == \"below\":\r"},{"line":124,"text":"            a, b = found.get(c[\"anchor\"]), found.get(c[\"under\"])\r"},{"line":125,"text":"            ok = a is not None and b is not None and a[\"max\"][2] <= b[\"min\"][2] + c.get(\"overlap_cm\", 1.0)\r"},{"line":126,"text":"        elif kind == \"in\":\r"},{"line":127,"text":"            a, b = found.get(c[\"anchor\"]), found.get(c[\"into\"])\r"},{"line":128,"text":"            ok = a is not None and b is not None and all(b[\"min\"][i] - 1.0 <= a[\"max\"][i] and a[\"min\"][i] <= b[\"max\"][i] + 1.0 for i in range(3))\r"},{"line":129,"text":"        else:\r"},{"line":130,"text":"            continue\r"},{"line":131,"text":"        if not ok:\r"},{"line":132,"text":"            false += 1\r"},{"line":133,"text":"        notes.append(\"%s: %s\" % (f[\"id\"], \"holds\" if ok else \"FALSE\"))\r"},{"line":134,"text":"    dup = sum(max(0, len(find_all(pcs, a)) - 1) for a in anchors.values() if a.get(\"unique\"))\r"},{"line":135,"text":"    return {\"facts.false\": false, \"parts.duplicates\": dup, \"notes\": notes}\r"}],"name":"facts","start_line":107,"symbol_id":"hold-code/weaponlab/rig.py#func:facts"}}
