      pts = [b(fi, \"01\") - wrist_to_knuckle, b(fi, \"01\"), b(fi, \"02\"), b(fi, \"03\"), self._finger_tip(fi, s)]\r"},{"line":2859,"text":"            d1, d2 = pts[2] - pts[1], pts[4] - pts[1]\r"},{"line":2860,"text":"            n = d1.cross(d2)\r"},{"line":2861,"text":"            if n.length < 0.26 * d1.length * d2.length:   # under about 15 degrees of curl: no plane of its own\r"},{"line":2862,"text":"                n = across - d2.normalized() * across.dot(d2.normalized())\r"},{"line":2863,"text":"            n.normalize()\r"},{"line":2864,"text":"            planes[fi] = n\r"},{"line":2865,"text":"            for i, j in enumerate((\"01\", \"02\", \"03\")):\r"},{"line":2866,"text":"                a, c = (pts[i + 1] - pts[i]).normalized(), (pts[i + 2] - pts[i + 1]).normalized()\r"},{"line":2867,"text":"                curl = math.degrees(math.atan2(a.cross(c).dot(across) * sign, a.dot(c)))\r"},{"line":2868,"text":"                if j == \"01\":\r"},{"line":2869,"text":"                    side_axis = across - a * across.dot(a)\r"},{"line":2870,"text":"                    side_deg = asin(c.dot(side_axis.normalized())) if side_axis.length > 1e-6 else 0.0\r"},{"line":2871,"text":"                elif j == \"02\":\r"},{"line":2872,"text":"                    # the middle joint against its own hinge: square to the segment before it and to the palm's\r"},{"line":2873,"text":"                    # normal (across the knuckles). The plane through the tip follows a kink here and hid it\r"},{"line":2874,"text":"                    h = across - a * across.dot(a)\r"},{"line":2875,"text":"                    side_deg = asin(c.dot(h.normalized())) if h.length > 1e-6 else 0.0\r"},{"line":2876,"text":"                else:\r"},{"line":2877,"text":"                    # the end joint against the middle joint: one hinge line, so their bending planes are one plane. A\r"},{"line":2878,"text":"                    # plane fitted through the tip follows a kink at the middle joint and hid a 35 degree one (ToangTown's\r"},{"line":2879,"text":"                    # M24 benchmark); the two joints' own planes do not. A joint bent under about 10 degrees has no plane:\r"},{"line":2880,"text":"                    # then the end segment against the middle joint's plane\r"},{"line":2881,"text":"                    p_mid = (pts[2] - pts[1]).cross(pts[3] - pts[2])\r"},{"line":2882,"text":"                    p_end = (pts[3] - pts[2]).cross(pts[4] - pts[3])\r"},{"line":2883,"text":"                    s_mid = 0.17 * (pts[2] - pts[1]).length * (pts[3] - pts[2]).length\r"},{"line":2884,"text":"                    s_end = 0.17 * (pts[3] - pts[2]).length * (pts[4] - pts[3]).length\r"},{"line":2885,"text":"                    if p_mid.length >= s_mid and p_end.length >= s_end:\r"},{"line":2886,"text":"                        ang = math.degrees(p_mid.angle(p_end))\r"},{"line":2887,"text":"                        side_deg = math.copysign(min(ang, 180.0 - ang), p_mid.cross(p_end).dot(pts[3] - pts[2]))\r"},{"line":2888,"text":"                    elif p_mid.length >= s_mid:\r"},{"line":2889,"text":"                        side_deg = asin(c.dot(p_mid.normalized()))\r"},{"line":2890,"text":"                    else:\r"},{"line":2891,"text":"                        side_deg = asin(c.dot(n)) - asin(a.dot(n))\r"},{"line":2892,"text":"                lo, hi, sd = FL[j]\r"},{"line":2893,"text":"                out[\"%s_%s\" % (fi, j)] = [round(curl), round(side_deg)]\r"},{"line":2894,"text":"                if round(curl) < lo:\r"},{"line":2895,"text":"                    bad.append(\"%s %s bent %.0f backward (hyperextended; at most %.0f)\" % (fi, JOINT_NAMES[j], -curl, -lo))\r"},{"line":2896,"text":"                elif round(curl) > hi:\r"},{"line":2897,"text":"                    bad.append(\"%s %s curled %.0f (at most %.0f)\" % (fi, JOINT_NAMES[j], curl, hi))\r"},{"line":2898,"text":"                if abs(round(side_deg)) > sd:\r"},{"line":2899,"text":"                    bad.append(\"%s %s twisted %.0f out of the finger's plane (at most %.0f)\" % (fi, JOINT_NAMES[j], abs(side_deg), sd))\r"},{"line":2900,"text":"        return out, bad, planes\r"}],"name":"_finger_report","start_line":2848,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._finger_report"}}
