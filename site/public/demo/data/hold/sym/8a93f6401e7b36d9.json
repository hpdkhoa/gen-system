:[{"kind":"return","line":899,"text":"return False, None, touching"}],"preds":[33],"stmts":["return"],"succs":null},{"id":35,"label":"merge","lines":[{"kind":"call","line":900,"text":"top = max(angles)"},{"kind":"call","line":901,"text":"return top >= need, round(top), touching"}],"preds":[33],"stmts":["call max","call round","return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[32,34,35],"func_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._grasp","issues":null},"source":{"end_line":901,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"method","language":"python","lines":[{"line":864,"text":"    def _grasp(self, s, tree, contact_cm=0.3, friction=0.5, near=None, near_cm=None):\r"},{"line":865,"text":"        \"\"\"Whether the hand pinches the rifle between the thumb and a finger (an antipodal grasp): each digit's point\r"},{"line":866,"text":"        nearest the rifle (its two outer segments), touching when its skin is within contact_cm of the surface, and\r"},{"line":867,"text":"        the direction from the surface to it. Thumb and finger hold the part between them when those directions are\r"},{"line":868,"text":"        at least 180 - 2 atan(friction) degrees apart: each pad pushes inside its friction cone (skin on metal or\r"},{"line":869,"text":"        polymer, friction about 0.5: 127 degrees). Returns (grasping, the widest thumb to finger angle or None, the\r"},{"line":870,"text":"        digits touching). near, near_cm: only the rifle's surface within near_cm of the point near counts (a hand that\r"},{"line":871,"text":"        must pinch one part, not the rifle anywhere).\"\"\"\r"},{"line":872,"text":"        need = 180.0 - 2.0 * math.degrees(math.atan(friction))\r"},{"line":873,"text":"        segs = {x[0]: x for x in self._segments(s)}\r"},{"line":874,"text":"        dirs = {}\r"},{"line":875,"text":"        for fi in FINGERS:\r"},{"line":876,"text":"            best = None\r"},{"line":877,"text":"            for j in (2, 3):\r"},{"line":878,"text":"                seg = segs.get(\"%s%d_%s\" % (fi, j, s))\r"},{"line":879,"text":"                if seg is None:\r"},{"line":880,"text":"                    continue\r"},{"line":881,"text":"                _n, a, b, r = seg\r"},{"line":882,"text":"                n = max(2, int((b - a).length / 0.003))\r"},{"line":883,"text":"                for i in range(n + 1):\r"},{"line":884,"text":"                    p = a.lerp(b, i / n)\r"},{"line":885,"text":"                    q, d = tree.nearest(p)\r"},{"line":886,"text":"                    if q is None or (near is not None and (q - near).length * 100.0 > near_cm):\r"},{"line":887,"text":"                        continue\r"},{"line":888,"text":"                    gap = (d - r) * 100.0\r"},{"line":889,"text":"                    if best is None or gap < best[0]:\r"},{"line":890,"text":"                        u = (p - q) if d >= 0.0 else (q - p)\r"},{"line":891,"text":"                        best = (gap, u.normalized() if u.length > 1e-9 else None)\r"},{"line":892,"text":"            if best is not None and best[0] <= contact_cm and best[1] is not None:\r"},{"line":893,"text":"                dirs[fi] = best[1]\r"},{"line":894,"text":"        touching = sorted(dirs)\r"},{"line":895,"text":"        if \"thumb\" not in dirs:\r"},{"line":896,"text":"            return False, None, touching\r"},{"line":897,"text":"        angles = [math.degrees(dirs[\"thumb\"].angle(v)) for f, v in dirs.items() if f != \"thumb\"]\r"},{"line":898,"text":"        if not angles:\r"},{"line":899,"text":"            return False, None, touching\r"},{"line":900,"text":"        top = max(angles)\r"},{"line":901,"text":"        return top >= need, round(top), touching\r"}],"name":"_grasp","start_line":864,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._grasp"}}
