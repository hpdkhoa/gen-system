{"flow":{"kind":"var","name":"RULES","noCFG":true,"reason":"RULES is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":756,"file":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py","kind":"var","language":"python","lines":[{"line":716,"text":"RULES = {}\r"},{"line":717,"text":"\r"},{"line":718,"text":"\r"},{"line":719,"text":"def hand_rules(side):\r"},{"line":720,"text":"    \"\"\"A hand's contact rules with their regions on this mesh (polygon indices), its wrap band and closure.\"\"\"\r"},{"line":721,"text":"    if side in RULES:\r"},{"line":722,"text":"        return RULES[side]\r"},{"line":723,"text":"    h = ((STYLE or {}).get(\"hands\") or {}).get(side) or {}\r"},{"line":724,"text":"    rules = []\r"},{"line":725,"text":"    for r_ in h.get(\"contact_rules\", []):\r"},{"line":726,"text":"        x = dict(r_)\r"},{"line":727,"text":"        if r_.get(\"on_hand\"):\r"},{"line":728,"text":"            x[\"polys\"] = []                               # the region is the other hand's skin, found each time\r"},{"line":729,"text":"        else:\r"},{"line":730,"text":"            x[\"polys\"] = resolve_region(r_[\"region\"])\r"},{"line":731,"text":"        rules.append(x)\r"},{"line":732,"text":"    wrap = None\r"},{"line":733,"text":"    if h.get(\"wrap\"):\r"},{"line":734,"text":"        wrap = {\"polys\": resolve_region(h[\"wrap\"][\"region\"]), \"min\": h[\"wrap\"][\"min\"],\r"},{"line":735,"text":"                \"sides\": [\"r\", \"l\"] if h[\"wrap\"].get(\"both_hands\") else [side]}\r"},{"line":736,"text":"    RULES[side] = (rules, wrap, h.get(\"closure\"))\r"},{"line":737,"text":"    report.setdefault(\"contact_regions\", {})[side] = {r_[\"id\"]: (\"hand \" + r_[\"on_hand\"][\"side\"] if r_.get(\"on_hand\") else len(r_[\"polys\"])) for r_ in rules}\r"},{"line":738,"text":"    return RULES[side]\r"},{"line":739,"text":"\r"},{"line":740,"text":"\r"},{"line":741,"text":"def contacts_now(side):\r"},{"line":742,"text":"    rules, wrap, closure = hand_rules(side)\r"},{"line":743,"text":"    if not rules and not wrap and not closure:\r"},{"line":744,"text":"        return None\r"},{"line":745,"text":"    cn = L.contacts(side, rules, glove_cm=GLOVE, friction=(closure or {}).get(\"friction\", 0.5), wrap=wrap,\r"},{"line":746,"text":"                    closure_sides=(closure or {}).get(\"sides\", [side]), frame=\"world\")\r"},{"line":747,"text":"    Ri = RA.matrix_world.inverted()\r"},{"line":748,"text":"    for r_ in cn[\"rules\"]:\r"},{"line":749,"text":"        if r_.get(\"touch\") is not None:\r"},{"line":750,"text":"            q = Ri @ Vector(r_[\"touch\"])\r"},{"line":751,"text":"            r_[\"touch\"] = [round(q.x * 100, 2), round(-q.y * 100, 2), round(q.z * 100, 2)]\r"},{"line":752,"text":"            nv = Ri.to_quaternion() @ Vector(r_[\"normal\"])\r"},{"line":753,"text":"            r_[\"normal\"] = [round(nv.x, 2), round(-nv.y, 2), round(nv.z, 2)]\r"},{"line":754,"text":"    return cn\r"},{"line":755,"text":"\r"},{"line":756,"text":"\r"}],"name":"RULES","start_line":716,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#var:RULES"}}
