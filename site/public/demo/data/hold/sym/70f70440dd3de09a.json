tmts":["call self._set_curl"],"succs":[16]},{"id":16,"label":"try_merge","preds":[15,13],"stmts":null,"succs":[12]},{"id":17,"label":"try_body","lines":[{"kind":"call","line":2513,"text":"return self._body_size(side, ranges)"}],"preds":[8],"stmts":["call self._body_size","return"],"succs":null},{"id":18,"label":"try_merge","preds":[19],"stmts":null,"succs":null},{"id":19,"label":"catch","lines":[{"kind":"call","line":2515,"text":"self.snapshot(\"load\", \"_body_size\")"},{"kind":"call","line":2516,"text":"bpy.context.view_layer.update()"}],"preds":[8],"stmts":["call self.snapshot","call bpy.context.view_layer.update"],"succs":[18]}],"effects":["unknown"],"entry":0,"exits":[17],"func_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.body_size","issues":null},"source":{"end_line":2516,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"method","language":"python","lines":[{"line":2488,"text":"    def body_size(self, side=\"both\", ranges=None):\r"},{"line":2489,"text":"        \"\"\"The arm's and hand's sizes as built, in cm: the bones joint to joint (upper arm, forearm), the hand's length\r"},{"line":2490,"text":"        to the farthest skin of its middle finger, the skin's breadth and girth at the knuckles (thumb left out), the\r"},{"line":2491,"text":"        wrist's least girth and the forearm's most. ranges ({measure: {low, high, ...}}, from Pose Lab's human_sizes):\r"},{"line":2492,"text":"        each measure outside its range is listed in bad. skin_vs_capsules: how far the drawn skin lies outside the\r"},{"line":2493,"text":"        capsules clearance tests the body with (palm, forearm, fingers); past 0.3 cm the clearance checks miss clips\r"},{"line":2494,"text":"        the picture shows, and that is listed in bad too. Measured on the rig's rest pose (fingers straight, as the\r"},{"line":2495,"text":"        survey measures a hand); the pose is put back after.\"\"\"\r"},{"line":2496,"text":"        self._need()\r"},{"line":2497,"text":"        self.snapshot(\"save\", \"_body_size\")\r"},{"line":2498,"text":"        for pb in self.arm.pose.bones:\r"},{"line":2499,"text":"            pb.matrix_basis = Matrix.Identity(4)\r"},{"line":2500,"text":"        bpy.context.view_layer.update()\r"},{"line":2501,"text":"        # the fingers straight, as the survey measures a hand (a rig's rest pose curls them a little: a hand then\r"},{"line":2502,"text":"        # reads short along its own line)\r"},{"line":2503,"text":"        FL = self._limits()[1]\r"},{"line":2504,"text":"        for s_ in ((\"l\", \"r\") if side == \"both\" else (side,)):\r"},{"line":2505,"text":"            for fi in (\"index\", \"middle\", \"ring\", \"pinky\"):\r"},{"line":2506,"text":"                for j in (\"01\", \"02\", \"03\"):\r"},{"line":2507,"text":"                    try:\r"},{"line":2508,"text":"                        self._set_curl(s_, fi, j, 0.0, FL)\r"},{"line":2509,"text":"                    except Exception:\r"},{"line":2510,"text":"                        pass\r"},{"line":2511,"text":"        bpy.context.view_layer.update()\r"},{"line":2512,"text":"        try:\r"},{"line":2513,"text":"            return self._body_size(side, ranges)\r"},{"line":2514,"text":"        finally:\r"},{"line":2515,"text":"            self.snapshot(\"load\", \"_body_size\")\r"},{"line":2516,"text":"            bpy.context.view_layer.update()\r"}],"name":"body_size","start_line":2488,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.body_size"}}
