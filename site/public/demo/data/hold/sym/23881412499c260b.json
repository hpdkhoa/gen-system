ranslation","call Vector","call list","call self._n","call self._bw","call self._put_hand","call Matrix.LocRotScale","call M.to_quaternion","call self._unit","call bpy.context.view_layer.update","call round","call self._anchor","call tg.items","call round","return"],"succs":null},{"id":13,"label":"then","lines":[{"kind":"call","line":2337,"text":"aw = (self._gun().to_quaternion() @ ue(across)).normalized()"}],"preds":[11],"stmts":["call ?.normalized"],"succs":[14]},{"id":14,"label":"merge","lines":[{"kind":"call","line":2338,"text":"ah = self._hand_frame(side)[0]"},{"kind":"call","line":2339,"text":"c0 = sum(src, Vector()) / len(src)"},{"kind":"call","line":2340,"text":"c1 = sum(dst, Vector()) / len(dst)"}],"preds":[13,11],"stmts":["call self._hand_frame","call sum","call Vector","call len","call sum","call Vector","call len"],"succs":[15]},{"cond":"for sg in (1.0, -1.0)","id":15,"label":"loop_header","preds":[14,16],"stmts":null,"succs":[16,17]},{"id":16,"label":"loop_body","lines":[{"kind":"call","line":2342,"text":"src.append(c0 + ah * (sg * facing_cm / 100.0))"},{"kind":"call","line":2343,"text":"dst.append(c1 + aw * (sg * facing_cm / 100.0))"}],"preds":[15],"stmts":["call src.append","call dst.append"],"succs":[15]},{"id":17,"label":"loop_exit","preds":[15],"stmts":null,"succs":[12]}],"effects":["unknown"],"entry":0,"exits":[12],"func_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.place_hand","issues":null},"source":{"end_line":2359,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"method","language":"python","lines":[{"line":2312,"text":"    def place_hand(self, side, anchors, facing=None, frame=\"world\", facing_cm=3.0, across=None):\r"},{"line":2313,"text":"        \"\"\"The hand moved and turned as one rigid body so its named points (anchors: {web|knuckle|...: point}) land\r"},{"line":2314,"text":"        as close as they can on their points, and its palm faces facing (a direction), by a least-squares fit\r"},{"line":2315,"text":"        (Kabsch). across: the way the line across the knuckles (little finger to index) should run, for a grip\r"},{"line":2316,"text":"        the grip's own axis upward, so the fingers curl round it. The arm reaches it. Returns each anchor's\r"},{"line":2317,"text":"        distance left (cm) and the reach short (cm).\"\"\"\r"},{"line":2318,"text":"        import numpy as np\r"},{"line":2319,"text":"        self._need()\r"},{"line":2320,"text":"        to_w = (lambda p: Vector(p)) if frame == \"world\" else (lambda p: self._point(p, frame))\r"},{"line":2321,"text":"        tg = {k: to_w(v) for k, v in anchors.items()}\r"},{"line":2322,"text":"        src, dst = [], []\r"},{"line":2323,"text":"        for k, t in tg.items():\r"},{"line":2324,"text":"            src.append(self._anchor(side, k))\r"},{"line":2325,"text":"            dst.append(t)\r"},{"line":2326,"text":"        if facing is not None:\r"},{"line":2327,"text":"            fw = Vector(facing).normalized()\r"},{"line":2328,"text":"            if frame == \"gun\":\r"},{"line":2329,"text":"                fw = (self._gun().to_quaternion() @ ue(facing)).normalized()\r"},{"line":2330,"text":"            c0 = sum(src, Vector()) / len(src)\r"},{"line":2331,"text":"            c1 = sum(dst, Vector()) / len(dst)\r"},{"line":2332,"text":"            src.append(c0 + self._palm_facing(side) * (facing_cm / 100.0))\r"},{"line":2333,"text":"            dst.append(c1 + fw * (facing_cm / 100.0))\r"},{"line":2334,"text":"        if across is not None:\r"},{"line":2335,"text":"            aw = Vector(across).normalized()\r"},{"line":2336,"text":"            if frame == \"gun\":\r"},{"line":2337,"text":"                aw = (self._gun().to_quaternion() @ ue(across)).normalized()\r"},{"line":2338,"text":"            ah = self._hand_frame(side)[0]\r"},{"line":2339,"text":"            c0 = sum(src, Vector()) / len(src)\r"},{"line":2340,"text":"            c1 = sum(dst, Vector()) / len(dst)\r"},{"line":2341,"text":"            for sg in (1.0, -1.0):\r"},{"line":2342,"text":"                src.append(c0 + ah * (sg * facing_cm / 100.0))\r"},{"line":2343,"text":"                dst.append(c1 + aw * (sg * facing_cm / 100.0))\r"},{"line":2344,"text":"        A = np.array([list(p) for p in src])\r"},{"line":2345,"text":"        Bm = np.array([list(p) for p in dst])\r"},{"line":2346,"text":"        ca, cb = A.mean(0), Bm.mean(0)\r"},{"line":2347,"text":"        Hm = (A - ca).T @ (Bm - cb)\r"},{"line":2348,"text":"        U, _S, Vt = np.linalg.svd(Hm)\r"},{"line":2349,"text":"        dd = np.sign(np.linalg.det(Vt.T @ U.T))\r"},{"line":2350,"text":"        D = np.diag([1.0, 1.0, dd])\r"},{"line":2351,"text":"        Rm = Vt.T @ D @ U.T\r"},{"line":2352,"text":"        R = Matrix([list(Rm[0]), list(Rm[1]), list(Rm[2])]).to_4x4()\r"},{"line":2353,"text":"        T = Matrix.Translation(Vector(list(cb))) @ R @ Matrix.Translation(-Vector(list(ca)))\r"},{"line":2354,"text":"        hn = self._n(\"hand\", side)\r"},{"line":2355,"text":"        M = T @ self._bw(hn)\r"},{"line":2356,"text":"        short = self._put_hand(side, Matrix.LocRotScale(M.translation, M.to_quaternion(), self._unit()))\r"},{"line":2357,"text":"        bpy.context.view_layer.update()\r"},{"line":2358,"text":"        left = {k: round((self._anchor(side, k) - t).length * 100.0, 2) for k, t in tg.items()}\r"},{"line":2359,"text":"        return {\"left_cm\": left, \"short_cm\": round(short, 2)}\r"}],"name":"place_hand","start_line":2312,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.place_hand"}}
