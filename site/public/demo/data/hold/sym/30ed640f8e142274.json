{"flow":{"kind":"var","name":"PLATFORM_ACTION","noCFG":true,"reason":"PLATFORM_ACTION is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":53,"file":"hold-code/weaponlab/gunkit/modellab.py","kind":"var","language":"python","lines":[{"line":13,"text":"PLATFORM_ACTION = {\"ar15\": \"ar_gas\"}\r"},{"line":14,"text":"\r"},{"line":15,"text":"\r"},{"line":16,"text":"def _box(sb, *names):\r"},{"line":17,"text":"    \"\"\"The bounds of shapes taken together: [[x0, y0, z0], [x1, y1, z1]] (gun cm).\"\"\"\r"},{"line":18,"text":"    got = [sb[n] for n in names if n in sb]\r"},{"line":19,"text":"    if not got:\r"},{"line":20,"text":"        return None\r"},{"line":21,"text":"    return [[min(b[0][i] for b in got) for i in range(3)], [max(b[1][i] for b in got) for i in range(3)]]\r"},{"line":22,"text":"\r"},{"line":23,"text":"\r"},{"line":24,"text":"def _mid(b, i):\r"},{"line":25,"text":"    return round((b[0][i] + b[1][i]) / 2.0, 3)\r"},{"line":26,"text":"\r"},{"line":27,"text":"\r"},{"line":28,"text":"def partsmap(build_folder):\r"},{"line":29,"text":"    \"\"\"The parts map of a Model Lab build (its folder under Model Lab's builds).\"\"\"\r"},{"line":30,"text":"    folder = Path(build_folder)\r"},{"line":31,"text":"    f = json.loads((folder / \"facts.json\").read_text(encoding=\"utf-8\"))\r"},{"line":32,"text":"    action = PLATFORM_ACTION.get(f.get(\"platform\"))\r"},{"line":33,"text":"    if not action:\r"},{"line":34,"text":"        raise ValueError(\"Gun Kit knows Model Lab's platforms %s; this build is %s\" % (\", \".join(PLATFORM_ACTION), f.get(\"platform\")))\r"},{"line":35,"text":"    mv, mk, sb = f[\"moving\"], f[\"marks\"], f[\"shape_bounds\"]\r"},{"line":36,"text":"    at = lambda name: [round(v, 3) for v in mk[name][\"at\"]]       # noqa: E731\r"},{"line":37,"text":"    parts = {\r"},{"line":38,"text":"        \"carrier\": {\"vertex_groups\": [\"Bolt\"], \"axis\": mv[\"Bolt\"][\"axis\"], \"travel_cm\": mv[\"Bolt\"][\"travel_cm\"]},\r"},{"line":39,"text":"        \"handle\": {\"vertex_groups\": [\"ChargingHandle\"], \"axis\": mv[\"ChargingHandle\"][\"axis\"], \"travel_cm\": mv[\"ChargingHandle\"][\"travel_cm\"]},\r"},{"line":40,"text":"        \"magazine\": {\"vertex_groups\": [\"Magazine\", \"MagRound\"]},\r"},{"line":41,"text":"    }\r"},{"line":42,"text":"    if \"DustCover\" in mv:\r"},{"line":43,"text":"        parts[\"cover\"] = {\"vertex_groups\": [\"DustCover\"], \"axis\": mv[\"DustCover\"][\"axis\"], \"turn_deg\": mv[\"DustCover\"][\"open_deg\"],\r"},{"line":44,"text":"                          \"pivot\": [round(v, 3) for v in mv[\"DustCover\"][\"hinge\"]]}\r"},{"line":45,"text":"    if \"BoltCatch\" in mv:\r"},{"line":46,"text":"        parts[\"catch\"] = {\"vertex_groups\": [\"BoltCatch\"], \"axis\": [0, 0, 1], \"travel_cm\": mv[\"BoltCatch\"][\"lift_cm\"]}\r"},{"line":47,"text":"    if \"MagRelease\" in mv:\r"},{"line":48,"text":"        parts[\"release\"] = {\"vertex_groups\": [\"MagRelease\"], \"axis\": mv[\"MagRelease\"][\"axis\"], \"travel_cm\": mv[\"MagRelease\"][\"press_cm\"]}\r"},{"line":49,"text":"    if \"ForwardAssist\" in mv:\r"},{"line":50,"text":"        parts[\"assist\"] = {\"vertex_groups\": [\"ForwardAssist\"], \"axis\": mv[\"ForwardAssist\"][\"axis\"], \"travel_cm\": mv[\"ForwardAssist\"][\"press_cm\"]}\r"},{"line":51,"text":"    tb = _box(sb, \"Trigger\")\r"},{"line":52,"text":"    if \"Trigger\" in mv and tb:\r"},{"line":53,"text":"        parts[\"trigger\"] = {\"vertex_groups\": [\"Trigger\"], \"axis\": [1, 0, 0], \"turn_deg\": mv[\"Trigger\"][\"pull_deg\"],\r"}],"name":"PLATFORM_ACTION","start_line":13,"symbol_id":"hold-code/weaponlab/gunkit/modellab.py#var:PLATFORM_ACTION"}}
