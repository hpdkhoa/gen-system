 []).append(n)\r"},{"line":91,"text":"    seen, out = set(), []\r"},{"line":92,"text":"    for key in cells:\r"},{"line":93,"text":"        if key in seen:\r"},{"line":94,"text":"            continue\r"},{"line":95,"text":"        stack, idx = [key], []\r"},{"line":96,"text":"        seen.add(key)\r"},{"line":97,"text":"        while stack:\r"},{"line":98,"text":"            a, b = stack.pop()\r"},{"line":99,"text":"            idx += cells[(a, b)]\r"},{"line":100,"text":"            for da in (-1, 0, 1):\r"},{"line":101,"text":"                for db in (-1, 0, 1):\r"},{"line":102,"text":"                    q = (a + da, b + db)\r"},{"line":103,"text":"                    if q in cells and q not in seen:\r"},{"line":104,"text":"                        seen.add(q)\r"},{"line":105,"text":"                        stack.append(q)\r"},{"line":106,"text":"        idx = np.array(idx)\r"},{"line":107,"text":"        out.append((pu[idx], pv[idx]))\r"},{"line":108,"text":"    return out\r"}],"name":"_blobs","start_line":81,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#func:_blobs"}}
