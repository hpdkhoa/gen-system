[{"line":26,"text":"def split(tris, weld=0.02):\r"},{"line":27,"text":"    \"\"\"Connected pieces of a triangle soup (vertices within weld cm count as one).\"\"\"\r"},{"line":28,"text":"    key = lambda p: (round(p[0] / weld), round(p[1] / weld), round(p[2] / weld))\r"},{"line":29,"text":"    parent = {}\r"},{"line":30,"text":"\r"},{"line":31,"text":"    def find(a):\r"},{"line":32,"text":"        while parent[a] != a:\r"},{"line":33,"text":"            parent[a] = parent[parent[a]]\r"},{"line":34,"text":"            a = parent[a]\r"},{"line":35,"text":"        return a\r"},{"line":36,"text":"\r"},{"line":37,"text":"    for t in tris:\r"},{"line":38,"text":"        ks = [key(p) for p in t]\r"},{"line":39,"text":"        for k in ks:\r"},{"line":40,"text":"            parent.setdefault(k, k)\r"},{"line":41,"text":"        for k in ks[1:]:\r"},{"line":42,"text":"            ra, rb = find(ks[0]), find(k)\r"},{"line":43,"text":"            if ra != rb:\r"},{"line":44,"text":"                parent[rb] = ra\r"},{"line":45,"text":"    out = {}\r"},{"line":46,"text":"    for t in tris:\r"},{"line":47,"text":"        out.setdefault(find(key(t[0])), []).append(t)\r"},{"line":48,"text":"    return list(out.values())\r"}],"name":"split","start_line":26,"symbol_id":"hold-code/weaponlab/rig.py#func:split"}}
