 cannot read (out of reach): no start\r"},{"line":654,"text":"        w = abs(rep_.get(\"wrist_bend_deg\", 0.0))\r"},{"line":655,"text":"        rad = rep_.get(\"wrist_radial_deg\", 0.0)\r"},{"line":656,"text":"        roll = rep_.get(\"forearm_rotation_deg\", 0.0) or 0.0\r"},{"line":657,"text":"        el = rep_.get(\"elbow_bend_deg\", 90.0)\r"},{"line":658,"text":"        ex = max(0.0, w - Lm[\"wrist_max_deg\"]) + max(0.0, rad - Lm[\"wrist_radial_deg\"]) + max(0.0, -rad - Lm[\"wrist_ulnar_deg\"])\r"},{"line":659,"text":"        ex += max(0.0, roll - Lm[\"supination_deg\"]) + max(0.0, -roll - Lm[\"pronation_deg\"])\r"},{"line":660,"text":"        ex += max(0.0, Lm[\"elbow_bend_min_deg\"] + 5.0 - el)\r"},{"line":661,"text":"        return round(ex + 5.0 * len([b for b in bad if \"shoulder\" in b or \"across\" in b or \"behind\" in b]), 1)\r"}],"name":"arm_excess","start_line":646,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#func:arm_excess"}}
