un_clips\"][cid][\"seconds\"]\r"},{"line":139,"text":"        plan[\"A_%s_%s\" % (facts[\"name\"], cid)] = sorted({round(round(secs * x * T.FPS) / T.FPS, 5) for x in times})   # on frames\r"},{"line":140,"text":"    _blender(\"gunkit_readback.py\", {\"blend\": str(out / (\"%s_clips.blend\" % facts[\"name\"])), \"clips\": plan, \"out\": str(out)}, out)\r"},{"line":141,"text":"    got = json.loads((out / \"readback.json\").read_text(encoding=\"utf-8\"))\r"},{"line":142,"text":"    kp = out / \"keyed_tracks.json\"\r"},{"line":143,"text":"    keyed = json.loads(kp.read_text(encoding=\"utf-8\")) if kp.exists() else {\"resolved\": [], \"tracks\": {}}\r"},{"line":144,"text":"    report = {}\r"},{"line":145,"text":"    for cid in a[\"gun_clips\"]:\r"},{"line":146,"text":"        name = \"A_%s_%s\" % (facts[\"name\"], cid)\r"},{"line":147,"text":"        clip = T.gun_clip(a, facts, cid)\r"},{"line":148,"text":"        res = cid in keyed[\"resolved\"] and cid in keyed[\"tracks\"]\r"},{"line":149,"text":"        worst = 0.0\r"},{"line":150,"text":"        for t in plan[name]:\r"},{"line":151,"text":"            want = expected_keyed(facts, keyed[\"tracks\"][cid], t) if res else expected(facts, clip, t)\r"},{"line":152,"text":"            for bone, pts in want.items():\r"},{"line":153,"text":"                for k, w in pts.items():\r"},{"line":154,"text":"                    g = got[name][str(t)][bone][k]\r"},{"line":155,"text":"                    worst = max(worst, max(abs(g[i] - w[i]) for i in range(3)))\r"},{"line":156,"text":"        report[cid] = {\"worst_cm\": round(worst, 4), \"ok\": worst <= tol_cm, \"against\": \"keyed (hand step)\" if res else \"timeline\"}\r"},{"line":157,"text":"    (out / \"readback_report.json\").write_text(json.dumps(report, indent=1), encoding=\"utf-8\")\r"},{"line":158,"text":"    return report\r"}],"name":"verify","start_line":131,"symbol_id":"hold-code/weaponlab/gunkit/run.py#func:verify"}}
