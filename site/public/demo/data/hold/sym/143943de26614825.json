ext":"    def build_sdf(self, part, cell_cm=SDF_CELL_CM, margin_cm=SDF_MARGIN_CM):\r"},{"line":78,"text":"        \"\"\"A part's signed distance grid in its own frame (m; inside below 0), and its region labels near the\r"},{"line":79,"text":"        surface. Kept on disk under the part's mesh's hash; built once.\"\"\"\r"},{"line":80,"text":"        V, ps = self._part_mesh_local(part)\r"},{"line":81,"text":"        if not ps:\r"},{"line":82,"text":"            return None\r"},{"line":83,"text":"        key = hashlib.sha1((part + json.dumps([[round(c, 5) for c in v] for v in V[:: max(1, len(V) // 500)]]) +\r"},{"line":84,"text":"                            str(len(V)) + str(len(ps)) + str(cell_cm)).encode()).hexdigest()[:16]\r"},{"line":85,"text":"        path = os.path.join(self._sdf_dir(), \"%s_%s.npz\" % (part, key))\r"},{"line":86,"text":"        if os.path.exists(path):\r"},{"line":87,"text":"            z = np.load(path, allow_pickle=True)\r"},{"line":88,"text":"            return {\"origin\": z[\"origin\"], \"cell\": float(z[\"cell\"]), \"d\": z[\"d\"], \"path\": path}\r"},{"line":89,"text":"        bvh = BVHTree.FromPolygons(V, ps)\r"},{"line":90,"text":"        A = np.array([list(v) for v in V])\r"},{"line":91,"text":"        cell = cell_cm / 100.0\r"},{"line":92,"text":"        lo = A.min(0) - margin_cm / 100.0\r"},{"line":93,"text":"        hi = A.max(0) + margin_cm / 100.0\r"},{"line":94,"text":"        n = np.maximum(2, np.ceil((hi - lo) / cell).astype(int) + 1)\r"},{"line":95,"text":"        nx, ny, nz = int(n[0]), int(n[1]), int(n[2])\r"},{"line":96,"text":"        # inside or out: rays along every row of cells, both ways along x and along z; crossings alternate\r"},{"line":97,"text":"        def row_inside(axis):\r"},{"line":98,"text":"            ins = np.zeros((nx, ny, nz), dtype=np.int8)\r"},{"line":99,"text":"            a, b = [k for k in range(3) if k != axis]\r"},{"line":100,"text":"            dirv = Vector([1.0 if k == axis else 0.0 for k in range(3)])\r"},{"line":101,"text":"            length = (n[axis] - 1) * cell\r"},{"line":102,"text":"            for i in range(n[a]):\r"},{"line":103,"text":"                for j in range(n[b]):\r"},{"line":104,"text":"                    o = [0.0, 0.0, 0.0]\r"},{"line":105,"text":"                    o[a] = lo[a] + i * cell\r"},{"line":106,"text":"                    o[b] = lo[b] + j * cell\r"},{"line":107,"text":"                    o[axis] = lo[axis] - 0.001\r"},{"line":108,"text":"                    o = Vector(o)\r"},{"line":109,"text":"                    hits, t0 = [], 0.0\r"},{"line":110,"text":"                    for _ in range(64):\r"},{"line":111,"text":"                        h = bvh.ray_cast(o + dirv * t0, dirv, length + 0.002 - t0)\r"},{"line":112,"text":"                        if h[0] is None:\r"},{"line":113,"text":"                            break\r"},{"line":114,"text":"                        t_hit = (h[0] - o).dot(dirv)\r"},{"line":115,"text":"                        hits.append(t_hit)\r"},{"line":116,"text":"                        t0 = t_hit + 1e-5\r"},{"line":117,"text":"                    if len(hits) < 2:\r"},{"line":118,"text":"                        continue\r"},{"line":119,"text":"                    ts = (np.arange(n[axis]) * cell + 0.001)\r"},{"line":120,"text":"                    cnt = np.searchsorted(np.array(hits), ts)\r"},{"line":121,"text":"                    line = (cnt % 2 == 1).astype(np.int8)\r"},{"line":122,"text":"                    sl = [slice(None)] * 3\r"},{"line":123,"text":"                    sl[a], sl[b] = i, j\r"},{"line":124,"text":"                    ins[tuple(sl)] = line\r"},{"line":125,"text":"            return ins\r"},{"line":126,"text":"        inside = (row_inside(0) + row_inside(2)) >= 1\r"},{"line":127,"text":"        # the distance: the nearest surface, for every cell (far cells clamped)\r"},{"line":128,"text":"        d = np.empty((nx, ny, nz), dtype=np.float32)\r"},{"line":129,"text":"        band = SDF_BAND_CM / 100.0\r"},{"line":130,"text":"        for i in range(nx):\r"},{"line":131,"text":"            for j in range(ny):\r"},{"line":132,"text":"                for k in range(nz):\r"},{"line":133,"text":"                    q = Vector((lo[0] + i * cell, lo[1] + j * cell, lo[2] + k * cell))\r"},{"line":134,"text":"                    loc, _nr, _ix, dist = bvh.find_nearest(q, band)\r"},{"line":135,"text":"                    dist = band if loc is None else dist\r"},{"line":136,"text":"                    d[i, j, k] = -dist if inside[i, j, k] else dist\r"},{"line":137,"text":"        np.savez_compressed(path, origin=lo, cell=cell, d=d)\r"},{"line":138,"text":"        return {\"origin\": lo, \"cell\": cell, \"d\": d, \"path\": path}\r"}],"name":"build_sdf","start_line":77,"symbol_id":"hold-code/poselab_mcp/blender/sdflab.py#method:SdfMixin.build_sdf"}}
