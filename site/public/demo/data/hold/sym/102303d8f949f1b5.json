  sc.display.shading.light = 'STUDIO'\r"},{"line":120,"text":"    sc.render.resolution_x, sc.render.resolution_y = 960, 600\r"},{"line":121,"text":"    sc.render.film_transparent = False\r"},{"line":122,"text":"    sc.world = bpy.data.worlds.new(\"w\")\r"},{"line":123,"text":"    sc.world.color = (0.93, 0.93, 0.9)\r"},{"line":124,"text":"    pts = [o.matrix_world @ Vector(c) for o in sc.objects if o.type == 'MESH' for c in o.bound_box]\r"},{"line":125,"text":"    lo = Vector((min(p.x for p in pts), min(p.y for p in pts), min(p.z for p in pts)))\r"},{"line":126,"text":"    hi = Vector((max(p.x for p in pts), max(p.y for p in pts), max(p.z for p in pts)))\r"},{"line":127,"text":"    mid, size = (lo + hi) / 2, max((hi - lo).length, 0.1)\r"},{"line":128,"text":"    cam_data = bpy.data.cameras.new(\"c\")\r"},{"line":129,"text":"    cam_data.type = 'ORTHO'\r"},{"line":130,"text":"    cam_data.ortho_scale = size * 1.05\r"},{"line":131,"text":"    cam = bpy.data.objects.new(\"c\", cam_data)\r"},{"line":132,"text":"    sc.collection.objects.link(cam)\r"},{"line":133,"text":"    sc.camera = cam\r"},{"line":134,"text":"    # gun space: +Y along the barrel, +Z up, +X the gun's left (Pose Lab's gun frame)\r"},{"line":135,"text":"    dirs = {\"right\": Vector((-1, 0, 0)), \"left\": Vector((1, 0, 0)), \"top\": Vector((0, 0, 1)), \"bottom\": Vector((0, 0, -1)), \"front\": Vector((0, 1, 0))}\r"},{"line":136,"text":"    made = []\r"},{"line":137,"text":"    for v in views:\r"},{"line":138,"text":"        d = dirs[v]\r"},{"line":139,"text":"        cam.location = mid + d * size * 2\r"},{"line":140,"text":"        up = Vector((0, 1, 0)) if v in (\"top\", \"bottom\") else Vector((0, 0, 1))\r"},{"line":141,"text":"        cam.rotation_euler = (-d).to_track_quat('-Z', 'Y' if v not in (\"top\", \"bottom\") else 'Y').to_euler()\r"},{"line":142,"text":"        if v in (\"top\", \"bottom\"):\r"},{"line":143,"text":"            cam.rotation_euler = (-d).to_track_quat('-Z', 'Y').to_euler()\r"},{"line":144,"text":"        sc.render.filepath = os.path.join(out, \"%s_%s.png\" % (tag, v))\r"},{"line":145,"text":"        bpy.ops.render.render(write_still=True)\r"},{"line":146,"text":"        made.append(sc.render.filepath)\r"},{"line":147,"text":"    return made\r"}],"name":"render","start_line":115,"symbol_id":"hold-code/weaponlab/blender/render_parts.py#func:render"}}
