{"flow":{"kind":"var","name":"SCRIPT","noCFG":true,"reason":"SCRIPT is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":54,"file":"hold-code/weaponlab/blueprint/build.py","kind":"var","language":"python","lines":[{"line":14,"text":"SCRIPT = Path(__file__).resolve().parent / \"blender\" / \"blueprint_build.py\"\r"},{"line":15,"text":"\r"},{"line":16,"text":"\r"},{"line":17,"text":"def magazine_line(outline):\r"},{"line":18,"text":"    \"\"\"A magazine's own line from its side outline: the direction of its longest straight side (a magazine's front\r"},{"line":19,"text":"    and back run along its well; the points' spread would lean toward a slanted outline's diagonal), pointing down,\r"},{"line":20,"text":"    out of the well; and its length along it.\"\"\"\r"},{"line":21,"text":"    import numpy as np\r"},{"line":22,"text":"    P = np.array(outline, dtype=float)\r"},{"line":23,"text":"    segs = [(np.linalg.norm(b - a), b - a) for a, b in zip(P, np.roll(P, -1, axis=0))]\r"},{"line":24,"text":"    d = max(segs, key=lambda s: s[0])[1]\r"},{"line":25,"text":"    d = d / np.linalg.norm(d)\r"},{"line":26,"text":"    if d[1] > 0:\r"},{"line":27,"text":"        d = -d\r"},{"line":28,"text":"    proj = (P - P.mean(axis=0)) @ d\r"},{"line":29,"text":"    return {\"axis\": [0.0, round(float(d[0]), 5), round(float(d[1]), 5)], \"length_cm\": round(float(proj.max() - proj.min()), 3)}\r"},{"line":30,"text":"\r"},{"line":31,"text":"\r"},{"line":32,"text":"def partsmap(bp, blend):\r"},{"line":33,"text":"    \"\"\"The parts map for a built blueprint: Blender's world (metres, Y flipped), forward -Y, up +Z, origin 0.\"\"\"\r"},{"line":34,"text":"    parts = {}\r"},{"line":35,"text":"    for pid, p in bp[\"parts\"].items():\r"},{"line":36,"text":"        if p[\"role\"] == \"body\":\r"},{"line":37,"text":"            continue\r"},{"line":38,"text":"        q = parts.setdefault(p[\"role\"], {\"objects\": []})\r"},{"line":39,"text":"        q[\"objects\"].append(pid)\r"},{"line":40,"text":"        mo = p[\"motion\"]\r"},{"line":41,"text":"        if mo[\"kind\"] in (\"slide\", \"turn\"):\r"},{"line":42,"text":"            q[\"kind\"] = mo[\"kind\"]\r"},{"line":43,"text":"            q[\"axis\"] = mo[\"axis\"]\r"},{"line":44,"text":"        if mo[\"kind\"] == \"slide\":\r"},{"line":45,"text":"            q[\"travel_cm\"] = mo[\"travel_cm\"]\r"},{"line":46,"text":"        elif mo[\"kind\"] == \"turn\":\r"},{"line":47,"text":"            q[\"turn_deg\"] = mo[\"turn_deg\"]\r"},{"line":48,"text":"            q[\"pivot\"] = mo[\"pivot\"]\r"},{"line":49,"text":"        if p.get(\"parent\"):\r"},{"line":50,"text":"            q[\"parent\"] = bp[\"parts\"][p[\"parent\"]][\"role\"]\r"},{"line":51,"text":"    role = {pid: p[\"role\"] for pid, p in bp[\"parts\"].items()}\r"},{"line":52,"text":"    mark_parts = {}\r"},{"line":53,"text":"    for m, chain in bp.get(\"mark_parts\", {}).items():\r"},{"line":54,"text":"        roles = [role[c] for c in ([chain] if isinstance(chain, str) else chain) if role[c] != \"body\"]\r"}],"name":"SCRIPT","start_line":14,"symbol_id":"hold-code/weaponlab/blueprint/build.py#var:SCRIPT"}}
