{"flow":{"kind":"var","name":"STATUS","noCFG":true,"reason":"STATUS is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":63,"file":"hold-code/weaponlab/spec.py","kind":"var","language":"python","lines":[{"line":23,"text":"STATUS = (\"measured\", \"proposed\")\r"},{"line":24,"text":"FACT_KINDS = (\"side\", \"travel\", \"count\", \"two_hand\", \"edge_leads\", \"bone\", \"order\", \"below\", \"in\")\r"},{"line":25,"text":"DEFAULT_LIMITS = {\"wrist_deg\": 30.0, \"elbow_under_shoulder_cm\": 2.0, \"elbow_bend\": [5.0, 150.0], \"clearance_cm\": 0.2,\r"},{"line":26,"text":"                  \"contacts\": [], \"view_budget\": None}\r"},{"line":27,"text":"\r"},{"line":28,"text":"\r"},{"line":29,"text":"def path_of(weapon_id):\r"},{"line":30,"text":"    return project().specs / (weapon_id + \".json\")\r"},{"line":31,"text":"\r"},{"line":32,"text":"\r"},{"line":33,"text":"def list_specs():\r"},{"line":34,"text":"    folder = project().specs\r"},{"line":35,"text":"    out = []\r"},{"line":36,"text":"    for p in sorted(folder.glob(\"*.json\")) if folder.exists() else []:\r"},{"line":37,"text":"        try:\r"},{"line":38,"text":"            s = json.loads(p.read_text(encoding=\"utf-8-sig\"))\r"},{"line":39,"text":"            out.append({\"id\": s.get(\"id\", p.stem), \"name\": s.get(\"name\"), \"family\": s.get(\"family\"),\r"},{"line":40,"text":"                        \"marks\": len(s.get(\"marks\", {})), \"actions\": sorted(s.get(\"actions\", {})),\r"},{"line":41,"text":"                        \"proposed_marks\": sorted(k for k, m in s.get(\"marks\", {}).items() if m.get(\"status\") != \"measured\")})\r"},{"line":42,"text":"        except ValueError as e:\r"},{"line":43,"text":"            out.append({\"id\": p.stem, \"error\": \"not JSON: %s\" % e})\r"},{"line":44,"text":"    return out\r"},{"line":45,"text":"\r"},{"line":46,"text":"\r"},{"line":47,"text":"def read_spec(weapon_id):\r"},{"line":48,"text":"    p = path_of(weapon_id)\r"},{"line":49,"text":"    if not p.exists():\r"},{"line":50,"text":"        raise FileNotFoundError(\"no spec for %s (%s)\" % (weapon_id, p))\r"},{"line":51,"text":"    s = json.loads(p.read_text(encoding=\"utf-8-sig\"))\r"},{"line":52,"text":"    lim = copy.deepcopy(DEFAULT_LIMITS)\r"},{"line":53,"text":"    lim.update(s.get(\"limits\", {}))\r"},{"line":54,"text":"    s[\"limits\"] = lim\r"},{"line":55,"text":"    return s\r"},{"line":56,"text":"\r"},{"line":57,"text":"\r"},{"line":58,"text":"def _vec(v):\r"},{"line":59,"text":"    return isinstance(v, list) and len(v) == 3 and all(isinstance(x, (int, float)) for x in v)\r"},{"line":60,"text":"\r"},{"line":61,"text":"\r"},{"line":62,"text":"def validate(spec):\r"},{"line":63,"text":"    \"\"\"Every problem with a spec, as sentences; an empty list means it is whole.\"\"\"\r"}],"name":"STATUS","start_line":23,"symbol_id":"hold-code/weaponlab/spec.py#var:STATUS"}}
