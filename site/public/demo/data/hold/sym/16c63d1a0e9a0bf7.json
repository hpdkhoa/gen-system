"text":"        idle = getattr(self, \"idle_world\", {})\r"},{"line":2797,"text":"        if lo not in idle or hn not in idle:\r"},{"line":2798,"text":"            return None\r"},{"line":2799,"text":"\r"},{"line":2800,"text":"        def twist(Lm, Hm):\r"},{"line":2801,"text":"            lq = Lm.to_quaternion()\r"},{"line":2802,"text":"            axis = lq.inverted() @ (Hm.translation - Lm.translation)\r"},{"line":2803,"text":"            if axis.length < 1e-9:\r"},{"line":2804,"text":"                return None\r"},{"line":2805,"text":"            rel = lq.inverted() @ Hm.to_quaternion()\r"},{"line":2806,"text":"            p = Vector((rel.x, rel.y, rel.z)).project(axis.normalized())\r"},{"line":2807,"text":"            return Quaternion((rel.w, p.x, p.y, p.z)).normalized()\r"},{"line":2808,"text":"        now, base = twist(self._bw(lo), self._bw(hn)), twist(idle[lo], idle[hn])\r"},{"line":2809,"text":"        if now is None or base is None:\r"},{"line":2810,"text":"            return None\r"},{"line":2811,"text":"        return now @ base.inverted()\r"}],"name":"_twist_change","start_line":2792,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._twist_change"}}
