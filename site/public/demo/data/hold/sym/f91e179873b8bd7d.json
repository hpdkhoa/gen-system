         improved = True\r"},{"line":1066,"text":"            while improved:\r"},{"line":1067,"text":"                improved = False\r"},{"line":1068,"text":"                for mv in moves:\r"},{"line":1069,"text":"                    for sg in (1.0, -1.0):\r"},{"line":1070,"text":"                        self.snapshot(\"save\", \"_ds\")\r"},{"line":1071,"text":"                        mv(sg * st)\r"},{"line":1072,"text":"                        bpy.context.view_layer.update()\r"},{"line":1073,"text":"                        w1 = self.wall_faults(side, other)\r"},{"line":1074,"text":"                        if not self._walls_hold(w1, w0):\r"},{"line":1075,"text":"                            self.snapshot(\"load\", \"_ds\")\r"},{"line":1076,"text":"                            continue\r"},{"line":1077,"text":"                        e1 = err_fn()\r"},{"line":1078,"text":"                        if self._walls_rank(w1) < self._walls_rank(w0) or e1 < e0 - 1e-6:\r"},{"line":1079,"text":"                            e0, w0, improved = e1, w1, True\r"},{"line":1080,"text":"                        else:\r"},{"line":1081,"text":"                            self.snapshot(\"load\", \"_ds\")\r"},{"line":1082,"text":"        return e0\r"}],"name":"_descend","start_line":1056,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#method:HoldMixin._descend"}}
