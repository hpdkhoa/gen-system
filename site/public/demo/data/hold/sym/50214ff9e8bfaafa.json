e, N=None):\r"},{"line":227,"text":"        \"\"\"hand_labels as arrays: (vertex indices, labels), worked out with numpy (the search reads it each try).\"\"\"\r"},{"line":228,"text":"        if P is None:\r"},{"line":229,"text":"            P, N, _A, _b, _t = self._skin_arrays()\r"},{"line":230,"text":"        _bone, _T, sidev, kind, segi = self._skin_static()\r"},{"line":231,"text":"        sc_ = 1 if side == \"r\" else 2\r"},{"line":232,"text":"        sel = (sidev == sc_) & (kind > 0)\r"},{"line":233,"text":"        idx = np.nonzero(sel)[0]\r"},{"line":234,"text":"        hand = self._n(\"hand\", side)\r"},{"line":235,"text":"        f0 = self._palm_facing(side)\r"},{"line":236,"text":"        w = self._bw(hand).translation\r"},{"line":237,"text":"        d0 = (self._bw(self._n(\"finger\", side, \"middle\", \"01\")).translation - w).normalized()\r"},{"line":238,"text":"        d0 = (d0 - f0 * d0.dot(f0)).normalized()\r"},{"line":239,"text":"        web = np.array(self._anchor(side, \"web\"))\r"},{"line":240,"text":"        pads = np.zeros((15, 3))\r"},{"line":241,"text":"        for k, fi in enumerate(DIGITS):\r"},{"line":242,"text":"            for jj, j in enumerate((\"01\", \"02\", \"03\")):\r"},{"line":243,"text":"                if fi == \"thumb\":\r"},{"line":244,"text":"                    try:\r"},{"line":245,"text":"                        n_ = self._n(\"finger\", side, \"thumb\", j)\r"},{"line":246,"text":"                        pd_ = (self._bw(n_).to_quaternion() @ self._thumb_pad_axis(side, j)).normalized()\r"},{"line":247,"text":"                    except Exception:\r"},{"line":248,"text":"                        pd_ = f0\r"},{"line":249,"text":"                else:\r"},{"line":250,"text":"                    a_ = self._bw(self._n(\"finger\", side, fi, j)).translation\r"},{"line":251,"text":"                    b_ = self._bw(self._n(\"finger\", side, fi, (\"02\", \"03\")[jj])).translation if jj < 2 else self._finger_tip(fi, side)\r"},{"line":252,"text":"                    s_ = (b_ - a_).normalized()\r"},{"line":253,"text":"                    th = math.atan2(s_.dot(f0), s_.dot(d0))\r"},{"line":254,"text":"                    pd_ = (f0 * math.cos(th) - d0 * math.sin(th)).normalized()\r"},{"line":255,"text":"                pads[k * 3 + jj] = list(pd_)\r"},{"line":256,"text":"        lab = np.empty(len(idx), dtype=object)\r"},{"line":257,"text":"        k_ = kind[idx]\r"},{"line":258,"text":"        lab[k_ == 1] = \"forearm\"\r"},{"line":259,"text":"        dig = k_ == 3\r"},{"line":260,"text":"        if dig.any():\r"},{"line":261,"text":"            si = segi[idx[dig]]\r"},{"line":262,"text":"            c = np.einsum(\"ij,ij->i\", N[idx[dig]], pads[si])\r"},{"line":263,"text":"            kd_ = np.where(c > 0.5, \"pad\", np.where(c < -0.5, \"back\", \"side\"))\r"},{"line":264,"text":"            names = np.array([\"%s%d\" % (DIGITS[q // 3], q % 3 + 1) for q in range(15)], dtype=object)\r"},{"line":265,"text":"            lab[dig] = names[si] + \"_\" + kd_.astype(object)\r"},{"line":266,"text":"        pal = k_ == 2\r"},{"line":267,"text":"        if pal.any():\r"},{"line":268,"text":"            pi_ = idx[pal]\r"},{"line":269,"text":"            c = N[pi_] @ np.array(list(f0))\r"},{"line":270,"text":"            nearw = np.linalg.norm(P[pi_] - web, axis=1) <= 0.012\r"},{"line":271,"text":"            lab[pal] = np.where(nearw, \"web\", np.where(c > 0.3, \"palm\", np.where(c < -0.3, \"palm_back\", \"palm_side\")))\r"},{"line":272,"text":"        return idx, lab.tolist()\r"}],"name":"_hand_label_arrays","start_line":226,"symbol_id":"hold-code/poselab_mcp/blender/contactlab.py#method:ContactMixin._hand_label_arrays"}}
