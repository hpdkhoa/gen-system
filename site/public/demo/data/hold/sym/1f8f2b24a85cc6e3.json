"line":69,"text":"def load(action_id):\r"},{"line":70,"text":"    \"\"\"An action, with what its base lends it (\"extends\": a file whose hand clips, gun clips, marks and sources it\r"},{"line":71,"text":"    takes where it has none of its own).\"\"\"\r"},{"line":72,"text":"    p = HERE / (\"%s.json\" % action_id)\r"},{"line":73,"text":"    if not p.exists():\r"},{"line":74,"text":"        raise ValueError(\"no action %r; actions: %s\" % (action_id, \", \".join(ids())))\r"},{"line":75,"text":"    a = json.loads(p.read_text(encoding=\"utf-8\"))\r"},{"line":76,"text":"    if a.get(\"extends\"):\r"},{"line":77,"text":"        base = load(a[\"extends\"])\r"},{"line":78,"text":"        for key in (\"hand_clips\", \"gun_clips\"):\r"},{"line":79,"text":"            a[key] = {**base.get(key, {}), **a.get(key, {})}\r"},{"line":80,"text":"        a[\"marks\"] = list(dict.fromkeys(base.get(\"marks\", []) + a.get(\"marks\", [])))\r"},{"line":81,"text":"        a[\"sources\"] = base.get(\"sources\", []) + a.get(\"sources\", [])\r"},{"line":82,"text":"        a[\"manuals\"] = base.get(\"manuals\", []) + a.get(\"manuals\", [])\r"},{"line":83,"text":"    return a\r"}],"name":"load","start_line":69,"symbol_id":"hold-code/weaponlab/gunkit/actions.py#func:load"}}
