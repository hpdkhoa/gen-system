ue\r"},{"line":1143,"text":"            n = max(2, int((b - a).length / 0.004))\r"},{"line":1144,"text":"            for i in range(n + 1):\r"},{"line":1145,"text":"                q, dq = tree.nearest(a.lerp(b, i / n))\r"},{"line":1146,"text":"                if q is not None:\r"},{"line":1147,"text":"                    best = min(best, (dq - r - g) * 100.0)\r"},{"line":1148,"text":"            for _o, oa, ob, orr in theirs:\r"},{"line":1149,"text":"                best = min(best, (self._seg_seg(a, b, oa, ob) - r - orr - 2 * g) * 100.0)\r"},{"line":1150,"text":"        return best\r"}],"name":"_digit_gap","start_line":1132,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._digit_gap"}}
