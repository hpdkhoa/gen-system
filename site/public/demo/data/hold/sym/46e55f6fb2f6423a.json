stmts":["call sorted"],"succs":[7]}],"effects":["unknown"],"entry":0,"exits":[9],"func_id":"hold-code/poselab_mcp/blender/contactlab.py#method:ContactMixin.conform_digits","issues":null},"source":{"end_line":510,"file":"hold-code/poselab_mcp/blender/contactlab.py","kind":"method","language":"python","lines":[{"line":374,"text":"    def conform_digits(self, side, digits=(\"index\", \"middle\", \"ring\", \"pinky\"), step_deg=3.0, touch_cm=0.08,\r"},{"line":375,"text":"                       other=False, max_steps=60, sample=24, press_cm=0.12):\r"},{"line":376,"text":"        \"\"\"The digits closed onto the object the way a hand closes on a handle: every joint of a finger closes\r"},{"line":377,"text":"        together (the end joints a little slower); when a segment's skin touches the object (or, with other, the\r"},{"line":378,"text":"        other hand) the joints behind it stop and the ones past it keep closing, until each segment rests on the\r"},{"line":379,"text":"        surface or its joint is at its limit; a step that would press a segment past press_cm is taken back. The skin\r"},{"line":380,"text":"        is read once and turned with the joints in numpy (a segment's skin rides its joint's hinge rigidly), so a\r"},{"line":381,"text":"        closing costs no scene update per step; the bones are set once at the end. Returns per digit the degrees\r"},{"line":382,"text":"        each joint closed and which segments touch.\"\"\"\r"},{"line":383,"text":"        bvh, surf = self._object_now()[:2]\r"},{"line":384,"text":"        P, N, _A, _b, _t = self._skin_arrays()\r"},{"line":385,"text":"        _bone, _T, sidev, kind, segi = self._skin_static()\r"},{"line":386,"text":"        sc_ = 1 if side == \"r\" else 2\r"},{"line":387,"text":"        FL = self._limits()[1]\r"},{"line":388,"text":"        TL = self._thumb_limits()\r"},{"line":389,"text":"        fr = self._finger_report(side, FL)[0]\r"},{"line":390,"text":"        tr = self._thumb_report(side, TL)[0]\r"},{"line":391,"text":"        planes = self._finger_report(side, FL)[2]\r"},{"line":392,"text":"        f0 = self._palm_facing(side)\r"},{"line":393,"text":"        oh = None\r"},{"line":394,"text":"        if other:\r"},{"line":395,"text":"            o = \"r\" if side == \"l\" else \"l\"\r"},{"line":396,"text":"            oh = self._other_hand_bvh(o, P, N)\r"},{"line":397,"text":"        out = {}\r"},{"line":398,"text":"        for fi in digits:\r"},{"line":399,"text":"            k0 = DIGITS.index(fi) * 3\r"},{"line":400,"text":"            joints = (\"02\", \"03\") if fi == \"thumb\" else (\"01\", \"02\", \"03\")\r"},{"line":401,"text":"            heads = {}\r"},{"line":402,"text":"            for j in (\"01\", \"02\", \"03\"):\r"},{"line":403,"text":"                heads[j] = np.array(list(self._bw(self._n(\"finger\", side, fi, j)).translation))\r"},{"line":404,"text":"            tip = np.array(list(self._finger_tip(fi, side)))\r"},{"line":405,"text":"            # the hinge of each joint and its closing sign: turning + moves the segment past it toward its pad\r"},{"line":406,"text":"            hinge = {}\r"},{"line":407,"text":"            for j in joints:\r"},{"line":408,"text":"                if fi == \"thumb\":\r"},{"line":409,"text":"                    try:\r"},{"line":410,"text":"                        a = np.array(list(self._thumb_report(side, TL)[2][j]))\r"},{"line":411,"text":"                    except Exception:\r"},{"line":412,"text":"                        continue\r"},{"line":413,"text":"                else:\r"},{"line":414,"text":"                    a = np.array(list(planes[fi]))\r"},{"line":415,"text":"                a = a / max(1e-9, np.linalg.norm(a))\r"},{"line":416,"text":"                nxt = heads[(\"02\", \"03\")[(\"01\", \"02\").index(j)]] if j in (\"01\", \"02\") else tip\r"},{"line":417,"text":"                seg = nxt - heads[j]\r"},{"line":418,"text":"                pad_way = np.array(list(f0))\r"},{"line":419,"text":"                if fi == \"thumb\":\r"},{"line":420,"text":"                    pn = self._n(\"finger\", side, \"thumb\", j)\r"},{"line":421,"text":"                    pad_way = np.array(list((self._bw(pn).to_quaternion() @ self._thumb_pad_axis(side, j)).normalized()))\r"},{"line":422,"text":"                if float(np.dot(np.cross(a, seg), pad_way)) < 0.0:\r"},{"line":423,"text":"                    a = -a\r"},{"line":424,"text":"                hinge[j] = a\r"},{"line":425,"text":"            if not hinge:\r"},{"line":426,"text":"                continue\r"},{"line":427,"text":"            # each segment's skin (sampled), the points that ride each joint\r"},{"line":428,"text":"            segv = {}\r"},{"line":429,"text":"            for jj, j in enumerate((\"01\", \"02\", \"03\")):\r"},{"line":430,"text":"                vi = np.nonzero((sidev == sc_) & (kind == 3) & (segi == k0 + jj))[0]\r"},{"line":431,"text":"                segv[j] = vi[:: max(1, len(vi) // sample)]\r"},{"line":432,"text":"            pts = {j: P[segv[j]].copy() for j in (\"01\", \"02\", \"03\")}\r"},{"line":433,"text":"            hd = {j: heads[j].copy() for j in (\"01\", \"02\", \"03\")}\r"},{"line":434,"text":"            room = {}\r"},{"line":435,"text":"            for j in hinge:\r"},{"line":436,"text":"                if fi == \"thumb\":\r"},{"line":437,"text":"                    cur = tr.get(\"thumb_\" + j, [0.0])[0]\r"},{"line":438,"text":"                    room[j] = max(0.0, TL[j][1] - cur)\r"},{"line":439,"text":"                else:\r"},{"line":440,"text":"                    cur = fr[\"%s_%s\" % (fi, j)][0]\r"},{"line":441,"text":"                    room[j] = max(0.0, FL[j][1] - cur)\r"},{"line":442,"text":"            # the knuckle leads, as a hand closes on a handle: the base segment comes down first, then the middle,\r"},{"line":443,"text":"            # then the end (all three at once land the fingertip first and stop the finger short of a wrap)\r"},{"line":444,"text":"            rate = {\"01\": 1.0, \"02\": 0.5, \"03\": 0.35} if fi != \"thumb\" else {\"02\": 1.0, \"03\": 0.6}\r"},{"line":445,"text":"            closed = {j: 0.0 for j in hinge}\r"},{"line":446,"text":"            active = set(hinge)\r"},{"line":447,"text":"            touching = set()\r"},{"line":448,"text":"\r"},{"line":449,"text":"            def gap(j):\r"},{"line":450,"text":"                best = None\r"},{"line":451,"text":"                if len(pts[j]):\r"},{"line":452,"text":"                    best = float(self.sdf_query(pts[j], want_normal=False)[0].min()) / 100.0\r"},{"line":453,"text":"                for q in (pts[j] if oh is not None else ()):\r"},{"line":454,"text":"                    v = Vector(q)\r"},{"line":455,"text":"                    if oh is not None:\r"},{"line":456,"text":"                        l2, n2, _t2, d2 = oh[0].find_nearest(v, 0.03)\r"},{"line":457,"text":"                        if l2 is not None:\r"},{"line":458,"text":"                            sd2 = -d2 if (v - l2).dot(n2) < 0.0 else d2\r"},{"line":459,"text":"                            best = sd2 if best is None else min(best, sd2)\r"},{"line":460,"text":"                return 99.0 if best is None else best * 100.0\r"},{"line":461,"text":"\r"},{"line":462,"text":"            for _ in range(max_steps):\r"},{"line":463,"text":"                if not active:\r"},{"line":464,"text":"                    break\r"},{"line":465,"text":"                order = [j for j in (\"01\", \"02\", \"03\") if j in active]\r"},{"line":466,"text":"                for j in order:\r"},{"line":467,"text":"                    d_ang = min(step_deg * rate[j], room[j] - closed[j])\r"},{"line":468,"text":"                    if d_ang <= 0.0:\r"},{"line":469,"text":"                        active.discard(j)\r"},{"line":470,"text":"                        continue\r"},{"line":471,"text":"                    ang = math.radians(d_ang)\r"},{"line":472,"text":"                    ride = [k for k in (\"01\", \"02\", \"03\") if k >= j]\r"},{"line":473,"text":"                    saved = {k: pts[k].copy() for k in ride}\r"},{"line":474,"text":"                    saved_h = {k: hd[k].copy() for k in (\"01\", \"02\", \"03\")}\r"},{"line":475,"text":"                    for k in ride:\r"},{"line":476,"text":"                        pts[k] = self._rodrigues(pts[k], hd[j], hinge[j], ang)\r"},{"line":477,"text":"                    for k in (\"02\", \"03\"):\r"},{"line":478,"text":"                        if k > j:\r"},{"line":479,"text":"                            hd[k] = self._rodrigues(hd[k][None, :], hd[j], hinge[j], ang)[0]\r"},{"line":480,"text":"                    worst = min(gap(k) for k in ride)\r"},{"line":481,"text":"                    if worst < -press_cm:\r"},{"line":482,"text":"                        for k in ride:                     # pressed in: the step taken back, this joint stops\r"},{"line":483,"text":"                            pts[k] = saved[k]\r"},{"line":484,"text":"                        hd.update(saved_h)\r"},{"line":485,"text":"                        active.discard(j)\r"},{"line":486,"text":"                        continue\r"},{"line":487,"text":"                    closed[j] += d_ang\r"},{"line":488,"text":"                    for k in ride:\r"},{"line":489,"text":"                        if gap(k) <= touch_cm:\r"},{"line":490,"text":"                            touching.add(k)\r"},{"line":491,"text":"                            for q in (\"01\", \"02\", \"03\"):  # a segment that touches stops its own joint and those behind it\r"},{"line":492,"text":"                                if q <= k:\r"},{"line":493,"text":"                                    active.discard(q)\r"},{"line":494,"text":"            # the bones turned once, by the angles found\r"},{"line":495,"text":"            for j, d_ang in closed.items():\r"},{"line":496,"text":"                if d_ang <= 0.0:\r"},{"line":497,"text":"                    continue\r"},{"line":498,"text":"                if fi == \"thumb\":\r"},{"line":499,"text":"                    if self.R.get(\"thumb_hinge\") == \"ray\":\r"},{"line":500,"text":"                        self._thumb_flex(side, j, d_ang)\r"},{"line":501,"text":"                    else:\r"},{"line":502,"text":"                        t2 = self._thumb_report(side, TL)[0]\r"},{"line":503,"text":"                        b2, b3 = t2.get(\"thumb_02\", [0, 0])[0], t2.get(\"thumb_03\", [0, 0])[0]\r"},{"line":504,"text":"                        self._set_thumb_bend(side, b2 + (d_ang if j == \"02\" else 0.0), b3 + (d_ang if j == \"03\" else 0.0), TL)\r"},{"line":505,"text":"                else:\r"},{"line":506,"text":"                    cur = self._finger_report(side, FL)[0][\"%s_%s\" % (fi, j)][0]\r"},{"line":507,"text":"                    self._set_curl(side, fi, j, cur + d_ang, FL)\r"},{"line":508,"text":"            out[fi] = {\"closed_deg\": {j: round(v, 1) for j, v in closed.items()}, \"touching\": sorted(touching)}\r"},{"line":509,"text":"        bpy.context.view_layer.update()\r"},{"line":510,"text":"        return out\r"}],"name":"conform_digits","start_line":374,"symbol_id":"hold-code/poselab_mcp/blender/contactlab.py#method:ContactMixin.conform_digits"}}
