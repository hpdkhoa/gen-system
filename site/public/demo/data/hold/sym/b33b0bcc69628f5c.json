70,"text":"        if fact not in fs:\r"},{"line":71,"text":"            raise ValueError(\"no fact %s (have %s)\" % (fact, \", \".join(fs)))\r"},{"line":72,"text":"        if fs[fact][\"unit\"] != \"cm\":\r"},{"line":73,"text":"            raise ValueError(\"fact %s is in %s, not a length\" % (fact, fs[fact][\"unit\"]))\r"},{"line":74,"text":"        cm = fs[fact][\"value\"]\r"},{"line":75,"text":"    if not cm:\r"},{"line":76,"text":"        raise ValueError(\"a fact or a length in cm\")\r"},{"line":77,"text":"    px = math.dist(a, b)\r"},{"line":78,"text":"    f[\"scale\"] = {\"cm_per_px\": round(cm / px, 7), \"a\": [round(v, 2) for v in a], \"b\": [round(v, 2) for v in b], \"cm\": round(cm, 4)}\r"},{"line":79,"text":"    if fact:\r"},{"line":80,"text":"        f[\"scale\"][\"fact\"] = fact\r"},{"line":81,"text":"    f[\"scale\"][\"cm_per_px\"] = f[\"scale\"][\"cm\"] / math.dist(f[\"scale\"][\"a\"], f[\"scale\"][\"b\"])\r"},{"line":82,"text":"    store.save(gun, \"sources\", doc)\r"},{"line":83,"text":"    return {\"cm_per_px\": f[\"scale\"][\"cm_per_px\"], \"px\": round(px, 2), \"cm\": cm}\r"}],"name":"calibrate","start_line":64,"symbol_id":"hold-code/weaponlab/blueprint/figures.py#func:calibrate"}}
