t(side, FL)[0]\r"},{"line":1379,"text":"        for fi in (\"index\", \"middle\", \"ring\", \"pinky\"):\r"},{"line":1380,"text":"            if abs(rep_[\"%s_03\" % fi][1]) > FL[\"03\"][2]:\r"},{"line":1381,"text":"                self._set_curl(side, fi, \"03\", 2.0, FL)\r"}],"name":"_end_joints_flat","start_line":1351,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:_end_joints_flat"}}
