, the\r"},{"line":1558,"text":"        pad of an opposable thumb facing them. It then turns with the bone, its roll included.\"\"\"\r"},{"line":1559,"text":"        cache = getattr(self, \"_tpa\", None) or {}\r"},{"line":1560,"text":"        if (side, j) in cache:\r"},{"line":1561,"text":"            return cache[(side, j)]\r"},{"line":1562,"text":"        self.snapshot(\"save\", \"_tpa\")\r"},{"line":1563,"text":"        self.pose_idle()\r"},{"line":1564,"text":"        n3 = self._n(\"finger\", side, \"thumb\", j)\r"},{"line":1565,"text":"        M = self._bw(n3)\r"},{"line":1566,"text":"        nxt = {\"01\": \"02\", \"02\": \"03\"}.get(j)\r"},{"line":1567,"text":"        endp = self._bw(self._n(\"finger\", side, \"thumb\", nxt)).translation if nxt else self._finger_tip(\"thumb\", side)\r"},{"line":1568,"text":"        c = M.translation.lerp(endp, 0.5)\r"},{"line":1569,"text":"        d = (endp - M.translation).normalized()\r"},{"line":1570,"text":"        want = self._bw(self._n(\"finger\", side, \"middle\", \"02\")).translation - c\r"},{"line":1571,"text":"        want = (want - d * want.dot(d)).normalized()\r"},{"line":1572,"text":"        q = M.to_quaternion()\r"},{"line":1573,"text":"        best = None\r"},{"line":1574,"text":"        for ax in (Vector((1, 0, 0)), Vector((-1, 0, 0)), Vector((0, 1, 0)), Vector((0, -1, 0)), Vector((0, 0, 1)), Vector((0, 0, -1))):\r"},{"line":1575,"text":"            w = q @ ax\r"},{"line":1576,"text":"            sc = w.dot(want)\r"},{"line":1577,"text":"            if best is None or sc > best[0]:\r"},{"line":1578,"text":"                best = (sc, ax)\r"},{"line":1579,"text":"        self.snapshot(\"load\", \"_tpa\")\r"},{"line":1580,"text":"        bpy.context.view_layer.update()\r"},{"line":1581,"text":"        cache[(side, j)] = best[1]\r"},{"line":1582,"text":"        self._tpa = cache\r"},{"line":1583,"text":"        return best[1]\r"}],"name":"_thumb_pad_axis","start_line":1555,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._thumb_pad_axis"}}
