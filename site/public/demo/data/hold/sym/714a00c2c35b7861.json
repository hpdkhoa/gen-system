ft, 2) if left is not None else None), round(touching, 2)"}],"preds":[3],"stmts":["call round"],"succs":[20]},{"id":20,"label":"merge","lines":[{"kind":"call","line":313,"text":"return (round(left, 2) if left is not None else None), round(touching, 2)"}],"preds":[19,3],"stmts":["call round","return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[20],"func_id":"hold-code/poselab_mcp/blender/contactlab.py#method:ContactMixin.settle_palm","issues":null},"source":{"end_line":313,"file":"hold-code/poselab_mcp/blender/contactlab.py","kind":"method","language":"python","lines":[{"line":274,"text":"    def settle_palm(self, side, rounds=4, gap_cm=-0.15):\r"},{"line":275,"text":"        \"\"\"The hand slid as one body until its palm's skin just meets the object: each round every palm vertex's\r"},{"line":276,"text":"        signed distance to the surface (inside below 0, by the nearest face's side); palm skin inside pushes the\r"},{"line":277,"text":"        hand out along that face's normal by the deepest, else the hand moves in toward the nearest by its gap less\r"},{"line":278,"text":"        gap_cm (the arm follows). Returns the gap left (cm; below 0 still in the object) and the palm's touching\r"},{"line":279,"text":"        area (cm2).\"\"\"\r"},{"line":280,"text":"        hn = self._n(\"hand\", side)\r"},{"line":281,"text":"        bvh, surf = self._object_now()[:2]\r"},{"line":282,"text":"        left, touching = None, 0.0\r"},{"line":283,"text":"        for _ in range(rounds):\r"},{"line":284,"text":"            P, N, A, _b, _t = self._skin_arrays()\r"},{"line":285,"text":"            idx, lab = self._hand_label_arrays(side, P, N)\r"},{"line":286,"text":"            pv = [int(i) for i, l_ in zip(idx, lab) if l_ in (\"palm\", \"palm_side\")]\r"},{"line":287,"text":"            if not pv:\r"},{"line":288,"text":"                break\r"},{"line":289,"text":"            pv = np.array(pv)\r"},{"line":290,"text":"            D, _w, Nr = self.sdf_query(P[pv])            # the grids: signed distance (cm) and outward normal\r"},{"line":291,"text":"            touching = float(A[pv][D <= 0.2].sum())\r"},{"line":292,"text":"            kw = int(np.argmin(D))\r"},{"line":293,"text":"            worst = (float(D[kw]) / 100.0, Vector(Nr[kw]))\r"},{"line":294,"text":"            outs = np.nonzero(D >= 0.0)[0]\r"},{"line":295,"text":"            near_ = None\r"},{"line":296,"text":"            if len(outs):\r"},{"line":297,"text":"                kn = outs[int(np.argmin(D[outs]))]\r"},{"line":298,"text":"                near_ = (float(D[kn]) / 100.0, -Vector(Nr[kn]) * (float(D[kn]) / 100.0))\r"},{"line":299,"text":"            if worst is None:\r"},{"line":300,"text":"                break\r"},{"line":301,"text":"            left = worst[0] * 100.0\r"},{"line":302,"text":"            give = SKIN_GIVE[\"palm\"] / 100.0\r"},{"line":303,"text":"            if worst[0] < -give - 0.0005:\r"},{"line":304,"text":"                move = worst[1].normalized() * (-worst[0] - give + 0.0005)              # out, to its give\r"},{"line":305,"text":"            elif near_ is not None and near_[0] * 100.0 > gap_cm + 0.02 and near_[1].length > 1e-9:\r"},{"line":306,"text":"                move = near_[1].normalized() * (near_[0] - gap_cm / 100.0)           # in, until it meets\r"},{"line":307,"text":"            else:\r"},{"line":308,"text":"                break\r"},{"line":309,"text":"            H = self._bw(hn).copy()\r"},{"line":310,"text":"            M = Matrix.Translation(move) @ H\r"},{"line":311,"text":"            self._put_hand(side, Matrix.LocRotScale(M.translation, M.to_quaternion(), self._unit()))\r"},{"line":312,"text":"            bpy.context.view_layer.update()\r"},{"line":313,"text":"        return (round(left, 2) if left is not None else None), round(touching, 2)\r"}],"name":"settle_palm","start_line":274,"symbol_id":"hold-code/poselab_mcp/blender/contactlab.py#method:ContactMixin.settle_palm"}}
