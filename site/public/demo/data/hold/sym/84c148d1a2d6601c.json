"line":1795,"text":"        verts = self._gun_verts()\r"},{"line":1796,"text":"        for rule in rules:\r"},{"line":1797,"text":"            r_ = self._rule_eval(side, rule, glove_cm, verts)\r"},{"line":1798,"text":"            if \"touch\" in r_:\r"},{"line":1799,"text":"                r_[\"touch\"] = r2(self._to(r_[\"touch\"], frame), 2) if frame != \"world\" else [round(x, 4) for x in r_[\"touch\"]]\r"},{"line":1800,"text":"                G = self._gun().to_quaternion()\r"},{"line":1801,"text":"                r_[\"normal\"] = r2(G.inverted() @ r_[\"normal\"], 2) if frame == \"gun\" else [round(x, 3) for x in r_[\"normal\"]]\r"},{"line":1802,"text":"            r_[\"need\"] = rule.get(\"need\", \"required\")\r"},{"line":1803,"text":"            out[\"rules\"].append(r_)\r"},{"line":1804,"text":"            if r_[\"need\"] == \"required\" and not r_[\"met\"]:\r"},{"line":1805,"text":"                out[\"ok\"] = False\r"},{"line":1806,"text":"        if wrap:\r"},{"line":1807,"text":"            w = self._wrap(tuple(wrap.get(\"sides\") or (side,)), wrap[\"polys\"], glove_cm)\r"},{"line":1808,"text":"            out[\"wrap\"] = {\"share\": round(w, 2), \"min\": wrap.get(\"min\", 0.5), \"met\": w >= wrap.get(\"min\", 0.5)}\r"},{"line":1809,"text":"            out[\"ok\"] = out[\"ok\"] and out[\"wrap\"][\"met\"]\r"},{"line":1810,"text":"        tc = self._touches(tuple(closure_sides or (side,)), glove_cm)\r"},{"line":1811,"text":"        closed, margin = self._closure(tc, friction)\r"},{"line":1812,"text":"        out[\"closure\"] = {\"closed\": closed, \"margin\": margin, \"touches\": len(tc), \"friction\": friction}\r"},{"line":1813,"text":"        out[\"ok\"] = out[\"ok\"] and closed\r"},{"line":1814,"text":"        return out\r"}],"name":"contacts","start_line":1786,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.contacts"}}
