"    bad = _schema_problems(doc, \"blueprint\")\r"},{"line":84,"text":"    if bad:\r"},{"line":85,"text":"        return bad\r"},{"line":86,"text":"    if sources is None:\r"},{"line":87,"text":"        p = Path(doc[\"sources\"])\r"},{"line":88,"text":"        if p.exists():\r"},{"line":89,"text":"            sources = json.loads(p.read_text(encoding=\"utf-8\"))\r"},{"line":90,"text":"    if action is None:\r"},{"line":91,"text":"        try:\r"},{"line":92,"text":"            from ..gunkit import actions as A\r"},{"line":93,"text":"            action = A.load(doc[\"action\"])\r"},{"line":94,"text":"        except Exception as e:                     # an unknown action is itself a problem\r"},{"line":95,"text":"            bad.append(\"action %s: %s\" % (doc[\"action\"], e))\r"},{"line":96,"text":"    figs = {f[\"id\"] for f in (sources or {}).get(\"figures\", [])}\r"},{"line":97,"text":"    facts = {f[\"id\"] for f in (sources or {}).get(\"facts\", [])}\r"},{"line":98,"text":"\r"},{"line":99,"text":"    def ref_ok(where, r):\r"},{"line":100,"text":"        if sources is None:\r"},{"line":101,"text":"            return\r"},{"line":102,"text":"        if \"figure\" in r and r[\"figure\"] not in figs:\r"},{"line":103,"text":"            bad.append(\"%s: figure %s is not in the sources\" % (where, r[\"figure\"]))\r"},{"line":104,"text":"        if \"fact\" in r and r[\"fact\"] not in facts:\r"},{"line":105,"text":"            bad.append(\"%s: fact %s is not in the sources\" % (where, r[\"fact\"]))\r"},{"line":106,"text":"\r"},{"line":107,"text":"    roles = set((action or {}).get(\"parts\", {}))\r"},{"line":108,"text":"    for pid, p in doc[\"parts\"].items():\r"},{"line":109,"text":"        sh, mo = p[\"shape\"], p.get(\"motion\")\r"},{"line":110,"text":"        extra = tuple(k for k in (\"front\", \"top\") if sh[\"kind\"] == \"views\" and k in sh)\r"},{"line":111,"text":"        for key in NEEDS[sh[\"kind\"]] + extra + (NEEDS[mo[\"kind\"]] if mo else ()) + ((\"bevel_cm\",) if p.get(\"bevel_cm\") else ()):\r"},{"line":112,"text":"            if key not in p[\"sources\"]:\r"},{"line":113,"text":"                bad.append(\"part %s: no source for its %s\" % (pid, key))\r"},{"line":114,"text":"        for key, r in p[\"sources\"].items():\r"},{"line":115,"text":"            ref_ok(\"part %s %s\" % (pid, key), r)\r"},{"line":116,"text":"        for n, h in enumerate(p.get(\"holes\", [])):\r"},{"line":117,"text":"            ref_ok(\"part %s hole %d\" % (pid, n), h[\"source\"])\r"},{"line":118,"text":"        for n, ft in enumerate(p.get(\"features\", [])):\r"},{"line":119,"text":"            ref_ok(\"part %s feature %d\" % (pid, n), ft[\"source\"])\r"},{"line":120,"text":"        if sh[\"kind\"] in (\"extrude\", \"views\") and sh[\"x\"][0] >= sh[\"x\"][1]:\r"},{"line":121,"text":"            bad.append(\"part %s: its x runs from the right (x0) to the left (x1); x0 < x1\" % pid)\r"},{"line":122,"text":"        if sh[\"kind\"] == \"lathe\" and any(r < 0 for _, r in sh[\"profile\"]):\r"},{"line":123,"text":"            bad.append(\"part %s: a lathe profile's radius is never below 0\" % pid)\r"},{"line":124,"text":"        if action is not None and p[\"role\"] != \"body\" and p[\"role\"] not in roles:\r"},{"line":125,"text":"            bad.append(\"part %s: role %s is not body or a part of %s (%s)\" % (pid, p[\"role\"], doc[\"action\"], \", \".join(sorted(roles))))\r"},{"line":126,"text":"        if p.get(\"parent\") and p[\"parent\"] not in doc[\"parts\"]:\r"},{"line":127,"text":"            bad.append(\"part %s: parent %s is not a part\" % (pid, p[\"parent\"]))\r"},{"line":128,"text":"        if p[\"role\"] != \"body\" and not mo:\r"},{"line":129,"text":"            bad.append(\"part %s: a moving part (%s) needs its motion\" % (pid, p[\"role\"]))\r"},{"line":130,"text":"    if action is not None:\r"},{"line":131,"text":"        have = {p[\"role\"] for p in doc[\"parts\"].values()}\r"},{"line":132,"text":"        for role, want in action[\"parts\"].items():\r"},{"line":133,"text":"            if want.get(\"required\", True) and role not in have:\r"},{"line":134,"text":"                bad.append(\"the action %s needs a part with role %s (%s)\" % (doc[\"action\"], role, want.get(\"what\", \"\")))\r"},{"line":135,"text":"        for m in action.get(\"marks\", []):\r"},{"line":136,"text":"            if m not in doc[\"marks\"]:\r"},{"line":137,"text":"                bad.append(\"the action %s needs the mark %s\" % (doc[\"action\"], m))\r"},{"line":138,"text":"    for m, x in doc[\"marks\"].items():\r"},{"line":139,"text":"        ref_ok(\"mark %s\" % m, x[\"source\"])\r"},{"line":140,"text":"    for m, chain in doc.get(\"mark_parts\", {}).items():\r"},{"line":141,"text":"        if m not in doc[\"marks\"]:\r"},{"line":142,"text":"            bad.append(\"mark_parts: %s is not a mark\" % m)\r"},{"line":143,"text":"        for pid in [chain] if isinstance(chain, str) else chain:\r"},{"line":144,"text":"            if pid not in doc[\"parts\"]:\r"},{"line":145,"text":"                bad.append(\"mark_parts: %s rides %s, which is not a part\" % (m, pid))\r"},{"line":146,"text":"    return bad\r"}],"name":"check_blueprint","start_line":80,"symbol_id":"hold-code/weaponlab/contracts/__init__.py#func:check_blueprint"}}
