python","lines":[{"line":210,"text":"def hand_clip(action, facts, clip_id, fps=FPS):\r"},{"line":211,"text":"    \"\"\"The hand clip's frames: the parts (the gun clip of the same name moves them, or they rest), the gun's pose and\r"},{"line":212,"text":"    each hand's way from one target to the next.\"\"\"\r"},{"line":213,"text":"    clip = action[\"hand_clips\"][clip_id]\r"},{"line":214,"text":"    gun = action[\"gun_clips\"].get(clip_id, {\"seconds\": clip[\"seconds\"], \"beats\": []})\r"},{"line":215,"text":"    merged = {\"beats\": _beats(gun.get(\"beats\", []), facts), \"events\": clip.get(\"events\", [])}\r"},{"line":216,"text":"    events = {h: sorted([e for e in clip.get(\"events\", []) if e[\"hand\"] == h], key=lambda e: e[\"from\"]) for h in (\"r\", \"l\")}\r"},{"line":217,"text":"    # where each hand rests: the right on the grip, the left on the support, unless the action says (a bow: the left\r"},{"line":218,"text":"    # on its grip, the right on the string)\r"},{"line":219,"text":"    home = {h: dict(v) for h, v in action.get(\"home\", {\"r\": {\"mark\": \"grip\"}, \"l\": {\"mark\": \"support\"}}).items()}\r"},{"line":220,"text":"    out = []\r"},{"line":221,"text":"    for t in frames_of(clip[\"seconds\"], fps):\r"},{"line":222,"text":"        values = part_values(action, merged, t, kind=\"hand\")\r"},{"line":223,"text":"        hands = {}\r"},{"line":224,"text":"        for h in (\"r\", \"l\"):\r"},{"line":225,"text":"            prev, cur, w, grasp = home[h], None, 1.0, \"palm\"\r"},{"line":226,"text":"            for e in events[h]:\r"},{"line":227,"text":"                if t < e[\"from\"]:\r"},{"line":228,"text":"                    break\r"},{"line":229,"text":"                span = e[\"to\"] - e[\"from\"]\r"},{"line":230,"text":"                x = 1.0 if span <= 0 else (t - e[\"from\"]) / span\r"},{"line":231,"text":"                if t < e[\"to\"]:\r"},{"line":232,"text":"                    cur, w = e[\"go\"], ease(x, e.get(\"ease\", \"inout\"))\r"},{"line":233,"text":"                    grasp = e.get(\"grasp\", grasp)\r"},{"line":234,"text":"                    break\r"},{"line":235,"text":"                prev, grasp = e[\"go\"], e.get(\"grasp\", grasp)\r"},{"line":236,"text":"            a = _resolve(facts, values, prev)\r"},{"line":237,"text":"            b = _resolve(facts, values, cur) if cur else a\r"},{"line":238,"text":"            hands[h] = {\"a\": a, \"b\": b, \"w\": round(w if cur else 1.0, 4), \"grasp\": grasp}\r"},{"line":239,"text":"        out.append({\"t\": t, \"parts\": values, \"gun\": _pose(clip, t), \"hands\": hands})\r"},{"line":240,"text":"    return {\"clip\": clip_id, \"seconds\": clip[\"seconds\"], \"fps\": fps, \"loop\": bool(clip.get(\"loop\")), \"frames\": out,\r"},{"line":241,"text":"            \"expect\": clip.get(\"expect\", [])}\r"}],"name":"hand_clip","start_line":210,"symbol_id":"hold-code/weaponlab/gunkit/timeline.py#func:hand_clip"}}
