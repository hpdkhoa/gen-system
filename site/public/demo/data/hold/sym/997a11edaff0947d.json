,"text":"                        best = (gap, q, nn)\r"},{"line":1726,"text":"                if best and best[0] <= within_cm:\r"},{"line":1727,"text":"                    out.append((name, best[1], best[2]))\r"},{"line":1728,"text":"        return out\r"}],"name":"_touches","start_line":1707,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:_touches"}}
