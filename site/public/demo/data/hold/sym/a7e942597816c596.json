 []\r"},{"line":70,"text":"    for wid in weapon_ids:\r"},{"line":71,"text":"        w = arsenal.get(wid, {\"id\": wid})\r"},{"line":72,"text":"        acts = dict(table.get(w.get(\"kind\"), table[\"*\"]))\r"},{"line":73,"text":"        bones, support = {}, None\r"},{"line":74,"text":"        if wid in specs:\r"},{"line":75,"text":"            sp = S.read_spec(wid)\r"},{"line":76,"text":"            for name in sp.get(\"actions\", {}):\r"},{"line":77,"text":"                if name in table.get(\"spec\", {}):\r"},{"line":78,"text":"                    acts[name] = table[\"spec\"][name]\r"},{"line":79,"text":"            for mname, m in sp.get(\"marks\", {}).items():\r"},{"line":80,"text":"                if m.get(\"bone\"):\r"},{"line":81,"text":"                    bones[mname] = m[\"bone\"]\r"},{"line":82,"text":"            if \"support_l\" in sp.get(\"marks\", {}):\r"},{"line":83,"text":"                support = sp[\"marks\"][\"support_l\"][\"at\"]\r"},{"line":84,"text":"        names = actions or list(acts)\r"},{"line":85,"text":"        item = {\"id\": wid, \"actions\": [dict(name=n, **acts[n]) for n in names if n in acts]}\r"},{"line":86,"text":"        if not item[\"actions\"]:\r"},{"line":87,"text":"            continue\r"},{"line":88,"text":"        for a in item[\"actions\"]:\r"},{"line":89,"text":"            if at and a[\"name\"] in at:\r"},{"line":90,"text":"                a[\"at\"] = list(at[a[\"name\"]])\r"},{"line":91,"text":"        if bones:\r"},{"line":92,"text":"            item[\"bones\"] = bones\r"},{"line":93,"text":"        if support:\r"},{"line":94,"text":"            item[\"support_l\"] = support\r"},{"line":95,"text":"        if tune and wid in tune:\r"},{"line":96,"text":"            item[\"tune\"] = tune[wid]\r"},{"line":97,"text":"        out.append(item)\r"},{"line":98,"text":"    return out\r"}],"name":"job_for","start_line":62,"symbol_id":"hold-code/weaponlab/probe.py#func:job_for"}}
