ull,"succs":[12]},{"id":12,"label":"merge","preds":[11],"stmts":null,"succs":[9]},{"id":13,"label":"else","lines":[{"kind":"return","line":585,"text":"raise ValueError(\"frame must be gun, arms or view\")"}],"preds":[10],"stmts":["return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[1,3,13,6],"func_id":"hold-code/poselab_mcp/blender/lab.py#func:turn_bone","issues":null},"source":{"end_line":589,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"func","language":"python","lines":[{"line":568,"text":"    def turn_bone(self, bone, axis, degrees, frame=\"gun\"):\r"},{"line":569,"text":"        \"\"\"One bone turned by degrees about an axis through its head; the bones below it follow, nothing else moves.\r"},{"line":570,"text":"        axis: a direction in the frame (gun, arms or view). The two signs turn opposite ways.\"\"\"\r"},{"line":571,"text":"        self._need()\r"},{"line":572,"text":"        n = self._bone(bone)\r"},{"line":573,"text":"        if n == self.names[\"gun\"]:\r"},{"line":574,"text":"            raise ValueError(\"turn the rifle with move_gun, not turn_bone\")\r"},{"line":575,"text":"        a = Vector(_xyz(axis, \"axis\"))\r"},{"line":576,"text":"        if a.length < 1e-9:\r"},{"line":577,"text":"            raise ValueError(\"the axis has no length\")\r"},{"line":578,"text":"        if frame == \"gun\":\r"},{"line":579,"text":"            d = self._gun().to_quaternion() @ ue(a)\r"},{"line":580,"text":"        elif frame == \"arms\":\r"},{"line":581,"text":"            d = ue(a)\r"},{"line":582,"text":"        elif frame == \"view\":\r"},{"line":583,"text":"            d = VIEW_RIGHT * a.x + VIEW_FWD * a.y + VIEW_UP * a.z\r"},{"line":584,"text":"        else:\r"},{"line":585,"text":"            raise ValueError(\"frame must be gun, arms or view\")\r"},{"line":586,"text":"        head = self._bw(n).translation.copy()\r"},{"line":587,"text":"        self._turn_about(n, d.normalized(), float(degrees), head)\r"},{"line":588,"text":"        # no positions in the reply: a pose tool that answered where a joint sits would be a measuring tool\r"},{"line":589,"text":"        return {\"bone\": n, \"degrees\": float(degrees), \"axis\": r2(Vector(a).normalized(), 3), \"frame\": frame}\r"}],"name":"turn_bone","start_line":568,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:turn_bone"}}
