 = math.tan(math.radians(H_FOV / 2))\r"},{"line":3204,"text":"        x, y = p.x / p.y / t, p.z / p.y / (t / ASPECT)\r"},{"line":3205,"text":"        return {\"on_screen\": abs(x) <= 1.0 and abs(y) <= 1.0, \"x\": round(x, 3), \"y\": round(y, 3)}\r"}],"name":"screen","start_line":3197,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.screen"}}
