,{"line":3178,"text":"        d = (target - self.eye).normalized()\r"},{"line":3179,"text":"        u = d.cross(VIEW_UP)\r"},{"line":3180,"text":"        u = u.normalized() if u.length > 1e-6 else Vector((1, 0, 0))\r"},{"line":3181,"text":"        v = d.cross(u).normalized()\r"},{"line":3182,"text":"        samples = [target]\r"},{"line":3183,"text":"        for ring in range(1, rings + 1):\r"},{"line":3184,"text":"            rr = radius_cm / 100.0 * ring / rings\r"},{"line":3185,"text":"            for k in range(8):\r"},{"line":3186,"text":"                a = 2 * math.pi * k / 8\r"},{"line":3187,"text":"                samples.append(target + (u * math.cos(a) + v * math.sin(a)) * rr)\r"},{"line":3188,"text":"        dg = bpy.context.evaluated_depsgraph_get()\r"},{"line":3189,"text":"        seen = 0\r"},{"line":3190,"text":"        for s in samples:\r"},{"line":3191,"text":"            ray = s - self.eye\r"},{"line":3192,"text":"            hit, loc, nrm, idx, obj, mat = self.sc.ray_cast(dg, self.eye, ray.normalized(), distance=ray.length + 0.01)\r"},{"line":3193,"text":"            if not hit or (loc - s).length < 0.006 or (loc - self.eye).length >= ray.length - 0.006:\r"},{"line":3194,"text":"                seen += 1\r"},{"line":3195,"text":"        return {\"visible\": round(seen / len(samples), 3), \"samples\": len(samples)}\r"}],"name":"visible","start_line":3172,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:visible"}}
