{"flow":{"kind":"var","name":"missing","noCFG":true,"reason":"missing is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":212,"file":"hold-code/weaponlab/gunkit/blender/gunkit_rig.py","kind":"var","language":"python","lines":[{"line":172,"text":"missing = [n for p in pm[\"parts\"].values() for n in p.get(\"objects\", []) if n not in objects]\r"},{"line":173,"text":"if missing:\r"},{"line":174,"text":"    raise SystemExit(\"GUNKIT RIG: the parts map names objects the model does not have: %s; it has: %s\"\r"},{"line":175,"text":"                     % (\", \".join(missing), \", \".join(sorted(objects))))\r"},{"line":176,"text":"\r"},{"line":177,"text":"# --- each part's centre, then the facts (rigplan) --------------------------------------------------------------------\r"},{"line":178,"text":"centres = {}\r"},{"line":179,"text":"for role, p in pm[\"parts\"].items():\r"},{"line":180,"text":"    pts = [Vector(c) for n in p.get(\"objects\", []) for c in [v.co for v in objects[n].data.vertices]]\r"},{"line":181,"text":"    if pts:\r"},{"line":182,"text":"        lo = Vector((min(v.x for v in pts), min(v.y for v in pts), min(v.z for v in pts)))\r"},{"line":183,"text":"        hi = Vector((max(v.x for v in pts), max(v.y for v in pts), max(v.z for v in pts)))\r"},{"line":184,"text":"        centres[role] = gun((lo + hi) / 2.0)\r"},{"line":185,"text":"tri = sum(len(ob.data.polygons) for ob in objects.values())\r"},{"line":186,"text":"facts = R.plan(pm, centres, model={\"source\": \"proxy\" if job.get(\"shapes\") else \"import\", \"from\": pm.get(\"model\"),\r"},{"line":187,"text":"                                   \"triangles\": tri})\r"},{"line":188,"text":"\r"},{"line":189,"text":"# --- one mesh on one armature ------------------------------------------------------------------------------------------\r"},{"line":190,"text":"owner = {n: R.bone_name(role) for role, p in pm[\"parts\"].items() for n in p.get(\"objects\", [])}\r"},{"line":191,"text":"for name, ob in objects.items():\r"},{"line":192,"text":"    vg = ob.vertex_groups.new(name=owner.get(name, \"Root\"))\r"},{"line":193,"text":"    vg.add(list(range(len(ob.data.vertices))), 1.0, 'REPLACE')\r"},{"line":194,"text":"for o in bpy.context.scene.objects:\r"},{"line":195,"text":"    o.select_set(False)\r"},{"line":196,"text":"every = list(objects.values())\r"},{"line":197,"text":"for ob in every:\r"},{"line":198,"text":"    ob.select_set(True)\r"},{"line":199,"text":"bpy.context.view_layer.objects.active = every[0]\r"},{"line":200,"text":"bpy.ops.object.join()\r"},{"line":201,"text":"mesh = bpy.context.object\r"},{"line":202,"text":"mesh.name = NAME + \"_Mesh\"\r"},{"line":203,"text":"arm_data = bpy.data.armatures.new(\"SKEL_\" + NAME)\r"},{"line":204,"text":"arm = bpy.data.objects.new(NAME, arm_data)\r"},{"line":205,"text":"bpy.context.scene.collection.objects.link(arm)\r"},{"line":206,"text":"bpy.context.view_layer.objects.active = arm\r"},{"line":207,"text":"arm.select_set(True)\r"},{"line":208,"text":"bpy.ops.object.mode_set(mode='EDIT')\r"},{"line":209,"text":"for b in facts[\"bones\"]:\r"},{"line":210,"text":"    eb = arm_data.edit_bones.new(b[\"name\"])\r"},{"line":211,"text":"    eb.head = g(*b[\"head\"])\r"},{"line":212,"text":"    eb.tail = eb.head + Vector((0, 0.02, 0))\r"}],"name":"missing","start_line":172,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_rig.py#var:missing"}}
