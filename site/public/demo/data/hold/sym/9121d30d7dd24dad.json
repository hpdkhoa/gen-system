:"inside","id":17,"label":"merge","lines":[{"kind":"call","line":182,"text":"rows.append({\"moment\": Path(obj).stem, \"down_cm\": round(down, 2), \"sideways_cm\": round(lateral, 2), \"tilt_deg\": round(ang, 2), \"in_well\": inside})"}],"preds":[16,15],"stmts":["call rows.append","call Path","call round","call round","call round"],"succs":[18,19]},{"id":18,"label":"then","lines":[{"kind":"call","line":184,"text":"worst_off, worst_ang = max(worst_off, lateral), max(worst_ang, ang)"}],"preds":[17],"stmts":["call max","call max"],"succs":[19]},{"id":19,"label":"merge","preds":[18,17],"stmts":null,"succs":[11]}],"effects":["unknown"],"entry":0,"exits":[1,13],"func_id":"hold-code/weaponlab/rig.py#func:align","issues":null},"source":{"end_line":185,"file":"hold-code/weaponlab/rig.py","kind":"func","language":"python","lines":[{"line":145,"text":"def align(seated_obj, moment_objs, bone, well_depth_cm=4.0, axis=None, column_cm=3.0):\r"},{"line":146,"text":"    \"\"\"The magazine against its seat: each moment's magazine fitted rigidly onto the seated one. While its top is in\r"},{"line":147,"text":"    the well (within well_depth_cm down and column_cm across), its sideways offset (cm) and tilt (deg) from the seated\r"},{"line":148,"text":"    line should be nil. Returns the worst of each and each moment's numbers.\"\"\"\r"},{"line":149,"text":"    A = np.array(read_group(seated_obj, bone))\r"},{"line":150,"text":"    if len(A) < 4:\r"},{"line":151,"text":"        return None\r"},{"line":152,"text":"    ca = A.mean(0)\r"},{"line":153,"text":"    w, v = np.linalg.eigh(np.cov((A - ca).T))\r"},{"line":154,"text":"    ax = v[:, int(np.argmax(w))]\r"},{"line":155,"text":"    if ax[2] < 0:\r"},{"line":156,"text":"        ax = -ax\r"},{"line":157,"text":"    h = (A - ca) @ ax\r"},{"line":158,"text":"    hi = h.max()\r"},{"line":159,"text":"    upper, lower = A[h > hi - 1.0], A[(h < hi - 4.0) & (h > hi - 6.0)]\r"},{"line":160,"text":"    if len(upper) >= 3 and len(lower) >= 3:          # a curved magazine: its straight top's line\r"},{"line":161,"text":"        ax = upper.mean(0) - lower.mean(0)\r"},{"line":162,"text":"        ax /= np.linalg.norm(ax)\r"},{"line":163,"text":"    if axis is not None:                             # the well's own axis (the spec's)\r"},{"line":164,"text":"        ax = np.array(axis, dtype=float)\r"},{"line":165,"text":"        ax /= np.linalg.norm(ax)\r"},{"line":166,"text":"    top = ca + ax * ((A - ca) @ ax).max()\r"},{"line":167,"text":"    rows, worst_off, worst_ang = [], 0.0, 0.0\r"},{"line":168,"text":"    for obj in moment_objs:\r"},{"line":169,"text":"        B = np.array(read_group(obj, bone))\r"},{"line":170,"text":"        if len(B) != len(A):\r"},{"line":171,"text":"            rows.append({\"moment\": Path(obj).stem, \"note\": \"not drawn\"})\r"},{"line":172,"text":"            continue\r"},{"line":173,"text":"        cb = B.mean(0)\r"},{"line":174,"text":"        U, _s, Vt = np.linalg.svd((A - ca).T @ (B - cb))\r"},{"line":175,"text":"        d = np.sign(np.linalg.det(Vt.T @ U.T))\r"},{"line":176,"text":"        R = Vt.T @ np.diag([1, 1, d]) @ U.T\r"},{"line":177,"text":"        disp = R @ (top - ca) + cb - top\r"},{"line":178,"text":"        down = -float(disp @ ax)\r"},{"line":179,"text":"        lateral = float(np.linalg.norm(disp + ax * down))\r"},{"line":180,"text":"        ang = float(np.degrees(np.arccos(max(-1.0, min(1.0, (np.trace(R) - 1) / 2)))))\r"},{"line":181,"text":"        inside = down < well_depth_cm and lateral < column_cm\r"},{"line":182,"text":"        rows.append({\"moment\": Path(obj).stem, \"down_cm\": round(down, 2), \"sideways_cm\": round(lateral, 2), \"tilt_deg\": round(ang, 2), \"in_well\": inside})\r"},{"line":183,"text":"        if inside:\r"},{"line":184,"text":"            worst_off, worst_ang = max(worst_off, lateral), max(worst_ang, ang)\r"},{"line":185,"text":"    return {\"offset_cm\": round(worst_off, 2), \"angle_deg\": round(worst_ang, 2), \"moments\": rows}\r"}],"name":"align","start_line":145,"symbol_id":"hold-code/weaponlab/rig.py#func:align"}}
