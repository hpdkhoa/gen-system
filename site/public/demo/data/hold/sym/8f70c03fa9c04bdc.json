{"flow":{"kind":"var","name":"job","noCFG":true,"reason":"job is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":55,"file":"hold-code/weaponlab/blueprint/blender/blueprint_render.py","kind":"var","language":"python","lines":[{"line":15,"text":"job = json.load(open(sys.argv[sys.argv.index(\"--\") + 1], encoding=\"utf-8\"))\r"},{"line":16,"text":"OUT = job[\"out\"]\r"},{"line":17,"text":"S = float(job.get(\"cm_per_px\", 0.03))\r"},{"line":18,"text":"sc = bpy.context.scene\r"},{"line":19,"text":"obs = [o for o in sc.objects if o.type == 'MESH']\r"},{"line":20,"text":"lo = Vector((min(min((o.matrix_world @ v.co)[i] for v in o.data.vertices) for o in obs) for i in range(3)))\r"},{"line":21,"text":"hi = Vector((max(max((o.matrix_world @ v.co)[i] for v in o.data.vertices) for o in obs) for i in range(3)))\r"},{"line":22,"text":"mid = (lo + hi) / 2.0\r"},{"line":23,"text":"size = hi - lo\r"},{"line":24,"text":"sc.render.engine = 'BLENDER_WORKBENCH'\r"},{"line":25,"text":"sc.display.shading.light = 'STUDIO'\r"},{"line":26,"text":"sc.display.shading.color_type = 'MATERIAL'\r"},{"line":27,"text":"sc.display.shading.show_cavity = True\r"},{"line":28,"text":"sc.display.shading.show_object_outline = True\r"},{"line":29,"text":"sc.render.film_transparent = False\r"},{"line":30,"text":"sc.world = sc.world or bpy.data.worlds.new(\"W\")\r"},{"line":31,"text":"sc.world.color = (1.0, 1.0, 1.0)\r"},{"line":32,"text":"sc.display.shading.background_type = 'WORLD'\r"},{"line":33,"text":"cam_data = bpy.data.cameras.new(\"Cam\")\r"},{"line":34,"text":"cam = bpy.data.objects.new(\"Cam\", cam_data)\r"},{"line":35,"text":"sc.collection.objects.link(cam)\r"},{"line":36,"text":"sc.camera = cam\r"},{"line":37,"text":"out = {\"views\": {}}\r"},{"line":38,"text":"\r"},{"line":39,"text":"\r"},{"line":40,"text":"def shoot(name, loc, look, ortho=True, pad=1.15):\r"},{"line":41,"text":"    cam.location = loc\r"},{"line":42,"text":"    d = (look - loc).normalized()\r"},{"line":43,"text":"    cam.rotation_euler = d.to_track_quat('-Z', 'Y').to_euler()\r"},{"line":44,"text":"    if ortho:\r"},{"line":45,"text":"        cam_data.type = 'ORTHO'\r"},{"line":46,"text":"        w_m = max(size.y, size.x) * pad if abs(d.x) > 0.5 else max(size.y, size.z) * pad\r"},{"line":47,"text":"        h_m = size.z * pad\r"},{"line":48,"text":"        sc.render.resolution_x = int(w_m * 100 / S)\r"},{"line":49,"text":"        sc.render.resolution_y = int(h_m * 100 / S)\r"},{"line":50,"text":"        cam_data.ortho_scale = max(w_m, h_m)\r"},{"line":51,"text":"    else:\r"},{"line":52,"text":"        cam_data.type = 'PERSP'\r"},{"line":53,"text":"        cam_data.lens = 50\r"},{"line":54,"text":"        sc.render.resolution_x, sc.render.resolution_y = 1400, 900\r"},{"line":55,"text":"    sc.render.filepath = os.path.join(OUT, \"%s.png\" % name)\r"}],"name":"job","start_line":15,"symbol_id":"hold-code/weaponlab/blueprint/blender/blueprint_render.py#var:job"}}
