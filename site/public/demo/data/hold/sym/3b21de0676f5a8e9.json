clash\r"},{"line":3766,"text":"                    clash.name = clash.name + \"_kept\"\r"},{"line":3767,"text":"                self.arm.name = root_name\r"},{"line":3768,"text":"            self.sc.render.fps, self.sc.render.fps_base = int(round(fps)), 1.0\r"},{"line":3769,"text":"            self.sc.frame_start, self.sc.frame_end = 0, len(frames) - 1\r"},{"line":3770,"text":"            try:\r"},{"line":3771,"text":"                bpy.ops.export_scene.fbx(filepath=path, use_selection=True, object_types={'ARMATURE'}, add_leaf_bones=False,\r"},{"line":3772,"text":"                                         bake_anim=True, bake_anim_use_all_actions=False, bake_anim_use_nla_strips=False,\r"},{"line":3773,"text":"                                         bake_anim_force_startend_keying=True, bake_anim_simplify_factor=0.0)\r"},{"line":3774,"text":"            finally:\r"},{"line":3775,"text":"                self.arm.name = old_name\r"},{"line":3776,"text":"                if renamed:\r"},{"line":3777,"text":"                    renamed.name = root_name\r"},{"line":3778,"text":"                self.arm.animation_data.action = None\r"},{"line":3779,"text":"                bpy.data.actions.remove(act)\r"},{"line":3780,"text":"                self.sc.render.fps = 30\r"},{"line":3781,"text":"                self._apply(keep)\r"},{"line":3782,"text":"            written.append(path)\r"},{"line":3783,"text":"        return {\"clip\": clip, \"frames\": len(frames), \"fps\": fps, \"written\": written}\r"}],"name":"save_clip","start_line":3730,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.save_clip"}}
