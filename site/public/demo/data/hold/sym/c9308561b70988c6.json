,"text":"    c = P.mean(axis=0)\r"},{"line":101,"text":"    w, v = np.linalg.eigh(np.cov((P - c).T))\r"},{"line":102,"text":"    d = v[:, int(np.argmax(w))]\r"},{"line":103,"text":"    if d[1] < 0:\r"},{"line":104,"text":"        d = -d\r"},{"line":105,"text":"    t = np.array(line[1], dtype=float) - np.array(line[0], dtype=float)\r"},{"line":106,"text":"    t = t / np.linalg.norm(t)\r"},{"line":107,"text":"    if t[1] < 0:\r"},{"line":108,"text":"        t = -t\r"},{"line":109,"text":"    ang = np.arctan2(t[1], t[0]) - np.arctan2(d[1], d[0])\r"},{"line":110,"text":"    R = np.array([[np.cos(ang), -np.sin(ang)], [np.sin(ang), np.cos(ang)]])\r"},{"line":111,"text":"    Q = (P - c) @ R.T + c\r"},{"line":112,"text":"    n = np.array([t[1], -t[0]])                       # square to the line, toward +y (the front) for a line going up\r"},{"line":113,"text":"    if n[0] < 0:\r"},{"line":114,"text":"        n = -n\r"},{"line":115,"text":"    l0 = np.array(line[0], dtype=float)\r"},{"line":116,"text":"    off = (Q - l0) @ n\r"},{"line":117,"text":"    target = -inset_cm if front else inset_cm\r"},{"line":118,"text":"    # one move a*n + b*z that sets both: the side on its inset and the lowest point at bottom_z\r"},{"line":119,"text":"    side = target - (off.max() if front else off.min())\r"},{"line":120,"text":"    drop = bottom_z - Q[:, 1].min()\r"},{"line":121,"text":"    a, b = np.linalg.solve(np.array([[1.0, n[1]], [n[1], 1.0]]), np.array([side, drop]))\r"},{"line":122,"text":"    Q = Q + a * n + np.array([0.0, b])\r"},{"line":123,"text":"    return [[round(float(y), 4), round(float(z), 4)] for y, z in Q], round(float(np.degrees(ang)), 2)\r"}],"name":"fit_along","start_line":94,"symbol_id":"hold-code/weaponlab/blueprint/plan.py#func:fit_along"}}
