.py","kind":"func","language":"python","lines":[{"line":242,"text":"def span(gun, fig_id, a, b, threshold=None, gap_px=0):\r"},{"line":243,"text":"    \"\"\"Where the ink starts and ends along a line from a to b (px): the first and last ink pixel, their distance in\r"},{"line":244,"text":"    cm (when the figure has a scale) and every run of ink along it. gap_px: runs closer than this join.\"\"\"\r"},{"line":245,"text":"    cv2, np = _cv()\r"},{"line":246,"text":"    f = Fg.figure(gun, fig_id)\r"},{"line":247,"text":"    m = ink(gun, f, threshold) > 0\r"},{"line":248,"text":"    n = int(max(abs(b[0] - a[0]), abs(b[1] - a[1]))) + 1\r"},{"line":249,"text":"    xs = np.linspace(a[0], b[0], n).round().astype(int)\r"},{"line":250,"text":"    ys = np.linspace(a[1], b[1], n).round().astype(int)\r"},{"line":251,"text":"    on = m[ys.clip(0, m.shape[0] - 1), xs.clip(0, m.shape[1] - 1)]\r"},{"line":252,"text":"    runs, start = [], None\r"},{"line":253,"text":"    for i, v in enumerate(list(on) + [False]):\r"},{"line":254,"text":"        if v and start is None:\r"},{"line":255,"text":"            start = i\r"},{"line":256,"text":"        elif not v and start is not None:\r"},{"line":257,"text":"            if runs and start - runs[-1][1] <= gap_px:\r"},{"line":258,"text":"                runs[-1][1] = i - 1\r"},{"line":259,"text":"            else:\r"},{"line":260,"text":"                runs.append([start, i - 1])\r"},{"line":261,"text":"            start = None\r"},{"line":262,"text":"    if not runs:\r"},{"line":263,"text":"        return {\"figure\": fig_id, \"ink\": False}\r"},{"line":264,"text":"    first, last = runs[0][0], runs[-1][1]\r"},{"line":265,"text":"    pt = lambda i: [float(xs[i]), float(ys[i])]   # noqa: E731\r"},{"line":266,"text":"    out = {\"figure\": fig_id, \"ink\": True, \"first_px\": pt(first), \"last_px\": pt(last), \"runs\": [[pt(r[0]), pt(r[1])] for r in runs]}\r"},{"line":267,"text":"    if \"scale\" in f:\r"},{"line":268,"text":"        step = float(np.hypot(b[0] - a[0], b[1] - a[1])) / max(1, n - 1)\r"},{"line":269,"text":"        out[\"cm\"] = round((last - first) * step * f[\"scale\"][\"cm_per_px\"], 4)\r"},{"line":270,"text":"    return out\r"}],"name":"span","start_line":242,"symbol_id":"hold-code/weaponlab/blueprint/trace.py#func:span"}}
