es":[{"line":98,"text":"    def object_regions(self, marks=None, left_dir=None):\r"},{"line":99,"text":"        \"\"\"The object's surface sampled every 2 mm and each sample labelled: \"notouch:<part>\" on a part that must\r"},{"line":100,"text":"        stay clear; on a held part, by where it lies round the run and which way it faces (back, front, left,\r"},{"line":101,"text":"        right; \"tang\" above the run facing the palm's way; \"end\" facing along the run; \"opening_edge\" along the\r"},{"line":102,"text":"        opening's edge line); else \"other:<part>\". left_dir: the object's left in the held part's frame (names the\r"},{"line":103,"text":"        sides; else side_a and side_b). Keeps the samples in each part's frame. Returns {label: area cm2}.\"\"\"\r"},{"line":104,"text":"        self._need()\r"},{"line":105,"text":"        obj = getattr(self, \"_object\", None) or self.read_object()\r"},{"line":106,"text":"        pts = self._part_points(spacing_cm=SAMPLE_CM)\r"},{"line":107,"text":"        notouch = {m[\"part\"] for m in (marks or []) if m.get(\"role\") == \"notouch\"}\r"},{"line":108,"text":"        # the regions are named in the object's own frame, by the first hold on each part (a power wrap first): a\r"},{"line":109,"text":"        # second hand's mark on the same part does not rename them\r"},{"line":110,"text":"        holds, seen = [], set()\r"},{"line":111,"text":"        for m in sorted((m for m in (marks or []) if m.get(\"role\") == \"hold\"), key=lambda m: m.get(\"purpose\") != \"power_wrap\"):\r"},{"line":112,"text":"            if m[\"part\"] not in seen:\r"},{"line":113,"text":"                holds.append(m)\r"},{"line":114,"text":"                seen.add(m[\"part\"])\r"},{"line":115,"text":"        samples = []                                   # (part, local point, local normal, label)\r"},{"line":116,"text":"        for part, (P, N) in pts.items():\r"},{"line":117,"text":"            labs = np.array([\"notouch:\" + part if part in notouch else \"other:\" + part] * len(P), dtype=object)\r"},{"line":118,"text":"            for m in holds:\r"},{"line":119,"text":"                if m[\"part\"] != part or part not in obj[\"parts\"] or not obj[\"parts\"][part][\"runs\"]:\r"},{"line":120,"text":"                    continue\r"},{"line":121,"text":"                run = obj[\"parts\"][part][\"runs\"][m.get(\"run\", 0)]\r"},{"line":122,"text":"                d = np.array(run[\"axis\"])\r"},{"line":123,"text":"                inner, outer = np.array(run[\"inner\"]), np.array(run[\"outer\"])\r"},{"line":124,"text":"                inward = d if float((inner - outer) @ d) >= 0 else -d\r"},{"line":125,"text":"                L_run = float(np.linalg.norm(inner - outer))\r"},{"line":126,"text":"                pd = np.array(m.get(\"palm_dir\") or run[\"u\"], dtype=float)\r"},{"line":127,"text":"                pd = pd - inward * float(pd @ inward)\r"},{"line":128,"text":"                pd /= np.linalg.norm(pd)\r"},{"line":129,"text":"                sd = np.cross(inward, pd)\r"},{"line":130,"text":"                web_h = float((np.array(m[\"_web\"]) - inner) @ inward) if m.get(\"_web\") else 0.0\r"},{"line":131,"text":"                h = (P - inner) @ inward\r"},{"line":132,"text":"                radv = (P - inner) - np.outer(h, inward)\r"},{"line":133,"text":"                rad = np.linalg.norm(radv, axis=1)\r"},{"line":134,"text":"                zone = (h >= -L_run - 0.01) & (h <= web_h + 0.012) & (rad <= 0.05)\r"},{"line":135,"text":"                nn = N - np.outer(N @ inward, inward)\r"},{"line":136,"text":"                nl = np.linalg.norm(nn, axis=1)\r"},{"line":137,"text":"                ang = np.degrees(np.arctan2(N @ sd, N @ pd))\r"},{"line":138,"text":"                for i in np.nonzero(zone)[0]:\r"},{"line":139,"text":"                    if nl[i] < 0.5:\r"},{"line":140,"text":"                        labs[i] = \"end\"\r"},{"line":141,"text":"                    elif h[i] > 0.003 and abs(ang[i]) <= 60.0:\r"},{"line":142,"text":"                        labs[i] = \"tang\"\r"},{"line":143,"text":"                    elif abs(ang[i]) <= 45.0:\r"},{"line":144,"text":"                        labs[i] = \"back\"\r"},{"line":145,"text":"                    elif abs(ang[i]) >= 135.0:\r"},{"line":146,"text":"                        labs[i] = \"front\"\r"},{"line":147,"text":"                    else:\r"},{"line":148,"text":"                        nm = \"side_a\" if ang[i] > 0 else \"side_b\"\r"},{"line":149,"text":"                        if left_dir is not None:\r"},{"line":150,"text":"                            ld = np.array(left_dir, dtype=float)\r"},{"line":151,"text":"                            nm = \"left\" if float((sd if ang[i] > 0 else -sd) @ ld) > 0 else \"right\"\r"},{"line":152,"text":"                        labs[i] = nm\r"},{"line":153,"text":"                for op in run.get(\"openings\", [])[:1]:\r"},{"line":154,"text":"                    e0, e1 = np.array(op[\"edge\"][0]), np.array(op[\"edge\"][1])\r"},{"line":155,"text":"                    thru = np.array(op[\"through\"])\r"},{"line":156,"text":"                    ld_ = (e1 - e0) - thru * float((e1 - e0) @ thru)\r"},{"line":157,"text":"                    ln = float(np.linalg.norm(ld_))\r"},{"line":158,"text":"                    if ln < 1e-6:\r"},{"line":159,"text":"                        continue\r"},{"line":160,"text":"                    ld_ /= ln\r"},{"line":161,"text":"                    q = (P - e0) - np.outer((P - e0) @ thru, thru)\r"},{"line":162,"text":"                    t_ = q @ ld_\r"},{"line":163,"text":"                    off = np.linalg.norm(q - np.outer(t_, ld_), axis=1)\r"},{"line":164,"text":"                    sel = (t_ >= -0.005) & (t_ <= ln + 0.005) & (off <= 0.006)\r"},{"line":165,"text":"                    labs[sel & ~np.char.startswith(labs.astype(str), \"notouch\")] = \"opening_edge\"\r"},{"line":166,"text":"            for p_, n_, l_ in zip(P, N, labs):\r"},{"line":167,"text":"                samples.append((part, p_, n_, str(l_)))\r"},{"line":168,"text":"        self._samples = samples\r"},{"line":169,"text":"        a = SAMPLE_CM * SAMPLE_CM\r"},{"line":170,"text":"        out = {}\r"},{"line":171,"text":"        for s_ in samples:\r"},{"line":172,"text":"            out[s_[3]] = out.get(s_[3], 0.0) + a\r"},{"line":173,"text":"        return {k: round(v, 2) for k, v in sorted(out.items())}\r"}],"name":"object_regions","start_line":98,"symbol_id":"hold-code/poselab_mcp/blender/contactlab.py#func:object_regions"}}
