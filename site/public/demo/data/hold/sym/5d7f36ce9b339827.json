{"flow":{"kind":"var","name":"CLIPS","noCFG":true,"reason":"CLIPS is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":55,"file":"hold-code/weaponlab/blueprint/showcase.py","kind":"var","language":"python","lines":[{"line":15,"text":"CLIPS = [  # action suffix, label, slow, view, repeat, zoom (the camera's distance)\r"},{"line":16,"text":"    (\"fire\", \"Firing: the slide cycles (6x slow)\", 6, \"right_close\", 2, 1.0),\r"},{"line":17,"text":"    (\"reload_empty\", \"Empty reload: the empty magazine drops free, a new one goes in, the slide runs forward (2x slow)\", 2, \"right\", 1, 1.7),\r"},{"line":18,"text":"    (\"check_chamber\", \"Chamber check: the slide eased back to see the round\", 1, \"right\", 1, 1.0),\r"},{"line":19,"text":"    (\"check_mag\", \"Magazine check: out, looked at, back in\", 1, \"left\", 1, 1.5),\r"},{"line":20,"text":"]\r"},{"line":21,"text":"\r"},{"line":22,"text":"\r"},{"line":23,"text":"def _font(size):\r"},{"line":24,"text":"    from PIL import ImageFont\r"},{"line":25,"text":"    for name in (\"segoeui.ttf\", \"arial.ttf\", \"DejaVuSans.ttf\"):\r"},{"line":26,"text":"        try:\r"},{"line":27,"text":"            return ImageFont.truetype(name, size)\r"},{"line":28,"text":"        except OSError:\r"},{"line":29,"text":"            continue\r"},{"line":30,"text":"    return ImageFont.load_default()\r"},{"line":31,"text":"\r"},{"line":32,"text":"\r"},{"line":33,"text":"def _label(img, top, bottom):\r"},{"line":34,"text":"    from PIL import ImageDraw\r"},{"line":35,"text":"    d = ImageDraw.Draw(img)\r"},{"line":36,"text":"    w, h = img.size\r"},{"line":37,"text":"    d.rectangle([0, 0, w, 34], fill=(255, 255, 255))\r"},{"line":38,"text":"    d.text((12, 6), top, fill=(20, 20, 20), font=_font(18))\r"},{"line":39,"text":"    d.rectangle([0, h - 30, w, h], fill=(30, 30, 34))\r"},{"line":40,"text":"    d.text((12, h - 26), bottom, fill=(235, 235, 235), font=_font(15))\r"},{"line":41,"text":"    return img\r"},{"line":42,"text":"\r"},{"line":43,"text":"\r"},{"line":44,"text":"def _card(size, lines):\r"},{"line":45,"text":"    from PIL import Image, ImageDraw\r"},{"line":46,"text":"    img = Image.new(\"RGB\", size, (24, 26, 30))\r"},{"line":47,"text":"    d = ImageDraw.Draw(img)\r"},{"line":48,"text":"    y = size[1] // 2 - 30 * len(lines) // 2 - 10\r"},{"line":49,"text":"    for k, (text, big) in enumerate(lines):\r"},{"line":50,"text":"        f = _font(34 if big else 18)\r"},{"line":51,"text":"        tw = d.textlength(text, font=f)\r"},{"line":52,"text":"        d.text(((size[0] - tw) / 2, y), text, fill=(240, 240, 240) if big else (190, 190, 195), font=f)\r"},{"line":53,"text":"        y += 48 if big else 30\r"},{"line":54,"text":"    return img\r"},{"line":55,"text":"\r"}],"name":"CLIPS","start_line":15,"symbol_id":"hold-code/weaponlab/blueprint/showcase.py#var:CLIPS"}}
