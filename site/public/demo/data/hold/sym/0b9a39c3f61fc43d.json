\" % (source_id, pages[0], pages[-1]))\r"},{"line":202,"text":"    cv2.imwrite(str(out), np.ascontiguousarray(np.vstack(rows)[:, :, ::-1]))   # RGB to the BGR cv2 writes\r"},{"line":203,"text":"    return str(out)\r"}],"name":"sheet","start_line":184,"symbol_id":"hold-code/weaponlab/blueprint/sources.py#func:sheet"}}
