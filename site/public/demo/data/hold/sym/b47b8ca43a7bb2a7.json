de, protraction_deg=0.0, elevation_deg=0.0):\r"},{"line":516,"text":"        \"\"\"The shoulder girdle moved as a body moves it: the clavicle turned at its inner end, forward\r"},{"line":517,"text":"        (protraction, below 0 back: retraction) about the body's up line and up (elevation, below 0 down) about its\r"},{"line":518,"text":"        forward line, each kept inside its working range (CLAVICLE). The arm hangs from it: call before placing\r"},{"line":519,"text":"        the hand. Returns the degrees used and whether a request was clipped.\"\"\"\r"},{"line":520,"text":"        cn = self._clav_rest(side)\r"},{"line":521,"text":"        if cn is None:\r"},{"line":522,"text":"            return {\"protraction_deg\": 0.0, \"elevation_deg\": 0.0, \"clipped\": False, \"note\": \"the rig has no clavicle\"}\r"},{"line":523,"text":"        pr = max(-CLAVICLE[\"retraction_deg\"], min(CLAVICLE[\"protraction_deg\"], protraction_deg))\r"},{"line":524,"text":"        el = max(-CLAVICLE[\"depression_deg\"], min(CLAVICLE[\"elevation_deg\"], elevation_deg))\r"},{"line":525,"text":"        pb = self.arm.pose.bones[cn]\r"},{"line":526,"text":"        pb.rotation_quaternion = self._clav0[side]\r"},{"line":527,"text":"        bpy.context.view_layer.update()\r"},{"line":528,"text":"        from lab import VIEW_FWD, VIEW_UP\r"},{"line":529,"text":"        C = self._bw(cn).translation.copy()\r"},{"line":530,"text":"        S = self._bw(self._n(\"upperarm\", side)).translation.copy()\r"},{"line":531,"text":"        out = (S - C)\r"},{"line":532,"text":"        # forward: the turn about up that moves the shoulder's end toward VIEW_FWD; up: about forward toward VIEW_UP\r"},{"line":533,"text":"        ax_up = VIEW_UP.normalized()\r"},{"line":534,"text":"        sg_p = 1.0 if out.cross(VIEW_FWD).dot(ax_up) >= 0 else -1.0\r"},{"line":535,"text":"        q1 = Quaternion(ax_up, math.radians(pr) * sg_p)\r"},{"line":536,"text":"        ax_f = VIEW_FWD.normalized()\r"},{"line":537,"text":"        o1 = q1 @ out\r"},{"line":538,"text":"        sg_e = 1.0 if o1.cross(VIEW_UP).dot(ax_f) >= 0 else -1.0\r"},{"line":539,"text":"        q2 = Quaternion(ax_f, math.radians(el) * sg_e)\r"},{"line":540,"text":"        self._turn_about(cn, (q2 @ q1).axis if (q2 @ q1).angle > 1e-9 else Vector((0, 0, 1)), math.degrees((q2 @ q1).angle), C)\r"},{"line":541,"text":"        bpy.context.view_layer.update()\r"},{"line":542,"text":"        return {\"protraction_deg\": round(pr, 1), \"elevation_deg\": round(el, 1),\r"},{"line":543,"text":"                \"clipped\": abs(pr - protraction_deg) > 1e-6 or abs(el - elevation_deg) > 1e-6}\r"}],"name":"shoulder","start_line":515,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#method:HoldMixin.shoulder"}}
