{"flow":{"kind":"var","name":"path","noCFG":true,"reason":"path is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":56,"file":"hold-code/weaponlab/gunkit/blender/gunkit_inspect.py","kind":"var","language":"python","lines":[{"line":16,"text":"path = job[\"model\"]\r"},{"line":17,"text":"ext = os.path.splitext(path)[1].lower()\r"},{"line":18,"text":"bpy.ops.wm.read_factory_settings(use_empty=True)\r"},{"line":19,"text":"if ext == \".blend\":\r"},{"line":20,"text":"    with bpy.data.libraries.load(path, link=False) as (src, dst):\r"},{"line":21,"text":"        dst.objects = [n for n in src.objects]\r"},{"line":22,"text":"    for ob in dst.objects:\r"},{"line":23,"text":"        if ob is not None:\r"},{"line":24,"text":"            bpy.context.scene.collection.objects.link(ob)\r"},{"line":25,"text":"elif ext == \".fbx\":\r"},{"line":26,"text":"    bpy.ops.import_scene.fbx(filepath=path)\r"},{"line":27,"text":"elif ext == \".obj\":\r"},{"line":28,"text":"    bpy.ops.wm.obj_import(filepath=path)\r"},{"line":29,"text":"elif ext in (\".glb\", \".gltf\"):\r"},{"line":30,"text":"    bpy.ops.import_scene.gltf(filepath=path)\r"},{"line":31,"text":"else:\r"},{"line":32,"text":"    raise SystemExit(\"GUNKIT INSPECT: cannot read %s\" % path)\r"},{"line":33,"text":"bpy.context.view_layer.update()\r"},{"line":34,"text":"\r"},{"line":35,"text":"\r"},{"line":36,"text":"def bounds(pts):\r"},{"line":37,"text":"    lo = Vector((min(p.x for p in pts), min(p.y for p in pts), min(p.z for p in pts)))\r"},{"line":38,"text":"    hi = Vector((max(p.x for p in pts), max(p.y for p in pts), max(p.z for p in pts)))\r"},{"line":39,"text":"    return lo, hi\r"},{"line":40,"text":"\r"},{"line":41,"text":"\r"},{"line":42,"text":"objects, every = [], []\r"},{"line":43,"text":"for ob in bpy.context.scene.objects:\r"},{"line":44,"text":"    if ob.type != 'MESH':\r"},{"line":45,"text":"        continue\r"},{"line":46,"text":"    pts = [ob.matrix_world @ v.co for v in ob.data.vertices]\r"},{"line":47,"text":"    if not pts:\r"},{"line":48,"text":"        continue\r"},{"line":49,"text":"    every += pts\r"},{"line":50,"text":"    lo, hi = bounds(pts)\r"},{"line":51,"text":"    groups = []\r"},{"line":52,"text":"    for vg in ob.vertex_groups:\r"},{"line":53,"text":"        gp = [ob.matrix_world @ v.co for v in ob.data.vertices if any(g.group == vg.index and g.weight > 0.5 for g in v.groups)]\r"},{"line":54,"text":"        if gp:\r"},{"line":55,"text":"            glo, ghi = bounds(gp)\r"},{"line":56,"text":"            groups.append({\"name\": vg.name, \"vertices\": len(gp), \"min\": list(glo), \"max\": list(ghi)})\r"}],"name":"path","start_line":16,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_inspect.py#var:path"}}
