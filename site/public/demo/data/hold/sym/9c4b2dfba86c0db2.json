:"hold-code/poselab_mcp/blender/contactlab.py","kind":"method","language":"python","lines":[{"line":766,"text":"    def contact_pairs(self, side, other=True, band_cm=0.2, near_cm=1.0, facing_max_deg=70.0, skin_give_cm=0.3,\r"},{"line":767,"text":"                      cover_regions=None):\r"},{"line":768,"text":"        \"\"\"One hand's contact as posed now, quickly: {(hand part, region): [contact cm2, press cm2, deepest cm]},\r"},{"line":769,"text":"        the totals (contact, press into the object, press into the other hand past the skin's give), and the share\r"},{"line":770,"text":"        of each of cover_regions this hand's skin touches. The same reading the contact map makes, for the\r"},{"line":771,"text":"        purposes, the gate and the search. Only skin near the object is tested; inside is the nearest face's side,\r"},{"line":772,"text":"        confirmed by ray parity before a press counts.\"\"\"\r"},{"line":773,"text":"        P, N, A, bone, T = self._skin_arrays()\r"},{"line":774,"text":"        bvh, surf, SW, SL, kd = self._object_now()\r"},{"line":775,"text":"        RI = self._region_index()\r"},{"line":776,"text":"        idx, labl = self._hand_label_arrays(side, P, N)\r"},{"line":777,"text":"        labs = dict(zip(idx.tolist(), labl))\r"},{"line":778,"text":"        vs, _ps = self._gun_verts()\r"},{"line":779,"text":"        lo = np.min(np.array([list(v) for v in vs[:: max(1, len(vs) // 400)]]), 0) - near_cm / 100.0 - 0.01\r"},{"line":780,"text":"        hi = np.max(np.array([list(v) for v in vs[:: max(1, len(vs) // 400)]]), 0) + near_cm / 100.0 + 0.01\r"},{"line":781,"text":"        Pi = P[idx]\r"},{"line":782,"text":"        near = np.all((Pi >= lo) & (Pi <= hi), axis=1)\r"},{"line":783,"text":"        pairs, press, deep = {}, 0.0, 0.0\r"},{"line":784,"text":"        cos_f = math.cos(math.radians(facing_max_deg))\r"},{"line":785,"text":"        touched = set()\r"},{"line":786,"text":"        r_cov = max(band_cm, 0.35) / 100.0\r"},{"line":787,"text":"        ks = np.nonzero(near)[0]\r"},{"line":788,"text":"        if len(ks):\r"},{"line":789,"text":"            vi_n = idx[ks]\r"},{"line":790,"text":"            Dn, _wp, Nn = self.sdf_query(P[vi_n])           # the grids: distance (cm), outward normal, at once\r"},{"line":791,"text":"        for kk, k in enumerate(ks):\r"},{"line":792,"text":"            i = int(idx[k])\r"},{"line":793,"text":"            d_cm = float(Dn[kk])\r"},{"line":794,"text":"            if d_cm > near_cm:\r"},{"line":795,"text":"                continue\r"},{"line":796,"text":"            nrm = Vector(Nn[kk])\r"},{"line":797,"text":"            loc = Vector(P[i]) - nrm * (d_cm / 100.0)     # the nearest surface point\r"},{"line":798,"text":"            _c, si, _dd = kd.find(loc)\r"},{"line":799,"text":"            reg = SL[si] if si is not None else \"other\"\r"},{"line":800,"text":"            pr = pairs.setdefault((labs[i], reg), [0.0, 0.0, 0.0])\r"},{"line":801,"text":"            give = SKIN_GIVE.get(_lab_key(labs[i]), SKIN_GIVE[\"default\"])\r"},{"line":802,"text":"            if d_cm < -give - SDF_TOL_CM:                   # past the give by more than the grid can tell\r"},{"line":803,"text":"                pr[1] += A[i]\r"},{"line":804,"text":"                pr[2] = max(pr[2], -d_cm - give)\r"},{"line":805,"text":"                press += A[i]\r"},{"line":806,"text":"                deep = max(deep, -d_cm - give)\r"},{"line":807,"text":"            if d_cm <= band_cm and (d_cm < 0.0 or -float(np.dot(N[i], nrm)) >= cos_f):\r"},{"line":808,"text":"                pr[0] += A[i]\r"},{"line":809,"text":"            if cover_regions and d_cm * 0.01 <= r_cov:\r"},{"line":810,"text":"                for (_co, sk, _d) in kd.find_range(loc, r_cov):\r"},{"line":811,"text":"                    touched.add(sk)\r"},{"line":812,"text":"        hand_press, hand_deep = 0.0, 0.0\r"},{"line":813,"text":"        o = \"r\" if side == \"l\" else \"l\"\r"},{"line":814,"text":"        if other:\r"},{"line":815,"text":"            oh = self._other_hand_bvh(o, P, N)\r"},{"line":816,"text":"            if oh is not None:\r"},{"line":817,"text":"                ob_bvh, ts, olab, olo, ohi = oh\r"},{"line":818,"text":"                nearo = np.all((Pi >= olo) & (Pi <= ohi), axis=1)\r"},{"line":819,"text":"                _b2, _T2, sidev, kind, _s2 = self._skin_static()\r"},{"line":820,"text":"                vi_o = np.nonzero((sidev == (1 if o == \"r\" else 2)) & (kind > 0))[0]\r"},{"line":821,"text":"                for k in np.nonzero(nearo)[0]:\r"},{"line":822,"text":"                    i = int(idx[k])\r"},{"line":823,"text":"                    p_ = Vector(P[i])\r"},{"line":824,"text":"                    l2, n2, ti, d2 = ob_bvh.find_nearest(p_, near_cm / 100.0)\r"},{"line":825,"text":"                    if l2 is None:\r"},{"line":826,"text":"                        continue\r"},{"line":827,"text":"                    dd = (-d2 if (p_ - l2).dot(n2) < 0.0 and d2 < 0.02 else d2) * 100.0\r"},{"line":828,"text":"                    pr = pairs.setdefault((labs[i], \"hand_%s:%s\" % (o, olab.get(int(ts[ti][0]), \"?\"))), [0.0, 0.0, 0.0])\r"},{"line":829,"text":"                    if dd < -skin_give_cm:\r"},{"line":830,"text":"                        pr[1] += A[i]\r"},{"line":831,"text":"                        pr[2] = max(pr[2], -dd - skin_give_cm)\r"},{"line":832,"text":"                        hand_press += A[i]\r"},{"line":833,"text":"                        hand_deep = max(hand_deep, -dd - skin_give_cm)\r"},{"line":834,"text":"                    if dd <= band_cm:\r"},{"line":835,"text":"                        pr[0] += A[i]\r"},{"line":836,"text":"        # the other way round: the object's surface inside the hand's flesh past its give. A thin part (a trigger\r"},{"line":837,"text":"        # guard's ring) can pass through a finger between its skin vertices; its own surface samples cannot\r"},{"line":838,"text":"        pierced, pierce_deep, pierce_at = 0.0, 0.0, None\r"},{"line":839,"text":"        _bone, _T, sidev, kind, segi = self._skin_static()\r"},{"line":840,"text":"        sc_ = 1 if side == \"r\" else 2\r"},{"line":841,"text":"        selh = (sidev == sc_) & (kind > 0)\r"},{"line":842,"text":"        th = T[selh[T[:, 0]] & selh[T[:, 1]] & selh[T[:, 2]]]\r"},{"line":843,"text":"        if len(th):\r"},{"line":844,"text":"            vi = np.nonzero(selh)[0]\r"},{"line":845,"text":"            hb = BVHTree.FromPolygons([Vector(x) for x in P[vi]], [tuple(t) for t in np.searchsorted(vi, th)])\r"},{"line":846,"text":"            lo_h, hi_h = P[vi].min(0) - 0.01, P[vi].max(0) + 0.01\r"},{"line":847,"text":"            inbox = np.nonzero(np.all((SW >= lo_h) & (SW <= hi_h), axis=1))[0]\r"},{"line":848,"text":"            a_s = SAMPLE_CM * SAMPLE_CM\r"},{"line":849,"text":"            for k in inbox:\r"},{"line":850,"text":"                hit = self.inside_flesh(Vector(SW[k]), hb)\r"},{"line":851,"text":"                if hit is None:\r"},{"line":852,"text":"                    continue                           # outside the flesh\r"},{"line":853,"text":"                d_cm, t3 = hit\r"},{"line":854,"text":"                d3 = d_cm / 100.0\r"},{"line":855,"text":"                lab3 = labs.get(int(th[t3][0]), \"palm\")\r"},{"line":856,"text":"                give = SKIN_GIVE.get(_lab_key(lab3), SKIN_GIVE[\"default\"])\r"},{"line":857,"text":"                if d3 * 100.0 > give + 0.02:\r"},{"line":858,"text":"                    pierced += a_s\r"},{"line":859,"text":"                    if d3 * 100.0 - give > pierce_deep:\r"},{"line":860,"text":"                        pierce_deep, pierce_at = d3 * 100.0 - give, lab3\r"},{"line":861,"text":"        cover = {}\r"},{"line":862,"text":"        if cover_regions:\r"},{"line":863,"text":"            hit_all, tot_all = 0, 0\r"},{"line":864,"text":"            for l_ in cover_regions:\r"},{"line":865,"text":"                ks = RI[\"by\"].get(l_, [])\r"},{"line":866,"text":"                if not ks:\r"},{"line":867,"text":"                    continue\r"},{"line":868,"text":"                h_ = sum(1 for k in ks if k in touched)\r"},{"line":869,"text":"                cover[l_] = round(h_ / float(len(ks)), 3)\r"},{"line":870,"text":"                hit_all += h_\r"},{"line":871,"text":"                tot_all += len(ks)\r"},{"line":872,"text":"            cover[\"_all\"] = round(hit_all / float(max(1, tot_all)), 3)\r"},{"line":873,"text":"        return {\"pairs\": pairs, \"press_cm2\": round(press, 2), \"deepest_cm\": round(deep, 2),\r"},{"line":874,"text":"                \"hand_press_cm2\": round(hand_press, 2), \"hand_deepest_cm\": round(hand_deep, 2), \"cover\": cover,\r"},{"line":875,"text":"                \"pierced_cm2\": round(pierced, 2), \"pierced_deep_cm\": round(pierce_deep, 2), \"pierced_at\": pierce_at,\r"},{"line":876,"text":"                \"_P\": P, \"_idx\": idx, \"_lab\": labl, \"_touched\": touched}\r"}],"name":"contact_pairs","start_line":766,"symbol_id":"hold-code/poselab_mcp/blender/contactlab.py#method:ContactMixin.contact_pairs"}}
