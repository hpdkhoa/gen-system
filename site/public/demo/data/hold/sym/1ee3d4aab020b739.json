e\"]: r for r, p in facts[\"parts\"].items()}\r"},{"line":80,"text":"\r"},{"line":81,"text":"    def move(bone, pt):\r"},{"line":82,"text":"        \"\"\"pt carried by the bone's own move, then by its parent's (a child rides its parent).\"\"\"\r"},{"line":83,"text":"        role = role_of.get(bone)\r"},{"line":84,"text":"        if role:\r"},{"line":85,"text":"            p = facts[\"parts\"][role]\r"},{"line":86,"text":"            v = fr[\"parts\"].get(role, 0.0)\r"},{"line":87,"text":"            head = byname[bone][\"head\"]\r"},{"line":88,"text":"            if p[\"kind\"] == \"slide\":\r"},{"line":89,"text":"                pt = [pt[i] + p[\"axis\"][i] * p[\"travel_cm\"] * v for i in range(3)]\r"},{"line":90,"text":"            elif p[\"kind\"] == \"turn\":\r"},{"line":91,"text":"                pt = T._rot(pt, head, p[\"axis\"], p[\"turn_deg\"] * v)\r"},{"line":92,"text":"            elif isinstance(v, list):\r"},{"line":93,"text":"                pt = [pt[i] + v[i] for i in range(3)]\r"},{"line":94,"text":"        parent = byname[bone].get(\"parent\")\r"},{"line":95,"text":"        return move(parent, pt) if parent and parent != \"Root\" else pt\r"},{"line":96,"text":"\r"},{"line":97,"text":"    out = {}\r"},{"line":98,"text":"    for b in facts[\"bones\"]:\r"},{"line":99,"text":"        h = b[\"head\"]\r"},{"line":100,"text":"        pts = {\"head\": h, \"x\": [h[0] + 3, h[1], h[2]], \"y\": [h[0], h[1] + 3, h[2]], \"z\": [h[0], h[1], h[2] + 3]}\r"},{"line":101,"text":"        out[b[\"name\"]] = {k: move(b[\"name\"], v) for k, v in pts.items()}\r"},{"line":102,"text":"    return out\r"}],"name":"expected","start_line":75,"symbol_id":"hold-code/weaponlab/gunkit/run.py#func:expected"}}
