{"flow":{"blocks":[{"id":0,"label":"entry","lines":[{"kind":"call","line":2119,"text":"face = (Quaternion(ax, math.radians(tilt_a)) @ Quaternion(bx, math.radians(tilt_b)) @ face).normalized()"},{"kind":"call","line":2120,"text":"P = Vector(centre) + nrm * (dist / 100.0) + ax * (sa / 100.0) + bx * (sb / 100.0)"},{"kind":"call","line":2121,"text":"self.snapshot(\"load\", \"_natural\")"},{"kind":"call","line":2122,"text":"H = self._bw(hn)"},{"kind":"call","line":2124,"text":"mid = self._bw(self._n(\"finger\", side, \"middle\", \"01\")).translation"},{"kind":"call","line":2125,"text":"pc = w.lerp(mid, 0.5)"},{"kind":"call","line":2126,"text":"q = self._palm_facing(side).rotation_difference(face)"},{"kind":"call","line":2127,"text":"R = Matrix.Translation(pc) @ q.to_matrix().to_4x4() @ Matrix.Translation(-pc) @ H"},{"kind":"call","line":2128,"text":"R = Matrix.Translation(pc) @ Quaternion(face, math.radians(roll)).to_matrix().to_4x4() @ Matrix.Translation(-pc) @ R"},{"kind":"call","line":2129,"text":"R = Matrix.Translation(P - pc) @ R"},{"kind":"call","line":2130,"text":"return Matrix.LocRotScale(R.translation, R.to_quaternion(), self._unit())"}],"preds":null,"stmts":["call ?.normalized","call Vector","call self.snapshot","call self._bw","call self._bw","call self._n","call w.lerp","call ?.rotation_difference","call Matrix.Translation","call ?.to_4x4","call Matrix.Translation","call Matrix.Translation","call ?.to_4x4","call Matrix.Translation","call Matrix.Translation","call Matrix.LocRotScale","call R.to_quaternion","call self._unit","return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[0],"func_id":"hold-code/poselab_mcp/blender/lab.py#func:hand_at","issues":null},"source":{"end_line":2130,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"func","language":"python","lines":[{"line":2115,"text":"        def hand_at(dist, tilt_a, tilt_b, roll, sa=0.0, sb=0.0):\r"},{"line":2116,"text":"            # the palm facing into the surface, tilted, then turned about its own facing; its middle at the place\r"},{"line":2117,"text":"            # (slid sa along the axis and sb across it on the surface)\r"},{"line":2118,"text":"            face = -nrm\r"},{"line":2119,"text":"            face = (Quaternion(ax, math.radians(tilt_a)) @ Quaternion(bx, math.radians(tilt_b)) @ face).normalized()\r"},{"line":2120,"text":"            P = Vector(centre) + nrm * (dist / 100.0) + ax * (sa / 100.0) + bx * (sb / 100.0)\r"},{"line":2121,"text":"            self.snapshot(\"load\", \"_natural\")\r"},{"line":2122,"text":"            H = self._bw(hn)\r"},{"line":2123,"text":"            w = H.translation\r"},{"line":2124,"text":"            mid = self._bw(self._n(\"finger\", side, \"middle\", \"01\")).translation\r"},{"line":2125,"text":"            pc = w.lerp(mid, 0.5)\r"},{"line":2126,"text":"            q = self._palm_facing(side).rotation_difference(face)\r"},{"line":2127,"text":"            R = Matrix.Translation(pc) @ q.to_matrix().to_4x4() @ Matrix.Translation(-pc) @ H\r"},{"line":2128,"text":"            R = Matrix.Translation(pc) @ Quaternion(face, math.radians(roll)).to_matrix().to_4x4() @ Matrix.Translation(-pc) @ R\r"},{"line":2129,"text":"            R = Matrix.Translation(P - pc) @ R\r"},{"line":2130,"text":"            return Matrix.LocRotScale(R.translation, R.to_quaternion(), self._unit())\r"}],"name":"hand_at","start_line":2115,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:hand_at"}}
