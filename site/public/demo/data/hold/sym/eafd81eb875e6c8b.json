old-code/weaponlab/blueprint/figures.py","kind":"func","language":"python","lines":[{"line":21,"text":"def add(gun, fig_id, source_id, page, kind, shows=None, crop=None, rotate_deg=0, dpi=300, to_scale=None,\r"},{"line":22,"text":"        caption=None, note=None):\r"},{"line":23,"text":"    \"\"\"Cuts a figure from a page. crop: [x0, y0, x1, y1] as shares of the page before turning (default the whole\r"},{"line":24,"text":"    page); rotate_deg: 0, 90, 180 or 270, clockwise, to bring the gun upright; kind: side, section, top, front,\r"},{"line":25,"text":"    rear, exploded, detail or photo; shows: right or left (the side a side view shows).\"\"\"\r"},{"line":26,"text":"    import cv2\r"},{"line":27,"text":"    import numpy as np\r"},{"line":28,"text":"    doc = store.load(gun, \"sources\")\r"},{"line":29,"text":"    src = S._source(doc, source_id)\r"},{"line":30,"text":"    if src[\"file\"].lower().endswith(\".pdf\"):\r"},{"line":31,"text":"        pdf = S._pdf().open(src[\"file\"])\r"},{"line":32,"text":"        pg = pdf[page - 1]\r"},{"line":33,"text":"        clip = None\r"},{"line":34,"text":"        if crop:\r"},{"line":35,"text":"            r = pg.rect\r"},{"line":36,"text":"            clip = S._pdf().Rect(r.x0 + crop[0] * r.width, r.y0 + crop[1] * r.height, r.x0 + crop[2] * r.width, r.y0 + crop[3] * r.height)\r"},{"line":37,"text":"        pix = pg.get_pixmap(dpi=dpi, clip=clip)\r"},{"line":38,"text":"        img = np.frombuffer(pix.samples, dtype=np.uint8).reshape(pix.height, pix.width, pix.n)[:, :, :3][:, :, ::-1].copy()\r"},{"line":39,"text":"    else:\r"},{"line":40,"text":"        img = cv2.imread(src[\"file\"])\r"},{"line":41,"text":"        if crop:\r"},{"line":42,"text":"            h, w = img.shape[:2]\r"},{"line":43,"text":"            img = img[int(crop[1] * h):int(crop[3] * h), int(crop[0] * w):int(crop[2] * w)].copy()\r"},{"line":44,"text":"    turn = {0: None, 90: cv2.ROTATE_90_CLOCKWISE, 180: cv2.ROTATE_180, 270: cv2.ROTATE_90_COUNTERCLOCKWISE}[rotate_deg]\r"},{"line":45,"text":"    if turn is not None:\r"},{"line":46,"text":"        img = cv2.rotate(img, turn)\r"},{"line":47,"text":"    out = store.folder(gun, \"figures\") / (\"%s.png\" % fig_id)\r"},{"line":48,"text":"    cv2.imwrite(str(out), img)\r"},{"line":49,"text":"    fig = {\"id\": fig_id, \"source\": source_id, \"page\": int(page), \"kind\": kind, \"image\": store.rel(gun, out),\r"},{"line":50,"text":"           \"rotate_deg\": rotate_deg, \"dpi\": dpi}\r"},{"line":51,"text":"    if crop:\r"},{"line":52,"text":"        fig[\"crop\"] = [round(c, 4) for c in crop]\r"},{"line":53,"text":"    if shows:\r"},{"line":54,"text":"        fig[\"shows\"] = shows\r"},{"line":55,"text":"    fig[\"to_scale\"] = (kind != \"exploded\") if to_scale is None else bool(to_scale)\r"},{"line":56,"text":"    for k, v in ((\"caption\", caption), (\"note\", note)):\r"},{"line":57,"text":"        if v:\r"},{"line":58,"text":"            fig[k] = v\r"},{"line":59,"text":"    doc[\"figures\"] = [f for f in doc.get(\"figures\", []) if f[\"id\"] != fig_id] + [fig]\r"},{"line":60,"text":"    store.save(gun, \"sources\", doc)\r"},{"line":61,"text":"    return {\"figure\": fig, \"image\": str(out), \"size_px\": [img.shape[1], img.shape[0]]}\r"}],"name":"add","start_line":21,"symbol_id":"hold-code/weaponlab/blueprint/figures.py#func:add"}}
