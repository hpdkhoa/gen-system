n its back and own side, the fingers round the front to the far side; a part\r"},{"line":959,"text":"                # with none (a round handle) asks for palm and fingers anywhere on the run\r"},{"line":960,"text":"                named = bool(m.get(\"palm_dir\")) and own != \"side_?\"\r"},{"line":961,"text":"                RUN = [\"back\", \"front\", \"side_?\", \"left\", \"right\", \"tang\", \"end\"]\r"},{"line":962,"text":"                pr_ = [\"back\", own, \"tang\"] if named else RUN\r"},{"line":963,"text":"                fr_, ff_ = ([\"front\"], [far]) if named else (RUN, RUN)\r"},{"line":964,"text":"                got = {\"palm_cm2\": pa(cp, [\"palm\", \"palm_side\"], pr_),\r"},{"line":965,"text":"                       \"fingers_front_cm2\": pa(cp, FINGERS3, fr_),\r"},{"line":966,"text":"                       \"fingers_far_cm2\": pa(cp, FINGERS3, ff_) if named else 0.0,\r"},{"line":967,"text":"                       \"web_cm2\": pa(cp, [\"web\"], [\"tang\", \"back\"] if named else RUN),\r"},{"line":968,"text":"                       \"cover\": self.span_cover(cp, m, cover_r)}\r"},{"line":969,"text":"                if not named:\r"},{"line":970,"text":"                    got[\"fingers_far_cm2\"] = q[\"fingers_far_cm2\"]      # one finger area for a round handle\r"},{"line":971,"text":"                err = (self._short(got[\"palm_cm2\"], q[\"palm_cm2\"]) + self._short(got[\"fingers_front_cm2\"], q[\"fingers_front_cm2\"])\r"},{"line":972,"text":"                       + self._short(got[\"fingers_far_cm2\"], q[\"fingers_far_cm2\"]) + self._short(got[\"web_cm2\"], q[\"web_cm2\"])\r"},{"line":973,"text":"                       + 2.0 * self._short(got[\"cover\"], q[\"cover_min\"]))\r"},{"line":974,"text":"                met = err <= 1e-6\r"},{"line":975,"text":"                # the pull: each contact still short, how far its hand part is from its region (cm), so a hand\r"},{"line":976,"text":"                # off the object always costs more the farther it is\r"},{"line":977,"text":"                pull = 0.0\r"},{"line":978,"text":"                for key, hp, rg in ((\"palm_cm2\", [\"palm\"], pr_), (\"fingers_front_cm2\", FINGERS3, fr_),\r"},{"line":979,"text":"                                    (\"fingers_far_cm2\", FINGERS3, ff_), (\"web_cm2\", [\"web\"], [\"tang\", \"back\"] if named else RUN)):\r"},{"line":980,"text":"                    if got[key] < q[key]:\r"},{"line":981,"text":"                        pull += min(10.0, self.pull_cm(cp, hp, rg))\r"},{"line":982,"text":"                err += PULL_W * pull\r"},{"line":983,"text":"                got[\"pull_cm\"] = round(pull, 2)\r"},{"line":984,"text":"                res.append({\"purpose\": \"power_wrap\", \"met\": met, \"error\": round(err, 3), **got,\r"},{"line":985,"text":"                            \"asks\": {k: v for k, v in q.items() if k not in (\"why\", \"estimate\")}})\r"},{"line":986,"text":"                if m.get(\"index\") == \"extended\" and self._object[\"parts\"][m[\"part\"]][\"runs\"][m.get(\"run\", 0)][\"openings\"]:\r"},{"line":987,"text":"                    g_ = self.purpose_index_extended(side, m, glove_cm)\r"},{"line":988,"text":"                    on_nt = pa(cp, [\"index*\"], [\"notouch:*\"])\r"},{"line":989,"text":"                    g_[\"notouch_cm2\"] = on_nt\r"},{"line":990,"text":"                    g_[\"error\"] = round(g_[\"error\"] + (1.0 if on_nt > 0 else 0.0), 3)\r"},{"line":991,"text":"                    g_[\"met\"] = g_[\"error\"] <= 1e-6\r"},{"line":992,"text":"                    res.append(g_)\r"},{"line":993,"text":"                if m.get(\"thumb\") == \"inline\":\r"},{"line":994,"text":"                    res.append(self._thumb_contact(side, m, glove_cm, cp, [far, \"tang\", \"back\", \"opening_edge\"], None))\r"},{"line":995,"text":"                elif m.get(\"thumb\") in (\"wrap\", \"opposed\"):\r"},{"line":996,"text":"                    # the thumb closed round the handle the other way from the fingers (the GRASP taxonomy's power\r"},{"line":997,"text":"                    # wrap with the thumb opposed): its pad or side on the handle\r"},{"line":998,"text":"                    q2 = CONTACT_PURPOSES[\"thumb_wrap\"]\r"},{"line":999,"text":"                    got2 = pa(cp, [\"thumb?_pad\", \"thumb?_side\"], pr_ if not named else RUN)\r"},{"line":1000,"text":"                    e2 = self._short(got2, q2[\"pad_cm2\"])\r"},{"line":1001,"text":"                    met2 = e2 <= 1e-6\r"},{"line":1002,"text":"                    if not met2:\r"},{"line":1003,"text":"                        e2 += PULL_W * min(10.0, self.pull_cm(cp, [\"thumb?_pad\"], RUN))\r"},{"line":1004,"text":"                    res.append({\"purpose\": \"thumb_wrap\", \"met\": met2, \"error\": round(e2, 3), \"pad_cm2\": got2,\r"},{"line":1005,"text":"                                \"asks\": {\"pad_cm2\": q2[\"pad_cm2\"]}})\r"},{"line":1006,"text":"            elif m[\"purpose\"] == \"support\":\r"},{"line":1007,"text":"                q = C[\"support\"]\r"},{"line":1008,"text":"                o = \"r\" if side == \"l\" else \"l\"\r"},{"line":1009,"text":"                got = {\"palm_cm2\": pa(cp, [\"palm\", \"palm_side\"], [own]),\r"},{"line":1010,"text":"                       \"over_cm2\": pa(cp, [\"index?_pad\", \"middle?_pad\", \"ring?_pad\", \"pinky?_pad\"],\r"},{"line":1011,"text":"                                      [\"hand_%s:*_back\" % o, \"hand_%s:*_side\" % o]),\r"},{"line":1012,"text":"                       \"cover\": cp[\"cover\"].get(own, 0.0)}\r"},{"line":1013,"text":"                err = (self._short(got[\"palm_cm2\"], q[\"palm_cm2\"]) + self._short(got[\"over_cm2\"], q[\"over_cm2\"])\r"},{"line":1014,"text":"                       + 2.0 * self._short(got[\"cover\"], q[\"cover_min\"]))\r"},{"line":1015,"text":"                met = err <= 1e-6\r"},{"line":1016,"text":"                pull = min(10.0, self.pull_cm(cp, [\"palm\"], [own])) if got[\"palm_cm2\"] < q[\"palm_cm2\"] else 0.0\r"},{"line":1017,"text":"                err += PULL_W * pull\r"},{"line":1018,"text":"                got[\"pull_cm\"] = round(pull, 2)\r"},{"line":1019,"text":"                res.append({\"purpose\": \"support\", \"met\": met, \"error\": round(err, 3), **got,\r"},{"line":1020,"text":"                            \"asks\": {k: v for k, v in q.items() if k not in (\"why\", \"estimate\")}})\r"},{"line":1021,"text":"                if m.get(\"thumb\") == \"inline\":\r"},{"line":1022,"text":"                    res.append(self._thumb_contact(side, m, glove_cm, cp, [own, \"hand_%s:thumb*\" % o, \"tang\"], self._thumb_dir(o)))\r"},{"line":1023,"text":"        nt_c = pa(cp, [\"*\"], [\"notouch:*\"])\r"},{"line":1024,"text":"        nt_p = pa(cp, [\"*\"], [\"notouch:*\"], 1)\r"},{"line":1025,"text":"        res.append({\"purpose\": \"notouch\", \"met\": nt_c <= 0.0 and nt_p <= 0.0, \"error\": round(nt_c + 5.0 * nt_p, 3),\r"},{"line":1026,"text":"                    \"contact_cm2\": nt_c, \"press_cm2\": nt_p})\r"},{"line":1027,"text":"        # no clipping, ever: no skin inside the object past its give, no object inside the flesh past it, no hand\r"},{"line":1028,"text":"        # inside the other past the skin's give (a hair of sampling noise allowed, no depth)\r"},{"line":1029,"text":"        clip_a = cp[\"press_cm2\"] + cp[\"pierced_cm2\"] + cp[\"hand_press_cm2\"]\r"},{"line":1030,"text":"        clip_d = max(cp[\"deepest_cm\"], cp[\"pierced_deep_cm\"], cp[\"hand_deepest_cm\"])\r"},{"line":1031,"text":"        perr = max(0.0, clip_a - CLIP_NOISE_CM2) + 10.0 * clip_d\r"},{"line":1032,"text":"        res.append({\"purpose\": \"press\", \"met\": clip_a <= CLIP_NOISE_CM2 and clip_d <= 0.0, \"error\": round(perr, 3),\r"},{"line":1033,"text":"                    \"hard\": True, \"object_cm2\": cp[\"press_cm2\"], \"object_deepest_cm\": cp[\"deepest_cm\"],\r"},{"line":1034,"text":"                    \"pierced_cm2\": cp[\"pierced_cm2\"], \"pierced_deep_cm\": cp[\"pierced_deep_cm\"], \"pierced_at\": cp[\"pierced_at\"],\r"},{"line":1035,"text":"                    \"hand_cm2\": cp[\"hand_press_cm2\"], \"hand_deepest_cm\": cp[\"hand_deepest_cm\"]})\r"},{"line":1036,"text":"        res.append(self.hold_digit_rule(side))\r"},{"line":1037,"text":"        res.append(self.purpose_comfort(side))\r"},{"line":1038,"text":"        return res\r"}],"name":"contact_purposes","start_line":943,"symbol_id":"hold-code/poselab_mcp/blender/contactlab.py#method:ContactMixin.contact_purposes"}}
