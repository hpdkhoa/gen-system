,{"line":1085,"text":"        TL = self._thumb_limits()\r"},{"line":1086,"text":"        tdir = self._thumb_dir(side)\r"},{"line":1087,"text":"        ref = along if along is not None else self._index_dir(side)\r"},{"line":1088,"text":"        ang = math.degrees(tdir.angle(ref)) if tdir.length and ref.length else 180.0\r"},{"line":1089,"text":"        end = abs(self._thumb_report(side, TL)[0].get(\"thumb_03\", [0, 0])[0])\r"},{"line":1090,"text":"        from holdlab import PURPOSES as _GP\r"},{"line":1091,"text":"        G = _GP[\"thumb_inline\"]\r"},{"line":1092,"text":"        err = max(0.0, ang - G[\"angle_max_deg\"]) / 10.0 + max(0.0, end - G[\"end_bend_max_deg\"]) / 10.0 + self._short(pad, q[\"pad_cm2\"])\r"},{"line":1093,"text":"        g_[\"met\"] = err <= 1e-6\r"},{"line":1094,"text":"        obj_regions = [r for r in regions if not r.startswith(\"hand_\")]\r"},{"line":1095,"text":"        if pad < q[\"pad_cm2\"] and obj_regions:\r"},{"line":1096,"text":"            err += PULL_W * min(10.0, self.pull_cm(cp, [\"thumb?_pad\"], obj_regions))\r"},{"line":1097,"text":"        g_[\"error\"] = round(err, 3)\r"},{"line":1098,"text":"        return g_\r"}],"name":"_thumb_contact","start_line":1076,"symbol_id":"hold-code/poselab_mcp/blender/contactlab.py#func:_thumb_contact"}}
