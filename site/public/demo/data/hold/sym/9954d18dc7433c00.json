esses.append(\"/Applications/Blender.app/Contents/MacOS/Blender\")\r"},{"line":32,"text":"    else:\r"},{"line":33,"text":"        guesses += [\"/usr/bin/blender\", \"/snap/bin/blender\"]\r"},{"line":34,"text":"    for g in guesses:\r"},{"line":35,"text":"        if os.path.exists(g):\r"},{"line":36,"text":"            return g\r"},{"line":37,"text":"    raise ToolError(\"Blender not found: set POSELAB_BLENDER to blender's executable (for example \"\r"},{"line":38,"text":"                    \"D:/Blender/blender.exe) in the MCP client's configuration or the shell that starts the server\")\r"},{"line":39,"text":"\r"},{"line":40,"text":"\r"},{"line":41,"text":"def out_dir():\r"}],"name":"stop","start_line":1,"symbol_id":"hold-code/poselab_mcp/worker_client.py#method:Worker.stop"}}
