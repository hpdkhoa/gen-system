\"clips\"].items() if isinstance(h.get(\"checks\"), dict)}}"},{"kind":"return","line":103,"text":"return {\"folder\": str(out), \"plan\": plan, \"data_file\": str(out / (\"%s.json\" % game_id)), \"trial_folder\": str(out / \"trial\"),"}],"preds":[30],"stmts":["call ?.write_text","call json.dumps","call register","call json.loads","call ?.replace","call ?.mkdir","call ?.write_text","call json.dumps","call str","call str","call str","call ?.get","call ?.items","call isinstance","call h.get","return"],"succs":null}],"effects":["fs"],"entry":0,"exits":[32],"func_id":"hold-code/weaponlab/gunkit/export.py#func:export","issues":null},"source":{"end_line":105,"file":"hold-code/weaponlab/gunkit/export.py","kind":"func","language":"python","lines":[{"line":30,"text":"def export(facts_path, game_id, base=None, game_folder=\"/Game/Guns\", staging=\"/Game/Staging/Guns\", rig=\"Shared\"):\r"},{"line":31,"text":"    \"\"\"Stages one gun: its FBX files, the import plan and a draft data file. base: the game's current definition of\r"},{"line":32,"text":"    the gun (a dict or a path to a dump), whose numbers the draft keeps.\"\"\"\r"},{"line":33,"text":"    facts = json.loads(Path(facts_path).read_text(encoding=\"utf-8\"))\r"},{"line":34,"text":"    build = Path(facts_path).parent\r"},{"line":35,"text":"    a = A.load(facts[\"action\"])\r"},{"line":36,"text":"    clips = json.loads((build / \"clips.json\").read_text(encoding=\"utf-8\"))\r"},{"line":37,"text":"    hands = json.loads((build / \"hands\" / \"hands.json\").read_text(encoding=\"utf-8\"))\r"},{"line":38,"text":"    out = build / \"export\"\r"},{"line":39,"text":"    (out / \"arms\").mkdir(parents=True, exist_ok=True)\r"},{"line":40,"text":"    shutil.copy2(clips[\"fbx\"], out / Path(clips[\"fbx\"]).name)\r"},{"line":41,"text":"    arms = {}\r"},{"line":42,"text":"    for cid, h in hands[\"clips\"].items():\r"},{"line":43,"text":"        fbx = next((w for w in h[\"written\"] if w.endswith(\".fbx\")), None)\r"},{"line":44,"text":"        if fbx:\r"},{"line":45,"text":"            dst = out / \"arms\" / Path(fbx).name\r"},{"line":46,"text":"            shutil.copy2(fbx, dst)\r"},{"line":47,"text":"            arms[cid] = {\"fbx\": str(dst), \"clip\": h[\"clip\"]}\r"},{"line":48,"text":"    folder = \"%s/%s\" % (game_folder, game_id)\r"},{"line":49,"text":"    mesh = \"SK_%s\" % game_id\r"},{"line":50,"text":"    plan = {\"gun\": {\"fbx\": str(out / Path(clips[\"fbx\"]).name), \"name\": mesh, \"clips\": [c[\"clip\"] for c in clips[\"clips\"]],\r"},{"line":51,"text":"                    \"rate\": 60},\r"},{"line":52,"text":"            \"arms\": [{\"fbx\": v[\"fbx\"], \"name\": v[\"clip\"]} for v in arms.values()],\r"},{"line":53,"text":"            \"staging\": \"%s/%s\" % (staging, game_id), \"dest\": folder, \"approved_by\": None}\r"},{"line":54,"text":"    (out / \"import_plan.json\").write_text(json.dumps(plan, indent=1), encoding=\"utf-8\")\r"},{"line":55,"text":"    d = dict(base) if isinstance(base, dict) else (json.loads(Path(base).read_text(encoding=\"utf-8\")) if base else {})\r"},{"line":56,"text":"    d.pop(\"_about\", None)\r"},{"line":57,"text":"    d[\"_about\"] = (\"%s, drafted by Gun Kit from %s (action %s); the game's numbers from its dump. A draft: it goes to \"\r"},{"line":58,"text":"                   \"Content/Data/Guns only after the Gate and the user\" % (game_id, facts[\"name\"], a[\"id\"]))\r"},{"line":59,"text":"    d[\"Id\"] = game_id\r"},{"line":60,"text":"    if facts.get(\"proxy\"):\r"},{"line":61,"text":"        d[\"DisplayName\"] = \"TEST MODEL (%s proxy)\" % a[\"id\"]      # a proxy never ships: its name says what it is\r"},{"line":62,"text":"    d[\"ArmsRig\"] = rig\r"},{"line":63,"text":"    d[\"ArmsGun\"] = asset(folder, mesh)\r"},{"line":64,"text":"    d[\"ArmsGunNoIrons\"] = \"\"\r"},{"line":65,"text":"    d[\"ArmsGunOffset\"] = dict(zip(\"XYZ\", hands[\"placement\"][\"bolt_face_in_gun_bone_cm\"]))\r"},{"line":66,"text":"    d[\"ArmsGunRot\"] = {\"Pitch\": 0.0, \"Yaw\": 0.0, \"Roll\": 0.0}\r"},{"line":67,"text":"    d[\"ArmsGunScale\"] = 1.0\r"},{"line":68,"text":"    d[\"ArmsMuzzle\"] = dict(zip(\"XYZ\", facts[\"marks\"].get(\"muzzle\", [0.0, 40.0, 0.0])))\r"},{"line":69,"text":"    d[\"ChamberAt\"] = {\"X\": 0.0, \"Y\": 0.0, \"Z\": 0.0}\r"},{"line":70,"text":"    if \"port\" in facts[\"marks\"]:\r"},{"line":71,"text":"        d[\"EjectPort\"] = dict(zip(\"XYZ\", facts[\"marks\"][\"port\"]))\r"},{"line":72,"text":"    if facts.get(\"magazine\"):\r"},{"line":73,"text":"        d[\"ArmsMagBone\"] = facts[\"magazine\"][\"bone\"]\r"},{"line":74,"text":"        d[\"ArmsMagMesh\"] = \"\"          # the magazine is the rig's own bone: its clips carry it, in the hand too\r"},{"line":75,"text":"    for cid, field in GUN_FIELD.items():\r"},{"line":76,"text":"        if cid in a[\"gun_clips\"]:\r"},{"line":77,"text":"            d[field] = asset(folder, \"A_%s_%s\" % (facts[\"name\"], cid))\r"},{"line":78,"text":"    d[\"ArmsClips\"] = {HAND_ROLE[cid]: asset(folder, v[\"clip\"]) for cid, v in arms.items() if cid in HAND_ROLE}\r"},{"line":79,"text":"    if \"idle\" in arms:\r"},{"line":80,"text":"        d[\"ArmsClips\"][\"hold\"] = d[\"ArmsClips\"][\"idle\"]\r"},{"line":81,"text":"    # the chamber check's open stretch (the round shows): the action's own expectation of the port in view\r"},{"line":82,"text":"    cc = a[\"hand_clips\"].get(\"check_chamber\", {})\r"},{"line":83,"text":"    seen = next((x[\"at\"] for x in cc.get(\"expect\", []) if \"visible\" in x and isinstance(x[\"at\"], list)), None)\r"},{"line":84,"text":"    if seen:\r"},{"line":85,"text":"        d[\"ChamberOpen\"] = {\"X\": seen[0], \"Y\": seen[1]}\r"},{"line":86,"text":"    charge = a[\"hand_clips\"].get(\"charge\") or a[\"hand_clips\"].get(\"cycle\")\r"},{"line":87,"text":"    if charge:\r"},{"line":88,"text":"        d[\"HandChargeSeconds\"] = charge[\"seconds\"]\r"},{"line":89,"text":"    d[\"EmptyReloadCut\"] = 0.0\r"},{"line":90,"text":"    # the special paths of the old rigs do not apply to a gun with its own clips\r"},{"line":91,"text":"    for k in (\"ArmsChamberClip\", \"ArmsChargeClip\", \"ArmsMagHoldClip\", \"ArmsClipSuffix\", \"ArmsHandBone\", \"ArmsPressBone\",\r"},{"line":92,"text":"              \"ArmsMagHandBone\", \"ArmsGunChargeLocked\", \"ArmsGunLoad\", \"ArmsGunLoadStart\", \"ArmsGunLoadEnd\"):\r"},{"line":93,"text":"        d.pop(k, None)\r"},{"line":94,"text":"    (out / (\"%s.json\" % game_id)).write_text(json.dumps(d, indent=1), encoding=\"utf-8\")\r"},{"line":95,"text":"    from .gaterows import register\r"},{"line":96,"text":"    register(game_id, build)                          # the Gate's gunkit provider finds the build by the game id\r"},{"line":97,"text":"    # the same file for a trial before the import is approved: every asset in the staging folder (the game reads it\r"},{"line":98,"text":"    # with -GunData=<folder>, Game Probe's trial)\r"},{"line":99,"text":"    trial = json.loads(json.dumps(d).replace('\"%s/' % folder, '\"%s/%s/' % (staging, game_id)))\r"},{"line":100,"text":"    trial[\"_about\"] = \"TRIAL of \" + d[\"_about\"]\r"},{"line":101,"text":"    (out / \"trial\").mkdir(exist_ok=True)\r"},{"line":102,"text":"    (out / \"trial\" / (\"%s.json\" % game_id)).write_text(json.dumps(trial, indent=1), encoding=\"utf-8\")\r"},{"line":103,"text":"    return {\"folder\": str(out), \"plan\": plan, \"data_file\": str(out / (\"%s.json\" % game_id)), \"trial_folder\": str(out / \"trial\"),\r"},{"line":104,"text":"            \"hand_checks\": {c: {k: h[\"checks\"].get(k) for k in (\"clearance_worst_cm\", \"anatomy_break_frames\", \"grip_break_frames\")}\r"},{"line":105,"text":"                            for c, h in hands[\"clips\"].items() if isinstance(h.get(\"checks\"), dict)}}\r"}],"name":"export","start_line":30,"symbol_id":"hold-code/weaponlab/gunkit/export.py#func:export"}}
