p_.get(\"elbow_bend_deg\", 90.0))\r"},{"line":2091,"text":"        return sc, rep_, bad\r"}],"name":"_comfort","start_line":2082,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._comfort"}}
