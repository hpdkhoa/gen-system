 = {\"poselab\": str(Path(poselab_mcp.__file__).resolve().parent / \"blender\"), \"arms\": arms(),"},{"kind":"call","line":200,"text":"\"prefix\": \"A_%s_Hands_\" % facts[\"name\"], \"out\": str(out), \"grip_steps\": grip_steps, \"render\": render,"},{"kind":"call","line":201,"text":"\"style\": st, \"character\": ch, \"glove_cm\": SU.glove_cm(ch), \"diagnose\": list(diagnose),"},{"kind":"call","line":203,"text":"\"body_ranges\": _body_ranges(ch),"},{"kind":"call","line":205,"text":"\"reference\": reference_for(facts_path, st)}"},{"kind":"call","line":206,"text":"job.update(options or {})          # the hand step's own switches (solver_*, regrip, arc_cm ...), for trials"}],"preds":[9],"stmts":["call str","call ?.resolve","call arms","call str","call SU.glove_cm","call list","call _body_ranges","call reference_for","call job.update"],"succs":[12,13]},{"id":12,"label":"then","preds":[11],"stmts":null,"succs":[13]},{"id":13,"label":"merge","lines":[{"kind":"call","line":207,"text":"_blender(\"gunkit_hands.py\", job, out, timeout=7200)"},{"kind":"call","line":208,"text":"return json.loads((out / \"hands.json\").read_text(encoding=\"utf-8\"))"}],"preds":[12,11],"stmts":["call _blender","call json.loads","call ?.read_text","return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[13],"func_id":"hold-code/weaponlab/gunkit/run.py#func:hands","issues":null},"source":{"end_line":208,"file":"hold-code/weaponlab/gunkit/run.py","kind":"func","language":"python","lines":[{"line":182,"text":"def hands(facts_path, clips=None, grip_steps=3, render=False, style=None, character=None, diagnose=(), options=None):\r"},{"line":183,"text":"    \"\"\"The hand clips on the shared arms (Pose Lab's Lab in Blender): each written as FBX and bone data, with Pose\r"},{"line":184,"text":"    Lab's clipping, anatomy and grip checks, the expected sights (a port in view) and the carried parts' tracks.\r"},{"line":185,"text":"    style: a grip style id (default the action family's); character: a character id (default the project's). The\r"},{"line":186,"text":"    character's glove is counted in the palm's place, the fingers' closure and the clearance allowed.\"\"\"\r"},{"line":187,"text":"    import poselab_mcp\r"},{"line":188,"text":"    from . import setup as SU\r"},{"line":189,"text":"    facts = json.loads(Path(facts_path).read_text(encoding=\"utf-8\"))\r"},{"line":190,"text":"    a = A.load(facts[\"action\"])\r"},{"line":191,"text":"    st = SU.style(style) if style else SU.style_for(facts[\"action\"])\r"},{"line":192,"text":"    ch = SU.character(character)\r"},{"line":193,"text":"    out = Path(facts_path).parent / \"hands\"\r"},{"line":194,"text":"    out.mkdir(exist_ok=True)\r"},{"line":195,"text":"    want = clips or list(a[\"hand_clips\"])\r"},{"line":196,"text":"    tl = {cid: T.hand_clip(a, facts, cid) for cid in want}\r"},{"line":197,"text":"    tracks = {cid: R.tracks(facts, c) for cid, c in tl.items()}\r"},{"line":198,"text":"    job = {\"poselab\": str(Path(poselab_mcp.__file__).resolve().parent / \"blender\"), \"arms\": arms(),\r"},{"line":199,"text":"           \"gun_fbx\": facts[\"model\"][\"file\"], \"facts\": facts, \"clips\": tl, \"tracks\": tracks,\r"},{"line":200,"text":"           \"prefix\": \"A_%s_Hands_\" % facts[\"name\"], \"out\": str(out), \"grip_steps\": grip_steps, \"render\": render,\r"},{"line":201,"text":"           \"style\": st, \"character\": ch, \"glove_cm\": SU.glove_cm(ch), \"diagnose\": list(diagnose),\r"},{"line":202,"text":"           # no bone and no part of the skin of a size no adult has (Pose Lab's body_size, ANSUR II ranges)\r"},{"line":203,"text":"           \"body_ranges\": _body_ranges(ch),\r"},{"line":204,"text":"           # the grip style's reference hold (a pack's hand, in the grip's frame), kept beside the guns' folders\r"},{"line":205,"text":"           \"reference\": reference_for(facts_path, st)}\r"},{"line":206,"text":"    job.update(options or {})          # the hand step's own switches (solver_*, regrip, arc_cm ...), for trials\r"},{"line":207,"text":"    _blender(\"gunkit_hands.py\", job, out, timeout=7200)\r"},{"line":208,"text":"    return json.loads((out / \"hands.json\").read_text(encoding=\"utf-8\"))\r"}],"name":"hands","start_line":182,"symbol_id":"hold-code/weaponlab/gunkit/run.py#func:hands"}}
