":"len(L._thumb_report(side, _TL)[1]) > rules0","id":14,"label":"merge","lines":[{"kind":"call","line":492,"text":"M = L._bw(n)"},{"kind":"call","line":493,"text":"gap0 = finger_gap(side, \"thumb\", tree)"},{"kind":"call","line":494,"text":"L._turn_about(n, axis.normalized(), ang, head)"},{"kind":"call","line":495,"text":"if len(L._thumb_report(side, _TL)[1]) > rules0 or finger_gap(side, \"thumb\", tree) < min(gap0, GLOVE) - 0.05:"}],"preds":[13,12],"stmts":["call L._bw","call finger_gap","call L._turn_about","call axis.normalized","call len","call L._thumb_report"],"succs":[15,16]},{"id":15,"label":"then","lines":[{"kind":"call","line":495,"text":"if len(L._thumb_report(side, _TL)[1]) > rules0 or finger_gap(side, \"thumb\", tree) < min(gap0, GLOVE) - 0.05:"}],"preds":[14],"stmts":["call finger_gap","call min"],"succs":[16]},{"cond":"len(L._thumb_report(side, _TL)[1]) > rules0 or finger_gap(side, 'thumb', tree) < min(gap0, GLOVE) - 0.05","id":16,"label":"merge","preds":[15,14],"stmts":null,"succs":[17,18]},{"id":17,"label":"then","lines":[{"kind":"call","line":496,"text":"L._set_world(n, M)"}],"preds":[16],"stmts":["call L._set_world"],"succs":[18]},{"id":18,"label":"merge","preds":[17,16],"stmts":null,"succs":[4]},{"id":19,"label":"then","preds":[6],"stmts":null,"succs":[20]},{"id":20,"label":"merge","preds":[19,6],"stmts":null,"succs":[1]}],"effects":["unknown"],"entry":0,"exits":[3],"func_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:thumb_to","issues":null},"source":{"end_line":501,"file":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py","kind":"func","language":"python","lines":[{"line":472,"text":"def thumb_to(side, target, tree, rounds=12, step_deg=8.0):\r"},{"line":473,"text":"    \"\"\"The thumb's tip brought to a rest point: each of its joints, tip to base, turned about its head toward the\r"},{"line":474,"text":"    point by at most step_deg a round (cyclic coordinate descent); a turn that breaks a thumb rule or puts the thumb\r"},{"line":475,"text":"    deeper in the gun is undone. Returns the tip's distance left, cm.\"\"\"\r"},{"line":476,"text":"    rules0 = len(L._thumb_report(side, _TL)[1])\r"},{"line":477,"text":"    for _ in range(rounds):\r"},{"line":478,"text":"        moved = False\r"},{"line":479,"text":"        for j in (\"03\", \"02\", \"01\"):\r"},{"line":480,"text":"            n = L._n(\"finger\", side, \"thumb\", j)\r"},{"line":481,"text":"            head = L._bw(n).translation.copy()\r"},{"line":482,"text":"            tip = L._finger_tip(\"thumb\", side)\r"},{"line":483,"text":"            a, b = (tip - head), (target - head)\r"},{"line":484,"text":"            if a.length < 1e-6 or b.length < 1e-6:\r"},{"line":485,"text":"                continue\r"},{"line":486,"text":"            axis = a.cross(b)\r"},{"line":487,"text":"            if axis.length < 1e-9:\r"},{"line":488,"text":"                continue\r"},{"line":489,"text":"            ang = min(step_deg, math.degrees(a.angle(b)))\r"},{"line":490,"text":"            if ang < 0.5:\r"},{"line":491,"text":"                continue\r"},{"line":492,"text":"            M = L._bw(n)\r"},{"line":493,"text":"            gap0 = finger_gap(side, \"thumb\", tree)\r"},{"line":494,"text":"            L._turn_about(n, axis.normalized(), ang, head)\r"},{"line":495,"text":"            if len(L._thumb_report(side, _TL)[1]) > rules0 or finger_gap(side, \"thumb\", tree) < min(gap0, GLOVE) - 0.05:\r"},{"line":496,"text":"                L._set_world(n, M)\r"},{"line":497,"text":"                continue\r"},{"line":498,"text":"            moved = True\r"},{"line":499,"text":"        if not moved:\r"},{"line":500,"text":"            break\r"},{"line":501,"text":"    return (L._finger_tip(\"thumb\", side) - target).length * 100.0\r"}],"name":"thumb_to","start_line":472,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:thumb_to"}}
