d":"call","line":2447,"text":"sc, why = place(best[1])"},{"kind":"call","line":2448,"text":"return {\"score\": round(sc, 3), \"move_cm\": [round(v, 2) for v in best[1][:3]], \"turn_deg\": [round(v, 1) for v in best[1][3:]],"}],"preds":[30],"stmts":["call place","call round"],"succs":[35]},{"id":33,"label":"then","preds":[31],"stmts":null,"succs":[34]},{"id":34,"label":"merge","preds":[33,31],"stmts":null,"succs":[30]},{"cond":"for v in best[1][:3]","id":35,"label":"loop_header","preds":[32,36],"stmts":null,"succs":[36,37]},{"id":36,"label":"loop_body","lines":[{"kind":"call","line":2448,"text":"return {\"score\": round(sc, 3), \"move_cm\": [round(v, 2) for v in best[1][:3]], \"turn_deg\": [round(v, 1) for v in best[1][3:]],"}],"preds":[35],"stmts":["call round"],"succs":[35]},{"id":37,"label":"loop_exit","preds":[35],"stmts":null,"succs":[38]},{"cond":"for v in best[1][3:]","id":38,"label":"loop_header","preds":[37,39],"stmts":null,"succs":[39,40]},{"id":39,"label":"loop_body","lines":[{"kind":"call","line":2448,"text":"return {\"score\": round(sc, 3), \"move_cm\": [round(v, 2) for v in best[1][:3]], \"turn_deg\": [round(v, 1) for v in best[1][3:]],"}],"preds":[38],"stmts":["call round"],"succs":[38]},{"id":40,"label":"loop_exit","lines":[{"kind":"return","line":2448,"text":"return {\"score\": round(sc, 3), \"move_cm\": [round(v, 2) for v in best[1][:3]], \"turn_deg\": [round(v, 1) for v in best[1][3:]],"}],"preds":[38],"stmts":["return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[40],"func_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.solve_hand","issues":null},"source":{"end_line":2449,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"method","language":"python","lines":[{"line":2361,"text":"    def solve_hand(self, side, point, normal, plan=None, toward=None, glove_cm=0.0, frame=\"gun\", span_cm=1.5,\r"},{"line":2362,"text":"                   turn_deg=20.0, samples=40, refine=16, seed=1, other=True, soft=None, from_current=False, tilt_deg=None,\r"},{"line":2363,"text":"                   anchors=None, anchor_w=3.0, contact_rules=None, contact_w=8.0):\r"},{"line":2364,"text":"        \"\"\"The grasp solver: the hand placed on a hold as a whole. Around the palm laid on the point (facing into\r"},{"line":2365,"text":"        the surface's normal, its fingers toward the given way), places up to span_cm off along the surface and its\r"},{"line":2366,"text":"        normal and turns up to turn_deg about the normal (half that about the other two axes) are tried, the digits\r"},{"line":2367,"text":"        closed by the plan for each; the place that presses least past what is allowed (into the gun and into the\r"},{"line":2368,"text":"        other hand, the glove counted), keeps the palm on the surface, and leaves the arm and the fingers within their\r"},{"line":2369,"text":"        limits wins, then is refined round itself. Returns its score's parts; the hand is left there.\r"},{"line":2370,"text":"        from_current: the tries move and turn the hand from where it is now (about its palm's middle), keeping what\r"},{"line":2371,"text":"        a placement before it set (the thumb's base across the gun), instead of laying the palm afresh.\"\"\"\r"},{"line":2372,"text":"        import random as _random\r"},{"line":2373,"text":"        self._need()\r"},{"line":2374,"text":"        rnd = _random.Random(seed)\r"},{"line":2375,"text":"        at = Vector(point) if frame == \"world\" else self._point(point, frame)\r"},{"line":2376,"text":"        G = self._gun().to_quaternion()\r"},{"line":2377,"text":"        nrm = (G @ ue(normal)).normalized() if frame == \"gun\" else Vector(normal).normalized()\r"},{"line":2378,"text":"        tw = None if toward is None else ((G @ ue(toward)).normalized() if frame == \"gun\" else Vector(toward).normalized())\r"},{"line":2379,"text":"        t1 = nrm.orthogonal().normalized()\r"},{"line":2380,"text":"        t2 = nrm.cross(t1).normalized()\r"},{"line":2381,"text":"        tree = self._tree()\r"},{"line":2382,"text":"        thick = (self._fitted_radii() or {}).get(\"palm\", RADIUS[\"palm\"]) * 100.0 + glove_cm - 0.15\r"},{"line":2383,"text":"        self.snapshot(\"save\", \"_solve_hand\")\r"},{"line":2384,"text":"        hn0 = self._n(\"hand\", side)\r"},{"line":2385,"text":"        H0 = self._bw(hn0).copy()\r"},{"line":2386,"text":"        P0 = H0.translation.lerp(self._bw(self._n(\"finger\", side, \"middle\", \"01\")).translation, 0.5)\r"},{"line":2387,"text":"\r"},{"line":2388,"text":"        def place(p):\r"},{"line":2389,"text":"            self.snapshot(\"load\", \"_solve_hand\")\r"},{"line":2390,"text":"            dx, dy, dz, yaw, pa, pb = p\r"},{"line":2391,"text":"            if from_current:\r"},{"line":2392,"text":"                q = Quaternion(nrm, math.radians(yaw)) @ Quaternion(t1, math.radians(pa)) @ Quaternion(t2, math.radians(pb))\r"},{"line":2393,"text":"                R = (Matrix.Translation((t1 * dx + t2 * dy + nrm * dz) / 100.0) @ Matrix.Translation(P0)\r"},{"line":2394,"text":"                     @ q.to_matrix().to_4x4() @ Matrix.Translation(-P0) @ H0)\r"},{"line":2395,"text":"                short = self._put_hand(side, Matrix.LocRotScale(R.translation, R.to_quaternion(), self._unit()))\r"},{"line":2396,"text":"                self.close_hand(side, plan, tree, glove_cm, other, from_pose=not anchors and not contact_rules,\r"},{"line":2397,"text":"                                rules=contact_rules)\r"},{"line":2398,"text":"                sc, why = self._hand_score(side, tree, glove_cm, other, soft, short)\r"},{"line":2399,"text":"                if contact_rules:\r"},{"line":2400,"text":"                    vv_ = self._gun_verts()\r"},{"line":2401,"text":"                    ev_ = [self._rule_eval(side, r_, glove_cm, vv_) for r_ in contact_rules]\r"},{"line":2402,"text":"                    cerr = sum(e[\"error\"] * (1.0 if r_.get(\"need\", \"required\") == \"required\" else 0.3)\r"},{"line":2403,"text":"                               for e, r_ in zip(ev_, contact_rules))\r"},{"line":2404,"text":"                    sc += contact_w * cerr\r"},{"line":2405,"text":"                    why = dict(why, contacts={e[\"id\"]: e[\"error\"] for e in ev_})\r"},{"line":2406,"text":"                if anchors:\r"},{"line":2407,"text":"                    off = {k: (self._anchor(side, k) - Vector(v)).length * 100.0 for k, v in anchors.items()}\r"},{"line":2408,"text":"                    sc += anchor_w * sum(max(0.0, d - 0.5) for d in off.values())\r"},{"line":2409,"text":"                    why = dict(why, anchors_cm={k: round(d, 2) for k, d in off.items()})\r"},{"line":2410,"text":"                return sc, why\r"},{"line":2411,"text":"            n2 = (Quaternion(t1, math.radians(pa)) @ Quaternion(t2, math.radians(pb)) @ nrm).normalized()\r"},{"line":2412,"text":"            way = tw if tw is not None else None\r"},{"line":2413,"text":"            if way is not None:\r"},{"line":2414,"text":"                way = Quaternion(nrm, math.radians(yaw)) @ way\r"},{"line":2415,"text":"            short = self._lay(side, at + (t1 * dx + t2 * dy + nrm * dz) / 100.0, n2, way, thick)\r"},{"line":2416,"text":"            if way is None and abs(yaw) > 1e-6:\r"},{"line":2417,"text":"                hn = self._n(\"hand\", side)\r"},{"line":2418,"text":"                H = self._bw(hn)\r"},{"line":2419,"text":"                P = H.translation\r"},{"line":2420,"text":"                R = Matrix.Translation(P) @ Quaternion(nrm, math.radians(yaw)).to_matrix().to_4x4() @ Matrix.Translation(-P) @ H\r"},{"line":2421,"text":"                short = self._put_hand(side, Matrix.LocRotScale(R.translation, R.to_quaternion(), self._unit()))\r"},{"line":2422,"text":"            self.close_hand(side, plan, tree, glove_cm, other)\r"},{"line":2423,"text":"            return self._hand_score(side, tree, glove_cm, other, soft, short)\r"},{"line":2424,"text":"\r"},{"line":2425,"text":"        best = (None, None, None)\r"},{"line":2426,"text":"        tried = 0\r"},{"line":2427,"text":"        tl = turn_deg / 2 if tilt_deg is None else tilt_deg\r"},{"line":2428,"text":"        # a wide turn (no finger direction to start from) is swept first: every 30 degrees about the face's normal\r"},{"line":2429,"text":"        sweep = [(0.0, 0.0, 0.0, float(y), 0.0, 0.0) for y in range(-180, 180, 30)] if turn_deg >= 90.0 else []\r"},{"line":2430,"text":"        cands = [(0.0,) * 6] + sweep + [(rnd.uniform(-span_cm, span_cm), rnd.uniform(-span_cm, span_cm), rnd.uniform(-0.3, 0.6 * span_cm),\r"},{"line":2431,"text":"                                         rnd.uniform(-turn_deg, turn_deg), rnd.uniform(-tl, tl), rnd.uniform(-tl, tl))\r"},{"line":2432,"text":"                                        for _ in range(max(0, samples - 1))]\r"},{"line":2433,"text":"        for p in cands:\r"},{"line":2434,"text":"            sc, why = place(p)\r"},{"line":2435,"text":"            tried += 1\r"},{"line":2436,"text":"            if best[0] is None or sc < best[0]:\r"},{"line":2437,"text":"                best = (sc, p, why)\r"},{"line":2438,"text":"        for _ in range(refine):\r"},{"line":2439,"text":"            p0 = best[1]\r"},{"line":2440,"text":"            tr = min(turn_deg, 30.0)\r"},{"line":2441,"text":"            p = (p0[0] + rnd.uniform(-0.3, 0.3) * span_cm, p0[1] + rnd.uniform(-0.3, 0.3) * span_cm, p0[2] + rnd.uniform(-0.15, 0.15) * span_cm,\r"},{"line":2442,"text":"                 p0[3] + rnd.uniform(-0.3, 0.3) * tr, p0[4] + rnd.uniform(-0.3, 0.3) * min(tl, 15.0), p0[5] + rnd.uniform(-0.3, 0.3) * min(tl, 15.0))\r"},{"line":2443,"text":"            sc, why = place(p)\r"},{"line":2444,"text":"            tried += 1\r"},{"line":2445,"text":"            if sc < best[0]:\r"},{"line":2446,"text":"                best = (sc, p, why)\r"},{"line":2447,"text":"        sc, why = place(best[1])\r"},{"line":2448,"text":"        return {\"score\": round(sc, 3), \"move_cm\": [round(v, 2) for v in best[1][:3]], \"turn_deg\": [round(v, 1) for v in best[1][3:]],\r"},{"line":2449,"text":"                \"tried\": tried, **why}\r"}],"name":"solve_hand","start_line":2361,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.solve_hand"}}
