rs=FL, thumb=TL)}\r"},{"line":2989,"text":"        for s_ in ((\"l\", \"r\") if side == \"both\" else (side,)):\r"},{"line":2990,"text":"            rep_, bad = self._arm_report(s_, L)\r"},{"line":2991,"text":"            if fingers and self._has_fingers(s_):\r"},{"line":2992,"text":"                fr, fbad, _ = self._finger_report(s_, FL)\r"},{"line":2993,"text":"                rep_[\"fingers\"] = fr\r"},{"line":2994,"text":"                bad += fbad\r"},{"line":2995,"text":"            if fingers and self._has_thumb(s_):\r"},{"line":2996,"text":"                tr, tbad, _ = self._thumb_report(s_, TL)\r"},{"line":2997,"text":"                rep_[\"thumb\"] = tr\r"},{"line":2998,"text":"                bad += tbad\r"},{"line":2999,"text":"            rep_[\"bad\"] = bad\r"},{"line":3000,"text":"            out[s_] = rep_\r"},{"line":3001,"text":"            out[\"ok\"] = out[\"ok\"] and not bad\r"},{"line":3002,"text":"        return out\r"}],"name":"anatomy","start_line":2977,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:anatomy"}}
