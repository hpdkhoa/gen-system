 lo, hn = self._n(\"lowerarm\", s), self._n(\"hand\", s)\r"},{"line":2724,"text":"        if lo not in self.arm.pose.bones or hn not in self.arm.pose.bones:\r"},{"line":2725,"text":"            return []\r"},{"line":2726,"text":"        E, W = self._bw(lo).translation, self._bw(hn).translation\r"},{"line":2727,"text":"        a = W - E\r"},{"line":2728,"text":"        if a.length_squared < 1e-12:\r"},{"line":2729,"text":"            return []\r"},{"line":2730,"text":"        out = [(min(max((self.arm.matrix_world @ pb.head - E).dot(a) / a.length_squared, 0.0), 1.0), pb.name)\r"},{"line":2731,"text":"               for pb in self.arm.pose.bones[lo].children if pb.name != hn and \"twist\" in pb.name.lower()]\r"},{"line":2732,"text":"        return sorted(out)\r"}],"name":"_twist_bones","start_line":2720,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._twist_bones"}}
