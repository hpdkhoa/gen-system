effects":["unknown"],"entry":0,"exits":[19],"func_id":"hold-code/poselab_mcp/blender/contactlab.py#method:ContactMixin._skin_now","issues":null},"source":{"end_line":216,"file":"hold-code/poselab_mcp/blender/contactlab.py","kind":"method","language":"python","lines":[{"line":190,"text":"    def _skin_now(self):\r"},{"line":191,"text":"        \"\"\"The skin as posed: world points, normals, each vertex's area in cm2 (its share of the world-size\r"},{"line":192,"text":"        polygons round it), its heaviest bone, and the triangles.\"\"\"\r"},{"line":193,"text":"        ob = self.meshes[0]\r"},{"line":194,"text":"        names = {g.index: g.name for g in ob.vertex_groups}\r"},{"line":195,"text":"        bone = []\r"},{"line":196,"text":"        for v0 in ob.data.vertices:\r"},{"line":197,"text":"            gm = max(v0.groups, key=lambda x: x.weight) if v0.groups else None\r"},{"line":198,"text":"            bone.append(names.get(gm.group, \"\") if gm else \"\")\r"},{"line":199,"text":"        dg = bpy.context.evaluated_depsgraph_get()\r"},{"line":200,"text":"        ev = ob.evaluated_get(dg)\r"},{"line":201,"text":"        me = ev.to_mesh()\r"},{"line":202,"text":"        M = ev.matrix_world\r"},{"line":203,"text":"        R3 = M.to_3x3()\r"},{"line":204,"text":"        P = np.array([list(M @ v.co) for v in me.vertices])\r"},{"line":205,"text":"        N = np.array([list((R3 @ v.normal).normalized()) for v in me.vertices])\r"},{"line":206,"text":"        A = np.zeros(len(P))\r"},{"line":207,"text":"        tris = []\r"},{"line":208,"text":"        for p in me.polygons:\r"},{"line":209,"text":"            vs = list(p.vertices)\r"},{"line":210,"text":"            for k in range(1, len(vs) - 1):\r"},{"line":211,"text":"                tris.append((vs[0], vs[k], vs[k + 1]))\r"},{"line":212,"text":"                a = 0.5 * float(np.linalg.norm(np.cross(P[vs[k]] - P[vs[0]], P[vs[k + 1]] - P[vs[0]]))) * 1e4\r"},{"line":213,"text":"                for i in (vs[0], vs[k], vs[k + 1]):\r"},{"line":214,"text":"                    A[i] += a / 3.0\r"},{"line":215,"text":"        ev.to_mesh_clear()\r"},{"line":216,"text":"        return P, N, A, bone, tris\r"}],"name":"_skin_now","start_line":190,"symbol_id":"hold-code/poselab_mcp/blender/contactlab.py#method:ContactMixin._skin_now"}}
