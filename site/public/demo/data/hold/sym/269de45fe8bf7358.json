d-code/weaponlab/gunkit/blender/gunkit_hands.py#func:finger_gap","issues":null},"source":{"end_line":318,"file":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py","kind":"func","language":"python","lines":[{"line":305,"text":"def finger_gap(side, fi, tree):\r"},{"line":306,"text":"    \"\"\"The finger's skin to the gun's surface, the closest of its three segments (cm; under 0 when inside).\"\"\"\r"},{"line":307,"text":"    best = None\r"},{"line":308,"text":"    for name, a, b, r in L._segments(side):\r"},{"line":309,"text":"        if not name.startswith(fi):\r"},{"line":310,"text":"            continue\r"},{"line":311,"text":"        n = max(2, int((b - a).length / 0.003))\r"},{"line":312,"text":"        for i in range(n + 1):\r"},{"line":313,"text":"            q, dq = tree.nearest(a.lerp(b, i / n))\r"},{"line":314,"text":"            if q is None:\r"},{"line":315,"text":"                continue\r"},{"line":316,"text":"            gap = (dq - r) * 100.0\r"},{"line":317,"text":"            best = gap if best is None else min(best, gap)\r"},{"line":318,"text":"    return 99.0 if best is None else best\r"}],"name":"finger_gap","start_line":305,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:finger_gap"}}
