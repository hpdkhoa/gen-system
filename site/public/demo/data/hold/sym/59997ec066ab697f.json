f[\"middle\"][0] - wrist\r"},{"line":90,"text":"    curls = {}\r"},{"line":91,"text":"    for fi in (\"index\", \"middle\", \"ring\", \"pinky\"):\r"},{"line":92,"text":"        pts = [f[fi][0] - w2k, f[fi][0], f[fi][1], f[fi][2], f[fi][3]]\r"},{"line":93,"text":"        c3 = []\r"},{"line":94,"text":"        for i in range(3):\r"},{"line":95,"text":"            a, c = (pts[i + 1] - pts[i]).normalized(), (pts[i + 2] - pts[i + 1]).normalized()\r"},{"line":96,"text":"            c3.append(round(math.degrees(math.atan2(a.cross(c).dot(across) * sign, a.dot(c))), 1))\r"},{"line":97,"text":"        curls[fi] = c3\r"},{"line":98,"text":"    t = f[\"thumb\"]\r"},{"line":99,"text":"    elbow = Vector(head(B[\"forearm\"])) if B.get(\"forearm\") else None\r"},{"line":100,"text":"    extra = {}\r"},{"line":101,"text":"    if elbow is not None:\r"},{"line":102,"text":"        # the forearm's line and the wrist's bend off it (the forearm to the wrist against the wrist to the middle\r"},{"line":103,"text":"        # knuckle), as the animator posed them\r"}],"name":"lips","start_line":63,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_pack_hold.py#var:lips"}}
