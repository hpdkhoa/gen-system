{"flow":{"blocks":[{"id":0,"label":"entry","lines":[{"kind":"call","line":1134,"text":"TL = self._thumb_limits()"},{"kind":"call","line":1135,"text":"n1 = self._n(\"finger\", side, \"thumb\", \"01\")"},{"kind":"call","line":1136,"text":"P_, N_ = self._skin_arrays()[:2]"},{"kind":"call","line":1137,"text":"ix, lb = self._hand_label_arrays(side, P_, N_)"},{"kind":"call","line":1138,"text":"pad = np.array([i for i, l_ in zip(ix, lb) if l_.startswith(\"thumb\") and l_.endswith(\"_pad\")])"}],"preds":null,"stmts":["call self._thumb_limits","call self._n","call self._skin_arrays","call self._hand_label_arrays","call np.array"],"succs":[1]},{"cond":"for (i, l_) in zip(ix, lb)","id":1,"label":"loop_header","preds":[0,7],"stmts":null,"succs":[2,3]},{"cond":"l_.startswith('thumb') and l_.endswith('_pad')","id":2,"label":"loop_body","preds":[1],"stmts":null,"succs":[4,5]},{"id":3,"label":"loop_exit","lines":[{"kind":"call","line":1163,"text":"return self._descend(err, [base((1, 0, 0)), base((0, 1, 0)), base((0, 0, 1)), bend(\"02\"), bend(\"03\")], side, other)"}],"preds":[1],"stmts":["call self._descend","call base","call base","call base","call bend","call bend","return"],"succs":null},{"id":4,"label":"then","preds":[2],"stmts":null,"succs":[5]},{"cond":"l_.startswith('thumb')","id":5,"label":"merge","lines":[{"kind":"call","line":1138,"text":"pad = np.array([i for i, l_ in zip(ix, lb) if l_.startswith(\"thumb\") and l_.endswith(\"_pad\")])"}],"preds":[4,2],"stmts":["call l_.startswith"],"succs":[6,7]},{"id":6,"label":"then","lines":[{"kind":"call","line":1138,"text":"pad = np.array([i for i, l_ in zip(ix, lb) if l_.startswith(\"thumb\") and l_.endswith(\"_pad\")])"}],"preds":[5],"stmts":["call l_.endswith"],"succs":[7]},{"id":7,"label":"merge","preds":[6,5],"stmts":null,"succs":[1]}],"effects":["unknown"],"entry":0,"exits":[3],"func_id":"hold-code/poselab_mcp/blender/holdlab.py#method:HoldMixin._fit_thumb","issues":null},"source":{"end_line":1163,"file":"hold-code/poselab_mcp/blender/holdlab.py","kind":"method","language":"python","lines":[{"line":1129,"text":"    def _fit_thumb(self, side, mark, glove_cm, along=None, inline=True, other=True):\r"},{"line":1130,"text":"        \"\"\"A thumb placed: its base turned about three axes and its two joints bent, a fixed step pattern, its pad\r"},{"line":1131,"text":"        just on the object (a gap of -0.1 cm wanted) and an inline thumb on the index's line (or along). Inside the\r"},{"line":1132,"text":"        walls: a turn that takes the base past its spread or the joints past their ranges, or the thumb into the\r"},{"line":1133,"text":"        object either way, is undone.\"\"\"\r"},{"line":1134,"text":"        TL = self._thumb_limits()\r"},{"line":1135,"text":"        n1 = self._n(\"finger\", side, \"thumb\", \"01\")\r"},{"line":1136,"text":"        P_, N_ = self._skin_arrays()[:2]\r"},{"line":1137,"text":"        ix, lb = self._hand_label_arrays(side, P_, N_)\r"},{"line":1138,"text":"        pad = np.array([i for i, l_ in zip(ix, lb) if l_.startswith(\"thumb\") and l_.endswith(\"_pad\")])\r"},{"line":1139,"text":"\r"},{"line":1140,"text":"        def err():\r"},{"line":1141,"text":"            P = self._skin_arrays()[0]\r"},{"line":1142,"text":"            gap = float(self.sdf_query(P[pad], want_normal=False)[0].min()) if len(pad) else 5.0\r"},{"line":1143,"text":"            e = abs(gap + 0.1) / 0.3\r"},{"line":1144,"text":"            if inline:\r"},{"line":1145,"text":"                e += self.purpose_thumb_inline(side, mark, glove_cm, along=along)[\"error\"]\r"},{"line":1146,"text":"            return e\r"},{"line":1147,"text":"\r"},{"line":1148,"text":"        def base(ax):\r"},{"line":1149,"text":"            def mv(deg):\r"},{"line":1150,"text":"                head = self._bw(n1).translation.copy()\r"},{"line":1151,"text":"                self._turn_about(n1, Vector(ax), deg, head)\r"},{"line":1152,"text":"            return mv\r"},{"line":1153,"text":"\r"},{"line":1154,"text":"        def bend(j):\r"},{"line":1155,"text":"            def mv(deg):\r"},{"line":1156,"text":"                if self.R.get(\"thumb_hinge\") == \"ray\":\r"},{"line":1157,"text":"                    self._thumb_flex(side, j, deg)\r"},{"line":1158,"text":"                else:\r"},{"line":1159,"text":"                    tr = self._thumb_report(side, TL)[0]\r"},{"line":1160,"text":"                    b2, b3 = tr.get(\"thumb_02\", [0, 0])[0], tr.get(\"thumb_03\", [0, 0])[0]\r"},{"line":1161,"text":"                    self._set_thumb_bend(side, b2 + (deg if j == \"02\" else 0.0), b3 + (deg if j == \"03\" else 0.0), TL)\r"},{"line":1162,"text":"            return mv\r"},{"line":1163,"text":"        return self._descend(err, [base((1, 0, 0)), base((0, 1, 0)), base((0, 0, 1)), bend(\"02\"), bend(\"03\")], side, other)\r"}],"name":"_fit_thumb","start_line":1129,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#method:HoldMixin._fit_thumb"}}
