text":"        self.folder = folder\r"},{"line":276,"text":"        bpy.ops.import_scene.fbx(filepath=os.path.join(folder, R[\"arms\"]))\r"},{"line":277,"text":"        old = [o for o in bpy.data.objects if o.type == 'ARMATURE'][0]\r"},{"line":278,"text":"        mesh = [o for o in bpy.data.objects if o.type == 'MESH'][0]\r"},{"line":279,"text":"        if R.get(\"idle\"):\r"},{"line":280,"text":"            # the idle clip's armature drives the mesh (a mesh file's own armature may have a bad rest)\r"},{"line":281,"text":"            before = set(bpy.data.objects.keys())\r"},{"line":282,"text":"            bpy.ops.import_scene.fbx(filepath=os.path.join(folder, R[\"idle\"]))\r"},{"line":283,"text":"            self.arm = [o for o in bpy.data.objects if o.type == 'ARMATURE' and o.name not in before][0]\r"},{"line":284,"text":"            for m in mesh.modifiers:\r"},{"line":285,"text":"                if m.type == 'ARMATURE':\r"},{"line":286,"text":"                    m.object = self.arm\r"},{"line":287,"text":"            mw = mesh.matrix_world.copy()\r"},{"line":288,"text":"            mesh.parent = self.arm\r"},{"line":289,"text":"            mesh.matrix_world = mw\r"},{"line":290,"text":"            self.orphans = _adopt_orphans(mesh, old, self.arm)\r"},{"line":291,"text":"            bpy.data.objects.remove(old)\r"},{"line":292,"text":"            edits = R.get(\"bone_edits\")\r"},{"line":293,"text":"            if isinstance(edits, str):\r"},{"line":294,"text":"                with open(os.path.join(folder, edits), encoding=\"utf-8\") as fh:\r"},{"line":295,"text":"                    edits = json.load(fh)\r"},{"line":296,"text":"            if edits:\r"},{"line":297,"text":"                self._edit_skeleton(edits)\r"},{"line":298,"text":"            act = self.arm.animation_data.action\r"},{"line":299,"text":"            self.sc.frame_set(int(act.frame_range[0]))\r"},{"line":300,"text":"            bpy.context.view_layer.update()\r"},{"line":301,"text":"        else:\r"},{"line":302,"text":"            self.arm = old\r"},{"line":303,"text":"        self.meshes = [mesh]\r"},{"line":304,"text":"        before = set(bpy.data.objects.keys())\r"},{"line":305,"text":"        bpy.ops.import_scene.fbx(filepath=os.path.join(folder, R[\"gun\"]))\r"},{"line":306,"text":"        new = [o for o in bpy.data.objects if o.name not in before]\r"},{"line":307,"text":"        self.rifle_arm = [o for o in new if o.type == 'ARMATURE'][0]\r"},{"line":308,"text":"        self.rifle_mesh = [o for o in new if o.type == 'MESH'][0]\r"}],"name":"_load_files","start_line":273,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#func:_load_files"}}
