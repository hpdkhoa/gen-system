es":null},"source":{"end_line":453,"file":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py","kind":"func","language":"python","lines":[{"line":432,"text":"def pose_digits(side, h, trigger, tree, fingers=None):\r"},{"line":433,"text":"    fingers = fingers or h[\"fingers\"]\r"},{"line":434,"text":"    for fi in DIGITS:\r"},{"line":435,"text":"        f = fingers.get(fi)\r"},{"line":436,"text":"        if trigger and fi == \"index\" and h.get(\"trigger\"):\r"},{"line":437,"text":"            f = h[\"trigger\"]\r"},{"line":438,"text":"        if not f or f[\"pose\"] == \"rest\":\r"},{"line":439,"text":"            continue\r"},{"line":440,"text":"        if f[\"pose\"] == \"straight\":\r"},{"line":441,"text":"            set_finger(side, fi, f[\"curl\"])\r"},{"line":442,"text":"        elif f[\"pose\"] == \"wrap\":\r"},{"line":443,"text":"            wrap(side, fi, f[\"max_curl\"], tree)\r"},{"line":444,"text":"    t = fingers.get(\"thumb\")\r"},{"line":445,"text":"    if t and t[\"pose\"] == \"straight\":\r"},{"line":446,"text":"        set_thumb(side, t[\"curl\"][1], t[\"curl\"][2])\r"},{"line":447,"text":"    elif t and t[\"pose\"] == \"wrap\":\r"},{"line":448,"text":"        thumb_wrap(side, t[\"max_curl\"], tree)\r"},{"line":449,"text":"    elif t and t[\"pose\"] == \"to\":\r"},{"line":450,"text":"        thumb_to(side, RA.matrix_world @ g(t[\"point\"]), tree)\r"},{"line":451,"text":"    L._mend_hand(side)                                  # the joints back in range and in their fingers' planes\r"},{"line":452,"text":"    end_joints_flat(side)\r"},{"line":453,"text":"    thumb_clear(side, tree)\r"}],"name":"pose_digits","start_line":432,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:pose_digits"}}
