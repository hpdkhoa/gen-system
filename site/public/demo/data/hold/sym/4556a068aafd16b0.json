{"flow":{"kind":"var","name":"dg","noCFG":true,"reason":"dg is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":72,"file":"hold-code/weaponlab/gunkit/blender/gunkit_pack_hold.py","kind":"var","language":"python","lines":[{"line":32,"text":"dg = bpy.context.evaluated_depsgraph_get()\r"},{"line":33,"text":"\r"},{"line":34,"text":"\r"},{"line":35,"text":"def verts(name):\r"},{"line":36,"text":"    ob = bpy.data.objects[name]\r"},{"line":37,"text":"    ev = ob.evaluated_get(dg)\r"},{"line":38,"text":"    me = ev.to_mesh()\r"},{"line":39,"text":"    pts = np.array([list(ev.matrix_world @ v.co) for v in me.vertices])\r"},{"line":40,"text":"    ev.to_mesh_clear()\r"},{"line":41,"text":"    return pts\r"},{"line":42,"text":"\r"},{"line":43,"text":"\r"},{"line":44,"text":"def axis(pts):\r"},{"line":45,"text":"    c = pts.mean(0)\r"},{"line":46,"text":"    _u, _s, vt = np.linalg.svd(pts - c)\r"},{"line":47,"text":"    return c, vt[0]\r"},{"line":48,"text":"\r"},{"line":49,"text":"\r"},{"line":50,"text":"G = job[\"gun\"]\r"},{"line":51,"text":"body = verts(G[\"frame\"]).mean(0)\r"},{"line":52,"text":"mags = sorted(G[\"magazine\"], key=lambda n: float(np.linalg.norm(verts(n).mean(0) - body)))\r"},{"line":53,"text":"mag = verts(mags[0])\r"},{"line":54,"text":"slide = verts(G[\"slide\"])\r"},{"line":55,"text":"mc, up = axis(mag)\r"},{"line":56,"text":"sc_, fwd = axis(slide)\r"},{"line":57,"text":"if np.dot(up, sc_ - mc) < 0:\r"},{"line":58,"text":"    up = -up                                          # up the magazine: toward the slide\r"},{"line":59,"text":"proj = (slide - sc_) @ fwd\r"},{"line":60,"text":"mag_on = float((mc - sc_) @ fwd)\r"},{"line":61,"text":"if abs(proj.max() - mag_on) < abs(proj.min() - mag_on):\r"},{"line":62,"text":"    fwd = -fwd                                        # forward: toward the slide's end far from the grip\r"},{"line":63,"text":"lips = mag[int(np.argmax((mag - mc) @ up))]\r"},{"line":64,"text":"left = np.cross(up, fwd)                              # Blender's world is right-handed: up x forward is the left\r"},{"line":65,"text":"FR = REF.grip_frame(list(lips), list(up), list(fwd), list(left))\r"},{"line":66,"text":"W = arm.matrix_world\r"},{"line":67,"text":"\r"},{"line":68,"text":"\r"},{"line":69,"text":"def head(n):\r"},{"line":70,"text":"    return list(W @ arm.pose.bones[n].head)\r"},{"line":71,"text":"\r"},{"line":72,"text":"\r"}],"name":"dg","start_line":32,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_pack_hold.py#var:dg"}}
