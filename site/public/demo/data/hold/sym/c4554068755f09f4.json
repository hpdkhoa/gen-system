":null},"source":{"end_line":366,"file":"hold-code/poselab_mcp/blender/contactlab.py","kind":"method","language":"python","lines":[{"line":315,"text":"    def relax_fingers(self, side, fingers=(\"index\", \"middle\", \"ring\", \"pinky\", \"thumb\"), step_deg=4.0, rounds=8,\r"},{"line":316,"text":"                      allow_cm=0.05):\r"},{"line":317,"text":"        \"\"\"Every finger opened, by the drawn skin, until it no longer presses into the object: each round one read\r"},{"line":318,"text":"        of the skin, and in each finger still pressing the joint whose segment presses deepest opens step_deg\r"},{"line":319,"text":"        (closing by capsules leaves skin a little inside: the capsules are thinner than the flesh at the pads).\r"},{"line":320,"text":"        Returns each finger's degrees opened.\"\"\"\r"},{"line":321,"text":"        bvh, surf = self._object_now()[:2]\r"},{"line":322,"text":"        _bone, _T, sidev, kind, segi = self._skin_static()\r"},{"line":323,"text":"        sc_ = 1 if side == \"r\" else 2\r"},{"line":324,"text":"        FL = self._limits()[1]\r"},{"line":325,"text":"        TL = self._thumb_limits()\r"},{"line":326,"text":"        verts = {}\r"},{"line":327,"text":"        for fi in fingers:\r"},{"line":328,"text":"            k0 = DIGITS.index(fi) * 3\r"},{"line":329,"text":"            vi = np.nonzero((sidev == sc_) & (kind == 3) & (segi >= k0) & (segi < k0 + 3))[0]\r"},{"line":330,"text":"            if len(vi):\r"},{"line":331,"text":"                verts[fi] = (k0, vi[:: max(1, len(vi) // 90)])\r"},{"line":332,"text":"        opened = {fi: 0.0 for fi in verts}\r"},{"line":333,"text":"        live = set(verts)\r"},{"line":334,"text":"        for _ in range(rounds):\r"},{"line":335,"text":"            if not live:\r"},{"line":336,"text":"                break\r"},{"line":337,"text":"            P, _N, _A, _b, _t = self._skin_arrays()\r"},{"line":338,"text":"            moved = False\r"},{"line":339,"text":"            for fi in sorted(live):\r"},{"line":340,"text":"                k0, vi = verts[fi]\r"},{"line":341,"text":"                deep = {}\r"},{"line":342,"text":"                D, _w, _n = self.sdf_query(P[vi], want_normal=False)\r"},{"line":343,"text":"                for i, dcm in zip(vi, D):\r"},{"line":344,"text":"                    if dcm < -allow_cm:\r"},{"line":345,"text":"                        j = int(segi[i]) - k0\r"},{"line":346,"text":"                        deep[j] = max(deep.get(j, 0.0), -dcm / 100.0)\r"},{"line":347,"text":"                if not deep:\r"},{"line":348,"text":"                    live.discard(fi)\r"},{"line":349,"text":"                    continue\r"},{"line":350,"text":"                jn = (\"01\", \"02\", \"03\")[max(deep, key=deep.get)]\r"},{"line":351,"text":"                if fi == \"thumb\":\r"},{"line":352,"text":"                    jn = \"02\" if jn == \"01\" else jn\r"},{"line":353,"text":"                    if self.R.get(\"thumb_hinge\") == \"ray\":\r"},{"line":354,"text":"                        self._thumb_flex(side, jn, -step_deg)\r"},{"line":355,"text":"                    else:\r"},{"line":356,"text":"                        tr = self._thumb_report(side, TL)[0]\r"},{"line":357,"text":"                        b2, b3 = tr.get(\"thumb_02\", [0, 0])[0], tr.get(\"thumb_03\", [0, 0])[0]\r"},{"line":358,"text":"                        self._set_thumb_bend(side, b2 - (step_deg if jn == \"02\" else 0.0), b3 - (step_deg if jn == \"03\" else 0.0), TL)\r"},{"line":359,"text":"                else:\r"},{"line":360,"text":"                    cur = self._finger_report(side, FL)[0][\"%s_%s\" % (fi, jn)][0]\r"},{"line":361,"text":"                    self._set_curl(side, fi, jn, cur - step_deg, FL)\r"},{"line":362,"text":"                opened[fi] += step_deg\r"},{"line":363,"text":"                moved = True\r"},{"line":364,"text":"            if moved:\r"},{"line":365,"text":"                bpy.context.view_layer.update()\r"},{"line":366,"text":"        return opened\r"}],"name":"relax_fingers","start_line":315,"symbol_id":"hold-code/poselab_mcp/blender/contactlab.py#method:ContactMixin.relax_fingers"}}
