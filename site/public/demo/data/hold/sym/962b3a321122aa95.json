{"flow":{"kind":"var","name":"_GP","noCFG":true,"reason":"_GP is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":721,"file":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py","kind":"var","language":"python","lines":[{"line":681,"text":"_GP = []\r"},{"line":682,"text":"\r"},{"line":683,"text":"\r"},{"line":684,"text":"def _bound(b, axis, part_ext):\r"},{"line":685,"text":"    if isinstance(b, (int, float)):\r"},{"line":686,"text":"        return float(b)\r"},{"line":687,"text":"    if b.startswith(\"frac:\"):\r"},{"line":688,"text":"        lo, hi = part_ext\r"},{"line":689,"text":"        return lo + (hi - lo) * float(b[5:])\r"},{"line":690,"text":"    import re as _re\r"},{"line":691,"text":"    m = _re.match(r\"^([A-Za-z_]+)([+-][0-9.]+)?$\", b)\r"},{"line":692,"text":"    return facts[\"marks\"][m.group(1)][\"xyz\".index(axis)] + float(m.group(2) or 0.0)\r"},{"line":693,"text":"\r"},{"line":694,"text":"\r"},{"line":695,"text":"def resolve_region(spec):\r"},{"line":696,"text":"    \"\"\"The polygons of a region: the part's (frame: the gun's body), facing the way asked within its tolerance,\r"},{"line":697,"text":"    their centres inside the window.\"\"\"\r"},{"line":698,"text":"    if not _GP:\r"},{"line":699,"text":"        _GP.extend(_gun_polys())\r"},{"line":700,"text":"    bone = \"Root\" if spec[\"part\"] == \"frame\" else (facts[\"parts\"][spec[\"part\"]][\"bone\"])\r"},{"line":701,"text":"    mine = [(i, c_, n_) for i, (c_, n_, b_) in enumerate(_GP) if b_ == bone]\r"},{"line":702,"text":"    ext = {ax: (min(c_[\"xyz\".index(ax)] for _i, c_, _n in mine), max(c_[\"xyz\".index(ax)] for _i, c_, _n in mine)) for ax in \"xyz\"} if mine else {}\r"},{"line":703,"text":"    fv = _facing_vec(spec[\"facing\"])\r"},{"line":704,"text":"    cos_t = math.cos(math.radians(spec.get(\"facing_tol_deg\", 60.0)))\r"},{"line":705,"text":"    win = {ax: (_bound(v[0], ax, ext.get(ax, (0, 0))), _bound(v[1], ax, ext.get(ax, (0, 0)))) for ax, v in (spec.get(\"window\") or {}).items()}\r"},{"line":706,"text":"    out = []\r"},{"line":707,"text":"    for i, c_, n_ in mine:\r"},{"line":708,"text":"        if fv is not None and n_.dot(fv) < cos_t:\r"},{"line":709,"text":"            continue\r"},{"line":710,"text":"        if any(not (min(lohi) <= c_[\"xyz\".index(ax)] <= max(lohi)) for ax, lohi in win.items()):\r"},{"line":711,"text":"            continue\r"},{"line":712,"text":"        out.append(i)\r"},{"line":713,"text":"    return out\r"},{"line":714,"text":"\r"},{"line":715,"text":"\r"},{"line":716,"text":"RULES = {}\r"},{"line":717,"text":"\r"},{"line":718,"text":"\r"},{"line":719,"text":"def hand_rules(side):\r"},{"line":720,"text":"    \"\"\"A hand's contact rules with their regions on this mesh (polygon indices), its wrap band and closure.\"\"\"\r"},{"line":721,"text":"    if side in RULES:\r"}],"name":"_GP","start_line":681,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#var:_GP"}}
