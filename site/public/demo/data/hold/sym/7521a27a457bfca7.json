98,"text":"    def solve_grip(self, side, mark, along=(-8.0, 8.0), steps=9, poles=None, view_budget=None, clearance_max_cm=0.2,\r"},{"line":3899,"text":"                   ignore=(), frame=\"gun\", rolls=(0.0, -30.0, 30.0, -60.0, 60.0)):\r"},{"line":3900,"text":"        \"\"\"Searches a hand's hold: its palm on a mark (gun frame, cm) moved along the barrel by along (cm, steps), each\r"},{"line":3901,"text":"        with the elbow pointed toward each pole (arms frame, cm; the idle elbow and four around it if left out) and the\r"},{"line":3902,"text":"        hand rolled about the barrel by each of rolls (degrees: the forearm pronates or supinates with it). A hold\r"},{"line":3903,"text":"        counts when the hand holds the rifle with its palm (grip, hold: the palm's press within grip's own limit), nothing\r"},{"line":3904,"text":"        else clips past clearance_max_cm (declared contacts in ignore), every arm and finger rule holds (anatomy), and the\r"},{"line":3905,"text":"        view's lower left and bottom middle stay\r"},{"line":3906,"text":"        within view_budget {lower_left, bottom_middle}. Of the holds that count, the one nearest the mark wins, then the\r"},{"line":3907,"text":"        one that covers least of the view. The rig is left in it (snapshot 'solve_grip_start' holds the pose before).\"\"\"\r"},{"line":3908,"text":"        self._need()\r"},{"line":3909,"text":"        if side not in (\"l\", \"r\"):\r"},{"line":3910,"text":"            raise ValueError(\"side must be l or r\")\r"},{"line":3911,"text":"        self.snapshot(\"save\", \"solve_grip_start\")\r"},{"line":3912,"text":"        hn = self._n(\"hand\", side)\r"},{"line":3913,"text":"        G = self._gun()\r"},{"line":3914,"text":"        H0 = self._bw(hn).copy()\r"},{"line":3915,"text":"        rel = G.inverted() @ H0                                   # the hand's turn against the gun, kept\r"},{"line":3916,"text":"        mid = self._bw(self._n(\"finger\", side, \"middle\", \"01\")).translation\r"},{"line":3917,"text":"        # the palm's middle from the wrist, in the hand's turn (world units: an FBX armature's scale would otherwise\r"},{"line":3918,"text":"        # stretch it a hundredfold)\r"},{"line":3919,"text":"        palm_off = H0.to_quaternion().inverted() @ (H0.translation.lerp(mid, 0.5) - H0.translation)\r"},{"line":3920,"text":"        target = self._point(mark, frame)\r"},{"line":3921,"text":"        axis = (G.to_quaternion() @ Vector((0.0, -1.0, 0.0))).normalized()   # along the barrel (ue +Y is Blender -Y)\r"},{"line":3922,"text":"        if poles is None:\r"},{"line":3923,"text":"            e = self._to(self._bw(self._n(\"lowerarm\", side)).translation, \"arms\")\r"},{"line":3924,"text":"            poles = [None] + [[e.x + dx, e.y + dy, e.z + dz] for dx, dy, dz in ((0, 0, -15), (15, 0, -10), (-15, 0, -10), (0, 15, -15))]\r"},{"line":3925,"text":"        rows, best = [], None\r"},{"line":3926,"text":"        n = max(1, int(steps))\r"},{"line":3927,"text":"        combos = [(i, pole, roll) for i in range(n) for pole in poles for roll in rolls]\r"},{"line":3928,"text":"        for i, pole, roll in combos:\r"},{"line":3929,"text":"            d = along[0] + (along[1] - along[0]) * (i / (n - 1) if n > 1 else 0.5)\r"},{"line":3930,"text":"            if True:\r"},{"line":3931,"text":"                self.snapshot(\"load\", \"solve_grip_start\")\r"},{"line":3932,"text":"                Gn = self._gun()\r"},{"line":3933,"text":"                palm_goal = target + axis * d / 100.0\r"},{"line":3934,"text":"                Hw = Gn @ rel\r"},{"line":3935,"text":"                if roll:\r"},{"line":3936,"text":"                    R = Quaternion(axis, math.radians(roll)).to_matrix().to_4x4()\r"},{"line":3937,"text":"                    Hw = Matrix.Translation(palm_goal) @ R @ Matrix.Translation(-palm_goal) @ Matrix.LocRotScale(palm_goal - (Hw.to_quaternion() @ palm_off), Hw.to_quaternion(), Hw.to_scale())\r"},{"line":3938,"text":"                wrist_goal = palm_goal - (Hw.to_quaternion() @ (palm_off * 1.0))\r"},{"line":3939,"text":"                self._two_bone(side, wrist_goal, pole)\r"},{"line":3940,"text":"                self._set_world(hn, Matrix.LocRotScale(self._bw(hn).translation, Hw.to_quaternion(), self._unit()))\r"},{"line":3941,"text":"                self._roll_forearm(side)\r"},{"line":3942,"text":"                self._mend_hand(side)\r"},{"line":3943,"text":"                # settle the palm on the rifle's surface: pressed in, the hand backs off along the palm's own direction\r"},{"line":3944,"text":"                # (from inside, the grip reads a negative palm gap); a few rounds, the hand's turn kept\r"},{"line":3945,"text":"                for _ in range(3):\r"},{"line":3946,"text":"                    g = self.grip(side, hold=False)[side]\r"},{"line":3947,"text":"                    gap = g.get(\"palm_gap_cm\")\r"},{"line":3948,"text":"                    if gap is None or -0.1 <= gap <= 0.4:\r"},{"line":3949,"text":"                        break\r"},{"line":3950,"text":"                    across, k = self._hand_frame(side)\r"},{"line":3951,"text":"                    hw = self._bw(hn)\r"},{"line":3952,"text":"                    mid_now = self._bw(self._n(\"finger\", side, \"middle\", \"01\")).translation\r"},{"line":3953,"text":"                    palm_dir = (across.cross((mid_now - hw.translation).normalized()) * k).normalized()\r"},{"line":3954,"text":"                    move = palm_dir * ((gap - 0.15) / 100.0)          # toward the rifle if off it, away if pressed in\r"},{"line":3955,"text":"                    self._two_bone(side, hw.translation + move, pole)\r"},{"line":3956,"text":"                    self._set_world(hn, Matrix.LocRotScale(self._bw(hn).translation, hw.to_quaternion(), self._unit()))\r"},{"line":3957,"text":"                    self._roll_forearm(side)\r"},{"line":3958,"text":"                self._clear_fingers(side)\r"},{"line":3959,"text":"                g = self.grip(side, hold=True)[side]\r"},{"line":3960,"text":"                # the palm's own press is grip's to judge (palm_max_cm, its capsule is rounder than a palm): clearance\r"},{"line":3961,"text":"                # covers the forearm, the back of the hand and whatever the caller did not declare a contact\r"},{"line":3962,"text":"                cr = self.clearance(parts=\"left\" if side == \"l\" else \"right\", ignore=list(ignore) + [\"palm*\"], top=2)\r"},{"line":3963,"text":"                c = cr[\"worst_cm\"]\r"},{"line":3964,"text":"                a = self.anatomy(side)[side]\r"},{"line":3965,"text":"                v = self.view_cover()\r"},{"line":3966,"text":"                over = None\r"},{"line":3967,"text":"                if view_budget:\r"},{"line":3968,"text":"                    over = max(v[\"lower_left\"] - view_budget.get(\"lower_left\", 1.0), v[\"bottom_middle\"] - view_budget.get(\"bottom_middle\", 1.0),\r"},{"line":3969,"text":"                               view_budget.get(\"hand_l_shown_min\", 0.0) - (v.get(\"hand_l_shown\") or 0.0), 0.0)\r"},{"line":3970,"text":"                ok = g[\"holding\"] and not g[\"bad\"] and c <= clearance_max_cm and not a[\"bad\"] and (over is None or over <= 0.0)\r"},{"line":3971,"text":"                row = {\"along_cm\": round(d, 1), \"pole\": pole, \"roll_deg\": roll, \"holding\": g[\"holding\"], \"palm_gap_cm\": g[\"palm_gap_cm\"],\r"},{"line":3972,"text":"                       \"clearance_cm\": c, \"clips\": [x[\"segment\"] for x in cr[\"contacts\"]], \"rules_broken\": a[\"bad\"][:3], \"grip_bad\": g[\"bad\"][:3], \"view\": v, \"ok\": ok}\r"},{"line":3973,"text":"                rows.append(row)\r"},{"line":3974,"text":"                if ok and (best is None or (abs(d), abs(roll), v[\"lower_left\"] + v[\"bottom_middle\"]) < (abs(best[\"along_cm\"]), abs(best[\"roll_deg\"]), best[\"view\"][\"lower_left\"] + best[\"view\"][\"bottom_middle\"])):\r"},{"line":3975,"text":"                    best = row\r"},{"line":3976,"text":"                    self.snapshot(\"save\", \"solve_grip_best\")\r"},{"line":3977,"text":"        if best:\r"},{"line":3978,"text":"            self.snapshot(\"load\", \"solve_grip_best\")\r"},{"line":3979,"text":"        else:\r"},{"line":3980,"text":"            self.snapshot(\"load\", \"solve_grip_start\")\r"},{"line":3981,"text":"        return {\"found\": best is not None, \"best\": best, \"tried\": len(rows), \"passed\": sum(r[\"ok\"] for r in rows),\r"},{"line":3982,"text":"                \"rows\": sorted(rows, key=lambda r: (not r[\"ok\"], abs(r[\"along_cm\"]), abs(r[\"roll_deg\"])))[:12]}\r"}],"name":"solve_grip","start_line":3898,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.solve_grip"}}
