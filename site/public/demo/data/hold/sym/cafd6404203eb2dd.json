"got.append({\"centre\": [float(x) for x in o[\"centre\"]], \"area_cm2\": o[\"area_cm2\"], \"through\": [float(x) for x in thin],"},{"kind":"call","line":381,"text":"\"edge\": [[float(x) for x in (c_ + ld * t_.min())], [float(x) for x in (c_ + ld * t_.max())]]})"}],"preds":[6,4],"stmts":["call np.cross","call np.linalg.norm","call max","call float","call np.ptp","call h.max","call top.mean","call np.linalg.svd","call float","call np.linalg.norm","call got.append","call float","call float","call float","call t_.min","call float","call t_.max"],"succs":[3]}],"effects":["unknown"],"entry":0,"exits":[5],"func_id":"hold-code/poselab_mcp/blender/holdlab.py#method:HoldMixin._attach_openings","issues":null},"source":{"end_line":383,"file":"hold-code/poselab_mcp/blender/holdlab.py","kind":"method","language":"python","lines":[{"line":356,"text":"    def _attach_openings(self, run, opens, reach_cm=8.0):\r"},{"line":357,"text":"        \"\"\"The part's openings within reach_cm of a run's inner end, each with its edge on the run's inner side\r"},{"line":358,"text":"        (toward the rest of the object: a pistol's frame over its guard), where an extended index lies.\"\"\"\r"},{"line":359,"text":"        d = np.array(run[\"axis\"])\r"},{"line":360,"text":"        inner, outer = np.array(run[\"inner\"]), np.array(run[\"outer\"])\r"},{"line":361,"text":"        inward = d if float((inner - outer) @ d) >= 0 else -d\r"},{"line":362,"text":"        got = []\r"},{"line":363,"text":"        for o in opens:\r"},{"line":364,"text":"            pts = o[\"cells\"]\r"},{"line":365,"text":"            if float(np.min(np.linalg.norm(pts - inner, axis=1))) > reach_cm / 100.0:\r"},{"line":366,"text":"                continue\r"},{"line":367,"text":"            thin = o[\"through\"]\r"},{"line":368,"text":"            across = np.cross(thin, inward)\r"},{"line":369,"text":"            across /= np.linalg.norm(across)\r"},{"line":370,"text":"            # the opening's edge on the inner side: its cells in the top band of its height up the run (the top\r"},{"line":371,"text":"            # 15 percent, at least 3 mm), a straight line fitted through them (a guard's top, under the frame)\r"},{"line":372,"text":"            h = pts @ inward\r"},{"line":373,"text":"            band = max(0.003, 0.15 * float(np.ptp(h)))\r"},{"line":374,"text":"            top = pts[h >= h.max() - band]\r"},{"line":375,"text":"            c_ = top.mean(0)\r"},{"line":376,"text":"            _u, _s, vt = np.linalg.svd(top - c_, full_matrices=False)\r"},{"line":377,"text":"            ld = vt[0] - thin * float(vt[0] @ thin)\r"},{"line":378,"text":"            ld /= np.linalg.norm(ld)\r"},{"line":379,"text":"            t_ = (top - c_) @ ld\r"},{"line":380,"text":"            got.append({\"centre\": [float(x) for x in o[\"centre\"]], \"area_cm2\": o[\"area_cm2\"], \"through\": [float(x) for x in thin],\r"},{"line":381,"text":"                        \"edge\": [[float(x) for x in (c_ + ld * t_.min())], [float(x) for x in (c_ + ld * t_.max())]]})\r"},{"line":382,"text":"        got.sort(key=lambda g_: float(np.linalg.norm(np.array(g_[\"centre\"]) - inner)))\r"},{"line":383,"text":"        return got\r"}],"name":"_attach_openings","start_line":356,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#method:HoldMixin._attach_openings"}}
