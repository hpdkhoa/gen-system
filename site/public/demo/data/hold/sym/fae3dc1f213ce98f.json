b, oa, ob)"}],"preds":[24],"stmts":["call self._seg_seg"],"succs":[27,28]},{"id":26,"label":"loop_exit","preds":[24],"stmts":null,"succs":[5]},{"id":27,"label":"then","lines":[{"kind":"call","line":1128,"text":"worst.append((name, oname, round(into - skin, 2)))"}],"preds":[25],"stmts":["call worst.append","call round"],"succs":[28]},{"id":28,"label":"merge","preds":[27,25],"stmts":null,"succs":[24]}],"effects":["unknown"],"entry":0,"exits":[7],"func_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.hand_presses","issues":null},"source":{"end_line":1130,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"method","language":"python","lines":[{"line":1098,"text":"    def hand_presses(self, side, tree=None, glove_cm=0.0, allow_cm=0.2, palm_allow_cm=0.4, other=True, soft=None):\r"},{"line":1099,"text":"        \"\"\"How far the hand presses past what is allowed, into the gun and into the other hand, the glove's thickness\r"},{"line":1100,"text":"        counted on every capsule: (penalty, the worst presses [(segment, what, excess cm)]). The palm may press\r"},{"line":1101,"text":"        palm_allow_cm (it holds the gun); soft: {segment prefix: cm} a style allows. The forearm counts against the gun\r"},{"line":1102,"text":"        (a hand over the slide must not lay its forearm on the gun), not against the other hand.\"\"\"\r"},{"line":1103,"text":"        tree = tree or self._tree()\r"},{"line":1104,"text":"        g = glove_cm / 100.0\r"},{"line":1105,"text":"        mine = list(self._segments(side))\r"},{"line":1106,"text":"        theirs = [x for x in self._segments({\"l\": \"r\", \"r\": \"l\"}[side]) if not x[0].startswith(\"forearm\")] if other else []\r"},{"line":1107,"text":"        pen, worst = 0.0, []\r"},{"line":1108,"text":"        for name, a, b, r in mine:\r"},{"line":1109,"text":"            allow = palm_allow_cm if name.startswith(\"palm\") else next((v for k, v in (soft or {}).items() if name.startswith(k)), allow_cm)\r"},{"line":1110,"text":"            n = max(2, int((b - a).length / 0.004))\r"},{"line":1111,"text":"            deep = 0.0\r"},{"line":1112,"text":"            for i in range(n + 1):\r"},{"line":1113,"text":"                q, dq = tree.nearest(a.lerp(b, i / n))\r"},{"line":1114,"text":"                if q is not None and dq < r + g:\r"},{"line":1115,"text":"                    deep = max(deep, (r + g - dq) * 100.0)\r"},{"line":1116,"text":"            if deep > allow:\r"},{"line":1117,"text":"                pen += 2.0 * (deep - allow) + (deep - allow) ** 2        # a small press counts too\r"},{"line":1118,"text":"                worst.append((name, \"gun\", round(deep - allow, 2)))\r"},{"line":1119,"text":"            if name.startswith(\"forearm\"):\r"},{"line":1120,"text":"                continue\r"},{"line":1121,"text":"            # skin on skin gives: a hand may press the other 0.5 cm (the support palm on the firing fingers' tips, 0.8)\r"},{"line":1122,"text":"            skin = max(allow, 0.8 if name.startswith(\"palm\") else 0.5)\r"},{"line":1123,"text":"            for oname, oa, ob, orr in theirs:\r"},{"line":1124,"text":"                d = self._seg_seg(a, b, oa, ob)\r"},{"line":1125,"text":"                into = (r + orr + 2 * g - d) * 100.0\r"},{"line":1126,"text":"                if into > skin:\r"},{"line":1127,"text":"                    pen += 2.0 * (into - skin) + (into - skin) ** 2\r"},{"line":1128,"text":"                    worst.append((name, oname, round(into - skin, 2)))\r"},{"line":1129,"text":"        worst.sort(key=lambda w: -w[2])\r"},{"line":1130,"text":"        return pen, worst[:4]\r"}],"name":"hand_presses","start_line":1098,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.hand_presses"}}
