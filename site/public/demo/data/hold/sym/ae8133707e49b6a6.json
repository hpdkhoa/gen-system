:null,"succs":[14,15]},{"id":13,"label":"loop_exit","preds":[11],"stmts":null,"succs":[8]},{"id":14,"label":"then","lines":[{"kind":"call","line":769,"text":"acc += (v - RW[\"axis\"] * v.dot(RW[\"axis\"])).normalized()"}],"preds":[12],"stmts":["call ?.normalized"],"succs":[15]},{"id":15,"label":"merge","preds":[14,12],"stmts":null,"succs":[11]},{"id":16,"label":"then","lines":[{"kind":"return","line":772,"text":"return None, 0.0"}],"preds":[10],"stmts":["return"],"succs":null},{"id":17,"label":"merge","lines":[{"kind":"call","line":773,"text":"Fq = self._obj_frame(mark[\"part\"]).to_quaternion()"},{"kind":"call","line":774,"text":"return list(Fq.inverted() @ acc.normalized()), round(n_open / float(max(1, n_all)), 3)"}],"preds":[10],"stmts":["call ?.to_quaternion","call list","call Fq.inverted","call acc.normalized","call round","call float","call max","return"],"succs":null}],"effects":["unknown"],"entry":0,"exits":[16,17],"func_id":"hold-code/poselab_mcp/blender/holdlab.py#func:open_dir","issues":null},"source":{"end_line":774,"file":"hold-code/poselab_mcp/blender/holdlab.py","kind":"func","language":"python","lines":[{"line":751,"text":"    def open_dir(self, other, mark, glove_cm=0.0):\r"},{"line":752,"text":"        \"\"\"Which way the run is left open by the other hand (as it holds now): the direction, square to the run's\r"},{"line":753,"text":"        axis and in the part's frame, from the run's middle line to the middle of the girth the other hand does not\r"},{"line":754,"text":"        cover, over the sections it spans; and the open share. A support hand's palm goes there.\"\"\"\r"},{"line":755,"text":"        P = PURPOSES[\"support\"]\r"},{"line":756,"text":"        run = self._object[\"parts\"][mark[\"part\"]][\"runs\"][mark.get(\"run\", 0)]\r"},{"line":757,"text":"        RW = self._run_world(run)\r"},{"line":758,"text":"        g = glove_cm / 100.0\r"},{"line":759,"text":"        theirs = [(n, a, b, r + g) for n, a, b, r in self._segments(other) if not n.startswith(\"forearm\")]\r"},{"line":760,"text":"        span = self._hand_span(other, RW) or RW[\"sections\"]\r"},{"line":761,"text":"        acc, n_open, n_all = Vector(), 0, 0\r"},{"line":762,"text":"        skin = self._hand_skin(other)\r"},{"line":763,"text":"        for cen, ring in span:\r"},{"line":764,"text":"            cov = self._skin_covered(ring, skin, P[\"band_cm\"])\r"},{"line":765,"text":"            for q, c in zip(ring, cov):\r"},{"line":766,"text":"                n_all += 1\r"},{"line":767,"text":"                if not c:\r"},{"line":768,"text":"                    v = q - cen\r"},{"line":769,"text":"                    acc += (v - RW[\"axis\"] * v.dot(RW[\"axis\"])).normalized()\r"},{"line":770,"text":"                    n_open += 1\r"},{"line":771,"text":"        if acc.length < 1e-9:\r"},{"line":772,"text":"            return None, 0.0\r"},{"line":773,"text":"        Fq = self._obj_frame(mark[\"part\"]).to_quaternion()\r"},{"line":774,"text":"        return list(Fq.inverted() @ acc.normalized()), round(n_open / float(max(1, n_all)), 3)\r"}],"name":"open_dir","start_line":751,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#func:open_dir"}}
