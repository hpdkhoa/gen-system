{"flow":{"kind":"var","name":"CONFIG","noCFG":true,"reason":"CONFIG is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":70,"file":"hold-code/poselab_mcp/blender/sample.py","kind":"var","language":"python","lines":[{"line":30,"text":"CONFIG = {\r"},{"line":31,"text":"    \"eye\": list(EYE), \"gun_offset\": [0.0, 0.0, 0.0], \"parts\": {\"carrier\": [\"carrier\"]},\r"},{"line":32,"text":"    \"points\": {\"port\": [-1.5, 9.0, 4.0], \"bore\": [0.0, 0.0, 3.5], \"stock\": [0.0, -25.0, 0.0],\r"},{"line":33,"text":"               \"muzzle\": [0.0, 64.0, 3.5], \"handle\": [-2.6, 4.0, 4.5]},\r"},{"line":34,"text":"    \"normals\": {\"port\": [-1.0, 0.0, 0.0]},\r"},{"line":35,"text":"    \"poles\": {k: list(v) for k, v in POLE.items()},\r"},{"line":36,"text":"}\r"},{"line":37,"text":"\r"},{"line":38,"text":"\r"},{"line":39,"text":"def ue(v):\r"},{"line":40,"text":"    return Vector((v[0], -v[1], v[2])) / 100.0\r"},{"line":41,"text":"\r"},{"line":42,"text":"\r"},{"line":43,"text":"def material(name):\r"},{"line":44,"text":"    m = bpy.data.materials.get(\"poselab_\" + name)\r"},{"line":45,"text":"    if not m:\r"},{"line":46,"text":"        m = bpy.data.materials.new(\"poselab_\" + name)\r"},{"line":47,"text":"        m.diffuse_color = COLOURS[name] + (1.0,)\r"},{"line":48,"text":"        m.roughness = 0.35 if name in (\"steel\", \"handle\") else 0.6\r"},{"line":49,"text":"        m.metallic = 0.6 if name in (\"steel\", \"handle\") else 0.0\r"},{"line":50,"text":"    return m\r"},{"line":51,"text":"\r"},{"line":52,"text":"\r"},{"line":53,"text":"def new_object(name, bm, mat, smooth=True):\r"},{"line":54,"text":"    me = bpy.data.meshes.new(name)\r"},{"line":55,"text":"    bm.to_mesh(me)\r"},{"line":56,"text":"    bm.free()\r"},{"line":57,"text":"    me.materials.append(material(mat))\r"},{"line":58,"text":"    for p in me.polygons:\r"},{"line":59,"text":"        p.use_smooth = smooth\r"},{"line":60,"text":"    ob = bpy.data.objects.new(name, me)\r"},{"line":61,"text":"    bpy.context.scene.collection.objects.link(ob)\r"},{"line":62,"text":"    return ob\r"},{"line":63,"text":"\r"},{"line":64,"text":"\r"},{"line":65,"text":"# --- the rifle ----------------------------------------------------------------------------------------------------\r"},{"line":66,"text":"def rifle_box(lo, hi, bevel=0.0025, turn_deg=0.0):\r"},{"line":67,"text":"    \"\"\"A bevelled box from lo to hi (gun space, cm), turned about the gun's left-right axis through its middle.\"\"\"\r"},{"line":68,"text":"    lo, hi = ue(lo), ue(hi)\r"},{"line":69,"text":"    size = Vector((abs(hi.x - lo.x), abs(hi.y - lo.y), abs(hi.z - lo.z)))\r"},{"line":70,"text":"    bm = bmesh.new()\r"}],"name":"CONFIG","start_line":30,"symbol_id":"hold-code/poselab_mcp/blender/sample.py#var:CONFIG"}}
