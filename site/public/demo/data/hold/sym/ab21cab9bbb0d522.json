for p in me.polygons:\r"},{"line":405,"text":"            gs = [vg[i] or \"body\" for i in p.vertices]\r"},{"line":406,"text":"            own = max(set(gs), key=gs.count)\r"},{"line":407,"text":"            if (part is None and own not in skip) or not any(vg) or own == part:\r"},{"line":408,"text":"                ps.append(tuple(p.vertices))\r"},{"line":409,"text":"        ev.to_mesh_clear()\r"},{"line":410,"text":"        bvh = BVHTree.FromPolygons(V, ps) if ps else None\r"},{"line":411,"text":"        c[ck] = bvh\r"},{"line":412,"text":"        self._pbvh = c\r"},{"line":413,"text":"        return bvh\r"}],"name":"_part_bvh_local","start_line":385,"symbol_id":"hold-code/poselab_mcp/blender/holdlab.py#func:_part_bvh_local"}}
