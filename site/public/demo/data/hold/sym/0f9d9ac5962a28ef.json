text":"            q2 = have.rotation_difference(want)\r"},{"line":252,"text":"            R = Matrix.Translation(P) @ q2.to_matrix().to_4x4() @ Matrix.Translation(-P) @ R\r"},{"line":253,"text":"    goal = at + normal * (thickness_cm / 100.0)\r"},{"line":254,"text":"    R = Matrix.Translation(goal - P) @ R\r"},{"line":255,"text":"    short = L._put_hand(side, Matrix.LocRotScale(R.translation, R.to_quaternion(), L._unit()))\r"},{"line":256,"text":"    L._mend_hand(side)\r"},{"line":257,"text":"    return short\r"}],"name":"lay_palm","start_line":236,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:lay_palm"}}
