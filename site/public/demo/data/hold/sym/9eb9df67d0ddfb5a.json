4],"stmts":["call self._set_world"],"succs":[1]}],"effects":["unknown"],"entry":0,"exits":[3],"func_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._spread_roll","issues":null},"source":{"end_line":2790,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"method","language":"python","lines":[{"line":2774,"text":"    def _spread_roll(self, s):\r"},{"line":2775,"text":"        \"\"\"The forearm's roll spread along it: the elbow's end its share, each twist bone the share up to its place, the\r"},{"line":2776,"text":"        hand left where it is. Nothing the eye sees of the hand or the elbow moves; the skin between turns evenly.\"\"\"\r"},{"line":2777,"text":"        L, _fl = self._limits()\r"},{"line":2778,"text":"        share0 = L[\"forearm_elbow_share\"]\r"},{"line":2779,"text":"        lo, hn = self._n(\"lowerarm\", s), self._n(\"hand\", s)\r"},{"line":2780,"text":"        H = self._bw(hn).copy()\r"},{"line":2781,"text":"        for _ in range(3):        # the links are measured about lines that move a little as they turn\r"},{"line":2782,"text":"            links, total = self._forearm_links(s)\r"},{"line":2783,"text":"            E, W = self._bw(lo).translation, self._bw(hn).translation\r"},{"line":2784,"text":"            a = (W - E).normalized()\r"},{"line":2785,"text":"            self._turn_about(lo, a, links[0][2] - links[0][1], E)\r"},{"line":2786,"text":"            self._set_world(hn, H)\r"},{"line":2787,"text":"            for p, n in self._twist_bones(s):\r"},{"line":2788,"text":"                now = self._twist_about(self._rest_turn(n) @ self._rest_turn(lo).inverted(), a)\r"},{"line":2789,"text":"                self._turn_about(n, a, (1.0 - share0) * p * total - now, self._bw(n).translation)\r"},{"line":2790,"text":"            self._set_world(hn, H)\r"}],"name":"_spread_roll","start_line":2774,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._spread_roll"}}
