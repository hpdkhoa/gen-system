{"flow":{"kind":"var","name":"_TL","noCFG":true,"reason":"_TL is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":316,"file":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py","kind":"var","language":"python","lines":[{"line":276,"text":"_TL = L._thumb_limits()\r"},{"line":277,"text":"DIGITS = (\"index\", \"middle\", \"ring\", \"pinky\")\r"},{"line":278,"text":"\r"},{"line":279,"text":"\r"},{"line":280,"text":"def _curl(side, fi, j):\r"},{"line":281,"text":"    return L._finger_report(side, _FL)[0][\"%s_%s\" % (fi, j)][0]\r"},{"line":282,"text":"\r"},{"line":283,"text":"\r"},{"line":284,"text":"def set_joint(side, fi, j, target):\r"},{"line":285,"text":"    \"\"\"One finger joint turned about the finger's own hinge to a curl (degrees), the way that gets closer.\"\"\"\r"},{"line":286,"text":"    cur = _curl(side, fi, j)\r"},{"line":287,"text":"    if abs(cur - target) < 0.5:\r"},{"line":288,"text":"        return\r"},{"line":289,"text":"    n = L._n(\"finger\", side, fi, j)\r"},{"line":290,"text":"    head = L._bw(n).translation.copy()\r"},{"line":291,"text":"    M = L._bw(n)\r"},{"line":292,"text":"    planes = L._finger_report(side, _FL)[2]\r"},{"line":293,"text":"    for sg in (1.0, -1.0):\r"},{"line":294,"text":"        L._turn_about(n, planes[fi], (target - cur) * sg, head)\r"},{"line":295,"text":"        if abs(_curl(side, fi, j) - target) < abs(cur - target):\r"},{"line":296,"text":"            return\r"},{"line":297,"text":"        L._set_world(n, M)\r"},{"line":298,"text":"\r"},{"line":299,"text":"\r"},{"line":300,"text":"def set_finger(side, fi, curls):\r"},{"line":301,"text":"    for j, c in zip((\"01\", \"02\", \"03\"), curls):\r"},{"line":302,"text":"        set_joint(side, fi, j, c)\r"},{"line":303,"text":"\r"},{"line":304,"text":"\r"},{"line":305,"text":"def finger_gap(side, fi, tree):\r"},{"line":306,"text":"    \"\"\"The finger's skin to the gun's surface, the closest of its three segments (cm; under 0 when inside).\"\"\"\r"},{"line":307,"text":"    best = None\r"},{"line":308,"text":"    for name, a, b, r in L._segments(side):\r"},{"line":309,"text":"        if not name.startswith(fi):\r"},{"line":310,"text":"            continue\r"},{"line":311,"text":"        n = max(2, int((b - a).length / 0.003))\r"},{"line":312,"text":"        for i in range(n + 1):\r"},{"line":313,"text":"            q, dq = tree.nearest(a.lerp(b, i / n))\r"},{"line":314,"text":"            if q is None:\r"},{"line":315,"text":"                continue\r"},{"line":316,"text":"            gap = (dq - r) * 100.0\r"}],"name":"_TL","start_line":276,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#var:_TL"}}
