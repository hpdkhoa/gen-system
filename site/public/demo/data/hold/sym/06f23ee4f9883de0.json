, sd)) for sd in (\"l\", \"r\") for fi in fingers if \"%s_01_%s\" % (fi, sd) in a.data.bones}\r"},{"line":232,"text":"            bpy.ops.object.mode_set(mode=\"EDIT\")\r"},{"line":233,"text":"            Mi = a.matrix_world.inverted()\r"},{"line":234,"text":"            for (fi, sd), h01 in heads.items():\r"},{"line":235,"text":"                h01l = Mi @ h01\r"},{"line":236,"text":"                for j in (\"01\", \"02\", \"03\"):\r"},{"line":237,"text":"                    eb = a.data.edit_bones.get(\"%s_%s_%s\" % (fi, j, sd))\r"},{"line":238,"text":"                    if eb is None:\r"},{"line":239,"text":"                        continue\r"},{"line":240,"text":"                    roll = eb.roll\r"},{"line":241,"text":"                    eb.head = h01l + (eb.head - h01l) * fk\r"},{"line":242,"text":"                    eb.tail = h01l + (eb.tail - h01l) * fk\r"},{"line":243,"text":"                    eb.roll = roll\r"},{"line":244,"text":"            bpy.ops.object.mode_set(mode=\"OBJECT\")\r"},{"line":245,"text":"        if abs(pk - 1.0) > 1e-6:\r"},{"line":246,"text":"            fr = {}\r"},{"line":247,"text":"            for sd in (\"l\", \"r\"):\r"},{"line":248,"text":"                if \"hand_\" + sd in a.data.bones:\r"},{"line":249,"text":"                    H0, K0 = Bb(\"hand_\" + sd), Bb(\"middle_01_\" + sd)\r"},{"line":250,"text":"                    fr[sd] = (H0, (K0 - H0).normalized(), (K0 - H0).length)\r"},{"line":251,"text":"            bpy.ops.object.mode_set(mode=\"EDIT\")\r"},{"line":252,"text":"            Mi, Mw = a.matrix_world.inverted(), a.matrix_world\r"},{"line":253,"text":"            for eb in a.data.edit_bones:\r"},{"line":254,"text":"                bits = eb.name.split(\"_\")\r"},{"line":255,"text":"                if bits[-1] not in fr or bits[0] not in parts_:\r"},{"line":256,"text":"                    continue\r"},{"line":257,"text":"                H0, ax, ln = fr[bits[-1]]\r"},{"line":258,"text":"                st = lambda q_: ax * (min(max((q_ - H0).dot(ax), 0.0), ln) * (pk - 1.0))     # noqa: E731\r"},{"line":259,"text":"                roll = eb.roll\r"},{"line":260,"text":"                h, t = Mw @ eb.head, Mw @ eb.tail\r"},{"line":261,"text":"                if bits[0] == \"thumb\":\r"},{"line":262,"text":"                    # the thumb rides as one piece, by the stretch at its base joint: the palm must not lengthen it\r"},{"line":263,"text":"                    sh = st(Bb(\"thumb_01_\" + bits[-1]))\r"},{"line":264,"text":"                    eb.head, eb.tail = Mi @ (h + sh), Mi @ (t + sh)\r"},{"line":265,"text":"                else:\r"},{"line":266,"text":"                    eb.head = Mi @ (h + st(h))\r"},{"line":267,"text":"                    eb.tail = Mi @ (t + st(t))\r"},{"line":268,"text":"                eb.roll = roll\r"},{"line":269,"text":"            bpy.ops.object.mode_set(mode=\"OBJECT\")\r"},{"line":270,"text":"        bpy.context.view_layer.objects.active = prev\r"},{"line":271,"text":"        bpy.context.view_layer.update()\r"}],"name":"_edit_skeleton","start_line":219,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._edit_skeleton"}}
