"        gap = finger_gap(side, fi, tree)\r"},{"line":330,"text":"        if gap <= GLOVE + 0.05:\r"},{"line":331,"text":"            if gap < GLOVE - 0.1:\r"},{"line":332,"text":"                set_finger(side, fi, prev)\r"},{"line":333,"text":"            return\r"},{"line":334,"text":"        prev = c\r"}],"name":"wrap","start_line":321,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_hands.py#func:wrap"}}
