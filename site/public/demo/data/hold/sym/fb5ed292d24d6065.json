{"flow":{"kind":"var","name":"SCRIPTS","noCFG":true,"reason":"SCRIPTS is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":57,"file":"hold-code/weaponlab/gunkit/run.py","kind":"var","language":"python","lines":[{"line":17,"text":"SCRIPTS = Path(__file__).resolve().parent / \"blender\"\r"},{"line":18,"text":"PKG = Path(__file__).resolve().parents[2]          # the folder that holds the weaponlab package (src)\r"},{"line":19,"text":"\r"},{"line":20,"text":"\r"},{"line":21,"text":"def folder(name):\r"},{"line":22,"text":"    d = Path(project().work) / \"gunkit\" / name\r"},{"line":23,"text":"    d.mkdir(parents=True, exist_ok=True)\r"},{"line":24,"text":"    return d\r"},{"line":25,"text":"\r"},{"line":26,"text":"\r"},{"line":27,"text":"def _blender(script, job, out, timeout=1800, tag=\"GUNKIT\"):\r"},{"line":28,"text":"    P.guard()\r"},{"line":29,"text":"    jf = Path(out) / (\"%s.job.json\" % Path(script).stem)\r"},{"line":30,"text":"    jf.write_text(json.dumps(job, indent=1), encoding=\"utf-8\")\r"},{"line":31,"text":"    p = subprocess.run([str(project().blender()), \"-b\", \"--factory-startup\", \"-P\", str(SCRIPTS / script), \"--\", str(jf)],\r"},{"line":32,"text":"                       capture_output=True, text=True, timeout=timeout)\r"},{"line":33,"text":"    (Path(out) / (\"%s.log\" % Path(script).stem)).write_text((p.stdout or \"\") + \"\\n\" + (p.stderr or \"\"), encoding=\"utf-8\", errors=\"replace\")\r"},{"line":34,"text":"    lines = [l for l in (p.stdout or \"\").splitlines() if l.startswith(tag)]\r"},{"line":35,"text":"    if p.returncode != 0 or not lines:\r"},{"line":36,"text":"        tail = [l for l in ((p.stdout or \"\") + (p.stderr or \"\")).splitlines() if l.strip()][-15:]\r"},{"line":37,"text":"        raise RuntimeError(\"%s failed (see %s):\\n%s\" % (script, Path(out) / (\"%s.log\" % Path(script).stem), \"\\n\".join(tail)))\r"},{"line":38,"text":"    return lines\r"},{"line":39,"text":