],"stmts":null,"succs":[14]},{"cond":"o.type == 'ARMATURE' and o.animation_data and o.animation_data.action and (name not in self.clips)","id":14,"label":"merge","preds":[13,12],"stmts":null,"succs":[15,17]},{"id":15,"label":"then","lines":[{"kind":"call","line":331,"text":"T = fit([crest[b].translation for b in shared], [rest[b].translation for b in shared])"},{"kind":"call","line":332,"text":"C = {b: crest[b].inverted() @ T.inverted() @ rest[b] for b in shared}"},{"kind":"call","line":333,"text":"worst = max(((T @ crest[b]).translation - rest[b].translation).length for b in shared) * 100.0"},{"kind":"call","line":336,"text":"self.clip_fit[name] = {\"source\": \"fbx\", \"rest_mismatch_cm\": round(worst, 3)}"}],"preds":[14],"stmts":["call fit","call ?.inverted","call T.inverted","call max","call round"],"succs":[16]},{"id":16,"label":"merge","preds":[15,17],"stmts":null,"succs":[6]},{"id":17,"label":"else","lines":[{"kind":"call","line":338,"text":"bpy.data.objects.remove(o)"}],"preds":[14],"stmts":["call bpy.data.objects.remove"],"succs":[16]}],"effects":["fs"],"entry":0,"exits":[3],"func_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._load_clips","issues":null},"source":{"end_line":338,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"method","language":"python","lines":[{"line":310,"text":"    def _load_clips(self, R):\r"},{"line":311,"text":"        # bone data (<clip>.pose.json, the same idle armature) is taken as it is; an FBX clip sits on its own hidden\r"},{"line":312,"text":"        # armature and is carried over in world terms: ours = T @ clip @ C[bone], from the two rest poses\r"},{"line":313,"text":"        self.clips, self.clip_fit = {}, {}\r"},{"line":314,"text":"        rest = {b.name: self.arm.matrix_world @ b.matrix_local for b in self.arm.data.bones}\r"},{"line":315,"text":"        for name, f in R.get(\"clips\", {}).items():\r"},{"line":316,"text":"            path = os.path.join(self.folder, f)\r"},{"line":317,"text":"            if f.endswith(\".pose.json\"):\r"},{"line":318,"text":"                with open(path, encoding=\"utf-8-sig\") as fh:\r"},{"line":319,"text":"                    data = json.load(fh)\r"},{"line":320,"text":"                self.clips[name] = (\"json\", data[\"frames\"], float(data[\"fps\"]), None, None)\r"},{"line":321,"text":"                self.clip_fit[name] = {\"source\": \"bone data\"}\r"},{"line":322,"text":"                continue\r"},{"line":323,"text":"            before = set(bpy.data.objects.keys())\r"},{"line":324,"text":"            bpy.ops.import_scene.fbx(filepath=path)\r"},{"line":325,"text":"            fps = self.sc.render.fps / self.sc.render.fps_base\r"},{"line":326,"text":"            for o in [o for o in bpy.data.objects if o.name not in before]:\r"},{"line":327,"text":"                if o.type == 'ARMATURE' and o.animation_data and o.animation_data.action and name not in self.clips:\r"},{"line":328,"text":"                    o.hide_render = True     # still evaluated (a viewport-hidden armature does not animate)\r"},{"line":329,"text":"                    crest = {b.name: o.matrix_world @ b.matrix_local for b in o.data.bones}\r"},{"line":330,"text":"                    shared = [b.name for b in self.arm.data.bones if b.name in crest]\r"},{"line":331,"text":"                    T = fit([crest[b].translation for b in shared], [rest[b].translation for b in shared])\r"},{"line":332,"text":"                    C = {b: crest[b].inverted() @ T.inverted() @ rest[b] for b in shared}\r"},{"line":333,"text":"                    worst = max(((T @ crest[b]).translation - rest[b].translation).length for b in shared) * 100.0\r"},{"line":334,"text":"                    self.clips[name] = (o, o.animation_data.action, fps, T, C)\r"},{"line":335,"text":"                    # a large mismatch means the clip's skeleton is not this one (or Blender misread an FBX it wrote)\r"},{"line":336,"text":"                    self.clip_fit[name] = {\"source\": \"fbx\", \"rest_mismatch_cm\": round(worst, 3)}\r"},{"line":337,"text":"                else:\r"},{"line":338,"text":"                    bpy.data.objects.remove(o)\r"}],"name":"_load_clips","start_line":310,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab._load_clips"}}
