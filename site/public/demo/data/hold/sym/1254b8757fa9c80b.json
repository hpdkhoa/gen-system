{"flow":{"kind":"var","name":"NAME","noCFG":true,"reason":"NAME is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":59,"file":"hold-code/weaponlab/blueprint/store.py","kind":"var","language":"python","lines":[{"line":19,"text":"NAME = re.compile(r\"^[A-Za-z0-9_]+$\")\r"},{"line":20,"text":"\r"},{"line":21,"text":"\r"},{"line":22,"text":"def root():\r"},{"line":23,"text":"    r = os.environ.get(\"WEAPONLAB_DIGITIZE\")\r"},{"line":24,"text":"    return Path(r) if r else Path(project().work) / \"digitize\"\r"},{"line":25,"text":"\r"},{"line":26,"text":"\r"},{"line":27,"text":"def folder(gun, *sub):\r"},{"line":28,"text":"    if not NAME.match(gun or \"\"):\r"},{"line":29,"text":"        raise ValueError(\"a gun's name is letters, digits and _ (it names files): %r\" % gun)\r"},{"line":30,"text":"    d = root().joinpath(gun, *sub)\r"},{"line":31,"text":"    d.mkdir(parents=True, exist_ok=True)\r"},{"line":32,"text":"    return d\r"},{"line":33,"text":"\r"},{"line":34,"text":"\r"},{"line":35,"text":"def _path(gun, kind):\r"},{"line":36,"text":"    return folder(gun) / (\"%s.json\" % kind)\r"},{"line":37,"text":"\r"},{"line":38,"text":"\r"},{"line":39,"text":"def exists(gun, kind):\r"},{"line":40,"text":"    return (root() / gun / (\"%s.json\" % kind)).exists()\r"},{"line":41,"text":"\r"},{"line":42,"text":"\r"},{"line":43,"text":"def load(gun, kind):\r"},{"line":44,"text":"    p = _path(gun, kind)\r"},{"line":45,"text":"    if not p.exists():\r"},{"line":46,"text":"        raise FileNotFoundError(\"%s has no %s yet (%s)\" % (gun, kind, p))\r"},{"line":47,"text":"    return json.loads(p.read_text(encoding=\"utf-8\"))\r"},{"line":48,"text":"\r"},{"line":49,"text":"\r"},{"line":50,"text":"def save(gun, kind, doc, strict=True):\r"},{"line":51,"text":"    \"\"\"Writes a document after its contract check. strict: refuse it when the check finds problems (a blueprint is\r"},{"line":52,"text":"    saved while it is being written, so its part checks run in check.py).\"\"\"\r"},{"line":53,"text":"    bad = C.check_sources(doc) if kind == \"sources\" else C._schema_problems(doc, kind)\r"},{"line":54,"text":"    if bad and strict:\r"},{"line":55,"text":"        raise ValueError(\"the %s for %s does not follow its contract:\\n  %s\" % (kind, gun, \"\\n  \".join(bad[:20])))\r"},{"line":56,"text":"    _path(gun, kind).write_text(json.dumps(doc, indent=1, ensure_ascii=False), encoding=\"utf-8\")\r"},{"line":57,"text":"    return bad\r"},{"line":58,"text":"\r"},{"line":59,"text":"\r"}],"name":"NAME","start_line":19,"symbol_id":"hold-code/weaponlab/blueprint/store.py#var:NAME"}}
