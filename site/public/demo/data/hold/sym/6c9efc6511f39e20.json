call self._n","call ?.copy"],"succs":[39]},{"id":39,"label":"merge","lines":[{"kind":"call","line":216,"text":"if self._n(p, s) in self.arm.pose.bones}"}],"preds":[38,36],"stmts":["call self._n"],"succs":[35]}],"effects":["unknown"],"entry":0,"exits":[1,34],"func_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.load_rig","issues":null},"source":{"end_line":217,"file":"hold-code/poselab_mcp/blender/lab.py","kind":"method","language":"python","lines":[{"line":169,"text":"    def load_rig(self, rig):\r"},{"line":170,"text":"        \"\"\"Loads a rig: the arms on their idle pose, the rifle on the gun bone, the rig's clips.\"\"\"\r"},{"line":171,"text":"        rigs = self._rigs()\r"},{"line":172,"text":"        if rig not in rigs:\r"},{"line":173,"text":"            raise ValueError(\"no rig %r; rigs: %s\" % (rig, list(rigs)))\r"},{"line":174,"text":"        R = dict(rigs[rig])\r"},{"line":175,"text":"        bpy.ops.wm.read_factory_settings(use_empty=True)\r"},{"line":176,"text":"        self.sc = bpy.context.scene\r"},{"line":177,"text":"        self.names = dict(DEFAULT_BONES, **R.get(\"bones\", {}))\r"},{"line":178,"text":"        self.orphans = {}\r"},{"line":179,"text":"        if R.get(\"builtin\"):\r"},{"line":180,"text":"            from sample import build\r"},{"line":181,"text":"            made = build()\r"},{"line":182,"text":"            self.arm, self.meshes, self.rifle_arm, self.rifle_mesh = made[\"arm\"], made[\"meshes\"], made[\"rifle_arm\"], made[\"rifle_mesh\"]\r"},{"line":183,"text":"            R.update(made[\"config\"])\r"},{"line":184,"text":"        else:\r"},{"line":185,"text":"            self._load_files(R)\r"},{"line":186,"text":"        # the rifle at its rest: a rifle's FBX may carry its own animation (a trigger, a magazine), which then followed\r"},{"line":187,"text":"        # whatever scene frame a clip's sampling left; a finger on the trigger read 1.4 cm inside it (ToangTown's\r"},{"line":188,"text":"        # AKS-74U, 2026-10-10). The rig's parts move only by move_part\r"},{"line":189,"text":"        if self.rifle_arm.animation_data:\r"},{"line":190,"text":"            self.rifle_arm.animation_data.action = None\r"},{"line":191,"text":"        for pb in self.rifle_arm.pose.bones:     # the action's last pose stays on the bones without this\r"},{"line":192,"text":"            pb.matrix_basis = Matrix.Identity(4)\r"},{"line":193,"text":"        for pb in self.arm.pose.bones:\r"},{"line":194,"text":"            pb.rotation_mode = 'QUATERNION'\r"},{"line":195,"text":"        self.idle = {pb.name: (pb.location.copy(), pb.rotation_quaternion.copy(), pb.scale.copy()) for pb in self.arm.pose.bones}\r"},{"line":196,"text":"        if self.arm.animation_data:\r"},{"line":197,"text":"            self.arm.animation_data.action = None\r"},{"line":198,"text":"        self.R, self.rig = R, rig\r"},{"line":199,"text":"        self.G0 = (self.arm.matrix_world @ self.arm.pose.bones[self.names[\"gun\"]].matrix).copy()\r"},{"line":200,"text":"        self.rifle_rest = Matrix.Translation(self.G0.translation + ue(R.get(\"gun_offset\", (0, 0, 0)))) @ self.rifle_arm.matrix_world\r"},{"line":201,"text":"        lower = {b.name.lower(): b.name for b in self.rifle_arm.pose.bones}\r"},{"line":202,"text":"        self.part_bones = {p: [lower[b.lower()] for b in bones if b.lower() in lower] for p, bones in R.get(\"parts\", {}).items()}\r"},{"line":203,"text":"        self.travel = {}\r"},{"line":204,"text":"        self.poles = dict(DEFAULT_POLES, **R.get(\"poles\", {}))\r"},{"line":205,"text":"        self.eye = ue(R.get(\"eye\", (0.0, 0.0, 160.0)))\r"},{"line":206,"text":"        if not R.get(\"builtin\"):\r"},{"line":207,"text":"            self._load_clips(R)\r"},{"line":208,"text":"        else:\r"},{"line":209,"text":"            self.clips, self.clip_fit = {}, {}\r"},{"line":210,"text":"        self.sc.render.fps, self.sc.render.fps_base = 30, 1.0\r"},{"line":211,"text":"        self.snapshots = {}\r"},{"line":212,"text":"        self.pose_idle()\r"},{"line":213,"text":"        # the idle grip's forearm and hand: the twist between their bones there is the rig's own (a bind offset, not a\r"},{"line":214,"text":"        # roll); anatomy measures the twist against it\r"},{"line":215,"text":"        self.idle_world = {self._n(p, s): self._bw(self._n(p, s)).copy() for p in (\"lowerarm\", \"hand\") for s in (\"l\", \"r\")\r"},{"line":216,"text":"                           if self._n(p, s) in self.arm.pose.bones}\r"},{"line":217,"text":"        return self.describe()\r"}],"name":"load_rig","start_line":169,"symbol_id":"hold-code/poselab_mcp/blender/lab.py#method:Lab.load_rig"}}
