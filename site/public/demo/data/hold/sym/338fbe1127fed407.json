{"flow":{"kind":"var","name":"COLOURS","noCFG":true,"reason":"COLOURS is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":85,"file":"hold-code/weaponlab/gunkit/blender/gunkit_rig.py","kind":"var","language":"python","lines":[{"line":45,"text":"COLOURS = {None: (0.18, 0.18, 0.2, 1.0)}\r"},{"line":46,"text":"\r"},{"line":47,"text":"\r"},{"line":48,"text":"def material(role):\r"},{"line":49,"text":"    if role not in COLOURS:\r"},{"line":50,"text":"        h = (abs(hash(role)) % 360) / 360.0\r"},{"line":51,"text":"        import colorsys\r"},{"line":52,"text":"        r, gg, b = colorsys.hsv_to_rgb(h, 0.55, 0.8)\r"},{"line":53,"text":"        COLOURS[role] = (r, gg, b, 1.0)\r"},{"line":54,"text":"    name = \"M_\" + (R.bone_name(role) if role else \"Body\")\r"},{"line":55,"text":"    m = bpy.data.materials.get(name) or bpy.data.materials.new(name)\r"},{"line":56,"text":"    m.diffuse_color = COLOURS[role]\r"},{"line":57,"text":"    return m\r"},{"line":58,"text":"\r"},{"line":59,"text":"\r"},{"line":60,"text":"objects = {}\r"},{"line":61,"text":"if job.get(\"shapes\"):\r"},{"line":62,"text":"    for s in job[\"shapes\"]:\r"},{"line":63,"text":"        if s[\"shape\"] == \"box\":\r"},{"line":64,"text":"            bpy.ops.mesh.primitive_cube_add(size=1.0)\r"},{"line":65,"text":"            ob = bpy.context.object\r"},{"line":66,"text":"            ob.scale = (s[\"size\"][0] / 100.0, s[\"size\"][1] / 100.0, s[\"size\"][2] / 100.0)\r"},{"line":67,"text":"        else:\r"},{"line":68,"text":"            bpy.ops.mesh.primitive_cylinder_add(vertices=16, radius=0.5, depth=1.0)\r"},{"line":69,"text":"            ob = bpy.context.object\r"},{"line":70,"text":"            d, length = s[\"size\"]\r"},{"line":71,"text":"            along = s.get(\"along\", \"y\")\r"},{"line":72,"text":"            if along == \"y\":\r"},{"line":73,"text":"                ob.rotation_euler = (math.radians(90), 0, 0)\r"},{"line":74,"text":"                ob.scale = (d / 100.0, d / 100.0, length / 100.0)\r"},{"line":75,"text":"            elif along == \"x\":\r"},{"line":76,"text":"                ob.rotation_euler = (0, math.radians(90), 0)\r"},{"line":77,"text":"                ob.scale = (d / 100.0, d / 100.0, length / 100.0)\r"},{"line":78,"text":"            else:\r"},{"line":79,"text":"                ob.scale = (d / 100.0, d / 100.0, length / 100.0)\r"},{"line":80,"text":"        ob.location = g(*s[\"at\"])\r"},{"line":81,"text":"        ob.name = s[\"name\"]\r"},{"line":82,"text":"        ob.data.materials.append(material(s.get(\"part\")))\r"},{"line":83,"text":"        bpy.context.view_layer.update()\r"},{"line":84,"text":"        ob.data.transform(ob.matrix_world)\r"},{"line":85,"text":"        ob.matrix_world = Matrix.Identity(4)\r"}],"name":"COLOURS","start_line":45,"symbol_id":"hold-code/weaponlab/gunkit/blender/gunkit_rig.py#var:COLOURS"}}
