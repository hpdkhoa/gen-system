{"flow":{"kind":"var","name":"FPS","noCFG":true,"reason":"FPS is a var: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":54,"file":"hold-code/weaponlab/gunkit/timeline.py","kind":"var","language":"python","lines":[{"line":14,"text":"FPS = 60\r"},{"line":15,"text":"\r"},{"line":16,"text":"\r"},{"line":17,"text":"def ease(x, kind=\"inout\"):\r"},{"line":18,"text":"    x = min(max(x, 0.0), 1.0)\r"},{"line":19,"text":"    if kind == \"linear\":\r"},{"line":20,"text":"        return x\r"},{"line":21,"text":"    if kind == \"in\":\r"},{"line":22,"text":"        return x * x\r"},{"line":23,"text":"    if kind == \"out\":\r"},{"line":24,"text":"        return 1.0 - (1.0 - x) * (1.0 - x)\r"},{"line":25,"text":"    if kind == \"snap\":\r"},{"line":26,"text":"        return 1.0 if x >= 1.0 else 0.0\r"},{"line":27,"text":"    if kind == \"spring\":                      # a spring's return: past the stop a little, then settled\r"},{"line":28,"text":"        return 1.0 - math.cos(x * math.pi * 2.5) * math.exp(-5.0 * x) if x < 1.0 else 1.0\r"},{"line":29,"text":"    return x * x * (3.0 - 2.0 * x)            # inout: smoothstep\r"},{"line":30,"text":"\r"},{"line":31,"text":"\r"},{"line":32,"text":"def _add(a, b):\r"},{"line":33,"text":"    return [a[0] + b[0], a[1] + b[1], a[2] + b[2]]\r"},{"line":34,"text":"\r"},{"line":35,"text":"\r"},{"line":36,"text":"def _scale(a, s):\r"},{"line":37,"text":"    return [a[0] * s, a[1] * s, a[2] * s]\r"},{"line":38,"text":"\r"},{"line":39,"text":"\r"},{"line":40,"text":"def _rot(p, pivot, axis, deg):\r"},{"line":41,"text":"    \"\"\"p turned by deg round axis (a unit vector) through pivot (Rodrigues).\"\"\"\r"},{"line":42,"text":"    v = [p[i] - pivot[i] for i in range(3)]\r"},{"line":43,"text":"    k = axis\r"},{"line":44,"text":"    c, s = math.cos(math.radians(deg)), math.sin(math.radians(deg))\r"},{"line":45,"text":"    kv = k[0] * v[0] + k[1] * v[1] + k[2] * v[2]\r"},{"line":46,"text":"    kxv = [k[1] * v[2] - k[2] * v[1], k[2] * v[0] - k[0] * v[2], k[0] * v[1] - k[1] * v[0]]\r"},{"line":47,"text":"    r = [v[i] * c + kxv[i] * s + k[i] * kv * (1 - c) for i in range(3)]\r"},{"line":48,"text":"    return _add(r, pivot)\r"},{"line":49,"text":"\r"},{"line":50,"text":"\r"},{"line":51,"text":"def _value_track(beats, t, start=0.0):\r"},{"line":52,"text":"    \"\"\"A part's value at t from its beats (each from the value before it to its own).\"\"\"\r"},{"line":53,"text":"    v = start\r"},{"line":54,"text":"    for b in sorted(beats, key=lambda b: b[\"from\"]):\r"}],"name":"FPS","start_line":14,"symbol_id":"hold-code/weaponlab/gunkit/timeline.py#var:FPS"}}
