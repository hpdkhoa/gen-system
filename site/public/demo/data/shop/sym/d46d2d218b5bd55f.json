{"flow":{"kind":"field","name":"UnitCents","noCFG":true,"reason":"UnitCents is a field: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":41,"file":"examples/shop/store.go","kind":"field","language":"go","lines":[{"line":1,"text":"package shop"},{"line":2,"text":""},{"line":3,"text":"import ("},{"line":4,"text":"\t\"database/sql\""},{"line":5,"text":"\t\"errors\""},{"line":6,"text":")"},{"line":7,"text":""},{"line":8,"text":"// Line is one product on an order."},{"line":9,"text":"type Line struct {"},{"line":10,"text":"\tSKU       string"},{"line":11,"text":"\tUnitCents int"},{"line":12,"text":"\tQty       int"},{"line":13,"text":"}"},{"line":14,"text":""},{"line":15,"text":"// Store keeps orders and stock in a SQL database."},{"line":16,"text":"type Store struct {"},{"line":17,"text":"\tdb *sql.DB"},{"line":18,"text":"}"},{"line":19,"text":""},{"line":20,"text":"// ErrOutOfStock means a line asks for more than the warehouse holds."},{"line":21,"text":"var ErrOutOfStock = errors.New(\"out of stock\")"},{"line":22,"text":""},{"line":23,"text":"// Reserve takes stock for every line, or for none of them."},{"line":24,"text":"func (s *Store) Reserve(lines []Line) error {"},{"line":25,"text":"\ttx, err := s.db.Begin()"},{"line":26,"text":"\tif err != nil {"},{"line":27,"text":"\t\treturn err"},{"line":28,"text":"\t}"},{"line":29,"text":"\tfor _, l := range lines {"},{"line":30,"text":"\t\tvar left int"},{"line":31,"text":"\t\tif err := tx.QueryRow(\"SELECT qty FROM stock WHERE sku = $1\", l.SKU).Scan(&left); err != nil {"},{"line":32,"text":"\t\t\ttx.Rollback()"},{"line":33,"text":"\t\t\treturn err"},{"line":34,"text":"\t\t}"},{"line":35,"text":"\t\tif left < l.Qty {"},{"line":36,"text":"\t\t\ttx.Rollback()"},{"line":37,"text":"\t\t\treturn ErrOutOfStock"},{"line":38,"text":"\t\t}"},{"line":39,"text":"\t\tif _, err := tx.Exec(\"UPDATE stock SET qty = qty - $1 WHERE sku = $2\", l.Qty, l.SKU); err != nil {"},{"line":40,"text":"\t\t\ttx.Rollback()"},{"line":41,"text":"\t\t\treturn err"}],"name":"UnitCents","start_line":1,"symbol_id":"examples/shop/store.go#field:Line.UnitCents"}}
