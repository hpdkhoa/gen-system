{"flow":{"kind":"field","name":"Store","noCFG":true,"reason":"Store is a field: it holds data, not control flow. CFGs exist only for functions and methods."},"source":{"end_line":41,"file":"examples/shop/checkout.go","kind":"field","language":"go","lines":[{"line":1,"text":"package shop"},{"line":2,"text":""},{"line":3,"text":"import ("},{"line":4,"text":"\t\"encoding/json\""},{"line":5,"text":"\t\"fmt\""},{"line":6,"text":"\t\"net/http\""},{"line":7,"text":"\t\"os\""},{"line":8,"text":"\t\"path/filepath\""},{"line":9,"text":")"},{"line":10,"text":""},{"line":11,"text":"// Shop wires the store to the HTTP handlers."},{"line":12,"text":"type Shop struct {"},{"line":13,"text":"\tStore      *Store"},{"line":14,"text":"\tReceiptDir string"},{"line":15,"text":"}"},{"line":16,"text":""},{"line":17,"text":"type checkoutRequest struct {"},{"line":18,"text":"\tCustomer string `json:\"customer\"`"},{"line":19,"text":"\tLines    []Line `json:\"lines\"`"},{"line":20,"text":"}"},{"line":21,"text":""},{"line":22,"text":"// Checkout reserves stock, saves the order and writes a receipt."},{"line":23,"text":"func (s *Shop) Checkout(w http.ResponseWriter, r *http.Request) {"},{"line":24,"text":"\tvar req checkoutRequest"},{"line":25,"text":"\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {"},{"line":26,"text":"\t\thttp.Error(w, \"bad request\", http.StatusBadRequest)"},{"line":27,"text":"\t\treturn"},{"line":28,"text":"\t}"},{"line":29,"text":"\tif len(req.Lines) == 0 {"},{"line":30,"text":"\t\thttp.Error(w, \"empty order\", http.StatusBadRequest)"},{"line":31,"text":"\t\treturn"},{"line":32,"text":"\t}"},{"line":33,"text":"\tif err := s.Store.Reserve(req.Lines); err != nil {"},{"line":34,"text":"\t\tif err == ErrOutOfStock {"},{"line":35,"text":"\t\t\thttp.Error(w, err.Error(), http.StatusConflict)"},{"line":36,"text":"\t\t\treturn"},{"line":37,"text":"\t\t}"},{"line":38,"text":"\t\thttp.Error(w, \"internal error\", http.StatusInternalServerError)"},{"line":39,"text":"\t\treturn"},{"line":40,"text":"\t}"},{"line":41,"text":"\ttotal := OrderTotal(req.Lines)"}],"name":"Store","start_line":1,"symbol_id":"examples/shop/checkout.go#field:Shop.Store"}}
