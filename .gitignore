# Build artifacts and caches
.gen/
*.exe
# Compiled binaries at the repo root. NOTE: the `bench` binary is deliberately
# NOT listed — bench/ is a tracked source directory (the measurement drivers),
# and a bare `/bench` rule would hide all of them. Build binaries into /tmp or
# results/<date>/ instead, which the drivers already do.
/gen
/gen-server
/genbench
/understand-server
/gen-enrich

# Local environment. gen-system.env.example is the tracked template;
# a real .env holds machine-specific paths and DB credentials.
.env
.env.*
!gen-system.env.example

# NOT ignored on purpose: results/. The raw JSON and the .vram sidecars under
# results/<date>/ are the evidence a published number rests on, and the commit
# that carries them is what dates the run. Ignoring them would make
# `git add results/` silently do nothing, which is the opposite of the point.

# SWE-bench: the clones are huge and re-creatable; tasks.jsonl is public data
# that bench/swebench/fetch_tasks.py re-fetches and verifies against the
# committed tasks.sha256. Everything else under results/ is evidence.
results/*/swebench/repos/
bench/swebench/tasks.jsonl

# v26.32: two things `git add results/` picked up on the 2026-09-04 box that
# are not evidence. The genbench binary lib.sh builds into results/<date>/
# (14 MB, rebuilt by every driver), and the corpus clones run-understand.sh
# makes for the pinned public repos (each has its own .git, so git turns it
# into a submodule gitlink and .gitmodules starts pointing at meyfa/CobolCraft).
# The pinned commits live in bench/tasks.json; the clones are re-creatable.
results/*/genbench
results/*/genbench.exe
results/*/corpus/

# Generated applications produced by `gen idea` / `gen apply`
/generated-app/
/output/

# Toolchains
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
