# gen-system.env.example — gen-system runtime configuration template (v23.21)
#
# Copy to .env (default), or .env.<name> for a named environment, then select it:
#     cp gen-system.env.example .env.production
#     gen idea --env .env.production "..."     # explicit file
#     GEN_ENV=production gen idea "..."         # selects .env.production
#     gen idea "..."                            # uses ./.env
#
# Precedence (highest first):
#   1. A variable already exported in your shell / CI (always wins).
#   2. The value in the selected .env file.
#   3. The built-in default.
# Override any single value at launch without editing the file:
#     OLLAMA_TIMEOUT=1200 gen idea --env .env.production "..."

# ── Model selection (per task) ─────────────────────────────────────────────
OLLAMA_MODEL_PLAN=qwen3:14b
OLLAMA_MODEL_CODE=qwen2.5-coder:14b
# Legacy single model for BOTH roles if the two above are unset:
# OLLAMA_MODEL=deepseek-coder

# ── Logic generation ───────────────────────────────────────────────────────
# ollama → model writes service-logic; (unset) → deterministic templates.
GEN_LOGIC=ollama

# ── Ollama runtime ─────────────────────────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
# Per-request timeout in SECONDS. Two models → a cold load (30–90s) can land
# mid-run on top of generation; 600s is a safe default.
OLLAMA_TIMEOUT=600
# Keep a model resident between phases to avoid reloads. e.g. 30m, 1h, -1.
OLLAMA_KEEP_ALIVE=30m

# ── Backend / database ─────────────────────────────────────────────────────
# GEN_BACKEND=postgres
# DATABASE_URL=postgres://user:pass@localhost:5432/app?sslmode=disable

# ── Output (optional) ──────────────────────────────────────────────────────
# GEN_OUT=./generated-app

# ─────────────────────────────────────────────────────────────────────────────
# PER-ENVIRONMENT PROFILES
# Create one file per environment (they are .gitignored; only THIS template is
# committed). Select with GEN_ENV=<name> or --env .env.<name>.
#
# .env.dev — fast local iteration; deterministic templates (no model wait):
#   GEN_LOGIC=
#   OLLAMA_TIMEOUT=300
#   OLLAMA_KEEP_ALIVE=10m
#   GEN_OUT=./dev-out
#
# .env.staging — full live-model pipeline, generous cold-load timeout, in-memory:
#   GEN_LOGIC=ollama
#   OLLAMA_TIMEOUT=600
#   OLLAMA_KEEP_ALIVE=30m
#   GEN_OUT=./staging-out
#
# .env.production — live model + Postgres + warm models; DSN from your secret
# manager (real env overrides this file):
#   GEN_LOGIC=ollama
#   OLLAMA_TIMEOUT=900
#   OLLAMA_KEEP_ALIVE=1h
#   GEN_BACKEND=postgres
#   DATABASE_URL=postgres://gen:***@db/genprod?sslmode=disable
#   GEN_OUT=./prod-out
