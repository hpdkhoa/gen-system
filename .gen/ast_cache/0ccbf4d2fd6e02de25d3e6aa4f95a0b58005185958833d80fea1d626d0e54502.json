the final suffix of the range. (Each subrange could be empty.)\nThe usual way to establish this condition is to interpret cmp(i)\nas a comparison of a desired target value t against entry i in an\nunderlying indexed data structure x, returning \u003c0, 0, and \u003e0\nwhen t \u003c x[i], t == x[i], and t \u003e x[i], respectively.\n\nFor example, to look for a particular string in a sorted, random-access\nlist of strings:\n\n\ti, found := sort.Find(x.Len(), func(i int) int {\n\t    return strings.Compare(target, x.At(i))\n\t})\n\tif found {\n\t    fmt.Printf(\"found %s at entry %d\\n\", target, i)\n\t} else {\n\t    fmt.Printf(\"%s not found, would insert at %d\", target, i)\n\t}","Receiver":null,"Params":[{"Name":"n","Type":{"Name":"int","Package":"","IsSlice":false,"IsMap":false,"IsPtr":false,"IsFunc":false,"Params":null,"KeyType":null},"Variadic":false,"Optional":false,"Default":""},{"Name":"cmp","Type":{"Name":"func","Package":"","IsSlice":false,"IsMap":false,"IsPtr":false,"IsFunc":true,"Params":null,"KeyType":null},"Variadic":false,"Optional":false,"Default":""}],"Returns":[{"Name":"int","Package":"","IsSlice":false,"IsMap":false,"IsPtr":false,"IsFunc":false,"Params":null,"KeyType":null},{"Name":"bool","Package":"","IsSlice":false,"IsMap":false,"IsPtr":false,"IsFunc":false,"Params":null,"KeyType":null}],"Fields":null,"Implements":null,"Extends":"","TypeParams":null,"AliasTarget":{"Name":"","Package":"","IsSlice":false,"IsMap":false,"IsPtr":false,"IsFunc":false,"Params":null,"KeyType":null},"EnumMembers":null,"ImportPath":"","ImportAlias":"","ImportNames":null,"ImportAll":false,"TypeHint":{"Name":"","Package":"","IsSlice":false,"IsMap":false,"IsPtr":false,"IsFunc":false,"Params":null,"KeyType":null},"ValueLiteral":"","Callee":"","CallArgs":null,"RawSource":"","UnknownReason":"","Children":[{"ID":"","Kind":"assign","Name":"i","Language":"go","Span":{"Start":{"Line":103,"Column":2,"Offset":3958},"End":{"Line":103,"Column":14,"Offset":3970}},"Exported":false,"Abstr